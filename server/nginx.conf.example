# 博客的 nginx 站点配置示例：静态文件 + 划词问答反代。
# 放到 /etc/nginx/sites-available/blog 并软链到 sites-enabled/，然后改下面三处：
#   server_name、root、ssl_certificate（证书可以用 certbot 申请，见 server/README.md）

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # 申请证书时用 certbot --nginx，它会自己改写这一段
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com;

    # certbot 生成的证书路径
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    root /var/www/blog;
    index index.html;
    charset utf-8;

    # Astro 的构建产物：/posts/xxx/ 与 /_astro/xxx.（带哈希）都由 try_files 直接命中
    location / {
        try_files $uri $uri/index.html $uri.html =404;
    }

    # 带哈希的产物可以长期缓存，静态页面本身不缓存（重新发布后立刻生效）
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~* \.(html|json|xml)$ {
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;
    gzip_min_length 1024;

    # ---------- 划词问答 ----------
    location = /api/ask {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 服务端只信本机转发的这两个头，用来做限流
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";

        # 流式回答的关键：不许 nginx 攒着再发
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        # 思考型模型的首字可能要等一会儿；答完一整个回答也可能超过 60s
        proxy_read_timeout 180s;
        proxy_send_timeout 60s;
    }

    # 其余 /api/* 一律不存在，别让扫描器拿去做别的
    location /api/ {
        return 404;
    }
}
