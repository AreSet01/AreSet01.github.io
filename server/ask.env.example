# 划词问答服务的配置。
# 本地调试：复制为 server/ask.env；服务器上：放到 /etc/blog-ask.env 并 chmod 600。
# 填了 key 的文件永远不要提交到 git（server/ask.env 已在 .gitignore 里）。

# OpenAI 兼容接口，服务会请求 {AI_BASE_URL}/chat/completions
AI_BASE_URL=https://fuhuagoogle.top/v1
AI_API_KEY=
AI_MODEL=gemini-3.8-flash-high

# 单次回答的 token 上限。思考型模型的思考过程也算在里面，回答老被截断就调大
AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.4

# 构建产物目录：服务从这里读文章原文，核对读者选中的文字、截取上下文。
# 相对路径按 server/ 目录算；服务器上写绝对路径，例如 /var/www/blog
ASK_SITE_DIR=../dist

# 只监听本机，外面的请求一律经过 nginx
ASK_HOST=127.0.0.1
ASK_PORT=8787

# 限流：每个 IP 每分钟、每个 IP 每天、全站每天、同时进行中的回答数
ASK_RATE_PER_MIN=6
ASK_RATE_PER_DAY=60
ASK_DAILY_LIMIT=800
ASK_MAX_CONCURRENT=12

# 伴读体验参数（亦可在 /settings 控制台实时调整并热生效）
# 单次提问字数上限（默认 300）
# ASK_QUESTION_LIMIT=300
# 首字流式超时时间（秒，默认 60）
# ASK_IDLE_TIMEOUT=60
# 选区上下文截取字符数（默认 700）
# ASK_CONTEXT_LENGTH=700
# 自定义人设系统提示词（留空使用默认伴读人设）
# ASK_SYSTEM_PROMPT=

# 答案缓存落盘，重启后还在；不填就只存在内存里
# ASK_CACHE_FILE=/var/lib/blog-ask/cache.json

# 控制台管理页面 (/settings) 的管理员密码 SHA-256 哈希值
# 使用命令生成：npm run hash:password -- 你的密码
# 例如 123456 的哈希为 8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92
ADMIN_PASSWORD_HASH=

# 运行时动态配置文件路径（控制台保存后写入此文件并热重载生效）
# 服务器上默认使用 /var/lib/blog-ask/runtime-config.json
# ASK_CONFIG_FILE=/var/lib/blog-ask/runtime-config.json
