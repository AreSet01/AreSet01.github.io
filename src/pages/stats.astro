---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../utils/date';
import { byNewest, postMetrics, tagStats, categoryStats, tagSlug } from '../utils/posts';
import { LIFE_ITEMS, LIFE_CATEGORIES, getAllLifeCities, getAllLifeTags } from '../data/life';
import { GALLERY_PHOTOS, PHOTO_CATEGORIES } from '../data/gallery';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = byNewest(allPosts);

// ---- Life (拾光) Metrics ----
const totalLifeItems = LIFE_ITEMS.length;
const lifeCities = getAllLifeCities();
const lifeTags = getAllLifeTags();
const lifeByCategory = LIFE_CATEGORIES.filter((c) => c.id !== 'all').map((cat) => ({
  ...cat,
  count: LIFE_ITEMS.filter((item) => item.category === cat.id).length,
}));
const maxLifeCategory = Math.max(1, ...lifeByCategory.map((c) => c.count));

// ---- Gallery (拾影) Metrics ----
const totalPhotos = GALLERY_PHOTOS.length;
const photoCategories = PHOTO_CATEGORIES.filter((c) => c.id !== 'all').map((cat) => ({
  ...cat,
  count: GALLERY_PHOTOS.filter((photo) => photo.category === cat.id).length,
}));
const maxPhotoCategory = Math.max(1, ...photoCategories.map((c) => c.count));
const photoLocations = Array.from(new Set(GALLERY_PHOTOS.map((p) => p.location.split('·')[0].trim())));
const photoCameras = Array.from(new Set(GALLERY_PHOTOS.map((p) => p.exif.camera)));

const rows = posts.map((post) => {
  const metrics = postMetrics(post);
  const date = new Date(post.data.pubDate);
  return {
    id: post.id,
    title: post.data.title,
    category: post.data.category,
    date,
    dateLabel: formatDate(post.data.pubDate),
    monthKey: `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`,
    ...metrics,
  };
});

const totalChars = rows.reduce((sum, row) => sum + row.chars, 0);
const totalCode = rows.reduce((sum, row) => sum + row.codeLines, 0);
const totalMinutes = rows.reduce((sum, row) => sum + row.minutes, 0);
const tags = tagStats(posts);
const categories = categoryStats(posts);

// ---- Monthly cadence: every month from the first post to the last, gaps included ----
const oldest = rows[rows.length - 1]?.date ?? new Date();
const newest = rows[0]?.date ?? new Date();
const months: Array<{ key: string; label: string; year: number; month: number; count: number }> = [];
const cursor = new Date(oldest.getFullYear(), oldest.getMonth(), 1);
const lastMonth = new Date(newest.getFullYear(), newest.getMonth(), 1);
while (cursor <= lastMonth && months.length < 24) {
  const key = `${cursor.getFullYear()}-${String(cursor.getMonth() + 1).padStart(2, '0')}`;
  months.push({
    key,
    label: String(cursor.getMonth() + 1),
    year: cursor.getFullYear(),
    month: cursor.getMonth() + 1,
    count: rows.filter((row) => row.monthKey === key).length,
  });
  cursor.setMonth(cursor.getMonth() + 1);
}
const maxMonth = Math.max(1, ...months.map((month) => month.count));
const busiestMonth = months.reduce((best, month) => (month.count > best.count ? month : best), months[0]);

// ---- Per-post volume, longest first ----
const byVolume = [...rows].sort((a, b) => b.chars - a.chars);
const maxChars = Math.max(1, ...byVolume.map((row) => row.chars));

// ---- Cumulative words over time, oldest → newest ----
const chronological = [...rows].reverse();
let running = 0;
const cumulative = chronological.map((row) => {
  running += row.chars;
  return { ...row, total: running };
});
const spanStart = chronological[0]?.date.getTime() ?? 0;
const spanEnd = chronological[chronological.length - 1]?.date.getTime() ?? 1;
const spanRange = Math.max(1, spanEnd - spanStart);
const VIEW_W = 1000;
const VIEW_H = 280;
const points = cumulative.map((row) => ({
  ...row,
  px: ((row.date.getTime() - spanStart) / spanRange) * VIEW_W,
  py: VIEW_H - (row.total / Math.max(1, running)) * (VIEW_H - 18) - 6,
}));
const linePath = points.map((point, index) => `${index === 0 ? 'M' : 'L'}${point.px.toFixed(1)},${point.py.toFixed(1)}`).join(' ');
const feibaiPath = points.map((point, index) => `${index === 0 ? 'M' : 'L'}${point.px.toFixed(1)},${(point.py + 3.5).toFixed(1)}`).join(' ');
const areaPath = points.length
  ? `${linePath} L${VIEW_W},${VIEW_H} L0,${VIEW_H} Z`
  : '';

// ---- Tag distribution: top 8, tail folded ----
const TOP_TAGS = 8;
const topTags = tags.slice(0, TOP_TAGS);
const tailTags = tags.slice(TOP_TAGS);
const tailTotal = tailTags.reduce((sum, tag) => sum + tag.count, 0);
const maxTag = Math.max(1, ...tags.map((tag) => tag.count));

const nf = new Intl.NumberFormat('en-US');
const clip = (text: string, max = 16) => (text.length > max ? `${text.slice(0, max)}…` : text);
---

<BaseLayout title="写作统计 - 梦付千秋" description="这个博客到今天为止写了多少字、多少行代码">
  <Header />
  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-20 lg:pt-8 outline-none">
    <section class="stats-head">
      <p class="eyebrow" data-enter="top">Stats / 笔墨计数</p>
      <h1 class="section-title mt-4" data-enter="left">写了多少</h1>
      <p class="stats-hint" data-enter="left">
        反正大部分都AI写的（
      </p>
    </section>

    <!-- Hero: the one number this page leads with -->
    <section class="stats-hero" data-enter="card">
      <p class="stats-hero-label">累计字数</p>
      <p class="stats-hero-value" data-stat-value={totalChars}>{nf.format(totalChars)}</p>
      <p class="stats-hero-note">
        分布在 {posts.length} 篇文章里，另收录 {totalLifeItems} 项生活拾光、{totalPhotos} 幅拾影留痕与 {nf.format(totalCode)} 行代码
      </p>
    </section>

    <section class="stats-kpis" data-enter="card">
      <div class="stats-kpi">
        <p class="stats-kpi-label">技术文章</p>
        <p class="stats-kpi-value" data-stat-value={posts.length}>{posts.length}</p>
        <p class="stats-kpi-unit">篇</p>
      </div>
      <div class="stats-kpi">
        <p class="stats-kpi-label">生活拾光</p>
        <p class="stats-kpi-value" data-stat-value={totalLifeItems}>{totalLifeItems}</p>
        <p class="stats-kpi-unit">条记趣</p>
      </div>
      <div class="stats-kpi">
        <p class="stats-kpi-label">拾影画廊</p>
        <p class="stats-kpi-value" data-stat-value={totalPhotos}>{totalPhotos}</p>
        <p class="stats-kpi-unit">张摄影</p>
      </div>
      <div class="stats-kpi">
        <p class="stats-kpi-label">漫游足迹</p>
        <p class="stats-kpi-value" data-stat-value={lifeCities.length}>{lifeCities.length}</p>
        <p class="stats-kpi-unit">座城市</p>
      </div>
      <div class="stats-kpi">
        <p class="stats-kpi-label">代码行数</p>
        <p class="stats-kpi-value" data-stat-value={totalCode}>{nf.format(totalCode)}</p>
        <p class="stats-kpi-unit">行</p>
      </div>
      <div class="stats-kpi">
        <p class="stats-kpi-label">总阅读时长</p>
        <p class="stats-kpi-value" data-stat-value={totalMinutes}>{totalMinutes}</p>
        <p class="stats-kpi-unit">分钟</p>
      </div>
      <div class="stats-kpi">
        <p class="stats-kpi-label">全站标签</p>
        <p class="stats-kpi-value" data-stat-value={tags.length + lifeTags.length}>{tags.length + lifeTags.length}</p>
        <p class="stats-kpi-unit">个</p>
      </div>
    </section>

    <!-- 1. Cadence ------------------------------------------------------- -->
    <section class="chart-card" data-enter="card">
      <div class="chart-head">
        <h2>发文节奏</h2>
        <p>{months[0]?.year}年{months[0]?.month}月开始发文~</p>
      </div>
      <div class="chart-columns chart-brush-columns" data-chart-columns>
        {months.map((month, idx) => (
          <div
            class:list={['chart-column', { 'is-empty': month.count === 0, 'is-peak': month.count === maxMonth && month.count > 0 }]}
            style={`--value: ${(month.count / maxMonth).toFixed(3)}; --i: ${idx}`}
            data-tip={`${month.year} 年 ${month.month} 月 · ${month.count} 篇`}
            tabindex="0"
          >
            <span class="chart-column-track" aria-hidden="true">
              <span class="chart-column-fill"></span>
            </span>
            {month.count === maxMonth && month.count > 0 && (
              <span class="chart-column-cap">{month.count}</span>
            )}
            <span class="chart-column-label">{month.label}</span>
          </div>
        ))}
      </div>
      <p class="chart-foot">
        最忙的是 {busiestMonth?.year} 年 {busiestMonth?.month} 月，{busiestMonth?.count} 篇。
      </p>
    </section>

    <!-- 2. Volume per post ----------------------------------------------- -->
    <section class="chart-card" data-enter="card">
      <div class="chart-head">
        <h2>每篇的体量</h2>
        <p>按正文字数排序（不含代码）</p>
      </div>
      <ul class="chart-bars chart-brush-bars" data-chart-bars>
        {byVolume.map((row, index) => (
          <li
            class:list={['chart-bar-row', { 'is-peak': index === 0 }]}
            style={`--value: ${(row.chars / maxChars).toFixed(3)}; --i: ${index}`}
            data-tip={`${row.title} · ${nf.format(row.chars)} 字 · ${nf.format(row.codeLines)} 行代码`}
          >
            <a class="chart-bar-name" href={`/posts/${row.id}`} title={row.title}>{clip(row.title, 18)}</a>
            <span class="chart-bar-track" aria-hidden="true"><span class="chart-bar-fill"></span></span>
            <span class="chart-bar-value">{nf.format(row.chars)}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- 3. Cumulative ---------------------------------------------------- -->
    <section class="chart-card" data-enter="card">
      <div class="chart-head">
        <h2>累计字数</h2>
        <p>从第一篇到最新一篇，字数是怎么堆起来的</p>
      </div>
      <div class="chart-line chart-brush-line" data-chart-line>
        <svg viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="stats-mountain-wash" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--ink-strong)" stop-opacity="0.22" />
              <stop offset="68%" stop-color="var(--ink)" stop-opacity="0.06" />
              <stop offset="100%" stop-color="var(--ink)" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path class="chart-line-area chart-mountain-area" d={areaPath} />
          <path class="chart-line-feibai" d={feibaiPath} pathLength="1" vector-effect="non-scaling-stroke" />
          <path class="chart-line-stroke" d={linePath} pathLength="1" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="chart-line-overlay">
          {points.map((point, index) => (
            <span
              class:list={['chart-line-hit', { 'is-last': index === points.length - 1 }]}
              style={`--x: ${(point.px / VIEW_W * 100).toFixed(2)}%; --y: ${(point.py / VIEW_H * 100).toFixed(2)}%; --p: ${(point.px / VIEW_W).toFixed(3)}`}
              data-tip={`${point.dateLabel} · 累计 ${nf.format(point.total)} 字`}
              tabindex="0"
            >
              <i class="chart-line-dot" aria-hidden="true"></i>
            </span>
          ))}
        </div>
        <span class="chart-line-endlabel">{nf.format(running)} 字</span>
      </div>
      <div class="chart-axis">
        <span>{chronological[0]?.dateLabel}</span>
        <span>{chronological[chronological.length - 1]?.dateLabel}</span>
      </div>
    </section>

    <!-- 4. Tags ---------------------------------------------------------- -->
    <section class="chart-card" data-enter="card">
      <div class="chart-head">
        <h2>标签分布</h2>
        <p>前 {topTags.length} 个标签，其余 {tailTags.length} 个合并在最后一行~<a href="/tags">去星图看全部 →</a></p>
      </div>
      <ul class="chart-bars chart-brush-bars" data-chart-bars>
        {topTags.map((tag, index) => (
          <li
            class:list={['chart-bar-row', { 'is-peak': index === 0 }]}
            style={`--value: ${(tag.count / maxTag).toFixed(3)}; --i: ${index}`}
            data-tip={`${tag.name} · ${tag.count} 篇`}
          >
            <a class="chart-bar-name" href={`/tags/${tagSlug(tag.name)}`}>{clip(tag.name, 14)}</a>
            <span class="chart-bar-track" aria-hidden="true"><span class="chart-bar-fill"></span></span>
            <span class="chart-bar-value">{tag.count}</span>
          </li>
        ))}
        {tailTags.length > 0 && (
          <li
            class="chart-bar-row is-other"
            style={`--value: ${(tailTotal / Math.max(maxTag, tailTotal)).toFixed(3)}; --i: ${topTags.length}`}
            data-tip={`其余 ${tailTags.length} 个标签共出现 ${tailTotal} 次`}
          >
            <span class="chart-bar-name">其他 {tailTags.length} 个</span>
            <span class="chart-bar-track" aria-hidden="true"><span class="chart-bar-fill"></span></span>
            <span class="chart-bar-value">{tailTotal}</span>
          </li>
        )}
      </ul>
    </section>

    <!-- 5. Life / 拾光生活统计 -------------------------------------------- -->
    <section class="chart-card" data-enter="card">
      <div class="chart-head flex flex-col md:flex-row md:items-center justify-between gap-2">
        <div>
          <h2>拾光纪事 · 生活印迹</h2>
          <p>记录日常去处、玩乐体验与心选好物，共 {totalLifeItems} 项美好回忆，漫步于 {lifeCities.join('、')} 等地~</p>
        </div>
        <a href="/life" class="stats-sub-link">探索生活拾光 &rarr;</a>
      </div>
      <ul class="chart-bars chart-brush-bars" data-chart-bars>
        {lifeByCategory.map((cat, index) => (
          <li
            class:list={['chart-bar-row', { 'is-peak': index === 0 }]}
            style={`--value: ${(cat.count / maxLifeCategory).toFixed(3)}; --i: ${index}`}
            data-tip={`${cat.name} · ${cat.count} 条记录 · ${cat.desc}`}
          >
            <span class="chart-bar-name">{cat.icon} {cat.name}</span>
            <span class="chart-bar-track" aria-hidden="true"><span class="chart-bar-fill"></span></span>
            <span class="chart-bar-value">{cat.count} 条</span>
          </li>
        ))}
      </ul>
      <div class="stats-meta-row flex flex-wrap items-center gap-2">
        <span class="stats-meta-label">漫游足迹：</span>
        {lifeCities.map((city) => (
          <span class="stats-tag-pill">{city}</span>
        ))}
      </div>
    </section>

    <!-- 6. Gallery / 拾影画廊统计 ----------------------------------------- -->
    <section class="chart-card" data-enter="card">
      <div class="chart-head flex flex-col md:flex-row md:items-center justify-between gap-2">
        <div>
          <h2>拾影集 · 山海光影</h2>
          <p>定格 {totalPhotos} 幅山海风光与城市人文瞬息，主力器材 {photoCameras.join('、')}~</p>
        </div>
        <a href="/gallery" class="stats-sub-link">移步拾影画廊 &rarr;</a>
      </div>
      <ul class="chart-bars chart-brush-bars" data-chart-bars>
        {photoCategories.map((cat, index) => (
          <li
            class:list={['chart-bar-row', { 'is-peak': index === 0 }]}
            style={`--value: ${(cat.count / maxPhotoCategory).toFixed(3)}; --i: ${index}`}
            data-tip={`${cat.name} · ${cat.count} 张摄影 · ${cat.desc}`}
          >
            <span class="chart-bar-name">{cat.icon} {cat.name}</span>
            <span class="chart-bar-track" aria-hidden="true"><span class="chart-bar-fill"></span></span>
            <span class="chart-bar-value">{cat.count} 张</span>
          </li>
        ))}
      </ul>
      <div class="stats-meta-row flex flex-wrap items-center gap-2">
        <span class="stats-meta-label">拍摄地点：</span>
        {photoLocations.map((loc) => (
          <span class="stats-tag-pill">{loc}</span>
        ))}
      </div>
    </section>

    <!-- Table view: every number above, reachable without hovering -------- -->
    <details class="stats-table" data-enter="card">
      <summary>数据表</summary>
      <div class="stats-table-clip" data-stats-table-clip>
        <div class="stats-table-scroll">
          <table>
            <caption>每篇文章的字数与代码量</caption>
            <thead>
              <tr><th scope="col">文章</th><th scope="col">日期</th><th scope="col">分类</th><th scope="col">字数</th><th scope="col">代码行</th><th scope="col">阅读</th></tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td><a href={`/posts/${row.id}`}>{row.title}</a></td>
                  <td>{row.dateLabel}</td>
                  <td>{row.category}</td>
                  <td class="is-num">{nf.format(row.chars)}</td>
                  <td class="is-num">{nf.format(row.codeLines)}</td>
                  <td class="is-num">{row.minutes} min</td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr>
                <td colspan="3">合计</td>
                <td class="is-num">{nf.format(totalChars)}</td>
                <td class="is-num">{nf.format(totalCode)}</td>
                <td class="is-num">{totalMinutes} min</td>
              </tr>
            </tfoot>
          </table>

          <table>
            <caption>拾光生活记录</caption>
            <thead><tr><th scope="col">标题</th><th scope="col">分类</th><th scope="col">城市</th><th scope="col">星级</th><th scope="col">日期</th></tr></thead>
            <tbody>
              {LIFE_ITEMS.map((item) => (
                <tr>
                  <td><a href="/life">{item.title}</a></td>
                  <td>{item.categoryLabel}</td>
                  <td>{item.city}</td>
                  <td class="is-num">{'★'.repeat(item.rating)}</td>
                  <td>{item.dateAdded ?? '近期'}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <table>
            <caption>拾影摄影记录</caption>
            <thead><tr><th scope="col">照片名称</th><th scope="col">影集</th><th scope="col">地点</th><th scope="col">器材规格</th><th scope="col">拍摄日期</th></tr></thead>
            <tbody>
              {GALLERY_PHOTOS.map((photo) => (
                <tr>
                  <td><a href="/gallery">{photo.title}</a></td>
                  <td>{photo.categoryLabel}</td>
                  <td>{photo.location}</td>
                  <td>{photo.exif.camera} · {photo.exif.lens}</td>
                  <td>{photo.date}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <table>
            <caption>每月发文数</caption>
            <thead><tr><th scope="col">月份</th><th scope="col">篇数</th></tr></thead>
            <tbody>
              {months.map((month) => (
                <tr><td>{month.year}-{String(month.month).padStart(2, '0')}</td><td class="is-num">{month.count}</td></tr>
              ))}
            </tbody>
          </table>

          <table>
            <caption>标签与分类</caption>
            <thead><tr><th scope="col">名称</th><th scope="col">类型</th><th scope="col">篇数</th></tr></thead>
            <tbody>
              {categories.map((category) => (
                <tr><td>{category.name}</td><td>分类</td><td class="is-num">{category.count}</td></tr>
              ))}
              {tags.map((tag) => (
                <tr><td>{tag.name}</td><td>标签</td><td class="is-num">{tag.count}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </details>

    <!-- 宣纸批注小笺浮窗：常驻流外并通过纯 GPU translate3d 平滑跟随，杜绝 hidden 切换重排 -->
    <div class="stats-tip stats-paper-note" data-stats-tip aria-hidden="true">
      <span class="stats-tip-seal" aria-hidden="true">笺</span>
      <span class="stats-tip-body" data-stats-tip-body></span>
    </div>
  </main>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import CustomEase from 'gsap/CustomEase';

  gsap.registerPlugin(ScrollTrigger, CustomEase);
  CustomEase.create('enter', 'M0,0 C0.06,0.62 0.16,0.9 0.42,0.975 0.62,1.005 0.8,1 1,1');

  const CLEANUP_KEY = '__areSetStatsCleanup__';
  const LISTENER_KEY = '__areSetStatsBound__';

  function initStats() {
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') previousCleanup();

    const tip = document.querySelector<HTMLElement>('[data-stats-tip]');
    const tipBody = tip?.querySelector<HTMLElement>('[data-stats-tip-body]');
    if (!tip || !tipBody) return; // not the stats page

    const controller = new AbortController();
    const { signal } = controller;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let tableTween: gsap.core.Tween | null = null;
    const countTweens: gsap.core.Tween[] = [];

    // ---------- Data table: zero-reflow clip shell open/close ----------
    const table = document.querySelector<HTMLDetailsElement>('details.stats-table');
    const tableClip = table?.querySelector<HTMLElement>('[data-stats-table-clip]');
    if (table && tableClip) {
      const summary = table.querySelector<HTMLElement>('summary')!;
      table.querySelectorAll<HTMLElement>('tbody tr, tfoot tr').forEach((row, index) => {
        row.style.setProperty('--i', String(index));
      });
      const settle = () => {
        ScrollTrigger.refresh();
        try { (window as any).lenis?.resize(); } catch {}
      };
      if (reduceMotion) {
        table.addEventListener('toggle', settle, { signal });
      } else {
        table.classList.add('is-animated');
        if (table.open) table.classList.add('is-shown');
        summary.addEventListener('click', (event) => {
          event.preventDefault();
          tableTween?.kill();
          if (!table.open) {
            table.open = true;
            gsap.set(tableClip, { clearProps: 'height,overflow,willChange' });
            const full = tableClip.getBoundingClientRect().height;
            const startScrollY = window.scrollY;
            const summaryDocTop = summary.getBoundingClientRect().top + startScrollY;
            const targetCenterScrollY = Math.max(
              0,
              Math.round(summaryDocTop - (window.innerHeight - summary.offsetHeight) * 0.36),
            );
            const scrollDelta = targetCenterScrollY - startScrollY;
            const shouldScroll = scrollDelta > 10;

            tableClip.classList.add('is-animating-clip');
            gsap.set(tableClip, { height: 0, overflow: 'hidden', willChange: 'height' });
            requestAnimationFrame(() => table.classList.add('is-shown'));

            tableTween = gsap.to(tableClip, {
              height: full,
              duration: 0.72,
              ease: 'enter',
              onUpdate: function () {
                if (shouldScroll) {
                  const currentY = startScrollY + scrollDelta * this.progress();
                  if ((window as any).lenis) {
                    (window as any).lenis.scrollTo(currentY, { immediate: true });
                  } else {
                    window.scrollTo({ top: currentY, behavior: 'instant' });
                  }
                }
              },
              onComplete: () => {
                tableClip.classList.remove('is-animating-clip');
                gsap.set(tableClip, { clearProps: 'height,overflow,willChange' });
                tableTween = null;
                settle();
              },
            });
          } else {
            table.classList.remove('is-shown');
            const currentHeight = tableClip.getBoundingClientRect().height;
            const startScrollY = window.scrollY;
            const currentDocHeight = document.documentElement.scrollHeight;
            const targetDocHeight = currentDocHeight - currentHeight;
            const maxTargetScroll = Math.max(0, targetDocHeight - window.innerHeight);
            const needsScrollAdjust = startScrollY > maxTargetScroll;
            const scrollDistance = needsScrollAdjust ? startScrollY - maxTargetScroll : 0;

            tableClip.classList.add('is-animating-clip');
            gsap.set(tableClip, { height: currentHeight, overflow: 'hidden', willChange: 'height' });

            // 收拢期间不再逐帧调用 lenis.resize()，彻底消除每帧全文档重排卡顿
            tableTween = gsap.to(tableClip, {
              height: 0,
              duration: 0.52,
              ease: 'power3.inOut',
              onUpdate: function () {
                if (needsScrollAdjust) {
                  const targetY = startScrollY - scrollDistance * this.progress();
                  if ((window as any).lenis) {
                    (window as any).lenis.scrollTo(targetY, { immediate: true });
                  } else {
                    window.scrollTo({ top: targetY, behavior: 'instant' });
                  }
                }
              },
              onComplete: () => {
                table.open = false;
                tableClip.classList.remove('is-animating-clip');
                gsap.set(tableClip, { clearProps: 'height,overflow,willChange' });
                tableTween = null;
                settle();
              },
            });
          }
        }, { signal });
      }
    }

    // ---------- Count-up (once per view so numbers never flash back to 0) ----------
    const numberFormatter = new Intl.NumberFormat('en-US');
    document.querySelectorAll<HTMLElement>('[data-stat-value]').forEach((el) => {
      const target = Number(el.dataset.statValue || 0);
      if (!Number.isFinite(target) || reduceMotion) return;
      const counter = { value: 0 };
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            io.disconnect();
            const tw = gsap.to(counter, {
              value: target,
              duration: 1.35,
              ease: 'expo.out',
              onUpdate: () => { el.textContent = numberFormatter.format(Math.round(counter.value)); },
              onComplete: () => { el.textContent = numberFormatter.format(target); },
            });
            countTweens.push(tw);
          });
        },
        { threshold: 0.2 },
      );
      io.observe(el);
      signal.addEventListener('abort', () => io.disconnect());
    });

    // ---------- Brush-stroke chart entrance ----------
    const charts = Array.from(document.querySelectorAll<HTMLElement>('[data-chart-columns], [data-chart-bars], [data-chart-line]'));
    if (reduceMotion) {
      charts.forEach((chart) => chart.classList.add('is-drawn'));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-drawn');
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.14 },
      );
      charts.forEach((chart) => io.observe(chart));
      signal.addEventListener('abort', () => io.disconnect());
    }

    // ---------- Shared Xuan-Paper Tooltip Note (GPU quickTo glide, zero hidden-toggle reflow) ----------
    let hideTimer = 0;
    let tipVisible = false;
    let cachedTipW = 180;
    let cachedTipH = 38;

    const tipPos = { x: 0, y: 0 };
    const paintTipPos = () => {
      tip!.style.transform = `translate3d(${tipPos.x.toFixed(1)}px, ${tipPos.y.toFixed(1)}px, 0px)`;
    };
    const glideX = reduceMotion ? null : gsap.quickTo(tipPos, 'x', { duration: 0.24, ease: 'power3.out', onUpdate: paintTipPos });
    const glideY = reduceMotion ? null : gsap.quickTo(tipPos, 'y', { duration: 0.24, ease: 'power3.out', onUpdate: paintTipPos });

    function show(target: HTMLElement) {
      const text = target.dataset.tip;
      if (!text) return;
      window.clearTimeout(hideTimer);

      if (tipBody!.textContent !== text) {
        tipBody!.textContent = text;
        cachedTipW = tip!.offsetWidth || 180;
        cachedTipH = tip!.offsetHeight || 38;
      }

      const rect = target.getBoundingClientRect();
      const x = Math.min(
        window.innerWidth - cachedTipW - 12,
        Math.max(12, rect.left + rect.width / 2 - cachedTipW / 2),
      );
      const above = rect.top > cachedTipH + 22;
      const y = above ? rect.top - cachedTipH - 10 : rect.bottom + 10;

      if (!tipVisible || !glideX || !glideY) {
        gsap.killTweensOf(tipPos);
        tipPos.x = x;
        tipPos.y = y;
        paintTipPos();
      } else {
        glideX(x);
        glideY(y);
      }

      tipVisible = true;
      tip!.classList.add('is-visible');
    }

    function scheduleHide() {
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => {
        tipVisible = false;
        tip!.classList.remove('is-visible');
      }, 90);
    }

    document.addEventListener('pointerover', (event) => {
      const target = (event.target as Element)?.closest?.<HTMLElement>('[data-tip]');
      if (target) show(target);
    }, { signal });

    document.addEventListener('pointerout', (event) => {
      const target = (event.target as Element)?.closest?.('[data-tip]');
      if (!target) return;
      const next = (event as PointerEvent).relatedTarget as Element | null;
      if (next?.closest?.('[data-tip]')) return;
      scheduleHide();
    }, { signal });

    document.addEventListener('focusin', (event) => {
      const target = (event.target as Element)?.closest?.<HTMLElement>('[data-tip]');
      if (target) show(target);
    }, { signal });

    document.addEventListener('focusout', (event) => {
      const target = (event.target as Element)?.closest?.('[data-tip]');
      if (target) scheduleHide();
    }, { signal });

    window.addEventListener('scroll', () => {
      if (tipVisible) scheduleHide();
    }, { passive: true, signal });

    (window as any)[CLEANUP_KEY] = () => {
      controller.abort();
      window.clearTimeout(hideTimer);
      tableTween?.kill();
      tableTween = null;
      countTweens.forEach((tw) => tw.kill());
      countTweens.length = 0;
      gsap.killTweensOf(tipPos);
      (window as any)[CLEANUP_KEY] = undefined;
    };
  }

  initStats();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initStats);
    document.addEventListener('astro:before-swap', () => {
      (window as any)[CLEANUP_KEY]?.();
    });
    (window as any)[LISTENER_KEY] = true;
  }
</script>

