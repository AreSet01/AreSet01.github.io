---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { formatDate, sortPostsByDate } from '../utils/date';
import { categoryStats } from '../utils/posts';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = sortPostsByDate(allPosts);
const categories = categoryStats(posts);

const postsByYear = posts.reduce((acc, post) => {
  const year = new Date(post.data.pubDate).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof posts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
const latestYear = years[0] ?? String(new Date().getFullYear());
---

<BaseLayout title="归档 - 梦付千秋">
  <Header />
  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-16 lg:pt-8 outline-none">
    <section class="panel pb-12 border-b border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 5%, var(--rule-strong) 50%, transparent 95%) 1;">
      <p class="eyebrow" data-enter="top">Archive</p>
      <div class="mt-6 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between flex-wrap">
        <div class="max-w-2xl">
          <h1 class="section-title" data-enter="left">让我看看这里有啥？</h1>
          <p
            class="mt-5 text-[1rem] leading-[1.78] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
            data-enter="left"
          >
            这里可以按时间看到所~有~的文章噢~
          </p>
        </div>
        <div class="archive-stats-wrap" data-enter="bloom" data-archive-stats-strip>
          <div class="archive-stats-strip" aria-label="归档数据概览">
            <span class="stats-glider" data-archive-stats-glider aria-hidden="true"></span>

            <div class="stats-item archive-stat-item" data-stats-item tabindex="0" title="全站公开文章总数">
              <span class="stats-label">TOTAL</span>
              <strong class="stats-value" data-count={posts.length}>{posts.length}</strong>
              <span class="stats-subnote">篇公开文章</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item archive-stat-item" data-stats-item tabindex="0" title="跨越年度">
              <span class="stats-label">YEARS</span>
              <strong class="stats-value" data-count={years.length}>{years.length}</strong>
              <span class="stats-subnote">年历程</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item archive-stat-item" data-stats-item tabindex="0" title="最近活跃年份">
              <span class="stats-label">LATEST</span>
              <strong class="stats-value">{latestYear}</strong>
              <span class="stats-subnote">最近活跃</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {categories.length > 1 && (
      <div class="archive-filter-bar" data-archive-filters data-enter="bottom">
        <span class="archive-filter-label">分类</span>
        <div class="archive-filter-chips" data-archive-chips>
          <span class="archive-ink-whisper" data-archive-ink-whisper aria-hidden="true"></span>
          <span class="archive-ink-pill" data-archive-ink-pill aria-hidden="true"></span>
          <button type="button" class="archive-filter is-active" data-filter="all">
            <span>全部</span><i>{posts.length}</i>
          </button>
          {categories.map((category) => (
            <button type="button" class="archive-filter" data-filter={category.name}>
              <span>{category.name}</span><i>{category.count}</i>
            </button>
          ))}
        </div>
      </div>
    )}

    <div class="mt-16 space-y-16" data-archive-list>
      {years.map((year) => (
        <section
          class="archive-year-section grid gap-8 lg:grid-cols-[140px_minmax(0,1fr)] lg:gap-14"
          data-archive-year
        >
          <div class="archive-year-rail panel lg:sticky lg:top-24 lg:self-start" data-enter="left">
            <p class="font-mono text-[0.7rem] tracking-[0.16em] uppercase text-[var(--muted)]">
              Year
            </p>
            <p class="archive-year-num font-display mt-3 text-[3rem] leading-none text-[var(--text-strong)]">
              {year}
            </p>
            <p class="mt-3 font-mono text-[0.72rem] tracking-[0.08em] text-[var(--muted)]" data-year-count>
              {postsByYear[Number(year)].length} {postsByYear[Number(year)].length > 1 ? 'entries' : 'entry'}
            </p>
          </div>
          <div class="panel">
            <ul class="space-y-0">
              {postsByYear[Number(year)].map((post: typeof posts[number]) => (
                <li class="archive-entry-row" data-enter="ink" data-category={post.data.category}>
                  <a href={`/posts/${post.id}`} class="timeline-link archive-ink-row group">
                    <time class="archive-row-date mt-0.5 w-24 shrink-0 font-mono text-[0.72rem] tracking-[0.06em] text-[var(--muted)]">
                      {formatDate(post.data.pubDate)}
                    </time>
                    <div class="min-w-0 flex-1">
                      <h3 class="font-display text-[1.15rem] leading-snug text-[var(--text-strong)] transition-colors duration-300 group-hover:text-[var(--accent)]">
                        {post.data.title}
                        {post.data.locked && <span class="lock-mark ml-3 align-middle">Locked</span>}
                      </h3>
                      {post.data.description && (
                        <p
                          class="mt-2 text-[0.88rem] leading-relaxed text-[var(--muted)] line-clamp-2"
                          style="font-family: var(--font-serif); font-style: italic;"
                        >
                          {post.data.description}
                        </p>
                      )}
                    </div>
                    <span class="archive-row-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  /* 归档统计胶囊游标：纯 GPU translate3d + scaleX + 反向圆角补偿驱动，禁边框消除缩放畸变 */
  [data-archive-stats-strip] [data-archive-stats-glider] {
    width: 100px !important;
    left: 0 !important;
    border: none !important;
    box-shadow: none !important;
    border-radius: var(--pill-rx, 9999px) / var(--pill-ry, 9999px) !important;
    transform-origin: left center !important;
    transition:
      transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms var(--ease) !important;
    will-change: transform, opacity;
  }

  /* 归档分类游走式「水墨底衬游标（Sliding Ink Pill）」 */
  .archive-filter-chips {
    position: relative;
    isolation: isolate;
  }

  .archive-ink-pill,
  .archive-ink-whisper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100px;
    height: 36px;
    border-radius: var(--pill-rx, 4px) / var(--pill-ry, 4px);
    transform-origin: 0 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .archive-ink-pill {
    z-index: 0;
    opacity: 0;
    background:
      radial-gradient(circle at 20% 50%, color-mix(in srgb, var(--vermilion) 24%, var(--ink-strong)) 0%, var(--ink-strong) 80%);
    transition:
      transform 430ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms var(--ease);
  }

  .archive-ink-pill.is-instant {
    transition: none !important;
  }

  .archive-ink-whisper {
    z-index: 0;
    opacity: 0;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 180ms var(--ease);
  }

  /* 游标就位后隐藏单按钮静态 ::before 填充，改由全局水墨游标丝滑游走灌注 */
  .archive-filter-chips[data-pill-ready="true"] .archive-filter {
    z-index: 1;
  }

  .archive-filter-chips[data-pill-ready="true"] .archive-filter::before {
    transform: scaleX(0) !important;
    opacity: 0 !important;
  }

  /* 归档目录行：悬停朱砂落点与行书引线反馈 */
  .archive-ink-row {
    position: relative;
  }

  .archive-ink-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 2.5rem;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--vermilion) 0%, var(--accent) 45%, transparent 100%);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1), opacity 260ms var(--ease);
  }

  .archive-ink-row:hover::after,
  .archive-ink-row:focus-visible::after {
    transform: scaleX(1);
    opacity: 0.72;
  }

  .archive-row-date {
    position: relative;
    padding-left: 0.85rem;
    transition: color 260ms var(--ease);
  }

  .archive-row-date::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52em;
    width: 0.36rem;
    height: 0.36rem;
    background: var(--rule-strong);
    transform: rotate(45deg) scale(0.82);
    transition: background-color 260ms var(--ease), transform 340ms var(--ease-bounce);
  }

  .archive-ink-row:hover .archive-row-date {
    color: var(--text-strong);
  }

  .archive-ink-row:hover .archive-row-date::before,
  .archive-ink-row:focus-visible .archive-row-date::before {
    background: var(--vermilion);
    transform: rotate(45deg) scale(1.25);
  }

  .archive-row-arrow {
    align-self: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    opacity: 0;
    transform: translate3d(-6px, 0, 0);
    transition: opacity 260ms var(--ease), transform 320ms var(--ease-bounce);
  }

  .archive-ink-row:hover .archive-row-arrow,
  .archive-ink-row:focus-visible .archive-row-arrow {
    opacity: 0.88;
    transform: translate3d(2px, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-archive-stats-strip] [data-archive-stats-glider],
    .archive-ink-pill,
    .archive-ink-whisper,
    .archive-ink-row::after,
    .archive-row-date::before,
    .archive-row-arrow {
      transition: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import CustomEase from 'gsap/CustomEase';

  gsap.registerPlugin(ScrollTrigger, CustomEase);
  // The same curve BaseLayout's entrance rides — fast in, long settle.
  CustomEase.create('enter', 'M0,0 C0.06,0.62 0.16,0.9 0.42,0.975 0.62,1.005 0.8,1 1,1');

  const CLEANUP_KEY = '__areSetArchiveFilterCleanup__';
  const LISTENER_KEY = '__areSetArchiveFilterBound__';
  const GLIDER_CLEANUP_KEY = '__areSetArchiveGliderCleanup__';

  const EXIT_CLIP = 0.42;       // ink contracting back into the date origin
  const EXIT_COLLAPSE = 0.5;    // row height closing smoothly behind it
  const EXIT_STAGGER = 0.026;
  const ARRIVE_AT = 0.26;       // arrivals overlap the tail of departures
  const ARRIVE_EXPAND = 0.54;
  const ARRIVE_CLIP = 0.88;
  const ARRIVE_STAGGER = 0.048;
  const SECTION_MOVE = 0.62;
  const ROW_PROPS = 'height,overflow,clipPath,opacity,transform,willChange';
  const SECTION_PROPS = 'height,marginTop,marginBottom,overflow,opacity,willChange';

  /** Batch-friendly geometry measurement using sub-pixel getBoundingClientRect() to guarantee 0.00px cumulative height drift. */
  function measureRowGeometry(el: HTMLElement) {
    const rowRect = el.getBoundingClientRect();
    const seed = el.querySelector('time') || el;
    const seedRect = seed === el ? rowRect : seed.getBoundingClientRect();
    const x = seedRect.left - rowRect.left + Math.min(seedRect.width, 40) / 2;
    const y = seedRect.top - rowRect.top + seedRect.height / 2;
    return {
      height: rowRect.height,
      origin: `${Math.round(x)}px ${Math.round(y)}px`,
      radius: Math.ceil(Math.hypot(rowRect.width, rowRect.height)),
    };
  }

  function sectionBox(section: HTMLElement) {
    const rect = section.getBoundingClientRect();
    const style = getComputedStyle(section);
    return {
      section,
      height: rect.height,
      marginTop: Number.parseFloat(style.marginTop) || 0,
      marginBottom: Number.parseFloat(style.marginBottom) || 0,
    };
  }

  function settle(el: HTMLElement) {
    gsap.killTweensOf(el);
    el.classList.remove('is-entering', 'is-filtered-out');
    el.classList.add('is-entered');
    el.dataset.enterState = 'in';
    delete el.dataset.filterMotion;
    gsap.set(el, { clearProps: ROW_PROPS });
  }

  function entryLabel(count: number) {
    return `${count} ${count > 1 ? 'entries' : 'entry'}`;
  }

  function initArchiveStatsGlider() {
    const prev = (window as any)[GLIDER_CLEANUP_KEY];
    if (typeof prev === 'function') prev();

    const strip = document.querySelector<HTMLElement>('[data-archive-stats-strip]');
    const glider = document.querySelector<HTMLElement>('[data-archive-stats-glider]');
    if (!strip || !glider) return;

    const items = Array.from(strip.querySelectorAll<HTMLElement>('[data-stats-item]'));
    if (items.length === 0) return;

    const controller = new AbortController();
    const { signal } = controller;

    let metrics = items.map((item) => ({
      left: item.offsetLeft,
      width: Math.max(1, item.offsetWidth),
      height: Math.max(1, glider.offsetHeight || item.offsetHeight),
    }));

    const refreshMetrics = () => {
      metrics = items.map((item) => ({
        left: item.offsetLeft,
        width: Math.max(1, item.offsetWidth),
        height: Math.max(1, glider.offsetHeight || item.offsetHeight),
      }));
    };

    const ro = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(refreshMetrics) : null;
    ro?.observe(strip);

    const moveGlider = (idx: number) => {
      const m = metrics[idx];
      if (!m) return;
      const sx = Math.max(0.01, m.width / 100);
      const halfH = Math.min(m.width, m.height) * 0.5;
      glider.style.setProperty('--pill-rx', `${(halfH / sx).toFixed(2)}px`);
      glider.style.setProperty('--pill-ry', `${halfH.toFixed(2)}px`);
      glider.style.opacity = '1';
      glider.style.transform = `translate3d(${m.left.toFixed(1)}px, 0, 0) scaleX(${sx.toFixed(4)})`;
    };

    const hideGlider = () => {
      glider.style.opacity = '0';
    };

    items.forEach((item, idx) => {
      item.addEventListener('pointerenter', () => moveGlider(idx), { signal });
      item.addEventListener('focus', () => moveGlider(idx), { signal });
      item.addEventListener(
        'click',
        () => {
          const rect = item.getBoundingClientRect();
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 8);
        },
        { signal },
      );
    });

    strip.addEventListener('pointerleave', hideGlider, { signal });
    strip.addEventListener('focusout', (e: FocusEvent) => {
      if (!strip.contains(e.relatedTarget as Node)) hideGlider();
    }, { signal });

    (window as any)[GLIDER_CLEANUP_KEY] = () => {
      controller.abort();
      ro?.disconnect();
      (window as any)[GLIDER_CLEANUP_KEY] = undefined;
    };
  }

  function initArchiveFilter() {
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') previousCleanup();

    initArchiveStatsGlider();

    const bar = document.querySelector<HTMLElement>('[data-archive-filters]');
    const list = document.querySelector<HTMLElement>('[data-archive-list]');
    if (!bar || !list) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const chipsWrap = bar.querySelector<HTMLElement>('[data-archive-chips]');
    const inkPill = bar.querySelector<HTMLElement>('[data-archive-ink-pill]');
    const inkWhisper = bar.querySelector<HTMLElement>('[data-archive-ink-whisper]');
    const buttons = Array.from(bar.querySelectorAll<HTMLElement>('[data-filter]'));
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-category]'));
    const sections = Array.from(list.querySelectorAll<HTMLElement>('[data-archive-year]'));
    const sectionRows = new Map(
      sections.map((section) => [section, Array.from(section.querySelectorAll<HTMLElement>('[data-category]'))]),
    );
    const activeCounters: object[] = [];
    let active = 'all';
    let timeline: gsap.core.Timeline | null = null;

    // ---------- Sliding Ink Pill metrics (cached on init & ResizeObserver) ----------
    let chipMetrics = buttons.map((btn) => ({
      x: btn.offsetLeft,
      y: btn.offsetTop,
      w: Math.max(1, btn.offsetWidth),
      h: Math.max(1, btn.offsetHeight),
    }));

    const measureChips = () => {
      chipMetrics = buttons.map((btn) => ({
        x: btn.offsetLeft,
        y: btn.offsetTop,
        w: Math.max(1, btn.offsetWidth),
        h: Math.max(1, btn.offsetHeight),
      }));
    };

    const setBoxTransform = (el: HTMLElement, m: { x: number; y: number; w: number; h: number }) => {
      const sx = Math.max(0.01, m.w / 100);
      const sy = Math.max(0.01, m.h / 36);
      const r = Math.min(4, m.w * 0.5, m.h * 0.5);
      el.style.setProperty('--pill-rx', `${(r / sx).toFixed(2)}px`);
      el.style.setProperty('--pill-ry', `${(r / sy).toFixed(2)}px`);
      el.style.transform = `translate3d(${m.x.toFixed(1)}px, ${m.y.toFixed(1)}px, 0px) scale(${sx.toFixed(4)}, ${sy.toFixed(4)})`;
    };

    const syncInkPill = (filterName: string, animate: boolean) => {
      if (!inkPill || !chipsWrap) return;
      const idx = buttons.findIndex((b) => b.dataset.filter === filterName);
      const m = chipMetrics[idx];
      if (!m) return;
      chipsWrap.dataset.pillReady = 'true';
      if (!animate || reduceMotion) {
        inkPill.classList.add('is-instant');
        setBoxTransform(inkPill, m);
        inkPill.style.opacity = '1';
        requestAnimationFrame(() => inkPill.classList.remove('is-instant'));
      } else {
        inkPill.style.opacity = '1';
        setBoxTransform(inkPill, m);
      }
      if (inkWhisper) inkWhisper.style.opacity = '0';
    };

    measureChips();
    syncInkPill(active, false);

    const chipRo = typeof ResizeObserver !== 'undefined' && chipsWrap
      ? new ResizeObserver(() => {
          measureChips();
          syncInkPill(active, false);
        })
      : null;
    if (chipsWrap && chipRo) chipRo.observe(chipsWrap);

    document.fonts?.ready.then(() => {
      if (signal.aborted) return;
      measureChips();
      syncInkPill(active, false);
    });

    buttons.forEach((btn, idx) => {
      btn.addEventListener('pointerenter', () => {
        if (!inkWhisper || btn.classList.contains('is-active')) {
          if (inkWhisper) inkWhisper.style.opacity = '0';
          return;
        }
        const m = chipMetrics[idx];
        if (!m) return;
        setBoxTransform(inkWhisper, m);
        inkWhisper.style.opacity = '1';
      }, { signal });
    });

    chipsWrap?.addEventListener('pointerleave', () => {
      if (inkWhisper) inkWhisper.style.opacity = '0';
    }, { signal });

    function writeUrl(next: string) {
      const url = new URL(window.location.href);
      if (next === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', next);
      history.replaceState(null, '', url);
    }

    function countUp(section: HTMLElement, to: number, at: number, tl: gsap.core.Timeline) {
      const el = section.querySelector<HTMLElement>('[data-year-count]');
      if (!el) return;
      const from = Number.parseInt(el.textContent ?? '', 10);
      if (!Number.isFinite(from) || from === to) { el.textContent = entryLabel(to); return; }
      const counter = { value: from };
      activeCounters.push(counter);
      tl.to(counter, {
        value: to,
        duration: 0.52,
        ease: 'power2.out',
        onUpdate: () => { el.textContent = entryLabel(Math.max(0, Math.round(counter.value))); },
        onComplete: () => { el.textContent = entryLabel(to); },
      }, at);
    }

    function killActiveTimelineAndCommitSnapshot() {
      if (!timeline) return null;

      // 阶段 1：在清除任何内联样式前，一次性只读捕获半途被打断时的真实可见态，杜绝连点残影或瞬移闪烁
      const midRowVisible = new Map<HTMLElement, boolean>();
      items.forEach((el) => {
        if (el.classList.contains('is-filtered-out')) {
          midRowVisible.set(el, false);
          return;
        }
        const rect = el.getBoundingClientRect();
        const op = Number.parseFloat(getComputedStyle(el).opacity);
        // 若正处于收干退场且高度已收缩过半或透明度极低，视为已退场；否则视为仍在场
        const stillShown = rect.height > 6 && (Number.isNaN(op) || op > 0.14);
        midRowVisible.set(el, stillShown);
      });

      timeline.kill();
      timeline = null;
      activeCounters.forEach((c) => gsap.killTweensOf(c));
      activeCounters.length = 0;

      // 阶段 2：统一批量还原干净样式与确定性类名，0 累积高度误差
      items.forEach((el) => {
        const shown = Boolean(midRowVisible.get(el));
        gsap.killTweensOf(el);
        delete el.dataset.filterMotion;
        el.classList.toggle('is-filtered-out', !shown);
        gsap.set(el, { clearProps: ROW_PROPS });
        if (shown) settle(el);
      });

      sections.forEach((section) => {
        gsap.killTweensOf(section);
        const rows = sectionRows.get(section) ?? [];
        const hasVisible = rows.some((r) => !r.classList.contains('is-filtered-out'));
        section.classList.toggle('is-empty', !hasVisible);
        gsap.set(section, { clearProps: SECTION_PROPS });
      });

      return midRowVisible;
    }

    function apply(next: string, animate = true) {
      if (!items.length) return;
      active = next;
      buttons.forEach((button) => button.classList.toggle('is-active', button.dataset.filter === next));
      syncInkPill(next, animate);
      writeUrl(next);

      killActiveTimelineAndCommitSnapshot();

      const keep = (el: HTMLElement) => next === 'all' || el.dataset.category === next;

      if (!animate || reduceMotion) {
        items.forEach((el) => {
          const hide = !keep(el);
          const wasHidden = el.classList.contains('is-filtered-out');
          el.classList.toggle('is-filtered-out', hide);
          if (hide) {
            delete el.dataset.filterMotion;
            gsap.set(el, { clearProps: ROW_PROPS });
          } else if (wasHidden) {
            settle(el);
          }
        });
        sections.forEach((section) => {
          const visible = (sectionRows.get(section) ?? []).filter(keep).length;
          section.classList.toggle('is-empty', visible === 0);
          gsap.set(section, { clearProps: SECTION_PROPS });
          const countEl = section.querySelector('[data-year-count]');
          if (countEl) countEl.textContent = entryLabel(visible);
        });
        ScrollTrigger.refresh();
        return;
      }

      // ---------- 阶段 A：集中只读测量退场项与即将清空的年份块（无任何穿插写入） ----------
      const hiddenNow = new Map(items.map((el) => [el, el.classList.contains('is-filtered-out')]));
      const leaving = items.filter((el) => !hiddenNow.get(el) && !keep(el));
      const arriving = items.filter((el) => hiddenNow.get(el) && keep(el));

      const plan = sections.map((section) => {
        const rows = sectionRows.get(section) ?? [];
        return {
          section,
          visibleNext: rows.filter(keep).length,
          wasEmpty: section.classList.contains('is-empty') || rows.every((el) => hiddenNow.get(el)),
          willBeEmpty: !rows.some(keep),
        };
      });
      const closing = plan.filter((p) => !p.wasEmpty && p.willBeEmpty);
      const opening = plan.filter((p) => p.wasEmpty && !p.willBeEmpty);
      const closingSections = new Set(closing.map((p) => p.section));
      const openingSections = new Set(opening.map((p) => p.section));
      const inClosingSection = (el: HTMLElement) => {
        const sec = el.closest<HTMLElement>('[data-archive-year]');
        return Boolean(sec && closingSections.has(sec));
      };
      const inOpeningSection = (el: HTMLElement) => {
        const sec = el.closest<HTMLElement>('[data-archive-year]');
        return Boolean(sec && openingSections.has(sec));
      };

      const exits = leaving.map((el) => {
        const geo = measureRowGeometry(el);
        return {
          el,
          ...geo,
          collapse: !inClosingSection(el),
          onScreen:
            el.dataset.enterState === 'in' ||
            el.classList.contains('is-entered') ||
            el.classList.contains('is-entering') ||
            !document.documentElement.classList.contains('js-enter'),
        };
      });
      const closingMetrics = closing.map((p) => sectionBox(p.section));

      // ---------- 阶段 B：在同一微任务内批量展开进场项 → 集中只读量高 → 批量折回起点 ----------
      opening.forEach((p) => p.section.classList.remove('is-empty'));
      arriving.forEach((el) => {
        el.classList.remove('is-filtered-out');
        gsap.set(el, { clearProps: ROW_PROPS });
      });

      const entrances = arriving.map((el) => {
        const geo = measureRowGeometry(el);
        return {
          el,
          ...geo,
          expand: !inOpeningSection(el),
        };
      });
      const openingMetrics = opening.map((p) => sectionBox(p.section));

      entrances.forEach(({ el, origin, expand }) => {
        el.dataset.enterState = 'in';
        el.dataset.filterMotion = 'arriving';
        el.classList.remove('is-entering');
        el.classList.add('is-entered');
        gsap.set(el, {
          opacity: 0,
          x: -8,
          willChange: 'clip-path, opacity, transform, height',
          clipPath: `circle(0px at ${origin})`,
          ...(expand ? { height: 0, overflow: 'hidden' } : {}),
        });
      });
      openingMetrics.forEach(({ section }) => {
        gsap.set(section, {
          height: 0,
          marginTop: 0,
          marginBottom: 0,
          overflow: 'hidden',
          opacity: 0,
          willChange: 'height, opacity',
        });
      });

      // ---------- 阶段 C：构建墨迹收干与晕染渗开时间线 ----------
      const tl = gsap.timeline({
        onComplete: () => {
          items.forEach((el) => {
            delete el.dataset.filterMotion;
            if (el.classList.contains('is-filtered-out')) {
              gsap.set(el, { clearProps: ROW_PROPS });
            } else if (!keep(el)) {
              el.classList.add('is-filtered-out');
              gsap.set(el, { clearProps: ROW_PROPS });
            }
          });
          sections.forEach((section) => {
            const visible = (sectionRows.get(section) ?? []).filter(keep).length;
            section.classList.toggle('is-empty', visible === 0);
            gsap.set(section, { clearProps: SECTION_PROPS });
          });
          activeCounters.length = 0;
          ScrollTrigger.refresh();
          try { (window as any).lenis?.resize(); } catch {}
          timeline = null;
        },
      });
      timeline = tl;

      let visibleExitIndex = 0;
      exits.forEach(({ el, height, origin, radius, collapse, onScreen }) => {
        el.dataset.filterMotion = 'leaving';
        const at = onScreen ? visibleExitIndex++ * EXIT_STAGGER : 0;
        if (onScreen) {
          gsap.killTweensOf(el);
          tl.fromTo(
            el,
            {
              clipPath: `circle(${radius}px at ${origin})`,
              opacity: 1,
              x: 0,
              willChange: 'clip-path, opacity, transform, height',
            },
            {
              clipPath: `circle(0px at ${origin})`,
              opacity: 0,
              x: -10,
              duration: EXIT_CLIP,
              ease: 'power2.inOut',
            },
            at,
          );
        }
        if (!collapse) return;
        tl.set(el, { height, overflow: 'hidden' }, at);
        tl.to(el, {
          height: 0,
          duration: EXIT_COLLAPSE,
          ease: 'enter',
          onComplete: () => {
            el.classList.add('is-filtered-out');
            delete el.dataset.filterMotion;
            gsap.set(el, { clearProps: ROW_PROPS });
          },
        }, at + (onScreen ? 0.1 : 0));
      });

      closingMetrics.forEach(({ section, height, marginTop, marginBottom }, index) => {
        const at = index * 0.05;
        tl.set(section, { height, marginTop, marginBottom, overflow: 'hidden', willChange: 'height, opacity' }, at);
        tl.to(section, {
          height: 0,
          marginTop: 0,
          marginBottom: 0,
          opacity: 0,
          duration: SECTION_MOVE,
          ease: 'enter',
          onComplete: () => { section.classList.add('is-empty'); },
        }, at + 0.14);
      });

      exits.filter((exit) => !exit.collapse).forEach(({ el }) => {
        tl.call(() => {
          el.classList.add('is-filtered-out');
          delete el.dataset.filterMotion;
        }, undefined, EXIT_CLIP + 0.26);
      });

      openingMetrics.forEach(({ section, height, marginTop, marginBottom }, index) => {
        const at = ARRIVE_AT + index * 0.055;
        tl.to(section, {
          height,
          marginTop,
          marginBottom,
          opacity: 1,
          duration: SECTION_MOVE,
          ease: 'enter',
        }, at);
      });

      entrances.forEach(({ el, height, origin, radius, expand }, index) => {
        const at = ARRIVE_AT + index * ARRIVE_STAGGER;
        if (expand) {
          tl.to(el, { height, duration: ARRIVE_EXPAND, ease: 'enter' }, at);
        }
        tl.to(el, {
          clipPath: `circle(${radius}px at ${origin})`,
          opacity: 1,
          x: 0,
          duration: ARRIVE_CLIP,
          ease: 'enter',
          onComplete: () => settle(el),
        }, at);
      });

      plan.forEach((p) => countUp(p.section, p.visibleNext, p.willBeEmpty ? 0 : ARRIVE_AT, tl));

      if (!exits.length && !entrances.length && !closingMetrics.length && !openingMetrics.length) {
        tl.to({}, { duration: 0.01 });
      }
    }

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = button.dataset.filter || 'all';
        if (next === active) return;
        const rect = button.getBoundingClientRect();
        (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 7);
        apply(next);
      }, { signal });
    });

    // Deep link from a post's category label
    const wanted = new URL(window.location.href).searchParams.get('category');
    if (wanted && buttons.some((button) => button.dataset.filter === wanted)) apply(wanted, false);

    (window as any)[CLEANUP_KEY] = () => {
      controller.abort();
      chipRo?.disconnect();
      timeline?.kill();
      timeline = null;
      activeCounters.forEach((c) => gsap.killTweensOf(c));
      activeCounters.length = 0;
      (window as any)[CLEANUP_KEY] = undefined;
    };
  }

  initArchiveFilter();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initArchiveFilter);
    document.addEventListener('astro:before-swap', () => {
      (window as any)[CLEANUP_KEY]?.();
      (window as any)[GLIDER_CLEANUP_KEY]?.();
    });
    (window as any)[LISTENER_KEY] = true;
  }
</script>
