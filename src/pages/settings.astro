                      <span class="text-[11px] text-neutral-500 dark:text-neutral-400 font-medium truncate block leading-tight mt-0.5">
                        {shade.name}
                      </span>
                    </div>
                  </div>
                </div>

                <!-- 对比度与点评说明 -->
                <div class="mt-2 pt-2 border-t border-neutral-200/50 dark:border-neutral-800/60">
                  <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-neutral-200/70 dark:bg-neutral-800/80 text-neutral-700 dark:text-neutral-300 mb-1.5">
                    WCAG: {shade.contrast}
                  </span>
                  <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-snug line-clamp-2">
                    {shade.note}
                  </p>
                </div>
              </button>
            ))}
          </div>
        </section>

        <form id="settingsForm" class="space-y-8">
