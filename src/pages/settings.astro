            {MOSS_SHADES.map((shade) => (
              <button
                type="button"
                class={`shade-option-card relative overflow-hidden rounded-xl p-3 text-left border transition-[border-color,background-color,transform] duration-200 cursor-pointer flex flex-col justify-between group outline-none focus:outline-none ${
                  shade.id === '00796B' ? 'border-[#FFC2D1] shadow-sm' : 'border-neutral-200/80 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-950/40 hover:border-neutral-400 dark:hover:border-neutral-600'
                }`}
                data-moss-shade-card={shade.id}
                data-shade-name={shade.name}
                data-shade-hex={shade.hex}
                title={`点击应用 ${shade.name}`}
              >
                <div>
                  <!-- 实测截图缩略图 -->
                  <div class="relative w-full aspect-[16/10] rounded-lg overflow-hidden border border-neutral-300/60 dark:border-neutral-700/60 bg-neutral-900 mb-3 shadow-inner">
                    <picture>
                      <source srcset={shade.previewWebp} type="image/webp" />
                      <img
                        src={shade.previewPng}
                        alt={`${shade.name} 全景实测截图`}
                        class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-105 pointer-events-none"
                        loading="lazy"
                        decoding="async"
                        width="640"
                        height="400"
                      />
                    </picture>

                    {shade.isRecommended && (
                      <span class="absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#FFC2D1] text-[#004D40] shadow-sm tracking-tight pointer-events-none">
                        ★ 最佳推荐
                      </span>
                    )}

                    <span class="shade-active-badge hidden absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500 text-white shadow-sm tracking-tight flex items-center gap-0.5 pointer-events-none">
