---
import BaseLayout from '../layouts/BaseLayout.astro';

const MOSS_SHADES = [
  {
    id: '004D40',
    hex: '#004D40',
    name: 'Teal 900 (松石极墨)',
    contrast: '8.96:1 (AAA)',
    note: '深沉如墨松，对比度极高，偏厚重',
    previewWebp: '/assets/previews/shade_1_004D40.webp',
    previewPng: '/assets/previews/shade_1_004D40.png',
    isRecommended: false,
  },
  {
    id: '00695C',
    hex: '#00695C',
    name: 'Teal 800 (竹青墨韵)',
    contrast: '6.03:1 (AA)',
    note: '浓郁雅致，青翠如竹，兼顾护眼与辨识',
    previewWebp: '/assets/previews/shade_2_00695C.webp',
    previewPng: '/assets/previews/shade_2_00695C.png',
    isRecommended: false,
  },
  {
    id: '00796B',
    hex: '#00796B',
    name: 'Teal 700 (翡翠青玉 · 推荐)',
    contrast: '4.85:1 (AA)',
    note: '透亮青润，摆脱原版浑浊感与深暗感，粉墨相映极佳',
    previewWebp: '/assets/previews/shade_3_00796B.webp',
    previewPng: '/assets/previews/shade_3_00796B.png',
    isRecommended: true,
  },
  {
    id: '00897B',
    hex: '#00897B',
    name: 'Teal 600 (碧波苍青)',
    contrast: '3.93:1',
    note: '明亮通透，青意盎然，大字辨识度高',
    previewWebp: '/assets/previews/shade_4_00897B.webp',
    previewPng: '/assets/previews/shade_4_00897B.png',
    isRecommended: false,
  },
  {
    id: '4DB6AC',
    hex: '#4DB6AC',
    name: 'Teal 300 (清凉薄荷)',
    contrast: '2.23:1 (适配深墨)',
    note: '清爽明亮浅底，需配合深黛墨字呈现',
    previewWebp: '/assets/previews/shade_5_4DB6AC.webp',
    previewPng: '/assets/previews/shade_5_4DB6AC.png',
    isRecommended: false,
  },
];
---

<BaseLayout title="服务器设置 · 控制台" description="博客划词问答与服务运行时控制台" standalone={true}>
  <div class="settings-viewport w-full min-h-screen flex flex-col justify-between selection:bg-neutral-800 selection:text-neutral-100">
    <!-- 顶部状态栏 -->
    <header class="settings-header w-full border-b border-neutral-200/60 dark:border-neutral-800/80 bg-neutral-50/80 dark:bg-neutral-950/80 backdrop-blur-md sticky top-0 z-40 transition-colors">
      <div class="max-w-5xl w-full mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="settings-back-link flex items-center gap-1.5 text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-200 transition-colors" title="返回博客首页">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span class="hidden sm:inline font-mono">Home</span>
          </a>
          <span class="text-neutral-300 dark:text-neutral-700">/</span>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50 animate-pulse"></span>
            <span class="font-medium text-sm tracking-wide text-neutral-900 dark:text-neutral-100 font-mono">CONSOLE</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-200/70 dark:bg-neutral-800/70 text-neutral-600 dark:text-neutral-400 font-mono">settings</span>
          </div>
        </div>

        <div class="flex items-center gap-3" id="headerStatusGroup">
          <div id="serviceStatusBadge" class="hidden items-center gap-1.5 text-xs px-2.5 py-1 rounded-full font-mono border">
            <!-- 动态注入状态 -->
          </div>
          <button id="logoutBtn" type="button" class="hidden text-xs text-neutral-500 hover:text-rose-500 dark:hover:text-rose-400 font-mono transition-colors">
            退出登录
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex flex-col relative space-y-8 outline-none">
      <!-- 视图 1：密码解锁卡片 -->
      <section id="lockSection" class="flex-1 w-full min-h-[calc(100vh-9.5rem)] flex items-center justify-center my-auto py-8 transition-[transform,opacity] duration-300">
        <div class="settings-lock-card w-full max-w-md bg-white/85 dark:bg-neutral-900/85 backdrop-blur-xl border border-neutral-200/80 dark:border-neutral-800/80 rounded-2xl p-6 sm:p-8 shadow-xl shadow-neutral-900/5 relative overflow-hidden">
          <span class="settings-ink-hairline" aria-hidden="true"></span>
          <div class="w-12 h-12 mx-auto rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-700 dark:text-neutral-200 mb-5 border border-neutral-200/60 dark:border-neutral-700/60">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>

          <h2 class="text-center text-lg font-semibold text-neutral-900 dark:text-neutral-100 tracking-tight">
            服务器控制台 · 书斋密钥锁
          </h2>
          <p class="text-center text-xs text-neutral-500 dark:text-neutral-400 mt-1.5 mb-6">
            此页面受服务端管理密钥保护，请输入管理密钥以展开配置
          </p>

          <form id="loginForm" class="space-y-4">
            <div>
              <label for="adminPassword" class="block text-xs font-mono text-neutral-600 dark:text-neutral-400 mb-1.5">
                ADMIN PASSWORD
              </label>
              <div class="relative">
                <input
                  type="password"
                  id="adminPassword"
                  name="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••••••"
                  class="w-full px-3.5 py-2.5 rounded-lg text-sm bg-neutral-50 dark:bg-neutral-950/60 border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 focus:outline-none focus:border-neutral-700 dark:focus:border-neutral-300 transition-colors font-mono"
                />
                <button
                  type="button"
                  id="togglePasswordVisibility"
                  class="absolute right-2.5 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 text-xs px-1"
                  title="显示/隐藏密码"
                >
                  👁️
                </button>
              </div>
            </div>

            <div id="loginError" class="hidden text-xs text-rose-500 bg-rose-50 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 rounded-lg p-2.5 text-center"></div>

            <button
              type="submit"
              id="loginSubmitBtn"
              class="w-full py-2.5 px-4 rounded-lg bg-neutral-900 dark:bg-neutral-100 text-neutral-100 dark:text-neutral-900 text-sm font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-[background-color,transform] duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-sm active:scale-[0.99]"
            >
              <span id="loginBtnText">验证密钥并启卷</span>
              <svg id="loginSpinner" class="hidden animate-spin h-4 w-4 text-current" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </form>

          <div class="mt-6 pt-5 border-t border-neutral-100 dark:border-neutral-800/60 text-center">
            <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-mono">
              密码哈希配置于 /etc/blog-ask.env
            </span>
          </div>
        </div>
      </section>

      <!-- 视图 2：控制台工作台 -->
      <section id="workbenchSection" class="hidden w-full space-y-8 pb-24 transition-[transform,opacity] duration-300">
        <!-- 统计面板条 -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-white/70 dark:bg-neutral-900/70 border border-neutral-200/70 dark:border-neutral-800/70">
            <div class="text-xs text-neutral-500 font-mono">服务状态</div>
            <div class="mt-1 flex items-center gap-2">
              <span id="statConfiguredDot" class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span id="statConfiguredText" class="text-sm font-medium text-neutral-900 dark:text-neutral-100">已就绪</span>
            </div>
          </div>
          <div class="p-4 rounded-xl bg-white/70 dark:bg-neutral-900/70 border border-neutral-200/70 dark:border-neutral-800/70">
            <div class="text-xs text-neutral-500 font-mono">今日问答调用</div>
            <div class="mt-1 flex items-baseline gap-1.5">
              <span id="statDailyUsed" class="text-xl font-bold font-mono text-neutral-900 dark:text-neutral-100">0</span>
              <span class="text-xs text-neutral-400 font-mono">/ <span id="statDailyLimit">800</span> 次</span>
            </div>
          </div>
          <div class="p-4 rounded-xl bg-white/70 dark:bg-neutral-900/70 border border-neutral-200/70 dark:border-neutral-800/70">
            <div class="text-xs text-neutral-500 font-mono">已缓存答案条数</div>
            <div class="mt-1 flex items-center justify-between">
              <span id="statCacheCount" class="text-xl font-bold font-mono text-neutral-900 dark:text-neutral-100">0</span>
              <button
                type="button"
                id="quickClearCacheBtn"
                class="text-xs text-rose-500 hover:text-rose-600 dark:hover:text-rose-400 border border-rose-200 dark:border-rose-900/60 rounded px-2 py-0.5 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors"
              >
                清空缓存
              </button>
            </div>
          </div>
        </div>

        <!-- 模块 -1：纸境书斋 · 四境主题涟漪、墨玉滑块与兰亭字韵调校 -->
        <section id="paperStudioSection" class="settings-studio-card w-full bg-white/85 dark:bg-neutral-900/85 backdrop-blur-xl border border-neutral-200/80 dark:border-neutral-800/80 rounded-2xl p-6 sm:p-7 shadow-sm relative overflow-hidden">
          <span class="settings-ink-hairline" aria-hidden="true"></span>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-neutral-100 dark:border-neutral-800/70">
            <div class="flex items-start sm:items-center gap-3">
              <div class="p-2.5 rounded-xl bg-neutral-100/90 dark:bg-neutral-800/70 text-neutral-700 dark:text-neutral-200 border border-neutral-200/80 dark:border-neutral-700/70 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 tracking-tight">
                    纸境书斋 · 墨玉开关与字韵调校
                  </h2>
                  <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200/80 dark:border-neutral-700/70 font-mono">
                    Ink-Jade Studio
                  </span>
                </div>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
                  点选纸境主题即荡开对应色泽的水墨涟漪；拨动墨玉阻尼滑块与字号标尺，实时预览书卷字韵
                </p>
              </div>
            </div>
          </div>

          <!-- 1) 四境纸色预览卡（点击荡开主题色水墨涟漪） -->
          <div class="mb-6">
            <div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-2.5 flex items-center justify-between">
              <span>THEME PALETTE · 四境纸色水墨涟漪预演</span>
              <span id="activeThemeLabel" class="font-semibold text-neutral-800 dark:text-neutral-200">宣纸素白</span>
            </div>
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3" id="themePreviewGrid">
              <button
                type="button"
                class="theme-preview-card"
                data-theme-preview-card="light"
                data-ripple-color="#141517"
                data-theme-label="宣纸素白 (Light)"
                style="--card-paper:#faf8f4; --card-ink:#141517; --card-accent:#141517;"
              >
                <span class="theme-preview-swatch">
                  <span class="swatch-line is-title"></span>
                  <span class="swatch-line"></span>
                  <span class="swatch-dot" aria-hidden="true"></span>
                </span>
                <span class="theme-preview-meta">
                  <strong>宣纸素白</strong>
                  <small>素笺乌丝 · 清透淡墨</small>
                </span>
              </button>

              <button
                type="button"
                class="theme-preview-card"
                data-theme-preview-card="dark"
                data-ripple-color="#d4d0c8"
                data-theme-label="松烟玄夜 (Dark)"
                style="--card-paper:#15161a; --card-ink:#f2efe9; --card-accent:#d4d0c8;"
              >
                <span class="theme-preview-swatch">
                  <span class="swatch-line is-title"></span>
                  <span class="swatch-line"></span>
                  <span class="swatch-dot" aria-hidden="true"></span>
                </span>
                <span class="theme-preview-meta">
                  <strong>松烟玄夜</strong>
                  <small>玄砚沉墨 · 灯火温润</small>
                </span>
              </button>

              <button
                type="button"
                class="theme-preview-card"
                data-theme-preview-card="moss"
                data-ripple-color="#FFC2D1"
                data-theme-label="竹青粉墨 (Moss)"
                style="--card-paper:#00796B; --card-ink:#FFF1F4; --card-accent:#FFC2D1;"
              >
                <span class="theme-preview-swatch">
                  <span class="swatch-line is-title"></span>
                  <span class="swatch-line"></span>
                  <span class="swatch-dot" aria-hidden="true"></span>
                </span>
                <span class="theme-preview-meta">
                  <strong>竹青粉墨</strong>
                  <small>翡翠青玉 · 桃粉映墨</small>
                </span>
              </button>

              <button
                type="button"
                class="theme-preview-card"
                data-theme-preview-card="rice"
                data-ripple-color="#6B5B45"
                data-theme-label="古籍米黄 (Rice)"
                style="--card-paper:#ebe0cb; --card-ink:#2c2218; --card-accent:#6B5B45;"
              >
                <span class="theme-preview-swatch">
                  <span class="swatch-line is-title"></span>
                  <span class="swatch-line"></span>
                  <span class="swatch-dot" aria-hidden="true"></span>
                </span>
                <span class="theme-preview-meta">
                  <strong>古籍米黄</strong>
                  <small>旧藏善本 · 温润护目</small>
                </span>
              </button>
            </div>
          </div>

          <!-- 2) 墨玉弹性阻尼开关 + 3) 书体与字号平滑试墨台 -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-5 border-t border-neutral-100 dark:border-neutral-800/70">
            <!-- 左侧：墨玉滑块组 -->
            <div class="space-y-3.5">
              <div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-1">
                INK-JADE SWITCHES · 墨玉弹性阻尼开关
              </div>

              <div class="ink-jade-row">
                <div class="min-w-0 pr-3">
                  <div class="text-xs font-semibold text-neutral-900 dark:text-neutral-100">水墨游丝笔迹拖尾</div>
                  <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">控制全站指针移动时的宣纸水墨飞白拖尾</div>
                </div>
                <button
                  type="button"
                  id="switchCursorTrail"
                  role="switch"
                  aria-checked="true"
                  aria-label="切换水墨游丝笔迹拖尾"
                  class="ink-jade-switch is-on"
                >
                  <span class="ink-jade-thumb" aria-hidden="true"></span>
                </button>
              </div>

              <div class="ink-jade-row">
                <div class="min-w-0 pr-3">
                  <div class="text-xs font-semibold text-neutral-900 dark:text-neutral-100">点染主题水墨涟漪</div>
                  <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">点击纸色卡片与青玉色阶时荡开同色水墨水纹</div>
                </div>
                <button
                  type="button"
                  id="switchInkRipple"
                  role="switch"
                  aria-checked="true"
                  aria-label="切换点染主题水墨涟漪"
                  class="ink-jade-switch is-on"
                >
                  <span class="ink-jade-thumb" aria-hidden="true"></span>
                </button>
              </div>

              <div class="ink-jade-row">
                <div class="min-w-0 pr-3">
                  <div class="text-xs font-semibold text-neutral-900 dark:text-neutral-100">选取远端模型后自动测活</div>
                  <div class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-0.5">在远端模型库点选模型时即刻发起低延迟连通探测</div>
                </div>
                <button
                  type="button"
                  id="switchAutoPingModel"
                  role="switch"
                  aria-checked="false"
                  aria-label="切换选取远端模型后自动测活"
                  class="ink-jade-switch"
                >
                  <span class="ink-jade-thumb" aria-hidden="true"></span>
                </button>
              </div>
            </div>

            <!-- 右侧：字体与字号实时试墨笺 -->
            <div class="space-y-3.5">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">TYPOGRAPHY · 书体与字号实时试墨</span>
                <div class="settings-font-seg" id="settingsFontSeg" role="group" aria-label="全站主书体切换">
                  <span class="settings-font-glider" id="settingsFontGlider" aria-hidden="true"></span>
                  <button type="button" class="settings-font-btn is-active" data-font-choice="pixel">像素碑刻</button>
                  <button type="button" class="settings-font-btn" data-font-choice="kai">行云手书</button>
                </div>
              </div>

              <div class="flex items-center gap-3">
                <span class="text-xs font-mono text-neutral-500 shrink-0">字号比例</span>
                <input
                  type="range"
                  id="fontScaleRange"
                  min="92"
                  max="116"
                  step="2"
                  value="100"
                  aria-label="调整阅读字号比例"
                  class="ink-jade-range flex-1"
                />
                <span id="fontScaleBadge" class="text-xs font-mono font-bold text-neutral-800 dark:text-neutral-200 w-12 text-right">100%</span>
              </div>

              <div id="fontLiveSpecimen" class="settings-specimen-box">
                <span class="specimen-shimmer" id="specimenShimmer" aria-hidden="true"></span>
                <div class="specimen-head">
                  <span class="specimen-pill">试墨预览</span>
                  <span id="specimenMetaText" class="font-mono text-[11px] text-neutral-500 dark:text-neutral-400">像素碑刻 · 100%</span>
                </div>
                <p id="specimenBodyText" class="specimen-body">
                  纸上得来终觉浅，绝知此事要躬行。落笔生枝蔓，水墨润清音。
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- 模块 0：绿粉主题色阶定制 (控制台已验证解锁后可用，全站即时生效) -->
        <section id="mossShadesSection" class="w-full bg-white/80 dark:bg-neutral-900/80 backdrop-blur-xl border border-neutral-200/80 dark:border-neutral-800/80 rounded-2xl p-6 sm:p-7 shadow-sm transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-neutral-100 dark:border-neutral-800/70">
            <div class="flex items-start sm:items-center gap-3">
              <div class="p-2.5 rounded-xl bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200/60 dark:border-teal-800/50 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21a4 4 0 01-4-4 4 4 0 014-4c.94 0 1.8.33 2.47.88L14 9.35a4 4 0 015.53-5.53 4 4 0 010 5.66l-4.53 4.53A4 4 0 0111 17a4 4 0 01-4 4z"></path>
                </svg>
              </div>
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100 tracking-tight">
                    绿粉主题色阶全景实测与切换
                  </h2>
                  <span class="text-xs px-2 py-0.5 rounded-full bg-teal-100/80 dark:bg-teal-900/60 text-teal-800 dark:text-teal-200 font-mono">
                    Moss Theme Shades
                  </span>
                </div>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
                  基准粉色字 (#FFF1F4) · 默认推荐翡翠青玉 #00796B，点击任一色卡即刻热切换全站生效并持久化
                </p>
              </div>
