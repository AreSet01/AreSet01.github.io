              />
              <select
                id="inviteTtl"
                class="px-3 py-2 rounded-lg text-sm bg-neutral-50 dark:bg-neutral-950/60 border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 focus:outline-none font-mono"
              >
                <option value="7">7 天有效</option>
                <option value="30">30 天有效</option>
                <option value="90">90 天有效</option>
              </select>
              <button
                type="button"
                id="generateInviteBtn"
                class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-semibold tracking-wide font-mono transition-[background-color,transform] duration-200 cursor-pointer active:scale-95"
              >
                生成邀请码
              </button>
            </div>

            <div id="inviteList" class="space-y-2 mb-6 text-xs text-neutral-500 dark:text-neutral-400">
              正在读取邀请码…
            </div>

            <div class="pt-5 border-t border-neutral-100 dark:border-neutral-800/70">
              <h4 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 mb-3">已注册账号</h4>
              <div id="accountList" class="space-y-2 text-xs text-neutral-500 dark:text-neutral-400">
                正在读取账号…
              </div>
            </div>
          </div>

          <div class="sticky bottom-6 z-30 p-4 rounded-2xl bg-neutral-900/90 dark:bg-neutral-100/90 text-neutral-100 dark:text-neutral-900 backdrop-blur-xl shadow-2xl flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4 border border-neutral-800 dark:border-neutral-200">
            <div class="flex items-center gap-2 text-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="font-mono">保存后即刻热重载生效，无需重启进程</span>
            </div>

            <button
              type="submit"
              id="saveConfigBtn"
              class="px-6 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-semibold tracking-wider font-mono transition-[background-color,transform] duration-200 flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-emerald-500/20 active:scale-95"
            >
              <span id="saveBtnText">保存并应用配置</span>
              <svg id="saveSpinner" class="hidden animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
            </button>
          </div>
        </form>
      </section>
    </main>

    <!-- 底部状态声明 -->
    <footer class="w-full py-4 border-t border-neutral-200/40 dark:border-neutral-800/40 text-center text-[11px] text-neutral-400 font-mono">
      <span>Blog Runtime Control Center · AreSet01</span>
    </footer>

    <!-- Toast 提示容器 -->
    <div id="toast" class="fixed top-6 right-6 z-50 transform translate-y-[-20px] opacity-0 pointer-events-none transition-[transform,opacity] duration-300 max-w-sm px-4 py-3 rounded-xl shadow-xl text-xs font-medium flex items-center gap-2 border"></div>
  </div>

  <script is:inline data-astro-rerun>
    (function () {
      const CLEANUP_KEY = '__areSetSettingsCleanup__';
      if (typeof window[CLEANUP_KEY] === 'function') {
        window[CLEANUP_KEY]();
      }
      const settingsAbort = new AbortController();
      const { signal } = settingsAbort;

      const STORAGE_KEY = 'blog_settings_token';
      let currentToken = sessionStorage.getItem(STORAGE_KEY) || '';
      let fetchedModelsList = [];

      const lockSection = document.getElementById('lockSection');
      const workbenchSection = document.getElementById('workbenchSection');
      if (!lockSection && !workbenchSection) return;
      const logoutBtn = document.getElementById('logoutBtn');
      const headerStatusGroup = document.getElementById('headerStatusGroup');
      const serviceStatusBadge = document.getElementById('serviceStatusBadge');
      const toast = document.getElementById('toast');

      // Toast 提示（仅合成 transform 与 opacity）
      function showToast(message, type = 'success') {
        if (!toast) return;
        toast.textContent = message;
        toast.className = `fixed top-6 right-6 z-50 transition-[transform,opacity] duration-300 max-w-sm px-4 py-3 rounded-xl shadow-xl text-xs font-medium flex items-center gap-2 border ${
          type === 'success'
            ? 'bg-emerald-950 text-emerald-200 border-emerald-800'
            : 'bg-rose-950 text-rose-200 border-rose-800'
        }`;
        toast.style.transform = 'translate3d(0, 0, 0)';
        toast.style.opacity = '1';
        toast.style.pointerEvents = 'auto';

        clearTimeout(toast.__timer);
        toast.__timer = setTimeout(() => {
          toast.style.transform = 'translate3d(0, -20px, 0)';
          toast.style.opacity = '0';
          toast.style.pointerEvents = 'none';
        }, 3200);
      }

      // GPU 水墨涟漪生成器（点击主题/色阶预览卡片时荡开对应主题色涟漪，零重排）
      function spawnSettingsInkRipple(hostEl, evt, rippleHex) {
        if (!hostEl || typeof hostEl.getBoundingClientRect !== 'function') return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          if (localStorage.getItem('settings-ink-ripple') === '0') return;
        } catch (e) {}

        const rect = hostEl.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const cx = evt && typeof evt.clientX === 'number' && evt.clientX > 0
          ? evt.clientX - rect.left
          : rect.width / 2;
        const cy = evt && typeof evt.clientY === 'number' && evt.clientY > 0
          ? evt.clientY - rect.top
          : rect.height / 2;
        const maxRadius = Math.hypot(Math.max(cx, rect.width - cx), Math.max(cy, rect.height - cy)) * 2.15;

        const ripple = document.createElement('span');
        ripple.className = 'settings-ink-ripple';
        ripple.style.width = `${maxRadius.toFixed(1)}px`;
        ripple.style.height = `${maxRadius.toFixed(1)}px`;
        ripple.style.left = `${cx.toFixed(1)}px`;
        ripple.style.top = `${cy.toFixed(1)}px`;
        ripple.style.setProperty('--ripple-color', rippleHex || '#141517');
        hostEl.appendChild(ripple);

        if (typeof ripple.animate === 'function') {
          const anim = ripple.animate(
            [
              { transform: 'translate3d(-50%, -50%, 0) scale(0.08)', opacity: 0.48 },
              { transform: 'translate3d(-50%, -50%, 0) scale(1)', opacity: 0 },
            ],
            { duration: 580, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' }
          );
          anim.onfinish = () => ripple.remove();
        } else {
          setTimeout(() => ripple.remove(), 600);
        }
      }
      window.__spawnSettingsInkRipple = spawnSettingsInkRipple;

      // 绿粉主题色阶选择器交互与热切换
      function initMossShadeSelector() {
        const shadeCards = document.querySelectorAll('[data-moss-shade-card]');
        const resetBtn = document.getElementById('resetShadeBtn');
        if (!shadeCards.length) return;

        function getActiveShade() {
          try {
            const stored = localStorage.getItem('moss-shade');
            if (stored) {
              const norm = stored.trim().replace(/^#/, '').toUpperCase();
              if (['004D40', '00695C', '00796B', '00897B', '4DB6AC'].includes(norm)) {
                return norm;
              }
            }
          } catch (e) {}
          return '00796B';
        }

        function updateShadeUi(activeShade) {
          shadeCards.forEach((card) => {
            const cardShade = card.getAttribute('data-moss-shade-card');
            const isActive = cardShade === activeShade;
            const badge = card.querySelector('.shade-active-badge');

            if (isActive) {
              card.classList.add('is-active', 'ring-2', 'ring-[#FFC2D1]', 'border-[#FFC2D1]', 'bg-[#FFC2D1]/10');
              card.classList.remove('border-neutral-200/80', 'dark:border-neutral-800');
              card.setAttribute('aria-pressed', 'true');
              if (badge) badge.classList.remove('hidden');
            } else {
              card.classList.remove('is-active', 'ring-2', 'ring-[#FFC2D1]', 'border-[#FFC2D1]', 'bg-[#FFC2D1]/10');
              card.classList.add('border-neutral-200/80', 'dark:border-neutral-800');
              card.setAttribute('aria-pressed', 'false');
              if (badge) badge.classList.add('hidden');
            }
          });
        }

        function applyShade(shade, name) {
          if (typeof window.__setMossShade === 'function') {
            window.__setMossShade(shade);
          } else {
            try { localStorage.setItem('moss-shade', shade); } catch (e) {}
            document.documentElement.setAttribute('data-theme', 'moss');
            document.documentElement.setAttribute('data-moss-shade', shade);
          }
          updateShadeUi(shade);
          showToast(`已切换绿粉主题色阶：${name || shade} (#${shade})`);
        }

        updateShadeUi(getActiveShade());

        const mossSig = typeof signal !== 'undefined' ? signal : undefined;

        shadeCards.forEach((card) => {
          card.addEventListener('click', (e) => {
            const shade = card.getAttribute('data-moss-shade-card');
            const name = card.getAttribute('data-shade-name') || shade;
            if (typeof window.__spawnSettingsInkRipple === 'function' && typeof card.getBoundingClientRect === 'function') {
              window.__spawnSettingsInkRipple(card, e, card.getAttribute('data-shade-hex') || `#${shade}`);
            }
            if (shade) applyShade(shade, name);
          }, { signal: mossSig });
        });

        resetBtn?.addEventListener('click', () => {
          applyShade('00796B', 'Teal 700 (翡翠青玉 · 推荐)');
        }, { signal: mossSig });

        window.addEventListener('theme-change', () => {
          updateShadeUi(getActiveShade());
        }, { signal: mossSig });
      }

      initMossShadeSelector();

      // 纸境书斋：四境主题水墨涟漪、墨玉阻尼滑块与字韵平滑反馈
      let autoPingOnSelect = false;
      function initPaperStudioControls() {
        const themeCards = Array.from(document.querySelectorAll('[data-theme-preview-card]'));
        const activeThemeLabel = document.getElementById('activeThemeLabel');
        const switchTrail = document.getElementById('switchCursorTrail');
        const switchRipple = document.getElementById('switchInkRipple');
        const switchAutoPing = document.getElementById('switchAutoPingModel');
        const fontSeg = document.getElementById('settingsFontSeg');
        const fontGlider = document.getElementById('settingsFontGlider');
        const fontBtns = Array.from(document.querySelectorAll('[data-font-choice]'));
        const fontScaleRange = document.getElementById('fontScaleRange');
        const fontScaleBadge = document.getElementById('fontScaleBadge');
        const specimenBox = document.getElementById('fontLiveSpecimen');
        const specimenBody = document.getElementById('specimenBodyText');
        const specimenMeta = document.getElementById('specimenMetaText');
        const specimenShimmer = document.getElementById('specimenShimmer');

        const THEME_NAMES = {
          light: '宣纸素白 (Light)',
          dark: '松烟玄夜 (Dark)',
          moss: '竹青粉墨 (Moss)',
          rice: '古籍米黄 (Rice)',
        };

        function syncThemeCards() {
          const curTheme = document.documentElement.getAttribute('data-theme') || 'light';
          if (activeThemeLabel) activeThemeLabel.textContent = THEME_NAMES[curTheme] || curTheme;
          themeCards.forEach((card) => {
            const match = card.getAttribute('data-theme-preview-card') === curTheme;
            card.classList.toggle('is-active', match);
            card.setAttribute('aria-pressed', String(match));
          });
        }

        themeCards.forEach((card) => {
          card.addEventListener('click', (e) => {
            const nextTheme = card.getAttribute('data-theme-preview-card') || 'light';
            const rippleHex = card.getAttribute('data-ripple-color') || '#141517';
            spawnSettingsInkRipple(card, e, rippleHex);
            if (typeof window.__applyTheme === 'function') {
              window.__applyTheme(nextTheme);
            } else {
              try { localStorage.setItem('theme', nextTheme); } catch {}
              document.documentElement.setAttribute('data-theme', nextTheme);
              if (nextTheme === 'moss') {
                const shade = (localStorage.getItem('moss-shade') || '00796B').replace(/^#/, '');
                document.documentElement.setAttribute('data-moss-shade', shade);
              } else {
                document.documentElement.removeAttribute('data-moss-shade');
              }
              const meta = document.querySelector('meta[name="theme-color"]');
              const mossShade = document.documentElement.getAttribute('data-moss-shade');
              const barColor =
                nextTheme === 'dark' ? '#0a0a0a' :
                nextTheme === 'moss' ? (mossShade ? '#' + mossShade : '#00796B') :
                nextTheme === 'rice' ? '#F2E9D8' : '#ffffff';
              if (meta) meta.setAttribute('content', barColor);
              document.documentElement.style.colorScheme = (nextTheme === 'light' || nextTheme === 'rice') ? 'light' : 'dark';
              window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: nextTheme } }));
            }
            syncThemeCards();
            showToast(`已展开「${THEME_NAMES[nextTheme] || nextTheme}」纸境主题`);
          }, { signal });
        });

        window.addEventListener('theme-change', syncThemeCards, { signal });
        syncThemeCards();

        // 墨玉弹性阻尼滑块绑定
        function bindInkJadeSwitch(btn, initialOn, onChange) {
          if (!btn) return () => {};
          const setVisual = (on) => {
            btn.classList.toggle('is-on', on);
            btn.setAttribute('aria-checked', String(on));
          };
          setVisual(initialOn);
          btn.addEventListener('click', () => {
            const next = !btn.classList.contains('is-on');
            setVisual(next);
            onChange(next);
          }, { signal });
          return setVisual;
        }

        const readTrailEnabled = () => {
          if (typeof window.__isCursorTrailDisabled === 'function') {
            return !window.__isCursorTrailDisabled();
          }
          try {
            if (localStorage.getItem('cursor-trail') === 'disabled') return false;
          } catch {}
          return document.documentElement.getAttribute('data-cursor-trail') !== 'disabled';
        };

        let trailOn = readTrailEnabled();
        let rippleOn = true;
        try {
          rippleOn = localStorage.getItem('settings-ink-ripple') !== '0';
          autoPingOnSelect = localStorage.getItem('settings-auto-ping') === '1';
        } catch {}

        const setSwitchTrailVisual = bindInkJadeSwitch(switchTrail, trailOn, (on) => {
          if (typeof window.__setCursorTrailDisabled === 'function') {
            window.__setCursorTrailDisabled(!on);
          } else if (on) {
            try { localStorage.removeItem('cursor-trail'); } catch {}
            document.documentElement.removeAttribute('data-cursor-trail');
          } else {
            try { localStorage.setItem('cursor-trail', 'disabled'); } catch {}
            document.documentElement.setAttribute('data-cursor-trail', 'disabled');
            if (typeof window.__clearCursorTrail === 'function') window.__clearCursorTrail();
          }
          window.dispatchEvent(new CustomEvent('cursor-trail-change', { detail: { enabled: on } }));
          showToast(on ? '已开启水墨游丝笔迹拖尾' : '已收敛水墨笔迹拖尾');
        });

        bindInkJadeSwitch(switchRipple, rippleOn, (on) => {
          try { localStorage.setItem('settings-ink-ripple', on ? '1' : '0'); } catch {}
          showToast(on ? '已开启主题卡片水墨涟漪' : '已静默水墨涟漪反馈');
        });

        bindInkJadeSwitch(switchAutoPing, autoPingOnSelect, (on) => {
          autoPingOnSelect = on;
          try { localStorage.setItem('settings-auto-ping', on ? '1' : '0'); } catch {}
          showToast(on ? '已开启选取模型后即刻测活' : '已关闭自动模型测活');
        });

        // 书体分段游标 + 阅读字号平滑预览（严格对齐 BaseLayout 'site-font': 'pixel' | 'kai' 与 html[data-font="kai"]）
        let currentFont = 'pixel';
        let currentScale = 100;
        try {
          const savedFont = localStorage.getItem('site-font');
          if (savedFont === 'kai' || savedFont === 'pixel') {
            currentFont = savedFont;
          } else if (document.documentElement.getAttribute('data-font') === 'kai') {
            currentFont = 'kai';
          }
          const savedScale = Number(localStorage.getItem('blog-reading-scale'));
          if (savedScale >= 92 && savedScale <= 116) currentScale = savedScale;
        } catch {}

        function syncFontGlider(immediate = false) {
          if (!fontSeg || !fontGlider) return;
          const activeBtn = fontSeg.querySelector('.settings-font-btn.is-active');
          if (!activeBtn || !activeBtn.offsetWidth) return;
          const sx = Math.max(0.05, activeBtn.offsetWidth / 100);
          fontGlider.style.setProperty('--pill-rx', `${(6 / sx).toFixed(2)}px`);
          const nextTransform = `translate3d(${activeBtn.offsetLeft}px, 0, 0) scaleX(${sx.toFixed(4)})`;
          if (immediate) {
            fontGlider.style.transition = 'none';
            fontGlider.style.transform = nextTransform;
            requestAnimationFrame(() => {
              if (fontGlider) fontGlider.style.transition = '';
            });
          } else {
            fontGlider.style.transform = nextTransform;
          }
        }

        function triggerSpecimenShimmer() {
          if (!specimenShimmer || typeof specimenShimmer.animate !== 'function') return;
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          specimenShimmer.animate(
            [
              { opacity: 0, transform: 'translate3d(-55%, 0, 0)' },
              { opacity: 0.75, offset: 0.45 },
              { opacity: 0, transform: 'translate3d(55%, 0, 0)' },
            ],
            { duration: 520, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
          );
        }

        function applyTypographyState(animateFeedback = false) {
          fontBtns.forEach((b) => {
            b.classList.toggle('is-active', b.getAttribute('data-font-choice') === currentFont);
          });
          syncFontGlider(!animateFeedback);
          if (fontScaleRange) fontScaleRange.value = String(currentScale);
          if (fontScaleBadge) fontScaleBadge.textContent = `${currentScale}%`;
          if (specimenBox) {
            specimenBox.setAttribute('data-specimen-font', currentFont);
            specimenBox.style.setProperty('--specimen-scale', (currentScale / 100).toFixed(3));
          }
          if (specimenMeta) {
            specimenMeta.textContent = `${currentFont === 'kai' ? '行云手书' : '像素碑刻'} · ${currentScale}%`;
          }
          if (animateFeedback) {
            triggerSpecimenShimmer();
            if (specimenBody && typeof specimenBody.animate === 'function' && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
              specimenBody.animate(
                [
                  { opacity: 0.65, transform: 'translate3d(0, 3px, 0)' },
                  { opacity: 1, transform: 'translate3d(0, 0, 0)' },
                ],
                { duration: 240, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
              );
            }
          }
        }

        fontBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const chosen = btn.getAttribute('data-font-choice') === 'kai' ? 'kai' : 'pixel';
            if (chosen === currentFont) return;
            currentFont = chosen;
            try { localStorage.setItem('site-font', currentFont); } catch {}
            if (typeof window.__transitionFont === 'function') {
              window.__transitionFont(currentFont, btn);
            } else if (typeof window.__applyFont === 'function') {
              window.__applyFont(currentFont);
            } else if (currentFont === 'kai') {
              document.documentElement.setAttribute('data-font', 'kai');
              window.dispatchEvent(new CustomEvent('font-change', { detail: { font: 'kai' } }));
            } else {
              document.documentElement.removeAttribute('data-font');
              window.dispatchEvent(new CustomEvent('font-change', { detail: { font: 'pixel' } }));
            }
            applyTypographyState(true);
            showToast(`已切换书体为「${currentFont === 'kai' ? '行云手书' : '像素碑刻'}」`);
          }, { signal });
        });

        window.addEventListener('font-change', (e) => {
          const next = e?.detail?.font === 'kai' || document.documentElement.getAttribute('data-font') === 'kai' ? 'kai' : 'pixel';
          if (next !== currentFont) {
            currentFont = next;
            applyTypographyState(false);
          }
        }, { signal });

        if (typeof MutationObserver !== 'undefined') {
          const rootAttrMO = new MutationObserver(() => {
            setSwitchTrailVisual(readTrailEnabled());
            const domFont = document.documentElement.getAttribute('data-font') === 'kai' ? 'kai' : 'pixel';
            if (domFont !== currentFont) {
              currentFont = domFont;
              applyTypographyState(false);
            }
          });
          rootAttrMO.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['data-cursor-trail', 'data-font'],
          });
          signal.addEventListener('abort', () => rootAttrMO.disconnect(), { once: true });
        }

        fontScaleRange?.addEventListener('input', (e) => {
          currentScale = Number(e.target.value) || 100;
          try { localStorage.setItem('blog-reading-scale', String(currentScale)); } catch {}
          document.documentElement.style.setProperty('--reading-font-scale', (currentScale / 100).toFixed(3));
          applyTypographyState(false);
        }, { signal });
        fontScaleRange?.addEventListener('change', () => {
          triggerSpecimenShimmer();
        }, { signal });

        requestAnimationFrame(() => applyTypographyState(false));
      }

      initPaperStudioControls();

      // 切换视图（含水墨启卷平滑入场）
      function setAuthedState(authed, animateUnfurl = false) {
        if (authed) {
          lockSection.classList.add('hidden');
          workbenchSection.classList.remove('hidden');
          logoutBtn.classList.remove('hidden');
          serviceStatusBadge.classList.remove('hidden');
          serviceStatusBadge.classList.add('flex');
          requestAnimationFrame(() => {
            const seg = document.getElementById('settingsFontSeg');
            const glider = document.getElementById('settingsFontGlider');
            const active = seg?.querySelector('.settings-font-btn.is-active');
            if (glider && active && active.offsetWidth) {
              const sx = Math.max(0.05, active.offsetWidth / 100);
              glider.style.setProperty('--pill-rx', `${(6 / sx).toFixed(2)}px`);
              glider.style.transform = `translate3d(${active.offsetLeft}px, 0, 0) scaleX(${sx.toFixed(4)})`;
            }
          });
          if (animateUnfurl && workbenchSection && typeof workbenchSection.animate === 'function' && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
            workbenchSection.animate(
              [
                { opacity: 0, transform: 'translate3d(0, 16px, 0) scale(0.99)' },
                { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
              ],
              { duration: 420, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
            );
          }
        } else {
          lockSection.classList.remove('hidden');
          workbenchSection.classList.add('hidden');
          logoutBtn.classList.add('hidden');
          serviceStatusBadge.classList.add('hidden');
          serviceStatusBadge.classList.remove('flex');
          sessionStorage.removeItem(STORAGE_KEY);
          currentToken = '';
        }
      }

      // 请求封装
      async function apiFetch(path, options = {}) {
        const headers = {
          'Content-Type': 'application/json',
          ...(options.headers || {}),
        };
        if (currentToken) {
          headers['Authorization'] = `Bearer ${currentToken}`;
        }
        const res = await fetch(path, { ...options, headers });
        if (res.status === 401 && path !== '/api/settings/login') {
          setAuthedState(false);
          showToast('登录态已失效，请重新输入密码', 'error');
          throw new Error('Unauthorized');
        }
        return res;
      }

      // 密码可见性切换
      const togglePwBtn = document.getElementById('togglePasswordVisibility');
      const adminPasswordInput = document.getElementById('adminPassword');
      if (togglePwBtn && adminPasswordInput) {
        togglePwBtn.addEventListener('click', () => {
          adminPasswordInput.type = adminPasswordInput.type === 'password' ? 'text' : 'password';
        }, { signal });
      }

      const toggleApiKeyBtn = document.getElementById('toggleApiKeyVisibility');
      const aiApiKeyInput = document.getElementById('aiApiKey');
      if (toggleApiKeyBtn && aiApiKeyInput) {
        toggleApiKeyBtn.addEventListener('click', () => {
          aiApiKeyInput.type = aiApiKeyInput.type === 'password' ? 'text' : 'password';
        }, { signal });
      }

      // 登录表单
      const loginForm = document.getElementById('loginForm');
      const loginError = document.getElementById('loginError');
      const loginSubmitBtn = document.getElementById('loginSubmitBtn');
      const loginSpinner = document.getElementById('loginSpinner');
      const loginBtnText = document.getElementById('loginBtnText');

      loginForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        loginError.classList.add('hidden');
        loginSubmitBtn.disabled = true;
        loginSpinner.classList.remove('hidden');
        loginBtnText.textContent = '验证中...';

        try {
          const password = adminPasswordInput.value.trim();
          const res = await fetch('/api/settings/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password }),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) {
            loginError.textContent = data.error || '验证失败';
            loginError.classList.remove('hidden');
            return;
          }

          currentToken = data.token;
          sessionStorage.setItem(STORAGE_KEY, currentToken);
          setAuthedState(true, true);
          showToast('密钥验证通过，正在展开配置...');
          await loadConfig();
          await loadInvites();
          await loadAccounts();
        } catch (err) {
          loginError.textContent = err.message || '网络连接异常';
          loginError.classList.remove('hidden');
        } finally {
          loginSubmitBtn.disabled = false;
          loginSpinner.classList.add('hidden');
          loginBtnText.textContent = '验证密钥并启卷';
        }
      }, { signal });

      // 退出登录
      logoutBtn?.addEventListener('click', () => {
        setAuthedState(false);
        showToast('已安全退出控制台');
      }, { signal });

      // 加载配置数据
      async function loadConfig() {
        try {
          const res = await apiFetch('/api/settings/config');
          const data = await res.json();
          if (!data.ok) return;

          const cfg = data.config;
          const status = data.status;

          document.getElementById('aiBaseUrl').value = cfg.baseUrl || '';
          document.getElementById('aiModel').value = cfg.model || '';
          document.getElementById('aiMaxTokens').value = cfg.maxTokens || 8192;

          const temp = cfg.temperature !== null && cfg.temperature !== undefined ? cfg.temperature : 0.4;
          document.getElementById('aiTemperature').value = temp;
          document.getElementById('aiTemperatureNum').value = temp;
          document.getElementById('tempValueDisplay').textContent = temp;

          const apiKeyHint = document.getElementById('apiKeyHint');
          if (cfg.apiKeyMasked) {
            apiKeyHint.textContent = `已配置: ${cfg.apiKeyMasked}`;
          } else {
            apiKeyHint.textContent = '尚未配置 Key';
            apiKeyHint.className = 'text-[10px] text-amber-500 font-sans';
          }

          document.getElementById('askRatePerMin').value = cfg.perMinute || 6;
          document.getElementById('askRatePerDay').value = cfg.perDay || 60;
          document.getElementById('askDailyLimit').value = cfg.dailyLimit || 800;
          document.getElementById('askMaxConcurrent').value = cfg.maxConcurrent || 12;

          document.getElementById('askQuestionLimit').value = cfg.questionLimit || 300;
          document.getElementById('askIdleTimeout').value = cfg.idleTimeout || 60;
          document.getElementById('askContextLength').value = cfg.contextLength || 700;
          document.getElementById('askSystemPrompt').value = cfg.systemPrompt || '';
          defaultPromptCached = cfg.defaultSystemPrompt || '';

          // 状态卡片
          document.getElementById('statConfiguredDot').className = status.configured
            ? 'w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50'
            : 'w-2.5 h-2.5 rounded-full bg-amber-500 shadow-sm shadow-amber-500/50';
          document.getElementById('statConfiguredText').textContent = status.configured ? '服务正常运行' : '未完全配置';

          document.getElementById('statDailyUsed').textContent = status.dailyUsed || 0;
          document.getElementById('statDailyLimit').textContent = cfg.dailyLimit || 800;
          document.getElementById('statCacheCount').textContent = status.cacheCount || 0;

          // 头部徽标
          serviceStatusBadge.className = status.configured
            ? 'flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full font-mono border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
            : 'flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full font-mono border border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400';
          serviceStatusBadge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full ${status.configured ? 'bg-emerald-500' : 'bg-amber-500'}"></span><span>${status.configured ? 'ONLINE' : 'INCOMPLETE'}</span>`;
        } catch (err) {
          console.error(err);
        }
      }

      // 温度滑块与数值联动
      const tempRange = document.getElementById('aiTemperature');
      const tempNum = document.getElementById('aiTemperatureNum');
      const tempDisplay = document.getElementById('tempValueDisplay');
      tempRange?.addEventListener('input', (e) => {
        tempNum.value = e.target.value;
        tempDisplay.textContent = e.target.value;
      }, { signal });
      tempNum?.addEventListener('input', (e) => {
        tempRange.value = e.target.value;
        tempDisplay.textContent = e.target.value;
      }, { signal });

      // 拉取模型列表
      const fetchModelsBtn = document.getElementById('fetchModelsBtn');
      const fetchModelsIcon = document.getElementById('fetchModelsIcon');
      const modelsDrawer = document.getElementById('modelsDrawer');
      const modelsListContainer = document.getElementById('modelsListContainer');
      const modelCountBadge = document.getElementById('modelCountBadge');
      const modelFilterInput = document.getElementById('modelFilterInput');

      function renderModels(filter = '') {
        if (!modelsListContainer) return;
        const norm = filter.trim().toLowerCase();
        const filtered = fetchedModelsList.filter((m) => !norm || m.toLowerCase().includes(norm));

        modelCountBadge.textContent = `${filtered.length} / ${fetchedModelsList.length} 个模型`;

        if (!filtered.length) {
          modelsListContainer.innerHTML = '<div class="text-xs text-neutral-400 py-3 text-center">无匹配的模型</div>';
          return;
        }

        modelsListContainer.innerHTML = filtered
          .map(
            (id) => `
          <div class="flex items-center justify-between px-3 py-1.5 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200/70 dark:border-neutral-800/80 hover:border-neutral-300 dark:hover:border-neutral-700 transition-colors">
            <span class="text-xs font-mono text-neutral-800 dark:text-neutral-200 truncate mr-2" title="${id}">${id}</span>
            <div class="flex items-center gap-1.5 shrink-0">
              <button
                type="button"
                data-select-model="${id}"
                class="px-2 py-0.5 rounded text-[11px] bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 font-mono transition-colors cursor-pointer"
              >
                选取
              </button>
              <button
                type="button"
                data-test-model="${id}"
                class="px-2 py-0.5 rounded text-[11px] bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 font-mono transition-colors cursor-pointer"
              >
                测活
              </button>
            </div>
          </div>
        `
          )
          .join('');

        // 绑定选取与独立测活事件
        modelsListContainer.querySelectorAll('[data-select-model]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const m = btn.getAttribute('data-select-model');
            document.getElementById('aiModel').value = m;
            showToast(`已选取模型: ${m}`);
            if (autoPingOnSelect && m) {
              testSpecificModel(m, null);
            }
          }, { signal });
        });

        modelsListContainer.querySelectorAll('[data-test-model]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const m = btn.getAttribute('data-test-model');
            testSpecificModel(m, btn);
          }, { signal });
        });
      }

      modelFilterInput?.addEventListener('input', (e) => {
        renderModels(e.target.value);
      }, { signal });

      // ---------- 邀请码与账号 ----------
      const inviteListEl = document.getElementById('inviteList');
      const accountListEl = document.getElementById('accountList');
      const inviteNoteInput = document.getElementById('inviteNote');
      const inviteTtlSelect = document.getElementById('inviteTtl');
      const generateInviteBtn = document.getElementById('generateInviteBtn');

      const escapeHtml = (value) =>
        String(value ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');

      const formatDate = (value) => {
        if (!value) return '—';
        const date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' });
      };

      function inviteStateLabel(state) {
        if (state === 'used') return '已使用';
        if (state === 'expired') return '已过期';
        return '未使用';
      }

      async function loadInvites() {
        if (!inviteListEl) return;
        try {
          const res = await apiFetch('/api/settings/invites');
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || '读取失败');
          const invites = Array.isArray(data.invites) ? data.invites : [];
          if (!invites.length) {
            inviteListEl.innerHTML = '<div class="py-3 text-center text-neutral-400">还没有邀请码，点上方按钮生成一个。</div>';
            return;
          }
          inviteListEl.innerHTML = invites
            .map((invite) => {
              const state = invite.state;
              const stateClass =
                state === 'unused'
                  ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40'
                  : 'text-neutral-500 dark:text-neutral-400 bg-neutral-100 dark:bg-neutral-800';
              return `
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-3 py-2.5 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white/60 dark:bg-neutral-950/30">
                  <div class="flex items-center gap-2 min-w-0">
                    <code class="font-mono text-sm tracking-wider text-neutral-900 dark:text-neutral-100">${escapeHtml(invite.code)}</code>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-mono ${stateClass}">${inviteStateLabel(state)}</span>
                    ${invite.note ? `<span class="text-[11px] text-neutral-400 truncate">${escapeHtml(invite.note)}</span>` : ''}
                  </div>
                  <div class="flex items-center gap-3 text-[11px] text-neutral-400 font-mono shrink-0">
                    <span>到期 ${formatDate(invite.expiresAt)}</span>
                    ${invite.usedByName ? `<span>使用者 ${escapeHtml(invite.usedByName)}</span>` : ''}
                    <button type="button" data-copy-invite="${escapeHtml(invite.code)}" class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-600 dark:text-neutral-300 transition-colors cursor-pointer">复制</button>
                    ${state === 'unused' ? `<button type="button" data-revoke-invite="${escapeHtml(invite.code)}" class="px-2 py-0.5 rounded text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors cursor-pointer">作废</button>` : ''}
                  </div>
                </div>`;
            })
            .join('');
        } catch (err) {
          inviteListEl.innerHTML = `<div class="py-3 text-center text-rose-500">${escapeHtml(err.message || '读取失败')}</div>`;
        }
      }

      async function loadAccounts() {
        if (!accountListEl) return;
        try {
          const res = await apiFetch('/api/settings/users');
          const data = await res.json();
          if (!data.ok) throw new Error(data.error || '读取失败');
          const users = Array.isArray(data.users) ? data.users : [];
          if (!users.length) {
            accountListEl.innerHTML = '<div class="py-3 text-center text-neutral-400">还没有注册账号。</div>';
            return;
          }
          accountListEl.innerHTML = users
            .map(
              (user) => `
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 px-3 py-2.5 rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-white/60 dark:bg-neutral-950/30">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">${escapeHtml(user.username)}</span>
                  <span class="text-[11px] text-neutral-400 font-mono">注册于 ${formatDate(user.createdAt)}</span>
                  ${user.inviteCode ? `<span class="text-[10px] text-neutral-400 font-mono">码 ${escapeHtml(user.inviteCode)}</span>` : ''}
                </div>
                <button type="button" data-reset-user="${escapeHtml(user.id)}" data-username="${escapeHtml(user.username)}" class="self-start sm:self-auto px-2 py-0.5 rounded text-[11px] font-mono text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors cursor-pointer">重置密码</button>
              </div>`
            )
            .join('');
        } catch (err) {
          accountListEl.innerHTML = `<div class="py-3 text-center text-rose-500">${escapeHtml(err.message || '读取失败')}</div>`;
        }
      }

      generateInviteBtn?.addEventListener('click', async () => {
        generateInviteBtn.disabled = true;
        try {
          const res = await apiFetch('/api/settings/invites', {
            method: 'POST',
            body: JSON.stringify({
              note: inviteNoteInput?.value.trim() || '',
              ttlDays: Number(inviteTtlSelect?.value) || 7,
            }),
          });
          const data = await res.json();
          if (!data.ok) {
            showToast(data.error || '生成失败', 'error');
            return;
          }
          const code = data.invite.code;
          try {
            await navigator.clipboard.writeText(code);
            showToast(`邀请码 ${code} 已生成并复制（仅可注册 1 个账号）`);
          } catch {
            showToast(`邀请码 ${code} 已生成（复制失败，请手动选中）`);
          }
          if (inviteNoteInput) inviteNoteInput.value = '';
          await loadInvites();
        } catch (err) {
          showToast(err.message || '生成失败', 'error');
        } finally {
          generateInviteBtn.disabled = false;
        }
      }, { signal });

      inviteListEl?.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;

        const copyCode = target.closest('[data-copy-invite]')?.getAttribute('data-copy-invite');
        if (copyCode) {
          try {
            await navigator.clipboard.writeText(copyCode);
            showToast(`已复制邀请码 ${copyCode}`);
          } catch {
            showToast('复制失败，请手动选中', 'error');
          }
          return;
        }

        const revokeCode = target.closest('[data-revoke-invite]')?.getAttribute('data-revoke-invite');
        if (revokeCode) {
          const res = await apiFetch(`/api/settings/invites/${encodeURIComponent(revokeCode)}`, { method: 'DELETE' });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.ok) showToast(data.error || '作废失败', 'error');
          else showToast(`已作废 ${revokeCode}`);
          await loadInvites();
        }
      }, { signal });

      accountListEl?.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const btn = target.closest('[data-reset-user]');
        if (!btn) return;
        const userId = btn.getAttribute('data-reset-user');
        const username = btn.getAttribute('data-username') || '';
        if (!userId) return;
        if (!window.confirm(`确定重置 ${username} 的密码？旧密码会立即失效。`)) return;

        const res = await apiFetch(`/api/settings/users/${encodeURIComponent(userId)}/reset-password`, {
          method: 'POST',
          body: '{}',
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) {
          showToast(data.error || '重置失败', 'error');
          return;
        }
        try {
          await navigator.clipboard.writeText(data.temporaryPassword);
          showToast(`临时密码：${data.temporaryPassword}（已复制）`);
        } catch {
          showToast(`临时密码：${data.temporaryPassword}`);
        }
      }, { signal });

      fetchModelsBtn?.addEventListener('click', async () => {
        fetchModelsBtn.disabled = true;
        fetchModelsIcon.classList.add('animate-spin');

        const baseUrl = document.getElementById('aiBaseUrl').value.trim();
        const apiKey = document.getElementById('aiApiKey').value.trim();

        try {
          const res = await apiFetch('/api/settings/models', {
            method: 'POST',
            body: JSON.stringify({ baseUrl, apiKey }),
          });
          const data = await res.json();
          if (!data.ok) {
            showToast(data.error || '获取模型失败', 'error');
            return;
          }

          fetchedModelsList = data.models || [];
          modelsDrawer.classList.remove('hidden');
          renderModels(modelFilterInput.value);
          showToast(`成功获取 ${fetchedModelsList.length} 个可用模型！`);
        } catch (err) {
          showToast(err.message || '网络连接失败', 'error');
        } finally {
          fetchModelsBtn.disabled = false;
          fetchModelsIcon.classList.remove('animate-spin');
        }
      }, { signal });

      // 模型测活核心
      async function testSpecificModel(targetModel, triggerBtn) {
        if (!targetModel) {
          showToast('请先填写或选择模型名称', 'error');
          return;
        }

        const baseUrl = document.getElementById('aiBaseUrl').value.trim();
        const apiKey = document.getElementById('aiApiKey').value.trim();

        let prevText = '';
        if (triggerBtn) {
          prevText = triggerBtn.textContent;
          triggerBtn.textContent = '测活中...';
          triggerBtn.disabled = true;
        }

        const statusBadge = document.getElementById('modelTestStatusBadge');
        if (statusBadge) {
          statusBadge.classList.remove('hidden');
          statusBadge.className = 'text-xs font-mono text-neutral-400';
          statusBadge.textContent = '正在测活探测...';
        }

        try {
          const res = await apiFetch('/api/settings/test-model', {
            method: 'POST',
            body: JSON.stringify({ model: targetModel, baseUrl, apiKey }),
          });
          const data = await res.json();

          if (data.ok) {
            showToast(`🟢 模型【${targetModel}】测活成功！延时: ${data.latencyMs}ms`);
            if (statusBadge) {
              statusBadge.className = 'text-xs font-mono text-emerald-500 font-medium';
              statusBadge.textContent = `🟢 正常 (${data.latencyMs}ms)`;
            }
          } else {
            showToast(`🔴 测活失败: ${data.error || '未能连通'}`, 'error');
            if (statusBadge) {
              statusBadge.className = 'text-xs font-mono text-rose-500 font-medium';
              statusBadge.textContent = `🔴 失败 (${data.error || '连接超时'})`;
            }
          }
        } catch (err) {
          showToast(`测活请求异常: ${err.message}`, 'error');
        } finally {
          if (triggerBtn) {
            triggerBtn.textContent = prevText;
            triggerBtn.disabled = false;
          }
        }
      }

      // 当前模型测活按钮
      const testModelBtn = document.getElementById('testModelBtn');
      testModelBtn?.addEventListener('click', () => {
        const currentModel = document.getElementById('aiModel').value.trim();
        testSpecificModel(currentModel, testModelBtn);
      }, { signal });

      // 清空缓存
      const quickClearCacheBtn = document.getElementById('quickClearCacheBtn');
      quickClearCacheBtn?.addEventListener('click', async () => {
        if (!confirm('确定要清空所有已保存的问答答案缓存吗？')) return;
        quickClearCacheBtn.disabled = true;
        try {
          const res = await apiFetch('/api/settings/clear-cache', { method: 'POST' });
          const data = await res.json();
          if (data.ok) {
            document.getElementById('statCacheCount').textContent = '0';
            showToast(`已清空 ${data.cleared} 条答案缓存`);
          } else {
            showToast('清空缓存失败', 'error');
          }
        } catch (err) {
          showToast(err.message, 'error');
        } finally {
          quickClearCacheBtn.disabled = false;
        }
      }, { signal });

      // 伴读提示词恢复默认
      let defaultPromptCached = '';
      const resetPromptBtn = document.getElementById('resetPromptBtn');
      resetPromptBtn?.addEventListener('click', () => {
        if (defaultPromptCached) {
          document.getElementById('askSystemPrompt').value = defaultPromptCached;
          showToast('已载入默认人设提示词');
        }
      }, { signal });

      // 保存设置
      const settingsForm = document.getElementById('settingsForm');
      const saveConfigBtn = document.getElementById('saveConfigBtn');
      const saveSpinner = document.getElementById('saveSpinner');
      const saveBtnText = document.getElementById('saveBtnText');

      settingsForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveConfigBtn.disabled = true;
        saveSpinner.classList.remove('hidden');
        saveBtnText.textContent = '保存并热生效中...';

        const payload = {
          baseUrl: document.getElementById('aiBaseUrl').value.trim(),
          apiKey: document.getElementById('aiApiKey').value.trim(),
          model: document.getElementById('aiModel').value.trim(),
          maxTokens: Number(document.getElementById('aiMaxTokens').value) || 8192,
          temperature: Number(document.getElementById('aiTemperature').value),
          perMinute: Number(document.getElementById('askRatePerMin').value) || 6,
          perDay: Number(document.getElementById('askRatePerDay').value) || 60,
          dailyLimit: Number(document.getElementById('askDailyLimit').value) || 800,
          maxConcurrent: Number(document.getElementById('askMaxConcurrent').value) || 12,
          questionLimit: Number(document.getElementById('askQuestionLimit').value) || 2000,
          idleTimeout: Number(document.getElementById('askIdleTimeout').value) || 60,
          contextLength: Number(document.getElementById('askContextLength').value) || 700,
          systemPrompt: document.getElementById('askSystemPrompt').value.trim(),
        };

        try {
          const res = await apiFetch('/api/settings/config', {
            method: 'POST',
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.ok) {
            showToast('✅ 配置已成功保存，并在服务端即刻生效！');
            await loadConfig();
            document.getElementById('aiApiKey').value = '';
          } else {
            showToast(data.error || '保存配置失败', 'error');
          }
        } catch (err) {
          showToast(err.message || '保存异常', 'error');
        } finally {
          saveConfigBtn.disabled = false;
          saveSpinner.classList.add('hidden');
          saveBtnText.textContent = '保存并应用配置';
        }
      }, { signal });

      // 初始化：若已有 token，尝试自动加载
      if (currentToken) {
        setAuthedState(true, false);
        loadConfig()
          .then(() => Promise.all([loadInvites(), loadAccounts()]))
          .catch(() => setAuthedState(false));
      }

      window[CLEANUP_KEY] = () => {
        settingsAbort.abort();
        if (toast && toast.__timer) clearTimeout(toast.__timer);
        window[CLEANUP_KEY] = undefined;
      };
      document.addEventListener('astro:before-swap', () => {
        if (typeof window[CLEANUP_KEY] === 'function') window[CLEANUP_KEY]();
      }, { signal });
    })();
  </script>

  <style is:global>
    /* 确保控制台视口撑满全屏，且不被侧边栏浮动按钮遮挡 */
    .site-shell:has(.settings-viewport),
    .site-shell-standalone {
      flex-direction: column !important;
      align-items: stretch !important;
      width: 100% !important;
      max-width: 100% !important;
      min-height: 100vh !important;
      gap: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      overflow: visible !important;
    }
    .site-shell:has(.settings-viewport) > .settings-viewport,
    .site-shell-standalone > .settings-viewport {
      width: 100% !important;
      max-width: 100% !important;
    }
    #toast {
      width: auto !important;
      max-width: 24rem !important;
    }
    html:has(.settings-viewport) .sidebar-expand-btn,
    html:has(.settings-viewport) .seal-floating {
      display: none !important;
    }

    /* 卷首单色细墨线 */
    .settings-ink-hairline {
      position: absolute;
      top: 0;
      left: 8%;
      right: 8%;
      height: 1.5px;
      background: linear-gradient(90deg, transparent, var(--border-strong, rgba(100, 100, 108, 0.45)), transparent);
      pointer-events: none;
    }

    /* 主题与色阶预览卡：点击荡开主题色水墨涟漪（GPU transform + opacity） */
    .settings-ink-ripple {
      position: absolute;
      border-radius: 9999px;
      pointer-events: none;
      z-index: 4;
      background: radial-gradient(
        circle,
        color-mix(in srgb, var(--ripple-color, #141517) 36%, transparent) 0%,
        color-mix(in srgb, var(--ripple-color, #141517) 14%, transparent) 55%,
        transparent 74%
      );
      transform: translate3d(-50%, -50%, 0) scale(0.08);
    }

    .theme-preview-card {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 0.72rem;
      border-radius: 0.85rem;
      border: 1px solid rgba(120, 120, 128, 0.24);
      background: rgba(250, 248, 244, 0.55);
      text-align: left;
      cursor: pointer;
      transition:
        transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 240ms ease,
        background-color 240ms ease;
    }
    [data-theme="dark"] .theme-preview-card {
      background: rgba(24, 25, 30, 0.72);
      border-color: rgba(255, 255, 255, 0.1);
    }
    .theme-preview-card:hover {
      transform: translate3d(0, -2px, 0);
      border-color: var(--card-accent, var(--ink-strong));
    }
    .theme-preview-card.is-active {
      border-color: var(--card-accent, var(--ink-strong));
      background: color-mix(in srgb, var(--card-accent, var(--ink-strong)) 8%, transparent);
    }

    .theme-preview-swatch {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.32rem;
      height: 3.1rem;
      padding: 0.55rem 0.65rem;
      border-radius: 0.55rem;
      background: var(--card-paper);
      border: 1px solid rgba(120, 120, 128, 0.22);
    }
    .theme-preview-swatch .swatch-line {
      display: block;
      height: 4px;
      width: 62%;
      border-radius: 999px;
      background: var(--card-ink);
      opacity: 0.38;
    }
    .theme-preview-swatch .swatch-line.is-title {
      width: 42%;
      height: 5px;
      opacity: 0.82;
    }
    .theme-preview-swatch .swatch-dot {
      position: absolute;
      right: 0.58rem;
      bottom: 0.52rem;
      width: 14px;
      height: 6px;
      border-radius: 9999px;
      background: var(--card-accent);
      opacity: 0.86;
    }

    .theme-preview-meta {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
    }
    .theme-preview-meta strong {
      font-size: 0.78rem;
      color: var(--text-strong, #171717);
    }
    [data-theme="dark"] .theme-preview-meta strong {
      color: #f5f5f5;
    }
    .theme-preview-meta small {
      font-size: 0.68rem;
      color: #737373;
    }

    /* 墨玉弹性阻尼开关 (Ink-Jade Elastic Switch) */
    .ink-jade-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.65rem 0.85rem;
      border-radius: 0.75rem;
      border: 1px solid rgba(120, 120, 128, 0.18);
      background: rgba(250, 249, 246, 0.6);
      transition: border-color 220ms ease, background-color 220ms ease;
    }
    [data-theme="dark"] .ink-jade-row {
      background: rgba(20, 21, 25, 0.6);
      border-color: rgba(255, 255, 255, 0.08);
    }
    .ink-jade-row:hover {
      border-color: rgba(100, 100, 108, 0.36);
    }

    .ink-jade-switch {
      position: relative;
      display: inline-flex;
      align-items: center;
      width: 46px;
      height: 26px;
      padding: 3px;
      border-radius: 9999px;
      border: 1px solid rgba(115, 115, 122, 0.34);
      background: rgba(120, 120, 128, 0.18);
      cursor: pointer;
      flex-shrink: 0;
      outline: none;
      transition:
        background-color 300ms cubic-bezier(0.22, 1, 0.36, 1),
        border-color 300ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .ink-jade-switch.is-on {
      background: linear-gradient(135deg, #0d6e61 0%, #174c45 100%);
      border-color: rgba(16, 185, 129, 0.55);
    }
    [data-theme="rice"] .ink-jade-switch.is-on {
      background: linear-gradient(135deg, #6B5B45 0%, #4E4132 100%);
      border-color: rgba(107, 91, 69, 0.55);
    }

    .ink-jade-thumb {
      width: 18px;
      height: 18px;
      border-radius: 9999px;
      background: radial-gradient(circle at 32% 28%, #ffffff 0%, #e7ecea 65%, #cbd5d1 100%);
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.24);
      transform: translate3d(0, 0, 0) scale(1);
      transition: transform 380ms cubic-bezier(0.34, 1.52, 0.64, 1);
    }
    .ink-jade-switch.is-on .ink-jade-thumb {
      transform: translate3d(20px, 0, 0) scale(1);
      background: radial-gradient(circle at 32% 28%, #ffffff 0%, #d5f5ec 68%, #9be0cd 100%);
    }
    .ink-jade-switch:active .ink-jade-thumb {
      transform: translate3d(0, 0, 0) scaleX(1.14) scaleY(0.9);
    }
    .ink-jade-switch.is-on:active .ink-jade-thumb {
      transform: translate3d(18px, 0, 0) scaleX(1.14) scaleY(0.9);
    }

    /* 墨玉滑尺 (Range Slider) */
    .ink-jade-range {
      -webkit-appearance: none;
      appearance: none;
      height: 6px;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(13, 110, 97, 0.28), rgba(82, 82, 91, 0.34));
      outline: none;
      cursor: pointer;
    }
    .ink-jade-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 999px;
      background: radial-gradient(circle at 35% 30%, #ffffff 0%, #d7ebe5 68%, #0f766e 100%);
      border: 1.5px solid #0f766e;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.22);
      transition: transform 220ms cubic-bezier(0.34, 1.52, 0.64, 1);
    }
    .ink-jade-range::-webkit-slider-thumb:hover {
      transform: scale(1.18);
    }

    /* 书体切换滑块与兰亭试墨笺 */
    .settings-font-seg {
      position: relative;
      display: inline-flex;
      align-items: center;
      padding: 2px;
      border-radius: 8px;
      background: rgba(120, 120, 128, 0.14);
      border: 1px solid rgba(120, 120, 128, 0.2);
    }
    .settings-font-glider {
      position: absolute;
      top: 2px;
      bottom: 2px;
      left: 0;
      width: 100px;
      transform-origin: 0 50%;
      border-radius: var(--pill-rx, 6px) / 6px;
      background: #1c1d21;
      z-index: 0;
      pointer-events: none;
      transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    [data-theme="dark"] .settings-font-glider {
      background: #f2efe9;
    }
    .settings-font-btn {
      position: relative;
      z-index: 1;
      padding: 0.22rem 0.65rem;
      font-size: 0.72rem;
      font-weight: 600;
      color: #666;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: color 200ms ease;
    }
    .settings-font-btn.is-active {
      color: #faf8f4;
    }
    [data-theme="dark"] .settings-font-btn.is-active {
      color: #15161a;
    }

    .settings-specimen-box {
      --specimen-scale: 1;
      position: relative;
      overflow: hidden;
      padding: 0.9rem 1rem;
      border-radius: 0.85rem;
      border: 1px solid rgba(120, 120, 128, 0.22);
      background: linear-gradient(135deg, rgba(250, 248, 242, 0.92), rgba(243, 238, 228, 0.85));
    }
    [data-theme="dark"] .settings-specimen-box {
      background: linear-gradient(135deg, rgba(24, 25, 30, 0.9), rgba(18, 19, 23, 0.88));
      border-color: rgba(255, 255, 255, 0.1);
    }
    .specimen-shimmer {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0;
      background: linear-gradient(110deg, transparent 25%, rgba(100, 100, 108, 0.12) 50%, transparent 75%);
    }
    .specimen-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.45rem;
    }
    .specimen-pill {
      display: inline-flex;
      align-items: center;
      padding: 0.1rem 0.52rem;
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--text-strong, #262626);
      background: rgba(120, 120, 128, 0.12);
      border: 1px solid rgba(120, 120, 128, 0.28);
      border-radius: 9999px;
    }
    [data-theme="dark"] .specimen-pill {
      color: #ebe8e1;
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.18);
    }
    .specimen-body {
      margin: 0;
      line-height: 1.72;
      color: #1e1f24;
      font-size: calc(0.88rem * var(--specimen-scale, 1));
      transition: font-size 220ms cubic-bezier(0.22, 1, 0.36, 1), color 220ms ease;
    }
    [data-theme="dark"] .specimen-body {
      color: #ebe8e1;
    }
    .settings-specimen-box[data-specimen-font="kai"] .specimen-body {
      font-family: var(--font-kai, var(--font-hand, var(--font-serif, serif)));
      letter-spacing: 0.04em;
    }

    /* 邀请码 / 账号列表入场动效 */
    #inviteList > div,
    #accountList > div {
      animation: settingsRowIn 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    #inviteList > div:nth-child(1),
    #accountList > div:nth-child(1) { animation-delay: 20ms; }
    #inviteList > div:nth-child(2),
    #accountList > div:nth-child(2) { animation-delay: 50ms; }
    #inviteList > div:nth-child(3),
    #accountList > div:nth-child(3) { animation-delay: 80ms; }
    #inviteList > div:nth-child(4),
    #accountList > div:nth-child(4) { animation-delay: 110ms; }
    #inviteList > div:nth-child(n + 5),
    #accountList > div:nth-child(n + 5) { animation-delay: 140ms; }

    @keyframes settingsRowIn {
      from {
        opacity: 0;
        transform: translate3d(0, 7px, 0);
      }
      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #inviteList > div,
      #accountList > div,
      .theme-preview-card,
      .ink-jade-switch,
      .ink-jade-thumb,
      .settings-font-glider,
      .specimen-body {
        animation: none !important;
        transition: none !important;
      }
    }
  </style>
</BaseLayout>
