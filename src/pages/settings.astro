                </label>
                <input
                  type="number"
                  id="askMaxConcurrent"
                  name="maxConcurrent"
                  min="1"
                  max="100"
                  placeholder="12"
                  class="w-full px-3 py-2 rounded-lg text-sm bg-neutral-50 dark:bg-neutral-950/60 border border-neutral-300 dark:border-neutral-700 text-neutral-900 dark:text-neutral-100 font-mono"
                />
              </div>
            </div>
          </div>

          <!-- 模块 3：墨问伴读体验与上下文调优 (Prompt & Context Controls) -->
          <div class="bg-white/80 dark:bg-neutral-900/80 backdrop-blur-xl border border-neutral-200/80 dark:border-neutral-800/80 rounded-2xl p-6 sm:p-7 shadow-sm">
            <div class="flex items-center gap-2.5 mb-6 pb-4 border-b border-neutral-100 dark:border-neutral-800/70">
              <div class="p-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">墨问伴读体验与上下文调优</h3>
                <p class="text-xs text-neutral-500 dark:text-neutral-400">微调读者提文字数上限、模型首字超时、正文上下文范围与 AI 伴读人设</p>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-5">
