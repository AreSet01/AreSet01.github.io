              <div class="flex items-center gap-1.5">
                <button type="button" id="mm-note-mode-btn" class="text-[0.7rem] px-2 py-0.5 rounded border border-[var(--rule)] text-[var(--muted-strong)] hover:text-[var(--text-strong)] cursor-pointer">预览</button>
                <button type="button" id="mm-note-close-btn" class="text-xs text-[var(--muted)] hover:text-[var(--text-strong)] px-1 cursor-pointer" aria-label="关闭备注">✕</button>
              </div>
            </div>
            <textarea
              id="mm-note-textarea"
              rows="5"
              placeholder="支持 Markdown（**加粗**、`行内代码`、列表、公式），失焦自动保存..."
              class="mt-2.5 w-full bg-[var(--bg-soft)] border border-[var(--rule)] rounded-lg p-2.5 text-xs text-[var(--text-strong)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--ink-strong)] resize-y leading-relaxed"
            ></textarea>
            <div id="mm-note-preview" class="hidden mt-2.5 prose-preview text-xs max-h-48 overflow-y-auto bg-[var(--bg-soft)] border border-[var(--rule)] rounded-lg p-2.5"></div>
          </div>

          <!-- 缩略舆图小地图：零重排 GPU 视口框实时跟手巡览 -->
          <div class="mm-minimap" id="mm-minimap" aria-label="思维导图缩略舆图" title="点击或拖拽快速巡览画布">
            <svg class="mm-minimap-svg" id="mm-minimap-svg" viewBox="0 0 156 96" aria-hidden="true"></svg>
            <div class="mm-minimap-vp" id="mm-minimap-vp" aria-hidden="true"></div>
          </div>

          <!-- 修复显示不全问题：采用统一的底栏 HUD Flexbox 容器，绝不越界裁切 -->
          <div class="mm-canvas-hud" aria-label="画布快捷键提示与缩放控制">
            <div class="mm-canvas-kbd-hint" title="Tab 子节点 · Enter 同级 · Space/双击 编辑 · / 折叠 · 拖拽移动/排序 · 空白处长按左键框选多选 · Ctrl+Z 撤销">
              <span><kbd>Tab</kbd> 子节点</span>
              <span class="mm-hud-sep">·</span>
              <span><kbd>Enter</kbd> 同级</span>
              <span class="mm-hud-sep">·</span>
              <span><kbd>Space</kbd>/<kbd>双击</kbd> 编辑</span>
              <span class="mm-hud-sep mm-hud-hide-md">·</span>
              <span class="mm-hud-hide-md"><kbd>长按</kbd> 框选</span>
              <span class="mm-hud-sep mm-hud-hide-md">·</span>
              <span class="mm-hud-hide-md"><kbd>Ctrl+Z</kbd> 撤销</span>
            </div>

            <div class="mm-canvas-zoom-bar">
              <button type="button" id="mm-fit-btn" class="mm-zoom-btn" title="居中并适配画布视角 (Ctrl+0)" aria-label="居中适配视图">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg>
              </button>
              <button type="button" id="mm-center-btn" class="mm-zoom-btn" title="定位到根节点" aria-label="定位根节点">⌖</button>
              <span class="mm-zoom-sep"></span>
              <button type="button" id="mm-zoom-out-btn" class="mm-zoom-btn" title="缩小" aria-label="缩小画布">−</button>
              <span id="mm-zoom-label" class="mm-zoom-label">100%</span>
              <button type="button" id="mm-zoom-in-btn" class="mm-zoom-btn" title="放大" aria-label="放大画布">+</button>
              <span class="mm-zoom-sep"></span>
              <button type="button" id="mm-expand-all-btn" class="mm-zoom-text-btn" title="全部展开或全部收起一级">展开/收起</button>
            </div>
          </div>
        </section>

        <!-- 可拖拽分屏滑条 -->
        <div class="mm-split-resizer" id="mm-split-resizer" role="separator" aria-orientation="vertical" aria-label="调节画布与大纲宽度"></div>

        <!-- 大纲编辑器区 -->
        <aside class="mm-outline-pane" id="mm-outline-pane" aria-label="Markdown 双向大纲编辑器" data-lenis-prevent>
          <div class="mm-outline-head">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold text-[var(--text-strong)]">Markdown 大纲 · 实时双向同步</span>
              <span class="text-[0.68rem] text-[var(--muted)] font-mono"># Root · ## 分支 · - 子项</span>
            </div>
            <div id="mm-outline-md-toolbar" class="mt-2"></div>
          </div>
          <textarea
            id="mm-outline-textarea"
            spellcheck="false"
            aria-label="思维导图 Markdown 大纲"
            placeholder="# 核心主题&#10;&#10;## 主分支 1&#10;- 要点 A&#10;  - 细节 1"
            class="mm-outline-textarea"
            data-lenis-prevent
          ></textarea>
        </aside>
      </div>
    </div>
    <!-- 置于 transformed .modal-card 外部，确保 position: fixed 永远以浏览器视口 (0, 0) 为基准贴合光标 -->
    <div class="mm-drag-ghost hidden" id="mm-drag-ghost" aria-hidden="true"></div>
    <div class="mm-drop-pill hidden" id="mm-drop-pill" aria-hidden="true"></div>
  </div>

  <!-- 7. 删除确认弹窗 -->
  <div
    id="mm-confirm-modal"
    class="fixed inset-0 z-[60] modal-overlay is-closed hidden flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mm-confirm-title"
    data-lenis-prevent
  >
    <div id="mm-confirm-card" tabindex="-1" class="bg-[var(--bg-elev)] border border-[var(--rule-strong)] rounded-2xl w-full max-w-sm overflow-hidden shadow-2xl modal-card p-5 space-y-4 outline-none">
      <div class="space-y-1.5">
        <h3 id="mm-confirm-title" class="text-sm font-bold text-[var(--text-strong)]">确认删除思维导图？</h3>
        <p id="mm-confirm-desc" class="text-xs text-[var(--muted-strong)] leading-relaxed">删除后将同时移除本地记录，并在同步后从云端清除。</p>
      </div>
      <div class="flex items-center justify-end gap-2 pt-1">
        <button type="button" id="mm-confirm-cancel-btn" class="px-3.5 py-1.5 rounded-lg text-xs font-medium text-[var(--muted-strong)] hover:text-[var(--text-strong)] transition cursor-pointer">取消</button>
        <button type="button" id="mm-confirm-ok-btn" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-red-600 text-white hover:bg-red-700 transition cursor-pointer shadow-sm">确认删除</button>
      </div>
    </div>
  </div>

  <!-- 8. Toast 反馈 -->
  <div id="mm-toast" role="status" aria-live="polite" aria-atomic="true" class="fixed bottom-6 right-6 z-[70] transform translate-y-12 opacity-0 transition-[transform,opacity] duration-300 pointer-events-none bg-[var(--ink-strong)] text-[var(--bg-base)] px-4 py-2.5 rounded-xl shadow-xl text-xs font-medium flex items-center gap-2">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span id="mm-toast-msg">操作成功</span>
  </div>
</BaseLayout>

<style>
  /* 复用 notes 视觉肌理与磁吸滑条 + 纯色标过滤 + 文章气泡 + 模态弹层 */
  :global(body.notes-modal-open) #mm-toast {
    bottom: 4.5rem;
  }

  .color-dot-btn {
    width: 26px;
    height: 26px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
    transition: transform 260ms var(--ease-bounce), border-color 200ms var(--ease);
    border: 2px solid transparent;
    background: transparent;
  }
  .color-dot-btn::after {
    content: '';
    width: 13px;
    height: 13px;
    border-radius: 9999px;
    background-color: var(--dot-color);
    transition: transform 240ms var(--ease-bounce), background-color 200ms var(--ease);
  }
  .color-dot-btn:hover { transform: scale(1.18); }
  .color-dot-btn.active { border-color: var(--ink-strong); transform: scale(1.12); }
  .color-dot-btn.active::after { transform: scale(1.15); }
  .color-dot-btn:focus-visible {
    outline: 2px solid var(--ink-strong);
    outline-offset: 2px;
  }

  .all-color-pill {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    border: 1px solid var(--rule);
    color: var(--muted-strong);
    background: transparent;
    cursor: pointer;
    transition:
      background-color 220ms var(--ease),
      color 220ms var(--ease),
      border-color 220ms var(--ease),
      transform 200ms var(--ease);
  }
  .all-color-pill.active,
  .all-color-pill:hover {
    background-color: var(--ink-strong);
    color: var(--bg-base);
    border-color: var(--ink-strong);
    font-weight: 600;
  }

  .article-popover {
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    background: var(--bg-elev);
    border: 1px solid var(--rule-strong);
    border-radius: 14px;
    box-shadow: 0 20px 48px -8px rgba(0, 0, 0, 0.18), 0 4px 14px rgba(0, 0, 0, 0.06);
    z-index: 50;
    transform-origin: top left;
    transition: transform 260ms var(--ease-elastic), opacity 220ms var(--ease);
  }
  .article-popover.is-open { transform: scale(1) translateY(0); opacity: 1; }
  .article-popover.is-closed { transform: scale(0.94) translateY(-8px); opacity: 0; pointer-events: none; visibility: hidden; }

  :global(#mm-article-filter-input:focus),
  :global(#mm-article-filter-input:focus-visible) {
    outline: none !important;
  }

  :global(.mm-article-item-row) {
    position: relative;
    background: transparent;
    color: var(--muted-strong);
    transition: color 180ms var(--ease);
    cursor: pointer;
  }
  :global(.mm-article-item-row)::after {
    content: '';
    position: absolute;
    left: 0.625rem;
    right: 0.625rem;
    bottom: 0;
    height: 1.5px;
    background: linear-gradient(90deg, var(--vermilion) 0%, var(--accent) 48%, transparent 100%);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    pointer-events: none;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1), opacity 220ms var(--ease);
  }
  :global(.mm-article-item-row):hover,
  :global(.mm-article-item-row):focus-visible {
    color: var(--text-strong);
    outline: none;
  }
  :global(.mm-article-item-row):hover::after,
  :global(.mm-article-item-row):focus-visible::after {
    transform: scaleX(1);
    opacity: 0.68;
  }
  :global(.mm-article-item-row.active) {
    font-weight: 600;
    color: var(--text-strong);
  }
  :global(.mm-article-item-row.active)::after {
    transform: scaleX(1);
    opacity: 0.95;
  }

  .modal-overlay {
    background: rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 1;
    transition: opacity 280ms var(--ease);
  }
  .modal-overlay.is-closed {
    opacity: 0;
    pointer-events: none;
  }
  .modal-overlay.is-open {
    opacity: 1;
  }
  .modal-card {
    transition: transform 340ms var(--ease-elastic), opacity 280ms var(--ease);
  }
  .modal-overlay.is-open .modal-card { transform: scale(1) translateY(0); opacity: 1; }
  .modal-overlay.is-closed .modal-card { transform: scale(0.95) translateY(12px); opacity: 0; }

  .notes-stats-strip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-control);
    user-select: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .notes-stat-item {
    cursor: pointer;
    transition: color 240ms var(--ease);
  }
  .notes-stat-item .stats-label,
  .notes-stat-item .stats-value,
  .notes-stat-item .stats-subnote {
    white-space: nowrap;
  }
  .notes-stat-item.is-hovered { color: var(--text-strong) !important; }
  .notes-stat-item.is-active .stats-label,
  .notes-stat-item.is-active .stats-value { color: var(--text-strong); }

  @media (max-width: 767.98px) {
    .notes-stat-item { padding: 0.3rem 0.28rem; }
    .notes-stat-item .stats-label { font-size: 0.52rem; letter-spacing: 0.03em; }
    .notes-stat-item .stats-subnote { font-size: 0.58rem; }
  }

  .subtabs-cluster {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.25rem 0.35rem;
    background: var(--bg-soft);
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius-control);
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .subtabs-cluster::-webkit-scrollbar { display: none; }
  .subtabs-glider {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 100px;
    transform-origin: 0 50%;
    border-radius: var(--pill-rx, 9999px) / var(--pill-ry, 9999px);
    background: var(--ink-strong);
    z-index: 1;
    pointer-events: none;
    transition: transform 380ms var(--ease), opacity 180ms var(--ease);
  }
  :global(#mm-subtabs-cluster .sub-tab-btn) {
    position: relative;
    z-index: 2;
    padding: 0.45rem 0.95rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--muted-strong);
    border-radius: var(--radius-control);
    transition: color 220ms var(--ease) 100ms, transform 200ms var(--ease-elastic);
    cursor: pointer;
    background: transparent;
    border: none;
    flex: 0 0 auto;
    white-space: nowrap;
  }
  :global(#mm-subtabs-cluster .sub-tab-btn:active) {
    transform: scale(0.95);
  }
  :global(#mm-subtabs-cluster .sub-tab-btn.active) {
    color: var(--bg-base) !important;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    :global(#mm-subtabs-cluster .sub-tab-btn) {
      padding: 0.36rem 0.55rem;
      font-size: 0.74rem;
    }
  }

  .notes-empty-state {
    min-height: 360px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .notes-empty-state.hidden { display: none !important; }

  .notes-masonry-board {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 1.35rem;
    width: 100%;
  }
  .notes-masonry-board.is-empty { display: none !important; }

  :global(.masonry-col) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* 导图卡片（挂靠 global.css 里的 .notes-card 四主题覆盖 + 专属纸境墨韵浮光，零 box-shadow 重绘） */
  :global(.mm-card) {
    display: flex !important;
    flex-direction: column;
    gap: 0.72rem;
    width: 100%;
    margin-bottom: 1.35rem;
    padding: 1.15rem 1.2rem;
    border-radius: 14px;
    border: 1px solid var(--rule);
    background: rgba(248, 246, 242, 0.9);
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.04);
    cursor: pointer;
    position: relative;
    isolation: isolate;
    transition: border-color 260ms var(--ease), transform 280ms var(--ease-card), background-color 260ms var(--ease);
  }
  :global(.mm-card)::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      115% 88% at 0% 48%,
      color-mix(in srgb, var(--note-accent, #c83e37) 14%, transparent) 0%,
      transparent 54%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms var(--ease-card);
  }
  :global(.mm-card)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 14px 30px -6px rgba(var(--accent-rgb), 0.12), 0 4px 12px -2px rgba(var(--accent-rgb), 0.06);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
    transition: opacity 340ms var(--ease-card);
  }
  :global(.mm-card:hover) {
    border-color: var(--rule-strong);
  }
  :global(.mm-card:hover)::before,
  :global(.mm-card:hover)::after {
    opacity: 1;
  }
  :global(.mm-card.is-entering),
  :global(.mm-card.is-reflowing) {
    transition: none !important;
  }
  :global(.mm-card.is-deleting) {
    opacity: 0 !important;
    transform: translateY(-8px) scale(0.988) !important;
    max-height: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    overflow: hidden !important;
    pointer-events: none !important;
    transition:
      opacity 240ms var(--ease-card),
      transform 320ms var(--ease-card),
      max-height 360ms var(--ease-card),
      margin 360ms var(--ease-card),
      padding 360ms var(--ease-card) !important;
  }
  :global(.mm-card-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  :global(.mm-card-badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted-strong);
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 9999px;
    padding: 0.16rem 0.6rem;
    max-width: 68%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.mm-card-dot) {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    flex-shrink: 0;
    background: var(--note-accent, var(--ink-strong));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--note-accent, var(--ink-strong)) 18%, transparent);
  }
  :global(.mm-card-actions) {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.68;
    transition: opacity 180ms var(--ease);
  }
  :global(.mm-card:hover .mm-card-actions),
  :global(.mm-card:focus-within .mm-card-actions) {
    opacity: 1;
  }
  :global(.mm-card-action-btn) {
    width: 26px;
    height: 26px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-strong);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      color 180ms var(--ease),
      background-color 180ms var(--ease),
      border-color 180ms var(--ease),
      transform 220ms var(--ease-elastic);
  }
  :global(.mm-card-action-btn:hover) {
    color: var(--text-strong);
    background: var(--bg-soft);
    border-color: var(--rule);
    transform: translateY(-1px) scale(1.06);
  }
  :global(.mm-card-action-btn:active) {
    transform: scale(0.9);
  }
  :global(.mm-card-action-btn.is-del:hover) {
    color: #ef5350;
    border-color: rgba(239, 83, 80, 0.35);
    background: rgba(239, 83, 80, 0.08);
  }
  :global(.mm-card-title) {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-strong);
    line-height: 1.4;
    word-break: break-word;
  }
  :global(.mm-card-topo-wrap) {
    position: relative;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    padding: 0.45rem 0.5rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }
  :global(.mm-card-topo-svg) {
    width: 100%;
    height: 92px;
    display: block;
  }
  :global(.mm-card-layout-tag) {
    position: absolute;
    right: 0.45rem;
    bottom: 0.35rem;
    font-size: 0.62rem;
    font-family: var(--font-mono);
    color: var(--muted);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.06rem 0.35rem;
  }
  :global(.mm-card-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }
  :global(.mm-card-tag) {
    font-size: 0.68rem;
    padding: 0.12rem 0.48rem;
    border-radius: 9999px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    color: var(--muted-strong);
  }
  :global(.mm-card-post-link) {
    font-size: 0.68rem;
    padding: 0.12rem 0.5rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--ink-strong) 8%, transparent);
    color: var(--text-strong);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }
  :global(.mm-card-post-link:hover) {
    text-decoration: underline;
  }
  :global(.mm-card-foot) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.69rem;
    color: var(--muted);
    padding-top: 0.35rem;
    border-top: 1px dashed var(--rule);
  }

  /* ============================================================== */
  /* 工作台弹层（全面防截断与全视口安全边界）                            */
  /* ============================================================== */
  .mm-workbench-overlay {
    padding: clamp(0.45rem, 1.4vw, 1rem);
  }
  .mm-workbench-dialog {
    width: min(1480px, 100%);
    height: min(92vh, calc(100vh - 1.2rem));
    height: min(92dvh, calc(100dvh - 1.2rem));
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
  }
  @media (max-width: 768px) {
    .mm-workbench-overlay {
      padding: 0;
    }
    .mm-workbench-dialog {
      width: 100%;
      height: 100vh;
      height: 100dvh;
      border-radius: 0;
      border: none;
    }
  }

  .mm-wb-header {
    position: relative;
    z-index: 35;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--rule);
    padding: 0.65rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex-shrink: 0;
    min-width: 0;
  }
  .mm-wb-row-top,
  .mm-wb-row-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem 0.85rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .mm-wb-title-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    flex: 1 1 14rem;
    max-width: 24rem;
  }
  .mm-wb-title-input {
    min-width: 0;
    flex: 1;
    font-size: 0.96rem;
    font-weight: 700;
    color: var(--text-strong);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.25rem 0.45rem;
    transition: background 180ms var(--ease), border-color 180ms var(--ease);
  }
  .mm-wb-title-input:hover,
  .mm-wb-title-input:focus {
    background: var(--bg-elev);
    border-color: var(--rule-strong);
    outline: none;
  }
  .mm-wb-meta-selectors {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    min-width: 0;
  }

  /* 统一毛玻璃自定义下拉组件（替代丑陋原生 select，支持真彩色圆点与搜索） */
  .mm-cselect {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    max-width: 100%;
  }
  .mm-cselect-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    height: 1.9rem;
    padding: 0 0.65rem;
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--text-strong);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: 9999px;
    outline: none;
    max-width: 10.5rem;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    transition:
      transform 240ms var(--ease-elastic),
      border-color 180ms var(--ease),
      background-color 180ms var(--ease);
  }
  .mm-cselect-modal-trigger {
    height: 2.15rem;
    padding: 0 0.8rem;
    background: var(--bg-soft);
    max-width: 13rem;
  }
  .mm-cselect-post-trigger {
    max-width: 13.5rem;
  }
  .mm-cselect-trigger:hover {
    border-color: var(--ink-strong);
    transform: translateY(-1px);
  }
  .mm-cselect-trigger:active {
    transform: translateY(0) scale(0.95);
  }
  .mm-cselect-trigger:focus-visible,
  .mm-cselect-trigger[aria-expanded="true"] {
    border-color: var(--ink-strong);
  }
  .mm-cselect-caret {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 240ms var(--ease-elastic), color 180ms var(--ease);
  }
  .mm-cselect-trigger[aria-expanded="true"] .mm-cselect-caret {
    transform: rotate(180deg);
    color: var(--text-strong);
  }
  :global(.mm-cselect-dot) {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    flex-shrink: 0;
    background: var(--dot-color, var(--ink-strong));
    box-shadow: 0 0 0 2.5px color-mix(in srgb, var(--dot-color, var(--ink-strong)) 22%, transparent);
    transition: transform 240ms var(--ease-elastic);
  }
  .mm-cselect-trigger:hover .mm-cselect-dot {
    transform: scale(1.16);
  }
  .mm-cselect-panel {
    position: absolute;
    left: 0;
    top: calc(100% + 0.42rem);
    min-width: 11.5rem;
    max-width: min(22rem, 90vw);
    padding: 0.36rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 80;
    max-height: 16rem;
    overflow-y: auto;
  }
  .mm-cselect-modal .mm-cselect-panel {
    right: 0;
    left: auto;
    min-width: 11.5rem;
    max-height: 12.5rem;
    transform-origin: top right;
  }
  .mm-cselect-post-panel {
    min-width: min(22.5rem, 90vw);
    max-width: min(26rem, 92vw);
    max-height: none;
    overflow: hidden;
    padding: 0.45rem;
    gap: 0.35rem;
  }
  .mm-cselect-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .mm-cselect-search-icon {
    position: absolute;
    left: 0.65rem;
    color: var(--muted);
    pointer-events: none;
  }
  .mm-cselect-search {
    width: 100%;
    height: 1.95rem;
    padding: 0 0.68rem 0 1.85rem;
    font-size: 0.74rem;
    color: var(--text-strong);
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 9999px;
    outline: none;
    transition: border-color 180ms var(--ease);
  }
  .mm-cselect-search:focus {
    border-color: var(--ink-strong);
  }
  .mm-cselect-scroll {
    max-height: 14.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-right: 1px;
  }
  :global(.mm-cselect-opt) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    width: 100%;
    border: none;
    background: transparent;
    color: var(--text-strong);
    font-size: 0.74rem;
    font-weight: 500;
    text-align: left;
    padding: 0.44rem 0.62rem;
    border-radius: 9px;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease),
      transform 220ms var(--ease-elastic);
  }
  :global(.mm-cselect-opt:hover),
  :global(.mm-cselect-opt.is-focused) {
    background: var(--bg-soft);
    transform: translateX(2px);
  }
  :global(.mm-cselect-opt:active) {
    transform: scale(0.98);
  }
  :global(.mm-cselect-opt.is-selected) {
    background: color-mix(in srgb, var(--ink-strong) 9%, var(--bg-soft));
    color: var(--ink-strong);
    font-weight: 600;
  }
  :global(.mm-cselect-opt-main) {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    min-width: 0;
    flex: 1;
  }
  :global(.mm-cselect-opt-text) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.mm-cselect-opt-sub) {
    font-size: 0.64rem;
    color: var(--muted);
    padding: 0.08rem 0.42rem;
    border-radius: 9999px;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    flex-shrink: 0;
    max-width: 6rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.mm-cselect-check) {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--ink-strong);
    opacity: 0;
    transform: scale(0.65);
    transition: opacity 160ms var(--ease), transform 220ms var(--ease-elastic);
  }
  :global(.mm-cselect-opt.is-selected .mm-cselect-check) {
    opacity: 1;
    transform: scale(1);
  }
  :global(.mm-cselect-empty) {
    padding: 0.9rem 0.6rem;
    text-align: center;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .mm-wb-tags-input {
    height: 1.9rem;
    padding: 0 0.55rem;
    font-size: 0.74rem;
    color: var(--text-strong);
    background: var(--bg-elev);
    border: 1px solid var(--rule);
    border-radius: 9999px;
    outline: none;
    max-width: 11rem;
    width: 8.5rem;
    transition: border-color 180ms var(--ease), background-color 180ms var(--ease);
  }
  .mm-wb-tags-input:focus {
    border-color: var(--ink-strong);
    background: var(--bg-base);
  }

  .mm-wb-switchers {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-left: auto;
  }
  .mm-seg-control {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 2px;
    border-radius: 9999px;
    background: var(--bg-elev);
    border: 1px solid var(--rule);
  }
  .mm-seg-glider {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 0;
    width: 100px;
    transform-origin: 0 50%;
    border-radius: var(--pill-rx, 9999px) / var(--pill-ry, 9999px);
    background: var(--ink-strong);
    z-index: 1;
    pointer-events: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.14);
    transition: transform 360ms var(--ease-elastic);
  }
  .mm-seg-btn {
    position: relative;
    z-index: 2;
    border: none;
    background: transparent;
    color: var(--muted-strong);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.25rem 0.68rem;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 220ms var(--ease) 60ms, transform 200ms var(--ease-elastic);
  }
  .mm-seg-btn:hover { color: var(--text-strong); }
  .mm-seg-btn:active { transform: scale(0.94); }
  .mm-seg-btn.is-active {
    color: var(--bg-base);
    font-weight: 600;
  }

  .mm-wb-chip-btn,
  .mm-wb-icon-btn,
  .mm-wb-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    height: 1.9rem;
    padding: 0 0.68rem;
    border-radius: 9999px;
    font-size: 0.74rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition:
      transform 240ms var(--ease-elastic),
      border-color 180ms var(--ease),
      background-color 180ms var(--ease),
      color 180ms var(--ease),
      opacity 180ms var(--ease);
  }
  .mm-wb-chip-btn {
    border: 1px solid var(--rule);
    background: var(--bg-elev);
    color: var(--text-strong);
  }
  .mm-wb-chip-btn:hover {
    border-color: var(--ink-strong);
    transform: translateY(-1px);
  }
  .mm-wb-chip-btn:active {
    transform: translateY(0) scale(0.94);
  }
  #mm-wb-back-btn svg {
    transition: transform 240ms var(--ease-elastic);
  }
  #mm-wb-back-btn:hover svg {
    transform: translateX(-2px);
  }
  .mm-wb-icon-btn {
    width: 1.9rem;
    padding: 0;
    justify-content: center;
    border: 1px solid var(--rule);
    background: var(--bg-elev);
    color: var(--muted-strong);
  }
  .mm-wb-icon-btn svg {
    transition: transform 240ms var(--ease-elastic);
  }
  .mm-wb-icon-btn:hover {
    color: var(--text-strong);
    border-color: var(--ink-strong);
    transform: translateY(-1px);
  }
  .mm-wb-icon-btn:active {
    transform: translateY(0) scale(0.91);
  }
  #mm-wb-undo-btn:hover:not(:disabled) svg { transform: rotate(-14deg); }
  #mm-wb-redo-btn:hover:not(:disabled) svg { transform: rotate(14deg); }
  .mm-wb-icon-btn:disabled { opacity: 0.38; pointer-events: none; }
  .mm-wb-primary-btn {
    border: none;
    background: var(--ink-strong);
    color: var(--bg-base);
    font-weight: 600;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }
  .mm-wb-primary-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }
  .mm-wb-primary-btn:active {
    transform: translateY(0) scale(0.94);
  }
  .mm-export-caret {
    transition: transform 240ms var(--ease-elastic);
  }
  #mm-export-trigger[aria-expanded="true"] .mm-export-caret {
    transform: rotate(180deg);
  }
  .mm-wb-save-state,
  .mm-wb-node-stats {
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .mm-wb-save-state.is-dirty { color: #d97706; }
  :global([data-theme="dark"]) .mm-wb-save-state.is-dirty { color: #fbbf24; }

  .mm-export-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    min-width: 11.2rem;
    padding: 0.36rem;
    z-index: 80;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transform-origin: top right;
  }
  .mm-export-item {
    border: none;
    background: transparent;
    color: var(--text-strong);
    font-size: 0.76rem;
    font-weight: 500;
    text-align: left;
    padding: 0.48rem 0.72rem;
    border-radius: 9px;
    cursor: pointer;
    transition: background-color 160ms var(--ease), transform 220ms var(--ease-elastic);
  }
  .mm-export-item:hover {
    background: var(--bg-soft);
    transform: translateX(3px);
  }
  .mm-export-item:active {
    transform: scale(0.97);
  }

  /* 工作台主体（画布 / 分屏 / 大纲） */
  .mm-wb-body {
    flex: 1;
    display: flex;
    min-width: 0;
    min-height: 0;
    position: relative;
    overflow: hidden;
  }
  .mm-canvas-pane {
    position: relative;
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--bg-base);
    background-image: radial-gradient(color-mix(in srgb, var(--ink) 14%, transparent) 1px, transparent 1px);
    background-size: 20px 20px;
    user-select: none;
    touch-action: none;
  }
  .mm-wb-body[data-view-mode="outline"] .mm-canvas-pane,
  .mm-wb-body[data-view-mode="outline"] .mm-split-resizer {
    display: none;
  }
  .mm-wb-body[data-view-mode="canvas"] .mm-split-resizer,
  .mm-wb-body[data-view-mode="canvas"] .mm-outline-pane {
    display: none;
  }
  .mm-wb-body[data-view-mode="outline"] .mm-outline-pane {
    width: 100% !important;
    max-width: 100% !important;
    flex: 1;
    border-left: none;
  }

  .mm-split-resizer {
    width: 6px;
    flex-shrink: 0;
    background: var(--bg-soft);
    border-left: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    cursor: col-resize;
    position: relative;
    transition: background 160ms var(--ease);
  }
  .mm-split-resizer:hover,
  .mm-split-resizer.is-dragging {
    background: color-mix(in srgb, var(--ink-strong) 18%, var(--bg-soft));
  }
  .mm-outline-pane {
    width: 340px;
    min-width: 240px;
    max-width: 75%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg-elev);
    border-left: 1px solid var(--rule);
    min-height: 0;
  }
  .mm-outline-head {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-soft);
    flex-shrink: 0;
  }
  .mm-outline-textarea {
    flex: 1;
    width: 100%;
    padding: 0.9rem 1rem;
    border: none;
    outline: none;
    resize: none;
    background: var(--bg-elev);
    color: var(--text-strong);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.82rem;
    line-height: 1.65;
    overflow-y: auto;
  }

  @media (max-width: 768px) {
    .mm-wb-body[data-view-mode="split"] {
      flex-direction: column;
    }
    .mm-split-resizer { display: none !important; }
    .mm-wb-body[data-view-mode="split"] .mm-outline-pane {
      width: 100% !important;
      max-width: 100%;
      height: 44%;
      border-left: none;
      border-top: 1px solid var(--rule);
    }
  }

  /* 顶部居中节点微操栏 */
  .mm-node-pill {
    position: absolute;
    top: 0.8rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: calc(100% - 1.6rem);
    overflow-x: auto;
    scrollbar-width: none;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.28rem 0.45rem;
    border-radius: 9999px;
    border: 1px solid var(--rule-strong);
    background: color-mix(in srgb, var(--bg-elev) 90%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    z-index: 25;
  }
  .mm-node-pill::-webkit-scrollbar { display: none; }
  .mm-pill-btn {
    border: none;
    background: transparent;
    color: var(--text-strong);
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.24rem 0.52rem;
    border-radius: 9999px;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition:
      background-color 160ms var(--ease),
      color 160ms var(--ease),
      transform 220ms var(--ease-elastic);
  }
  .mm-pill-btn:hover:not(:disabled) {
    background: var(--accent-soft);
    transform: translateY(-1px);
  }
  .mm-pill-btn:active:not(:disabled) {
    transform: translateY(0) scale(0.92);
  }
  .mm-pill-btn:disabled {
    opacity: 0.36;
    cursor: not-allowed;
  }
  .mm-pill-btn.is-has-note .mm-note-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #c9922e;
    display: inline-block;
  }
  .mm-pill-multi-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.48rem;
    margin-right: 0.15rem;
    border-radius: 9999px;
    background: var(--ink-strong);
    color: var(--bg-base);
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .mm-pill-multi-badge.hidden { display: none; }
  .mm-pill-sep {
    width: 1px;
    height: 14px;
    background: var(--rule);
    margin: 0 0.15rem;
    flex-shrink: 0;
  }
  .mm-pill-colors {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0 0.15rem;
  }
  .mm-node-cdot {
    position: relative;
    width: 13px;
    height: 13px;
    border-radius: 9999px;
    background: var(--nc);
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 240ms var(--ease-elastic), border-color 180ms var(--ease);
  }
  .mm-node-cdot:hover { transform: scale(1.24); }
  .mm-node-cdot:active { transform: scale(0.88); }
  .mm-node-cdot.is-selected {
    transform: scale(1.12);
    box-shadow: 0 0 0 2px var(--bg-elev), 0 0 0 3.5px var(--nc);
  }

  /* 交互视口与画布层：外层独立平移（不缩放置灰） + 内层 CSS zoom 矢量重绘，彻底解决高倍率文本发糊 */
  .mm-canvas-pane {
    --mm-focus-ink: var(--ink-strong, #141413);
    --mm-focus-soft: rgba(20, 20, 19, 0.1);
  }
  :global([data-theme="dark"]) .mm-canvas-pane {
    --mm-focus-ink: var(--ink-strong, #eae8e3);
    --mm-focus-soft: rgba(234, 232, 227, 0.15);
  }
  :global([data-theme="moss"]) .mm-canvas-pane {
    --mm-focus-ink: #FFC2D1;
    --mm-focus-soft: rgba(255, 194, 209, 0.22);
  }
  :global([data-theme="rice"]) .mm-canvas-pane {
    --mm-focus-ink: #4E4132;
    --mm-focus-soft: rgba(78, 65, 50, 0.12);
  }
  .mm-canvas-viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
    outline: none;
    cursor: grab;
  }
  .mm-canvas-viewport.is-panning { cursor: grabbing; }
  .mm-canvas-pan {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }
  .mm-canvas-stage {
    position: relative;
    transform-origin: 0 0;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
  .mm-measure-box {
    position: fixed;
    left: -99999px;
    top: -99999px;
    visibility: hidden;
    pointer-events: none;
    width: auto;
    height: auto;
    zoom: 1;
    transform: none;
    z-index: -1;
  }
  .mm-links-svg,
  .mm-drag-preview-svg,
  .mm-exit-layer {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
    pointer-events: none;
  }
  .mm-links-svg :global(path) {
    stroke-linejoin: round;
    transition: stroke 220ms var(--ease), stroke-width 220ms var(--ease);
  }
  .mm-exit-layer {
    z-index: 3;
  }
  .mm-drag-preview-svg {
    z-index: 30;
  }
  .mm-nodes-layer {
    position: relative;
    pointer-events: none;
  }
  :global(html:not(.has-custom-cursor)) .mm-canvas-viewport.is-marquee {
    cursor: crosshair !important;
  }
  .mm-marquee-box {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    z-index: 28;
    border: 1.5px dashed var(--mm-focus-ink);
    background: var(--mm-focus-soft);
    border-radius: 8px;
  }
  .mm-marquee-box.hidden { display: none; }
  .mm-hold-pulse {
    position: absolute;
    left: 0;
    top: 0;
    width: 38px;
    height: 38px;
    margin: -19px 0 0 -19px;
    border-radius: 9999px;
    border: 2px solid var(--mm-focus-ink);
    background: var(--mm-focus-soft);
    pointer-events: none;
    z-index: 29;
    animation: mmHoldPulse 380ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .mm-hold-pulse.hidden { display: none; }
  @keyframes mmHoldPulse {
    from { opacity: 0.92; transform: scale(0.42); }
    to { opacity: 0; transform: scale(1.75); }
  }

  /* 画布节点元素（JS 动态生成必须带 :global，零 box-shadow 重绘 + 温润水墨呼吸选框） */
  :global(.mm-node) {
    position: absolute;
    width: max-content;
    max-width: 278px;
    min-height: 34px;
    padding: 0.42rem 0.82rem;
    border-radius: 10px;
    border: 1.5px solid color-mix(in srgb, var(--node-color, var(--rule-strong)) 45%, var(--rule));
    background: var(--bg-elev);
    color: var(--text-strong);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.055);
    pointer-events: auto;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    box-sizing: border-box;
    contain: style;
    transition:
      border-color 180ms var(--ease),
      opacity 180ms var(--ease),
      background-color 180ms var(--ease);
    z-index: 2;
  }
  :global(.mm-node)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.11);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
    transition: opacity 220ms var(--ease);
  }
  :global(.mm-nodes-layer.is-live-typing .mm-node) {
    transition:
      border-color 150ms var(--ease),
      opacity 160ms var(--ease);
  }
  :global(.mm-node:hover) {
    border-color: var(--node-color, var(--ink-strong));
  }
  :global(.mm-node:hover)::after {
    opacity: 1;
  }
  :global(.mm-node.is-root) {
    background: var(--ink-strong);
    color: var(--bg-base);
    border-color: var(--ink-strong);
    font-weight: 700;
    font-size: 0.96rem;
    padding: 0.62rem 1.25rem;
    border-radius: 13px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.16);
    z-index: 4;
  }
  :global(.mm-node.is-selected)::before {
    content: '';
    position: absolute;
    inset: -4.5px;
    border-radius: 14px;
    border: 1.5px solid color-mix(in srgb, var(--node-color, var(--mm-focus-ink)) 78%, var(--mm-focus-ink));
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--node-color, var(--mm-focus-ink)) 10%, transparent) 0%,
      transparent 72%
    );
    pointer-events: none;
    animation: mmInkFocusBreathe 2.8s cubic-bezier(0.37, 0, 0.63, 1) infinite;
  }
  :global(.mm-node.is-selected.is-root)::before {
    inset: -5px;
    border-radius: 17px;
    border-color: var(--mm-focus-ink);
  }
  @keyframes mmInkFocusBreathe {
    0%, 100% {
      opacity: 0.56;
      transform: scale3d(0.992, 0.992, 1);
    }
    50% {
      opacity: 0.98;
      transform: scale3d(1.022, 1.022, 1);
    }
  }
  :global(.mm-node.is-selected:not(.is-root)) {
    border-color: var(--node-color, var(--mm-focus-ink));
    z-index: 5;
  }
  :global(.mm-node.is-selected.is-root) {
    z-index: 6;
  }
  :global(.mm-node.is-dragging-source) {
    opacity: 0.28 !important;
    border-style: dashed !important;
    pointer-events: none;
  }
  :global(.mm-node.is-drop-target) {
    border-color: var(--mm-focus-ink) !important;
    transform: scale(1.04);
    z-index: 8;
  }
  :global(.mm-node.is-drop-target)::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 14px;
    border: 2px solid var(--mm-focus-ink);
    opacity: 0.85;
    pointer-events: none;
  }
  :global(.mm-node.is-exiting) {
    opacity: 0 !important;
    transform: scale(0.72) !important;
    pointer-events: none !important;
    transition: opacity 150ms var(--ease), transform 160ms var(--ease) !important;
  }
  :global(.mm-node-text) {
    font-size: 0.84rem;
    line-height: 1.4;
    word-break: break-word;
    white-space: pre-wrap;
  }
  :global(.mm-node.is-root .mm-node-text) {
    font-size: 0.95rem;
  }
  :global(.mm-inline-code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.88em;
    padding: 0.06em 0.34em;
    border-radius: 5px;
    background: color-mix(in srgb, var(--ink-strong) 10%, transparent);
  }
  :global(.mm-node.is-root .mm-inline-code) {
    background: rgba(255, 255, 255, 0.16);
  }
  :global(.mm-node-note-icon) {
    font-size: 0.72rem;
    opacity: 0.78;
    flex-shrink: 0;
  }
  :global(.mm-node-edit-input) {
    min-width: 72px;
    max-width: 240px;
    border: none;
    outline: none;
    background: transparent;
    color: inherit;
    font: inherit;
    padding: 0;
  }
  :global(.mm-collapse-btn) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: -11px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 9999px;
    border: 1.5px solid var(--node-color, var(--rule-strong));
    background: var(--bg-elev);
    color: var(--text-strong);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
    z-index: 6;
    transition:
      transform 240ms var(--ease-elastic),
      background-color 150ms var(--ease),
      color 150ms var(--ease),
      border-color 150ms var(--ease);
  }
  :global(.mm-collapse-btn:hover) {
    transform: translateY(-50%) scale(1.16);
    background: var(--ink-strong);
    color: var(--bg-base);
    border-color: var(--ink-strong);
  }
  :global(.mm-collapse-btn:active) {
    transform: translateY(-50%) scale(0.92);
  }
  :global(.mm-collapse-btn.is-left) {
    right: auto;
    left: -11px;
  }
  :global(.mm-collapse-btn.is-bottom) {
    top: auto;
    right: auto;
    left: 50%;
    bottom: -11px;
    transform: translateX(-50%);
  }
  :global(.mm-collapse-btn.is-bottom:hover) {
    transform: translateX(-50%) scale(1.16);
  }
  :global(.mm-collapse-btn.is-bottom:active) {
    transform: translateX(-50%) scale(0.92);
  }

  /* 跟随光标移动的拖拽浮影节点（移除高频 backdrop-filter 并轻微半透以保持高帧率且不完全阻挡背景线索） */
  .mm-drag-ghost {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 120;
    pointer-events: none;
    box-sizing: border-box;
    padding: 0.42rem 0.82rem;
    border-radius: 10px;
    border: 2px solid var(--ghost-color, #42a5f5);
    background: color-mix(in srgb, var(--bg-elev) 90%, transparent);
    opacity: 0.8;
    color: var(--text-strong);
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.4;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.2), 0 0 0 3px color-mix(in srgb, var(--ghost-color, #42a5f5) 20%, transparent);
    max-width: 270px;
    white-space: pre-wrap;
    word-break: break-word;
    will-change: transform;
  }
  .mm-drag-ghost.hidden { display: none; }

  /* 置于拖拽浮影之上的落点方向标识胶囊（永不被浮影遮挡，单色浓墨高对比胶囊） */
  .mm-drop-pill {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 126;
    pointer-events: none;
    background: var(--ink-strong);
    color: var(--bg-base);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.18rem 0.58rem;
    border-radius: 9999px;
    border: 1.5px solid var(--bg-elev);
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.24);
    will-change: transform;
  }
  :global([data-theme="moss"]) .mm-drop-pill {
    background: #FFC2D1;
    color: #004D40;
  }
