              <button type="button" class="mm-seg-btn" data-wb-layout="mindmap-both">双向导图</button>
              <button type="button" class="mm-seg-btn" data-wb-layout="tree-down">组织树</button>
            </div>
          </div>
        </div>

        <div class="mm-wb-row-actions">
          <div class="flex items-center gap-2 min-w-0">
            <span id="mm-wb-save-state" class="mm-wb-save-state">本地已保存</span>
            <span id="mm-wb-node-stats" class="mm-wb-node-stats">0 节点</span>
            <a id="mm-wb-open-post-link" href="#" class="hidden text-[0.72rem] text-[var(--ink-strong)] underline underline-offset-2 hover:opacity-75 truncate max-w-[14rem]">打开原文 ↗</a>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button type="button" id="mm-wb-undo-btn" class="mm-wb-icon-btn" title="撤销 (Ctrl/Cmd + Z)" aria-label="撤销">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 14 4 9 9 4"></polyline><path d="M20 20v-7a4 4 0 0 0-4-4H4"></path></svg>
            </button>
            <button type="button" id="mm-wb-redo-btn" class="mm-wb-icon-btn" title="重做 (Ctrl/Cmd + Y)" aria-label="重做">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 14 20 9 15 4"></polyline><path d="M4 20v-7a4 4 0 0 1 4-4h12"></path></svg>
            </button>
            <button type="button" id="mm-wb-delete-btn" class="mm-wb-chip-btn text-[var(--muted-strong)] hover:text-red-500 hover:border-red-400" title="删除当前导图">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              <span>删除</span>
            </button>
            <button type="button" id="mm-wb-save-btn" class="mm-wb-chip-btn">保存</button>

            <div class="relative" id="mm-export-dropdown-wrap">
              <button type="button" id="mm-export-trigger" class="mm-wb-primary-btn" aria-haspopup="menu" aria-expanded="false">
                <span>导出</span>
                <svg class="mm-export-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div id="mm-export-menu" class="mm-export-menu article-popover is-closed" role="menu">
                <button type="button" class="mm-export-item" data-export="svg" role="menuitem">导出矢量 SVG</button>
                <button type="button" class="mm-export-item" data-export="png" role="menuitem">导出高清 2x PNG</button>
                <button type="button" class="mm-export-item" data-export="md" role="menuitem">导出 Markdown 大纲</button>
                <button type="button" class="mm-export-item" data-export="json" role="menuitem">导出 JSON 数据</button>
              </div>
            </div>
          </div>
        </div>
      </header>

      <!-- 主工作区：左/全 Canvas + 可拖拽分隔 + 右 Outline -->
      <div class="mm-wb-body" id="mm-wb-body" data-view-mode="canvas">
        <!-- 画布区 -->
        <section class="mm-canvas-pane" id="mm-canvas-pane" aria-label="思维导图可视化画布" data-lenis-prevent>
          <!-- 顶部居中浮动节点微操栏 -->
          <div class="mm-node-pill" id="mm-node-pill" role="toolbar" aria-label="选中节点操作栏">
            <span class="mm-pill-multi-badge hidden" id="mm-pill-multi-badge">已选 0</span>
            <button type="button" class="mm-pill-btn" data-node-act="child" title="添加子节点 (Tab)">+ 子节点</button>
            <button type="button" class="mm-pill-btn" data-node-act="sibling" title="添加同级节点 (Enter)">+ 同级</button>
            <button type="button" class="mm-pill-btn" data-node-act="edit" title="编辑节点标题 (Space / F2 / 双击)">编辑</button>
            <button type="button" class="mm-pill-btn" data-node-act="toggle" title="折叠或展开分支 (/)">折叠/展开</button>
            <button type="button" class="mm-pill-btn" data-node-act="note" title="编辑节点 Markdown 备注">
              <span class="mm-note-badge-dot" aria-hidden="true"></span>
              <span>备注</span>
            </button>
            <button type="button" class="mm-pill-btn mm-pill-icon" data-node-act="up" title="同级上移 (Alt+↑)">↑</button>
            <button type="button" class="mm-pill-btn mm-pill-icon" data-node-act="down" title="同级下移 (Alt+↓)">↓</button>
            <span class="mm-pill-sep" aria-hidden="true"></span>
            <div class="mm-pill-colors" role="group" aria-label="分支色标">
              <button type="button" class="mm-node-cdot" data-node-color="ink" style="--nc:#141517" title="玄墨"></button>
              <button type="button" class="mm-node-cdot" data-node-color="red" style="--nc:#ef5350" title="朱红"></button>
              <button type="button" class="mm-node-cdot" data-node-color="blue" style="--nc:#42a5f5" title="靛青"></button>
              <button type="button" class="mm-node-cdot" data-node-color="green" style="--nc:#66bb6a" title="竹青"></button>
              <button type="button" class="mm-node-cdot" data-node-color="yellow" style="--nc:#ffa726" title="雄黄"></button>
              <button type="button" class="mm-node-cdot" data-node-color="gold" style="--nc:#c9922e" title="赭金"></button>
            </div>
            <span class="mm-pill-sep" aria-hidden="true"></span>
            <button type="button" class="mm-pill-btn text-red-500 hover:bg-red-500/10" data-node-act="delete" title="删除当前节点与子树 (Delete)">删除</button>
          </div>

          <!-- 交互视口：外层独立平移（不缩放置灰） + 内层 CSS zoom 矢量清晰渲染 -->
          <div class="mm-canvas-viewport" id="mm-canvas-viewport" tabindex="-1">
            <div class="mm-canvas-pan" id="mm-canvas-pan">
              <div class="mm-canvas-stage" id="mm-canvas-stage">
                <svg class="mm-links-svg" id="mm-links-svg" aria-hidden="true"></svg>
                <div class="mm-exit-layer" id="mm-exit-layer" aria-hidden="true"></div>
                <div class="mm-nodes-layer" id="mm-nodes-layer"></div>
                <svg class="mm-drag-preview-svg" id="mm-drag-preview-svg" aria-hidden="true"></svg>
                <div class="mm-reorder-indicator hidden" id="mm-reorder-indicator" aria-hidden="true"></div>
              </div>
            </div>
          </div>
          <div class="mm-marquee-box hidden" id="mm-marquee-box" aria-hidden="true"></div>
          <div class="mm-hold-pulse hidden" id="mm-hold-pulse" aria-hidden="true"></div>

          <!-- 节点 Markdown 备注气泡 -->
          <div id="mm-note-popover" class="mm-note-popover hidden" role="dialog" aria-label="节点备注编辑器" data-lenis-prevent>
            <div class="flex items-center justify-between gap-2 pb-2 border-b border-[var(--rule)]">
