---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';

function extractHeadingsFromBody(body: string) {
  const lines = String(body || '').replace(/\r\n?/g, '\n').split('\n');
  const headings: Array<{ depth: number; slug: string; text: string }> = [];
  let inFence = false;
  for (const line of lines) {
    const trimmed = line.trim();
    if (/^(```|~~~)/.test(trimmed)) {
      inFence = !inFence;
      continue;
    }
    if (inFence) continue;
    const match = /^(#{2,4})\s+(.+?)\s*#*$/.exec(trimmed);
    if (!match) continue;
    const text = match[2]
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/`([^`]+)`/g, '$1')
      .replace(/\*\*([^*]+)\*\*/g, '$1')
      .trim();
    if (!text) continue;
    headings.push({ depth: match[1].length, slug: '', text });
  }
  return headings;
}

const allPosts = await getCollection('posts', ({ data }) => !data.draft && !data.locked);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const postsMeta = allPosts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  url: `/posts/${p.id}`,
  category: p.data.category || '',
  headings: extractHeadingsFromBody(p.body || ''),
}));

const postsMetaJson = JSON.stringify(postsMeta).replace(/</g, '\\u003c');
---

<BaseLayout title="MindMap - 梦付千秋" description="可视化思维导图、Markdown 双向大纲与知识脉络梳理工作台">
  <Header />

  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-16 lg:pt-8 outline-none min-h-[calc(100vh-140px)]">
    <script id="mindmap-posts-data" type="application/json" set:html={postsMetaJson} />

    <!-- 1. 顶部标题与数据概览 -->
    <section class="panel pb-8 border-b border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 3%, var(--rule-strong) 50%, transparent 97%) 1;">
      <p class="eyebrow" data-enter="top">Knowledge Map</p>
      <div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between flex-wrap">
        <div class="max-w-2xl">
          <h1 class="section-title" data-enter="left">
            MindMap
          </h1>
        </div>

        <!-- 磁吸滑块统计长条 -->
        <div class="archive-stats-wrap self-start lg:self-auto" data-enter="bloom" data-mm-stats-strip>
          <div class="archive-stats-strip notes-stats-strip" id="mm-stats-strip" aria-label="思维导图统计概览">
            <span class="stats-glider" id="mm-stats-glider" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item is-active" data-mm-stat="all" role="button" tabindex="0" title="查看全部思维导图">
              <span class="stats-label">TOTAL</span>
              <strong class="stats-value" id="mm-stat-total">0</strong>
              <span class="stats-subnote">张总导图</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item" data-mm-stat="nodes" role="button" tabindex="0" title="全站导图节点总数">
              <span class="stats-label">NODES</span>
              <strong class="stats-value" id="mm-stat-nodes">0</strong>
              <span class="stats-subnote">个知识节点</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item" data-mm-stat="cats" role="button" tabindex="0" title="管理自定义导图分类">
              <span class="stats-label">GROUPS</span>
              <strong class="stats-value" id="mm-stat-cats">4</strong>
              <span class="stats-subnote">个分类栏目</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item" data-mm-stat="linked" role="button" tabindex="0" title="仅筛选已关联文章的导图">
              <span class="stats-label">LINKED</span>
              <strong class="stats-value" id="mm-stat-linked">0</strong>
              <span class="stats-subnote">张关联文章</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 分类胶囊与操作工具栏 -->
    <section class="my-6 space-y-4" data-enter="bottom">
      <div class="flex flex-col lg:flex-row lg:items-center lg:flex-wrap justify-between gap-4">
        <!-- 动态分类胶囊条 + 管理入口 -->
        <div class="flex items-center gap-2 max-w-full min-w-0">
          <div class="subtabs-cluster self-start" id="mm-subtabs-cluster" role="tablist" aria-label="思维导图分类切换">
            <span class="subtabs-glider" id="mm-subtabs-glider" aria-hidden="true"></span>
            <!-- JS 动态渲染 全部导图 + 各分类胶囊 -->
          </div>
          <button
            id="mm-cat-manager-btn"
            type="button"
            class="w-9 h-9 rounded-full border border-[var(--rule)] bg-[var(--bg-elev)] text-[var(--muted-strong)] hover:text-[var(--text-strong)] hover:border-[var(--ink-strong)] transition duration-200 flex items-center justify-center shrink-0 cursor-pointer shadow-sm"
            title="新建、重命名、排序或删除分类"
            aria-label="管理思维导图分类"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </button>
        </div>

        <!-- 检索与核心动作群 -->
        <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap">
          <div class="relative w-full sm:w-60">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--muted)] pointer-events-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="mm-search-input"
              aria-label="搜索思维导图"
              placeholder="搜索标题、标签、节点..."
              class="w-full bg-[var(--bg-elev)] border border-[var(--rule)] text-xs rounded-full pl-9 pr-8 py-2 text-[var(--text-strong)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--ink-strong)] transition duration-200"
            />
            <button
              id="mm-search-clear-btn"
              type="button"
              class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-[var(--muted)] hover:text-[var(--text-strong)] p-0.5 rounded-full transition cursor-pointer"
              aria-label="清除搜索关键字"
              title="清除搜索"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <button
            id="mm-new-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold bg-[var(--ink-strong)] text-[var(--bg-base)] hover:opacity-90 active:scale-95 transition duration-200 shadow-sm cursor-pointer"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>新建导图</span>
          </button>

          <button
            id="mm-from-post-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full border border-[var(--rule)] text-xs font-medium text-[var(--text-strong)] bg-[var(--bg-elev)] hover:border-[var(--ink-strong)] active:scale-95 transition duration-200 cursor-pointer"
            title="从任意博客文章标题大纲与划线笔记自动生成导图骨架"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            <span>从文章生成</span>
          </button>

          <button
            id="mm-sync-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full border border-[var(--rule)] text-xs font-medium text-[var(--muted-strong)] bg-[var(--bg-elev)] hover:text-[var(--text-strong)] hover:border-[var(--ink-strong)] active:scale-95 transition duration-200 cursor-pointer"
            title="手动触发思维导图与私有云端增量同步"
          >
            <svg id="mm-sync-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
            </svg>
            <span id="mm-sync-text">同步</span>
          </button>
        </div>
      </div>

      <!-- 二级维度筛选：关联文章 + 五色色标 -->
      <div class="flex flex-wrap items-center gap-4 pt-1">
        <div class="relative inline-block" id="mm-article-popover-container">
          <button
            type="button"
            id="mm-article-popover-trigger"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--rule)] bg-[var(--bg-elev)] text-xs text-[var(--text-strong)] hover:border-[var(--ink-strong)] transition duration-200 shadow-sm font-medium cursor-pointer"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="mm-article-popover-panel"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--muted)]">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span id="mm-article-trigger-label" class="max-w-[14rem] truncate">关联文章: 全部来源 (0)</span>
            <span id="mm-article-quick-clear" class="hidden hover:text-red-500 p-0.5 rounded cursor-pointer" title="清除文章筛选" role="button" aria-label="清除文章筛选">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--muted)] ml-0.5 shrink-0"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>

          <div
            id="mm-article-popover-panel"
            class="article-popover is-closed absolute left-0 top-full mt-2 w-80 max-w-[90vw] p-2.5"
            role="dialog"
            aria-modal="false"
            aria-label="按关联文章筛选导图"
            aria-hidden="true"
            inert
            data-lenis-prevent
          >
            <div class="relative mb-2">
              <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-[var(--muted)] pointer-events-none" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="mm-article-filter-input"
                aria-label="过滤关联文章"
                placeholder="过滤关联文章..."
                class="w-full bg-[var(--bg-soft)] border border-[var(--rule)] text-xs rounded-full pl-7 pr-2.5 py-1.5 text-[var(--text-strong)] placeholder-[var(--muted)] focus:outline-none focus-visible:outline-none focus:border-[var(--ink-strong)]"
              />
            </div>
            <div class="max-h-60 overflow-y-auto space-y-1 text-xs" id="mm-article-filter-list" role="listbox" aria-label="关联文章清单"></div>
          </div>
        </div>

        <div class="h-4 w-px bg-[var(--rule)]"></div>

        <!-- 五色标记点过滤 -->
        <div class="flex items-center gap-1.5" role="group" aria-label="按导图色标筛选">
          <button type="button" class="all-color-pill active" data-mm-color="all" aria-pressed="true">全部</button>
          <button type="button" class="color-dot-btn" data-mm-color="red" style="--dot-color: #ef5350;" title="朱红" aria-label="按朱红筛选" aria-pressed="false"></button>
          <button type="button" class="color-dot-btn" data-mm-color="blue" style="--dot-color: #42a5f5;" title="靛青" aria-label="按靛青筛选" aria-pressed="false"></button>
          <button type="button" class="color-dot-btn" data-mm-color="green" style="--dot-color: #66bb6a;" title="竹青" aria-label="按竹青筛选" aria-pressed="false"></button>
          <button type="button" class="color-dot-btn" data-mm-color="yellow" style="--dot-color: #ffa726;" title="雄黄" aria-label="按雄黄筛选" aria-pressed="false"></button>
          <button type="button" class="color-dot-btn" data-mm-color="gold" style="--dot-color: #c9922e;" title="赭金" aria-label="按赭金筛选" aria-pressed="false"></button>
        </div>
      </div>
    </section>

    <!-- 3. 多列看板 -->
    <section id="mindmaps-container" class="notes-masonry-board pt-2" data-enter-hold></section>

    <!-- 空状态 -->
    <div id="mm-empty-state" class="notes-empty-state hidden mt-8 text-center py-16 panel max-w-xl mx-auto">
      <div class="w-16 h-16 rounded-full bg-[var(--bg-soft)] border border-[var(--rule)] mx-auto flex items-center justify-center text-[var(--muted)] mb-4 shadow-sm">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="9" width="6" height="6" rx="1.5"></rect>
          <rect x="15" y="4" width="6" height="5" rx="1.5"></rect>
          <rect x="15" y="15" width="6" height="5" rx="1.5"></rect>
          <path d="M9 12h3m0-5v10m0-10h3m-3 10h3"></path>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-[var(--text-strong)]" id="mm-empty-title">暂无思维导图</h3>
      <p class="text-xs text-[var(--muted-strong)] mt-2 max-w-md mx-auto leading-relaxed" id="mm-empty-desc">
        可以从空白画布开启自由发散，或直接从任意博客文章的标题大纲与划线笔记中一键抽取结构化导图。
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2.5 mt-6">
        <button type="button" id="mm-empty-create-btn" class="btn-primary text-xs py-2 px-4 cursor-pointer">+ 新建思维导图</button>
        <button type="button" id="mm-empty-article-btn" class="btn-secondary text-xs py-2 px-4 cursor-pointer">从文章生成</button>
        <button type="button" id="mm-empty-reset-btn" class="btn-secondary hidden text-xs py-2 px-4 cursor-pointer">重置筛选</button>
      </div>
    </div>
  </main>

  <!-- 4. 分类管理弹层 -->
  <div
    id="mm-cat-modal"
    class="fixed inset-0 z-50 modal-overlay is-closed hidden flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mm-cat-modal-title"
    data-lenis-prevent
  >
    <div id="mm-cat-card" tabindex="-1" class="bg-[var(--bg-elev)] border border-[var(--rule-strong)] rounded-2xl w-full max-w-md overflow-hidden shadow-2xl modal-card flex flex-col max-h-[82vh] outline-none">
      <div class="px-5 py-3.5 border-b border-[var(--rule)] bg-[var(--bg-soft)] flex items-center justify-between">
        <div>
          <h3 id="mm-cat-modal-title" class="text-sm font-bold text-[var(--text-strong)]">管理导图分类</h3>
          <p class="text-[0.72rem] text-[var(--muted)] mt-0.5">支持新建、重命名、调序与删除；改动会随云端同步</p>
        </div>
        <button type="button" id="mm-cat-close-btn" class="w-8 h-8 rounded-full flex items-center justify-center text-[var(--muted)] hover:text-[var(--text-strong)] hover:bg-[var(--accent-soft)] transition cursor-pointer" aria-label="关闭分类管理">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="p-5 overflow-y-auto space-y-4 flex-1" data-lenis-prevent>
        <form id="mm-cat-add-form" class="flex items-center gap-2">
          <input
            type="text"
            id="mm-cat-new-input"
            maxlength="32"
            placeholder="输入新分类名称（如：图形学、工程化）..."
            class="flex-1 bg-[var(--bg-soft)] border border-[var(--rule)] rounded-lg px-3 py-2 text-xs text-[var(--text-strong)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--ink-strong)]"
          />
          <button type="submit" class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-[var(--ink-strong)] text-[var(--bg-base)] hover:opacity-90 transition cursor-pointer shrink-0">添加</button>
        </form>
        <div id="mm-cat-list" class="space-y-2"></div>
      </div>
    </div>
  </div>

  <!-- 5. 从文章生成导图弹层 -->
  <div
    id="mm-article-gen-modal"
    class="fixed inset-0 z-50 modal-overlay is-closed hidden flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mm-gen-modal-title"
    data-lenis-prevent
  >
    <div id="mm-gen-card" tabindex="-1" class="bg-[var(--bg-elev)] border border-[var(--rule-strong)] rounded-2xl w-full max-w-2xl overflow-visible shadow-2xl modal-card flex flex-col max-h-[85vh] outline-none">
      <div class="px-5 py-3.5 border-b border-[var(--rule)] bg-[var(--bg-soft)] rounded-t-2xl flex items-center justify-between gap-3">
        <div>
          <h3 id="mm-gen-modal-title" class="text-sm font-bold text-[var(--text-strong)]">从博客文章与划线笔记生成导图</h3>
          <p class="text-[0.72rem] text-[var(--muted)] mt-0.5">自动抽取文章 H2/H3/H4 脉络，可选融合该文章的高亮批注与墨问 AI 问答</p>
        </div>
        <button type="button" id="mm-gen-close-btn" class="w-8 h-8 rounded-full flex items-center justify-center text-[var(--muted)] hover:text-[var(--text-strong)] hover:bg-[var(--accent-soft)] transition cursor-pointer" aria-label="关闭生成器">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="p-5 flex-1 min-h-0 flex flex-col gap-4">
        <div class="flex flex-col sm:flex-row gap-2.5 shrink-0">
          <input
            type="text"
            id="mm-gen-search"
            placeholder="搜索文章标题或分类..."
            class="flex-1 bg-[var(--bg-soft)] border border-[var(--rule)] rounded-full px-3.5 py-2 text-xs text-[var(--text-strong)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--ink-strong)]"
          />
          <div class="mm-cselect mm-cselect-modal" id="mm-gen-category-wrap">
            <button type="button" id="mm-gen-category-trigger" class="mm-cselect-trigger mm-cselect-modal-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="生成后归入分类">
              <span class="mm-cselect-label truncate">默认分类</span>
              <svg class="mm-cselect-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div id="mm-gen-category-panel" class="mm-cselect-panel article-popover is-closed" role="listbox" aria-label="选择生成分类" tabindex="-1"></div>
          </div>
        </div>
        <label class="inline-flex items-center gap-2 text-xs text-[var(--muted-strong)] cursor-pointer select-none shrink-0">
          <input type="checkbox" id="mm-gen-include-notes" checked class="rounded border-[var(--rule-strong)] accent-[var(--ink-strong)]" />
