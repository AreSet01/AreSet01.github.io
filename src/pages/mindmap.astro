<script>
  import gsap from 'gsap';
  import CustomEase from 'gsap/CustomEase';
  import { addCardExit, animateCardEnter, cardExitDuration, clearCardMotion } from '../utils/cardMotion';
  import {
    MINDMAP_STORAGE_KEY,
    MINDMAP_CATEGORIES_KEY,
    addChildNode,
    addMindMapCategory,
    addSiblingNode,
    buildInkBranchPath,
    buildMindMapFromArticle,
    buildTopologyPreviewSvg,
    cloneNode,
    colorHex,
    computeInkBranchOpacity,
    computeInkBranchStrokeWidth,
    countNodes,
    countSubtreeDescendants,
    createBlankMindMap,
    deleteMindMap,
    deleteMindMapCategory,
    exportMindMapMarkdown,
    findNodeById,
    findNodePath,
    isDescendant,
    loadActiveMindMaps,
    loadMindMapCategoryState,
    markdownToMindmap,
    mindmapToMarkdown,
    moveSiblingNode,
    normalizeCardColor,
    normalizeLayout,
    normalizePostSlug,
    removeNode,
    removeNodesBatch,
    renameMindMapCategory,
    renderNodeInlineHtml,
    reorderMindMapCategories,
    reparentOrReorderNode,
    setAllCollapsed,
    updateNodeProps,
    updateNodesColorBatch,
    upsertMindMap,
    type MindMapCardColor,
    type MindMapColor,
    type MindMapLayout,
    type MindMapNode,
    type MindMapRecord,
    type PostHeadingItem,
  } from '../utils/mindmapEngine';
  import { getAllNotesAcrossSite } from '../utils/articleHighlightEngine';
  import { initMindmapSync, syncMindMapsNow } from '../utils/mindmapSync';
  import { renderMarkdown } from '../utils/inkAskMarkdown';
  import { createMarkdownToolbar, handleMarkdownKeydown } from '../utils/markdownShortcuts';

  initMindmapSync();

  const CLEANUP_KEY = '__areSetMindmapPageCleanup__';
  const LEGACY_CLEANUP_KEY = '__areSetMindmapPageCleanup';
  const LISTENER_KEY = '__areSetMindmapPageListener__';

  interface PostMetaItem {
    slug: string;
    title: string;
    url: string;
    category: string;
    headings: PostHeadingItem[];
  }

  interface NodeBox {
    node: MindMapNode;
    depth: number;
    parentId: string | null;
    side: 'left' | 'right' | 'root' | 'down';
    x: number;
    y: number;
    w: number;
    h: number;
    color: string;
  }

  function initMindmapPage() {
    const container = document.getElementById('mindmaps-container');
    const oldCleanup = (window as any)[CLEANUP_KEY] || (window as any)[LEGACY_CLEANUP_KEY];
    if (!container) {
      if (typeof oldCleanup === 'function') oldCleanup();
      (window as any)[CLEANUP_KEY] = undefined;
      (window as any)[LEGACY_CLEANUP_KEY] = undefined;
      return;
    }
    if (container.dataset.mmInit === '1') return;
    if (typeof oldCleanup === 'function') oldCleanup();
    container.dataset.mmInit = '1';

    gsap.registerPlugin(CustomEase);
    try {
      CustomEase.create('enter', '0.16, 1, 0.3, 1');
    } catch {}

    const controller = new AbortController();
    const { signal } = controller;

    // Parse SSR blog posts metadata
    let postsMeta: PostMetaItem[] = [];
    try {
      const jsonEl = document.getElementById('mindmap-posts-data');
      if (jsonEl?.textContent) {
        postsMeta = JSON.parse(jsonEl.textContent) || [];
      }
    } catch {}
    const postBySlug = new Map<string, PostMetaItem>(postsMeta.map((p) => [p.slug, p]));

    // ---------- DOM Refs ----------
    const emptyState = document.getElementById('mm-empty-state')!;
    const emptyTitle = document.getElementById('mm-empty-title')!;
    const emptyDesc = document.getElementById('mm-empty-desc')!;
    const emptyResetBtn = document.getElementById('mm-empty-reset-btn')!;
    const subtabsCluster = document.getElementById('mm-subtabs-cluster')!;
    const subtabsGlider = document.getElementById('mm-subtabs-glider')!;
    const searchInput = document.getElementById('mm-search-input') as HTMLInputElement;
    const searchClearBtn = document.getElementById('mm-search-clear-btn')!;
    const articleTrigger = document.getElementById('mm-article-popover-trigger')!;
    const articlePanel = document.getElementById('mm-article-popover-panel')!;
    const articleFilterInput = document.getElementById('mm-article-filter-input') as HTMLInputElement;
    const articleFilterList = document.getElementById('mm-article-filter-list')!;
    const articleTriggerLabel = document.getElementById('mm-article-trigger-label')!;
    const articleQuickClear = document.getElementById('mm-article-quick-clear')!;

    // Modals
    const catModal = document.getElementById('mm-cat-modal')!;
    const catCard = document.getElementById('mm-cat-card')!;
    const catListEl = document.getElementById('mm-cat-list')!;
    const catNewInput = document.getElementById('mm-cat-new-input') as HTMLInputElement;
    const genModal = document.getElementById('mm-article-gen-modal')!;
    const genCard = document.getElementById('mm-gen-card')!;
    const genSearch = document.getElementById('mm-gen-search') as HTMLInputElement;
    const genIncludeNotes = document.getElementById('mm-gen-include-notes') as HTMLInputElement;
    const genPostList = document.getElementById('mm-gen-post-list')!;
    const confirmModal = document.getElementById('mm-confirm-modal')!;
    const confirmCard = document.getElementById('mm-confirm-card')!;
    const confirmTitle = document.getElementById('mm-confirm-title')!;
    const confirmDesc = document.getElementById('mm-confirm-desc')!;
    const confirmOkBtn = document.getElementById('mm-confirm-ok-btn')!;
    const confirmCancelBtn = document.getElementById('mm-confirm-cancel-btn')!;

    // Workbench
    const wbModal = document.getElementById('mm-workbench-modal')!;
    const wbDialog = document.getElementById('mm-workbench-dialog')!;
    const measureBox = document.getElementById('mm-measure-box')!;
    const wbTitleInput = document.getElementById('mm-wb-title-input') as HTMLInputElement;
    const wbTagsInput = document.getElementById('mm-wb-tags-input') as HTMLInputElement;
    const viewModeSwitch = document.getElementById('mm-view-mode-switch')!;
    const layoutSwitch = document.getElementById('mm-layout-switch')!;
    const wbSaveState = document.getElementById('mm-wb-save-state')!;
    const wbNodeStats = document.getElementById('mm-wb-node-stats')!;
    const wbOpenPostLink = document.getElementById('mm-wb-open-post-link') as HTMLAnchorElement;
    const wbBody = document.getElementById('mm-wb-body')!;
    const wbUndoBtn = document.getElementById('mm-wb-undo-btn') as HTMLButtonElement;
    const wbRedoBtn = document.getElementById('mm-wb-redo-btn') as HTMLButtonElement;
    const exportWrap = document.getElementById('mm-export-dropdown-wrap')!;
    const exportTrigger = document.getElementById('mm-export-trigger')!;
    const exportMenu = document.getElementById('mm-export-menu')!;
    const canvasPane = document.getElementById('mm-canvas-pane')!;
    const canvasViewport = document.getElementById('mm-canvas-viewport')!;
    const canvasPan = document.getElementById('mm-canvas-pan')!;
    const canvasStage = document.getElementById('mm-canvas-stage')!;
    const linksSvg = document.getElementById('mm-links-svg') as unknown as SVGSVGElement;
    const exitLayer = document.getElementById('mm-exit-layer')!;
    const nodesLayer = document.getElementById('mm-nodes-layer')!;
    const dragPreviewSvg = document.getElementById('mm-drag-preview-svg') as unknown as SVGSVGElement;
    const dragGhostEl = document.getElementById('mm-drag-ghost')!;
    const dropPillEl = document.getElementById('mm-drop-pill')!;
    const reorderIndicatorEl = document.getElementById('mm-reorder-indicator')!;
    const marqueeBoxEl = document.getElementById('mm-marquee-box')!;
    const holdPulseEl = document.getElementById('mm-hold-pulse')!;
    const nodePill = document.getElementById('mm-node-pill')!;
    const pillMultiBadge = document.getElementById('mm-pill-multi-badge')!;
    const notePopover = document.getElementById('mm-note-popover')!;
    const notePopTitle = document.getElementById('mm-note-pop-title')!;
    const noteTextarea = document.getElementById('mm-note-textarea') as HTMLTextAreaElement;
    const notePreview = document.getElementById('mm-note-preview')!;
    const noteModeBtn = document.getElementById('mm-note-mode-btn')!;
    const minimapEl = document.getElementById('mm-minimap')!;
    const minimapSvg = document.getElementById('mm-minimap-svg') as unknown as SVGSVGElement;
    const minimapVpEl = document.getElementById('mm-minimap-vp')!;
    const zoomLabel = document.getElementById('mm-zoom-label')!;
    const splitResizer = document.getElementById('mm-split-resizer')!;
    const outlinePane = document.getElementById('mm-outline-pane')!;
    const outlineTextarea = document.getElementById('mm-outline-textarea') as HTMLTextAreaElement;
    const outlineToolbarHost = document.getElementById('mm-outline-md-toolbar')!;

    // ---------- Layer 1 State ----------
    let mapsList: MindMapRecord[] = [];
    let categories: string[] = [];
    let filterCategory = 'all';
    let filterColor = 'all';
    let filterPostSlug = 'all';
    let filterLinkedOnly = false;
    let searchQuery = '';
    let isSelfDeleting = false;
    let cardFilterTimeline: gsap.core.Timeline | null = null;
    let toastTimer: number | null = null;
    let confirmResolver: ((ok: boolean) => void) | null = null;

    // ---------- Layer 2 Workbench State ----------
    let activeMap: MindMapRecord | null = null;
    let selectedNodeId: string | null = null;
    let selectedNodeIds = new Set<string>();
    let editingNodeId: string | null = null;
    let undoStack: MindMapNode[] = [];
    let redoStack: MindMapNode[] = [];
    let viewMode: 'canvas' | 'split' | 'outline' = 'canvas';
    let panX = 120;
    let panY = 120;
    let zoom = 1;
    let stageRasterZoom = 1;
    let stageW = 900;
    let stageH = 600;
    let laidOutBoxes = new Map<string, NodeBox>();
    const measureCache = new Map<string, { w: number; h: number }>();
    document.fonts?.ready.then(() => {
      measureCache.clear();
    });
    const nodeDomMap = new Map<string, HTMLElement>();
    const linkDomMap = new Map<string, SVGPathElement>();
    let outlinePendingBaseline: { boxes: Map<string, NodeBox>; rootIds: Set<string> } | null = null;
    let panAnimCleanupTimer: number | null = null;
    let viewportRafId: number | null = null;
    let linkMorphRafId: number | null = null;
    let wheelSettleTimer: number | null = null;
    let holdPulseTimer: number | null = null;
    let autosaveTimer: number | null = null;
    let outlineSyncTimer: number | null = null;
    let suppressOutlineInput = false;
    let notePreviewMode = false;
    let modalCloseTimers: number[] = [];

    const toastEl = document.getElementById('mm-toast')!;
    const toastMsgEl = document.getElementById('mm-toast-msg')!;
    function showToast(msg: string) {
      toastMsgEl.textContent = msg;
      toastEl.classList.remove('translate-y-12', 'opacity-0');
      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toastEl.classList.add('translate-y-12', 'opacity-0');
      }, 2400);
    }

    const escapeHtml = (v: unknown): string =>
      String(v ?? '').replace(/[&<>"']/g, (ch) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch] || ch
      ));

    function layoutLabel(layout: MindMapLayout): string {
      if (layout === 'mindmap-both') return '双向导图';
      if (layout === 'tree-down') return '组织树';
      return '右侧逻辑';
    }

    function formatRelativeTime(ts: number): string {
      const diff = Math.max(0, Date.now() - ts);
      const min = Math.floor(diff / 60_000);
      if (min < 1) return '刚刚';
      if (min < 60) return `${min} 分钟前`;
      const hr = Math.floor(min / 60);
      if (hr < 24) return `${hr} 小时前`;
      const day = Math.floor(hr / 24);
      if (day < 30) return `${day} 天前`;
      return new Date(ts).toLocaleDateString('zh-CN');
    }

    function stopLenis() {
      document.body.classList.add('notes-modal-open');
      (window as any).lenis?.stop?.();
    }

    function startLenisIfNoModal() {
      const openOverlay = document.querySelector('.modal-overlay:not(.hidden)');
      if (!openOverlay) {
        document.body.classList.remove('notes-modal-open');
        (window as any).lenis?.start?.();
      }
    }

    function openOverlay(overlay: HTMLElement, focusTarget?: HTMLElement | null) {
      overlay.classList.remove('hidden');
      stopLenis();
      requestAnimationFrame(() => {
        overlay.classList.remove('is-closed');
        overlay.classList.add('is-open');
        focusTarget?.focus({ preventScroll: true });
      });
    }

    function closeOverlay(overlay: HTMLElement, cb?: () => void) {
      overlay.classList.remove('is-open');
      overlay.classList.add('is-closed');
      const tid = window.setTimeout(() => {
        overlay.classList.add('hidden');
        startLenisIfNoModal();
        cb?.();
      }, 220);
      modalCloseTimers.push(tid);
    }

    function askConfirm(title: string, desc: string): Promise<boolean> {
      confirmTitle.textContent = title;
      confirmDesc.textContent = desc;
      openOverlay(confirmModal, confirmCancelBtn);
      return new Promise((resolve) => {
        confirmResolver = resolve;
      });
    }

    confirmCancelBtn.addEventListener('click', () => {
      const res = confirmResolver;
      confirmResolver = null;
      closeOverlay(confirmModal, () => res?.(false));
    }, { signal });
    confirmOkBtn.addEventListener('click', () => {
      const res = confirmResolver;
      confirmResolver = null;
      closeOverlay(confirmModal, () => res?.(true));
    }, { signal });

    // ---------- Stats Glider ----------
    const statsStrip = document.getElementById('mm-stats-strip');
    const statsGlider = document.getElementById('mm-stats-glider');
    const statsItems = statsStrip
      ? Array.from(statsStrip.querySelectorAll<HTMLElement>('[data-mm-stat]'))
      : [];

    function syncStatsGliderToEl(targetEl: HTMLElement | null) {
      if (!statsStrip || !statsGlider) return;
      if (!targetEl) {
        statsGlider.classList.remove('is-visible');
        return;
      }
      const stripRect = statsStrip.getBoundingClientRect();
      const itemRect = targetEl.getBoundingClientRect();
      if (!itemRect.width) return;
      statsGlider.style.width = `${itemRect.width.toFixed(1)}px`;
      statsGlider.style.height = `${itemRect.height.toFixed(1)}px`;
      statsGlider.style.transform = `translate3d(${(itemRect.left - stripRect.left).toFixed(1)}px, ${(itemRect.top - stripRect.top).toFixed(1)}px, 0)`;
      statsGlider.classList.add('is-visible');
    }

    function updateStatsStripActive() {
      const activeKey = filterLinkedOnly ? 'linked' : 'all';
      statsItems.forEach((item) => {
        item.classList.toggle('is-active', item.dataset.mmStat === activeKey);
      });
      const activeEl = statsStrip?.querySelector<HTMLElement>('.notes-stat-item.is-active') || statsItems[0] || null;
      requestAnimationFrame(() => syncStatsGliderToEl(activeEl));
    }

    if (statsStrip) {
      statsItems.forEach((item) => {
        item.addEventListener('pointerenter', () => syncStatsGliderToEl(item), { signal });
        item.addEventListener('click', () => {
          const mode = item.dataset.mmStat;
          if (mode === 'cats') {
            openCategoryManager();
          } else if (mode === 'linked') {
            filterLinkedOnly = !filterLinkedOnly;
            updateStatsStripActive();
            renderCards(true);
          } else if (mode === 'all') {
            filterLinkedOnly = false;
            filterCategory = 'all';
            filterColor = 'all';
            filterPostSlug = 'all';
            renderSubtabs();
            syncColorButtons();
            renderArticleDropdown();
            updateStatsStripActive();
            renderCards(true);
          }
        }, { signal });
      });
      statsStrip.addEventListener('pointerleave', () => {
        const activeEl = statsStrip.querySelector<HTMLElement>('.notes-stat-item.is-active') || null;
        syncStatsGliderToEl(activeEl);
      }, { signal });
    }

    // ---------- Subtabs Glider & Dynamic Categories ----------
    function updateSubtabsGlider() {
      const activeBtn = subtabsCluster.querySelector<HTMLElement>('.sub-tab-btn.active');
      if (!activeBtn || !activeBtn.offsetWidth) {
        subtabsGlider.style.opacity = '0';
        return;
      }
      const w = activeBtn.offsetWidth;
      const h = subtabsGlider.offsetHeight || activeBtn.offsetHeight;
      const sx = Math.max(0.05, w / 100);
      const halfR = Math.min(w, h) * 0.5;
      subtabsGlider.style.opacity = '1';
      subtabsGlider.style.setProperty('--pill-rx', `${(halfR / sx).toFixed(2)}px`);
      subtabsGlider.style.setProperty('--pill-ry', `${halfR.toFixed(2)}px`);
      subtabsGlider.style.transform = `translate3d(${activeBtn.offsetLeft}px, 0, 0) scaleX(${sx.toFixed(4)})`;
    }

    function renderSubtabs() {
      // Remove existing buttons while preserving glider
      subtabsCluster.querySelectorAll('.sub-tab-btn').forEach((b) => b.remove());
      const list = [{ key: 'all', label: '全部导图' }, ...categories.map((c) => ({ key: c, label: c }))];
      if (filterCategory !== 'all' && !categories.includes(filterCategory)) {
        filterCategory = 'all';
      }
      for (const item of list) {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isActive = filterCategory === item.key;
        btn.className = `sub-tab-btn${isActive ? ' active' : ''}`;
        btn.dataset.mmCat = item.key;
        btn.setAttribute('aria-pressed', String(isActive));
        btn.textContent = item.label;
        btn.addEventListener('click', () => {
          if (filterCategory === item.key) return;
          filterCategory = item.key;
          renderSubtabs();
          renderCards(true);
        }, { signal });
        subtabsCluster.appendChild(btn);
      }
      requestAnimationFrame(updateSubtabsGlider);
    }

    // ---------- Custom Frosted Popover Selects + Glider Helpers ----------
    interface CustomSelectOption {
      value: string;
      label: string;
      dotColor?: string;
      badge?: string;
    }

    interface CustomSelectController {
      setOptions(opts: CustomSelectOption[]): void;
      setValue(val: string): void;
      getValue(): string;
      isOpen(): boolean;
      setOpen(open: boolean): void;
      refreshView(): void;
    }

    const CARD_COLOR_OPTIONS: CustomSelectOption[] = [
      { value: 'blue', label: '靛青', dotColor: '#42a5f5' },
      { value: 'red', label: '朱红', dotColor: '#ef5350' },
      { value: 'green', label: '竹青', dotColor: '#66bb6a' },
      { value: 'yellow', label: '雄黄', dotColor: '#ffa726' },
      { value: 'gold', label: '赭金', dotColor: '#c9922e' },
    ];

    const dropdownControllers: Array<{ el: HTMLElement; isOpen: () => boolean; close: () => void }> = [];

    function closeAllDropdowns(exceptEl?: HTMLElement) {
      for (const ctrl of dropdownControllers) {
        if (exceptEl && ctrl.el === exceptEl) continue;
        if (ctrl.isOpen()) ctrl.close();
      }
    }

    function hasOpenDropdown(): boolean {
      return dropdownControllers.some((ctrl) => ctrl.isOpen());
    }

    function setExportMenuOpen(open: boolean) {
      if (open) closeAllDropdowns(exportWrap);
      exportTrigger.setAttribute('aria-expanded', String(open));
      exportMenu.setAttribute('aria-hidden', String(!open));
      if (open) {
        exportMenu.removeAttribute('inert');
        exportMenu.classList.remove('is-closed');
        exportMenu.classList.add('is-open');
      } else {
        exportMenu.setAttribute('inert', '');
        exportMenu.classList.remove('is-open');
        exportMenu.classList.add('is-closed');
      }
    }

    dropdownControllers.push({
      el: exportWrap,
      isOpen: () => exportMenu.classList.contains('is-open'),
      close: () => setExportMenuOpen(false),
    });

    function createCustomSelect(config: {
      wrapId: string;
      triggerId: string;
      panelId: string;
      listId?: string;
      searchInputId?: string;
      fallbackLabel?: string;
      onChange?: (value: string) => void;
    }): CustomSelectController {
      const wrap = document.getElementById(config.wrapId)!;
      const trigger = document.getElementById(config.triggerId) as HTMLButtonElement;
      const panel = document.getElementById(config.panelId)!;
      const listEl = config.listId ? document.getElementById(config.listId)! : panel;
      const searchInput = config.searchInputId
        ? (document.getElementById(config.searchInputId) as HTMLInputElement)
        : null;
      const labelEl = trigger.querySelector<HTMLElement>('.mm-cselect-label')!;
      const dotEl = trigger.querySelector<HTMLElement>('.mm-cselect-dot');

      let options: CustomSelectOption[] = [];
      let currentValue = '';
      let focusedIdx = -1;

      panel.setAttribute('aria-hidden', 'true');
      panel.setAttribute('inert', '');

      const getFiltered = (): CustomSelectOption[] => {
        const kw = (searchInput?.value || '').trim().toLowerCase();
        if (!kw) return options;
        return options.filter(
          (o) =>
            o.label.toLowerCase().includes(kw) ||
            (o.badge || '').toLowerCase().includes(kw)
        );
      };

      const syncTriggerDisplay = () => {
        const matched = options.find((o) => o.value === currentValue) || options[0];
        labelEl.textContent = matched ? matched.label : (config.fallbackLabel || '');
        if (dotEl && matched?.dotColor) {
          dotEl.style.setProperty('--dot-color', matched.dotColor);
        }
      };

      const renderOptions = () => {
        const filtered = getFiltered();
        if (!filtered.length) {
          listEl.innerHTML = '<div class="mm-cselect-empty">未找到匹配项</div>';
          focusedIdx = -1;
          return;
        }
        listEl.innerHTML = filtered
          .map((opt, idx) => {
            const isSel = opt.value === currentValue;
            const isFoc = idx === focusedIdx;
            const dotHtml = opt.dotColor
              ? `<span class="mm-cselect-dot" style="--dot-color:${escapeHtml(opt.dotColor)};" aria-hidden="true"></span>`
              : '';
            const badgeHtml = opt.badge
              ? `<span class="mm-cselect-opt-sub">${escapeHtml(opt.badge)}</span>`
              : '';
            return `
              <button
                type="button"
                role="option"
                aria-selected="${isSel}"
                data-cselect-idx="${idx}"
                data-cselect-val="${escapeHtml(opt.value)}"
                class="mm-cselect-opt${isSel ? ' is-selected' : ''}${isFoc ? ' is-focused' : ''}"
              >
                <span class="mm-cselect-opt-main">
                  ${dotHtml}
                  <span class="mm-cselect-opt-text">${escapeHtml(opt.label)}</span>
                </span>
                ${badgeHtml}
                <svg class="mm-cselect-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </button>
            `;
          })
          .join('');

        listEl.querySelectorAll<HTMLButtonElement>('[data-cselect-val]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const val = btn.dataset.cselectVal ?? '';
            const changed = val !== currentValue;
            currentValue = val;
            syncTriggerDisplay();
            setOpen(false);
            trigger.focus();
            if (changed) config.onChange?.(currentValue);
          });
        });
      };

      const isOpen = () => panel.classList.contains('is-open');

      const setOpen = (open: boolean) => {
        if (open) closeAllDropdowns(wrap);
        trigger.setAttribute('aria-expanded', String(open));
        panel.setAttribute('aria-hidden', String(!open));
        if (open) {
          panel.removeAttribute('inert');
          panel.classList.remove('is-closed');
          panel.classList.add('is-open');
          if (searchInput) searchInput.value = '';
          const activePos = options.findIndex((o) => o.value === currentValue);
          focusedIdx = activePos >= 0 ? activePos : 0;
          renderOptions();
          requestAnimationFrame(() => {
            if (searchInput) searchInput.focus();
            else panel.focus();
            listEl.querySelector<HTMLElement>('.mm-cselect-opt.is-selected')?.scrollIntoView({ block: 'nearest' });
          });
        } else {
          panel.setAttribute('inert', '');
          panel.classList.remove('is-open');
          panel.classList.add('is-closed');
        }
      };

      const handleKeyNav = (e: KeyboardEvent) => {
        if (!isOpen()) return;
        const filtered = getFiltered();
        if (e.key === 'Escape') {
          e.preventDefault();
          e.stopPropagation();
          setOpen(false);
          trigger.focus();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (!filtered.length) return;
          focusedIdx = (focusedIdx + 1) % filtered.length;
          renderOptions();
          listEl.querySelector<HTMLElement>(`[data-cselect-idx="${focusedIdx}"]`)?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (!filtered.length) return;
          focusedIdx = focusedIdx <= 0 ? filtered.length - 1 : focusedIdx - 1;
          renderOptions();
          listEl.querySelector<HTMLElement>(`[data-cselect-idx="${focusedIdx}"]`)?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter' && focusedIdx >= 0 && filtered[focusedIdx]) {
          e.preventDefault();
          const chosen = filtered[focusedIdx].value;
          const changed = chosen !== currentValue;
          currentValue = chosen;
          syncTriggerDisplay();
          setOpen(false);
          trigger.focus();
          if (changed) config.onChange?.(currentValue);
        }
      };

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        setOpen(!isOpen());
      }, { signal });
      trigger.addEventListener('keydown', (e) => {
        if ((e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') && !isOpen()) {
          e.preventDefault();
          setOpen(true);
        }
      }, { signal });
      panel.addEventListener('keydown', handleKeyNav, { signal });
      searchInput?.addEventListener('input', () => {
        focusedIdx = 0;
        renderOptions();
      }, { signal });
      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === 'Escape') {
          handleKeyNav(e);
        }
      }, { signal });

      dropdownControllers.push({ el: wrap, isOpen, close: () => setOpen(false) });

      return {
        setOptions(opts: CustomSelectOption[]) {
          options = opts;
          if (!options.some((o) => o.value === currentValue) && options.length > 0) {
            currentValue = options[0].value;
          }
          syncTriggerDisplay();
          if (isOpen()) renderOptions();
        },
        setValue(val: string) {
          currentValue = options.some((o) => o.value === val) ? val : (options[0]?.value ?? val);
          syncTriggerDisplay();
          if (isOpen()) renderOptions();
        },
        getValue() {
          return currentValue;
        },
        isOpen,
        setOpen,
        refreshView: renderOptions,
      };
    }

    function syncSegGlider(container: HTMLElement | null, immediate = false) {
      if (!container) return;
      const glider = container.querySelector<HTMLElement>('.mm-seg-glider');
      const activeBtn = container.querySelector<HTMLElement>('.mm-seg-btn.is-active');
      if (!glider || !activeBtn || !activeBtn.offsetWidth) return;
      const w = activeBtn.offsetWidth;
      const h = glider.offsetHeight || activeBtn.offsetHeight;
      const sx = Math.max(0.05, w / 100);
      const halfR = Math.min(w, h) * 0.5;
      glider.style.setProperty('--pill-rx', `${(halfR / sx).toFixed(2)}px`);
      glider.style.setProperty('--pill-ry', `${halfR.toFixed(2)}px`);
      const nextTransform = `translate3d(${activeBtn.offsetLeft}px, 0, 0) scaleX(${sx.toFixed(4)})`;
      if (immediate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        glider.style.transition = 'none';
        glider.style.transform = nextTransform;
        requestAnimationFrame(() => {
          glider.style.transition = '';
        });
      } else {
        glider.style.transform = nextTransform;
      }
    }

    function syncAllSegGliders(immediate = false) {
      syncSegGlider(viewModeSwitch, immediate);
      syncSegGlider(layoutSwitch, immediate);
    }

    const genCategoryCSelect = createCustomSelect({
      wrapId: 'mm-gen-category-wrap',
      triggerId: 'mm-gen-category-trigger',
      panelId: 'mm-gen-category-panel',
      fallbackLabel: '默认分类',
    });

    const wbCatCSelect = createCustomSelect({
      wrapId: 'mm-wb-cat-wrap',
      triggerId: 'mm-wb-cat-trigger',
      panelId: 'mm-wb-cat-panel',
      fallbackLabel: '未分类',
      onChange: (val) => {
        if (!activeMap) return;
        activeMap.category = val || categories[0];
        scheduleWorkbenchSave(true);
      },
    });

    const wbColorCSelect = createCustomSelect({
      wrapId: 'mm-wb-color-wrap',
      triggerId: 'mm-wb-color-trigger',
      panelId: 'mm-wb-color-panel',
      fallbackLabel: '靛青',
      onChange: (val) => {
        if (!activeMap) return;
        activeMap.color = normalizeCardColor(val);
        scheduleWorkbenchSave(true);
      },
    });
    wbColorCSelect.setOptions(CARD_COLOR_OPTIONS);

    const wbPostCSelect = createCustomSelect({
      wrapId: 'mm-wb-post-wrap',
      triggerId: 'mm-wb-post-trigger',
      panelId: 'mm-wb-post-panel',
      listId: 'mm-wb-post-list',
      searchInputId: 'mm-wb-post-search',
      fallbackLabel: '无关联文章',
      onChange: (slug) => {
        if (!activeMap) return;
        const meta = slug ? postBySlug.get(slug) : undefined;
        activeMap.postSlug = slug || undefined;
        activeMap.postTitle = meta?.title || undefined;
        syncOpenPostLink();
        scheduleWorkbenchSave(true);
      },
    });

    function syncWorkbenchSelects() {
      const catOptions: CustomSelectOption[] = categories.map((c) => ({ value: c, label: c }));
      wbCatCSelect.setOptions(catOptions);
      if (activeMap?.category && categories.includes(activeMap.category)) {
        wbCatCSelect.setValue(activeMap.category);
      }

      genCategoryCSelect.setOptions(catOptions);
      const genDefault = filterCategory !== 'all' && categories.includes(filterCategory) ? filterCategory : categories[0];
      if (genDefault) genCategoryCSelect.setValue(genDefault);

      const postOptions: CustomSelectOption[] = [
        { value: '', label: '无关联文章' },
        ...postsMeta.map((p) => ({
          value: p.slug,
          label: p.title,
          badge: p.category || undefined,
        })),
      ];
      wbPostCSelect.setOptions(postOptions);
      wbPostCSelect.setValue(activeMap?.postSlug || '');
    }

    // ---------- Data Refresh & Stats ----------
    function refreshDataFromStorage() {
      mapsList = loadActiveMindMaps();
      categories = loadMindMapCategoryState().categories;
      renderSubtabs();
      syncWorkbenchSelects();
      updateStats();
      renderArticleDropdown();
    }

    function updateStats() {
      let totalNodes = 0;
      let linkedCount = 0;
      for (const m of mapsList) {
        totalNodes += countNodes(m.root).total;
        if (m.postSlug) linkedCount += 1;
      }
      document.getElementById('mm-stat-total')!.textContent = String(mapsList.length);
      document.getElementById('mm-stat-nodes')!.textContent = String(totalNodes);
      document.getElementById('mm-stat-cats')!.textContent = String(categories.length);
      document.getElementById('mm-stat-linked')!.textContent = String(linkedCount);
      updateStatsStripActive();
    }

    // ---------- Article Source Filter Dropdown ----------
    function toggleArticlePopover(forceOpen?: boolean) {
      const isOpen = articleTrigger.getAttribute('aria-expanded') === 'true';
      const next = forceOpen !== undefined ? forceOpen : !isOpen;
      articleTrigger.setAttribute('aria-expanded', String(next));
      articlePanel.setAttribute('aria-hidden', String(!next));
      if (next) {
        articlePanel.removeAttribute('inert');
        articlePanel.classList.remove('is-closed');
        articlePanel.classList.add('is-open');
        requestAnimationFrame(() => articleFilterInput.focus());
      } else {
        articlePanel.setAttribute('inert', '');
        articlePanel.classList.remove('is-open');
        articlePanel.classList.add('is-closed');
      }
    }

    function renderArticleDropdown() {
      const counts = new Map<string, { slug: string; title: string; count: number }>();
      let standaloneCount = 0;
      for (const m of mapsList) {
        const s = normalizePostSlug(m.postSlug);
        if (!s) {
          standaloneCount += 1;
          continue;
        }
        const meta = postBySlug.get(s);
        const cur = counts.get(s) || { slug: s, title: m.postTitle || meta?.title || s, count: 0 };
        cur.count += 1;
        counts.set(s, cur);
      }

      if (filterPostSlug === 'all') {
        articleTriggerLabel.textContent = `关联文章: 全部来源 (${mapsList.length})`;
        articleQuickClear.classList.add('hidden');
      } else if (filterPostSlug === '__standalone__') {
        articleTriggerLabel.textContent = `关联文章: 独立导图 (${standaloneCount})`;
        articleQuickClear.classList.remove('hidden');
      } else {
        const found = counts.get(filterPostSlug);
        articleTriggerLabel.textContent = `关联: ${found?.title || filterPostSlug}`;
        articleQuickClear.classList.remove('hidden');
      }

      const q = articleFilterInput.value.trim().toLowerCase();
      const rows: Array<{ slug: string; label: string; count: number }> = [
        { slug: 'all', label: '全部来源', count: mapsList.length },
      ];
      if (standaloneCount > 0) {
        rows.push({ slug: '__standalone__', label: '无关联文章（自由导图）', count: standaloneCount });
      }
      for (const item of counts.values()) {
        rows.push({ slug: item.slug, label: item.title, count: item.count });
      }

      const matched = q ? rows.filter((r) => r.label.toLowerCase().includes(q)) : rows;
      articleFilterList.innerHTML = matched.length === 0
        ? `<div class="py-3 text-center text-[var(--muted)]">未匹配到文章</div>`
        : matched
            .map(
              (r) => `
              <button type="button" data-mm-art="${escapeHtml(r.slug)}" class="mm-article-item-row w-full flex items-center justify-between gap-2 px-2.5 py-1.5 text-left ${
                filterPostSlug === r.slug ? 'active' : ''
              }">
                <span class="truncate">${escapeHtml(r.label)}</span>
                <span class="text-[0.68rem] opacity-70 shrink-0">${r.count}</span>
              </button>`
            )
            .join('');

      articleFilterList.querySelectorAll<HTMLButtonElement>('[data-mm-art]').forEach((btn) => {
        btn.addEventListener('click', () => {
          filterPostSlug = btn.dataset.mmArt || 'all';
          toggleArticlePopover(false);
          renderArticleDropdown();
          renderCards(true);
        });
      });
    }

    articleTrigger.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#mm-article-quick-clear')) return;
      e.stopPropagation();
      toggleArticlePopover();
    }, { signal });
    articleQuickClear.addEventListener('click', (e) => {
      e.stopPropagation();
      filterPostSlug = 'all';
      renderArticleDropdown();
      renderCards(true);
    }, { signal });
    articleFilterInput.addEventListener('input', () => renderArticleDropdown(), { signal });
    document.addEventListener('click', (e) => {
      if (!articlePanel.classList.contains('is-open')) return;
      if (!document.getElementById('mm-article-popover-container')?.contains(e.target as Node)) {
        toggleArticlePopover(false);
      }
    }, { signal });

    // Color filter buttons
    function syncColorButtons() {
      document.querySelectorAll<HTMLElement>('[data-mm-color]').forEach((btn) => {
        const active = btn.dataset.mmColor === filterColor;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    }
    document.querySelectorAll<HTMLElement>('[data-mm-color]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.mmColor || 'all';
        filterColor = filterColor === next && next !== 'all' ? 'all' : next;
        syncColorButtons();
        renderCards(true);
      }, { signal });
    });

    // Search
    let searchDebounce: number | null = null;
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      searchClearBtn.classList.toggle('hidden', !searchQuery);
      if (searchDebounce) window.clearTimeout(searchDebounce);
      searchDebounce = window.setTimeout(() => renderCards(true), 120);
    }, { signal });
    searchClearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      searchClearBtn.classList.add('hidden');
      renderCards(true);
    }, { signal });

    // ---------- Filtering & Masonry Cards Rendering ----------
    function nodeTreeContains(node: MindMapNode, q: string): boolean {
      if (node.text.toLowerCase().includes(q) || (node.note && node.note.toLowerCase().includes(q))) {
        return true;
      }
      return (node.children || []).some((c) => nodeTreeContains(c, q));
    }

    function getFilteredMaps(): MindMapRecord[] {
      return mapsList.filter((m) => {
        if (filterCategory !== 'all' && m.category !== filterCategory) return false;
        if (filterColor !== 'all' && (m.color || 'blue') !== filterColor) return false;
        if (filterLinkedOnly && !m.postSlug) return false;
        if (filterPostSlug === '__standalone__' && m.postSlug) return false;
        if (filterPostSlug !== 'all' && filterPostSlug !== '__standalone__' && m.postSlug !== filterPostSlug) {
          return false;
        }
        if (searchQuery) {
          const hitMeta =
            m.title.toLowerCase().includes(searchQuery) ||
            m.category.toLowerCase().includes(searchQuery) ||
            (m.postTitle || '').toLowerCase().includes(searchQuery) ||
            (m.tags || []).some((t) => t.toLowerCase().includes(searchQuery));
          if (!hitMeta && !nodeTreeContains(m.root, searchQuery)) return false;
        }
        return true;
      });
    }

    function getColumnCount(): number {
      const w = window.innerWidth;
      if (w >= 1180) return 3;
      if (w >= 680) return 2;
      return 1;
    }

    function createCardElement(record: MindMapRecord, isInitialEnter: boolean): HTMLElement {
      const card = document.createElement('article');
      card.id = `mm-card-${record.id}`;
      card.className = 'notes-card mm-card';
      card.tabIndex = 0;
      card.setAttribute('role', 'button');
      card.setAttribute('aria-label', `打开思维导图 ${record.title}`);
      card.style.setProperty('--note-accent', colorHex(record.color));
      if (isInitialEnter) {
        card.setAttribute('data-enter', 'card');
      }

      const { total } = countNodes(record.root);
      const topoSvg = buildTopologyPreviewSvg(record.root, record.layout);
      const postMeta = record.postSlug ? postBySlug.get(record.postSlug) : undefined;
      const postDisplay = record.postTitle || postMeta?.title || '';

      card.innerHTML = `
        <div class="mm-card-head">
          <span class="mm-card-badge" title="${escapeHtml(record.category)}">
            <span class="mm-card-dot"></span>
            <span class="truncate">${escapeHtml(record.category)}</span>
          </span>
          <div class="mm-card-actions">
            <button type="button" class="mm-card-action-btn" data-card-edit="${escapeHtml(record.id)}" title="在画布工作台打开" aria-label="打开导图">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            </button>
            <button type="button" class="mm-card-action-btn is-del" data-card-del="${escapeHtml(record.id)}" title="删除导图" aria-label="删除导图">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path></svg>
            </button>
          </div>
        </div>
        <h3 class="mm-card-title">${escapeHtml(record.title)}</h3>
        <div class="mm-card-topo-wrap">
          ${topoSvg}
          <span class="mm-card-layout-tag">${layoutLabel(record.layout)}</span>
        </div>
        ${
          postDisplay || record.tags.length > 0
            ? `<div class="mm-card-tags">
                ${postDisplay ? `<a href="/posts/${escapeHtml(record.postSlug)}/" class="mm-card-post-link" title="打开关联文章">§ ${escapeHtml(postDisplay)}</a>` : ''}
                ${record.tags.map((t) => `<span class="mm-card-tag"># ${escapeHtml(t)}</span>`).join('')}
              </div>`
            : ''
        }
        <div class="mm-card-foot">
          <span>${total} 个节点 · ${record.root.children.length} 主支</span>
          <span>${formatRelativeTime(record.updatedAt)}</span>
        </div>
      `;

      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('.mm-card-post-link')) return;
        const delBtn = target.closest<HTMLElement>('[data-card-del]');
        if (delBtn) {
          e.stopPropagation();
          void handleDeleteCard(record, card);
          return;
        }
        openWorkbench(record.id);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          if ((e.target as HTMLElement).closest('button, a')) return;
          e.preventDefault();
          openWorkbench(record.id);
        }
      });

      return card;
    }

    async function handleDeleteCard(record: MindMapRecord, cardEl?: HTMLElement | null) {
      const ok = await askConfirm(
        `确认删除导图「${record.title}」？`,
        '删除后将移除该导图的所有节点与备注，并在同步后从云端清除。'
      );
      if (!ok) return;
      isSelfDeleting = true;
      deleteMindMap(record.id);
      if (cardEl) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduceMotion) cardEl.classList.add('is-deleting');
        window.setTimeout(() => {
          isSelfDeleting = false;
          refreshDataFromStorage();
          renderCards(false);
        }, reduceMotion ? 0 : 380);
      } else {
        isSelfDeleting = false;
        refreshDataFromStorage();
        renderCards(false);
      }
      showToast('已删除思维导图');
    }

    function renderCards(animateTransition = false, isInitialEnter = false) {
      if (cardFilterTimeline) {
        cardFilterTimeline.kill();
        cardFilterTimeline = null;
      }
      const filtered = getFilteredMaps();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const existingCards = Array.from(container.querySelectorAll<HTMLElement>('.mm-card'));
      existingCards.forEach((c) => {
        clearCardMotion(c);
        c.classList.remove('is-reflowing', 'is-entering');
      });

      const hasFilters =
        filterCategory !== 'all' ||
        filterColor !== 'all' ||
        filterPostSlug !== 'all' ||
        filterLinkedOnly ||
        Boolean(searchQuery);

      if (filtered.length === 0) {
        const wasHidden = emptyState.classList.contains('hidden');
        container.classList.add('is-empty');
        container.innerHTML = '';
        emptyState.classList.remove('hidden');
        if (mapsList.length === 0) {
          emptyTitle.textContent = '尚未创建思维导图';
          emptyDesc.textContent = '可以从空白画布开启自由发散，或直接从博客文章的大纲与划线笔记中一键生成导图。';
          emptyResetBtn.classList.add('hidden');
        } else if (hasFilters) {
          emptyTitle.textContent = '未找到匹配的思维导图';
          emptyDesc.textContent = '当前分类、色标或检索条件没有命中任何导图。';
          emptyResetBtn.classList.remove('hidden');
        }
        if (wasHidden && !reduceMotion) {
          cardFilterTimeline = animateCardEnter(emptyState, {
            replay: true,
            onComplete: () => {
              clearCardMotion(emptyState);
              cardFilterTimeline = null;
            },
          });
        }
        return;
      }

      const mountFilteredCards = (initial: boolean): HTMLElement[] => {
        emptyState.classList.add('hidden');
        container.classList.remove('is-empty');
        const cols = getColumnCount();
        container.innerHTML = '';
        const colEls: HTMLElement[] = [];
        for (let i = 0; i < cols; i += 1) {
          const col = document.createElement('div');
          col.className = 'masonry-col';
          container.appendChild(col);
          colEls.push(col);
        }
        const mounted: HTMLElement[] = [];
        filtered.forEach((rec, idx) => {
          const card = createCardElement(rec, initial);
          colEls[idx % cols].appendChild(card);
          mounted.push(card);
        });
        return mounted;
      };

      if (animateTransition && !reduceMotion) {
        if (existingCards.length > 0) {
          existingCards.forEach((c) => {
            c.classList.add('is-reflowing');
            c.classList.remove('is-entered', 'is-entering');
          });
          const tl = gsap.timeline();
          cardFilterTimeline = tl;
          addCardExit(tl, existingCards, 0);
          const switchAt = cardExitDuration(existingCards.length);
          tl.add(() => {
            const mountedCards = mountFilteredCards(false);
            mountedCards.forEach((c) => c.classList.add('is-reflowing'));
            cardFilterTimeline = animateCardEnter(mountedCards, {
              onComplete: () => {
                mountedCards.forEach((card) => {
                  clearCardMotion(card);
                  card.classList.remove('is-reflowing', 'is-entering');
                  card.classList.add('is-entered');
                });
                (window as any).__initTiltCards?.();
                cardFilterTimeline = null;
              },
            });
          }, switchAt);
          return;
        }

        const mountedCards = mountFilteredCards(false);
        mountedCards.forEach((c) => c.classList.add('is-reflowing'));
        cardFilterTimeline = animateCardEnter(mountedCards, {
          onComplete: () => {
            mountedCards.forEach((card) => {
              clearCardMotion(card);
              card.classList.remove('is-reflowing', 'is-entering');
              card.classList.add('is-entered');
            });
            (window as any).__initTiltCards?.();
            cardFilterTimeline = null;
          },
        });
        return;
      }

      mountFilteredCards(isInitialEnter);
      (window as any).__initTiltCards?.();
    }

    document.getElementById('mm-empty-reset-btn')?.addEventListener('click', () => {
      filterCategory = 'all';
      filterColor = 'all';
      filterPostSlug = 'all';
      filterLinkedOnly = false;
      searchInput.value = '';
      searchQuery = '';
      searchClearBtn.classList.add('hidden');
      renderSubtabs();
      syncColorButtons();
      renderArticleDropdown();
      updateStatsStripActive();
      renderCards(true);
    }, { signal });

    // ---------- Category Manager Modal ----------
    function renderCategoryManagerList() {
      const catCounts = new Map<string, number>();
      for (const m of mapsList) {
        catCounts.set(m.category, (catCounts.get(m.category) || 0) + 1);
      }

      catListEl.innerHTML = '';
      categories.forEach((cat, idx) => {
        const count = catCounts.get(cat) || 0;
        const row = document.createElement('div');
        row.className = 'flex items-center gap-2 p-2.5 rounded-xl border border-[var(--rule)] bg-[var(--bg-soft)]';
        row.innerHTML = `
          <input type="text" value="${escapeHtml(cat)}" maxlength="32" aria-label="编辑分类名称" class="mm-cat-row-input flex-1 min-w-0 bg-[var(--bg-elev)] border border-[var(--rule)] rounded-lg px-2.5 py-1 text-xs font-medium text-[var(--text-strong)] focus:outline-none focus:border-[var(--ink-strong)]" />
          <span class="text-[0.68rem] text-[var(--muted)] shrink-0 px-1">${count} 张</span>
          <button type="button" data-cat-move="-1" ${idx === 0 ? 'disabled' : ''} class="w-6 h-6 rounded border border-[var(--rule)] bg-[var(--bg-elev)] text-xs text-[var(--muted-strong)] hover:text-[var(--text-strong)] disabled:opacity-30 cursor-pointer" title="上移">↑</button>
          <button type="button" data-cat-move="1" ${idx === categories.length - 1 ? 'disabled' : ''} class="w-6 h-6 rounded border border-[var(--rule)] bg-[var(--bg-elev)] text-xs text-[var(--muted-strong)] hover:text-[var(--text-strong)] disabled:opacity-30 cursor-pointer" title="下移">↓</button>
          <button type="button" data-cat-del ${categories.length <= 1 ? 'disabled' : ''} class="w-6 h-6 rounded border border-[var(--rule)] bg-[var(--bg-elev)] text-xs text-red-500 hover:bg-red-500/10 disabled:opacity-30 cursor-pointer" title="${categories.length <= 1 ? '至少保留一个分类' : '删除分类（导图将自动迁移至首个分类）'}">✕</button>
        `;

        const input = row.querySelector<HTMLInputElement>('.mm-cat-row-input')!;
        const commitRename = () => {
          const nextName = input.value.trim();
          if (!nextName || nextName === cat) {
            input.value = cat;
            return;
          }
          if (categories.includes(nextName)) {
            showToast('分类名称已存在');
            input.value = cat;
            return;
          }
          renameMindMapCategory(cat, nextName);
          if (filterCategory === cat) filterCategory = nextName;
          refreshDataFromStorage();
          renderCards(false);
          renderCategoryManagerList();
          showToast(`已重命名为「${nextName}」`);
        };
        input.addEventListener('blur', commitRename);
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            input.blur();
          }
        });

        row.querySelectorAll<HTMLButtonElement>('[data-cat-move]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const dir = Number(btn.dataset.catMove);
            const next = [...categories];
            const swapIdx = idx + dir;
            if (swapIdx < 0 || swapIdx >= next.length) return;
            [next[idx], next[swapIdx]] = [next[swapIdx], next[idx]];
            reorderMindMapCategories(next);
            refreshDataFromStorage();
            renderCategoryManagerList();
          });
        });

        row.querySelector('[data-cat-del]')?.addEventListener('click', () => {
          if (categories.length <= 1) return;
          deleteMindMapCategory(cat);
          if (filterCategory === cat) filterCategory = 'all';
          refreshDataFromStorage();
          renderCards(false);
          renderCategoryManagerList();
          showToast(`已删除分类「${cat}」`);
        });

        catListEl.appendChild(row);
      });
    }

    function openCategoryManager() {
      refreshDataFromStorage();
      renderCategoryManagerList();
      openOverlay(catModal, catNewInput);
    }

    document.getElementById('mm-cat-manager-btn')?.addEventListener('click', openCategoryManager, { signal });
    document.getElementById('mm-cat-close-btn')?.addEventListener('click', () => closeOverlay(catModal), { signal });
    document.getElementById('mm-cat-add-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = catNewInput.value.trim();
      if (!name) return;
      if (categories.includes(name)) {
        showToast('该分类已存在');
        return;
      }
      addMindMapCategory(name);
      catNewInput.value = '';
      refreshDataFromStorage();
      renderCategoryManagerList();
      showToast(`已新增分类「${name}」`);
    }, { signal });

    // ---------- Generate From Blog Post Modal ----------
    function renderPostGenList() {
      const q = genSearch.value.trim().toLowerCase();
      const allSiteNotes = getAllNotesAcrossSite();
      const notesByPost = new Map<string, typeof allSiteNotes>();
      for (const n of allSiteNotes) {
        const s = normalizePostSlug(n.postSlug);
        if (!s) continue;
        const arr = notesByPost.get(s) || [];
        arr.push(n);
        notesByPost.set(s, arr);
      }

      const filtered = q
        ? postsMeta.filter(
            (p) =>
              p.title.toLowerCase().includes(q) ||
              (p.category || '').toLowerCase().includes(q)
          )
        : postsMeta;

      genPostList.innerHTML = filtered.length === 0
        ? `<div class="py-8 text-center text-xs text-[var(--muted)]">未匹配到符合条件的文章</div>`
        : filtered
            .map((p) => {
              const postNotes = notesByPost.get(p.slug) || [];
              return `
                <button type="button" data-gen-slug="${escapeHtml(p.slug)}" class="w-full text-left p-3 rounded-xl border border-[var(--rule)] bg-[var(--bg-soft)] hover:bg-[var(--bg-elev)] hover:border-[var(--ink-strong)] transition flex items-center justify-between gap-3 cursor-pointer">
                  <div class="min-w-0">
                    <div class="text-xs font-semibold text-[var(--text-strong)] truncate">${escapeHtml(p.title)}</div>
                    <div class="text-[0.7rem] text-[var(--muted)] mt-0.5 flex items-center gap-2">
                      ${p.category ? `<span>${escapeHtml(p.category)}</span><span>·</span>` : ''}
                      <span>${p.headings.length} 个小节标题</span>
                      ${postNotes.length > 0 ? `<span class="text-amber-600 dark:text-amber-400 font-medium">· 含 ${postNotes.length} 条划线/墨问笔记</span>` : ''}
                    </div>
                  </div>
                  <span class="px-2.5 py-1 rounded-full text-[0.7rem] font-semibold bg-[var(--ink-strong)] text-[var(--bg-base)] shrink-0">生成导图</span>
                </button>
              `;
            })
            .join('');

      genPostList.querySelectorAll<HTMLButtonElement>('[data-gen-slug]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const slug = btn.dataset.genSlug || '';
          const meta = postBySlug.get(slug);
          if (!meta) return;
          const postNotes = (notesByPost.get(slug) || []).map((n) => ({
            kind: n.kind,
            text: n.text,
            comment: n.comment,
            headingText: n.headingText,
            question: n.question,
            color: n.color,
          }));
          const created = buildMindMapFromArticle(
            {
              slug: meta.slug,
              title: meta.title,
              headings: meta.headings,
              notes: postNotes,
            },
            {
              category: genCategoryCSelect.getValue() || categories[0],
              includeNotes: genIncludeNotes.checked,
            }
          );
          const saved = upsertMindMap(created, true);
          refreshDataFromStorage();
          renderCards(false);
          closeOverlay(genModal, () => {
            openWorkbench(saved.id, true);
            showToast(`已从《${meta.title}》生成思维导图`);
          });
        });
      });
    }

    function openPostGenerator() {
      refreshDataFromStorage();
      genSearch.value = '';
      renderPostGenList();
      openOverlay(genModal, genSearch);
    }

    document.getElementById('mm-from-post-btn')?.addEventListener('click', openPostGenerator, { signal });
    document.getElementById('mm-empty-article-btn')?.addEventListener('click', openPostGenerator, { signal });
    document.getElementById('mm-gen-close-btn')?.addEventListener('click', () => closeOverlay(genModal), { signal });
    genSearch.addEventListener('input', () => renderPostGenList(), { signal });

    // ---------- New MindMap Trigger ----------
    function createAndOpenNewMap() {
      const targetCat = filterCategory !== 'all' ? filterCategory : categories[0];
      const blank = createBlankMindMap(targetCat, '新建思维导图');
      const saved = upsertMindMap(blank, true);
      refreshDataFromStorage();
      renderCards(false);
      openWorkbench(saved.id, true);
    }
    document.getElementById('mm-new-btn')?.addEventListener('click', createAndOpenNewMap, { signal });
    document.getElementById('mm-empty-create-btn')?.addEventListener('click', createAndOpenNewMap, { signal });

    // =========================================================================
    // Layer 2: Visual Canvas + Bidirectional Outline + Smooth Drag Workbench
    // =========================================================================

    installMarkdownShortcutsSafe();
    function installMarkdownShortcutsSafe() {
      outlineToolbarHost.innerHTML = '';
      const toolbar = createMarkdownToolbar(outlineTextarea);
      outlineToolbarHost.appendChild(toolbar);
      outlineTextarea.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          e.preventDefault();
          const start = outlineTextarea.selectionStart;
          const end = outlineTextarea.selectionEnd;
          outlineTextarea.setRangeText('  ', start, end, 'end');
          outlineTextarea.dispatchEvent(new Event('input', { bubbles: true }));
          return;
        }
        handleMarkdownKeydown(e, outlineTextarea);
      }, { signal });
    }

    function markSaveState(dirty: boolean) {
      wbSaveState.textContent = dirty ? '编辑中（自动保存）…' : '本地已保存';
      wbSaveState.classList.toggle('is-dirty', dirty);
    }

    function scheduleWorkbenchSave(immediate = false) {
      if (!activeMap) return;
      markSaveState(true);
      if (autosaveTimer) window.clearTimeout(autosaveTimer);
      const runSave = () => {
        if (!activeMap) return;
        const saved = upsertMindMap(activeMap, true);
        activeMap = saved;
        markSaveState(false);
        mapsList = loadActiveMindMaps();
        updateStats();
        renderCards(false);
      };
      if (immediate) runSave();
      else autosaveTimer = window.setTimeout(runSave, 260);
    }

    function pushUndoSnapshot() {
      if (!activeMap) return;
      undoStack.push(cloneNode(activeMap.root));
      if (undoStack.length > 60) undoStack.shift();
      redoStack = [];
      wbUndoBtn.disabled = undoStack.length === 0;
      wbRedoBtn.disabled = true;
    }

    function captureNodeRects(): Map<string, NodeBox> {
      const snap = new Map<string, NodeBox>();
      for (const [id, b] of laidOutBoxes.entries()) {
        snap.set(id, { ...b });
      }
      return snap;
    }

    function performUndo() {
      if (!activeMap || undoStack.length === 0) return;
      const prevRects = captureNodeRects();
      redoStack.push(cloneNode(activeMap.root));
      activeMap.root = undoStack.pop()!;
      const surviving = [...selectedNodeIds].filter((id) => findNodeById(activeMap!.root, id));
      setSelection(surviving.length ? surviving : [activeMap.root.id], undefined, false);
      wbUndoBtn.disabled = undoStack.length === 0;
      wbRedoBtn.disabled = false;
      renderCanvasAndOutline(false, prevRects, { anchorNodeId: activeMap.root.id, animateLinks: true });
      scheduleWorkbenchSave();
      showToast('已撤销上一步');
    }

    function performRedo() {
      if (!activeMap || redoStack.length === 0) return;
      const prevRects = captureNodeRects();
      undoStack.push(cloneNode(activeMap.root));
      activeMap.root = redoStack.pop()!;
      const surviving = [...selectedNodeIds].filter((id) => findNodeById(activeMap!.root, id));
      setSelection(surviving.length ? surviving : [activeMap.root.id], undefined, false);
      wbUndoBtn.disabled = false;
      wbRedoBtn.disabled = redoStack.length === 0;
      renderCanvasAndOutline(false, prevRects, { anchorNodeId: activeMap.root.id, animateLinks: true });
      scheduleWorkbenchSave();
      showToast('已重做');
    }

    wbUndoBtn.addEventListener('click', performUndo, { signal });
    wbRedoBtn.addEventListener('click', performRedo, { signal });

    // ---------- Single-rAF Viewport Physics Engine & Cached Geometry ----------
    let cachedVpRect: DOMRect = canvasViewport.getBoundingClientRect();
    let cachedPaneRect: DOMRect = canvasPane.getBoundingClientRect();
    let lastDisplayedZoomPct = -1;

    function refreshViewportMetrics() {
      if (wbModal.classList.contains('hidden')) return;
      cachedVpRect = canvasViewport.getBoundingClientRect();
      cachedPaneRect = canvasPane.getBoundingClientRect();
    }

    const vpResizeObserver = typeof ResizeObserver !== 'undefined'
      ? new ResizeObserver(() => {
          refreshViewportMetrics();
          syncMinimapViewport();
        })
      : null;
    if (vpResizeObserver) {
      vpResizeObserver.observe(canvasViewport);
      vpResizeObserver.observe(canvasPane);
      signal.addEventListener('abort', () => vpResizeObserver.disconnect(), { once: true });
    }

    // Minimap projection state & zero-reflow viewport indicator
    const MINIMAP_W = 156;
    const MINIMAP_H = 96;
    const MINIMAP_PAD = 8;
    let minimapScale = 0.1;
    let minimapOffX = MINIMAP_PAD;
    let minimapOffY = MINIMAP_PAD;
    let lastMinimapVpW = -1;
    let lastMinimapVpH = -1;

    function syncMinimapViewport() {
      if (!activeMap || viewMode === 'outline') return;
      const vpW = cachedVpRect.width || 800;
      const vpH = cachedVpRect.height || 520;
      const visLeft = (-panX / zoom) * minimapScale + minimapOffX;
      const visTop = (-panY / zoom) * minimapScale + minimapOffY;
      const visW = (vpW / zoom) * minimapScale;
      const visH = (vpH / zoom) * minimapScale;

      const clampedX = Math.max(2, Math.min(MINIMAP_W - 14, visLeft));
      const clampedY = Math.max(2, Math.min(MINIMAP_H - 12, visTop));
      const clampedW = Math.max(12, Math.min(MINIMAP_W - clampedX - 2, visW));
      const clampedH = Math.max(10, Math.min(MINIMAP_H - clampedY - 2, visH));

      if (Math.abs(clampedW - lastMinimapVpW) > 0.35) {
        lastMinimapVpW = clampedW;
        minimapVpEl.style.width = `${clampedW.toFixed(1)}px`;
      }
      if (Math.abs(clampedH - lastMinimapVpH) > 0.35) {
        lastMinimapVpH = clampedH;
        minimapVpEl.style.height = `${clampedH.toFixed(1)}px`;
      }
      minimapVpEl.style.transform = `translate3d(${clampedX.toFixed(1)}px, ${clampedY.toFixed(1)}px, 0)`;
    }

    function renderMinimapTopology() {
      if (!activeMap || laidOutBoxes.size === 0) {
        minimapSvg.innerHTML = '';
        return;
      }
      const usableW = MINIMAP_W - MINIMAP_PAD * 2;
      const usableH = MINIMAP_H - MINIMAP_PAD * 2;
      minimapScale = Math.min(usableW / Math.max(1, stageW), usableH / Math.max(1, stageH));
      minimapOffX = (MINIMAP_W - stageW * minimapScale) / 2;
      minimapOffY = (MINIMAP_H - stageH * minimapScale) / 2;

      const parts: string[] = [];
      for (const box of laidOutBoxes.values()) {
        if (!box.parentId) continue;
        const pBox = laidOutBoxes.get(box.parentId);
        if (!pBox) continue;
        const mp = {
          x: pBox.x * minimapScale + minimapOffX,
          y: pBox.y * minimapScale + minimapOffY,
          w: pBox.w * minimapScale,
          h: pBox.h * minimapScale,
          side: pBox.side,
        };
        const mc = {
          x: box.x * minimapScale + minimapOffX,
          y: box.y * minimapScale + minimapOffY,
          w: box.w * minimapScale,
          h: box.h * minimapScale,
          side: box.side,
        };
        parts.push(
          `<path d="${buildInkBranchPath(mp, mc)}" fill="none" stroke="${box.color}" stroke-opacity="0.58" stroke-width="${box.depth === 1 ? '1.15' : '0.85'}" stroke-linecap="round"/>`
        );
      }
      for (const box of laidOutBoxes.values()) {
        const rx = (box.x * minimapScale + minimapOffX).toFixed(1);
        const ry = (box.y * minimapScale + minimapOffY).toFixed(1);
        const rw = Math.max(3, box.w * minimapScale).toFixed(1);
        const rh = Math.max(2.2, box.h * minimapScale).toFixed(1);
        const fill = box.depth === 0 ? 'var(--ink-strong)' : box.color;
        const op = box.depth === 0 ? '0.92' : '0.68';
        parts.push(`<rect x="${rx}" y="${ry}" width="${rw}" height="${rh}" rx="1.5" fill="${fill}" fill-opacity="${op}"/>`);
      }
      minimapSvg.innerHTML = parts.join('');
      syncMinimapViewport();
    }

    // Unified rAF state for pan dragging, momentum inertia, and damped focal wheel zoom
    let pendingPointerPan: { x: number; y: number } | null = null;
    let panVelX = 0;
    let panVelY = 0;
    let lastPanSampleX = 0;
    let lastPanSampleY = 0;
    let lastPanSampleTime = 0;
    let isInertiaActive = false;
    let isWheelDamping = false;
    let wheelTargetZoom = 1;
    let wheelAnchorX = 0;
    let wheelAnchorY = 0;
    let lastViewportTickTime = 0;

    function syncZoomLabelOnly() {
      const pct = Math.round(zoom * 100);
      if (pct !== lastDisplayedZoomPct) {
        lastDisplayedZoomPct = pct;
        zoomLabel.textContent = `${pct}%`;
      }
    }

    function commitGpuViewportFrame() {
      const relScale = stageRasterZoom > 0 ? zoom / stageRasterZoom : 1;
      if (Math.abs(relScale - 1) > 0.0006) {
        canvasPan.style.transform = `translate3d(${panX.toFixed(2)}px, ${panY.toFixed(2)}px, 0) scale(${relScale.toFixed(5)})`;
      } else {
        canvasPan.style.transform = `translate3d(${panX.toFixed(1)}px, ${panY.toFixed(1)}px, 0)`;
      }
      syncZoomLabelOnly();
      syncMinimapViewport();
    }

    function settleStageRasterZoom() {
      if (wheelSettleTimer) {
        window.clearTimeout(wheelSettleTimer);
        wheelSettleTimer = null;
      }
      stageRasterZoom = zoom;
      (canvasStage.style as CSSStyleDeclaration & { zoom: string }).zoom = zoom.toFixed(4);
      canvasPan.style.transform = `translate3d(${panX.toFixed(1)}px, ${panY.toFixed(1)}px, 0)`;
      if (!isInertiaActive && !pendingPointerPan && !isWheelDamping) {
        canvasPan.style.willChange = '';
      }
      syncZoomLabelOnly();
      syncMinimapViewport();
    }

    function tickViewportPhysics(now: number) {
      viewportRafId = null;
      const dt = lastViewportTickTime > 0 ? Math.min(0.05, Math.max(0.001, (now - lastViewportTickTime) / 1000)) : 1 / 60;
      lastViewportTickTime = now;

      if (pendingPointerPan) {
        panX = pendingPointerPan.x;
        panY = pendingPointerPan.y;
        pendingPointerPan = null;
      } else if (isInertiaActive) {
        panX += panVelX * dt;
        panY += panVelY * dt;
        const decay = Math.exp(-5.6 * dt);
        panVelX *= decay;
        panVelY *= decay;
        if (Math.hypot(panVelX, panVelY) < 12) {
          isInertiaActive = false;
          panVelX = 0;
          panVelY = 0;
        }
      }

      if (isWheelDamping) {
        const alpha = 1 - Math.exp(-20 * dt);
        const prevZoom = zoom;
        const diff = wheelTargetZoom - prevZoom;
        if (Math.abs(diff) < 0.0012) {
          zoom = wheelTargetZoom;
          isWheelDamping = false;
        } else {
          zoom = prevZoom + diff * alpha;
        }
        panX = wheelAnchorX - ((wheelAnchorX - panX) / prevZoom) * zoom;
        panY = wheelAnchorY - ((wheelAnchorY - panY) / prevZoom) * zoom;

        if (!isWheelDamping) {
          if (wheelSettleTimer) window.clearTimeout(wheelSettleTimer);
          wheelSettleTimer = window.setTimeout(() => {
            wheelSettleTimer = null;
            if (!isWheelDamping) settleStageRasterZoom();
          }, 70);
        }
      }

      commitGpuViewportFrame();

      if (pendingPointerPan || isInertiaActive || isWheelDamping) {
        viewportRafId = requestAnimationFrame(tickViewportPhysics);
      } else {
        lastViewportTickTime = 0;
        if (!wheelSettleTimer) canvasPan.style.willChange = '';
      }
    }

    function requestViewportFrame() {
      if (viewportRafId !== null) return;
      canvasPan.style.willChange = 'transform';
      viewportRafId = requestAnimationFrame(tickViewportPhysics);
    }

    function stopPanAnimation() {
      if (panAnimCleanupTimer) {
        window.clearTimeout(panAnimCleanupTimer);
        panAnimCleanupTimer = null;
      }
      if (viewportRafId !== null) {
        cancelAnimationFrame(viewportRafId);
        viewportRafId = null;
      }
      if (wheelSettleTimer) {
        window.clearTimeout(wheelSettleTimer);
        wheelSettleTimer = null;
      }
      pendingPointerPan = null;
      isInertiaActive = false;
      panVelX = 0;
      panVelY = 0;
      if (isWheelDamping || Math.abs(stageRasterZoom - zoom) > 0.0006) {
        isWheelDamping = false;
        stageRasterZoom = zoom;
        (canvasStage.style as CSSStyleDeclaration & { zoom: string }).zoom = zoom.toFixed(4);
      }
      lastViewportTickTime = 0;
      canvasPan.style.transition = '';
      canvasPan.style.willChange = '';
    }

    function applyViewportTransform() {
      stopPanAnimation();
      stageRasterZoom = zoom;
      wheelTargetZoom = zoom;
      canvasPan.style.transform = `translate3d(${panX.toFixed(1)}px, ${panY.toFixed(1)}px, 0)`;
      (canvasStage.style as CSSStyleDeclaration & { zoom: string }).zoom = zoom.toFixed(4);
      syncZoomLabelOnly();
      syncMinimapViewport();
    }

    // 仅使用单次 CSS zoom 重绘 + GPU compositor 缩放平移，彻底消除逐帧 zoom 重排卡顿
    function animateViewportTo(targetPanX: number, targetPanY: number, targetZoom = zoom, animate = true) {
      stopPanAnimation();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const zoomDelta = Math.abs(targetZoom - zoom);
      const panDelta = Math.hypot(targetPanX - panX, targetPanY - panY);
      if (!animate || reduceMotion || (zoomDelta < 0.002 && panDelta < 2)) {
        panX = targetPanX;
        panY = targetPanY;
        zoom = targetZoom;
        applyViewportTransform();
        return;
      }
      const oldPanX = panX;
      const oldPanY = panY;
      const oldZoom = zoom;
      panX = targetPanX;
      panY = targetPanY;
      zoom = targetZoom;
      stageRasterZoom = zoom;
      wheelTargetZoom = zoom;

      (canvasStage.style as CSSStyleDeclaration & { zoom: string }).zoom = zoom.toFixed(4);
      syncZoomLabelOnly();
      syncMinimapViewport();

      const relScale = oldZoom / zoom;
      canvasPan.style.willChange = 'transform';
      canvasPan.style.transition = 'none';
      canvasPan.style.transform = `translate3d(${oldPanX.toFixed(1)}px, ${oldPanY.toFixed(1)}px, 0) scale(${relScale.toFixed(4)})`;
      void canvasPan.offsetWidth;
      canvasPan.style.transition = 'transform 280ms cubic-bezier(0.22, 1, 0.36, 1)';
      canvasPan.style.transform = `translate3d(${panX.toFixed(1)}px, ${panY.toFixed(1)}px, 0) scale(1)`;
      panAnimCleanupTimer = window.setTimeout(() => {
        panAnimCleanupTimer = null;
        canvasPan.style.transition = '';
        canvasPan.style.transform = `translate3d(${panX.toFixed(1)}px, ${panY.toFixed(1)}px, 0)`;
        canvasPan.style.willChange = '';
      }, 290);
    }

    function fallbackMeasureSize(textLen: number): { w: number; h: number } {
      const estW = Math.min(270, Math.max(84, textLen * 13 + 32));
      const lines = Math.max(1, Math.ceil((textLen * 13 + 32) / 242));
      return { w: estW, h: Math.max(36, 16 + lines * 20) };
    }

    function measureSingleNodeDim(text: string, isRoot: boolean, hasNote: boolean): { w: number; h: number } {
      const cacheKey = `${isRoot ? 'R' : 'N'}|${hasNote ? 1 : 0}|${text}`;
      const hit = measureCache.get(cacheKey);
      if (hit) return hit;

      const el = document.createElement('div');
      el.className = `mm-node${isRoot ? ' is-root' : ''}`;
      el.style.position = 'static';
      el.style.visibility = 'hidden';
      el.innerHTML = `<span class="mm-node-text">${renderNodeInlineHtml(text)}</span>${hasNote ? '<span class="mm-node-note-icon">📝</span>' : ''}`;
      measureBox.innerHTML = '';
      measureBox.appendChild(el);
      const r = el.getBoundingClientRect();
      const rawW = Math.max(r.width, el.offsetWidth);
      const rawH = Math.max(r.height, el.offsetHeight);
      measureBox.innerHTML = '';
      const dim =
        rawW >= 1 && rawH >= 1
          ? { w: Math.min(278, Math.max(54, Math.ceil(rawW) + 6)), h: Math.max(34, Math.ceil(rawH)) }
          : fallbackMeasureSize((text || '').length);
      if (rawW >= 1 && rawH >= 1) {
        if (measureCache.size > 1500) measureCache.clear();
        measureCache.set(cacheKey, dim);
      }
      return dim;
    }

    function measureNodesOnStage(root: MindMapNode): Map<string, { w: number; h: number }> {
      // 仅对未命中缓存的文本测量一次，大幅降低编辑/折叠/大纲同步时的瞬时重排开销
      const measured = new Map<string, { w: number; h: number }>();
      const uncached: Array<{ id: string; key: string; el: HTMLElement; textLen: number }> = [];
      const frag = document.createDocumentFragment();

      const walk = (node: MindMapNode, depth: number) => {
        const isRoot = depth === 0;
        const hasNote = Boolean(node.note);
        const key = `${isRoot ? 'R' : 'N'}|${hasNote ? 1 : 0}|${node.text}`;
        const cached = measureCache.get(key);
        if (cached) {
          measured.set(node.id, cached);
        } else {
          const el = document.createElement('div');
          el.className = `mm-node${isRoot ? ' is-root' : ''}`;
          el.style.position = 'static';
          el.style.visibility = 'hidden';
          el.innerHTML = `<span class="mm-node-text">${renderNodeInlineHtml(node.text)}</span>${hasNote ? '<span class="mm-node-note-icon">📝</span>' : ''}`;
          frag.appendChild(el);
          uncached.push({ id: node.id, key, el, textLen: (node.text || '').length });
        }
        if (!node.collapsed) {
          for (const child of node.children || []) {
            walk(child, depth + 1);
          }
        }
      };

      walk(root, 0);
      if (uncached.length > 0) {
        measureBox.innerHTML = '';
        measureBox.appendChild(frag);
        if (measureCache.size + uncached.length > 1500) measureCache.clear();
        for (const item of uncached) {
          const r = item.el.getBoundingClientRect();
          const rawW = Math.max(r.width, item.el.offsetWidth);
          const rawH = Math.max(r.height, item.el.offsetHeight);
          if (rawW >= 1 && rawH >= 1) {
            const dim = {
              w: Math.min(278, Math.max(54, Math.ceil(rawW) + 6)),
              h: Math.max(34, Math.ceil(rawH)),
            };
            measureCache.set(item.key, dim);
            measured.set(item.id, dim);
          } else {
            measured.set(item.id, fallbackMeasureSize(item.textLen));
          }
        }
        measureBox.innerHTML = '';
      }
      return measured;
    }

    function computeMindMapLayout(
      root: MindMapNode,
      layout: MindMapLayout,
      sizes: Map<string, { w: number; h: number }>
    ): { boxes: Map<string, NodeBox>; width: number; height: number } {
      const H_GAP = 54;
      const V_GAP = 16;
      const TREE_HGAP = 24;
      const TREE_VGAP = 52;
      const boxes = new Map<string, NodeBox>();

      const sizeOf = (id: string) => sizes.get(id) || { w: 110, h: 34 };

      const getSpanHeight = (node: MindMapNode): number => {
        const selfH = sizeOf(node.id).h;
        if (node.collapsed || !node.children.length) return selfH;
        let sum = 0;
        node.children.forEach((c, i) => {
          if (i > 0) sum += V_GAP;
          sum += getSpanHeight(c);
        });
        return Math.max(selfH, sum);
      };

      const getSpanWidth = (node: MindMapNode): number => {
        const selfW = sizeOf(node.id).w;
        if (node.collapsed || !node.children.length) return selfW;
        let sum = 0;
        node.children.forEach((c, i) => {
          if (i > 0) sum += TREE_HGAP;
          sum += getSpanWidth(c);
        });
        return Math.max(selfW, sum);
      };

      if (layout === 'tree-down') {
        const placeDown = (
          node: MindMapNode,
          depth: number,
          parentId: string | null,
          leftX: number,
          topY: number,
          inheritedColor: MindMapColor
        ) => {
          const { w, h } = sizeOf(node.id);
          const spanW = getSpanWidth(node);
          const x = leftX + (spanW - w) / 2;
          const nodeColor = node.color || inheritedColor;
          boxes.set(node.id, {
            node,
            depth,
            parentId,
            side: depth === 0 ? 'root' : 'down',
            x,
            y: topY,
            w,
            h,
            color: colorHex(nodeColor),
          });
          if (!node.collapsed && node.children.length > 0) {
            let totalKidsW = 0;
            const kidSpans = node.children.map((c, idx) => {
              const sw = getSpanWidth(c);
              totalKidsW += sw + (idx > 0 ? TREE_HGAP : 0);
              return sw;
            });
            let curX = leftX + Math.max(0, (spanW - totalKidsW) / 2);
            const nextY = topY + h + TREE_VGAP;
            node.children.forEach((c, idx) => {
              placeDown(c, depth + 1, node.id, curX, nextY, depth === 0 ? (c.color || 'blue') : nodeColor);
              curX += kidSpans[idx] + TREE_HGAP;
            });
          }
        };
        placeDown(root, 0, null, 80, 60, 'ink');
      } else {
        const placeSubtree = (
          node: MindMapNode,
          depth: number,
          parentId: string | null,
          anchorX: number,
          topY: number,
          dir: 1 | -1,
          inheritedColor: MindMapColor
        ) => {
          const { w, h } = sizeOf(node.id);
          const spanH = getSpanHeight(node);
          const x = dir === 1 ? anchorX : anchorX - w;
          const y = topY + (spanH - h) / 2;
          const nodeColor = node.color || inheritedColor;
          boxes.set(node.id, {
            node,
            depth,
            parentId,
            side: dir === 1 ? 'right' : 'left',
            x,
            y,
            w,
            h,
            color: colorHex(nodeColor),
          });

          if (!node.collapsed && node.children.length > 0) {
            let kidsH = 0;
            const kidSpans = node.children.map((c, idx) => {
              const sh = getSpanHeight(c);
              kidsH += sh + (idx > 0 ? V_GAP : 0);
              return sh;
            });
            let curY = topY + Math.max(0, (spanH - kidsH) / 2);
            const childAnchorX = dir === 1 ? x + w + H_GAP : x - H_GAP;
            node.children.forEach((c, idx) => {
              placeSubtree(
                c,
                depth + 1,
                node.id,
                childAnchorX,
                curY,
                dir,
                depth === 0 ? (c.color || 'blue') : nodeColor
              );
              curY += kidSpans[idx] + V_GAP;
            });
          }
        };

        const rootSize = sizeOf(root.id);
        if (layout === 'logic-right') {
          placeSubtree(root, 0, null, 80, 80, 1, 'ink');
          const rBox = boxes.get(root.id)!;
          rBox.side = 'root';
        } else {
          // mindmap-both: split level-1 branches left vs right
          const leftKids: MindMapNode[] = [];
          const rightKids: MindMapNode[] = [];
          (root.children || []).forEach((c, idx) => {
            if (c.side === 'left' || (!c.side && idx % 2 === 1)) leftKids.push(c);
            else rightKids.push(c);
          });

          const leftTotalH = leftKids.reduce((acc, c, i) => acc + getSpanHeight(c) + (i > 0 ? V_GAP : 0), 0);
          const rightTotalH = rightKids.reduce((acc, c, i) => acc + getSpanHeight(c) + (i > 0 ? V_GAP : 0), 0);
          const maxSpanH = Math.max(rootSize.h, leftTotalH, rightTotalH);

          const rootX = 480;
          const rootY = 80 + (maxSpanH - rootSize.h) / 2;
          boxes.set(root.id, {
            node: root,
            depth: 0,
            parentId: null,
            side: 'root',
            x: rootX,
            y: rootY,
            w: rootSize.w,
            h: rootSize.h,
            color: colorHex('ink'),
          });

          let ry = 80 + (maxSpanH - rightTotalH) / 2;
          for (const rc of rightKids) {
            const sh = getSpanHeight(rc);
            placeSubtree(rc, 1, root.id, rootX + rootSize.w + H_GAP, ry, 1, rc.color || 'blue');
            ry += sh + V_GAP;
          }

          let ly = 80 + (maxSpanH - leftTotalH) / 2;
          for (const lc of leftKids) {
            const sh = getSpanHeight(lc);
            placeSubtree(lc, 1, root.id, rootX - H_GAP, ly, -1, lc.color || 'green');
            ly += sh + V_GAP;
          }
        }
      }

      // Normalize positive canvas bounds with generous padding
      let minX = Infinity;
      let minY = Infinity;
      let maxX = -Infinity;
      let maxY = -Infinity;
      for (const b of boxes.values()) {
        if (b.x < minX) minX = b.x;
        if (b.y < minY) minY = b.y;
        if (b.x + b.w > maxX) maxX = b.x + b.w;
        if (b.y + b.h > maxY) maxY = b.y + b.h;
      }
      const PAD = 90;
      const shiftX = PAD - (Number.isFinite(minX) ? minX : 0);
      const shiftY = PAD - (Number.isFinite(minY) ? minY : 0);
      for (const b of boxes.values()) {
        b.x += shiftX;
        b.y += shiftY;
      }

      const width = Math.max(400, Math.round((maxX - minX) + PAD * 2));
      const height = Math.max(300, Math.round((maxY - minY) + PAD * 2));
      return { boxes, width, height };
    }

    function buildLinkPath(parent: NodeBox, child: NodeBox): string {
      return buildInkBranchPath(parent, child);
    }

    function fitCanvasToViewport(animate = false) {
      if (!activeMap || laidOutBoxes.size === 0) return;
      refreshViewportMetrics();
      const vpRect = cachedVpRect;
      if (!vpRect.width || !vpRect.height) return;
      const padX = 72;
      const padTop = 76;
      const padBottom = 68;
      const usableW = Math.max(220, vpRect.width - padX * 2);
      const usableH = Math.max(180, vpRect.height - padTop - padBottom);
      const nextZoom = Math.max(0.38, Math.min(1.18, Math.min(usableW / stageW, usableH / stageH)));
      const nextPanX = (vpRect.width - stageW * nextZoom) / 2;
      const nextPanY = padTop + (usableH - stageH * nextZoom) / 2;
      animateViewportTo(nextPanX, nextPanY, nextZoom, animate);
    }

    function centerOnRoot() {
      if (!activeMap) return;
      const rootBox = laidOutBoxes.get(activeMap.root.id);
      refreshViewportMetrics();
      const vpRect = cachedVpRect;
      if (!rootBox || !vpRect.width) return;
      const nextPanX = vpRect.width / 2 - (rootBox.x + rootBox.w / 2) * zoom;
      const nextPanY = vpRect.height / 2 - (rootBox.y + rootBox.h / 2) * zoom;
      animateViewportTo(nextPanX, nextPanY, zoom, true);
    }

    function syncNodePillState() {
      if (!activeMap) return;
      const ids = selectedNodeIds.size > 0
        ? [...selectedNodeIds]
        : selectedNodeId
          ? [selectedNodeId]
          : [activeMap.root.id];
      const isMulti = ids.length > 1;
      pillMultiBadge.textContent = `已选 ${ids.length}`;
      pillMultiBadge.classList.toggle('hidden', !isMulti);

      const selectedNodes = ids
        .map((id) => findNodeById(activeMap!.root, id))
        .filter((n): n is MindMapNode => Boolean(n));
      if (!selectedNodes.length) return;

      const singleActs = ['child', 'sibling', 'edit', 'note', 'up', 'down'];
      for (const act of singleActs) {
        const btn = nodePill.querySelector<HTMLButtonElement>(`[data-node-act="${act}"]`);
        if (btn) btn.disabled = isMulti;
      }

      const firstColor = selectedNodes[0].color || 'ink';
      const sameColor = selectedNodes.every((n) => (n.color || 'ink') === firstColor);
      nodePill.querySelectorAll<HTMLElement>('[data-node-color]').forEach((btn) => {
        btn.classList.toggle('is-selected', sameColor && btn.dataset.nodeColor === firstColor);
      });

      const noteBtn = nodePill.querySelector<HTMLElement>('[data-node-act="note"]');
      noteBtn?.classList.toggle('is-has-note', !isMulti && Boolean(selectedNodes[0].note));

      const delBtn = nodePill.querySelector<HTMLButtonElement>('[data-node-act="delete"]');
      if (delBtn) delBtn.disabled = !selectedNodes.some((n) => n.id !== activeMap!.root.id);

      const toggleBtn = nodePill.querySelector<HTMLButtonElement>('[data-node-act="toggle"]');
      if (toggleBtn) toggleBtn.disabled = !selectedNodes.some((n) => n.children.length > 0);
    }

    function setSelection(ids: string[], primaryId?: string, updatePill = true) {
      if (!activeMap) return;
      const validIds: string[] = [];
      const seen = new Set<string>();
      for (const id of ids) {
        if (!seen.has(id) && findNodeById(activeMap.root, id)) {
          seen.add(id);
          validIds.push(id);
        }
      }
      if (!validIds.length) {
        validIds.push(activeMap.root.id);
        seen.add(activeMap.root.id);
      }
      selectedNodeIds = seen;
      selectedNodeId = primaryId && seen.has(primaryId) ? primaryId : validIds[0];

      for (const [id, el] of nodeDomMap.entries()) {
        el.classList.toggle('is-selected', seen.has(id));
      }
      if (updatePill) syncNodePillState();
    }

    function applyNodeAndLinkPositionsInPlace(
      boxes: Map<string, NodeBox>,
      width: number,
      height: number,
      skipTextNodeId?: string
    ) {
      stageW = width;
      stageH = height;
      canvasStage.style.width = `${stageW}px`;
      canvasStage.style.height = `${stageH}px`;
      nodesLayer.style.width = `${stageW}px`;
      nodesLayer.style.height = `${stageH}px`;
      linksSvg.setAttribute('width', String(stageW));
      linksSvg.setAttribute('height', String(stageH));
      linksSvg.setAttribute('viewBox', `0 0 ${stageW} ${stageH}`);
      dragPreviewSvg.setAttribute('width', String(stageW));
      dragPreviewSvg.setAttribute('height', String(stageH));
      dragPreviewSvg.setAttribute('viewBox', `0 0 ${stageW} ${stageH}`);

      for (const [id, el] of nodeDomMap.entries()) {
        const b = boxes.get(id);
        if (!b) continue;
        el.style.left = `${b.x}px`;
        el.style.top = `${b.y}px`;
        if (id === skipTextNodeId) {
          el.style.width = '';
          el.style.minWidth = `${b.w}px`;
          el.style.minHeight = `${b.h}px`;
        } else {
          el.style.width = `${b.w}px`;
          el.style.minWidth = '';
          el.style.minHeight = `${b.h}px`;
        }
      }

      for (const box of boxes.values()) {
        if (!box.parentId) continue;
        const pBox = boxes.get(box.parentId);
        const pathEl = linkDomMap.get(box.node.id);
        if (!pBox || !pathEl) continue;
        pathEl.setAttribute('d', buildLinkPath(pBox, box));
      }
    }

    const DEFAULT_NODE_PLACEHOLDERS = new Set(['核心主题', '新分支节点', '同级节点']);

    function startInlineNodeEdit(nodeId: string, options?: { placeCaretAtEnd?: boolean }) {
      if (!activeMap) return;
      const nodeEl = nodeDomMap.get(nodeId) || nodesLayer.querySelector<HTMLElement>(`[data-node-id="${nodeId}"]`);
      const node = findNodeById(activeMap.root, nodeId);
      if (!nodeEl || !node) return;
      editingNodeId = nodeId;
      setSelection([nodeId], nodeId);

      const origText = node.text;
      const textSpan = nodeEl.querySelector<HTMLElement>('.mm-node-text');
      if (!textSpan) return;

      const input = document.createElement('input');
      input.type = 'text';
      input.value = origText;
      input.className = 'mm-node-edit-input';
      const initialDim = measureSingleNodeDim(origText, nodeId === activeMap.root.id, Boolean(node.note));
      input.style.width = `${Math.max(72, Math.min(240, initialDim.w - 18))}px`;

      textSpan.replaceWith(input);
      nodeEl.style.width = '';
      input.focus();
      if (options?.placeCaretAtEnd && !DEFAULT_NODE_PLACEHOLDERS.has(origText)) {
        const len = input.value.length;
        input.setSelectionRange(len, len);
      } else {
        input.select();
      }

      let finished = false;
      let isComposing = false;
      let liveOutlineTimer: number | null = null;
      let liveRaf: number | null = null;

      const applyLiveResizeAndReflow = () => {
        if (finished || !activeMap) return;
        const liveVal = input.value;
        const measureTarget = liveVal || ' ';
        const isRoot = nodeId === activeMap.root.id;
        const dim = measureSingleNodeDim(measureTarget, isRoot, Boolean(node.note));
        input.style.width = `${Math.max(72, Math.min(240, dim.w - 18))}px`;

        if (isComposing || viewMode === 'outline') return;

        const oldBox = laidOutBoxes.get(nodeId);
        node.text = liveVal.replace(/\r?\n/g, ' ').trim() || (isRoot ? '核心主题' : ' ');
        nodesLayer.classList.add('is-live-typing');
        const sizes = measureNodesOnStage(activeMap.root);
        const layout = computeMindMapLayout(activeMap.root, activeMap.layout, sizes);
        const newBox = layout.boxes.get(nodeId);
        if (oldBox && newBox) {
          panX -= (newBox.x - oldBox.x) * zoom;
          panY -= (newBox.y - oldBox.y) * zoom;
          applyViewportTransform();
        }
        laidOutBoxes = layout.boxes;
        applyNodeAndLinkPositionsInPlace(layout.boxes, layout.width, layout.height, nodeId);

        if (viewMode === 'split' && document.activeElement !== outlineTextarea) {
          if (liveOutlineTimer) window.clearTimeout(liveOutlineTimer);
          liveOutlineTimer = window.setTimeout(() => {
            if (!activeMap || finished) return;
            suppressOutlineInput = true;
            outlineTextarea.value = mindmapToMarkdown(activeMap.root);
            suppressOutlineInput = false;
          }, 160);
        }
      };

      const scheduleLiveReflow = () => {
        if (liveRaf) return;
        liveRaf = requestAnimationFrame(() => {
          liveRaf = null;
          applyLiveResizeAndReflow();
        });
      };

      input.addEventListener('compositionstart', () => {
        isComposing = true;
      });
      input.addEventListener('compositionend', () => {
        isComposing = false;
        scheduleLiveReflow();
      });
      input.addEventListener('input', scheduleLiveReflow);

      const finish = (commit: boolean, keepCanvasFocus = true) => {
        if (finished) return;
        finished = true;
        if (liveRaf) cancelAnimationFrame(liveRaf);
        if (liveOutlineTimer) window.clearTimeout(liveOutlineTimer);
        editingNodeId = null;
        nodesLayer.classList.remove('is-live-typing');

        const prevRects = captureNodeRects();
        node.text = origText;
        nodeEl.style.minWidth = '';

        const committedText = commit ? input.value.trim() : '';
        const finalText = committedText || origText;
        const restoredSpan = document.createElement('span');
        restoredSpan.className = 'mm-node-text';
        restoredSpan.innerHTML = renderNodeInlineHtml(finalText);
        if (input.isConnected) input.replaceWith(restoredSpan);
        nodeEl.dataset.contentKey = `${finalText}|${node.note ? '1' : '0'}`;

        if (commit && activeMap && committedText && committedText !== origText) {
          pushUndoSnapshot();
          activeMap.root = updateNodeProps(activeMap.root, nodeId, { text: committedText });
          if (nodeId === activeMap.root.id) {
            activeMap.title = committedText;
            wbTitleInput.value = committedText;
          }
          scheduleWorkbenchSave();
        }
        renderCanvasAndOutline(false, prevRects, { anchorNodeId: nodeId, skipExitClones: true });
        if (keepCanvasFocus && viewMode !== 'outline') {
          requestAnimationFrame(() => canvasViewport.focus({ preventScroll: true }));
        }
      };

      input.addEventListener('blur', () => finish(true, false));
      input.addEventListener('keydown', (e) => {
        e.stopPropagation();
        if (e.key === 'Tab') {
          e.preventDefault();
          finish(true, false);
          if (!e.shiftKey) runNodeAction('child');
        } else if (e.key === 'Enter' && !isComposing) {
          e.preventDefault();
          finish(true, true);
        } else if (e.key === 'Escape') {
          e.preventDefault();
          finish(false, true);
        }
      });
    }

    interface RenderCanvasOptions {
      anchorNodeId?: string;
      animateLinks?: boolean;
      enteredIds?: Set<string>;
      skipExitClones?: boolean;
    }

    function ensureTreeComfortablyVisible(animate = true) {
      if (!activeMap || laidOutBoxes.size === 0 || viewMode === 'outline') return;
      refreshViewportMetrics();
      const vpRect = cachedVpRect;
      if (!vpRect.width || !vpRect.height) return;

      let minX = Infinity;
      let minY = Infinity;
      let maxX = -Infinity;
      let maxY = -Infinity;
      for (const b of laidOutBoxes.values()) {
        if (b.x < minX) minX = b.x;
        if (b.y < minY) minY = b.y;
        if (b.x + b.w > maxX) maxX = b.x + b.w;
        if (b.y + b.h > maxY) maxY = b.y + b.h;
      }
      if (!Number.isFinite(minX)) return;

      const sLeft = panX + minX * zoom;
      const sRight = panX + maxX * zoom;
      const sTop = panY + minY * zoom;
      const sBottom = panY + maxY * zoom;
      const treeW = sRight - sLeft;
      const treeH = sBottom - sTop;
      const marginX = 56;
      const marginTop = 72;
      const marginBottom = 64;
      const availW = vpRect.width - marginX * 2;
      const availH = vpRect.height - marginTop - marginBottom;

      let targetPanX = panX;
      let targetPanY = panY;

      if (treeW <= availW) {
        if (sLeft < marginX) targetPanX += marginX - sLeft;
        else if (sRight > vpRect.width - marginX) targetPanX -= sRight - (vpRect.width - marginX);
        const blankLeft = sLeft - marginX;
        const blankRight = vpRect.width - marginX - sRight;
        if (Math.abs(blankRight - blankLeft) > availW * 0.42 && treeW < availW * 0.85) {
          targetPanX = (vpRect.width - (minX + maxX) * zoom) / 2;
        }
      } else {
        if (sRight < vpRect.width * 0.4) targetPanX += vpRect.width * 0.55 - sRight;
        if (sLeft > vpRect.width * 0.6) targetPanX -= sLeft - vpRect.width * 0.45;
      }

      if (treeH <= availH) {
        if (sTop < marginTop) targetPanY += marginTop - sTop;
        else if (sBottom > vpRect.height - marginBottom) targetPanY -= sBottom - (vpRect.height - marginBottom);
      }

      if (Math.hypot(targetPanX - panX, targetPanY - panY) < 6) return;
      animateViewportTo(targetPanX, targetPanY, zoom, animate);
    }

    function spawnExitAnimations(
      prevBoxes: Map<string, NodeBox | { x: number; y: number }>,
      newBoxes: Map<string, NodeBox>,
      anchorShiftX: number,
      anchorShiftY: number,
      root: MindMapNode
    ) {
      const svgPaths: string[] = [];
      const clones: Array<{ el: HTMLElement; dx: number; dy: number; isCollapse: boolean }> = [];

      for (const [id, oldEntry] of prevBoxes.entries()) {
        if (newBoxes.has(id) || !('w' in oldEntry)) continue;
        const oldBox = oldEntry as NodeBox;
        const oldX = oldBox.x + anchorShiftX;
        const oldY = oldBox.y + anchorShiftY;

        // Check if node was hidden inside a collapsed ancestor (collapse animation) vs removed completely (delete animation)
        let collapseTargetBox: NodeBox | null = null;
        const pathInNew = findNodePath(root, id);
        if (pathInNew && pathInNew.length >= 2) {
          for (let i = 0; i < pathInNew.length - 1; i += 1) {
            const anc = pathInNew[i];
            if (anc.collapsed && newBoxes.has(anc.id)) {
              collapseTargetBox = newBoxes.get(anc.id)!;
              break;
            }
          }
        }

        // Capture outgoing SVG connector path if parent existed before (water-ink stroke retraction)
        if (oldBox.parentId && prevBoxes.has(oldBox.parentId)) {
          const prevP = prevBoxes.get(oldBox.parentId);
          if (prevP && 'w' in prevP) {
            const shiftedP: NodeBox = { ...(prevP as NodeBox), x: (prevP as NodeBox).x + anchorShiftX, y: (prevP as NodeBox).y + anchorShiftY };
            const shiftedC: NodeBox = { ...oldBox, x: oldX, y: oldY };
            const sw = computeInkBranchStrokeWidth(oldBox.depth).toFixed(2);
            const so = computeInkBranchOpacity(oldBox.depth).toFixed(2);
            svgPaths.push(
              `<path class="mm-exit-branch" pathLength="1" stroke-dasharray="1" stroke-dashoffset="0" d="${buildLinkPath(shiftedP, shiftedC)}" fill="none" stroke="${oldBox.color}" stroke-opacity="${so}" stroke-width="${sw}" stroke-linecap="round"/>`
            );
          }
        }

        const cloneEl = document.createElement('div');
        cloneEl.className = `mm-node${oldBox.depth === 0 ? ' is-root' : ''}`;
        cloneEl.style.left = `${oldX}px`;
        cloneEl.style.top = `${oldY}px`;
        cloneEl.style.width = `${oldBox.w}px`;
        cloneEl.style.minHeight = `${oldBox.h}px`;
        cloneEl.style.setProperty('--node-color', oldBox.color);
        cloneEl.style.pointerEvents = 'none';
        cloneEl.innerHTML = `<span class="mm-node-text">${renderNodeInlineHtml(oldBox.node.text)}</span>`;

        const dx = collapseTargetBox
          ? collapseTargetBox.x + collapseTargetBox.w / 2 - (oldX + oldBox.w / 2)
          : 0;
        const dy = collapseTargetBox
          ? collapseTargetBox.y + collapseTargetBox.h / 2 - (oldY + oldBox.h / 2)
          : 0;
        clones.push({ el: cloneEl, dx, dy, isCollapse: Boolean(collapseTargetBox) });
      }

      if (svgPaths.length > 0) {
        const svgNS = 'http://www.w3.org/2000/svg';
        const exitSvg = document.createElementNS(svgNS, 'svg');
        exitSvg.setAttribute('width', String(stageW));
        exitSvg.setAttribute('height', String(stageH));
        exitSvg.setAttribute('viewBox', `0 0 ${stageW} ${stageH}`);
        exitSvg.style.position = 'absolute';
        exitSvg.style.left = '0';
        exitSvg.style.top = '0';
        exitSvg.style.overflow = 'visible';
        exitSvg.style.pointerEvents = 'none';
        exitSvg.innerHTML = svgPaths.join('');
        exitLayer.appendChild(exitSvg);
        exitSvg.querySelectorAll<SVGPathElement>('.mm-exit-branch').forEach((p) => {
          p.animate(
            [
              { strokeDashoffset: '0', opacity: 0.92 },
              { strokeDashoffset: '1', opacity: 0 },
            ],
            { duration: 220, easing: 'cubic-bezier(0.32, 0, 0.2, 1)', fill: 'forwards' }
          );
        });
        const svgAnim = exitSvg.animate(
          [{ opacity: 1 }, { opacity: 0 }],
          { duration: 225, easing: 'cubic-bezier(0.32, 0, 0.2, 1)', fill: 'forwards' }
        );
        svgAnim.onfinish = () => exitSvg.remove();
      }

      if (clones.length > 0) {
        const frag = document.createDocumentFragment();
        for (const c of clones) frag.appendChild(c.el);
        exitLayer.appendChild(frag);
        for (const c of clones) {
          const anim = c.el.animate(
            c.isCollapse
              ? [
                  { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
                  { opacity: 0, transform: `translate3d(${c.dx.toFixed(1)}px, ${c.dy.toFixed(1)}px, 0) scale(0.58)` },
                ]
              : [
                  { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
                  { opacity: 0, transform: 'translate3d(0, -4px, 0) scale(0.72)' },
                ],
            {
              duration: c.isCollapse ? 230 : 185,
              easing: c.isCollapse ? 'cubic-bezier(0.32, 0, 0.2, 1)' : 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'forwards',
            }
          );
          anim.onfinish = () => c.el.remove();
        }
      }
    }

    function createOrUpdateNodeElement(box: NodeBox, isSelected: boolean): { el: HTMLElement; created: boolean } {
      const id = box.node.id;
      const isRoot = box.depth === 0;
      const existing = nodeDomMap.get(id);
      const hiddenCount = box.node.collapsed ? countSubtreeDescendants(box.node) : 0;
      const collapseKey = box.node.children.length > 0
        ? `${box.side}|${box.node.collapsed ? `+${hiddenCount}` : '-'}`
        : 'none';
      const noteKey = box.node.note ? '1' : '0';
      const contentKey = `${box.node.text}|${noteKey}`;

      if (existing) {
        existing.className = `mm-node${isRoot ? ' is-root' : ''}${isSelected ? ' is-selected' : ''}`;
        existing.style.left = `${box.x}px`;
        existing.style.top = `${box.y}px`;
        existing.style.width = `${box.w}px`;
        existing.style.minWidth = '';
        existing.style.minHeight = `${box.h}px`;
        existing.style.setProperty('--node-color', box.color);

        const orphanInput = existing.querySelector('.mm-node-edit-input');
        if (editingNodeId !== id && orphanInput) {
          orphanInput.remove();
          existing.dataset.contentKey = '';
        }
        if (editingNodeId !== id && existing.dataset.contentKey !== contentKey) {
          existing.dataset.contentKey = contentKey;
          const textSpan = existing.querySelector('.mm-node-text');
          const noteIcon = existing.querySelector('.mm-node-note-icon');
          if (textSpan) textSpan.innerHTML = renderNodeInlineHtml(box.node.text);
          else {
            const sp = document.createElement('span');
            sp.className = 'mm-node-text';
            sp.innerHTML = renderNodeInlineHtml(box.node.text);
            existing.prepend(sp);
          }
          if (box.node.note && !noteIcon) {
            const ni = document.createElement('span');
            ni.className = 'mm-node-note-icon';
            ni.title = '包含节点备注';
            ni.textContent = '📝';
            const colBtn = existing.querySelector('.mm-collapse-btn');
            if (colBtn) existing.insertBefore(ni, colBtn);
            else existing.appendChild(ni);
          } else if (!box.node.note && noteIcon) {
            noteIcon.remove();
          }
        }

        if (existing.dataset.collapseKey !== collapseKey) {
          existing.dataset.collapseKey = collapseKey;
          let btn = existing.querySelector<HTMLButtonElement>('.mm-collapse-btn');
          if (collapseKey === 'none') {
            btn?.remove();
          } else {
            let sideClass = '';
            if (box.side === 'left') sideClass = ' is-left';
            else if (box.side === 'down' || (isRoot && activeMap?.layout === 'mindmap-both')) {
              sideClass = ' is-bottom';
            }
            if (!btn) {
              btn = document.createElement('button');
              btn.type = 'button';
              btn.addEventListener('pointerdown', (e) => e.stopPropagation());
              btn.addEventListener('click', (e) => {
                e.stopPropagation();
                if (!activeMap) return;
                const snap = captureNodeRects();
                pushUndoSnapshot();
                if (id === activeMap.root.id) {
                  const hasAnyCollapsed = activeMap.root.children.some((c) => c.collapsed);
                  activeMap.root = setAllCollapsed(activeMap.root, !hasAnyCollapsed);
                  renderCanvasAndOutline(true, snap, { animateLinks: true });
                } else {
                  const cur = findNodeById(activeMap.root, id);
                  activeMap.root = updateNodeProps(activeMap.root, id, {
                    collapsed: !cur?.collapsed,
                  });
                  renderCanvasAndOutline(false, snap, { anchorNodeId: id, animateLinks: true });
                }
                scheduleWorkbenchSave();
                canvasViewport.focus({ preventScroll: true });
              });
              existing.appendChild(btn);
            }
            btn.className = `mm-collapse-btn${sideClass}`;
            btn.textContent = box.node.collapsed ? `+${hiddenCount}` : '−';
            btn.title = box.node.collapsed ? `展开 ${hiddenCount} 个子节点` : '折叠该分支';
          }
        }
        return { el: existing, created: false };
      }

      const el = document.createElement('div');
      el.className = `mm-node${isRoot ? ' is-root' : ''}${isSelected ? ' is-selected' : ''}`;
      el.dataset.nodeId = id;
      el.dataset.contentKey = contentKey;
      el.dataset.collapseKey = collapseKey;
      el.style.left = `${box.x}px`;
      el.style.top = `${box.y}px`;
      el.style.width = `${box.w}px`;
      el.style.minHeight = `${box.h}px`;
      el.style.setProperty('--node-color', box.color);

      el.innerHTML = `<span class="mm-node-text">${renderNodeInlineHtml(box.node.text)}</span>${
        box.node.note ? `<span class="mm-node-note-icon" title="包含节点备注">📝</span>` : ''
      }`;

      if (box.node.children.length > 0) {
        const btn = document.createElement('button');
        btn.type = 'button';
        let sideClass = '';
        if (box.side === 'left') sideClass = ' is-left';
        else if (box.side === 'down' || (isRoot && activeMap?.layout === 'mindmap-both')) {
          sideClass = ' is-bottom';
        }
        btn.className = `mm-collapse-btn${sideClass}`;
        btn.textContent = box.node.collapsed ? `+${hiddenCount}` : '−';
        btn.title = box.node.collapsed ? `展开 ${hiddenCount} 个子节点` : '折叠该分支';
        btn.addEventListener('pointerdown', (e) => e.stopPropagation());
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (!activeMap) return;
          const snap = captureNodeRects();
          pushUndoSnapshot();
          if (isRoot) {
            const hasAnyCollapsed = activeMap.root.children.some((c) => c.collapsed);
            activeMap.root = setAllCollapsed(activeMap.root, !hasAnyCollapsed);
            renderCanvasAndOutline(true, snap, { animateLinks: true });
          } else {
            const cur = findNodeById(activeMap.root, id);
            activeMap.root = updateNodeProps(activeMap.root, id, {
              collapsed: !cur?.collapsed,
            });
            renderCanvasAndOutline(false, snap, { anchorNodeId: id, animateLinks: true });
          }
          scheduleWorkbenchSave();
          canvasViewport.focus({ preventScroll: true });
        });
        el.appendChild(btn);
      }

      el.addEventListener('pointerdown', (e) => onNodePointerDown(e, id));
      el.addEventListener('dblclick', (e) => {
        e.stopPropagation();
        startInlineNodeEdit(id);
      });

      nodeDomMap.set(id, el);
      return { el, created: true };
    }

    function renderCanvas(
      prevRects?: Map<string, NodeBox | { x: number; y: number }>,
      autoFit = false,
      opts: RenderCanvasOptions = {}
    ) {
      if (!activeMap) return;
      const sizes = measureNodesOnStage(activeMap.root);
      const layout = computeMindMapLayout(activeMap.root, activeMap.layout, sizes);
      laidOutBoxes = layout.boxes;
      stageW = layout.width;
      stageH = layout.height;

      // Anchor clicked/edited node on screen during non-autoFit updates so stage origin changes never jerk the tree sideways
      let anchorShiftX = 0;
      let anchorShiftY = 0;
      if (!autoFit && prevRects && opts.anchorNodeId) {
        const oldAnchor = prevRects.get(opts.anchorNodeId);
        const newAnchor = laidOutBoxes.get(opts.anchorNodeId);
        if (oldAnchor && newAnchor) {
          anchorShiftX = newAnchor.x - oldAnchor.x;
          anchorShiftY = newAnchor.y - oldAnchor.y;
          panX -= anchorShiftX * zoom;
          panY -= anchorShiftY * zoom;
        }
      }

      canvasStage.style.width = `${stageW}px`;
      canvasStage.style.height = `${stageH}px`;
      nodesLayer.style.width = `${stageW}px`;
      nodesLayer.style.height = `${stageH}px`;
      linksSvg.setAttribute('width', String(stageW));
      linksSvg.setAttribute('height', String(stageH));
      linksSvg.setAttribute('viewBox', `0 0 ${stageW} ${stageH}`);
      dragPreviewSvg.setAttribute('width', String(stageW));
      dragPreviewSvg.setAttribute('height', String(stageH));
      dragPreviewSvg.setAttribute('viewBox', `0 0 ${stageW} ${stageH}`);

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (linkMorphRafId !== null) {
        cancelAnimationFrame(linkMorphRafId);
        linkMorphRafId = null;
      }

      // Spawn collapse-into-parent or delete shrink-fade exit animations cleanly in non-blocking overlay
      if (prevRects && prevRects.size > 0 && !reduceMotion && !opts.skipExitClones) {
        spawnExitAnimations(prevRects, laidOutBoxes, anchorShiftX, anchorShiftY, activeMap.root);
      }

      // 1. Keyed SVG Calligraphic Bezier Link Reconciliation (hierarchical ink brush taper)
      const activeLinkIds = new Set<string>();
      const svgNS = 'http://www.w3.org/2000/svg';
      const newLinks: Array<{ pathEl: SVGPathElement; box: NodeBox }> = [];
      for (const box of laidOutBoxes.values()) {
        if (!box.parentId) continue;
        const pBox = laidOutBoxes.get(box.parentId);
        if (!pBox) continue;
        const id = box.node.id;
        activeLinkIds.add(id);
        const d = buildLinkPath(pBox, box);
        const sw = computeInkBranchStrokeWidth(box.depth).toFixed(2);
        const so = computeInkBranchOpacity(box.depth).toFixed(2);
        let pathEl = linkDomMap.get(id);
        if (!pathEl) {
          pathEl = document.createElementNS(svgNS, 'path');
          pathEl.setAttribute('fill', 'none');
          pathEl.setAttribute('stroke-linecap', 'round');
          pathEl.setAttribute('pathLength', '1');
          linkDomMap.set(id, pathEl);
          linksSvg.appendChild(pathEl);
          newLinks.push({ pathEl, box });
        }
        pathEl.setAttribute('d', d);
        pathEl.setAttribute('stroke', box.color);
        pathEl.setAttribute('stroke-opacity', so);
        pathEl.setAttribute('stroke-width', sw);
      }
      for (const [id, pathEl] of linkDomMap.entries()) {
        if (!activeLinkIds.has(id)) {
          pathEl.remove();
          linkDomMap.delete(id);
        }
      }

      // 2. Keyed Interactive Node DOM Reconciliation (reuses unchanged elements & listeners)
      const activeSel = selectedNodeIds.size > 0
        ? selectedNodeIds
        : selectedNodeId
          ? new Set([selectedNodeId])
          : new Set([activeMap.root.id]);

      for (const [id, el] of nodeDomMap.entries()) {
        if (!laidOutBoxes.has(id)) {
          el.remove();
          nodeDomMap.delete(id);
        }
      }

      const newNodesFrag = document.createDocumentFragment();
      const flipNodes: Array<{ id: string; el: HTMLElement; dx: number; dy: number }> = [];
      const flipDeltas = new Map<string, { dx: number; dy: number }>();
      const enterNodes: Array<{ el: HTMLElement; box: NodeBox; spawnDx: number; spawnDy: number }> = [];

      const findSpawnOrigin = (box: NodeBox): { x: number; y: number; w: number; h: number } | null => {
        let curParentId = box.parentId;
        while (curParentId) {
          if (prevRects && prevRects.has(curParentId)) {
            const prevAnc = prevRects.get(curParentId)!;
            const curAnc = laidOutBoxes.get(curParentId);
            return {
              x: prevAnc.x + anchorShiftX,
              y: prevAnc.y + anchorShiftY,
              w: 'w' in prevAnc ? prevAnc.w : (curAnc?.w || box.w),
              h: 'h' in prevAnc ? prevAnc.h : (curAnc?.h || box.h),
            };
          }
          curParentId = laidOutBoxes.get(curParentId)?.parentId || null;
        }
        if (box.parentId && laidOutBoxes.has(box.parentId)) {
          return laidOutBoxes.get(box.parentId)!;
        }
        return null;
      };

      for (const box of laidOutBoxes.values()) {
        const isSel = activeSel.has(box.node.id);
        const { el, created } = createOrUpdateNodeElement(box, isSel);
        if (created) newNodesFrag.appendChild(el);

        const isExplicitEnter = opts.enteredIds?.has(box.node.id);
        if (prevRects && prevRects.has(box.node.id) && !isExplicitEnter) {
          const prev = prevRects.get(box.node.id)!;
          const dx = prev.x + anchorShiftX - box.x;
          const dy = prev.y + anchorShiftY - box.y;
          if (Math.hypot(dx, dy) > 1.5) {
            flipNodes.push({ id: box.node.id, el, dx, dy });
            flipDeltas.set(box.node.id, { dx, dy });
          }
        } else if (isExplicitEnter || (prevRects && prevRects.size > 0 && !prevRects.has(box.node.id))) {
          const origin = findSpawnOrigin(box);
          const spawnDx = origin ? (origin.x + origin.w * 0.5) - (box.x + box.w * 0.5) : 0;
          const spawnDy = origin ? (origin.y + origin.h * 0.5) - (box.y + box.h * 0.5) : 0;
          enterNodes.push({ el, box, spawnDx, spawnDy });
        }
      }
      if (newNodesFrag.childNodes.length > 0) nodesLayer.appendChild(newNodesFrag);

      // 3. Water-ink branch stroke unfurling (毛笔运笔舒展: pathLength=1 strokeDashoffset 1 -> 0)
      const minEnterDepth = enterNodes.length > 0
        ? enterNodes.reduce((m, n) => Math.min(m, n.box.depth), Infinity)
        : 1;

      if (!reduceMotion && newLinks.length > 0 && (opts.animateLinks || enterNodes.length > 0) && newLinks.length < laidOutBoxes.size) {
        for (const { pathEl, box } of newLinks) {
          const relDepth = Math.max(0, box.depth - minEnterDepth);
          const delay = Math.min(130, relDepth * 32);
          pathEl.style.strokeDasharray = '1';
          pathEl.style.strokeDashoffset = '1';
          const anim = pathEl.animate(
            [
              { strokeDashoffset: '1', opacity: 0.2 },
              { strokeDashoffset: '0', opacity: 1 },
            ],
            {
              duration: 340,
              delay,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'forwards',
            }
          );
          anim.onfinish = () => {
            pathEl.style.strokeDasharray = '';
            pathEl.style.strokeDashoffset = '';
          };
        }
      }

      // 4. Pure GPU WAAPI FLIP for moved/reflowed nodes + Continuous Bezier Link Morph (zero detachment)
      const FLIP_DURATION_MS = 280;
      if (flipNodes.length > 0 && !reduceMotion) {
        for (const item of flipNodes) {
          item.el.animate(
            [
              { transform: `translate3d(${item.dx.toFixed(1)}px, ${item.dy.toFixed(1)}px, 0)` },
              { transform: 'translate3d(0, 0, 0)' },
            ],
            {
              duration: FLIP_DURATION_MS,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            }
          );
        }

        if (laidOutBoxes.size <= 160) {
          const morphPairs: Array<{ pathEl: SVGPathElement; pBox: NodeBox; cBox: NodeBox; pDelta?: { dx: number; dy: number }; cDelta?: { dx: number; dy: number } }> = [];
          for (const box of laidOutBoxes.values()) {
            if (!box.parentId) continue;
            const pDelta = flipDeltas.get(box.parentId);
            const cDelta = flipDeltas.get(box.node.id);
            if (!pDelta && !cDelta) continue;
            const pBox = laidOutBoxes.get(box.parentId);
            const pathEl = linkDomMap.get(box.node.id);
            if (pBox && pathEl) {
              morphPairs.push({ pathEl, pBox, cBox: box, pDelta, cDelta });
            }
          }
          if (morphPairs.length > 0) {
            const morphStart = performance.now();
            const stepMorph = (now: number) => {
              const rawT = Math.min(1, Math.max(0, (now - morphStart) / FLIP_DURATION_MS));
              // Matches cubic-bezier(0.22, 1, 0.36, 1) ease-out curve
              const eased = 1 - Math.pow(1 - rawT, 3.25);
              const rem = 1 - eased;
              for (const pair of morphPairs) {
                const ip = pair.pDelta
                  ? { ...pair.pBox, x: pair.pBox.x + pair.pDelta.dx * rem, y: pair.pBox.y + pair.pDelta.dy * rem }
                  : pair.pBox;
                const ic = pair.cDelta
                  ? { ...pair.cBox, x: pair.cBox.x + pair.cDelta.dx * rem, y: pair.cBox.y + pair.cDelta.dy * rem }
                  : pair.cBox;
                pair.pathEl.setAttribute('d', buildLinkPath(ip, ic));
              }
              if (rawT < 1) {
                linkMorphRafId = requestAnimationFrame(stepMorph);
              } else {
                linkMorphRafId = null;
              }
            };
            linkMorphRafId = requestAnimationFrame(stepMorph);
          }
        }
      }

      // 5. Water-ink parent-origin sprouting for newly added / expanded child nodes
      if (enterNodes.length > 0 && !reduceMotion) {
        const siblingStep = enterNodes.length > 1 ? Math.min(14, 96 / enterNodes.length) : 0;
        enterNodes.forEach(({ el, box, spawnDx, spawnDy }, idx) => {
          const relDepth = Math.max(0, box.depth - minEnterDepth);
          const delay = Math.min(150, relDepth * 30 + idx * siblingStep);
          const startX = (spawnDx * 0.8).toFixed(1);
          const startY = (spawnDy * 0.8).toFixed(1);
          el.animate(
            [
              { opacity: 0, transform: `translate3d(${startX}px, ${startY}px, 0) scale(0.74)` },
              { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1.018)', offset: 0.78 },
              { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)' },
            ],
            {
              duration: 340,
              delay,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              fill: 'backwards',
            }
          );
        });
      }

      const { total, hidden } = countNodes(activeMap.root);
      wbNodeStats.textContent = hidden > 0 ? `${total} 节点（${hidden} 已收起）` : `${total} 节点`;
      renderMinimapTopology();
      syncNodePillState();
      if (autoFit) {
        fitCanvasToViewport(!reduceMotion && Boolean(prevRects && prevRects.size > 0));
      } else {
        applyViewportTransform();
        if (prevRects && prevRects.size > 0) {
          requestAnimationFrame(() => ensureTreeComfortablyVisible(true));
        }
      }
    }

    function renderCanvasAndOutline(
      autoFit = false,
      prevRects?: Map<string, NodeBox | { x: number; y: number }>,
      opts: RenderCanvasOptions = {}
    ) {
      if (!activeMap) return;
      renderCanvas(prevRects, autoFit, opts);
      if (!suppressOutlineInput && document.activeElement !== outlineTextarea) {
        suppressOutlineInput = true;
        outlineTextarea.value = mindmapToMarkdown(activeMap.root);
        suppressOutlineInput = false;
      }
    }

    // ---------- Pointer-Following Drag-and-Drop Engine ----------
    let dragState: {
      dragId: string;
      dragColor: string;
      startX: number;
      startY: number;
      offsetX: number;
      offsetY: number;
      width: number;
      height: number;
      started: boolean;
      targetId: string | null;
      mode: 'inside' | 'before' | 'after';
      rafId: number | null;
      lastClientX: number;
      lastClientY: number;
      lastDropTargetEl: HTMLElement | null;
      lastPreviewSvgStr: string;
    } | null = null;

    function clearDragVisuals() {
      dragGhostEl.classList.add('hidden');
      dropPillEl.classList.add('hidden');
      dragPreviewSvg.innerHTML = '';
      reorderIndicatorEl.classList.add('hidden');
      nodesLayer.querySelectorAll('.mm-node.is-dragging-source, .mm-node.is-drop-target').forEach((n) => {
        n.classList.remove('is-dragging-source', 'is-drop-target');
      });
    }

    const dropPillSizeCache = new Map<string, { w: number; h: number }>();

    function findDropCandidate(clientX: number, clientY: number, dragId: string): {
      targetId: string | null;
      mode: 'inside' | 'before' | 'after';
    } {
      if (!activeMap) return { targetId: null, mode: 'inside' };
      const dragNode = findNodeById(activeMap.root, dragId);
      if (!dragNode) return { targetId: null, mode: 'inside' };

      const vpRect = cachedVpRect;
      const wx = (clientX - vpRect.left - panX) / zoom;
      const wy = (clientY - vpRect.top - panY) / zoom;

      let bestBox: NodeBox | null = null;
      let bestDist = Infinity;

      for (const box of laidOutBoxes.values()) {
        if (box.node.id === dragId || isDescendant(dragNode, box.node.id)) continue;
        const cx = Math.max(box.x, Math.min(wx, box.x + box.w));
        const cy = Math.max(box.y, Math.min(wy, box.y + box.h));
        const dist = Math.hypot(wx - cx, wy - cy);
        if (dist < 42 && dist < bestDist) {
          bestDist = dist;
          bestBox = box;
        }
      }

      if (!bestBox) return { targetId: null, mode: 'inside' };
      if (bestBox.depth === 0) return { targetId: bestBox.node.id, mode: 'inside' };

      if (bestBox.side === 'down') {
        const relX = (wx - bestBox.x) / bestBox.w;
        if (relX < 0.26) return { targetId: bestBox.node.id, mode: 'before' };
        if (relX > 0.74) return { targetId: bestBox.node.id, mode: 'after' };
      } else {
        const relY = (wy - bestBox.y) / bestBox.h;
        if (relY < 0.28) return { targetId: bestBox.node.id, mode: 'before' };
        if (relY > 0.72) return { targetId: bestBox.node.id, mode: 'after' };
      }
      return { targetId: bestBox.node.id, mode: 'inside' };
    }

    function positionDropPill(
      label: string,
      anchorCenterX: number,
      placement: 'above' | 'below',
      anchorTopY: number,
      anchorBottomY: number,
      vpRect: DOMRect,
      ghostBounds: { top: number; bottom: number }
    ) {
      if (dropPillEl.textContent !== label) {
        dropPillEl.textContent = label;
      }
      dropPillEl.classList.remove('hidden');
      let pillDim = dropPillSizeCache.get(label);
      if (!pillDim) {
        pillDim = {
          w: dropPillEl.offsetWidth || 72,
          h: dropPillEl.offsetHeight || 26,
        };
        dropPillSizeCache.set(label, pillDim);
      }
      const pw = pillDim.w;
      const ph = pillDim.h;
      const clearance = 10;
      const x = Math.max(vpRect.left + 8, Math.min(vpRect.right - pw - 8, anchorCenterX - pw / 2));
      let y = placement === 'above'
        ? Math.min(anchorTopY, ghostBounds.top) - ph - clearance
        : Math.max(anchorBottomY, ghostBounds.bottom) + clearance;
      if (placement === 'above' && y < vpRect.top + 8) {
        y = Math.max(anchorBottomY, ghostBounds.bottom) + clearance;
      } else if (placement === 'below' && y + ph > vpRect.bottom - 8) {
        y = Math.min(anchorTopY, ghostBounds.top) - ph - clearance;
      }
      y = Math.max(vpRect.top + 8, Math.min(vpRect.bottom - ph - 8, y));
      dropPillEl.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
    }

    function updateDragOverlayFrame() {
      if (!dragState || !dragState.started || !activeMap) return;
      const { dragId, dragColor, offsetX, offsetY, lastClientX, lastClientY, width, height } = dragState;

      // 1. Move fixed ghost node directly under pointer with zero lag
      const ghostLeft = lastClientX - offsetX;
      const ghostTop = lastClientY - offsetY;
      dragGhostEl.style.transform = `translate3d(${ghostLeft.toFixed(1)}px, ${ghostTop.toFixed(1)}px, 0) scale(1.03) rotate(0.5deg)`;

      // 2. Hit-test candidate target + render SVG live guide & unobstructed floating drop pill (zero DOM reflow)
      const { targetId, mode } = findDropCandidate(lastClientX, lastClientY, dragId);
      dragState.targetId = targetId;
      dragState.mode = mode;

      if (dragState.lastDropTargetEl) {
        dragState.lastDropTargetEl.classList.remove('is-drop-target');
        dragState.lastDropTargetEl = null;
      }
      reorderIndicatorEl.classList.add('hidden');

      if (!targetId) {
        dropPillEl.classList.add('hidden');
        if (dragState.lastPreviewSvgStr) {
          dragState.lastPreviewSvgStr = '';
          dragPreviewSvg.innerHTML = '';
        }
        return;
      }
      const tBox = laidOutBoxes.get(targetId);
      if (!tBox) return;

      const vpRect = cachedVpRect;
      const ghostBounds = { top: ghostTop, bottom: ghostTop + height };
      const ghostStageX = (ghostLeft - vpRect.left - panX) / zoom + width / 2;
      const ghostStageY = (ghostTop - vpRect.top - panY) / zoom + height / 2;
      let nextPreviewSvg = '';

      if (mode === 'inside') {
        const targetEl = nodeDomMap.get(targetId) || nodesLayer.querySelector<HTMLElement>(`[data-node-id="${targetId}"]`);
        if (targetEl) {
          targetEl.classList.add('is-drop-target');
          dragState.lastDropTargetEl = targetEl;
        }
        const x1 = tBox.side === 'left' ? tBox.x : tBox.x + tBox.w;
        const y1 = tBox.y + tBox.h / 2;
        const midX = (x1 + ghostStageX) / 2;
        nextPreviewSvg = `<path d="M ${x1} ${y1} C ${midX} ${y1}, ${midX} ${ghostStageY}, ${ghostStageX} ${ghostStageY}" fill="none" stroke="${dragColor}" stroke-width="2.2" stroke-dasharray="6 5" stroke-opacity="0.85"/>`;
        const tScreenTop = vpRect.top + panY + tBox.y * zoom;
        const tScreenBottom = vpRect.top + panY + (tBox.y + tBox.h) * zoom;
        const tScreenCenterX = vpRect.left + panX + (tBox.x + tBox.w / 2) * zoom;
        positionDropPill(
          tBox.depth === 0 ? '成为根下分支' : '成为子节点',
          tScreenCenterX,
          'above',
          tScreenTop,
          tScreenBottom,
          vpRect,
          ghostBounds
        );
      } else {
        if (tBox.side === 'down') {
          reorderIndicatorEl.classList.add('is-vertical');
          const ix = mode === 'before' ? tBox.x - 10 : tBox.x + tBox.w + 8;
          reorderIndicatorEl.style.left = `${ix}px`;
          reorderIndicatorEl.style.top = `${tBox.y - 6}px`;
          reorderIndicatorEl.style.width = '3.5px';
          reorderIndicatorEl.style.height = `${tBox.h + 12}px`;

          const barScreenX = vpRect.left + panX + ix * zoom;
          const barScreenTop = vpRect.top + panY + tBox.y * zoom;
          const barScreenBottom = vpRect.top + panY + (tBox.y + tBox.h) * zoom;
          positionDropPill(
            mode === 'before' ? '移至左侧' : '移至右侧',
            barScreenX,
            'above',
            barScreenTop,
            barScreenBottom,
            vpRect,
            ghostBounds
          );
        } else {
          reorderIndicatorEl.classList.remove('is-vertical');
          const iy = mode === 'before' ? tBox.y - 9 : tBox.y + tBox.h + 7;
          reorderIndicatorEl.style.left = `${tBox.x}px`;
          reorderIndicatorEl.style.top = `${iy}px`;
          reorderIndicatorEl.style.width = `${Math.max(88, tBox.w)}px`;
          reorderIndicatorEl.style.height = '3.5px';

          const barScreenCenterX = vpRect.left + panX + (tBox.x + Math.max(88, tBox.w) / 2) * zoom;
          const barScreenY = vpRect.top + panY + iy * zoom;
          positionDropPill(
            mode === 'before' ? '↑ 插至上方' : '↓ 插至下方',
            barScreenCenterX,
            mode === 'before' ? 'above' : 'below',
            barScreenY,
            barScreenY + 4,
            vpRect,
            ghostBounds
          );
        }
        reorderIndicatorEl.classList.remove('hidden');

        const pBox = tBox.parentId ? laidOutBoxes.get(tBox.parentId) : null;
        if (pBox) {
          const sx = tBox.side === 'left' ? pBox.x : pBox.x + pBox.w;
          const sy = pBox.y + pBox.h / 2;
          const ex = tBox.x + (tBox.side === 'left' ? tBox.w : 0);
          const ey = mode === 'before' ? tBox.y - 7 : tBox.y + tBox.h + 8;
          const mid = (sx + ex) / 2;
          nextPreviewSvg = `<path d="M ${sx} ${sy} C ${mid} ${sy}, ${mid} ${ey}, ${ex} ${ey}" fill="none" stroke="var(--mm-focus-ink, var(--ink-strong))" stroke-width="2" stroke-dasharray="5 4"/>`;
        }
      }

      if (nextPreviewSvg !== dragState.lastPreviewSvgStr) {
        dragState.lastPreviewSvgStr = nextPreviewSvg;
        dragPreviewSvg.innerHTML = nextPreviewSvg;
      }
    }

    function onNodePointerDown(e: PointerEvent, nodeId: string) {
      if (e.button !== 0 || editingNodeId) return;
      e.stopPropagation();
      stopPanAnimation();

      if (e.ctrlKey || e.metaKey || e.shiftKey) {
        const nextIds = new Set(selectedNodeIds);
        if (selectedNodeIds.has(nodeId) && nextIds.size > 1) {
          nextIds.delete(nodeId);
        } else {
          nextIds.add(nodeId);
        }
        setSelection([...nextIds], nodeId);
        canvasViewport.focus({ preventScroll: true });
        return;
      }

      setSelection([nodeId], nodeId);
      if (!notePopover.classList.contains('hidden')) openNodeNotePopover();

      const nodeEl = nodeDomMap.get(nodeId) || nodesLayer.querySelector<HTMLElement>(`[data-node-id="${nodeId}"]`);
      if (!activeMap || nodeId === activeMap.root.id || !nodeEl) return;
      refreshViewportMetrics();
      const rect = nodeEl.getBoundingClientRect();
      const box = laidOutBoxes.get(nodeId);
      const unscaledW = box?.w || rect.width / (zoom || 1);
      const unscaledH = box?.h || rect.height / (zoom || 1);
      const relX = rect.width > 0 ? Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width)) : 0.5;
      const relY = rect.height > 0 ? Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height)) : 0.5;
      dragState = {
        dragId: nodeId,
        dragColor: box?.color || '#42a5f5',
        startX: e.clientX,
        startY: e.clientY,
        offsetX: relX * unscaledW,
        offsetY: relY * unscaledH,
        width: unscaledW,
        height: unscaledH,
        started: false,
        targetId: null,
        mode: 'inside',
        rafId: null,
        lastClientX: e.clientX,
        lastClientY: e.clientY,
        lastDropTargetEl: null,
        lastPreviewSvgStr: '',
      };
    }

    window.addEventListener('pointermove', (e) => {
      if (!dragState || !activeMap) return;
      dragState.lastClientX = e.clientX;
      dragState.lastClientY = e.clientY;
      if (!dragState.started) {
        if (Math.hypot(e.clientX - dragState.startX, e.clientY - dragState.startY) < 5) return;
        dragState.started = true;
        const sourceEl = nodeDomMap.get(dragState.dragId) || nodesLayer.querySelector<HTMLElement>(`[data-node-id="${dragState.dragId}"]`);
        sourceEl?.classList.add('is-dragging-source');
        const nodeObj = findNodeById(activeMap.root, dragState.dragId);
        dragGhostEl.innerHTML = renderNodeInlineHtml(nodeObj?.text || '分支');
        dragGhostEl.style.width = `${dragState.width}px`;
        dragGhostEl.style.setProperty('--ghost-color', dragState.dragColor);
        dragGhostEl.classList.remove('hidden');
      }
      if (!dragState.rafId) {
        dragState.rafId = requestAnimationFrame(() => {
          if (dragState) dragState.rafId = null;
          updateDragOverlayFrame();
        });
      }
    }, { signal });

    window.addEventListener('pointerup', () => {
      if (!dragState) return;
      const state = dragState;
      dragState = null;
      if (state.rafId) cancelAnimationFrame(state.rafId);

      if (state.started && state.targetId && activeMap) {
        const prevRects = captureNodeRects();
        const existingBox = prevRects.get(state.dragId);
        const vpRect = cachedVpRect;
        const ghostStageX = (state.lastClientX - state.offsetX - vpRect.left - panX) / zoom;
        const ghostStageY = (state.lastClientY - state.offsetY - vpRect.top - panY) / zoom;
        if (existingBox) {
          prevRects.set(state.dragId, { ...existingBox, x: ghostStageX, y: ghostStageY });
        }

        const updated = reparentOrReorderNode(activeMap.root, state.dragId, state.targetId, state.mode);
        clearDragVisuals();
        if (updated) {
          pushUndoSnapshot();
          activeMap.root = updated;
          setSelection([state.dragId], state.dragId, false);
          renderCanvasAndOutline(false, prevRects, { animateLinks: true, skipExitClones: true });
          scheduleWorkbenchSave();
          showToast(state.mode === 'inside' ? '已调整节点所属父级' : '已调整同级顺序');
        }
      } else {
        clearDragVisuals();
      }
    }, { signal });

    // ---------- Canvas Pan (rAF + Momentum Inertia), Long-Press Marquee, Minimap & Damped Wheel Zoom ----------
    let canvasGesture: {
      mode: 'pending' | 'pan' | 'marquee';
      startX: number;
      startY: number;
      origPanX: number;
      origPanY: number;
      holdTimer: number | null;
      baseSelection: Set<string>;
      additive: boolean;
    } | null = null;

    function triggerMarqueeMode() {
      if (!canvasGesture || canvasGesture.mode !== 'pending') return;
      canvasGesture.mode = 'marquee';
      canvasGesture.holdTimer = null;
      canvasViewport.classList.remove('is-panning');
      canvasViewport.classList.add('is-marquee');

      const paneRect = cachedPaneRect;
      const px = canvasGesture.startX - paneRect.left;
      const py = canvasGesture.startY - paneRect.top;
      holdPulseEl.style.left = `${px}px`;
      holdPulseEl.style.top = `${py}px`;
      holdPulseEl.classList.remove('hidden');
      if (holdPulseTimer) window.clearTimeout(holdPulseTimer);
      holdPulseTimer = window.setTimeout(() => {
        holdPulseTimer = null;
        holdPulseEl.classList.add('hidden');
      }, 380);

      marqueeBoxEl.style.left = `${px}px`;
      marqueeBoxEl.style.top = `${py}px`;
      marqueeBoxEl.style.width = '0px';
      marqueeBoxEl.style.height = '0px';
      marqueeBoxEl.classList.remove('hidden');
    }

    canvasViewport.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || (e.target as HTMLElement).closest('.mm-node')) return;
      stopPanAnimation();
      refreshViewportMetrics();
      const additive = e.shiftKey || e.ctrlKey || e.metaKey;
      lastPanSampleX = e.clientX;
      lastPanSampleY = e.clientY;
      lastPanSampleTime = performance.now();
      panVelX = 0;
      panVelY = 0;
      canvasGesture = {
        mode: 'pending',
        startX: e.clientX,
        startY: e.clientY,
        origPanX: panX,
        origPanY: panY,
        holdTimer: null,
        baseSelection: additive ? new Set(selectedNodeIds) : new Set(),
        additive,
      };
      if (additive) {
        triggerMarqueeMode();
      } else {
        canvasGesture.holdTimer = window.setTimeout(triggerMarqueeMode, 230);
      }
    }, { signal });

    window.addEventListener('pointermove', (e) => {
      if (!canvasGesture) return;
      const dx = e.clientX - canvasGesture.startX;
      const dy = e.clientY - canvasGesture.startY;
      if (canvasGesture.mode === 'pending') {
        if (Math.hypot(dx, dy) < 5) return;
        if (canvasGesture.holdTimer) {
          window.clearTimeout(canvasGesture.holdTimer);
          canvasGesture.holdTimer = null;
        }
        canvasGesture.mode = 'pan';
        canvasViewport.classList.add('is-panning');
        lastPanSampleX = e.clientX;
        lastPanSampleY = e.clientY;
        lastPanSampleTime = performance.now();
      }
      if (canvasGesture.mode === 'pan') {
        const now = performance.now();
        const dtMs = Math.max(4, now - lastPanSampleTime);
        const instVx = ((e.clientX - lastPanSampleX) / dtMs) * 1000;
        const instVy = ((e.clientY - lastPanSampleY) / dtMs) * 1000;
        panVelX = panVelX * 0.52 + instVx * 0.48;
        panVelY = panVelY * 0.52 + instVy * 0.48;
        lastPanSampleX = e.clientX;
        lastPanSampleY = e.clientY;
        lastPanSampleTime = now;
        pendingPointerPan = {
          x: canvasGesture.origPanX + dx,
          y: canvasGesture.origPanY + dy,
        };
        requestViewportFrame();
      } else if (canvasGesture.mode === 'marquee' && activeMap) {
        const paneRect = cachedPaneRect;
        const x0 = Math.min(canvasGesture.startX, e.clientX);
        const y0 = Math.min(canvasGesture.startY, e.clientY);
        const x1 = Math.max(canvasGesture.startX, e.clientX);
        const y1 = Math.max(canvasGesture.startY, e.clientY);
        marqueeBoxEl.style.left = `${x0 - paneRect.left}px`;
        marqueeBoxEl.style.top = `${y0 - paneRect.top}px`;
        marqueeBoxEl.style.width = `${Math.max(1, x1 - x0)}px`;
        marqueeBoxEl.style.height = `${Math.max(1, y1 - y0)}px`;

        const vpRect = cachedVpRect;
        const stageX0 = (x0 - vpRect.left - panX) / zoom;
        const stageY0 = (y0 - vpRect.top - panY) / zoom;
        const stageX1 = (x1 - vpRect.left - panX) / zoom;
        const stageY1 = (y1 - vpRect.top - panY) / zoom;

        const hits = new Set(canvasGesture.baseSelection);
        for (const box of laidOutBoxes.values()) {
          if (box.x <= stageX1 && box.x + box.w >= stageX0 && box.y <= stageY1 && box.y + box.h >= stageY0) {
            hits.add(box.node.id);
          }
        }
        if (hits.size > 0) {
          setSelection([...hits]);
        }
      }
    }, { signal });

    window.addEventListener('pointerup', () => {
      if (!canvasGesture) return;
      const gesture = canvasGesture;
      canvasGesture = null;
      if (gesture.holdTimer) window.clearTimeout(gesture.holdTimer);
      canvasViewport.classList.remove('is-panning', 'is-marquee');
      marqueeBoxEl.classList.add('hidden');

      if (gesture.mode === 'pan') {
        if (pendingPointerPan) {
          panX = pendingPointerPan.x;
          panY = pendingPointerPan.y;
          pendingPointerPan = null;
          commitGpuViewportFrame();
        }
        const idleMs = performance.now() - lastPanSampleTime;
        const speed = Math.hypot(panVelX, panVelY);
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduceMotion && idleMs < 64 && speed > 95) {
          const maxSpeed = 2400;
          if (speed > maxSpeed) {
            const scale = maxSpeed / speed;
            panVelX *= scale;
            panVelY *= scale;
          }
          isInertiaActive = true;
          requestViewportFrame();
        } else {
          panVelX = 0;
          panVelY = 0;
        }
      } else if (gesture.mode === 'pending' && activeMap && !gesture.additive) {
        // Quick click on empty canvas clears multi-selection cleanly
        setSelection([activeMap.root.id], activeMap.root.id);
      }
    }, { signal });

    // Interactive Minimap Navigation (click / scrub to pan canvas)
    let minimapRectCache: DOMRect | null = null;
    let minimapDragging = false;
    function panFromMinimapPointer(clientX: number, clientY: number, smoothJump: boolean) {
      if (!activeMap || !minimapRectCache || minimapScale <= 0) return;
      const localX = Math.max(0, Math.min(MINIMAP_W, clientX - minimapRectCache.left));
      const localY = Math.max(0, Math.min(MINIMAP_H, clientY - minimapRectCache.top));
      const stageTargetX = (localX - minimapOffX) / minimapScale;
      const stageTargetY = (localY - minimapOffY) / minimapScale;
      const vpW = cachedVpRect.width || 800;
      const vpH = cachedVpRect.height || 520;
      const nextPanX = vpW / 2 - stageTargetX * zoom;
      const nextPanY = vpH / 2 - stageTargetY * zoom;
      if (smoothJump) {
        animateViewportTo(nextPanX, nextPanY, zoom, true);
      } else {
        pendingPointerPan = { x: nextPanX, y: nextPanY };
        requestViewportFrame();
      }
    }

    minimapEl.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || !activeMap) return;
      e.preventDefault();
      e.stopPropagation();
      stopPanAnimation();
      refreshViewportMetrics();
      minimapRectCache = minimapEl.getBoundingClientRect();
      minimapDragging = true;
      panFromMinimapPointer(e.clientX, e.clientY, true);
    }, { signal });
    window.addEventListener('pointermove', (e) => {
      if (!minimapDragging) return;
      panFromMinimapPointer(e.clientX, e.clientY, false);
    }, { signal });
    window.addEventListener('pointerup', () => {
      if (!minimapDragging) return;
      minimapDragging = false;
      minimapRectCache = null;
    }, { signal });

    canvasPane.addEventListener('wheel', (e) => {
      if (wbModal.classList.contains('hidden')) return;
      e.preventDefault();
      e.stopPropagation();
      if (panAnimCleanupTimer) {
        stopPanAnimation();
      }
      isInertiaActive = false;
      panVelX = 0;
      panVelY = 0;

      if (!cachedVpRect.width) refreshViewportMetrics();
      const vpRect = cachedVpRect;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (e.ctrlKey || e.metaKey || Math.abs(e.deltaY) >= 4) {
        const clampedDelta = Math.max(-130, Math.min(130, e.deltaY));
        const stepFactor = Math.exp(-clampedDelta * 0.00175);
        const baseTarget = isWheelDamping ? wheelTargetZoom : zoom;
        const nextZoom = Math.max(0.32, Math.min(2.4, baseTarget * stepFactor));
        const mx = e.clientX - vpRect.left;
        const my = e.clientY - vpRect.top;

        if (reduceMotion) {
          panX = mx - ((mx - panX) / zoom) * nextZoom;
          panY = my - ((my - panY) / zoom) * nextZoom;
          zoom = nextZoom;
          applyViewportTransform();
        } else {
          wheelTargetZoom = nextZoom;
          wheelAnchorX = mx;
          wheelAnchorY = my;
          isWheelDamping = true;
          requestViewportFrame();
        }
      } else {
        const baseX = pendingPointerPan ? pendingPointerPan.x : panX;
        const baseY = pendingPointerPan ? pendingPointerPan.y : panY;
        pendingPointerPan = {
          x: baseX - e.deltaX,
          y: baseY - e.deltaY,
        };
        requestViewportFrame();
      }
    }, { passive: false, signal });

    document.getElementById('mm-zoom-in-btn')?.addEventListener('click', () => {
      refreshViewportMetrics();
      const vp = cachedVpRect;
      const nextZ = Math.min(2.4, zoom * 1.18);
      const nextPanX = vp.width / 2 - ((vp.width / 2 - panX) / zoom) * nextZ;
      const nextPanY = vp.height / 2 - ((vp.height / 2 - panY) / zoom) * nextZ;
      animateViewportTo(nextPanX, nextPanY, nextZ, true);
      canvasViewport.focus({ preventScroll: true });
    }, { signal });
    document.getElementById('mm-zoom-out-btn')?.addEventListener('click', () => {
      refreshViewportMetrics();
      const vp = cachedVpRect;
      const nextZ = Math.max(0.32, zoom / 1.18);
      const nextPanX = vp.width / 2 - ((vp.width / 2 - panX) / zoom) * nextZ;
      const nextPanY = vp.height / 2 - ((vp.height / 2 - panY) / zoom) * nextZ;
      animateViewportTo(nextPanX, nextPanY, nextZ, true);
      canvasViewport.focus({ preventScroll: true });
    }, { signal });
    document.getElementById('mm-fit-btn')?.addEventListener('click', () => {
      fitCanvasToViewport(true);
      canvasViewport.focus({ preventScroll: true });
    }, { signal });
    document.getElementById('mm-center-btn')?.addEventListener('click', () => {
      centerOnRoot();
      canvasViewport.focus({ preventScroll: true });
    }, { signal });
    document.getElementById('mm-expand-all-btn')?.addEventListener('click', () => {
      if (!activeMap) return;
      const snap = captureNodeRects();
      pushUndoSnapshot();
      const hasCollapsed = countNodes(activeMap.root).hidden > 0;
      activeMap.root = setAllCollapsed(activeMap.root, !hasCollapsed);
      renderCanvasAndOutline(true, snap, { animateLinks: true });
      scheduleWorkbenchSave();
      canvasViewport.focus({ preventScroll: true });
    }, { signal });

    function collectAllTreeIds(node: MindMapNode, out = new Set<string>()): Set<string> {
      out.add(node.id);
      for (const c of node.children || []) collectAllTreeIds(c, out);
      return out;
    }

    // ---------- Node Pill Actions + Keyboard Navigation ----------
    function runNodeAction(action: string, options?: { placeCaretAtEnd?: boolean }) {
      if (!activeMap) return;
      const targetId = selectedNodeId || activeMap.root.id;
      const activeIds = selectedNodeIds.size > 0 ? new Set(selectedNodeIds) : new Set([targetId]);

      if (action === 'child') {
        const snap = captureNodeRects();
        pushUndoSnapshot();
        const res = addChildNode(activeMap.root, targetId, '新分支节点');
        if (res) {
          activeMap.root = res.root;
          setSelection([res.createdId], res.createdId, false);
          renderCanvasAndOutline(false, snap, {
            anchorNodeId: targetId,
            animateLinks: true,
            enteredIds: new Set([res.createdId]),
          });
          scheduleWorkbenchSave();
          requestAnimationFrame(() => startInlineNodeEdit(res.createdId));
        }
      } else if (action === 'sibling') {
        const snap = captureNodeRects();
        pushUndoSnapshot();
        const res = addSiblingNode(activeMap.root, targetId, '同级节点');
        if (res) {
          activeMap.root = res.root;
          setSelection([res.createdId], res.createdId, false);
          const path = findNodePath(activeMap.root, targetId);
          const anchorId = path && path.length >= 2 ? path[path.length - 2].id : activeMap.root.id;
          renderCanvasAndOutline(false, snap, {
            anchorNodeId: anchorId,
            animateLinks: true,
            enteredIds: new Set([res.createdId]),
          });
          scheduleWorkbenchSave();
          requestAnimationFrame(() => startInlineNodeEdit(res.createdId));
        }
      } else if (action === 'edit') {
        startInlineNodeEdit(targetId, options);
      } else if (action === 'toggle') {
        const snap = captureNodeRects();
        if (activeIds.size > 1) {
          const toggleTargets = [...activeIds]
            .map((id) => findNodeById(activeMap!.root, id))
            .filter((n): n is MindMapNode => Boolean(n && n.children.length > 0));
          if (!toggleTargets.length) return;
          const shouldCollapse = toggleTargets.some((n) => !n.collapsed);
          pushUndoSnapshot();
          let nextRoot = activeMap.root;
          for (const n of toggleTargets) {
            if (n.id === activeMap.root.id) {
              nextRoot = setAllCollapsed(nextRoot, shouldCollapse);
            } else {
              nextRoot = updateNodeProps(nextRoot, n.id, { collapsed: shouldCollapse });
            }
          }
          activeMap.root = nextRoot;
          renderCanvasAndOutline(false, snap, { anchorNodeId: targetId, animateLinks: true });
          scheduleWorkbenchSave();
          canvasViewport.focus({ preventScroll: true });
          return;
        }
        const node = findNodeById(activeMap.root, targetId);
        if (!node || !node.children.length) return;
        pushUndoSnapshot();
        if (targetId === activeMap.root.id) {
          const anyCollapsed = activeMap.root.children.some((c) => c.collapsed);
          activeMap.root = setAllCollapsed(activeMap.root, !anyCollapsed);
          renderCanvasAndOutline(true, snap, { animateLinks: true });
        } else {
          activeMap.root = updateNodeProps(activeMap.root, targetId, { collapsed: !node.collapsed });
          renderCanvasAndOutline(false, snap, { anchorNodeId: targetId, animateLinks: true });
        }
        scheduleWorkbenchSave();
        canvasViewport.focus({ preventScroll: true });
      } else if (action === 'note') {
        openNodeNotePopover();
      } else if (action === 'up' || action === 'down') {
        const snap = captureNodeRects();
        const path = findNodePath(activeMap.root, targetId);
        const anchorId = path && path.length >= 2 ? path[path.length - 2].id : activeMap.root.id;
        pushUndoSnapshot();
        activeMap.root = moveSiblingNode(activeMap.root, targetId, action === 'up' ? -1 : 1);
        renderCanvasAndOutline(false, snap, { anchorNodeId: anchorId, animateLinks: true, skipExitClones: true });
        scheduleWorkbenchSave();
        canvasViewport.focus({ preventScroll: true });
      } else if (action === 'delete') {
        const deletableIds = new Set([...activeIds].filter((id) => id && id !== activeMap!.root.id));
        if (deletableIds.size === 0) return;
        const snap = captureNodeRects();
        const anchorId = (() => {
          if (deletableIds.size === 1) {
            const onlyId = [...deletableIds][0];
            const path = findNodePath(activeMap!.root, onlyId);
            return path && path.length >= 2 ? path[path.length - 2].id : activeMap!.root.id;
          }
          return activeMap!.root.id;
        })();

        pushUndoSnapshot();
        if (deletableIds.size === 1) {
          const onlyId = [...deletableIds][0];
          const res = removeNode(activeMap.root, onlyId);
          if (res) {
            activeMap.root = res.root;
            setSelection([res.nextFocusId], res.nextFocusId, false);
            renderCanvasAndOutline(false, snap, { anchorNodeId: anchorId, animateLinks: true });
            scheduleWorkbenchSave();
          }
        } else {
          const res = removeNodesBatch(activeMap.root, deletableIds);
          if (res) {
            activeMap.root = res.root;
            setSelection([res.nextFocusId], res.nextFocusId, false);
            renderCanvasAndOutline(false, snap, { anchorNodeId: anchorId, animateLinks: true });
            scheduleWorkbenchSave();
            showToast(`已删除 ${res.removedCount} 个选中节点`);
          }
        }
        canvasViewport.focus({ preventScroll: true });
      }
    }

    nodePill.querySelectorAll<HTMLElement>('[data-node-act]').forEach((btn) => {
      btn.addEventListener('click', () => runNodeAction(btn.dataset.nodeAct || ''), { signal });
    });
    nodePill.querySelectorAll<HTMLElement>('[data-node-color]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!activeMap || !selectedNodeId) return;
        const c = (btn.dataset.nodeColor || 'ink') as MindMapColor;
        const targetSet = selectedNodeIds.size > 0 ? selectedNodeIds : new Set([selectedNodeId]);
        pushUndoSnapshot();
        activeMap.root = targetSet.size > 1
          ? updateNodesColorBatch(activeMap.root, targetSet, c)
          : updateNodeProps(activeMap.root, selectedNodeId, { color: c });
        renderCanvasAndOutline(false, captureNodeRects(), { skipExitClones: true });
        scheduleWorkbenchSave();
        canvasViewport.focus({ preventScroll: true });
      }, { signal });
    });

    // Node Note Popover
    function openNodeNotePopover() {
      if (!activeMap || !selectedNodeId) return;
      const node = findNodeById(activeMap.root, selectedNodeId);
      if (!node) return;
      notePopTitle.textContent = `备注 · ${node.text}`;
      noteTextarea.value = node.note || '';
      notePreviewMode = false;
      noteTextarea.classList.remove('hidden');
      notePreview.classList.add('hidden');
      noteModeBtn.textContent = '预览';
      notePopover.classList.remove('hidden');
      requestAnimationFrame(() => noteTextarea.focus());
    }

    noteModeBtn.addEventListener('click', () => {
      notePreviewMode = !notePreviewMode;
      if (notePreviewMode) {
        notePreview.innerHTML = renderMarkdown(noteTextarea.value || '*暂无备注内容*', { heading: 'h' });
        notePreview.classList.remove('hidden');
        noteTextarea.classList.add('hidden');
        noteModeBtn.textContent = '编辑';
      } else {
        notePreview.classList.add('hidden');
        noteTextarea.classList.remove('hidden');
        noteModeBtn.textContent = '预览';
        noteTextarea.focus();
      }
    }, { signal });
    document.getElementById('mm-note-close-btn')?.addEventListener('click', () => notePopover.classList.add('hidden'), { signal });
    noteTextarea.addEventListener('input', () => {
      if (!activeMap || !selectedNodeId) return;
      activeMap.root = updateNodeProps(activeMap.root, selectedNodeId, { note: noteTextarea.value });
      scheduleWorkbenchSave();
      syncNodePillState();
      renderCanvas(undefined, false);
    }, { signal });

    // ---------- Bidirectional Outline Input (Synced Add/Delete/FLIP Animations) ----------
    outlineTextarea.addEventListener('input', () => {
      if (suppressOutlineInput || !activeMap) return;
      if (outlineSyncTimer) window.clearTimeout(outlineSyncTimer);
      outlineSyncTimer = window.setTimeout(() => {
        if (!activeMap) return;
        const prevBoxes = captureNodeRects();
        const prevIds = collectAllTreeIds(activeMap.root);
        const nextRoot = markdownToMindmap(outlineTextarea.value, activeMap.root);
        const nextIds = collectAllTreeIds(nextRoot);
        const enteredIds = new Set([...nextIds].filter((id) => !prevIds.has(id)));

        pushUndoSnapshot();
        activeMap.root = nextRoot;
        if (nextRoot.text && nextRoot.text !== activeMap.title) {
          activeMap.title = nextRoot.text;
          wbTitleInput.value = nextRoot.text;
        }
        const surviving = [...selectedNodeIds].filter((id) => findNodeById(activeMap!.root, id));
        setSelection(surviving.length ? surviving : [activeMap.root.id], undefined, false);

        if (viewMode !== 'outline') {
          suppressOutlineInput = true;
          renderCanvas(prevBoxes, false, {
            anchorNodeId: activeMap.root.id,
            animateLinks: true,
            enteredIds,
          });
          suppressOutlineInput = false;
        }
        scheduleWorkbenchSave();
      }, 200);
    }, { signal });

    // ---------- Split Resizer ----------
    let splitDrag: { startX: number; origW: number; bodyW: number } | null = null;
    let splitResizeRaf = 0;
    let splitPendingClientX = 0;
    splitResizer.addEventListener('pointerdown', (e) => {
      splitDrag = {
        startX: e.clientX,
        origW: outlinePane.getBoundingClientRect().width,
        bodyW: wbBody.getBoundingClientRect().width,
      };
      splitPendingClientX = e.clientX;
      splitResizer.classList.add('is-dragging');
    }, { signal });
    window.addEventListener('pointermove', (e) => {
      if (!splitDrag) return;
      splitPendingClientX = e.clientX;
      if (splitResizeRaf) return;
      splitResizeRaf = requestAnimationFrame(() => {
        splitResizeRaf = 0;
        if (!splitDrag) return;
        const nextW = Math.max(220, Math.min(splitDrag.bodyW - 280, splitDrag.origW + (splitDrag.startX - splitPendingClientX)));
        outlinePane.style.width = `${nextW}px`;
      });
    }, { signal });
    window.addEventListener('pointerup', () => {
      if (!splitDrag) return;
      if (splitResizeRaf) {
        cancelAnimationFrame(splitResizeRaf);
        splitResizeRaf = 0;
      }
      splitDrag = null;
      splitResizer.classList.remove('is-dragging');
    }, { signal });

    // ---------- Workbench Top Controls & Export ----------
    function setWorkbenchViewMode(mode: 'canvas' | 'split' | 'outline', immediateGlider = false) {
      const prevMode = viewMode;
      if (prevMode !== 'outline' && mode === 'outline' && activeMap) {
        outlinePendingBaseline = {
          boxes: captureNodeRects(),
          rootIds: collectAllTreeIds(activeMap.root),
        };
      }
      viewMode = mode;
      wbBody.dataset.viewMode = mode;
      document.querySelectorAll<HTMLElement>('[data-wb-mode]').forEach((btn) => {
        btn.classList.toggle('is-active', btn.dataset.wbMode === mode);
      });
      syncSegGlider(viewModeSwitch, immediateGlider);
      if (mode !== 'canvas') {
        suppressOutlineInput = true;
        outlineTextarea.value = activeMap ? mindmapToMarkdown(activeMap.root) : '';
        suppressOutlineInput = false;
      }
      if (mode !== 'outline') {
        requestAnimationFrame(() => {
          if (prevMode === 'outline' && activeMap) {
            const baseline = outlinePendingBaseline;
            outlinePendingBaseline = null;
            if (baseline) {
              const curIds = collectAllTreeIds(activeMap.root);
              const enteredIds = new Set([...curIds].filter((id) => !baseline.rootIds.has(id)));
              renderCanvas(baseline.boxes, true, { animateLinks: true, enteredIds });
            } else {
              renderCanvas(undefined, true);
            }
          } else {
            fitCanvasToViewport(!immediateGlider);
          }
        });
      }
    }

    document.querySelectorAll<HTMLElement>('[data-wb-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        setWorkbenchViewMode((btn.dataset.wbMode || 'canvas') as 'canvas' | 'split' | 'outline');
      }, { signal });
    });

    document.querySelectorAll<HTMLElement>('[data-wb-layout]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!activeMap) return;
        const nextLayout = normalizeLayout(btn.dataset.wbLayout);
        const snap = captureNodeRects();
        activeMap.layout = nextLayout;
        document.querySelectorAll<HTMLElement>('[data-wb-layout]').forEach((b) => {
          b.classList.toggle('is-active', b.dataset.wbLayout === nextLayout);
        });
        syncSegGlider(layoutSwitch, false);
        renderCanvasAndOutline(true, snap, { animateLinks: true, skipExitClones: true });
        scheduleWorkbenchSave();
      }, { signal });
    });

    const segResizeObserver = typeof ResizeObserver !== 'undefined'
      ? new ResizeObserver(() => syncAllSegGliders(true))
      : null;
    if (segResizeObserver) {
      segResizeObserver.observe(viewModeSwitch);
      segResizeObserver.observe(layoutSwitch);
      signal.addEventListener('abort', () => segResizeObserver.disconnect(), { once: true });
    }

    wbTitleInput.addEventListener('input', () => {
      if (!activeMap) return;
      const t = wbTitleInput.value.trim();
      activeMap.title = t || activeMap.root.text;
      if (t) {
        activeMap.root = updateNodeProps(activeMap.root, activeMap.root.id, { text: t });
        renderCanvasAndOutline(false);
      }
      scheduleWorkbenchSave();
    }, { signal });
    wbTagsInput.addEventListener('input', () => {
      if (!activeMap) return;
      activeMap.tags = wbTagsInput.value
        .split(/[,，]/)
        .map((s) => s.trim())
        .filter(Boolean)
        .slice(0, 12);
      scheduleWorkbenchSave();
    }, { signal });

    function syncOpenPostLink() {
      if (activeMap?.postSlug) {
        wbOpenPostLink.href = `/posts/${activeMap.postSlug}/`;
        wbOpenPostLink.classList.remove('hidden');
      } else {
        wbOpenPostLink.classList.add('hidden');
      }
    }

    document.getElementById('mm-wb-save-btn')?.addEventListener('click', () => {
      scheduleWorkbenchSave(true);
      showToast('导图已保存');
    }, { signal });

    document.getElementById('mm-wb-back-btn')?.addEventListener('click', closeWorkbench, { signal });
    document.getElementById('mm-wb-delete-btn')?.addEventListener('click', async () => {
      if (!activeMap) return;
      const target = activeMap;
      const ok = await askConfirm(`确认删除「${target.title}」？`, '删除后将无法恢复，同步后会从云端删除。');
      if (!ok) return;
      deleteMindMap(target.id);
      activeMap = null;
      closeOverlay(wbModal, () => {
        refreshDataFromStorage();
        renderCards(false);
        showToast('已删除思维导图');
      });
    }, { signal });

    // Standalone SVG + 2x PNG + Markdown + JSON Export
    function buildExportSvgDocument(): { svgStr: string; width: number; height: number } | null {
      if (!activeMap) return null;
      const cs = getComputedStyle(document.documentElement);
      const bg = cs.getPropertyValue('--bg-base').trim() || '#faf8f4';
      const elev = cs.getPropertyValue('--bg-elev').trim() || '#ffffff';
      const inkStrong = cs.getPropertyValue('--ink-strong').trim() || '#141517';
      const textStrong = cs.getPropertyValue('--text-strong').trim() || '#141517';
      const bgBase = cs.getPropertyValue('--bg-base').trim() || '#faf8f4';
      const rule = cs.getPropertyValue('--rule-strong').trim() || '#d4d0c8';
      const fontSans = cs.getPropertyValue('--font-sans').trim() || 'system-ui, sans-serif';

      const parts: string[] = [
        `<rect x="0" y="0" width="${stageW}" height="${stageH}" fill="${bg}" rx="12"/>`,
      ];
      for (const box of laidOutBoxes.values()) {
        if (!box.parentId) continue;
        const pBox = laidOutBoxes.get(box.parentId);
        if (!pBox) continue;
        const d = buildLinkPath(pBox, box);
        const sw = computeInkBranchStrokeWidth(box.depth).toFixed(2);
        const so = computeInkBranchOpacity(box.depth).toFixed(2);
        parts.push(`<path d="${d}" fill="none" stroke="${box.color}" stroke-opacity="${so}" stroke-width="${sw}" stroke-linecap="round"/>`);
      }
      for (const box of laidOutBoxes.values()) {
        const isRoot = box.depth === 0;
        const fill = isRoot ? inkStrong : elev;
        const stroke = isRoot ? inkStrong : box.color || rule;
        const txtFill = isRoot ? bgBase : textStrong;
        parts.push(
          `<rect x="${box.x}" y="${box.y}" width="${box.w}" height="${box.h}" rx="${isRoot ? 13 : 10}" fill="${fill}" stroke="${stroke}" stroke-width="1.5"/>`
        );
        parts.push(
          `<text x="${box.x + box.w / 2}" y="${box.y + box.h / 2}" text-anchor="middle" dominant-baseline="central" font-family="${escapeHtml(fontSans)}" font-size="${isRoot ? 15 : 13.5}" font-weight="${isRoot ? 700 : 500}" fill="${txtFill}">${escapeHtml(box.node.text)}</text>`
        );
      }

      const svgStr = `<?xml version="1.0" encoding="UTF-8"?>\n<svg xmlns="http://www.w3.org/2000/svg" width="${stageW}" height="${stageH}" viewBox="0 0 ${stageW} ${stageH}">${parts.join('')}</svg>`;
      return { svgStr, width: stageW, height: stageH };
    }

    function downloadBlob(blob: Blob, filename: string) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    setExportMenuOpen(false);
    exportTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      setExportMenuOpen(!exportMenu.classList.contains('is-open'));
    }, { signal });
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      for (const ctrl of dropdownControllers) {
        if (!ctrl.el.contains(target) && ctrl.isOpen()) ctrl.close();
      }
    }, { signal });

    exportMenu.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!activeMap) return;
        const fmt = btn.dataset.export;
        setExportMenuOpen(false);
        const safeName = (activeMap.title || 'mindmap').replace(/[\\/:*?"<>|]/g, '_');

        if (fmt === 'md') {
          const md = exportMindMapMarkdown(activeMap);
          downloadBlob(new Blob([md], { type: 'text/markdown;charset=utf-8' }), `${safeName}.md`);
          showToast('已导出 Markdown 大纲');
        } else if (fmt === 'json') {
          const json = JSON.stringify(activeMap, null, 2);
          downloadBlob(new Blob([json], { type: 'application/json;charset=utf-8' }), `${safeName}.json`);
          showToast('已导出 JSON 数据');
        } else if (fmt === 'svg') {
          const doc = buildExportSvgDocument();
          if (!doc) return;
          downloadBlob(new Blob([doc.svgStr], { type: 'image/svg+xml;charset=utf-8' }), `${safeName}.svg`);
          showToast('已导出 SVG 矢量导图');
        } else if (fmt === 'png') {
          const doc = buildExportSvgDocument();
          if (!doc) return;
          const img = new Image();
          const svgUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(doc.svgStr);
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = doc.width * 2;
            canvas.height = doc.height * 2;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;
            ctx.scale(2, 2);
            ctx.drawImage(img, 0, 0);
            canvas.toBlob((pngBlob) => {
              if (pngBlob) {
                downloadBlob(pngBlob, `${safeName}.png`);
                showToast('已导出 2x PNG 高清图');
              }
            }, 'image/png');
          };
          img.src = svgUrl;
        }
      }, { signal });
    });

    function openWorkbench(mapId: string, isFresh = false) {
      const record = mapsList.find((m) => m.id === mapId) || loadActiveMindMaps().find((m) => m.id === mapId);
      if (!record) return;
      stopPanAnimation();
      nodeDomMap.clear();
      linkDomMap.clear();
      nodesLayer.innerHTML = '';
      linksSvg.innerHTML = '';
      exitLayer.innerHTML = '';
      outlinePendingBaseline = null;

      activeMap = { ...record, root: cloneNode(record.root), tags: [...(record.tags || [])] };
      wbModal.dataset.activeMapId = activeMap.id;
      selectedNodeId = activeMap.root.id;
      selectedNodeIds = new Set([activeMap.root.id]);
      editingNodeId = null;
      undoStack = [];
      redoStack = [];
      wbUndoBtn.disabled = true;
      wbRedoBtn.disabled = true;
      notePopover.classList.add('hidden');

      wbTitleInput.value = activeMap.title;
      wbTagsInput.value = activeMap.tags.join(', ');
      wbColorCSelect.setValue(normalizeCardColor(activeMap.color));
      syncWorkbenchSelects();
      wbCatCSelect.setValue(categories.includes(activeMap.category) ? activeMap.category : categories[0]);
      wbPostCSelect.setValue(activeMap.postSlug || '');
      syncOpenPostLink();

      document.querySelectorAll<HTMLElement>('[data-wb-layout]').forEach((b) => {
        b.classList.toggle('is-active', b.dataset.wbLayout === activeMap!.layout);
      });
      setWorkbenchViewMode('canvas', true);
      markSaveState(false);

      openOverlay(wbModal, canvasViewport);
      requestAnimationFrame(() => {
        refreshViewportMetrics();
        syncAllSegGliders(true);
        renderCanvasAndOutline(true);
        if (isFresh && activeMap?.root.children[0]) {
          setSelection([activeMap.root.id], activeMap.root.id);
        }
      });
    }

    function closeWorkbench() {
      stopPanAnimation();
      if (linkMorphRafId !== null) {
        cancelAnimationFrame(linkMorphRafId);
        linkMorphRafId = null;
      }
      if (activeMap) scheduleWorkbenchSave(true);
      notePopover.classList.add('hidden');
      closeAllDropdowns();
      outlinePendingBaseline = null;
      exitLayer.innerHTML = '';
      minimapSvg.innerHTML = '';
      delete wbModal.dataset.activeMapId;
      activeMap = null;
      closeOverlay(wbModal, () => {
        refreshDataFromStorage();
        renderCards(false);
      });
    }

    // ---------- Global Workbench Keyboard Shortcuts ----------
    document.addEventListener('keydown', (e) => {
      if (wbModal.classList.contains('hidden')) {
        if (e.key === 'Escape') {
          if (hasOpenDropdown()) closeAllDropdowns();
          else if (!catModal.classList.contains('hidden')) closeOverlay(catModal);
          else if (!genModal.classList.contains('hidden')) closeOverlay(genModal);
          else if (!confirmModal.classList.contains('hidden')) confirmCancelBtn.click();
        }
        return;
      }
      if (editingNodeId) return;

      const activeTag = (document.activeElement?.tagName || '').toLowerCase();
      const inInput = activeTag === 'input' || activeTag === 'textarea' || activeTag === 'select';

      if (e.key === 'Escape') {
        if (hasOpenDropdown()) {
          closeAllDropdowns();
        } else if (!notePopover.classList.contains('hidden')) {
          notePopover.classList.add('hidden');
        } else if (!confirmModal.classList.contains('hidden')) {
          confirmCancelBtn.click();
        } else {
          closeWorkbench();
        }
        return;
      }

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
        e.preventDefault();
        scheduleWorkbenchSave(true);
        showToast('导图已保存');
        return;
      }

      if (inInput) return;

      const activeEl = document.activeElement as HTMLElement | null;
      if (
        hasOpenDropdown() ||
        activeEl?.closest('.mm-cselect, #mm-note-popover, #mm-confirm-modal, #mm-cat-modal, #mm-gen-modal')
      ) {
        return;
      }

      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'a' && activeMap) {
        e.preventDefault();
        setSelection([...laidOutBoxes.keys()], selectedNodeId || activeMap.root.id);
        return;
      }
      if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        performUndo();
        return;
      }
      if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === 'y' || (e.shiftKey && e.key.toLowerCase() === 'z'))) {
        e.preventDefault();
        performRedo();
        return;
      }
      if ((e.ctrlKey || e.metaKey) && e.key === '0') {
        e.preventDefault();
        fitCanvasToViewport(true);
        return;
      }
      if (e.key === 'Tab') {
        e.preventDefault();
        runNodeAction('child');
      } else if (e.key === 'Enter') {
        e.preventDefault();
        runNodeAction('sibling');
      } else if (e.key === 'F2') {
        e.preventDefault();
        runNodeAction('edit');
      } else if ((e.key === ' ' || e.code === 'Space') && !e.ctrlKey && !e.metaKey && !e.altKey) {
        if (viewMode === 'outline') return;
        e.preventDefault();
        if (!e.repeat) {
          runNodeAction('edit', { placeCaretAtEnd: true });
        }
      } else if (e.key === 'Delete' || e.key === 'Backspace') {
        e.preventDefault();
        runNodeAction('delete');
      } else if (e.key === '/' || ((e.ctrlKey || e.metaKey) && e.code === 'Space')) {
        e.preventDefault();
        runNodeAction('toggle');
      } else if (e.altKey && e.key === 'ArrowUp') {
        e.preventDefault();
        runNodeAction('up');
      } else if (e.altKey && e.key === 'ArrowDown') {
        e.preventDefault();
        runNodeAction('down');
      } else if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key) && activeMap) {
        e.preventDefault();
        const cur = selectedNodeId ? findNodeById(activeMap.root, selectedNodeId) : activeMap.root;
        if (!cur) return;
        const path = findNodePath(activeMap.root, cur.id) || [activeMap.root];
        let nextNode: MindMapNode | null = null;
        if (e.key === 'ArrowRight') {
          if (!cur.collapsed && cur.children.length > 0) nextNode = cur.children[0];
          else if (path.length >= 2) nextNode = path[path.length - 2];
        } else if (e.key === 'ArrowLeft') {
          if (path.length >= 2) nextNode = path[path.length - 2];
        } else if ((e.key === 'ArrowUp' || e.key === 'ArrowDown') && path.length >= 2) {
          const p = path[path.length - 2];
          const idx = p.children.findIndex((c) => c.id === cur.id);
          const nextIdx = idx + (e.key === 'ArrowUp' ? -1 : 1);
          if (nextIdx >= 0 && nextIdx < p.children.length) nextNode = p.children[nextIdx];
        }
        if (nextNode) {
          setSelection([nextNode.id], nextNode.id);
        }
      }
    }, { signal });

    // ---------- Manual Cloud Sync Button & Cross-Tab Listeners ----------
    document.getElementById('mm-sync-btn')?.addEventListener('click', async () => {
      const icon = document.getElementById('mm-sync-icon');
      const txt = document.getElementById('mm-sync-text');
      icon?.classList.add('animate-spin');
      if (txt) txt.textContent = '同步中…';
      try {
        const res = await syncMindMapsNow();
        if (res.ok) {
          refreshDataFromStorage();
          renderCards(false);
          showToast(`同步成功（推 ${res.pushedCount} / 拉 ${res.pulledCount}）`);
        } else {
          showToast(
            res.reason === 'need-login'
              ? '请先在「Account」登录开启多设备云端同步'
              : res.reason === 'busy'
                ? '同步正在进行中…'
                : '同步失败，请稍后重试'
          );
        }
      } catch {
        showToast('同步请求异常');
      } finally {
        icon?.classList.remove('animate-spin');
        if (txt) txt.textContent = '同步';
      }
    }, { signal });

    window.addEventListener('mindmaps:synced', () => {
      if (wbModal.classList.contains('hidden')) {
        refreshDataFromStorage();
        renderCards(false);
      }
    }, { signal });

    document.addEventListener('mindmaps:changed', () => {
      if (isSelfDeleting || !wbModal.classList.contains('hidden')) return;
      refreshDataFromStorage();
      renderCards(false);
    }, { signal });

    window.addEventListener('storage', (e) => {
      if (e.key === MINDMAP_STORAGE_KEY || e.key === MINDMAP_CATEGORIES_KEY) {
        refreshDataFromStorage();
        renderCards(false);
      }
    }, { signal });

    let lastCols = getColumnCount();
    window.addEventListener('resize', () => {
      updateSubtabsGlider();
      updateStatsStripActive();
      const nextCols = getColumnCount();
      if (nextCols !== lastCols) {
        lastCols = nextCols;
        renderCards(false);
      }
    }, { signal });

    window.addEventListener('app:flush-drafts', () => {
      if (!wbModal.classList.contains('hidden') && activeMap) {
        wbModal.querySelector<HTMLInputElement>('.mm-node-edit-input')?.blur();
        scheduleWorkbenchSave(true);
      }
    }, { signal });

    // ---------- Initial Mount & Page Enter Coordination ----------
    refreshDataFromStorage();
    renderCards(false, true);
    container.removeAttribute('data-enter-hold');

    try {
      const reopenMapId = sessionStorage.getItem('areSet_reopen_mindmap_id');
      if (reopenMapId) {
        sessionStorage.removeItem('areSet_reopen_mindmap_id');
        requestAnimationFrame(() => openWorkbench(reopenMapId, false));
      }
    } catch {}

    const releaseEnterIfNeeded = () => {
      const isIntroActive = Boolean(
        document.querySelector('[data-site-intro]') &&
          (document.documentElement.classList.contains('site-intro-active') || (window as any).__siteIntroPending)
      );
      if (
        !isIntroActive &&
        document.documentElement.classList.contains('js-enter') &&
        !document.querySelector('main [data-enter].is-entering, main [data-enter].is-entered')
      ) {
        (window as any).__releasePageEnter?.();
      }
    };
    releaseEnterIfNeeded();

    const cleanupMindmapPage = () => {
      controller.abort();
      if (cardFilterTimeline) {
        cardFilterTimeline.kill();
        cardFilterTimeline = null;
      }
      stopPanAnimation();
      if (linkMorphRafId !== null) {
        cancelAnimationFrame(linkMorphRafId);
        linkMorphRafId = null;
      }
      if (dragState?.rafId) {
        cancelAnimationFrame(dragState.rafId);
        dragState = null;
      }
      if (canvasGesture?.holdTimer) {
        window.clearTimeout(canvasGesture.holdTimer);
        canvasGesture = null;
      }
      if (holdPulseTimer) window.clearTimeout(holdPulseTimer);
      modalCloseTimers.forEach((t) => window.clearTimeout(t));
      if (toastTimer) window.clearTimeout(toastTimer);
      if (searchDebounce) window.clearTimeout(searchDebounce);
      if (autosaveTimer) window.clearTimeout(autosaveTimer);
      if (outlineSyncTimer) window.clearTimeout(outlineSyncTimer);
      if (splitResizeRaf) cancelAnimationFrame(splitResizeRaf);
      document.body.classList.remove('notes-modal-open');
      (window as any).lenis?.start?.();
      delete container.dataset.mmInit;
      (window as any)[CLEANUP_KEY] = undefined;
      (window as any)[LEGACY_CLEANUP_KEY] = undefined;
    };
    (window as any)[CLEANUP_KEY] = cleanupMindmapPage;
    (window as any)[LEGACY_CLEANUP_KEY] = cleanupMindmapPage;
    document.addEventListener('astro:before-swap', () => {
      (window as any)[CLEANUP_KEY]?.();
    }, { signal });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMindmapPage, { once: true });
  } else {
    initMindmapPage();
  }

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', () => {
      initMindmapPage();
    });
    (window as any)[LISTENER_KEY] = true;
  }
</script>
