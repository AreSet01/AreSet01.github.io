                <svg class="mm-cselect-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div id="mm-wb-cat-panel" class="mm-cselect-panel article-popover is-closed" role="listbox" aria-label="导图分类列表" tabindex="-1"></div>
            </div>

            <div class="mm-cselect" id="mm-wb-color-wrap">
              <button type="button" id="mm-wb-color-trigger" class="mm-cselect-trigger mm-cselect-color-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="选择卡片色标">
                <span class="mm-cselect-dot" style="--dot-color:#42a5f5;" aria-hidden="true"></span>
                <span class="mm-cselect-label truncate">靛青</span>
                <svg class="mm-cselect-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div id="mm-wb-color-panel" class="mm-cselect-panel article-popover is-closed" role="listbox" aria-label="卡片色标列表" tabindex="-1"></div>
            </div>

            <div class="mm-cselect mm-cselect-post" id="mm-wb-post-wrap">
              <button type="button" id="mm-wb-post-trigger" class="mm-cselect-trigger mm-cselect-post-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="关联文章">
                <span class="mm-cselect-label truncate">无关联文章</span>
                <svg class="mm-cselect-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div id="mm-wb-post-panel" class="mm-cselect-panel mm-cselect-post-panel article-popover is-closed" role="listbox" aria-label="关联文章列表" tabindex="-1">
                <div class="mm-cselect-search-wrap">
                  <svg class="mm-cselect-search-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <input type="text" id="mm-wb-post-search" class="mm-cselect-search" placeholder="搜索文章标题或分类..." aria-label="搜索关联文章" />
                </div>
                <div class="mm-cselect-scroll" id="mm-wb-post-list" data-lenis-prevent></div>
              </div>
            </div>

            <input
              type="text"
              id="mm-wb-tags-input"
