---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="账号与同步 - 梦付千秋">
  <Header />
  <main id="main-content" tabindex="-1" class="container-medium flex-1 pt-6 pb-16 lg:pt-8 outline-none" style="position: relative;">
    <section class="account-shell" data-account-shell>
      <header class="account-head">
        <p class="account-kicker">Account / Sync</p>
        <h1 class="account-title">账号与数据同步</h1>
        <p class="account-desc">登录后，划词笔记、备注、「存入笔记」的墨问回答、思维导图与「夹签续读」阅读进度都会跨设备同步。未登录时仅保存在本机。</p>
      </header>

      <div id="authView" class="account-card">
        <div class="account-tabs" id="accountTabs" role="tablist" aria-label="登录或注册">
          <span class="account-tab-glider" id="accountTabGlider" aria-hidden="true"></span>
          <button type="button" id="tabLogin" class="account-tab is-active" role="tab" aria-selected="true">登录</button>
          <button type="button" id="tabRegister" class="account-tab" role="tab" aria-selected="false">用邀请码注册</button>
        </div>

        <p id="authServiceHint" class="account-service-hint" role="status" hidden></p>

        <form id="loginForm" class="account-form" autocomplete="on">
          <label class="account-label" for="loginUsername">用户名</label>
          <input id="loginUsername" name="username" class="account-input" autocomplete="username" maxlength="24" required />
          <label class="account-label" for="loginPassword">密码</label>
          <input id="loginPassword" name="password" type="password" class="account-input" autocomplete="current-password" maxlength="128" required />
          <button type="submit" class="account-submit" id="loginSubmit">登录</button>
        </form>

        <form id="registerForm" class="account-form" autocomplete="off" hidden>
          <label class="account-label" for="registerInvite">邀请码</label>
          <input id="registerInvite" name="inviteCode" class="account-input account-input--mono" maxlength="16" placeholder="向站主要一个邀请码" required />
          <label class="account-label" for="registerUsername">用户名</label>
          <input id="registerUsername" name="username" class="account-input" autocomplete="username" maxlength="24" placeholder="3–24 位字母、数字、_ 或 -" required />
          <label class="account-label" for="registerPassword">密码</label>
          <input id="registerPassword" name="password" type="password" class="account-input" autocomplete="new-password" maxlength="128" placeholder="至少 8 位" required />
          <label class="account-label" for="registerConfirm">确认密码</label>
          <input id="registerConfirm" name="confirm" type="password" class="account-input" autocomplete="new-password" maxlength="128" required />
          <button type="submit" class="account-submit" id="registerSubmit">注册并登录</button>
        </form>

        <p id="authMessage" class="account-message" role="status" hidden></p>
      </div>

      <div id="profileView" class="account-card" hidden>
        <div class="account-profile-head">
          <div class="account-profile-identity">
            <div>
              <p class="account-kicker">Signed in · 已登录 · 云端就绪</p>
              <p class="account-username" id="profileUsername">—</p>
            </div>
            <!-- 云端核验圆润胶囊徽标 + 双圈单色水纹涟漪 -->
            <div class="account-status-capsule-wrap" id="accountStatusWrap" aria-hidden="true">
              <span class="account-ink-ripple ring-a"></span>
              <span class="account-ink-ripple ring-b"></span>
              <span class="account-status-capsule" id="accountStatusBadge">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
                  <path d="m9.5 13.5 1.8 1.8 3.7-3.8"/>
                </svg>
                <span id="accountStatusLabel">同步就绪</span>
              </span>
            </div>
          </div>
          <button type="button" id="logoutBtn" class="account-ghost-btn">退出登录</button>
        </div>

        <!-- 多设备笔记同步卡片 -->
        <div class="account-sync-card">
          <div class="account-sync-card-head">
            <div class="account-sync-header-left">
              <span class="account-label" style="margin: 0;">多设备笔记与导图同步</span>
              <div class="account-sync-badge" id="syncBadge" data-state="checking">
                <span class="sync-badge-dot"></span>
                <span id="syncBadgeText">正在校验…</span>
              </div>
            </div>
            <button type="button" id="checkSyncBtn" class="account-check-btn" title="校验本地是否为最新同步状态">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>校验最新</span>
            </button>
          </div>

          <div class="account-sync-status-body">
            <p class="account-sync-status" id="syncStatus">正在检查本地与云端数据…</p>
            <p class="account-sync-detail" id="syncDetail">本地版本: — · 云端版本: — · 待提交: 0 · 待拉取: 0</p>
          </div>

          <!-- 云墨流转同步桥：本机砚台 ⇄ 云端藏书阁 -->
          <div class="sync-ink-bridge" id="syncInkBridge" data-flow="checking" aria-hidden="true">
            <div class="bridge-node is-local">
              <span class="bridge-node-title">本机砚台</span>
              <span class="bridge-node-meta" id="bridgeLocalMeta">待提交 0</span>
            </div>
            <div class="bridge-conduit">
              <svg class="bridge-svg" viewBox="0 0 220 36" preserveAspectRatio="none">
                <path class="bridge-track-bg" d="M 10 13 C 75 3, 145 23, 210 13" fill="none" />
                <path class="bridge-track-bg" d="M 210 23 C 145 33, 75 13, 10 23" fill="none" />
                <path class="bridge-stream stream-push" pathLength="1" d="M 10 13 C 75 3, 145 23, 210 13" fill="none" />
                <path class="bridge-stream stream-pull" pathLength="1" d="M 210 23 C 145 33, 75 13, 10 23" fill="none" />
              </svg>
              <span class="ink-flow-droplet droplet-push"></span>
              <span class="ink-flow-droplet droplet-pull"></span>
              <span class="bridge-confluence-pill" id="bridgeConfluenceLabel">云墨同频</span>
            </div>
            <div class="bridge-node is-cloud">
              <span class="bridge-node-title">云端藏书阁</span>
              <span class="bridge-node-meta" id="bridgeCloudMeta">待拉取 0</span>
            </div>
          </div>

          <!-- 两步同步核心操作 -->
          <div class="account-sync-step-grid">
            <!-- 步骤 1：提交同步 (Push) -->
            <button type="button" id="pushSyncBtn" class="account-step-btn account-push-btn">
              <div class="step-btn-content">
                <div class="step-btn-top">
                  <div class="step-btn-icon push-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 19V5M5 12l7-7 7 7"/>
                    </svg>
                  </div>
                  <span class="step-btn-name">1. 提交同步 (Push)</span>
                  <span class="step-btn-badge" id="pushPendingTag" hidden>0 条待提交</span>
                </div>
                <p class="step-btn-desc">将本地新增/修改笔记与删除标记提交至云端</p>
              </div>
            </button>

            <!-- 步骤 2：拉取同步 (Pull) -->
            <button type="button" id="pullSyncBtn" class="account-step-btn account-pull-btn">
              <div class="step-btn-content">
                <div class="step-btn-top">
                  <div class="step-btn-icon pull-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12l7 7 7-7"/>
                    </svg>
                  </div>
                  <span class="step-btn-name">2. 拉取同步 (Pull)</span>
                  <span class="step-btn-badge" id="pullIncomingTag" hidden>0 条新内容</span>
                </div>
                <p class="step-btn-desc">从云端拉取跨设备最新笔记并合并到本地</p>
              </div>
            </button>
          </div>

          <div class="account-sync-footer">
            <button type="button" id="syncNowBtn" class="account-subtle-sync-btn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              <span>一键双向同步</span>
            </button>
            <span id="syncActionFeedback" class="account-sync-feedback" role="status" aria-live="polite"></span>
          </div>
        </div>

        <div class="account-actions">
          <button type="button" id="exportNotesBtn" class="account-ghost-btn">导出全部笔记 (JSON)</button>
          <button type="button" id="exportMindmapsBtn" class="account-ghost-btn">导出全部导图 (JSON)</button>
          <a href="/" class="account-ghost-btn account-link-btn">返回首页</a>
        </div>

        <p class="account-hint">提示：文章里的「笔记」抽屉与「MindMap」工作台均可离线编辑，登录后自动与云端增量合并。</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { initNotesSync } from '../utils/notesSync';
  import { initMindmapSync } from '../utils/mindmapSync';
  import { initReadingSync } from '../utils/readingSync';

  initNotesSync();
  initMindmapSync();
  initReadingSync();

  const CLEANUP_KEY = '__areSetAccountCleanup__';
  const LISTENER_KEY = '__areSetAccountPageBound__';

  function initAccountPage() {
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') previousCleanup();

    const shell = document.querySelector<HTMLElement>('[data-account-shell]');
    if (!shell) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    const trackedTimers = new Set<number>();

    function scheduleTimer(fn: () => void, ms: number): number {
      const id = window.setTimeout(() => {
        trackedTimers.delete(id);
        fn();
      }, ms);
      trackedTimers.add(id);
      return id;
    }

    const $ = (id: string) => document.getElementById(id) as HTMLElement | null;

    const authView = $('authView');
    const profileView = $('profileView');
    const authMessage = $('authMessage') as HTMLParagraphElement | null;
    const accountTabs = $('accountTabs');
    const accountTabGlider = $('accountTabGlider');
    const tabLogin = $('tabLogin');
    const tabRegister = $('tabRegister');
    const loginForm = $('loginForm') as HTMLFormElement | null;
    const registerForm = $('registerForm') as HTMLFormElement | null;
    const profileUsername = $('profileUsername');
    const statusWrap = $('accountStatusWrap');
    const statusLabelEl = $('accountStatusLabel');
    const syncInkBridge = $('syncInkBridge');
    const bridgeLocalMeta = $('bridgeLocalMeta');
    const bridgeCloudMeta = $('bridgeCloudMeta');
    const bridgeConfluenceLabel = $('bridgeConfluenceLabel');
    const syncStatus = $('syncStatus');
    const serviceHint = $('authServiceHint') as HTMLParagraphElement | null;

    function syncAccountTabGlider(immediate = false) {
      if (!accountTabs || !accountTabGlider) return;
      const activeBtn = accountTabs.querySelector<HTMLElement>('.account-tab.is-active');
      if (!activeBtn || !activeBtn.offsetWidth) return;
      const sx = Math.max(0.05, activeBtn.offsetWidth / 100);
      accountTabGlider.style.setProperty('--pill-rx', `${(7 / sx).toFixed(2)}px`);
      const nextTransform = `translate3d(${activeBtn.offsetLeft}px, 0, 0) scaleX(${sx.toFixed(4)})`;
      if (immediate || reduceMotion) {
        accountTabGlider.style.transition = 'none';
        accountTabGlider.style.transform = nextTransform;
        requestAnimationFrame(() => {
          if (accountTabGlider) accountTabGlider.style.transition = '';
        });
      } else {
        accountTabGlider.style.transform = nextTransform;
      }
      accountTabGlider.classList.add('is-ready');
    }

    const tabsRO = typeof ResizeObserver !== 'undefined' && accountTabs
      ? new ResizeObserver(() => syncAccountTabGlider(true))
      : null;
    if (tabsRO && accountTabs) tabsRO.observe(accountTabs);

    // 入场：下一帧挂 is-ready，让 CSS 过渡跑起来
    requestAnimationFrame(() => {
      shell.classList.add('is-ready');
      syncAccountTabGlider(true);
    });

    type SyncFlowMode = 'idle' | 'checking' | 'pushing' | 'pulling' | 'bidirectional' | 'synced' | 'error';
    const FLOW_LABELS: Record<SyncFlowMode, string> = {
      idle: '待命',
      checking: '巡验',
      pushing: '呈送 →',
      pulling: '← 采撷',
      bidirectional: '⇄ 流转',
      synced: '已同步',
      error: '阻滞',
    };

    function setSyncInkFlowState(mode: SyncFlowMode) {
      if (syncInkBridge) syncInkBridge.setAttribute('data-flow', mode);
      if (bridgeConfluenceLabel) bridgeConfluenceLabel.textContent = FLOW_LABELS[mode] || '云墨同频';
    }

    let statusRippleTimer = 0;
    function triggerAccountStatusRipple(statusLabel = '同步就绪') {
      if (statusLabelEl) statusLabelEl.textContent = statusLabel;
      if (!statusWrap || reduceMotion) return;
      window.clearTimeout(statusRippleTimer);
      statusWrap.classList.remove('is-rippling');
      requestAnimationFrame(() => {
        statusWrap.classList.add('is-rippling');
        const rect = statusWrap.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 10);
        }
        statusRippleTimer = scheduleTimer(() => {
          statusWrap.classList.remove('is-rippling');
        }, 720);
      });
    }

    (window as any)[CLEANUP_KEY] = () => {
      controller.abort();
      tabsRO?.disconnect();
      trackedTimers.forEach((tid) => window.clearTimeout(tid));
      trackedTimers.clear();
      (window as any)[CLEANUP_KEY] = undefined;
    };

    type JsonResult = { res: Response; data: any };

    async function api(path: string, options: RequestInit = {}): Promise<JsonResult> {
      const res = await fetch(path, {
        ...options,
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
      });
      const text = await res.text();
      let data: any = {};
      if (text) {
        try {
          data = JSON.parse(text);
        } catch {
          data = { error: `服务返回了非 JSON 响应（HTTP ${res.status}）` };
        }
      }
      return { res, data };
    }

    function popMessageEl(el: HTMLElement) {
      if (reduceMotion || typeof el.animate !== 'function') return;
      el.animate(
        [
          { opacity: 0, transform: 'translate3d(0, -5px, 0)' },
          { opacity: 1, transform: 'translate3d(0, 0, 0)' },
        ],
        { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
      );
    }

    function setServiceHint(message: string) {
      if (!serviceHint) return;
      serviceHint.hidden = !message;
      serviceHint.textContent = message;
      if (message) popMessageEl(serviceHint);
    }

    const AUTH_PROXY_HINT = '账号接口没有生效：请确认服务器 nginx 已把 /api/auth 转发到 blog-ask，并执行 nginx -t && systemctl reload nginx。';

    function setMessage(message: string, type: 'error' | 'ok' = 'error') {
      if (!authMessage) return;
      authMessage.hidden = !message;
      authMessage.textContent = message;
      authMessage.dataset.type = type;
      if (message) popMessageEl(authMessage);
    }

    function switchTab(tab: 'login' | 'register') {
      if (!tabLogin || !tabRegister || !loginForm || !registerForm) return;
      const login = tab === 'login';
      tabLogin.classList.toggle('is-active', login);
      tabRegister.classList.toggle('is-active', !login);
      tabLogin.setAttribute('aria-selected', String(login));
      tabRegister.setAttribute('aria-selected', String(!login));
      loginForm.hidden = !login;
      registerForm.hidden = login;
      setMessage('');
      requestAnimationFrame(() => syncAccountTabGlider(false));
    }

    tabLogin?.addEventListener('click', () => switchTab('login'), { signal });
    tabRegister?.addEventListener('click', () => switchTab('register'), { signal });

    let feedbackHideTimer = 0;
    let feedbackClearTimer = 0;
    function setFeedback(msg: string, type: 'ok' | 'error' | 'info' = 'info') {
      const fb = $('syncActionFeedback');
      if (!fb) return;
      fb.textContent = msg;
      fb.setAttribute('data-type', type);
      fb.style.opacity = '1';
      window.clearTimeout(feedbackHideTimer);
      window.clearTimeout(feedbackClearTimer);
      if (msg) {
        feedbackHideTimer = scheduleTimer(() => {
          fb.style.opacity = '0';
          feedbackClearTimer = scheduleTimer(() => {
            if (fb.style.opacity === '0') fb.textContent = '';
          }, 300);
        }, 5000);
      }
    }

    async function refreshSyncStatus() {
      const notesSync = (window as any).__notesSync;
      const mindmapsSync = (window as any).__mindmapsSync;
      const readingSync = (window as any).__readingSync;
      const syncBadge = $('syncBadge');
      const syncBadgeText = $('syncBadgeText');
      const syncStatus = $('syncStatus');
      const syncDetail = $('syncDetail');
      const pushPendingTag = $('pushPendingTag');
      const pullIncomingTag = $('pullIncomingTag');

      if (!notesSync || typeof notesSync.checkSyncStatus !== 'function') {
        if (syncStatus) syncStatus.textContent = '同步模块尚未就绪';
        return;
      }

      if (syncBadge) syncBadge.setAttribute('data-state', 'checking');
      if (syncBadgeText) syncBadgeText.textContent = '校验中…';
      if (syncInkBridge?.getAttribute('data-flow') === 'idle') {
        setSyncInkFlowState('checking');
      }

      try {
        const [notesSt, mmSt, rdSt] = await Promise.all([
          notesSync.checkSyncStatus(),
          mindmapsSync?.checkSyncStatus ? mindmapsSync.checkSyncStatus() : Promise.resolve(null),
          readingSync?.checkSyncStatus ? readingSync.checkSyncStatus() : Promise.resolve(null),
        ]);
        if (!notesSt.ok) {
          if (syncBadge) syncBadge.setAttribute('data-state', notesSt.state || 'error');
          if (syncBadgeText) syncBadgeText.textContent = notesSt.state === 'need-login' ? '未登录' : '校验异常';
          if (syncStatus) syncStatus.textContent = notesSt.message || '无法获取同步状态';
          setSyncInkFlowState('error');
          return;
        }

        const totalPending = Number(notesSt.pendingCount || 0) + Number(mmSt?.pendingCount || 0) + Number(rdSt?.pendingCount || 0);
        const totalIncoming = Number(notesSt.incomingCount || 0) + Number(mmSt?.incomingCount || 0) + Number(rdSt?.incomingCount || 0);
        const ahead = totalPending > 0;
        const behind = totalIncoming > 0 || notesSt.state === 'behind' || notesSt.state === 'diverged' || mmSt?.state === 'behind' || mmSt?.state === 'diverged' || rdSt?.state === 'behind' || rdSt?.state === 'diverged';
        const combinedState = ahead && behind ? 'diverged' : ahead ? 'ahead' : behind ? 'behind' : 'latest';

        const stateLabels: Record<string, string> = {
          latest: '本地已是最新',
          ahead: '本地有待提交',
          behind: '云端有待拉取',
          diverged: '需双向同步',
        };

        if (syncBadge) syncBadge.setAttribute('data-state', combinedState);
        if (syncBadgeText) syncBadgeText.textContent = stateLabels[combinedState] || '已校验';
        if (bridgeLocalMeta) {
          bridgeLocalMeta.textContent = totalPending > 0 ? `待提交 ${totalPending}` : `r${notesSt.localRev} 已净`;
        }
        if (bridgeCloudMeta) {
          bridgeCloudMeta.textContent = totalIncoming > 0 ? `待拉取 ${totalIncoming}` : `r${notesSt.serverRev} 齐平`;
        }
        setSyncInkFlowState(combinedState === 'latest' ? 'synced' : 'idle');
        if (syncStatus) {
          syncStatus.textContent = combinedState === 'latest'
            ? '笔记、思维导图与夹签进度均已是最新，与云端完全同步'
            : `待提交 ${totalPending} 项（笔记 ${notesSt.pendingCount} / 导图 ${mmSt?.pendingCount || 0} / 夹签 ${rdSt?.pendingCount || 0}）· 待拉取 ${totalIncoming} 项`;
        }

        const lastSyncAt = Math.max(Number(notesSt.lastSyncAt || 0), Number(mmSt?.lastSyncAt || 0), Number(rdSt?.lastSyncAt || 0));
        const lastTime = lastSyncAt ? new Date(lastSyncAt).toLocaleString('zh-CN') : '从未同步';
        const mmRev = mmSt?.ok ? ` · 导图: r${mmSt.localRev}/r${mmSt.serverRev}` : '';
        const rdRev = rdSt?.ok ? ` · 夹签: r${rdSt.localRev}/r${rdSt.serverRev}` : '';
        if (syncDetail) {
          syncDetail.textContent = `笔记: r${notesSt.localRev}/r${notesSt.serverRev}${mmRev}${rdRev} · 待提交: ${totalPending} · 待拉取: ${totalIncoming} · 上次同步: ${lastTime}`;
        }

        if (pushPendingTag) {
          if (totalPending > 0) {
            pushPendingTag.textContent = `${totalPending} 项待提交`;
            pushPendingTag.removeAttribute('hidden');
          } else {
            pushPendingTag.setAttribute('hidden', '');
          }
        }

        if (pullIncomingTag) {
          if (totalIncoming > 0) {
            pullIncomingTag.textContent = `${totalIncoming} 项新内容`;
            pullIncomingTag.removeAttribute('hidden');
          } else {
            pullIncomingTag.setAttribute('hidden', '');
          }
        }
      } catch (err) {
        if (syncBadge) syncBadge.setAttribute('data-state', 'error');
        if (syncBadgeText) syncBadgeText.textContent = '校验失败';
        if (syncStatus) syncStatus.textContent = '网络异常，无法校验最新状态';
        setSyncInkFlowState('error');
      }
    }

    function showProfile(user: { username: string }, statusTitle = '同步就绪') {
      authView?.setAttribute('hidden', '');
      profileView?.removeAttribute('hidden');
      setServiceHint('');
      if (profileUsername) profileUsername.textContent = user.username;
      requestAnimationFrame(() => {
        profileView?.classList.add('is-in');
        triggerAccountStatusRipple(statusTitle);
      });
      void refreshSyncStatus();
    }

    function showAuth() {
      profileView?.setAttribute('hidden', '');
      profileView?.classList.remove('is-in');
      authView?.removeAttribute('hidden');
      requestAnimationFrame(() => {
        authView?.classList.add('is-in');
        syncAccountTabGlider(true);
      });
    }

    async function checkSession() {
      const { res, data } = await api('/api/auth/me');
      if (res.ok && data.user) {
        showProfile(data.user);
        return;
      }
      showAuth();
      if (res.status === 404) setServiceHint(AUTH_PROXY_HINT);
      else if (res.status >= 500) setServiceHint('账号服务暂时不可用，请检查 blog-ask 是否在运行。');
      else if (data.error && res.status !== 401) setServiceHint(String(data.error));
    }

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      setMessage('');
      const username = (($('loginUsername') as HTMLInputElement | null)?.value || '').trim();
      const password = ($('loginPassword') as HTMLInputElement | null)?.value || '';
      if (!username || !password) {
        setMessage('请填写用户名和密码');
        return;
      }
      const submit = $('loginSubmit') as HTMLButtonElement | null;
      if (submit) submit.disabled = true;
      try {
        const { res, data } = await api('/api/auth/login', {
          method: 'POST',
          body: JSON.stringify({ username, password }),
        });
        if (!res.ok) {
          setMessage(data.error || `登录失败（HTTP ${res.status}）`);
          if (res.status === 404) setServiceHint(AUTH_PROXY_HINT);
          return;
        }
        showProfile(data.user, '云端就绪');
        setSyncInkFlowState('bidirectional');
        await Promise.all([
          (window as any).__notesSync?.syncNow?.({ migrate: true }),
          (window as any).__mindmapsSync?.syncNow?.({ migrate: true }),
          (window as any).__readingSync?.syncNow?.({ migrate: true }),
        ]);
        await refreshSyncStatus();
      } finally {
        if (submit) submit.disabled = false;
      }
    }, { signal });

    registerForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      setMessage('');
      const inviteCode = (($('registerInvite') as HTMLInputElement | null)?.value || '').trim();
      const username = (($('registerUsername') as HTMLInputElement | null)?.value || '').trim();
      const password = ($('registerPassword') as HTMLInputElement | null)?.value || '';
      const confirm = ($('registerConfirm') as HTMLInputElement | null)?.value || '';
      if (!inviteCode) return setMessage('请填写邀请码');
      if (password.length < 8) return setMessage('密码至少 8 位');
      if (password !== confirm) return setMessage('两次输入的密码不一致');

      const submit = $('registerSubmit') as HTMLButtonElement | null;
      if (submit) submit.disabled = true;
      try {
        const { res, data } = await api('/api/auth/register', {
          method: 'POST',
          body: JSON.stringify({ username, password, inviteCode }),
        });
        if (!res.ok) {
          setMessage(data.error || `注册失败（HTTP ${res.status}）`);
          if (res.status === 404) setServiceHint(AUTH_PROXY_HINT);
          return;
        }
        showProfile(data.user, '新卷就绪');
        setSyncInkFlowState('bidirectional');
        await Promise.all([
          (window as any).__notesSync?.syncNow?.({ migrate: true }),
          (window as any).__mindmapsSync?.syncNow?.({ migrate: true }),
          (window as any).__readingSync?.syncNow?.({ migrate: true }),
        ]);
        await refreshSyncStatus();
      } finally {
        if (submit) submit.disabled = false;
      }
    }, { signal });

    $('logoutBtn')?.addEventListener('click', async () => {
      await api('/api/auth/logout', { method: 'POST', body: '{}' });
      showAuth();
      switchTab('login');
    }, { signal });

    $('checkSyncBtn')?.addEventListener('click', async () => {
      const btn = $('checkSyncBtn') as HTMLButtonElement | null;
      if (btn) btn.classList.add('is-spinning');
      setSyncInkFlowState('checking');
      try {
        await refreshSyncStatus();
        triggerAccountStatusRipple('校验就绪');
        setFeedback('✓ 校验完成，最新状态已同步呈现', 'ok');
      } finally {
        scheduleTimer(() => btn?.classList.remove('is-spinning'), 500);
      }
    }, { signal });

    $('pushSyncBtn')?.addEventListener('click', async () => {
      const notesSync = (window as any).__notesSync;
      const mindmapsSync = (window as any).__mindmapsSync;
      const readingSync = (window as any).__readingSync;
      if (!notesSync || typeof notesSync.pushSync !== 'function') {
        setFeedback('同步模块尚未加载', 'error');
        return;
      }
      const btn = $('pushSyncBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setSyncInkFlowState('pushing');
      setFeedback('正在呈送本地笔记、导图与夹签至云端藏书阁…', 'info');
      try {
        const [nRes, mRes, rRes] = await Promise.all([
          notesSync.pushSync(),
          mindmapsSync?.pushSync ? mindmapsSync.pushSync() : Promise.resolve({ ok: true, pushedCount: 0 }),
          readingSync?.pushSync ? readingSync.pushSync() : Promise.resolve({ ok: true, pushedCount: 0 }),
        ]);
        if (nRes.ok && mRes.ok && rRes.ok) {
          const totalPushed = (nRes.pushedCount || 0) + (mRes.pushedCount || 0) + (rRes.pushedCount || 0);
          setFeedback(totalPushed > 0 ? `✓ 提交完成（笔记 ${nRes.pushedCount || 0} · 导图 ${mRes.pushedCount || 0} · 夹签 ${rRes.pushedCount || 0}）` : '本地暂无待提交的更改（已最新）', 'ok');
          await refreshSyncStatus();
          triggerAccountStatusRipple('已提交云端');
        } else {
          setSyncInkFlowState('error');
          setFeedback(`提交失败：${(!nRes.ok ? nRes.reason : !mRes.ok ? mRes.reason : rRes.reason) || '网络错误'}`, 'error');
        }
      } catch (err: any) {
        setSyncInkFlowState('error');
        setFeedback(`提交异常：${err?.message || '未知错误'}`, 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    }, { signal });

    $('pullSyncBtn')?.addEventListener('click', async () => {
      const notesSync = (window as any).__notesSync;
      const mindmapsSync = (window as any).__mindmapsSync;
      const readingSync = (window as any).__readingSync;
      if (!notesSync || typeof notesSync.pullSync !== 'function') {
        setFeedback('同步模块尚未加载', 'error');
        return;
      }
      const btn = $('pullSyncBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setSyncInkFlowState('pulling');
      setFeedback('正在从云端藏书阁采撷最新笔记、导图与夹签…', 'info');
      try {
        const [nRes, mRes, rRes] = await Promise.all([
          notesSync.pullSync(),
          mindmapsSync?.pullSync ? mindmapsSync.pullSync() : Promise.resolve({ ok: true, pulledCount: 0 }),
          readingSync?.pullSync ? readingSync.pullSync() : Promise.resolve({ ok: true, pulledCount: 0 }),
        ]);
        if (nRes.ok && mRes.ok && rRes.ok) {
          const totalPulled = (nRes.pulledCount || 0) + (mRes.pulledCount || 0) + (rRes.pulledCount || 0);
          setFeedback(totalPulled > 0 ? `✓ 拉取完成（笔记 ${nRes.pulledCount || 0} · 导图 ${mRes.pulledCount || 0} · 夹签 ${rRes.pulledCount || 0}）` : '✓ 云端暂无新内容，本地已是最新', 'ok');
          await refreshSyncStatus();
          triggerAccountStatusRipple('已拉取最新');
        } else {
          setSyncInkFlowState('error');
          setFeedback(`拉取失败：${(!nRes.ok ? nRes.reason : !mRes.ok ? mRes.reason : rRes.reason) || '网络错误'}`, 'error');
        }
      } catch (err: any) {
        setSyncInkFlowState('error');
        setFeedback(`拉取异常：${err?.message || '未知错误'}`, 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    }, { signal });

    $('syncNowBtn')?.addEventListener('click', async () => {
      const notesSync = (window as any).__notesSync;
      const mindmapsSync = (window as any).__mindmapsSync;
      const readingSync = (window as any).__readingSync;
      if (!notesSync || typeof notesSync.syncNow !== 'function') {
        setFeedback('同步模块尚未加载', 'error');
        return;
      }
      const btn = $('syncNowBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setSyncInkFlowState('bidirectional');
      setFeedback('正在进行云墨流转双向全量同步…', 'info');
      try {
        const [nRes, mRes, rRes] = await Promise.all([
          notesSync.syncNow({ migrate: true }),
          mindmapsSync?.syncNow ? mindmapsSync.syncNow({ migrate: true }) : Promise.resolve({ ok: true, pushedCount: 0, pulledCount: 0 }),
          readingSync?.syncNow ? readingSync.syncNow({ migrate: true }) : Promise.resolve({ ok: true, pushedCount: 0, pulledCount: 0 }),
        ]);
        if (nRes.ok && mRes.ok && rRes.ok) {
          setFeedback(
            `✓ 双向同步完成（提交 笔记${nRes.pushedCount || 0}/导图${mRes.pushedCount || 0}/夹签${rRes.pushedCount || 0}，拉取 笔记${nRes.pulledCount || 0}/导图${mRes.pulledCount || 0}/夹签${rRes.pulledCount || 0}）`,
            'ok'
          );
          await refreshSyncStatus();
          triggerAccountStatusRipple('云墨同频');
        } else {
          setSyncInkFlowState('error');
          setFeedback(`同步失败：${(!nRes.ok ? nRes.reason : !mRes.ok ? mRes.reason : rRes.reason) || '网络错误'}`, 'error');
        }
      } catch (err: any) {
        setSyncInkFlowState('error');
        setFeedback(`同步异常：${err?.message || '未知错误'}`, 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    }, { signal });

    window.addEventListener('mindmaps:sync-phase', ((e: CustomEvent) => {
      const detail = e.detail || {};
      if (detail.phase === 'start') {
        if (detail.mode === 'push') setSyncInkFlowState('pushing');
        else if (detail.mode === 'pull') setSyncInkFlowState('pulling');
        else setSyncInkFlowState('bidirectional');
      }
    }) as EventListener, { signal });

    window.addEventListener('article-notes:synced', () => {
      void refreshSyncStatus();
    }, { signal });
    window.addEventListener('mindmaps:synced', () => {
      void refreshSyncStatus();
    }, { signal });

    $('exportNotesBtn')?.addEventListener('click', async () => {
      const { res, data } = await api('/api/notes/export');
      if (!res.ok) {
        if (syncStatus) syncStatus.textContent = data.error || '导出失败';
        return;
      }
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `notes-${new Date().toISOString().slice(0, 10)}.json`;
      link.click();
      URL.revokeObjectURL(url);
    }, { signal });

    $('exportMindmapsBtn')?.addEventListener('click', async () => {
      const { res, data } = await api('/api/mindmaps/export');
      if (!res.ok) {
        if (syncStatus) syncStatus.textContent = data.error || '导图导出失败';
        return;
      }
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `mindmaps-${new Date().toISOString().slice(0, 10)}.json`;
      link.click();
      URL.revokeObjectURL(url);
    }, { signal });

    void checkSession();
    document.addEventListener('astro:before-swap', () => {
      (window as any)[CLEANUP_KEY]?.();
    }, { signal });
  }

  initAccountPage();
  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initAccountPage);
    (window as any)[LISTENER_KEY] = true;
  }
</script>

