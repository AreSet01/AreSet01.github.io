---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="账号与同步 - 清浅">
  <Header />
  <main id="main-content" tabindex="-1" class="container-medium flex-1 pt-6 pb-16 lg:pt-8 outline-none" style="position: relative;">
    <section class="account-shell" data-account-shell>
      <header class="account-head">
        <p class="account-kicker">Account / Sync</p>
        <h1 class="account-title">账号与笔记同步</h1>
        <p class="account-desc">登录后，划词笔记、备注和「存入笔记」的墨问回答会跨设备同步。未登录时仍然只保存在本机。</p>
      </header>

      <div id="authView" class="account-card">
        <div class="account-tabs" role="tablist" aria-label="登录或注册">
          <button type="button" id="tabLogin" class="account-tab is-active" role="tab" aria-selected="true">登录</button>
          <button type="button" id="tabRegister" class="account-tab" role="tab" aria-selected="false">用邀请码注册</button>
        </div>

        <p id="authServiceHint" class="account-service-hint" role="status" hidden></p>

        <form id="loginForm" class="account-form" autocomplete="on">
          <label class="account-label" for="loginUsername">用户名</label>
          <input id="loginUsername" name="username" class="account-input" autocomplete="username" maxlength="24" required />
          <label class="account-label" for="loginPassword">密码</label>
          <input id="loginPassword" name="password" type="password" class="account-input" autocomplete="current-password" maxlength="128" required />
          <button type="submit" class="account-submit" id="loginSubmit">登录</button>
        </form>

        <form id="registerForm" class="account-form" autocomplete="off" hidden>
          <label class="account-label" for="registerInvite">邀请码</label>
          <input id="registerInvite" name="inviteCode" class="account-input account-input--mono" maxlength="16" placeholder="向站主要一个邀请码" required />
          <label class="account-label" for="registerUsername">用户名</label>
          <input id="registerUsername" name="username" class="account-input" autocomplete="username" maxlength="24" placeholder="3–24 位字母、数字、_ 或 -" required />
          <label class="account-label" for="registerPassword">密码</label>
          <input id="registerPassword" name="password" type="password" class="account-input" autocomplete="new-password" maxlength="128" placeholder="至少 8 位" required />
          <label class="account-label" for="registerConfirm">确认密码</label>
          <input id="registerConfirm" name="confirm" type="password" class="account-input" autocomplete="new-password" maxlength="128" required />
          <button type="submit" class="account-submit" id="registerSubmit">注册并登录</button>
        </form>

        <p id="authMessage" class="account-message" role="status" hidden></p>
      </div>

      <div id="profileView" class="account-card" hidden>
        <div class="account-profile-head">
          <div>
            <p class="account-kicker">Signed in</p>
            <p class="account-username" id="profileUsername">—</p>
          </div>
          <button type="button" id="logoutBtn" class="account-ghost-btn">退出登录</button>
        </div>

        <!-- 多设备笔记同步卡片 -->
        <div class="account-sync-card">
          <div class="account-sync-card-head">
            <div class="account-sync-header-left">
              <span class="account-label" style="margin: 0;">多设备笔记同步</span>
              <div class="account-sync-badge" id="syncBadge" data-state="checking">
                <span class="sync-badge-dot"></span>
                <span id="syncBadgeText">正在校验…</span>
              </div>
            </div>
            <button type="button" id="checkSyncBtn" class="account-check-btn" title="校验本地是否为最新同步状态">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>校验最新</span>
            </button>
          </div>

          <div class="account-sync-status-body">
            <p class="account-sync-status" id="syncStatus">正在检查本地与云端数据…</p>
            <p class="account-sync-detail" id="syncDetail">本地版本: — · 云端版本: — · 待提交: 0 · 待拉取: 0</p>
          </div>

          <!-- 两步同步核心操作 -->
          <div class="account-sync-step-grid">
            <!-- 步骤 1：提交同步 (Push) -->
            <button type="button" id="pushSyncBtn" class="account-step-btn account-push-btn">
              <div class="step-btn-content">
                <div class="step-btn-top">
                  <div class="step-btn-icon push-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 19V5M5 12l7-7 7 7"/>
                    </svg>
                  </div>
                  <span class="step-btn-name">1. 提交同步 (Push)</span>
                  <span class="step-btn-badge" id="pushPendingTag" hidden>0 条待提交</span>
                </div>
                <p class="step-btn-desc">将本地新增/修改笔记与删除标记提交至云端</p>
              </div>
            </button>

            <!-- 步骤 2：拉取同步 (Pull) -->
            <button type="button" id="pullSyncBtn" class="account-step-btn account-pull-btn">
              <div class="step-btn-content">
                <div class="step-btn-top">
                  <div class="step-btn-icon pull-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5v14M5 12l7 7 7-7"/>
                    </svg>
                  </div>
                  <span class="step-btn-name">2. 拉取同步 (Pull)</span>
                  <span class="step-btn-badge" id="pullIncomingTag" hidden>0 条新内容</span>
                </div>
                <p class="step-btn-desc">从云端拉取跨设备最新笔记并合并到本地</p>
              </div>
            </button>
          </div>

          <div class="account-sync-footer">
            <button type="button" id="syncNowBtn" class="account-subtle-sync-btn">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
              <span>一键双向同步</span>
            </button>
            <span id="syncActionFeedback" class="account-sync-feedback" role="status" aria-live="polite"></span>
          </div>
        </div>

        <div class="account-actions">
          <button type="button" id="exportNotesBtn" class="account-ghost-btn">导出全部笔记 (JSON)</button>
          <a href="/" class="account-ghost-btn account-link-btn">返回首页</a>
        </div>

        <p class="account-hint">提示：文章里的「笔记」抽屉可以直接添加备注、新建自由笔记；墨问回答结束后的「存入笔记」也会同步到这里。</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { initNotesSync } from '../utils/notesSync';

  initNotesSync();

  const CLEANUP_KEY = '__areSetAccountCleanup__';

  function initAccountPage() {
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') previousCleanup();

    const controller = new AbortController();
    const { signal } = controller;
    (window as any)[CLEANUP_KEY] = () => controller.abort();

    const $ = (id: string) => document.getElementById(id) as HTMLElement | null;

    const shell = document.querySelector<HTMLElement>('[data-account-shell]');
    const authView = $('authView');
    const profileView = $('profileView');
    const authMessage = $('authMessage') as HTMLParagraphElement | null;
    const tabLogin = $('tabLogin');
    const tabRegister = $('tabRegister');
    const loginForm = $('loginForm') as HTMLFormElement | null;
    const registerForm = $('registerForm') as HTMLFormElement | null;
    const profileUsername = $('profileUsername');
    const syncStatus = $('syncStatus');
    const serviceHint = $('authServiceHint') as HTMLParagraphElement | null;

    // 入场：下一帧挂 is-ready，让 CSS 过渡跑起来
    requestAnimationFrame(() => shell?.classList.add('is-ready'));

    type JsonResult = { res: Response; data: any };

    async function api(path: string, options: RequestInit = {}): Promise<JsonResult> {
      const res = await fetch(path, {
        ...options,
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
      });
      const text = await res.text();
      let data: any = {};
      if (text) {
        try {
          data = JSON.parse(text);
        } catch {
          data = { error: `服务返回了非 JSON 响应（HTTP ${res.status}）` };
        }
      }
      return { res, data };
    }

    function setServiceHint(message: string) {
      if (!serviceHint) return;
      serviceHint.hidden = !message;
      serviceHint.textContent = message;
      if (message) {
        serviceHint.classList.remove('is-pop');
        void serviceHint.offsetWidth;
        serviceHint.classList.add('is-pop');
      }
    }

    const AUTH_PROXY_HINT = '账号接口没有生效：请确认服务器 nginx 已把 /api/auth 转发到 blog-ask，并执行 nginx -t && systemctl reload nginx。';

    function setMessage(message: string, type: 'error' | 'ok' = 'error') {
      if (!authMessage) return;
      authMessage.hidden = !message;
      authMessage.textContent = message;
      authMessage.dataset.type = type;
      if (message) {
        authMessage.classList.remove('is-pop');
        void authMessage.offsetWidth;
        authMessage.classList.add('is-pop');
      }
    }

    function switchTab(tab: 'login' | 'register') {
      if (!tabLogin || !tabRegister || !loginForm || !registerForm) return;
      const login = tab === 'login';
      tabLogin.classList.toggle('is-active', login);
      tabRegister.classList.toggle('is-active', !login);
      tabLogin.setAttribute('aria-selected', String(login));
      tabRegister.setAttribute('aria-selected', String(!login));
      loginForm.hidden = !login;
      registerForm.hidden = login;
      setMessage('');
    }

    tabLogin?.addEventListener('click', () => switchTab('login'), { signal });
    tabRegister?.addEventListener('click', () => switchTab('register'), { signal });

    function setFeedback(msg: string, type: 'ok' | 'error' | 'info' = 'info') {
      const fb = $('syncActionFeedback');
      if (!fb) return;
      fb.textContent = msg;
      fb.setAttribute('data-type', type);
      fb.style.opacity = '1';
      window.clearTimeout((fb as any).__timer);
      if (msg) {
        (fb as any).__timer = window.setTimeout(() => {
          fb.style.opacity = '0';
          setTimeout(() => {
            if (fb.style.opacity === '0') fb.textContent = '';
          }, 300);
        }, 5000);
      }
    }

    async function refreshSyncStatus() {
      const sync = (window as any).__notesSync;
      const syncBadge = $('syncBadge');
      const syncBadgeText = $('syncBadgeText');
      const syncStatus = $('syncStatus');
      const syncDetail = $('syncDetail');
      const pushPendingTag = $('pushPendingTag');
      const pullIncomingTag = $('pullIncomingTag');

      if (!sync || typeof sync.checkSyncStatus !== 'function') {
        if (syncStatus) syncStatus.textContent = '同步模块尚未就绪';
        return;
      }

      if (syncBadge) syncBadge.setAttribute('data-state', 'checking');
      if (syncBadgeText) syncBadgeText.textContent = '校验中…';

      try {
        const status = await sync.checkSyncStatus();
        if (!status.ok) {
          if (syncBadge) syncBadge.setAttribute('data-state', status.state || 'error');
          if (syncBadgeText) syncBadgeText.textContent = status.state === 'need-login' ? '未登录' : '校验异常';
          if (syncStatus) syncStatus.textContent = status.message || '无法获取同步状态';
          return;
        }

        const stateLabels: Record<string, string> = {
          latest: '本地已是最新',
          ahead: '本地有待提交',
          behind: '云端有待拉取',
          diverged: '需双向同步',
        };

        if (syncBadge) syncBadge.setAttribute('data-state', status.state);
        if (syncBadgeText) syncBadgeText.textContent = stateLabels[status.state] || '已校验';
        if (syncStatus) syncStatus.textContent = status.message || '已就绪';

        const lastTime = status.lastSyncAt ? new Date(status.lastSyncAt).toLocaleString('zh-CN') : '从未同步';
        if (syncDetail) {
          syncDetail.textContent = `本地版本: r${status.localRev} · 云端版本: r${status.serverRev} · 待提交: ${status.pendingCount} 条 · 待拉取: ${status.incomingCount} 条 · 上次同步: ${lastTime}`;
        }

        if (pushPendingTag) {
          if (status.pendingCount > 0) {
            pushPendingTag.textContent = `${status.pendingCount} 条待提交`;
            pushPendingTag.removeAttribute('hidden');
          } else {
            pushPendingTag.setAttribute('hidden', '');
          }
        }

        if (pullIncomingTag) {
          if (status.incomingCount > 0) {
            pullIncomingTag.textContent = `${status.incomingCount} 条新内容`;
            pullIncomingTag.removeAttribute('hidden');
          } else {
            pullIncomingTag.setAttribute('hidden', '');
          }
        }
      } catch (err) {
        if (syncBadge) syncBadge.setAttribute('data-state', 'error');
        if (syncBadgeText) syncBadgeText.textContent = '校验失败';
        if (syncStatus) syncStatus.textContent = '网络异常，无法校验最新状态';
      }
    }

    function showProfile(user: { username: string }) {
      authView?.setAttribute('hidden', '');
      profileView?.removeAttribute('hidden');
      setServiceHint('');
      if (profileUsername) profileUsername.textContent = user.username;
      requestAnimationFrame(() => profileView?.classList.add('is-in'));
      void refreshSyncStatus();
    }

    function showAuth() {
      profileView?.setAttribute('hidden', '');
      profileView?.classList.remove('is-in');
      authView?.removeAttribute('hidden');
      requestAnimationFrame(() => authView?.classList.add('is-in'));
    }

    async function checkSession() {
      const { res, data } = await api('/api/auth/me');
      if (res.ok && data.user) {
        showProfile(data.user);
        return;
      }
      showAuth();
      if (res.status === 404) setServiceHint(AUTH_PROXY_HINT);
      else if (res.status >= 500) setServiceHint('账号服务暂时不可用，请检查 blog-ask 是否在运行。');
      else if (data.error && res.status !== 401) setServiceHint(String(data.error));
    }

    loginForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      setMessage('');
      const username = (($('loginUsername') as HTMLInputElement | null)?.value || '').trim();
      const password = ($('loginPassword') as HTMLInputElement | null)?.value || '';
      if (!username || !password) {
        setMessage('请填写用户名和密码');
        return;
      }
      const submit = $('loginSubmit') as HTMLButtonElement | null;
      if (submit) submit.disabled = true;
      try {
        const { res, data } = await api('/api/auth/login', {
          method: 'POST',
          body: JSON.stringify({ username, password }),
        });
        if (!res.ok) {
          setMessage(data.error || `登录失败（HTTP ${res.status}）`);
          if (res.status === 404) setServiceHint(AUTH_PROXY_HINT);
          return;
        }
        showProfile(data.user);
        await (window as any).__notesSync?.syncNow?.({ migrate: true });
      } finally {
        if (submit) submit.disabled = false;
      }
    }, { signal });

    registerForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      setMessage('');
      const inviteCode = (($('registerInvite') as HTMLInputElement | null)?.value || '').trim();
      const username = (($('registerUsername') as HTMLInputElement | null)?.value || '').trim();
      const password = ($('registerPassword') as HTMLInputElement | null)?.value || '';
      const confirm = ($('registerConfirm') as HTMLInputElement | null)?.value || '';
      if (!inviteCode) return setMessage('请填写邀请码');
      if (password.length < 8) return setMessage('密码至少 8 位');
      if (password !== confirm) return setMessage('两次输入的密码不一致');

      const submit = $('registerSubmit') as HTMLButtonElement | null;
      if (submit) submit.disabled = true;
      try {
        const { res, data } = await api('/api/auth/register', {
          method: 'POST',
          body: JSON.stringify({ username, password, inviteCode }),
        });
        if (!res.ok) {
          setMessage(data.error || `注册失败（HTTP ${res.status}）`);
          if (res.status === 404) setServiceHint(AUTH_PROXY_HINT);
          return;
        }
        showProfile(data.user);
        await (window as any).__notesSync?.syncNow?.({ migrate: true });
      } finally {
        if (submit) submit.disabled = false;
      }
    }, { signal });

    $('logoutBtn')?.addEventListener('click', async () => {
      await api('/api/auth/logout', { method: 'POST', body: '{}' });
      showAuth();
      switchTab('login');
    }, { signal });

    $('checkSyncBtn')?.addEventListener('click', async () => {
      const btn = $('checkSyncBtn') as HTMLButtonElement | null;
      if (btn) btn.classList.add('is-spinning');
      try {
        await refreshSyncStatus();
        setFeedback('✓ 校验完成，最新状态已同步呈现', 'ok');
      } finally {
        setTimeout(() => btn?.classList.remove('is-spinning'), 500);
      }
    }, { signal });

    $('pushSyncBtn')?.addEventListener('click', async () => {
      const sync = (window as any).__notesSync;
      if (!sync || typeof sync.pushSync !== 'function') {
        setFeedback('同步模块尚未加载', 'error');
        return;
      }
      const btn = $('pushSyncBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setFeedback('正在提交本地修改到云端…', 'info');
      try {
        const res = await sync.pushSync();
        if (res.ok) {
          setFeedback(res.pushedCount > 0 ? `✓ ${res.message}` : '本地暂无待提交的更改（已最新）', 'ok');
          await refreshSyncStatus();
        } else {
          setFeedback(`提交失败：${res.reason || '网络错误'}`, 'error');
        }
      } catch (err: any) {
        setFeedback(`提交异常：${err?.message || '未知错误'}`, 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    }, { signal });

    $('pullSyncBtn')?.addEventListener('click', async () => {
      const sync = (window as any).__notesSync;
      if (!sync || typeof sync.pullSync !== 'function') {
        setFeedback('同步模块尚未加载', 'error');
        return;
      }
      const btn = $('pullSyncBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setFeedback('正在从云端拉取多设备最新笔记…', 'info');
      try {
        const res = await sync.pullSync();
        if (res.ok) {
          setFeedback(res.pulledCount > 0 ? `✓ ${res.message}` : '✓ 云端暂无新内容，本地已是最新', 'ok');
          await refreshSyncStatus();
        } else {
          setFeedback(`拉取失败：${res.reason || '网络错误'}`, 'error');
        }
      } catch (err: any) {
        setFeedback(`拉取异常：${err?.message || '未知错误'}`, 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    }, { signal });

    $('syncNowBtn')?.addEventListener('click', async () => {
      const sync = (window as any).__notesSync;
      if (!sync || typeof sync.syncNow !== 'function') {
        setFeedback('同步模块尚未加载', 'error');
        return;
      }
      const btn = $('syncNowBtn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      setFeedback('正在进行双向全量同步…', 'info');
      try {
        const res = await sync.syncNow({ migrate: true });
        if (res.ok) {
          setFeedback(`✓ 双向同步完成（提交 ${res.pushedCount || 0} 条，拉取 ${res.pulledCount || 0} 条）`, 'ok');
          await refreshSyncStatus();
        } else {
          setFeedback(`同步失败：${res.reason || '网络错误'}`, 'error');
        }
      } catch (err: any) {
        setFeedback(`同步异常：${err?.message || '未知错误'}`, 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    }, { signal });

    window.addEventListener('article-notes:synced', () => {
      void refreshSyncStatus();
    }, { signal });

    $('exportNotesBtn')?.addEventListener('click', async () => {
      const { res, data } = await api('/api/notes/export');
      if (!res.ok) {
        if (syncStatus) syncStatus.textContent = data.error || '导出失败';
        return;
      }
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `notes-${new Date().toISOString().slice(0, 10)}.json`;
      link.click();
      URL.revokeObjectURL(url);
    }, { signal });

    void checkSession();
  }

  initAccountPage();
  document.addEventListener('astro:page-load', initAccountPage);
</script>

<style>
  .account-shell {
    max-width: 44rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .account-shell.is-ready {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .account-head {
    text-align: center;
    padding: 2rem 1rem 0.5rem;
    opacity: 0;
    transform: translate3d(0, 10px, 0);
    transition:
      opacity 700ms cubic-bezier(0.16, 1, 0.3, 1) 80ms,
      transform 760ms cubic-bezier(0.16, 1, 0.3, 1) 80ms;
  }

  .account-shell.is-ready .account-head {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .account-kicker {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .account-title {
    position: relative;
    display: inline-block;
    margin: 0;
    font-family: var(--font-hand-title);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--text-strong);
    letter-spacing: var(--font-letter-title);
  }

  .account-title::after {
    content: "";
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -7px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1) 420ms;
    opacity: 0.65;
  }

  .account-shell.is-ready .account-title::after {
    transform: scaleX(1);
  }

  .account-desc {
    margin: 0.7rem auto 0;
    max-width: 34rem;
    color: var(--muted-strong);
    font-size: 0.9rem;
