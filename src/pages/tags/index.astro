---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import { tagStats, tagPairs, tagSlug } from '../../utils/posts';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const tags = tagStats(posts);
const pairs = tagPairs(posts);
const maxCount = Math.max(1, ...tags.map((tag) => tag.count));
const strongPairs = pairs.filter((pair) => pair.weight >= 2).length;
---

<BaseLayout title="标签星图" description="按共现关系排布的标签星图">
  <Header />
  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-20 lg:pt-8 outline-none">
    <section class="tag-head">
      <p class="eyebrow" data-enter="top">Tags · 水墨星宿</p>
      <h1 class="section-title mt-4" data-enter="left">标签星图</h1>
      <p class="tag-hint" data-enter="left">
        Tags Gather Into A Galaxy
      </p>
      <div class="tag-meta-row" data-enter="bottom">
        <div class="tag-legend">
          <span><b>{tags.length}</b> 个标签</span>
          <span><b>{strongPairs}</b> 组强共现</span>
          <span><b>{posts.length}</b> 篇文章</span>
        </div>

        <div class="tag-view-toolbar">
          <div class="tag-view-switch" role="group" aria-label="星图视图模式" data-tag-view-bar>
            <span class="tag-view-glider" data-tag-view-glider aria-hidden="true"></span>
            <button
              type="button"
              class="tag-view-btn is-active"
              data-tag-view-btn="2d"
              aria-pressed="true"
            >
              <span>平面星图</span>
              <small>2D</small>
            </button>
            <button
              type="button"
              class="tag-view-btn"
              data-tag-view-btn="3d"
              aria-pressed="false"
            >
              <span>三维星云</span>
              <small>3D</small>
            </button>
          </div>

          <div class="tag-3d-controls" data-tag-3d-controls hidden>
            <span class="tag-3d-hint">拖拽旋览 · 滚轮调焦</span>
            <button
              type="button"
              class="tag-3d-reset"
              data-tag-3d-reset
              aria-label="重置三维星云视角与缩放"
              title="归位默认视角 (100%)"
            >
              <span>归位</span>
              <span class="tag-3d-zoom" data-tag-zoom-readout>100%</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <section
      class="tag-sky"
      data-tag-sky
      data-view-mode="2d"
      data-pairs={JSON.stringify(pairs.map((pair) => [pair.a, pair.b, pair.weight]))}
    >
      <canvas class="tag-sky-webgl" data-tag-webgl aria-hidden="true"></canvas>
      <svg class="tag-sky-links" data-tag-links aria-hidden="true"></svg>
      <div class="tag-sky-nodes" data-tag-nodes>
        {tags.map((tag) => (
          <a
            class="tag-node"
            href={`/tags/${tagSlug(tag.name)}`}
            data-tag-node
            data-tag={tag.name}
            data-weight={(tag.count / maxCount).toFixed(3)}
            style={`--weight: ${(tag.count / maxCount).toFixed(3)}`}
          >
            <span class="tag-node-halo" aria-hidden="true"></span>
            <span class="tag-node-name">{tag.name}</span>
            <span class="tag-node-count">{tag.count}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tag-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-top: 1.4rem;
  }

  .tag-meta-row .tag-legend {
    margin-top: 0;
  }

  .tag-view-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.85rem;
  }

  .tag-view-switch {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    padding: 3px;
    border-radius: 9999px;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg-soft) 78%, transparent);
  }

  /* 100x32 基准胶囊 + 纯 GPU translate3d/scale + 反向圆角补偿，零布局回流 */
  .tag-view-glider {
    position: absolute;
    top: 0;
    left: 0;
    width: 100px;
    height: 32px;
    border: none !important;
    border-radius: var(--pill-rx, 9999px) / var(--pill-ry, 9999px);
    transform-origin: 0 0;
    background: var(--ink-strong);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    will-change: transform, opacity;
  }

  :global([data-theme="moss"]) .tag-view-glider {
    background: var(--accent);
  }

  .tag-view-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.34rem;
    padding: 0.32rem 0.82rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: var(--muted-strong);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition:
      color 220ms var(--ease),
      opacity 220ms var(--ease);
  }

  .tag-view-btn small {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    opacity: 0.72;
  }

  .tag-view-btn:hover {
    color: var(--text-strong);
  }

  .tag-view-btn.is-active {
    color: var(--bg-base);
  }

  :global([data-theme="moss"]) .tag-view-btn.is-active {
    color: #002b24;
  }

  :global([data-theme="moss"][data-moss-shade="4DB6AC"]) .tag-view-btn.is-active {
    color: #f2fbf9;
  }

  .tag-view-btn[aria-disabled="true"] {
    opacity: 0.42;
    cursor: not-allowed;
  }

  .tag-3d-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .tag-3d-hint {
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .tag-3d-hint {
      display: none;
    }
  }

  .tag-3d-reset {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    padding: 0.24rem 0.66rem;
    border-radius: 9999px;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg-soft) 72%, transparent);
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    cursor: pointer;
    transition:
      transform 180ms var(--ease),
      border-color 180ms var(--ease),
      background-color 180ms var(--ease);
  }

  .tag-3d-reset:hover {
    border-color: var(--rule-strong);
    transform: translateY(-1px);
  }

  .tag-3d-reset:active {
    transform: scale(0.97);
  }

  .tag-3d-zoom {
    opacity: 0.72;
  }

  .tag-sky {
    background:
      radial-gradient(ellipse 64% 56% at 50% 50%, color-mix(in srgb, var(--bg-soft) 55%, transparent) 0%, transparent 100%);
  }

  .tag-sky[data-view-mode="3d"] {
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .tag-sky[data-view-mode="3d"]:global(.is-orbiting) {
    cursor: grabbing;
  }

  .tag-sky-webgl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 340ms var(--ease);
  }

  .tag-sky[data-view-mode="3d"] .tag-sky-webgl {
    opacity: 1;
  }

  .tag-sky[data-view-mode="3d"] .tag-sky-links {
    opacity: 0;
    transition: opacity 260ms var(--ease);
  }

  /* 静止收敛后释放非活跃节点的 will-change，节约 GPU 合成层显存 */
  .tag-sky[data-view-mode="2d"]:global(.is-settled) .tag-node:not(:hover):not(:global(.is-lit)):not(:global(.is-origin)) {
    will-change: auto;
  }

  /* 基础水墨星轨弧线 */
  :global(.tag-link) {
    fill: none;
    stroke: var(--ink-strong);
    stroke-linecap: round;
    opacity: 0.05;
    transition: opacity 320ms var(--ease), stroke 320ms var(--ease);
  }

  :global(.tag-link.is-strong) {
    opacity: 0.17;
  }

  .tag-sky:global(.is-focused) :global(.tag-link),
  .tag-sky:global(.is-focused) :global(.tag-link.is-strong) {
    opacity: 0.045;
  }

  .tag-sky:global(.is-focused) :global(.tag-link.is-lit) {
    stroke: var(--accent);
    opacity: 0.42;
  }

  /* 悬停点亮专属「水墨星座连线脉冲」：浓淡墨流自焦点标签向共现伴星游走 */
  :global(.tag-link-pulse) {
    fill: none;
    stroke: var(--vermilion);
    stroke-linecap: round;
    stroke-dasharray: 0.16 0.34;
    stroke-dashoffset: 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms var(--ease);
  }

  :global(.tag-link-pulse.is-lit) {
    opacity: 0.92;
    animation: constellationInkFlow 1.65s linear infinite;
  }

  @keyframes constellationInkFlow {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  /* 水墨星芒光晕（零 blur、纯 transform + opacity 同心水纹环） */
  .tag-node {
    position: relative;
    isolation: isolate;
  }

  .tag-node-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2.3em;
    height: 2.3em;
    margin-left: -1.15em;
    margin-top: -1.15em;
    pointer-events: none;
    z-index: -1;
    opacity: 0;
    transform: scale(0.55);
    transition:
      opacity 280ms var(--ease),
      transform 480ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* 外环水墨微晕 + 内嵌同心水纹墨环 */
  .tag-node-halo::before,
  .tag-node-halo::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .tag-node-halo::before {
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--vermilion) 20%, transparent) 0%,
      color-mix(in srgb, var(--accent) 8%, transparent) 52%,
      transparent 74%
    );
  }

  .tag-node-halo::after {
    inset: 24%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--vermilion) 52%, transparent);
  }

  .tag-node:hover .tag-node-halo,
  .tag-node:focus-visible .tag-node-halo,
  .tag-node:global(.is-origin) .tag-node-halo {
    opacity: 1;
    transform: scale(1.08);
  }

  .tag-node:global(.is-lit):not(:global(.is-origin)) .tag-node-halo {
    opacity: 0.52;
    transform: scale(0.82);
  }

  .tag-node:global(.is-origin) {
    color: var(--vermilion);
    z-index: 4;
  }

  .tag-node:global(.is-lit):not(:global(.is-origin)) {
    color: var(--text-strong);
    z-index: 3;
  }

  .tag-node:global(.is-origin) .tag-node-count {
    color: var(--vermilion);
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.tag-link-pulse.is-lit) {
      animation: none !important;
      stroke-dasharray: none;
    }
    .tag-node-halo,
    .tag-sky-webgl,
    .tag-view-btn,
    .tag-3d-reset {
      transition: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { animate, spring } from 'motion';
  import { canUseWebGL } from '../../utils/threeInkStage';
  import { createTagConstellationThree } from '../../utils/tagConstellationThree';
  import type { TagConstellationThreeHandle } from '../../utils/tagConstellationThree';

  // Force-directed constellation layout:
  // - Fixed 60Hz timestep prevents acceleration on 120–240Hz displays
  // - Dirty-checked sub-pixel DOM/SVG batching eliminates redundant attribute/style writes
  // - Kinetic-energy convergence & offscreen/hidden-tab sleep immediately halt rAF at rest
  const CLEANUP_KEY = '__areSetTagSkyCleanup__';
  const LISTENER_KEY = '__areSetTagSkyBound__';
  const GLIDER_BASE_W = 100;
  const GLIDER_BASE_H = 32;

  type ConstellationMode = '2d' | '3d';

  interface Node {
    el: HTMLElement;
    name: string;
    weight: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    hw: number;
    hh: number;
    r: number;
    paintedX: number;
    paintedY: number;
  }

  interface ConstellationLink {
    a: Node;
    b: Node;
    weight: number;
    curveSign: 1 | -1;
    basePath: SVGPathElement;
    pulsePath: SVGPathElement;
    lastD: string;
  }

  interface SwitchTabMetric {
    mode: ConstellationMode;
    x: number;
    y: number;
    w: number;
    h: number;
  }

  function buildArcPath(x1: number, y1: number, x2: number, y2: number, sign: 1 | -1): string {
    const mx = (x1 + x2) * 0.5;
    const my = (y1 + y2) * 0.5;
    const dx = x2 - x1;
    const dy = y2 - y1;
    const len = Math.max(1, Math.hypot(dx, dy));
    // 柔雅微弧度书法连丝（弧高控制在弦长的 7% 且上限 22px，清逸不杂乱）
    const bow = Math.min(22, len * 0.07) * sign;
    const cx = mx - (dy / len) * bow;
    const cy = my + (dx / len) * bow;
    return `M${x1.toFixed(1)},${y1.toFixed(1)} Q${cx.toFixed(1)},${cy.toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`;
  }

  function initTagSky() {
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') previousCleanup();

    const sky = document.querySelector<HTMLElement>('[data-tag-sky]');
    const wrap = sky?.querySelector<HTMLElement>('[data-tag-nodes]');
    const svg = sky?.querySelector<SVGSVGElement>('[data-tag-links]');
    const webglCanvas = sky?.querySelector<HTMLCanvasElement>('[data-tag-webgl]');
    if (!sky || !wrap || !svg) return;

    const viewBar = document.querySelector<HTMLElement>('[data-tag-view-bar]');
    const viewGlider = viewBar?.querySelector<HTMLElement>('[data-tag-view-glider]');
    const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag-view-btn]'));
    const controls3d = document.querySelector<HTMLElement>('[data-tag-3d-controls]');
    const reset3dBtn = document.querySelector<HTMLButtonElement>('[data-tag-3d-reset]');
    const zoomReadout = document.querySelector<HTMLElement>('[data-tag-zoom-readout]');

    const controller = new AbortController();
    const { signal } = controller;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const webglCapable = !reduceMotion && canUseWebGL();

    const els = Array.from(wrap.querySelectorAll<HTMLElement>('[data-tag-node]'));
    if (!els.length) return;

    let activeMode: ConstellationMode = '2d';
    let modeRequestToken = 0;
    let threeHandle: TagConstellationThreeHandle | null = null;
    let gliderAnim: { stop?: () => void } | null = null;
    let switchMetrics: SwitchTabMetric[] = [];

    const btn3d = viewButtons.find((b) => b.dataset.tagViewBtn === '3d');
    if (btn3d && !webglCapable) {
      btn3d.setAttribute('aria-disabled', 'true');
      btn3d.title = reduceMotion
        ? '已开启减弱动态效果，自动保持平面水墨星图'
        : '当前环境未启用 WebGL，自动保持平面水墨星图';
    }

    const measureViewSwitch = () => {
      switchMetrics = viewButtons.map((btn) => ({
        mode: (btn.dataset.tagViewBtn === '3d' ? '3d' : '2d') as ConstellationMode,
        x: btn.offsetLeft,
        y: btn.offsetTop,
        w: Math.max(1, btn.offsetWidth),
        h: Math.max(1, btn.offsetHeight),
      }));
    };

    const syncViewGlider = (mode: ConstellationMode, withSpring: boolean) => {
      viewButtons.forEach((btn) => {
        const isCurrent = btn.dataset.tagViewBtn === mode;
        btn.classList.toggle('is-active', isCurrent);
        btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      });
      if (controls3d) {
        controls3d.hidden = mode !== '3d';
      }

      if (!viewGlider || switchMetrics.length === 0) return;
      const metric = switchMetrics.find((m) => m.mode === mode) ?? switchMetrics[0];
      const sx = Math.max(0.01, metric.w / GLIDER_BASE_W);
      const sy = Math.max(0.01, metric.h / GLIDER_BASE_H);
      const halfR = Math.min(metric.w, metric.h) * 0.5;
      viewGlider.style.setProperty('--pill-rx', `${(halfR / sx).toFixed(2)}px`);
      viewGlider.style.setProperty('--pill-ry', `${(halfR / sy).toFixed(2)}px`);
      viewGlider.style.opacity = '1';

      const targetTransform = `translate3d(${metric.x.toFixed(1)}px, ${metric.y.toFixed(1)}px, 0px) scale(${sx.toFixed(4)}, ${sy.toFixed(4)})`;
      gliderAnim?.stop?.();
      gliderAnim = null;

      if (!withSpring || reduceMotion) {
        viewGlider.style.transform = targetTransform;
        return;
      }

      try {
        gliderAnim = animate(
          viewGlider,
          { transform: targetTransform },
          { type: spring, stiffness: 420, damping: 34, mass: 0.72 },
        );
      } catch {
        viewGlider.style.transform = targetTransform;
      }
    };

    measureViewSwitch();
    syncViewGlider('2d', false);

    let viewBarRo: ResizeObserver | null = null;
    if (viewBar && typeof ResizeObserver !== 'undefined') {
      viewBarRo = new ResizeObserver(() => {
        measureViewSwitch();
        syncViewGlider(activeMode, false);
      });
      viewBarRo.observe(viewBar);
    }

    let width = sky.clientWidth;
    let height = sky.clientHeight;
    let frame = 0;
    let alpha = 1;
    let settled = false;
    let inViewport = true;

    // Measure while nodes are still in normal flow (single batched read pass), then lift out of flow
    const measuredDims = els.map((el) => ({
      hw: el.offsetWidth / 2,
      hh: el.offsetHeight / 2,
    }));

    const nodes: Node[] = els.map((el, idx) => {
      const { hw, hh } = measuredDims[idx];
      return {
        el,
        name: el.dataset.tag || '',
        weight: Number.parseFloat(el.dataset.weight || '0') || 0,
        x: 0,
        y: 0,
        vx: 0,
        vy: 0,
        hw,
        hh,
        r: Math.hypot(hw, hh),
        paintedX: Number.NaN,
        paintedY: Number.NaN,
      };
    });

    const byName = new Map(nodes.map((node) => [node.name, node]));
    wrap.classList.add('is-laid-out');

    const rawPairs: Array<[string, string, number]> = JSON.parse(sky.dataset.pairs || '[]');
    const maxWeight = Math.max(1, ...rawPairs.map(([, , w]) => w));

    svg.replaceChildren();
    const baseGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    const pulseGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

    const links: ConstellationLink[] = [];
    const neighbours = new Map<string, Set<string>>();

    rawPairs.forEach(([aName, bName, weight], idx) => {
      const a = byName.get(aName);
      const b = byName.get(bName);
      if (!a || !b) return;

      if (!neighbours.has(a.name)) neighbours.set(a.name, new Set());
      if (!neighbours.has(b.name)) neighbours.set(b.name, new Set());
      neighbours.get(a.name)!.add(b.name);
      neighbours.get(b.name)!.add(a.name);

      const strokeW = (0.65 + (weight / maxWeight) * 2.1).toFixed(2);
      const basePath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      basePath.setAttribute('class', weight >= 2 ? 'tag-link is-strong' : 'tag-link');
      basePath.setAttribute('stroke-width', strokeW);
      basePath.dataset.a = a.name;
      basePath.dataset.b = b.name;
      baseGroup.appendChild(basePath);

      const pulsePath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      pulsePath.setAttribute('class', 'tag-link-pulse');
      pulsePath.setAttribute('stroke-width', (Number(strokeW) + 0.55).toFixed(2));
      pulsePath.setAttribute('pathLength', '1');
      pulsePath.dataset.a = a.name;
      pulsePath.dataset.b = b.name;
      pulseGroup.appendChild(pulsePath);

      links.push({
        a,
        b,
        weight,
        curveSign: idx % 2 === 0 ? 1 : -1,
        basePath,
        pulsePath,
        lastD: '',
      });
    });

    svg.append(baseGroup, pulseGroup);

    let focusedTag: string | null = null;

    function seed() {
      width = Math.max(240, sky!.clientWidth);
      height = Math.max(240, sky!.clientHeight);
      svg!.setAttribute('viewBox', `0 0 ${width} ${height}`);
      const cx = width / 2;
      const cy = height / 2;
      const ring = Math.max(width, height) * 0.58;
      nodes.forEach((node, index) => {
        const angle = (index / nodes.length) * Math.PI * 2 + 0.6;
        node.x = cx + Math.cos(angle) * ring;
        node.y = cy + Math.sin(angle) * ring * 0.78;
        node.vx = 0;
        node.vy = 0;
        node.paintedX = Number.NaN;
        node.paintedY = Number.NaN;
      });
      links.forEach((l) => {
        l.lastD = '';
      });
      alpha = 1;
      settled = false;
    }

    function step(): number {
      const cx = width / 2;
      const cy = height / 2;

      // Repulsion + axis-aware text-box separation
      for (let i = 0; i < nodes.length; i += 1) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j += 1) {
          const b = nodes[j];
          let dx = b.x - a.x;
          let dy = b.y - a.y;
          let dist2 = dx * dx + dy * dy;
          if (dist2 < 1) {
            dx = (Math.random() - 0.5) * 2;
            dy = (Math.random() - 0.5) * 2;
            dist2 = 4;
          }
          const dist = Math.sqrt(dist2);
          const charge = 3200 / Math.max(dist2, 400);
          const fx = (dx / dist) * charge;
          const fy = (dy / dist) * charge;
          a.vx -= fx;
          a.vy -= fy;
          b.vx += fx;
          b.vy += fy;

          const overlapX = a.hw + b.hw + 18 - Math.abs(dx);
          const overlapY = a.hh + b.hh + 12 - Math.abs(dy);
          if (overlapX > 0 && overlapY > 0) {
            if (overlapX < overlapY) {
              const push = (overlapX * 0.5) * (dx >= 0 ? 1 : -1) * 0.55;
              a.vx -= push;
              b.vx += push;
            } else {
              const push = (overlapY * 0.5) * (dy >= 0 ? 1 : -1) * 0.55;
              a.vy -= push;
              b.vy += push;
            }
          }
        }
      }

      // Co-occurrence springs
      for (let i = 0; i < links.length; i += 1) {
        const link = links[i];
        const dx = link.b.x - link.a.x;
        const dy = link.b.y - link.a.y;
        const dist = Math.max(1, Math.hypot(dx, dy));
        const rest = link.a.r + link.b.r + 26 + 140 / link.weight;
        const pull = (dist - rest) * 0.012 * Math.min(1.6, 0.5 + link.weight / maxWeight);
        const px = (dx / dist) * pull;
        const py = (dy / dist) * pull;
        link.a.vx += px;
        link.a.vy += py;
        link.b.vx -= px;
        link.b.vy -= py;
      }

      let maxMove = 0;
      for (let i = 0; i < nodes.length; i += 1) {
        const node = nodes[i];
        node.vx += (cx - node.x) * 0.0022;
        node.vy += (cy - node.y) * 0.0032;
        node.vx *= 0.84;
        node.vy *= 0.84;
        const moveX = node.vx * alpha;
        const moveY = node.vy * alpha;
        const prevX = node.x;
        const prevY = node.y;
        node.x = Math.min(width - node.hw - 4, Math.max(node.hw + 4, node.x + moveX));
        node.y = Math.min(height - node.hh - 4, Math.max(node.hh + 4, node.y + moveY));
        const disp = Math.abs(node.x - prevX) + Math.abs(node.y - prevY);
        if (disp > maxMove) maxMove = disp;
      }
      return maxMove;
    }

    function paint() {
      // Dirty-checked sub-pixel batch write on GPU transforms
      for (let i = 0; i < nodes.length; i += 1) {
        const node = nodes[i];
        const tx = node.x - node.hw;
        const ty = node.y - node.hh;
        if (
          Number.isNaN(node.paintedX) ||
          Math.abs(tx - node.paintedX) > 0.04 ||
          Math.abs(ty - node.paintedY) > 0.04
        ) {
          node.paintedX = tx;
          node.paintedY = ty;
          node.el.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0px)`;
        }
      }

      for (let i = 0; i < links.length; i += 1) {
        const link = links[i];
        const d = buildArcPath(link.a.x, link.a.y, link.b.x, link.b.y, link.curveSign);
        if (d !== link.lastD) {
          link.lastD = d;
          link.basePath.setAttribute('d', d);
          if (focusedTag && (link.a.name === focusedTag || link.b.name === focusedTag)) {
            const fromA = link.a.name === focusedTag;
            const pd = fromA
              ? d
              : buildArcPath(link.b.x, link.b.y, link.a.x, link.a.y, (-link.curveSign as 1 | -1));
            link.pulsePath.setAttribute('d', pd);
          } else {
            link.pulsePath.setAttribute('d', d);
          }
        }
      }
    }

    // Fixed 60Hz physics step banked against wall-clock time
    const STEP = 1 / 60;
    let lastTime = 0;
    let bank = 0;

    function markSettled() {
      settled = true;
      frame = 0;
      lastTime = 0;
      sky!.classList.add('is-settled');
    }

    function tick(now: number) {
      frame = 0;
      if (activeMode !== '2d' || settled || signal.aborted || document.hidden || !inViewport) {
        lastTime = 0;
        return;
      }
      if (!lastTime) lastTime = now;
      bank += Math.min(0.1, (now - lastTime) / 1000);
      lastTime = now;

      let maxDisp = 1;
      let stepsRun = 0;
      while (bank >= STEP && stepsRun < 6) {
        maxDisp = step();
        alpha *= 0.985;
        bank -= STEP;
        stepsRun += 1;
      }

      paint();

      // Kinetic energy auto-sleep: stop rAF immediately once displacement converges
      if (alpha <= 0.02 || (alpha < 0.36 && maxDisp < 0.04)) {
        markSettled();
        return;
      }

      frame = requestAnimationFrame(tick);
    }

    function ensureTicking() {
      if (activeMode !== '2d' || settled || frame || reduceMotion || document.hidden || !inViewport || signal.aborted) return;
      lastTime = 0;
      frame = requestAnimationFrame(tick);
    }

    function run() {
      if (activeMode !== '2d') return;
      cancelAnimationFrame(frame);
      frame = 0;
      seed();
      lastTime = 0;
      bank = 0;
      sky!.classList.remove('is-settled');
      if (reduceMotion) {
        for (let i = 0; i < 420; i += 1) {
          const d = step();
          alpha *= 0.99;
          if (alpha < 0.3 && d < 0.03) break;
        }
        paint();
        markSettled();
        return;
      }
      ensureTicking();
    }

    // ---------- Hover: light up constellation & orient outward ink-stream pulses ----------
    function highlight(name: string | null) {
      focusedTag = name;
      if (activeMode === '3d' && threeHandle) {
        threeHandle.highlight(name);
        return;
      }

      sky!.classList.toggle('is-focused', Boolean(name));
      const near = name ? neighbours.get(name) ?? new Set<string>() : null;

      for (let i = 0; i < nodes.length; i += 1) {
        const node = nodes[i];
        const isOrigin = Boolean(name) && node.name === name;
        const lit = !name || isOrigin || near!.has(node.name);
        node.el.classList.toggle('is-origin', isOrigin);
        node.el.classList.toggle('is-lit', Boolean(name) && lit);
        node.el.classList.toggle('is-dim', Boolean(name) && !lit);
      }

      for (let i = 0; i < links.length; i += 1) {
        const link = links[i];
        const lit = Boolean(name) && (link.a.name === name || link.b.name === name);
        link.basePath.classList.toggle('is-lit', lit);
        link.pulsePath.classList.toggle('is-lit', lit);
        if (lit && name) {
          // Orient pulse path from hovered star -> companion star so ink flows outward
          const fromA = link.a.name === name;
          const orientedD = fromA
            ? buildArcPath(link.a.x, link.a.y, link.b.x, link.b.y, link.curveSign)
            : buildArcPath(link.b.x, link.b.y, link.a.x, link.a.y, (-link.curveSign as 1 | -1));
          link.pulsePath.setAttribute('d', orientedD);
        }
      }
    }

    async function setViewMode(requested: ConstellationMode, withSpring = true): Promise<ConstellationMode> {
      const token = ++modeRequestToken;
      if (requested === '3d') {
        if (!webglCapable) {
          activeMode = '2d';
          sky!.dataset.viewMode = '2d';
          sky!.removeAttribute('data-lenis-prevent');
          syncViewGlider('2d', withSpring);
          return '2d';
        }
        if (activeMode === '3d' && threeHandle?.active) {
          syncViewGlider('3d', withSpring);
          return '3d';
        }

        cancelAnimationFrame(frame);
        frame = 0;
        activeMode = '3d';
        sky!.dataset.viewMode = '3d';
        sky!.setAttribute('data-lenis-prevent', '');
        syncViewGlider('3d', withSpring);
        if (zoomReadout) zoomReadout.textContent = '100%';

        const handle = await createTagConstellationThree({
          sky: sky!,
          canvas: webglCanvas,
          nodes: nodes.map((n) => ({
            el: n.el,
            name: n.name,
            hw: n.hw,
            hh: n.hh,
            weight: n.weight,
          })),
          pairs: rawPairs,
          onZoomChange: (z) => {
            if (zoomReadout) {
              zoomReadout.textContent = `${Math.round(z * 100)}%`;
            }
          },
        });

        if (signal.aborted || token !== modeRequestToken) {
          handle.dispose();
          return activeMode;
        }

        if (!handle.active || handle.fallback) {
          handle.dispose();
          activeMode = '2d';
          sky!.dataset.viewMode = '2d';
          sky!.removeAttribute('data-lenis-prevent');
          syncViewGlider('2d', false);
          nodes.forEach((n) => {
            n.paintedX = Number.NaN;
            n.paintedY = Number.NaN;
          });
          paint();
          ensureTicking();
          return '2d';
        }

        threeHandle = handle;
        if (focusedTag) {
          threeHandle.highlight(focusedTag);
        }
        return '3d';
      }

      // Switch to 2D SVG mode
      if (threeHandle) {
        threeHandle.dispose();
        threeHandle = null;
      }
      activeMode = '2d';
      sky!.dataset.viewMode = '2d';
      sky!.removeAttribute('data-lenis-prevent');
      syncViewGlider('2d', withSpring);

      nodes.forEach((n) => {
        n.paintedX = Number.NaN;
        n.paintedY = Number.NaN;
      });
      if (settled) {
        paint();
      } else {
        run();
      }
      if (focusedTag) {
        highlight(focusedTag);
      }
      return '2d';
    }

    viewButtons.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const targetMode: ConstellationMode = btn.dataset.tagViewBtn === '3d' ? '3d' : '2d';
          if (targetMode === '3d' && !webglCapable) return;
          void setViewMode(targetMode, true);
        },
        { signal },
      );
    });

    reset3dBtn?.addEventListener(
      'click',
      () => {
        threeHandle?.resetView();
        if (zoomReadout) zoomReadout.textContent = '100%';
      },
      { signal },
    );

    els.forEach((el) => {
      el.addEventListener('pointerenter', () => highlight(el.dataset.tag || null), { signal });
      el.addEventListener('focus', () => highlight(el.dataset.tag || null), { signal });
      el.addEventListener('pointerleave', () => highlight(null), { signal });
      el.addEventListener('blur', () => highlight(null), { signal });
    });

    // Offscreen & background-tab auto-sleep
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          inViewport = entry.isIntersecting;
          if (!inViewport && frame) {
            cancelAnimationFrame(frame);
            frame = 0;
            lastTime = 0;
          } else if (inViewport) {
            ensureTicking();
          }
        });
      },
      { rootMargin: '100px 0px' },
    );
    io.observe(sky);

    document.addEventListener(
      'visibilitychange',
      () => {
        if (document.hidden && frame) {
          cancelAnimationFrame(frame);
          frame = 0;
          lastTime = 0;
        } else if (!document.hidden) {
          ensureTicking();
        }
      },
      { signal },
    );

    let resizeTimer = 0;
    window.addEventListener(
      'resize',
      () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          measureViewSwitch();
          syncViewGlider(activeMode, false);
          if (activeMode === '2d') run();
        }, 180);
      },
      { signal },
    );

    run();

    // Honor ?view=3d deep link when WebGL is available
    try {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('view') === '3d' && webglCapable) {
        void setViewMode('3d', false);
      }
    } catch {}

    // Re-measure once webfont settles so text-box separation stays crisp
    document.fonts?.ready.then(() => {
      if (signal.aborted) return;
      measureViewSwitch();
      syncViewGlider(activeMode, false);
      if (activeMode !== '2d') return;
      wrap.classList.remove('is-laid-out');
      const nextDims = nodes.map((node) => ({
        hw: node.el.offsetWidth / 2,
        hh: node.el.offsetHeight / 2,
      }));
      wrap.classList.add('is-laid-out');
      nodes.forEach((node, idx) => {
        node.hw = nextDims[idx].hw;
        node.hh = nextDims[idx].hh;
        node.r = Math.hypot(node.hw, node.hh);
      });
      run();
    });

    (window as any).__areSetTagSkyMode__ = {
      getMode: () => activeMode,
      setMode: (mode: ConstellationMode) => setViewMode(mode, true),
    };

    (window as any)[CLEANUP_KEY] = () => {
      modeRequestToken += 1;
      controller.abort();
      io.disconnect();
      viewBarRo?.disconnect();
      gliderAnim?.stop?.();
      gliderAnim = null;
      if (threeHandle) {
        threeHandle.dispose();
        threeHandle = null;
      }
      cancelAnimationFrame(frame);
      frame = 0;
      window.clearTimeout(resizeTimer);
      gsap.killTweensOf(els);
      (window as any).__areSetTagSkyMode__ = undefined;
      (window as any)[CLEANUP_KEY] = undefined;
    };
  }

  initTagSky();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initTagSky);
    document.addEventListener('astro:before-swap', () => {
      (window as any)[CLEANUP_KEY]?.();
    });
    (window as any)[LISTENER_KEY] = true;
  }
</script>
