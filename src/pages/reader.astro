    const sortSelect = document.getElementById('reader-sort-select') as HTMLSelectElement | null;
    const shelfGrid = document.getElementById('reader-shelf-grid');
    const emptyState = document.getElementById('reader-empty-state');
    const emptyTitle = document.getElementById('reader-empty-title');
    const emptyDesc = document.getElementById('reader-empty-desc');

    const dropOverlay = document.getElementById('reader-drop-overlay');
