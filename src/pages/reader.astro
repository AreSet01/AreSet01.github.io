  }

  function escapeHtml(raw: string): string {
    return String(raw || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatWordCount(count: number): string {
    if (count >= 10000) return `${(count / 10000).toFixed(1)}w`;
    if (count >= 1000) return `${(count / 1000).toFixed(1)}k`;
    return String(count || 0);
  }

  function formatRelativeTime(ts: number): string {
    if (!ts) return '刚刚';
    const diff = Date.now() - ts;
    if (diff < 60_000) return '刚刚';
    if (diff < 3_600_000) return `${Math.floor(diff / 60_000)} 分钟前`;
    if (diff < 86_400_000) return `${Math.floor(diff / 3_600_000)} 小时前`;
    const d = new Date(ts);
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  }

  function revealKind(el: HTMLElement): string {
    const tag = el.tagName;
    if (tag === 'H2') return 'heading';
    if (tag === 'H3' || tag === 'H4') return 'subheading';
    if (tag === 'PRE') return 'code';
    if (el.classList.contains('mermaid-block')) return 'mermaid';
    if (tag === 'BLOCKQUOTE' || el.classList.contains('callout-card')) return 'quote';
    if (tag === 'TABLE' || el.classList.contains('table-scroll-wrap')) return 'table';
    if (tag === 'UL' || tag === 'OL') return 'list';
    if (tag === 'HR') return 'rule';
    if (tag === 'FIGURE' || (tag === 'P' && el.children.length === 1 && el.children[0].tagName === 'IMG')) {
      return 'image';
    }
    return 'block';
  }

  async function collectDroppedFiles(dataTransfer: DataTransfer): Promise<ImportedFileItem[]> {
    const out: ImportedFileItem[] = [];
    const items = Array.from(dataTransfer.items || []);

    const walkEntry = async (entry: any, prefix = ''): Promise<void> => {
      if (!entry) return;
      if (entry.isFile) {
        await new Promise<void>((resolve) => {
          entry.file(
            (file: File) => {
              const rel = prefix ? `${prefix}/${file.name}` : file.name;
              out.push({ file, relativePath: rel });
              resolve();
            },
            () => resolve(),
          );
        });
      } else if (entry.isDirectory) {
        const reader = entry.createReader();
        const readAll = async (): Promise<any[]> => {
          const entries: any[] = [];
          while (true) {
            const batch = await new Promise<any[]>((resolve) => {
              reader.readEntries((res: any[]) => resolve(res || []), () => resolve([]));
            });
            if (!batch.length) break;
            entries.push(...batch);
          }
          return entries;
        };
        const children = await readAll();
        const nextPrefix = prefix ? `${prefix}/${entry.name}` : entry.name;
        for (const child of children) {
          await walkEntry(child, nextPrefix);
        }
      }
    };

    const entries = items
      .map((item) => (typeof (item as any).webkitGetAsEntry === 'function' ? (item as any).webkitGetAsEntry() : null))
      .filter(Boolean);

    if (entries.length > 0) {
      for (const entry of entries) {
        await walkEntry(entry, '');
      }
      return out;
    }

    for (const file of Array.from(dataTransfer.files || [])) {
      const rel = (file as any).webkitRelativePath || file.name;
      out.push({ file, relativePath: rel });
    }
    return out;
  }

  function extractStructuredTextFromProse(proseEl: HTMLElement): string {
    const SKIP = '.code-block-toolbar, .mermaid-block-header, .mermaid-block-actions, .mermaid-source, .code-expand-veil, .heading-anchor-btn, button, svg, script, style';
    const blocks: string[] = [];
    const children = Array.from(proseEl.children);
    for (const child of children) {
      if (!(child instanceof HTMLElement)) continue;
      if (child.classList.contains('mermaid-block')) {
        const title = child.querySelector('.mermaid-block-title-text')?.textContent?.trim();
        if (title) blocks.push(`[图表: ${title}]`);
        continue;
      }
      const clone = child.cloneNode(true) as HTMLElement;
      clone.querySelectorAll(SKIP).forEach((el) => el.remove());
      const raw = (clone.textContent || '')
        .replace(/[ \t\f\r\u00a0]+/g, ' ')
        .replace(/ *\n */g, '\n')
        .replace(/\n{3,}/g, '\n\n')
        .trim();
      if (!raw) continue;
      const tag = child.tagName.toUpperCase();
      if (/^H[1-6]$/.test(tag)) {
        const level = Number(tag[1]) || 2;
        blocks.push(`${'#'.repeat(level)} ${raw}`);
      } else {
        blocks.push(raw);
      }
    }
    return blocks.join('\n\n').slice(0, 26_000);
  }

