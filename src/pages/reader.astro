    // Stage 元素
    const stageBar = document.getElementById('reader-stage-bar');
    const stageHeader = document.getElementById('reader-stage-header');
    const backShelfBtn = document.getElementById('reader-back-shelf-btn');
    const crumbShelfBtn = document.getElementById('reader-crumb-shelf');
    const docSwitcher = document.getElementById('reader-doc-switcher') as HTMLSelectElement | null;
    const reimportBtn = document.getElementById('reader-reimport-btn');
    const exportNotesBtn = document.getElementById('reader-export-notes-btn');
    const toMindmapBtn = document.getElementById('reader-to-mindmap-btn');
    const metaDateEl = document.getElementById('reader-meta-date');
    const metaCategoryEl = document.getElementById('reader-meta-category');
    const metaMinutesEl = document.getElementById('reader-meta-minutes');
    const metaBadgeEl = document.getElementById('reader-meta-badge');
    const docTitleEl = document.getElementById('reader-doc-title');
    const docDescEl = document.getElementById('reader-doc-desc');
    const docTagsWrap = document.getElementById('reader-doc-tags-wrap');
    const docTagsEl = document.getElementById('reader-doc-tags');
    const missingBanner = document.getElementById('reader-missing-assets-banner');
    const missingText = document.getElementById('reader-missing-assets-text');
    const attachAssetsBtn = document.getElementById('reader-attach-assets-btn');
    const tocDetails = document.getElementById('reader-toc') as HTMLDetailsElement | null;
    const tocExpander = document.getElementById('reader-toc-expander');
    const tocNav = document.getElementById('reader-toc-nav');
    const tocCountEl = document.getElementById('reader-toc-count');
    const postBodyEl = document.querySelector<HTMLElement>('[data-post-body]');
    const spineEl = document.querySelector<HTMLElement>('[data-post-spine]');
    const spineLine = document.querySelector<SVGLineElement>('[data-post-spine-line]');

    // Modals
    const pasteModal = document.getElementById('reader-paste-modal');
    const pasteForm = document.getElementById('reader-paste-form') as HTMLFormElement | null;
    const pasteTitleInput = document.getElementById('reader-paste-title') as HTMLInputElement | null;
    const pasteCatSelect = document.getElementById('reader-paste-category') as HTMLSelectElement | null;
    const pasteContentInput = document.getElementById('reader-paste-content') as HTMLTextAreaElement | null;
    const dupModal = document.getElementById('reader-dup-modal');
    const dupDesc = document.getElementById('reader-dup-desc');

    // ---------- 状态 ----------
    let docs: LocalReaderDocument[] = [];
    let categories: string[] = loadReaderCategories();
    let activeCategory = 'all';
    let statFilter: 'all' | 'reading' = 'all';
    let searchKeyword = '';
    let sortMode = 'recent';
    let activeDoc: LocalReaderDocument | null = null;
    let activeObjectUrls: string[] = [];
    let proseController: AbortController | null = null;
    let tocObserver: IntersectionObserver | null = null;
    let shelfFilterTimeline: gsap.core.Timeline | null = null;
    let paperPhysicsCleanup: (() => void) | null = null;
    let searchDebounceTimer = 0;
    let companionPhaseTimer = 0;
    let deepLinkTimer = 0;
    let openToken = 0;
    let toastTimer = 0;
    let dragDepth = 0;
    let reimportTargetId: string | null = null;
    let lastModalTrigger: HTMLElement | null = null;
    let openModalCount = 0;

    const prefersReducedMotion = () =>
      window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;

    function notifyModalChange(delta: 1 | -1) {
      const prev = openModalCount;
      openModalCount = Math.max(0, openModalCount + delta);
      if (prev === 0 && openModalCount > 0) {
        window.dispatchEvent(new CustomEvent('app:modal-enter'));
      } else if (prev > 0 && openModalCount === 0) {
        window.dispatchEvent(new CustomEvent('app:modal-leave'));
      }
    }

    function refreshScroll(options: { clamp?: boolean } = {}) {
      try {
        (window as any).lenis?.resize?.();
      } catch {}
      if (options.clamp !== false) {
        try {
          (window as any).ScrollTrigger?.refresh?.();
        } catch {}
      }
    }

    function returnToFilterBar() {
      if (window.scrollY <= 80 || !filterBar) return;
      if ((window as any).lenis) {
        (window as any).lenis.scrollTo(filterBar, { offset: -90, duration: 0.65 });
      } else {
        filterBar.scrollIntoView({ behavior: prefersReducedMotion() ? 'auto' : 'smooth', block: 'start' });
      }
    }

    function showToast(msg: string) {
      if (!toastEl) return;
      window.clearTimeout(toastTimer);
      toastEl.textContent = msg;
      toastEl.hidden = false;
      toastEl.classList.remove('is-visible');
      void toastEl.offsetWidth;
      toastEl.classList.add('is-visible');
      toastTimer = window.setTimeout(() => {
        toastEl.classList.remove('is-visible');
        window.setTimeout(() => {
          if (!toastEl.classList.contains('is-visible')) toastEl.hidden = true;
        }, 220);
      }, 2800);
    }

    function revokeActiveAssetUrls() {
      for (const url of activeObjectUrls) {
        try {
          URL.revokeObjectURL(url);
        } catch {}
      }
      activeObjectUrls = [];
    }

    function trapModalFocus(modalEl: HTMLElement, e: KeyboardEvent) {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(
        modalEl.querySelectorAll<HTMLElement>(
          'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => el.offsetParent !== null);
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && (document.activeElement === first || !modalEl.contains(document.activeElement))) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (document.activeElement === last || !modalEl.contains(document.activeElement))) {
        e.preventDefault();
        first.focus();
      }
    }

    // ---------- 批量读取一次进度与笔记数（彻底消除 O(N) localStorage JSON.parse） ----------

    function buildShelfLookupSnapshot() {
      const progressBySlug = new Map<string, ReadingProgressRecord>();
      for (const entry of loadAllReadingEntries()) {
        if (entry && !entry.deleted && entry.kind === 'progress') {
          progressBySlug.set(normalizeReadingSlug(entry.postSlug), entry);
        }
      }
      const notesCountBySlug = new Map<string, number>();
      for (const bucket of loadAllStoredNotes()) {
        const slug = normalizeReadingSlug(bucket.postSlug);
        const count = (bucket.records || []).filter((r) => r && !r.deleted).length;
        if (slug && count > 0) {
          notesCountBySlug.set(slug, (notesCountBySlug.get(slug) || 0) + count);
        }
      }
      return { progressBySlug, notesCountBySlug };
    }

    // ---------- 顶部统计条磁吸悬停滑块（与 /notes 一致） ----------

    function initStatsGlider() {
      if (!statsStrip || !statsGlider) return;
      const items = Array.from(statsStrip.querySelectorAll<HTMLElement>('.stats-item'));

      const moveHoverGlider = (target: HTMLElement) => {
        const stripRect = statsStrip.getBoundingClientRect();
        const targetRect = target.getBoundingClientRect();
        if (!targetRect.width) return;
        const left = targetRect.left - stripRect.left;
        statsGlider.style.opacity = '1';
        statsGlider.style.width = `${targetRect.width}px`;
        statsGlider.style.transform = `translate3d(${left.toFixed(1)}px, 0, 0)`;
        items.forEach((it) => it.classList.remove('is-hovered'));
        target.classList.add('is-hovered');
      };

      const hideHoverGlider = () => {
        statsGlider.style.opacity = '0';
        items.forEach((it) => it.classList.remove('is-hovered'));
      };

      items.forEach((item) => {
        item.addEventListener('mouseenter', () => moveHoverGlider(item), { signal });
        item.addEventListener('focus', () => moveHoverGlider(item), { signal });
        const activate = () => {
          const rect = item.getBoundingClientRect();
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 8);
          const key = item.dataset.readerStat;
          if (key === 'words') return;
          const nextFilter: 'all' | 'reading' = key === 'reading' && statFilter !== 'reading' ? 'reading' : 'all';
          if (nextFilter === statFilter) return;
          statFilter = nextFilter;
          items.forEach((el) => {
            const active = (el.dataset.readerStat || 'all') === statFilter;
            el.classList.toggle('is-active', active);
            el.setAttribute('aria-pressed', String(active));
          });
          renderShelf(true, false);
        };
        item.addEventListener('click', activate, { signal });
        item.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate();
          }
        }, { signal });
      });

      statsStrip.addEventListener('mouseleave', hideHoverGlider, { signal });
    }

    // ---------- 分类胶囊纯 GPU scaleX 滑块（零 width 重排 + 反向圆角补偿） ----------

    function syncCatGlider() {
      if (!catBar || !catGlider) return;
      const activeBtn = catBar.querySelector<HTMLElement>('.reader-cat-pill.is-active');
      if (!activeBtn) return;
      const w = activeBtn.offsetWidth;
      const h = catGlider.offsetHeight || activeBtn.offsetHeight;
      if (!w || !h) return;
      const left = activeBtn.offsetLeft;
      const sx = Math.max(0.05, w / 100);
      const halfR = Math.min(w, h) * 0.5;
      catGlider.style.setProperty('--pill-rx', `${(halfR / sx).toFixed(2)}px`);
      catGlider.style.setProperty('--pill-ry', `${halfR.toFixed(2)}px`);
      catGlider.style.opacity = '1';
      catGlider.style.transform = `translate3d(${left.toFixed(1)}px, 0, 0) scaleX(${sx.toFixed(4)})`;
    }

    function updateStats(progressBySlug: Map<string, ReadingProgressRecord>) {
      let readingCount = 0;
      let totalWords = 0;
      for (const doc of docs) {
        totalWords += doc.wordCount || 0;
        const prog = progressBySlug.get(normalizeReadingSlug(buildLocalReaderSlug(doc.id)));
        if (prog && !prog.completed && prog.progress >= 0.04) {
          readingCount += 1;
        }
      }
      if (statTotalEl) statTotalEl.textContent = String(docs.length);
      if (statReadingEl) statReadingEl.textContent = String(readingCount);
      if (statWordsEl) statWordsEl.textContent = formatWordCount(totalWords);
    }

    function renderCategoryBar() {
      if (!catBar) return;
      const docCats = new Set<string>(categories);
      for (const d of docs) {
        if (d.category) docCats.add(d.category);
      }
      const allCats = ['all', ...Array.from(docCats)];
      catBar.querySelectorAll('.reader-cat-pill').forEach((b) => b.remove());

      for (const cat of allCats) {
        const count = cat === 'all' ? docs.length : docs.filter((d) => d.category === cat).length;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `reader-cat-pill${activeCategory === cat ? ' is-active' : ''}`;
        btn.dataset.cat = cat;
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-selected', String(activeCategory === cat));
        btn.innerHTML = `<span>${escapeHtml(cat === 'all' ? '全部' : cat)}</span><span class="reader-cat-count">${count}</span>`;
        btn.addEventListener('click', () => {
          const rect = btn.getBoundingClientRect();
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 7);
          if (activeCategory === cat) return;
          activeCategory = cat;
          catBar.querySelectorAll<HTMLElement>('.reader-cat-pill').forEach((el) => {
            const match = el.dataset.cat === cat;
            el.classList.toggle('is-active', match);
            el.setAttribute('aria-selected', String(match));
          });
          syncCatGlider();
          renderShelf(true, false);
        }, { signal });
        catBar.appendChild(btn);
      }

      if (pasteCatSelect) {
        const prev = pasteCatSelect.value;
        pasteCatSelect.innerHTML = Array.from(docCats)
          .map((c) => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`)
          .join('');
        if (prev && docCats.has(prev)) pasteCatSelect.value = prev;
      }

      requestAnimationFrame(syncCatGlider);
    }

    function syncDocSwitcher() {
      if (!docSwitcher) return;
      docSwitcher.innerHTML = docs
        .map((d) => `<option value="${escapeHtml(d.id)}">${escapeHtml(d.title)}</option>`)
        .join('');
      if (activeDoc) {
        docSwitcher.value = activeDoc.id;
      }
    }

    // ---------- 书架卡片构建与 3D 纸笺动效渲染 ----------

    function getFilteredDocs(progressBySlug: Map<string, ReadingProgressRecord>): LocalReaderDocument[] {
      const kw = searchKeyword.trim().toLowerCase();
      let list = docs.filter((doc) => {
        if (activeCategory !== 'all' && doc.category !== activeCategory) return false;
        if (statFilter === 'reading') {
          const prog = progressBySlug.get(normalizeReadingSlug(buildLocalReaderSlug(doc.id)));
          if (!prog || prog.completed || prog.progress < 0.04) return false;
        }
        if (kw) {
          const hay = [doc.title, doc.fileName, doc.description, doc.category, ...(doc.tags || [])]
            .join(' ')
            .toLowerCase();
          if (!hay.includes(kw)) return false;
        }
        return true;
      });

      list = [...list].sort((a, b) => {
        if (sortMode === 'title') return a.title.localeCompare(b.title, 'zh-CN');
        if (sortMode === 'words') return (b.wordCount || 0) - (a.wordCount || 0);
        if (sortMode === 'updated') return (b.updatedAt || 0) - (a.updatedAt || 0);
        return (b.lastOpenedAt || b.updatedAt || 0) - (a.lastOpenedAt || a.updatedAt || 0);
      });
      return list;
    }

    function syncEmptyStateCopy() {
      if (docs.length === 0) {
        if (emptyTitle) emptyTitle.textContent = '书架暂时空着';
        if (emptyDesc) {
          emptyDesc.textContent =
            '把本地的 Markdown 笔记或整套技术文档文件夹拖到这里，即可获得与博客正式文章完全一致的排版、代码高亮、Mermaid 图表、划线批注与墨问伴读体验。';
        }
        if (loadSampleBtn) loadSampleBtn.hidden = false;
      } else {
        if (emptyTitle) emptyTitle.textContent = '当前筛选下没有匹配的文稿';
        if (emptyDesc) emptyDesc.textContent = '可以切换分类、清空搜索词，或直接拖入新的 Markdown 文件。';
        if (loadSampleBtn) loadSampleBtn.hidden = true;
      }
    }

    function buildDocCardElement(
      doc: LocalReaderDocument,
      progressBySlug: Map<string, ReadingProgressRecord>,
      notesCountBySlug: Map<string, number>,
      useInitialEnterAttr: boolean,
    ): HTMLElement {
      const slug = normalizeReadingSlug(buildLocalReaderSlug(doc.id));
      const prog = progressBySlug.get(slug);
      const pct = prog ? formatProgressPercent(prog.progress) : 0;
      const notesCount = notesCountBySlug.get(slug) || 0;
      const assetCount = doc.assetPaths?.length || 0;

      const card = document.createElement('article');
      card.className = 'reader-doc-card panel';
      card.tabIndex = 0;
      card.setAttribute('role', 'button');
      card.setAttribute('data-paper-card', '');
      card.setAttribute('aria-label', `打开文稿：${doc.title}`);
      if (useInitialEnterAttr) {
        card.setAttribute('data-enter', 'card');
      }

      const tagsHtml = (doc.tags || [])
        .slice(0, 3)
        .map((t) => `<span class="reader-card-tag">#${escapeHtml(t)}</span>`)
        .join('');

      const progressBadge = prog
        ? prog.completed
          ? '<span class="reader-card-progress-pill is-done">已读完</span>'
          : prog.progress >= 0.04
          ? `<span class="reader-card-progress-pill is-reading">已阅 ${pct}%</span>`
          : ''
        : '';

      card.innerHTML = `
        <div class="reader-card-top">
          <div class="reader-card-badges">
            <span class="reader-card-cat">${escapeHtml(doc.category || '技术文档')}</span>
            ${assetCount > 0 ? `<span class="reader-card-asset-pill" title="已关联 ${assetCount} 张本地图片">含 ${assetCount} 图</span>` : ''}
            ${notesCount > 0 ? `<span class="reader-card-asset-pill" title="已有 ${notesCount} 条划线或批注">${notesCount} 条笔记</span>` : ''}
          </div>
          <div class="reader-card-actions" data-card-actions>
            <button type="button" class="reader-card-icon-btn" data-action="reimport" title="重导更新正文（保留笔记与书签）" aria-label="重导更新">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
            </button>
            <button type="button" class="reader-card-icon-btn" data-action="category" title="修改分类" aria-label="修改分类">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            </button>
            <button type="button" class="reader-card-icon-btn is-danger" data-action="delete" title="从本地书架移除" aria-label="删除文稿">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path></svg>
            </button>
          </div>
        </div>

        <h2 class="reader-card-title">${escapeHtml(doc.title)}</h2>
        <p class="reader-card-desc">${escapeHtml(doc.description || doc.fileName)}</p>

        ${tagsHtml ? `<div class="reader-card-tags">${tagsHtml}</div>` : ''}

        <div class="reader-card-footer">
          <div class="reader-card-meta">
            <span title="${escapeHtml(doc.fileName)}">${escapeHtml(doc.fileName)}</span>
            <span class="opacity-40">·</span>
            <span>${formatWordCount(doc.wordCount)} 字</span>
            <span class="opacity-40">·</span>
            <span>${doc.readingMinutes || 1} min</span>
          </div>
          <div class="reader-card-right">
            ${progressBadge || `<span class="reader-card-time">${formatRelativeTime(doc.lastOpenedAt || doc.updatedAt)}</span>`}
          </div>
        </div>
        ${prog && prog.progress >= 0.04 ? `<div class="reader-card-progress-track" aria-hidden="true"><span style="width:${Math.min(100, pct)}%"></span></div>` : ''}
      `;

      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const actionBtn = target.closest<HTMLButtonElement>('[data-action]');
        if (actionBtn) {
          e.stopPropagation();
          const act = actionBtn.dataset.action;
          if (act === 'delete') {
            if (confirm(`确认从本地书架移除《${doc.title}》吗？（你在 /notes 中保存的划线摘录不会被删除）`)) {
              deleteLocalDoc(doc.id).then(async () => {
                docs = await listLocalDocs();
                renderCategoryBar();
                renderShelf(true, false);
                showToast(`已移除《${doc.title}》`);
              });
            }
          } else if (act === 'reimport') {
            reimportTargetId = doc.id;
            reimportInput?.click();
          } else if (act === 'category') {
            const nextCat = prompt(`为《${doc.title}》设置分类（当前：${doc.category}）：`, doc.category);
            if (nextCat && nextCat.trim()) {
              const clean = nextCat.trim().slice(0, 24);
              if (!categories.includes(clean)) {
                categories = saveReaderCategories([...categories, clean]);
              }
              updateLocalDocMeta(doc.id, { category: clean }).then(async () => {
                docs = await listLocalDocs();
                renderCategoryBar();
                renderShelf(true, false);
                showToast(`已归入「${clean}」`);
              });
            }
          }
          return;
        }
        openDocument(doc.id, { pushHistory: true });
      }, { signal });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          if ((e.target as HTMLElement)?.closest('[data-card-actions]')) return;
          e.preventDefault();
          openDocument(doc.id, { pushHistory: true });
        }
      }, { signal });

      return card;
    }

    function bindPaperCards() {
      paperPhysicsCleanup?.();
      paperPhysicsCleanup = initPaperCardPhysics('#reader-shelf-grid [data-paper-card]');
    }

    function mountShelfCards(
      list: LocalReaderDocument[],
      progressBySlug: Map<string, ReadingProgressRecord>,
      notesCountBySlug: Map<string, number>,
      useInitialEnterAttr: boolean,
    ): HTMLElement[] {
      if (!shelfGrid) return [];
      const frag = document.createDocumentFragment();
      const mounted: HTMLElement[] = [];
      for (const doc of list) {
        const card = buildDocCardElement(doc, progressBySlug, notesCountBySlug, useInitialEnterAttr);
        frag.appendChild(card);
        mounted.push(card);
      }
      shelfGrid.innerHTML = '';
      shelfGrid.appendChild(frag);
      return mounted;
    }

    function renderShelf(animateTransition = false, isInitialEnter = false) {
      if (!shelfGrid || !emptyState) return;
      const { progressBySlug, notesCountBySlug } = buildShelfLookupSnapshot();
      updateStats(progressBySlug);

      const filtered = getFilteredDocs(progressBySlug);
      const reduceMotion = prefersReducedMotion();

      if (shelfFilterTimeline) {
        shelfFilterTimeline.kill();
        shelfFilterTimeline = null;
      }
      const existingCards = Array.from(shelfGrid.querySelectorAll<HTMLElement>('.reader-doc-card'));
      const currentH = shelfGrid.getBoundingClientRect().height;
      shelfGrid.style.minHeight = '';
      shelfGrid.style.paddingTop = '';
      shelfGrid.style.paddingBottom = '';

      if (!isInitialEnter) {
        emptyState.removeAttribute('data-enter');
        emptyState.dataset.enterState = 'in';
      }

      // 场景 0：首次加载或无动画模式
      if (!animateTransition || reduceMotion) {
        if (filtered.length === 0) {
          syncEmptyStateCopy();
          shelfGrid.innerHTML = '';
          shelfGrid.classList.add('is-empty');
          emptyState.classList.remove('hidden');
          clearCardMotion(emptyState);
          if (isInitialEnter && !reduceMotion) {
            emptyState.setAttribute('data-enter', 'card');
            emptyState.setAttribute('data-no-replay', '');
          }
          refreshScroll();
          return;
        }

        emptyState.classList.add('hidden');
        clearCardMotion(emptyState);
        shelfGrid.classList.remove('is-empty');
        mountShelfCards(filtered, progressBySlug, notesCountBySlug, isInitialEnter && !reduceMotion);
        bindPaperCards();
        refreshScroll();
        return;
      }

      // 场景 A：筛选无匹配（对齐 /notes & /mindmap 五段式空态收拢）
      if (filtered.length === 0) {
        syncEmptyStateCopy();

        if (existingCards.length === 0) {
          const wasAlreadyEmpty = !emptyState.classList.contains('hidden');
          shelfGrid.innerHTML = '';
          shelfGrid.classList.add('is-empty');
          emptyState.classList.remove('hidden');
          if (wasAlreadyEmpty) {
            clearCardMotion(emptyState);
            refreshScroll();
            return;
          }
          refreshScroll();
          setCardEnterState(emptyState, { replay: true });
          const tl = gsap.timeline({
            onComplete: () => {
              clearCardMotion(emptyState);
              refreshScroll();
              shelfFilterTimeline = null;
            },
          });
          shelfFilterTimeline = tl;
          addCardEnter(tl, emptyState, 0, { replay: true });
          return;
        }

        emptyState.classList.add('hidden');
        if (currentH > 0) shelfGrid.style.minHeight = `${currentH}px`;
        returnToFilterBar();

        const switchTime = cardExitDuration(existingCards.length);
        const tl = gsap.timeline({
          onComplete: () => {
            clearCardMotion(emptyState);
            refreshScroll();
            shelfFilterTimeline = null;
          },
        });
        shelfFilterTimeline = tl;

        addCardExit(tl, existingCards, 0);
        tl.add(() => {
          emptyState.classList.remove('hidden');
          shelfGrid.innerHTML = '';
          refreshScroll({ clamp: false });
        }, switchTime);

        setCardEnterState(emptyState, { replay: true });
        addCardEnter(tl, emptyState, switchTime, { replay: true });

        tl.to(shelfGrid, {
          paddingTop: 0,
          paddingBottom: 0,
          minHeight: 0,
          duration: 0.55,
          ease: 'power3.out',
          autoRound: false,
          onUpdate: () => refreshScroll({ clamp: false }),
          onComplete: () => {
            shelfGrid.style.minHeight = '0px';
            shelfGrid.classList.add('is-empty');
            shelfGrid.style.paddingTop = '';
            shelfGrid.style.paddingBottom = '';
            refreshScroll();
          },
        }, switchTime);
        return;
      }

      // 场景 B：有结果卡片 — 平滑退场换骨 + 3D 纸笺波浪入场
      const wasEmpty = !emptyState.classList.contains('hidden');
      if (currentH > 0) shelfGrid.style.minHeight = `${currentH}px`;
      returnToFilterBar();

      const exitDuration = wasEmpty ? 0.22 : cardExitDuration(existingCards.length);
      const tl = gsap.timeline({
        onComplete: () => {
          shelfGrid.style.minHeight = '';
          bindPaperCards();
          refreshScroll();
          shelfFilterTimeline = null;
        },
      });
      shelfFilterTimeline = tl;

      if (wasEmpty) {
        tl.to(emptyState, { opacity: 0, y: -8, duration: 0.22, ease: 'power2.in' }, 0);
      } else if (existingCards.length > 0) {
        addCardExit(tl, existingCards, 0);
      }

      tl.add(() => {
        emptyState.classList.add('hidden');
        clearCardMotion(emptyState);
        shelfGrid.classList.remove('is-empty');
        shelfGrid.style.minHeight = '';
        const newCards = mountShelfCards(filtered, progressBySlug, notesCountBySlug, false);
        setCardEnterState(newCards, { replay: true });
        const enterTl = gsap.timeline({
          onComplete: () => {
            newCards.forEach((c) => clearCardMotion(c));
            bindPaperCards();
            refreshScroll();
          },
        });
        addCardEnter(enterTl, newCards, 0, { replay: true });
      }, exitDuration);
    }

    // ---------- 同名冲突弹窗 Promise（带平滑进出场与 app:modal-enter） ----------

    function openAnimatedModal(backdrop: HTMLElement) {
      backdrop.hidden = false;
      backdrop.classList.remove('is-open');
      void backdrop.offsetWidth;
      backdrop.classList.add('is-open');
      notifyModalChange(1);
    }

    function closeAnimatedModal(backdrop: HTMLElement) {
      if (backdrop.hidden) return;
      backdrop.classList.remove('is-open');
      notifyModalChange(-1);
      if (prefersReducedMotion()) {
        backdrop.hidden = true;
      } else {
        window.setTimeout(() => {
          if (!backdrop.classList.contains('is-open')) backdrop.hidden = true;
        }, 200);
      }
    }

    function askDuplicateAction(existingTitle: string, fileName: string): Promise<'overwrite' | 'new' | 'skip'> {
      return new Promise((resolve) => {
        if (!dupModal || !dupDesc) {
          resolve('overwrite');
          return;
        }
        dupDesc.textContent = `书架中已存在同名文件「${fileName}」（当前标题：《${existingTitle}》）。你可以覆盖更新正文并保留已有的划线批注与书签，或者另存为一份新文稿。`;
        openAnimatedModal(dupModal);

        const finish = (choice: 'overwrite' | 'new' | 'skip') => {
          closeAnimatedModal(dupModal);
          dupModal.removeEventListener('click', onClick);
          window.removeEventListener('keydown', onKey);
          resolve(choice);
        };

        const onClick = (e: MouseEvent) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-dup-action]');
          if (btn) {
            const act = btn.dataset.dupAction as 'overwrite' | 'new' | 'skip';
            finish(act || 'skip');
          } else if (e.target === dupModal) {
            finish('skip');
          }
        };

        const onKey = (e: KeyboardEvent) => {
          if (e.key === 'Escape') {
            e.preventDefault();
            finish('skip');
          } else if (e.key === 'Tab') {
            trapModalFocus(dupModal, e);
          }
        };

        dupModal.addEventListener('click', onClick);
        window.addEventListener('keydown', onKey);
        dupModal.querySelector<HTMLButtonElement>('[data-dup-action="overwrite"]')?.focus();
      });
    }

    // ---------- 导入管线（单文件 / 多文件 / 文件夹 / 重导更新） ----------

    async function handleImportedFiles(items: ImportedFileItem[], opts: { targetDocId?: string } = {}) {
      if (!items.length) return;

      const mdItems = items.filter((it) => isSupportedMarkdownFileName(it.file.name));
      const imageItems = items.filter((it) => isSupportedImageFileName(it.file.name));

      if (!mdItems.length && imageItems.length > 0 && (opts.targetDocId || activeDoc)) {
        const targetId = opts.targetDocId || activeDoc!.id;
        const targetDoc = await getLocalDoc(targetId);
        if (targetDoc) {
          const assets: LocalReaderAssetInput[] = imageItems.map((it) => ({
            path: normalizeAssetPath(it.relativePath || it.file.name),
            fileName: it.file.name,
            mimeType: it.file.type || 'application/octet-stream',
            blob: it.file,
            size: it.file.size,
          }));
          await saveLocalDoc(targetDoc, assets, { replaceAssets: false });
          docs = await listLocalDocs();
          showToast(`已为《${targetDoc.title}》补充关联 ${assets.length} 张本地图片`);
          if (activeDoc && activeDoc.id === targetDoc.id) {
            await openDocument(targetDoc.id, { pushHistory: false, preserveScroll: true });
          } else {
            renderShelf(true, false);
          }
          return;
        }
      }

      if (!mdItems.length) {
        showToast('未检测到 .md / .markdown / .txt 文件');
        return;
      }

      const sharedAssets: LocalReaderAssetInput[] = imageItems.map((it) => ({
        path: normalizeAssetPath(it.relativePath || it.file.name),
        fileName: it.file.name,
        mimeType: it.file.type || 'application/octet-stream',
        blob: it.file,
        size: it.file.size,
      }));

      let lastImportedId: string | null = null;
      let importedCount = 0;
      let updatedCount = 0;

      for (const mdItem of mdItems) {
        const rawText = await mdItem.file.text();
        const relPath = normalizeAssetPath(mdItem.relativePath || mdItem.file.name);
        const docDir = dirnameOfPath(relPath);
        const topFolder = relPath.includes('/') ? relPath.split('/')[0] : '';
        const defaultCat = activeCategory !== 'all' ? activeCategory : '技术文档';
        const parsed = parseMarkdownDocument(rawText, mdItem.file.name, defaultCat);

        if (opts.targetDocId && mdItems.length === 1) {
          const existing = await getLocalDoc(opts.targetDocId);
          if (existing) {
            const updated: LocalReaderDocument = {
              ...existing,
              title: parsed.title,
              fileName: mdItem.file.name,
              docDir: docDir || existing.docDir,
              folderName: topFolder || existing.folderName,
              description: parsed.description,
              tags: parsed.tags.length ? parsed.tags : existing.tags,
              pubDate: parsed.pubDate || existing.pubDate,
              markdown: rawText,
              wordCount: parsed.wordCount,
              readingMinutes: parsed.readingMinutes,
              headings: parsed.headings,
              updatedAt: Date.now(),
            };
            await saveLocalDoc(updated, sharedAssets.length ? sharedAssets : undefined, {
              replaceAssets: false,
            });
            lastImportedId = updated.id;
            updatedCount += 1;
            continue;
          }
        }

        const dup = findDuplicateDocByFileName(docs, mdItem.file.name);
        let overwriteId: string | null = null;
        if (dup) {
          const decision = await askDuplicateAction(dup.title, mdItem.file.name);
          if (decision === 'skip') continue;
          if (decision === 'overwrite') overwriteId = dup.id;
        }

        const now = Date.now();
        if (overwriteId) {
          const existing = await getLocalDoc(overwriteId);
          if (existing) {
            const updated: LocalReaderDocument = {
              ...existing,
              title: parsed.title,
              docDir: docDir || existing.docDir,
              folderName: topFolder || existing.folderName,
              description: parsed.description,
              tags: parsed.tags.length ? parsed.tags : existing.tags,
              pubDate: parsed.pubDate || existing.pubDate,
              markdown: rawText,
              wordCount: parsed.wordCount,
              readingMinutes: parsed.readingMinutes,
              headings: parsed.headings,
              updatedAt: now,
            };
            await saveLocalDoc(updated, sharedAssets.length ? sharedAssets : undefined, {
              replaceAssets: sharedAssets.length > 0,
            });
            lastImportedId = updated.id;
            updatedCount += 1;
            continue;
          }
        }

        if (parsed.category && !categories.includes(parsed.category)) {
          categories = saveReaderCategories([...categories, parsed.category]);
        }

        const newDoc: LocalReaderDocument = {
          id: createLocalDocId(),
          title: parsed.title,
          fileName: mdItem.file.name,
          docDir,
          folderName: topFolder,
          category: parsed.category,
          tags: parsed.tags,
          description: parsed.description,
          pubDate: parsed.pubDate,
          markdown: rawText,
          wordCount: parsed.wordCount,
          readingMinutes: parsed.readingMinutes,
          headings: parsed.headings,
          assetPaths: [],
          createdAt: now,
          updatedAt: now,
          lastOpenedAt: now,
        };
        await saveLocalDoc(newDoc, sharedAssets, { replaceAssets: true });
        lastImportedId = newDoc.id;
        importedCount += 1;
      }

      docs = await listLocalDocs();
      renderCategoryBar();
      syncDocSwitcher();

      if (importedCount + updatedCount === 0) return;

      if (importedCount === 1 && updatedCount === 0 && lastImportedId) {
        showToast(sharedAssets.length ? `导入成功（已关联 ${sharedAssets.length} 张图片）` : '导入成功，正在展卷…');
        await openDocument(lastImportedId, { pushHistory: true });
      } else if (updatedCount === 1 && importedCount === 0 && lastImportedId) {
        showToast('已覆盖更新正文并保留原划线与书签');
        await openDocument(lastImportedId, { pushHistory: !activeDoc || activeDoc.id !== lastImportedId });
      } else {
        const msgParts = [];
        if (importedCount) msgParts.push(`新增 ${importedCount} 篇`);
        if (updatedCount) msgParts.push(`更新 ${updatedCount} 篇`);
        if (sharedAssets.length) msgParts.push(`关联 ${sharedAssets.length} 张图片`);
        showToast(`批量导入完成：${msgParts.join(' · ')}`);
        if (!activeDoc) renderShelf(true, false);
      }
    }

    // ---------- 目录 WAAPI 可打断展开/收拢（与 PostLayout 100% 对齐） ----------

    function bindSmoothToc(docSignal: AbortSignal) {
      if (!tocDetails || !tocExpander) return;
      const summary = tocDetails.querySelector<HTMLElement>('.post-toc-summary');
      if (!summary) return;

      let isOpening = false;
      let isClosing = false;
      let tocAnim: Animation | null = null;
      const layoutEase = readArticleMotion().layoutEase;

      summary.querySelectorAll('button, a, input').forEach((btn) => {
        btn.addEventListener('click', (event) => {
          event.stopPropagation();
          event.preventDefault();
          if (btn.matches('#post-toc-notes-btn, [data-article-notes-trigger]')) {
            if ((window as any).__articleHighlights?.openDrawer) {
              (window as any).__articleHighlights.openDrawer();
            } else {
              document.getElementById('article-highlights-floating-pill')?.click();
            }
          } else if (btn.matches('#post-toc-search-btn, [data-article-search-trigger]')) {
            (window as any).__articleSearch?.open?.();
          } else if (btn.matches('#post-toc-bookmarks-btn, [data-article-bookmarks-trigger]')) {
            (window as any).__readingBookmarks?.openPopover?.();
          }
        }, { signal: docSignal });
      });

      summary.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest('button, a, input, [role="button"]')) {
          event.preventDefault();
          event.stopPropagation();
          return;
        }
        event.preventDefault();

        if (prefersReducedMotion()) {
          tocAnim?.cancel();
          tocAnim = null;
          isOpening = false;
          isClosing = false;
          tocDetails.open = !tocDetails.open;
          tocDetails.classList.toggle('is-collapsed', !tocDetails.open);
          tocExpander.style.height = '';
          tocExpander.style.overflow = '';
          tocExpander.style.opacity = '';
          refreshScroll();
          return;
        }

        const shouldOpen = isClosing || (!isOpening && !tocDetails.open);
        if (shouldOpen) {
          isClosing = false;
          isOpening = true;
          let currentH = 0;
          let currentOp = 0;
          if (tocAnim) {
            currentH = tocExpander.getBoundingClientRect().height;
            currentOp = parseFloat(getComputedStyle(tocExpander).opacity) || 0;
            tocAnim.onfinish = null;
            tocAnim.oncancel = null;
            tocAnim.cancel();
            tocAnim = null;
          }
          tocDetails.open = true;
          tocDetails.classList.remove('is-collapsed');
          tocExpander.style.overflow = 'hidden';
          const targetH = tocExpander.scrollHeight;
          const frac = targetH > 0 ? (targetH - currentH) / targetH : 1;
          const baseMs = Math.min(480, Math.max(300, 250 + targetH * 0.32));
          const duration = Math.max(180, Math.round(baseMs * Math.min(1, Math.max(0.24, frac))));

          tocAnim = tocExpander.animate(
            [{ height: `${currentH}px`, opacity: currentOp }, { height: `${targetH}px`, opacity: 1 }],
            { duration, easing: layoutEase },
          );
          tocAnim.onfinish = () => {
            isOpening = false;
            tocAnim = null;
            tocExpander.style.height = '';
            tocExpander.style.overflow = '';
            tocExpander.style.opacity = '';
            refreshScroll();
          };
          tocAnim.oncancel = () => {
            isOpening = false;
          };
        } else {
          isOpening = false;
          isClosing = true;
          const currentH = tocExpander.getBoundingClientRect().height;
          const currentOp = tocAnim ? parseFloat(getComputedStyle(tocExpander).opacity) || 1 : 1;
          if (tocAnim) {
            tocAnim.onfinish = null;
            tocAnim.oncancel = null;
            tocAnim.cancel();
            tocAnim = null;
          }
          tocDetails.classList.add('is-collapsed');
          tocExpander.style.overflow = 'hidden';
          const duration = Math.min(420, Math.max(220, Math.round(210 + currentH * 0.24)));

          tocAnim = tocExpander.animate(
            [{ height: `${currentH}px`, opacity: currentOp }, { height: '0px', opacity: 0 }],
            { duration, easing: layoutEase },
          );
          tocAnim.onfinish = () => {
            isClosing = false;
            tocAnim = null;
            tocDetails.open = false;
            tocExpander.style.height = '';
            tocExpander.style.overflow = '';
            tocExpander.style.opacity = '';
            refreshScroll();
          };
          tocAnim.oncancel = () => {
            isClosing = false;
          };
        }
      }, { signal: docSignal });

      docSignal.addEventListener('abort', () => {
        tocAnim?.cancel();
        tocAnim = null;
      });
    }

    // ---------- 正文交互与 120fps 书斋动效增强（零 scroll 重排！） ----------

    function enhanceReaderProse(proseEl: HTMLElement, docSignal: AbortSignal) {
      const COPY_SVG =
        '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
      const CHECK_SVG =
        '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';

      const reduceMotion = prefersReducedMotion();
      const motion = readArticleMotion();

      // 1. 单次宣纸显形（对齐 PostLayout .prose .pr + H2 书法墨线自左向右铺展）
      const blocks = Array.from(proseEl.children) as HTMLElement[];
      blocks.forEach((el) => {
        const kind = el.dataset.pr || revealKind(el);
        el.dataset.pr = kind;
        el.classList.add('pr');
        if (kind === 'table') el.querySelectorAll('tr').forEach((row, i) => row.style.setProperty('--i', String(Math.min(i, 3))));
        if (kind === 'list') Array.from(el.children).forEach((li, i) => (li as HTMLElement).style.setProperty('--i', String(Math.min(i, 3))));
      });

      if (reduceMotion) {
        blocks.forEach((el) => el.classList.add('is-in'));
      } else {
        const revealIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              if (el.classList.contains('is-in')) {
                revealIo.unobserve(el);
                return;
              }
              if (entry.boundingClientRect.top < 0) {
                el.classList.add('pr-instant', 'is-in');
                requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('pr-instant')));
              } else {
                el.classList.add('is-in');
              }
              revealIo.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -4% 0px', threshold: 0 },
        );
        blocks.forEach((el) => revealIo.observe(el));
        docSignal.addEventListener('abort', () => revealIo.disconnect());

        // 首屏块延迟一帧柔和显形，保证过渡可见不瞬间跳过
        requestAnimationFrame(() => {
          if (docSignal.aborted) return;
          const vh = window.innerHeight || 800;
          blocks.forEach((el, idx) => {
            if (el.classList.contains('is-in')) return;
            const r = el.getBoundingClientRect();
            if ((r.top < vh * 0.96 && r.bottom > 0) || (idx < 3 && r.top < vh)) {
              el.classList.add('is-in');
              revealIo.unobserve(el);
            } else if (r.bottom <= 0 && r.top !== 0) {
              el.classList.add('pr-instant', 'is-in');
              revealIo.unobserve(el);
              requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('pr-instant')));
            }
          });
        });
      }

      // 2. 代码块工具栏 + WAAPI 平滑折叠/展开（对齐 PostLayout）
      proseEl.querySelectorAll('pre').forEach((pre) => {
        if (pre.dataset.codeEnhanced === 'true') return;
        if (pre.closest('.mermaid-block')) return;
        const code = pre.querySelector('code');
        if (!code) return;
        pre.dataset.codeEnhanced = 'true';

        const className = code.className || '';
        const langMatch = className.match(/(?:language|lang)-([a-z0-9_+#.-]+)/i);
        const language = (langMatch?.[1] || pre.getAttribute('data-language') || 'code').toLowerCase();

        const toolbar = document.createElement('div');
        toolbar.className = 'code-block-toolbar';

        const fileName = pre.getAttribute('data-title');
        if (fileName) {
          toolbar.dataset.titled = 'true';
          const titleEl = document.createElement('span');
          titleEl.className = 'code-block-title';
          titleEl.textContent = fileName;
          toolbar.appendChild(titleEl);
        }

        const label = document.createElement('span');
        label.className = 'code-block-language';
        label.textContent = language;

        const lineElements = code.querySelectorAll('.line');
        const lineCount = lineElements.length || (code.textContent || '').replace(/\n$/, '').split('\n').length;

        let collapseButton: HTMLButtonElement | null = null;
        let expandVeil: HTMLDivElement | null = null;
        let collapseAnim: Animation | null = null;

        const setCollapsed = (collapsed: boolean) => {
          const COLLAPSED_H = 240;
          const startH = pre.getBoundingClientRect().height;
          if (collapseAnim) {
            collapseAnim.onfinish = null;
            collapseAnim.oncancel = null;
            collapseAnim.cancel();
            collapseAnim = null;
          }
          pre.style.maxHeight = '';
          if (collapsed) {
            pre.classList.add('is-code-collapsed');
            if (collapseButton) {
              collapseButton.innerHTML = `<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg><span>展开 (${lineCount}行)</span>`;
              collapseButton.setAttribute('aria-expanded', 'false');
            }
            if (expandVeil) expandVeil.hidden = false;
            if (!reduceMotion && startH > COLLAPSED_H) {
              const duration = Math.round(Math.min(480, Math.max(260, 220 + (startH - COLLAPSED_H) * 0.2)));
              collapseAnim = pre.animate(
                [{ maxHeight: `${startH}px` }, { maxHeight: `${COLLAPSED_H}px` }],
                { duration, easing: motion.layoutEase },
              );
              collapseAnim.onfinish = () => {
                collapseAnim = null;
                pre.style.maxHeight = '';
                refreshScroll();
              };
            }
          } else {
            pre.classList.remove('is-code-collapsed');
            if (collapseButton) {
              collapseButton.innerHTML = `<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"></polyline></svg><span>折叠 (${lineCount}行)</span>`;
              collapseButton.setAttribute('aria-expanded', 'true');
            }
            if (expandVeil) expandVeil.hidden = true;
            const endH = pre.scrollHeight;
            if (!reduceMotion && endH > startH) {
              const duration = Math.round(Math.min(540, Math.max(280, 240 + (endH - startH) * 0.22)));
              collapseAnim = pre.animate(
                [{ maxHeight: `${startH}px` }, { maxHeight: `${endH}px` }],
                { duration, easing: motion.layoutEase },
              );
              collapseAnim.onfinish = () => {
                collapseAnim = null;
                pre.style.maxHeight = '';
                refreshScroll();
              };
            }
          }
        };

        if (lineCount > 18) {
          pre.dataset.lineCount = String(lineCount);
          collapseButton = document.createElement('button');
          collapseButton.className = 'code-collapse-button';
          collapseButton.type = 'button';
          collapseButton.setAttribute('aria-expanded', 'true');
          collapseButton.innerHTML = `<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"></polyline></svg><span>折叠 (${lineCount}行)</span>`;
          collapseButton.addEventListener('click', () => {
            setCollapsed(!pre.classList.contains('is-code-collapsed'));
          }, { signal: docSignal });

          expandVeil = document.createElement('div');
          expandVeil.className = 'code-expand-veil';
          expandVeil.hidden = true;
          const veilBtn = document.createElement('button');
          veilBtn.type = 'button';
          veilBtn.className = 'code-expand-veil-btn';
          veilBtn.innerHTML = `<span>展开全部 ${lineCount} 行代码</span><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>`;
          veilBtn.addEventListener('click', () => setCollapsed(false), { signal: docSignal });
          expandVeil.appendChild(veilBtn);
        }

        const copyButton = document.createElement('button');
        copyButton.className = 'code-copy-button';
        copyButton.type = 'button';
        copyButton.innerHTML = `${COPY_SVG}<span>Copy</span>`;
        copyButton.setAttribute('aria-label', '复制代码');
        let copyTimer = 0;

        copyButton.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code.textContent || '');
            window.clearTimeout(copyTimer);
            copyButton.classList.remove('is-copied');
            void copyButton.offsetWidth;
            copyButton.classList.add('is-copied');
            copyButton.innerHTML = `${CHECK_SVG}<span>已复制</span>`;
            copyTimer = window.setTimeout(() => {
              copyButton.classList.remove('is-copied');
              copyButton.innerHTML = `${COPY_SVG}<span>Copy</span>`;
            }, 1600);
          } catch {}
        }, { signal: docSignal });

        if (!pre.id) {
          pre.id = `reader-code-${Math.random().toString(36).slice(2, 9)}`;
        }
        const pinButton = document.createElement('button');
        pinButton.className = 'code-pin-button';
        pinButton.type = 'button';
        pinButton.setAttribute('aria-label', '钉住对照');
        pinButton.title = '钉到分屏工作台对照';
        pinButton.setAttribute('data-pin-btn', 'true');
        pinButton.setAttribute('data-pin-id', pre.id);
        pinButton.innerHTML = `
          <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="17" x2="12" y2="22"></line>
            <path d="M5 17h14v-2l-2-2V5a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v8l-2 2v2z"></path>
          </svg>
          <span>Pin</span>
        `;

        if (collapseButton) toolbar.append(label, collapseButton, copyButton, pinButton);
        else toolbar.append(label, copyButton, pinButton);

        pre.prepend(toolbar);
        if (expandVeil) pre.appendChild(expandVeil);
      });

      // 3. 章节标题锚点自复制 + 水墨轻拂高亮
      const pulseHeading = (el: HTMLElement) => {
        el.classList.remove('is-anchor-target');
        void el.offsetWidth;
        el.classList.add('is-anchor-target');
        window.setTimeout(() => el.classList.remove('is-anchor-target'), 1100);
      };

      proseEl.querySelectorAll<HTMLElement>('h2[id], h3[id]').forEach((heading) => {
        if (heading.dataset.anchorEnhanced === 'true') return;
        heading.dataset.anchorEnhanced = 'true';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'heading-anchor-btn';
        btn.setAttribute('aria-label', '复制本节链接');
        btn.title = '复制章节锚点链接';
        btn.textContent = '#';
        btn.addEventListener('click', async (e) => {
          e.stopPropagation();
          e.preventDefault();
          const url = `${window.location.origin}${window.location.pathname}${window.location.search}#${encodeURIComponent(heading.id)}`;
          try {
            await navigator.clipboard.writeText(url);
            btn.classList.add('is-copied');
            btn.textContent = '✓';
            showToast('已复制章节定位链接');
            window.setTimeout(() => {
              btn.classList.remove('is-copied');
              btn.textContent = '#';
            }, 1400);
          } catch {}
          pulseHeading(heading);
        }, { signal: docSignal });
        heading.appendChild(btn);
      });

      // 4. 文内锚点平滑滚动
      proseEl.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const anchor = event.target instanceof Element ? event.target.closest('a[href^="#"]') : null;
        if (!anchor) return;
        const href = anchor.getAttribute('href') || '';
        if (href.length <= 1) return;
        const targetId = decodeURIComponent(href.slice(1));
        const targetEl = document.getElementById(targetId) || proseEl.querySelector<HTMLElement>(`#${CSS.escape(targetId)}`);
        if (targetEl) {
          event.preventDefault();
          if ((window as any).lenis) (window as any).lenis.scrollTo(targetEl, { offset: -76 });
          else targetEl.scrollIntoView({ behavior: 'smooth' });
          pulseHeading(targetEl);
        }
      }, { signal: docSignal });

      // 5. TOC ScrollSpy
      if (tocObserver) {
        tocObserver.disconnect();
        tocObserver = null;
      }
      const tocLinks = Array.from(tocNav?.querySelectorAll<HTMLAnchorElement>('.post-toc-link') || []);
      const headingEls = Array.from(proseEl.querySelectorAll<HTMLElement>('h2[id], h3[id]'));
      if (tocLinks.length > 0 && headingEls.length > 0) {
        const linkById = new Map(tocLinks.map((a) => [a.dataset.tocLink || '', a]));
        const setActiveToc = (id: string) => {
          tocLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.tocLink === id));
        };
        tocObserver = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((en) => en.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible[0]?.target?.id && linkById.has(visible[0].target.id)) {
              setActiveToc(visible[0].target.id);
            }
          },
          { rootMargin: '-80px 0px -68% 0px', threshold: 0 },
        );
        headingEls.forEach((h) => tocObserver?.observe(h));
      }

      // 6. 左侧水墨书脊（H2 节点光晕 + 零 scroll 重排阻尼笔触进度线）
      if (postBodyEl && spineEl && spineLine) {
        spineEl.querySelectorAll('.post-spine-dot').forEach((n) => n.remove());
        const h2s = Array.from(proseEl.querySelectorAll<HTMLElement>('h2'));
        const dots: HTMLElement[] = [];
        h2s.forEach(() => {
          const dot = document.createElement('i');
          dot.className = 'post-spine-dot';
          spineEl.appendChild(dot);
          dots.push(dot);
        });

        let cachedBodyTop = 0;
        let cachedBodyHeight = 1;
        let cachedViewportH = window.innerHeight || 800;

        const measureSpineGeometry = () => {
          if (docSignal.aborted || !postBodyEl.isConnected) return;
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const bodyRect = postBodyEl.getBoundingClientRect();
          cachedBodyTop = bodyRect.top + scrollY;
          cachedBodyHeight = Math.max(1, bodyRect.height);
          cachedViewportH = window.innerHeight || 800;

          // 只读阶段批量测量全部 h2 坐标，再统一写 top，杜绝交错重排
          const tops = h2s.map((h2) => Math.round(h2.getBoundingClientRect().top - bodyRect.top + 14));
          tops.forEach((top, i) => {
            if (dots[i]) dots[i].style.top = `${top}px`;
          });
        };

        let targetDash = 1;
        let currentDash = 1;
        let spineRaf = 0;
        spineLine.style.strokeDashoffset = reduceMotion ? '0' : '1';

        const stepSpine = () => {
          spineRaf = 0;
          if (docSignal.aborted) return;
          const diff = targetDash - currentDash;
          if (Math.abs(diff) <= 0.0015 || reduceMotion) {
            currentDash = targetDash;
            spineLine.style.strokeDashoffset = currentDash.toFixed(4);
            return;
          }
          currentDash += diff * 0.24;
          spineLine.style.strokeDashoffset = currentDash.toFixed(4);
          spineRaf = requestAnimationFrame(stepSpine);
        };

        const onScrollSpine = () => {
          // 纯数学计算，scroll 期间 0 次 DOM 几何读取！
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const startY = cachedBodyTop - cachedViewportH * 0.65;
          const endY = cachedBodyTop + cachedBodyHeight - cachedViewportH * 0.55;
          const span = Math.max(1, endY - startY);
          const progress = Math.max(0, Math.min(1, (scrollY - startY) / span));
          targetDash = 1 - progress;
          if (!spineRaf && !docSignal.aborted) {
            spineRaf = requestAnimationFrame(stepSpine);
          }
        };

        const litIo = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const index = h2s.indexOf(entry.target as HTMLElement);
              const dot = dots[index];
              if (!dot) return;
              dot.classList.toggle('is-lit', entry.isIntersecting || entry.boundingClientRect.top < 0);
            });
          },
          { rootMargin: '-32% 0px -32% 0px' },
        );
        h2s.forEach((h) => litIo.observe(h));

        let roTimer = 0;
        const ro = new ResizeObserver(() => {
          window.clearTimeout(roTimer);
          roTimer = window.setTimeout(() => {
            measureSpineGeometry();
            onScrollSpine();
          }, 160);
        });
        ro.observe(proseEl);

        requestAnimationFrame(() => {
          measureSpineGeometry();
          onScrollSpine();
        });

        window.addEventListener('scroll', onScrollSpine, { passive: true, signal: docSignal });
        window.addEventListener('resize', () => {
          measureSpineGeometry();
          onScrollSpine();
        }, { passive: true, signal: docSignal });

        docSignal.addEventListener('abort', () => {
          if (spineRaf) cancelAnimationFrame(spineRaf);
          window.clearTimeout(roTimer);
          litIo.disconnect();
          ro.disconnect();
        });
      }

      // 7. 绑定平滑目录折叠
      bindSmoothToc(docSignal);
    }

    // ---------- 舞台入场微动效（纯 GPU WAAPI，零重排） ----------

    function playStageEntrance() {
      if (prefersReducedMotion()) return;
      const revealEase = readArticleMotion().revealEase;
      const targets = [stageBar, stageHeader, tocDetails, postBodyEl].filter(
        (el): el is HTMLElement => Boolean(el && !el.hidden),
      );
      targets.forEach((el, idx) => {
        if (typeof el.animate !== 'function') return;
        el.animate(
          [
            { opacity: 0, transform: 'translate3d(0, 14px, 0)' },
            { opacity: 1, transform: 'translate3d(0, 0, 0)' },
          ],
          {
            duration: 420,
            delay: idx * 55,
            easing: revealEase,
            fill: 'backwards',
          },
        );
      });
    }

    // ---------- 打开 / 关闭阅读视图 ----------

    interface OpenDocOptions {
      pushHistory?: boolean;
      preserveScroll?: boolean;
      resume?: boolean;
      bookmarkId?: string;
      highlightId?: string;
    }

    async function openDocument(docId: string, opts: OpenDocOptions = {}) {
      const token = ++openToken;
      const doc = await getLocalDoc(docId);
      if (signal.aborted || token !== openToken) return;
      if (!doc) {
        showToast('未在本地书架找到该文稿（可能仅保存在另一台设备上）');
        closeDocument({ pushHistory: false });
        return;
      }

      const savedScrollY = opts.preserveScroll ? window.scrollY : 0;

      // 清理旧文档与定时任务
      window.clearTimeout(companionPhaseTimer);
      window.clearTimeout(deepLinkTimer);
      proseController?.abort();
      proseController = new AbortController();
      const docSignal = proseController.signal;
      revokeActiveAssetUrls();
      paperPhysicsCleanup?.();
      paperPhysicsCleanup = null;

      activeDoc = doc;
      updateLocalDocMeta(doc.id, { lastOpenedAt: Date.now() }).catch(() => {});

      const parsed = parseMarkdownDocument(doc.markdown, doc.fileName, doc.category);
      const usedLangs = detectCodeLanguages(parsed.body);

      // 并行加载本地图片 Blob 与本文档实际用到的少数 highlight.js 语言包
      const [assets, hljs] = await Promise.all([
        getDocAssets(doc.id),
        usedLangs.length > 0 ? loadCodeHighlighter(usedLangs) : Promise.resolve(null),
      ]);
      if (signal.aborted || token !== openToken) return;

      const assetUrlMap = new Map<string, string>();
      for (const a of assets) {
        if (a.blob) {
          const url = URL.createObjectURL(a.blob);
          activeObjectUrls.push(url);
          assetUrlMap.set(a.normalizedPath, url);
        }
      }

      const rendered = renderLocalMarkdownBody(parsed.body, {
        docDir: doc.docDir,
        assetUrlMap,
        highlighter: hljs,
      });

      // 切换视图
      shelfView.hidden = true;
      stageView.hidden = false;

      // 填充头部元数据
      if (metaDateEl) metaDateEl.textContent = doc.pubDate || new Date(doc.updatedAt).toISOString().slice(0, 10);
      if (metaCategoryEl) metaCategoryEl.textContent = doc.category || '技术文档';
      if (metaMinutesEl) metaMinutesEl.textContent = `${doc.readingMinutes || 1} min read`;
      if (metaBadgeEl) {
        metaBadgeEl.textContent = assets.length > 0 ? `本地文稿 · ${assets.length} 图` : '本地文稿';
      }
      if (docTitleEl) docTitleEl.textContent = doc.title;
      document.title = `${doc.title} - Reader - 梦付千秋`;

      if (docDescEl) {
        if (doc.description) {
          docDescEl.textContent = doc.description;
          docDescEl.hidden = false;
        } else {
          docDescEl.hidden = true;
        }
      }

      if (docTagsWrap && docTagsEl) {
        if (doc.tags && doc.tags.length > 0) {
          docTagsEl.innerHTML = doc.tags
            .map((tag) => `<span class="tag-chip">#${escapeHtml(tag)}</span>`)
            .join('');
          docTagsWrap.hidden = false;
        } else {
          docTagsEl.innerHTML = '';
          docTagsWrap.hidden = true;
        }
      }

      // 缺失图片提示条
      if (missingBanner && missingText) {
        if (rendered.missingAssets.length > 0) {
          missingText.textContent = `文中引用了 ${rendered.missingAssets.length} 处本地图片尚未关联（如 ${rendered.missingAssets[0]}），点击右侧可补充上传并立即显示。`;
          missingBanner.hidden = false;
        } else {
          missingBanner.hidden = true;
        }
      }

      // 渲染目录 TOC
      const tocHeadings = rendered.headings.filter((h) => h.depth >= 2 && h.depth <= 3);
      if (tocDetails && tocNav && tocCountEl) {
        tocCountEl.textContent = `${tocHeadings.length} 节`;
        if (tocHeadings.length > 0) {
          tocDetails.open = true;
          tocDetails.classList.remove('is-collapsed');
          tocNav.innerHTML = tocHeadings
            .map(
              (h) => `
              <a href="#${escapeHtml(h.slug)}" class="post-toc-link depth-${h.depth}" data-toc-link="${escapeHtml(h.slug)}">
                <span class="toc-bullet"></span>
                <span class="toc-text">${escapeHtml(h.text)}</span>
              </a>
            `,
            )
            .join('');
          tocNav.querySelectorAll<HTMLAnchorElement>('.post-toc-link').forEach((link) => {
            link.addEventListener('click', (e) => {
              e.preventDefault();
              const id = link.dataset.tocLink || '';
              const el = document.getElementById(id);
              if (el) {
                if ((window as any).lenis) (window as any).lenis.scrollTo(el, { offset: -76 });
                else el.scrollIntoView({ behavior: 'smooth' });
                el.classList.remove('is-anchor-target');
                void el.offsetWidth;
                el.classList.add('is-anchor-target');
                window.setTimeout(() => el.classList.remove('is-anchor-target'), 1100);
              }
            }, { signal: docSignal });
          });
          tocDetails.hidden = false;
        } else {
          tocNav.innerHTML = '';
          tocDetails.hidden = true;
        }
      }

      // 写入正文与虚拟文章 Slug
      const virtualSlug = buildLocalReaderSlug(doc.id);
      prose.innerHTML = rendered.html;
      prose.dataset.articleSlug = virtualSlug;

      (window as any).__localReaderActiveDoc = () => ({
        id: doc.id,
        title: doc.title,
        content: extractStructuredTextFromProse(prose),
      });

      // Phase 1：正文动效与工具栏增强 + 舞台展卷入场
      enhanceReaderProse(prose, docSignal);
      syncDocSwitcher();
      if (!opts.preserveScroll) {
        window.scrollTo({ top: 0 });
        playStageEntrance();
      } else {
        window.scrollTo({ top: savedScrollY });
      }

      // 同步 URL
      if (opts.pushHistory) {
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.set('doc', doc.id);
        nextUrl.searchParams.delete('resume');
        nextUrl.searchParams.delete('bm');
        nextUrl.searchParams.delete('noteId');
        window.history.pushState({ readerDocId: doc.id }, '', nextUrl.pathname + nextUrl.search);
      }

      // Phase 2（下一帧）：挂载核心伴读（划线批注 / 夹签续读 / 文内搜索），避免同帧布局风暴
      requestAnimationFrame(() => {
        if (docSignal.aborted || token !== openToken) return;
        document.dispatchEvent(
          new CustomEvent('reader:doc-change', { detail: { docId: doc.id, slug: virtualSlug, phase: 'core' } }),
        );
        refreshScroll({ clamp: false });

        // 处理深链定位：划线高亮 / 夹签 / 续读
        const urlHash = window.location.hash || '';
        const hashHighlightId = urlHash.startsWith('#highlight-')
          ? decodeURIComponent(urlHash.slice('#highlight-'.length))
          : '';
        const targetHighlightId = opts.highlightId || hashHighlightId;

        if (targetHighlightId || opts.bookmarkId || opts.resume) {
          deepLinkTimer = window.setTimeout(() => {
            if (docSignal.aborted || token !== openToken) return;
            if (targetHighlightId) {
              (window as any).__articleNotes?.jumpToHighlight?.(targetHighlightId);
            } else if (opts.bookmarkId) {
              (window as any).__readingBookmarks?.jumpToBookmark?.(opts.bookmarkId);
            } else if (opts.resume) {
              (window as any).__readingBookmarks?.resumeProgress?.();
            }
          }, 180);
        }
      });

      // Phase 3（错峰挂载）：钉板 / 墨问 AI / Mermaid 渲染，与入场帧彻底错开实现满帧丝滑
      companionPhaseTimer = window.setTimeout(() => {
        if (docSignal.aborted || token !== openToken) return;
        document.dispatchEvent(
          new CustomEvent('reader:doc-change', { detail: { docId: doc.id, slug: virtualSlug, phase: 'companion' } }),
        );
      }, 130);
    }

    function closeDocument(opts: { pushHistory?: boolean } = {}) {
      openToken += 1;
      window.clearTimeout(companionPhaseTimer);
      window.clearTimeout(deepLinkTimer);
      proseController?.abort();
      proseController = null;
      if (tocObserver) {
        tocObserver.disconnect();
        tocObserver = null;
      }
      revokeActiveAssetUrls();
      activeDoc = null;
      (window as any).__localReaderActiveDoc = null;

      prose.dataset.articleSlug = '__inactive__';
      prose.innerHTML = '';
      stageView.hidden = true;
      shelfView.hidden = false;
      document.title = 'Reader - 梦付千秋';

      // 不传 phase -> 所有 6 大伴读组件同步退回静默态
      document.dispatchEvent(new CustomEvent('reader:doc-change', { detail: { docId: null, slug: '__inactive__' } }));

      if (opts.pushHistory) {
        const nextUrl = new URL(window.location.href);
        nextUrl.searchParams.delete('doc');
        nextUrl.searchParams.delete('resume');
        nextUrl.searchParams.delete('bm');
        nextUrl.searchParams.delete('noteId');
        window.history.pushState({ readerDocId: null }, '', nextUrl.pathname + nextUrl.search);
      }

      listLocalDocs().then((loaded) => {
        if (signal.aborted) return;
        docs = loaded;
        renderCategoryBar();
        renderShelf(true, false);
        window.scrollTo({ top: 0 });
        refreshScroll();
      });
    }

    // 暴露给 BaseLayout ⌘K 同页秒切
    (window as any).__localReaderOpenDoc = (
      docId: string,
      opts?: { resume?: boolean; bookmarkId?: string; highlightId?: string },
    ) => {
      openDocument(docId, {
        pushHistory: true,
        resume: opts?.resume,
        bookmarkId: opts?.bookmarkId,
        highlightId: opts?.highlightId,
      });
    };

    // ---------- 事件绑定 ----------

    initStatsGlider();

    importFilesBtn?.addEventListener('click', () => fileInput?.click(), { signal });
    emptyImportBtn?.addEventListener('click', () => fileInput?.click(), { signal });
    importFolderBtn?.addEventListener('click', () => folderInput?.click(), { signal });

    fileInput?.addEventListener('change', async () => {
      const files = Array.from(fileInput.files || []).map((file) => ({ file, relativePath: file.name }));
      fileInput.value = '';
      await handleImportedFiles(files);
    }, { signal });

    folderInput?.addEventListener('change', async () => {
      const files = Array.from(folderInput.files || []).map((file) => ({
        file,
        relativePath: (file as any).webkitRelativePath || file.name,
      }));
      folderInput.value = '';
      await handleImportedFiles(files);
    }, { signal });

    reimportInput?.addEventListener('change', async () => {
      const files = Array.from(reimportInput.files || []).map((file) => ({ file, relativePath: file.name }));
      reimportInput.value = '';
      const targetId = reimportTargetId || activeDoc?.id || undefined;
      reimportTargetId = null;
      await handleImportedFiles(files, { targetDocId: targetId });
    }, { signal });

    assetsInput?.addEventListener('change', async () => {
      const files = Array.from(assetsInput.files || []).map((file) => ({ file, relativePath: file.name }));
      assetsInput.value = '';
      if (activeDoc) {
        await handleImportedFiles(files, { targetDocId: activeDoc.id });
      }
    }, { signal });

    loadSampleBtn?.addEventListener('click', async () => {
      const parsed = parseMarkdownDocument(SAMPLE_READER_MARKDOWN, 'local-reader-guide.md', '技术文档');
      const now = Date.now();
      const sampleDoc: LocalReaderDocument = {
        id: createLocalDocId(),
        title: parsed.title,
        fileName: 'local-reader-guide.md',
        docDir: '',
        folderName: '',
        category: parsed.category,
        tags: parsed.tags,
        description: parsed.description,
        pubDate: parsed.pubDate,
        markdown: SAMPLE_READER_MARKDOWN,
        wordCount: parsed.wordCount,
        readingMinutes: parsed.readingMinutes,
        headings: parsed.headings,
        assetPaths: [],
        createdAt: now,
        updatedAt: now,
        lastOpenedAt: now,
      };
      await saveLocalDoc(sampleDoc);
      docs = await listLocalDocs();
      renderCategoryBar();
      syncDocSwitcher();
      showToast('已载入示例文稿，开始体验吧');
      await openDocument(sampleDoc.id, { pushHistory: true });
    }, { signal });

    addCatBtn?.addEventListener('click', () => {
      const name = prompt('输入新的书架分类名称（最多 12 字）：');
      if (!name || !name.trim()) return;
      const clean = name.trim().slice(0, 12);
      categories = saveReaderCategories([...categories, clean]);
      activeCategory = clean;
      renderCategoryBar();
      renderShelf(true, false);
      showToast(`已创建分类「${clean}」`);
    }, { signal });

    // 搜索防抖（120ms），消除每次击键全量重排
    searchInput?.addEventListener('input', () => {
      searchKeyword = searchInput.value;
      window.clearTimeout(searchDebounceTimer);
      searchDebounceTimer = window.setTimeout(() => {
        renderShelf(true, false);
      }, 120);
    }, { signal });

    sortSelect?.addEventListener('change', () => {
      sortMode = sortSelect.value;
      renderShelf(true, false);
    }, { signal });

    // 粘贴新建弹窗
    const closePasteModal = () => {
      if (!pasteModal) return;
      closeAnimatedModal(pasteModal);
      lastModalTrigger?.focus();
    };

    pasteBtn?.addEventListener('click', () => {
      if (!pasteModal) return;
      lastModalTrigger = pasteBtn;
      if (pasteTitleInput) pasteTitleInput.value = '';
      if (pasteContentInput) pasteContentInput.value = '';
      openAnimatedModal(pasteModal);
      pasteContentInput?.focus();
    }, { signal });

    pasteModal?.addEventListener('click', (e) => {
      if (e.target === pasteModal || (e.target as HTMLElement).closest('[data-modal-close]')) {
        closePasteModal();
      }
    }, { signal });

    pasteForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const raw = pasteContentInput?.value || '';
      if (!raw.trim()) return;
      const customTitle = pasteTitleInput?.value.trim() || '';
      const chosenCat = pasteCatSelect?.value || '技术文档';
      const fileName = `${(customTitle || 'pasted-note').replace(/[\\/:*?"<>|]+/g, '-').slice(0, 48)}.md`;
      const parsed = parseMarkdownDocument(raw, fileName, chosenCat);
      const now = Date.now();
      const newDoc: LocalReaderDocument = {
        id: createLocalDocId(),
        title: customTitle || parsed.title,
        fileName,
        docDir: '',
        folderName: '',
        category: chosenCat || parsed.category,
        tags: parsed.tags,
        description: parsed.description,
        pubDate: parsed.pubDate,
        markdown: raw,
        wordCount: parsed.wordCount,
        readingMinutes: parsed.readingMinutes,
        headings: parsed.headings,
        assetPaths: [],
        createdAt: now,
        updatedAt: now,
        lastOpenedAt: now,
      };
      await saveLocalDoc(newDoc);
      docs = await listLocalDocs();
      renderCategoryBar();
      syncDocSwitcher();
      closePasteModal();
      showToast('已保存到本地书架');
      await openDocument(newDoc.id, { pushHistory: true });
    }, { signal });

    window.addEventListener('keydown', (e) => {
      if (pasteModal && !pasteModal.hidden) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closePasteModal();
        } else if (e.key === 'Tab') {
          trapModalFocus(pasteModal, e);
        }
      }
    }, { signal });

    // 阅读视图按钮
    backShelfBtn?.addEventListener('click', () => closeDocument({ pushHistory: true }), { signal });
    crumbShelfBtn?.addEventListener('click', () => closeDocument({ pushHistory: true }), { signal });

    docSwitcher?.addEventListener('change', () => {
      const nextId = docSwitcher.value;
      if (nextId && nextId !== activeDoc?.id) {
        openDocument(nextId, { pushHistory: true });
      }
    }, { signal });

    reimportBtn?.addEventListener('click', () => {
      if (!activeDoc) return;
      reimportTargetId = activeDoc.id;
      reimportInput?.click();
    }, { signal });

    attachAssetsBtn?.addEventListener('click', () => {
      if (!activeDoc) return;
      assetsInput?.click();
    }, { signal });

    exportNotesBtn?.addEventListener('click', () => {
      if (!activeDoc) return;
      const slug = buildLocalReaderSlug(activeDoc.id);
      const records = loadHighlights(slug);
      if (!records.length) {
        showToast('本文暂无划线或批注记录');
        return;
      }
      const md = exportHighlightsAsMarkdown(activeDoc.title, window.location.href, records);
      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${activeDoc.title.replace(/[\\/:*?"<>|]+/g, '_')}-笔记.md`;
      a.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      showToast(`已导出 ${records.length} 条划线与批注`);
    }, { signal });

    toMindmapBtn?.addEventListener('click', () => {
      if (!activeDoc) return;
      const slug = buildLocalReaderSlug(activeDoc.id);
      const highlights = loadHighlights(slug);
      const created = buildMindMapFromArticle(
        {
          slug,
          title: activeDoc.title,
          headings: activeDoc.headings || [],
          notes: highlights,
        },
        { includeNotes: true },
      );
      upsertMindMap(created);
      window.location.href = `/mindmap/?map=${encodeURIComponent(created.id)}`;
    }, { signal });

    // 全局拖拽上传
    const hasFilePayload = (e: DragEvent) => Array.from(e.dataTransfer?.types || []).includes('Files');

    window.addEventListener('dragenter', (e) => {
      if (!hasFilePayload(e)) return;
      e.preventDefault();
      dragDepth += 1;
      if (dropOverlay && dropOverlay.hidden) {
        dropOverlay.hidden = false;
        dropOverlay.setAttribute('aria-hidden', 'false');
        void dropOverlay.offsetWidth;
        dropOverlay.classList.add('is-open');
      }
    }, { signal });

    window.addEventListener('dragover', (e) => {
      if (!hasFilePayload(e)) return;
      e.preventDefault();
      if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
    }, { signal });

    const hideDropOverlay = () => {
      if (!dropOverlay) return;
      dropOverlay.classList.remove('is-open');
      dropOverlay.setAttribute('aria-hidden', 'true');
      window.setTimeout(() => {
        if (!dropOverlay.classList.contains('is-open')) dropOverlay.hidden = true;
      }, 180);
    };

    window.addEventListener('dragleave', (e) => {
      if (!hasFilePayload(e)) return;
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) hideDropOverlay();
    }, { signal });

    window.addEventListener('drop', async (e) => {
      if (!hasFilePayload(e)) return;
      e.preventDefault();
      dragDepth = 0;
      hideDropOverlay();
      if (!e.dataTransfer) return;
      const items = await collectDroppedFiles(e.dataTransfer);
      await handleImportedFiles(items);
    }, { signal });

    window.addEventListener('popstate', () => {
      const docId = new URLSearchParams(window.location.search).get('doc');
      if (docId) {
        if (activeDoc?.id !== docId) {
          openDocument(docId, { pushHistory: false });
        }
      } else if (activeDoc) {
        closeDocument({ pushHistory: false });
      }
    }, { signal });

    window.addEventListener('resize', () => {
      syncCatGlider();
    }, { passive: true, signal });

    window.addEventListener('article-notes:changed', () => {
      if (!activeDoc) renderShelf(false, false);
    }, { signal });

    // 清理函数注册
    (window as any)[CLEANUP_KEY] = () => {
      openToken += 1;
      controller.abort();
      proseController?.abort();
      tocObserver?.disconnect();
      shelfFilterTimeline?.kill();
      paperPhysicsCleanup?.();
      paperPhysicsCleanup = null;
      revokeActiveAssetUrls();
      window.clearTimeout(searchDebounceTimer);
      window.clearTimeout(companionPhaseTimer);
      window.clearTimeout(deepLinkTimer);
      window.clearTimeout(toastTimer);
      if (openModalCount > 0) {
        openModalCount = 0;
        window.dispatchEvent(new CustomEvent('app:modal-leave'));
      }
      (window as any).__localReaderActiveDoc = null;
      (window as any).__localReaderOpenDoc = null;
    };

    // ---------- 首次装载：释放 data-enter-hold 触发首屏 3D 纸笺落案入场 ----------
    listLocalDocs().then(async (loaded) => {
      if (signal.aborted) return;
      docs = loaded;
      renderCategoryBar();
      syncDocSwitcher();

      const params = new URLSearchParams(window.location.search);
      const initialDocId = params.get('doc');
      if (initialDocId) {
        shelfGrid?.removeAttribute('data-enter-hold');
        (window as any).__releasePageEnter?.();
        await openDocument(initialDocId, {
          pushHistory: false,
          resume: params.get('resume') === '1',
          bookmarkId: params.get('bm') || undefined,
          highlightId: params.get('noteId') || undefined,
        });
      } else {
        renderShelf(false, true);
        shelfGrid?.removeAttribute('data-enter-hold');
        (window as any).__releasePageEnter?.();
      }
    });
  }

  initLocalReaderPage();

  if (!(window as any)[LISTENER_KEY]) {
    (window as any)[LISTENER_KEY] = true;
    document.addEventListener('astro:page-load', () => {
      initLocalReaderPage();
    });
    document.addEventListener('astro:before-swap', () => {
      (window as any)[CLEANUP_KEY]?.();
    });
  }
</script>

<style is:global>
  /* ================= 本地书架样式（120fps 单色水墨宣纸规范） ================= */
  .reader-inline-pill {
    font-family: var(--font-mono);
    font-size: 0.84em;
    padding: 0.08em 0.42em;
    border-radius: 6px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    color: var(--text-strong);
  }

  .reader-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .reader-drop-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--muted);
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px dashed var(--rule);
    background: var(--bg-soft);
  }

  .reader-cat-rail-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    max-width: 100%;
  }

  .reader-cat-rail {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    overflow-x: auto;
    max-width: 100%;
    scrollbar-width: none;
  }
  .reader-cat-rail::-webkit-scrollbar {
    display: none;
  }

  /* 纯 GPU transform: translate3d + scaleX 滑块 + 反向圆角补偿（0 width 重排） */
  .reader-cat-glider {
    position: absolute;
    top: 0.25rem;
    left: 0;
    width: 100px;
    height: calc(100% - 0.5rem);
    border-radius: var(--pill-rx, 999px) / var(--pill-ry, 999px);
    background: var(--text-strong);
    opacity: 0;
    transform-origin: left center;
    will-change: transform;
    pointer-events: none;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease;
    z-index: 0;
  }

  .reader-cat-pill {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.34rem 0.78rem;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--muted-strong);
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: color 200ms ease;
  }
  .reader-cat-pill.is-active {
    color: var(--bg-base);
    font-weight: 600;
  }
  .reader-cat-count {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    opacity: 0.72;
  }

  .reader-add-cat-btn {
    padding: 0.35rem 0.72rem;
    border-radius: 999px;
    border: 1px dashed var(--rule-strong);
    background: transparent;
    color: var(--muted-strong);
    font-size: 0.76rem;
    cursor: pointer;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease, transform 180ms ease;
  }
  .reader-add-cat-btn:hover {
    border-color: var(--text-strong);
    color: var(--text-strong);
    background: var(--bg-soft);
    transform: translateY(-1px);
  }

  .reader-search-box {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    color: var(--muted);
    min-width: 240px;
    transition: border-color 180ms ease;
  }
  .reader-search-box:focus-within {
    border-color: var(--text-strong);
  }
  .reader-search-box input {
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text-strong);
    font-size: 0.84rem;
    width: 100%;
  }

  .reader-sort-select,
  .reader-doc-switcher {
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    color: var(--text-strong);
    font-size: 0.8rem;
    cursor: pointer;
    outline: none;
  }
  .reader-doc-switcher {
    max-width: 260px;
    text-overflow: ellipsis;
  }

  /* 书架卡片网格与空态零跳动锁高 */
  .reader-shelf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .reader-shelf-grid.is-empty {
    height: 0 !important;
    min-height: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    overflow: hidden;
  }

  /* 3D 宣纸卡片（与 initPaperCardPhysics 协同：GPU 合成层、无 box-shadow 逐帧重绘、纸面光泽跟手） */
  .reader-doc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.35rem 1.2rem !important;
    border-radius: 18px !important;
    border: 1px solid var(--rule);
    background: var(--bg-elev, var(--bg-soft));
    cursor: pointer;
    overflow: hidden;
    contain: layout style;
    transform-style: preserve-3d;
    transition: border-color 200ms ease;
  }
  .reader-doc-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(
      260px circle at var(--paper-x, 50%) var(--paper-y, 50%),
      rgba(255, 255, 255, 0.22),
      transparent 70%
    );
    opacity: var(--paper-sheen-opacity, 0);
    z-index: 2;
  }
  [data-theme="dark"] .reader-doc-card::after {
    background: radial-gradient(
      260px circle at var(--paper-x, 50%) var(--paper-y, 50%),
      rgba(255, 255, 255, 0.08),
      transparent 70%
    );
  }
  .reader-doc-card.is-paper-hovered,
  .reader-doc-card:hover {
    border-color: var(--rule-strong);
  }

  .reader-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }
  .reader-card-badges {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .reader-card-cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.16rem 0.56rem;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    color: var(--text-strong);
  }
  .reader-card-asset-pill {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.14rem 0.5rem;
    border-radius: 999px;
    background: transparent;
    border: 1px dashed var(--rule);
    color: var(--muted-strong);
  }

  .reader-card-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.72;
    transition: opacity 180ms ease;
  }
  .reader-doc-card:hover .reader-card-actions,
  .reader-doc-card:focus-within .reader-card-actions {
    opacity: 1;
  }

  .reader-card-icon-btn {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted-strong);
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  .reader-card-icon-btn:hover {
    background: var(--bg-soft);
    border-color: var(--rule);
    color: var(--text-strong);
  }

  .reader-card-title {
    margin: 0;
    font-family: var(--font-hand-title, var(--font-display));
    font-size: 1.14rem;
    font-weight: 700;
    line-height: 1.42;
    color: var(--text-strong);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .reader-card-desc {
    margin: 0.55rem 0 0;
    font-size: 0.84rem;
    line-height: 1.62;
    color: var(--muted-strong);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .reader-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.8rem;
  }
  .reader-card-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .reader-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 0.72rem;
    border-top: 1px dashed var(--rule-soft, var(--rule));
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .reader-card-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
  }
  .reader-card-meta > span:first-child {
    max-width: 115px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .reader-card-progress-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 600;
    background: var(--bg-soft);
    border: 1px solid var(--rule-strong);
    color: var(--text-strong);
    white-space: nowrap;
  }
  .reader-card-progress-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(0, 0, 0, 0.05);
  }
  .reader-card-progress-track > span {
    display: block;
    height: 100%;
    background: var(--accent, var(--text-strong));
    transition: width 320ms ease;
  }

  /* ================= 沉浸阅读舞台 ================= */
  .reader-stage-wrap {
    max-width: 56rem;
    margin: 0 auto;
  }

  .reader-stage-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.72rem 1rem !important;
    border-radius: 16px !important;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
  }
  .reader-stage-bar-left,
  .reader-stage-bar-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .reader-bar-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    padding: 0.38rem 0.78rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-base);
    color: var(--text-strong);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reader-bar-btn:hover {
    border-color: var(--rule-strong);
    transform: translateY(-1px);
  }
  .reader-bar-btn:active {
    transform: scale(0.97);
  }
  .reader-bar-btn.is-strong {
    background: var(--text-strong);
    border-color: var(--text-strong);
    color: var(--bg-base);
  }

  .reader-local-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: var(--bg-soft);
    color: var(--text-strong);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
  }

  .reader-missing-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem !important;
    border-radius: 14px !important;
    border: 1px dashed var(--rule-strong);
    background: var(--bg-soft);
    font-size: 0.84rem;
    color: var(--text-strong);
  }
  .reader-missing-banner[hidden] {
    display: none !important;
  }
  .reader-missing-banner-info {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .reader-missing-asset {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    margin: 0.5rem 0;
    border-radius: 10px;
    border: 1px dashed var(--rule-strong);
    background: var(--bg-soft);
    color: var(--muted-strong);
    font-size: 0.82rem;
  }

  /* ================= 零 backdrop-filter 拖拽蒙层 / 弹窗 / Toast（120fps 纯 GPU 过渡） ================= */
  .reader-drop-overlay {
    position: fixed;
    inset: 0;
    z-index: 100200;
    display: grid;
    place-items: center;
    background: rgba(15, 15, 16, 0.68);
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .reader-drop-overlay.is-open {
    opacity: 1;
  }
  .reader-drop-overlay[hidden] {
    display: none !important;
  }
  .reader-drop-card {
    padding: 2.2rem 2.8rem;
    border-radius: 22px;
    border: 2px dashed var(--rule-strong);
    background: var(--bg-elev, var(--bg-base));
    color: var(--text-strong);
    text-align: center;
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.28);
    transform: scale(0.95);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reader-drop-overlay.is-open .reader-drop-card {
    transform: scale(1);
  }
  .reader-drop-icon {
    width: 60px;
    height: 60px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    display: grid;
    place-items: center;
    margin: 0 auto 1rem;
  }
  .reader-drop-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
  }
  .reader-drop-sub {
    margin: 0.45rem 0 0;
    font-size: 0.85rem;
    color: var(--muted-strong);
  }

  .reader-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 100150;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(12, 12, 14, 0.64);
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .reader-modal-backdrop.is-open {
    opacity: 1;
  }
  .reader-modal-backdrop[hidden] {
    display: none !important;
  }
  .reader-modal-card {
    width: min(680px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 20px;
    border: 1px solid var(--rule-strong);
    background: var(--bg-elev, var(--bg-base));
    box-shadow: 0 28px 64px rgba(0, 0, 0, 0.28);
    transform: translate3d(0, 12px, 0) scale(0.96);
    opacity: 0;
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease;
  }
  .reader-modal-backdrop.is-open .reader-modal-card {
    transform: translate3d(0, 0, 0) scale(1);
    opacity: 1;
  }
  .reader-modal-card--sm {
    width: min(460px, 100%);
  }
  .reader-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.4rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .reader-modal-title {
    margin: 0.25rem 0 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-strong);
  }
  .reader-modal-close {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    color: var(--text-strong);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
  }
  .reader-modal-body {
    padding: 1.25rem 1.4rem 1.4rem;
  }
  .reader-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .reader-field > span {
    font-size: 0.76rem;
    color: var(--muted-strong);
  }
  .reader-field input,
  .reader-field select,
  .reader-field textarea {
    width: 100%;
    padding: 0.62rem 0.8rem;
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    color: var(--text-strong);
    font-size: 0.88rem;
    outline: none;
  }
  .reader-field textarea {
    font-family: var(--font-mono);
    line-height: 1.6;
    resize: vertical;
  }
  .reader-field input:focus,
  .reader-field select:focus,
  .reader-field textarea:focus {
    border-color: var(--text-strong);
  }
  .reader-modal-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-top: 1.15rem;
  }

  .reader-toast {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    z-index: 100300;
    transform: translate3d(-50%, 10px, 0);
    opacity: 0;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: var(--text-strong);
    color: var(--bg-base);
    font-size: 0.82rem;
    font-weight: 500;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
    transition: opacity 200ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .reader-toast.is-visible {
    opacity: 1;
    transform: translate3d(-50%, 0, 0);
  }

  /* ================= 复用 PostLayout 同款目录、折叠代码块与章节水墨轻拂样式 ================= */
  .post-toc {
    border-radius: 18px !important;
    padding: 1.1rem 1.4rem !important;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    transition: border-color 0.2s ease;
    overscroll-behavior: contain !important;
  }
  @media (max-width: 640px) {
    .post-toc {
      padding: 0.85rem 0.9rem !important;
    }
    .post-toc-tools .post-toc-search-btn {
      display: none !important;
    }
  }
  .post-toc:hover {
    border-color: var(--rule-strong);
  }
  .post-toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    list-style: none;
    outline: none;
  }
  .post-toc-summary::-webkit-details-marker {
    display: none;
  }
  .post-toc-caret {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    transition: transform 360ms var(--article-ease-layout, ease), color 200ms ease;
  }
  .post-toc:not([open]) .post-toc-caret,
  .post-toc.is-collapsed .post-toc-caret {
    transform: rotate(-90deg) !important;
  }
  .post-toc-expander {
    overflow: hidden;
  }
  .post-toc-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .post-toc-title {
    font-family: var(--font-hand);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-strong);
    white-space: nowrap;
  }
  .post-toc-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-strong);
    background: rgba(0, 0, 0, 0.04);
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    border: 1px solid var(--rule-soft);
    white-space: nowrap;
  }
  .post-toc-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-strong);
    background: rgba(0, 0, 0, 0.04);
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid var(--rule-soft);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }
  .post-toc-search-btn:hover {
    color: var(--text-strong);
    border-color: var(--rule-strong);
    background: rgba(0, 0, 0, 0.08);
    transform: translateY(-1px);
  }
  .post-toc-search-kbd,
  .post-toc-notes-badge {
    display: inline-block;
    font-size: 0.62rem;
    padding: 0.05rem 0.28rem;
    border-radius: 3px;
    background: var(--bg-base);
    border: 1px solid var(--rule-soft);
    opacity: 0.8;
  }
  .post-toc-inner {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--rule);
  }
  .post-toc-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: 22rem;
    overflow-y: auto;
    padding-right: 0.4rem;
  }
  .post-toc-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.28rem 0.55rem;
    border-radius: 6px;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted-strong);
    text-decoration: none !important;
    transition: color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .post-toc-link .toc-bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rule-strong);
    flex-shrink: 0;
    opacity: 0.45;
    transition: transform 0.15s ease, opacity 0.15s ease, background 0.15s ease;
  }
  .post-toc-link.depth-2 {
    font-weight: 600;
    color: var(--text-strong);
    margin-top: 0.35rem;
  }
  .post-toc-link.depth-3 {
    padding-left: 1.4rem;
    font-size: 0.82rem;
  }
  .post-toc-link.depth-3 .toc-bullet {
    width: 3.5px;
    height: 3.5px;
  }
  .post-toc-link:hover {
    color: var(--text-strong);
    background: rgba(0, 0, 0, 0.04);
    transform: translateX(3px);
  }
  .post-toc-link.is-active {
    color: var(--text-strong);
    font-weight: 700;
    background: rgba(0, 0, 0, 0.05);
  }
  [data-theme="dark"] .post-toc-link:hover,
  [data-theme="dark"] .post-toc-link.is-active {
    background: rgba(255, 255, 255, 0.1);
  }
  .post-toc-link.is-active .toc-bullet {
    opacity: 1;
    background: var(--accent);
    transform: scale(1.3);
  }

  .code-copy-button,
  .code-collapse-button {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: transform 200ms ease, color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .code-collapse-button {
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.2;
    color: #e4e4e7;
    background: rgba(255, 255, 255, 0.06);
    cursor: pointer;
  }
  .code-copy-button.is-copied {
    border-color: rgba(255, 255, 255, 0.44) !important;
    color: #f4f4f5 !important;
    background: rgba(255, 255, 255, 0.14) !important;
    animation: readerCodeCopyPulse 260ms var(--article-ease-surface, ease);
  }
  @keyframes readerCodeCopyPulse {
    0% { transform: scale(0.95); opacity: 0.84; }
    58% { transform: scale(1.03); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  .prose pre.is-code-collapsed {
    max-height: 240px;
    overflow: hidden !important;
    position: relative;
  }
  .code-expand-veil {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 82px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 12px;
    background: linear-gradient(to bottom, rgba(20, 20, 22, 0), rgba(20, 20, 22, 0.92) 65%, rgba(20, 20, 22, 0.98));
    z-index: 4;
  }
  .code-expand-veil[hidden] {
    display: none !important;
  }
  .code-expand-veil-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.34rem 0.95rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.12);
    color: #f4f4f5;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    cursor: pointer;
  }

  .prose h2[id],
  .prose h3[id] {
    position: relative;
    scroll-margin-top: 84px;
  }
  .prose h2[id]::after,
  .prose h3[id]::after {
    content: '';
    position: absolute;
    inset: -4px -8px;
    border-left: 2.5px solid var(--vermilion);
    border-radius: 3px 6px 6px 3px;
    background: linear-gradient(
      90deg,
      var(--vermilion-soft) 0%,
      rgba(var(--vermilion-rgb, 0, 0, 0), 0.04) 46%,
      transparent 100%
    );
    opacity: 0;
    transform: scaleX(0.08);
    transform-origin: left center;
    pointer-events: none;
    z-index: -1;
  }
  .prose .is-anchor-target {
    isolation: isolate;
  }
  .prose .is-anchor-target::after {
    animation: readerHeadingInkSweep 1050ms var(--article-ease-surface, ease) forwards;
  }
  @keyframes readerHeadingInkSweep {
    0% { opacity: 0; transform: scaleX(0.06); }
    24% { opacity: 1; transform: scaleX(1); }
    62% { opacity: 0.78; transform: scaleX(1); }
    100% { opacity: 0; transform: scaleX(1); }
  }
  .heading-anchor-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.42rem;
    padding: 0 0.34rem;
    height: 1.35em;
    border-radius: 5px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72em;
    opacity: 0;
    transform: translateX(-3px);
    cursor: pointer;
    transition: opacity 180ms ease, transform 200ms ease, color 160ms ease, background 160ms ease;
  }
  .prose h2[id]:hover .heading-anchor-btn,
  .prose h3[id]:hover .heading-anchor-btn,
  .heading-anchor-btn:focus-visible,
  .heading-anchor-btn.is-copied {
    opacity: 0.9;
    transform: translateX(0);
  }

  /* ================= highlight.js 深色代码面配色（对齐 Shiki 风格） ================= */
  .prose pre.reader-code code {
    color: #e4e4e7;
  }
  .prose pre.reader-code .hljs-comment,
  .prose pre.reader-code .hljs-quote {
    color: #7c8594;
    font-style: italic;
  }
  .prose pre.reader-code .hljs-keyword,
  .prose pre.reader-code .hljs-selector-tag,
  .prose pre.reader-code .hljs-subst {
    color: #c792ea;
  }
  .prose pre.reader-code .hljs-type,
  .prose pre.reader-code .hljs-title.class_,
  .prose pre.reader-code .hljs-built_in {
    color: #ffcb6b;
  }
  .prose pre.reader-code .hljs-title.function_,
  .prose pre.reader-code .hljs-section {
    color: #82aaff;
  }
  .prose pre.reader-code .hljs-string,
  .prose pre.reader-code .hljs-regexp,
  .prose pre.reader-code .hljs-addition {
    color: #c3e88d;
  }
  .prose pre.reader-code .hljs-number,
  .prose pre.reader-code .hljs-literal,
  .prose pre.reader-code .hljs-symbol {
    color: #f78c6c;
  }
  .prose pre.reader-code .hljs-meta,
  .prose pre.reader-code .hljs-attr,
  .prose pre.reader-code .hljs-attribute {
    color: #89ddff;
  }
  .prose pre.reader-code .hljs-variable,
  .prose pre.reader-code .hljs-params,
  .prose pre.reader-code .hljs-property {
    color: #d6deeb;
  }
  .prose pre.reader-code .hljs-deletion,
  .prose pre.reader-code .hljs-name,
  .prose pre.reader-code .hljs-selector-id {
    color: #f07178;
  }

  @media (prefers-reduced-motion: reduce) {
    .reader-cat-glider,
