---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import CompanionLayout from '../components/CompanionLayout.astro';
import InkAsk from '../components/InkAsk.astro';
import PinWorkbench from '../components/PinWorkbench.astro';
import ArticleSearch from '../components/ArticleSearch.astro';
import ArticleSelectionDock from '../components/ArticleSelectionDock.astro';
import ReadingBookmark from '../components/ReadingBookmark.astro';
---

<BaseLayout
  title="Reader - 梦付千秋"
  description="本地 Markdown 书架与沉浸阅读器：支持文件夹与图片导入、代码高亮、公式图表、划线批注、夹签续读、导图生成与墨问 AI 伴读"
>
  <Header />

  <main
    id="main-content"
    tabindex="-1"
    class="container-wide flex-1 pt-6 pb-28 lg:pt-8 outline-none min-h-[calc(100vh-140px)]"
  >
    <!-- 隐藏文件选择器 -->
    <input
      id="reader-file-input"
      type="file"
      multiple
      accept=".md,.markdown,.mdown,.mkd,.txt,image/*"
      hidden
    />
    <input
      id="reader-folder-input"
      type="file"
      webkitdirectory
      directory
      multiple
      hidden
    />
    <input
      id="reader-reimport-input"
      type="file"
      multiple
      accept=".md,.markdown,.mdown,.mkd,.txt,image/*"
      hidden
    />
    <input
      id="reader-assets-input"
      type="file"
      multiple
      accept="image/*"
      hidden
    />

    <!-- ==================== 视图 A：本地书架 ==================== -->
    <div id="reader-shelf-view" class="reader-shelf-view space-y-8">
      <!-- 顶部标题与统计胶囊条 -->
      <section
        class="panel pb-8 border-b border-[var(--rule)]"
        style="border-image: linear-gradient(to right, transparent 3%, var(--rule-strong) 50%, transparent 97%) 1;"
      >
        <p class="eyebrow" data-enter="top">Local Reader</p>
        <div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between flex-wrap">
          <div class="max-w-2xl">
            <h1 class="section-title" data-enter="left">Reader</h1>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-[var(--muted-strong)]" data-enter="left">
              把本地 <code class="reader-inline-pill">.md</code> 文稿与配套图片装进浏览器书架，原文仅存本机 IndexedDB，畅享全套划线批注、夹签续读、导图生成与墨问 AI 伴读。
            </p>
          </div>

          <div class="archive-stats-wrap self-start lg:self-auto" data-enter="bloom" data-reader-stats-strip>
            <div class="archive-stats-strip notes-stats-strip" id="reader-stats-strip" aria-label="本地书架统计">
              <span class="stats-glider" id="reader-stats-glider" aria-hidden="true"></span>

              <div class="stats-item notes-stat-item is-active" data-reader-stat="all" role="button" tabindex="0" aria-pressed="true" title="查看全部文稿">
                <span class="stats-label">DOCS</span>
                <strong class="stats-value" id="reader-stat-total">0</strong>
                <span class="stats-subnote">篇书架文稿</span>
              </div>

              <span class="stats-separator" aria-hidden="true"></span>

              <div class="stats-item notes-stat-item" data-reader-stat="reading" role="button" tabindex="0" aria-pressed="false" title="筛选正在阅读中的文稿">
                <span class="stats-label">READING</span>
                <strong class="stats-value" id="reader-stat-reading">0</strong>
                <span class="stats-subnote">篇在读中</span>
              </div>

              <span class="stats-separator" aria-hidden="true"></span>

              <div class="stats-item notes-stat-item" data-reader-stat="words" role="button" tabindex="0" aria-pressed="false" title="书架累计字数">
                <span class="stats-label">WORDS</span>
                <strong class="stats-value" id="reader-stat-words">0</strong>
                <span class="stats-subnote">总字数</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 导入操作工具栏 -->
        <div class="mt-7 flex flex-wrap items-center gap-3" data-enter="bottom">
          <button type="button" id="reader-import-files-btn" class="btn-primary reader-action-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>导入 Markdown</span>
          </button>

          <button type="button" id="reader-import-folder-btn" class="btn-secondary reader-action-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>导入文件夹（含图片）</span>
          </button>

          <button type="button" id="reader-paste-btn" class="btn-secondary reader-action-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
              <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
            </svg>
            <span>粘贴新建</span>
          </button>

          <span class="reader-drop-hint">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="8 17 12 21 16 17"></polyline>
              <line x1="12" y1="12" x2="12" y2="21"></line>
              <path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"></path>
            </svg>
            <span>支持直接拖拽 .md 或整个文件夹到页面任意处</span>
          </span>
        </div>
      </section>

      <!-- 分类筛选与搜索条 -->
      <section class="reader-toolbar flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between" id="reader-filter-bar" data-enter="bottom">
        <div class="reader-cat-rail-wrap">
          <div class="reader-cat-rail" id="reader-cat-bar" role="tablist" aria-label="文稿分类筛选">
            <span class="reader-cat-glider" id="reader-cat-glider" aria-hidden="true"></span>
            <!-- 由脚本动态注入分类胶囊 -->
          </div>
          <button
            type="button"
            id="reader-add-cat-btn"
            class="reader-add-cat-btn"
            title="新建书架分类"
            aria-label="新建书架分类"
          >
            + 分类
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <label class="reader-search-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              id="reader-search-input"
              type="search"
              placeholder="搜索标题、文件名、标签或摘要..."
              autocomplete="off"
              aria-label="搜索书架文稿"
            />
          </label>

          <select id="reader-sort-select" class="reader-sort-select" aria-label="排序方式">
            <option value="recent">最近阅读</option>
            <option value="updated">最近导入</option>
            <option value="title">按标题</option>
            <option value="words">按字数</option>
          </select>
        </div>
      </section>

      <!-- 书架卡片网格（挂载 data-enter-hold 等待 IndexedDB 首屏渲染后统一释放 3D 落案入场） -->
      <section id="reader-shelf-grid" class="reader-shelf-grid" aria-label="本地文稿书架" data-enter-hold></section>

      <!-- 空状态 -->
      <section id="reader-empty-state" class="mt-8 text-center py-16 panel max-w-xl mx-auto hidden">
        <div class="w-16 h-16 rounded-full bg-[var(--bg-soft)] border border-[var(--rule)] flex items-center justify-center mx-auto mb-5 text-[var(--muted-strong)]">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            <line x1="8" y1="7" x2="16" y2="7"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h2 id="reader-empty-title" class="font-display text-xl text-[var(--text-strong)]">书架暂时空着</h2>
        <p id="reader-empty-desc" class="mt-3 text-sm text-[var(--muted-strong)] leading-relaxed max-w-md mx-auto">
          把本地的 Markdown 笔记或整套技术文档文件夹拖到这里，即可获得与博客正式文章完全一致的排版、代码高亮、Mermaid 图表、划线批注与墨问伴读体验。
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <button type="button" id="reader-empty-import-btn" class="btn-primary reader-action-btn">
            <span>选择本地 .md 文件</span>
          </button>
          <button type="button" id="reader-load-sample-btn" class="btn-secondary reader-action-btn">
            <span>载入示例文稿体验</span>
          </button>
        </div>
      </section>
    </div>

    <!-- ==================== 视图 B：沉浸阅读舞台 ==================== -->
    <div id="reader-stage-view" class="reader-stage-wrap" hidden>
      <!-- 顶部阅读器工具栏 -->
      <div class="reader-stage-bar panel" id="reader-stage-bar">
        <div class="reader-stage-bar-left">
          <button type="button" id="reader-back-shelf-btn" class="reader-bar-btn is-strong">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span>返回书架</span>
          </button>

          <select id="reader-doc-switcher" class="reader-doc-switcher" aria-label="切换本地书架文稿"></select>
        </div>

        <div class="reader-stage-bar-right">
          <button type="button" id="reader-reimport-btn" class="reader-bar-btn" title="重新导入同名或更新版 .md 文件（保留当前划线与书签）">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            <span>重导更新</span>
          </button>

          <button type="button" id="reader-export-notes-btn" class="reader-bar-btn" title="将本文划线高亮与批注导出为 Markdown">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>导出笔记</span>
          </button>

          <button type="button" id="reader-to-mindmap-btn" class="reader-bar-btn" title="根据本文标题结构与划线批注一键生成思维导图">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="5" cy="12" r="2.5"></circle>
              <circle cx="19" cy="6" r="2.5"></circle>
              <circle cx="19" cy="18" r="2.5"></circle>
              <path d="M7.5 12h4c1.5 0 2-6 5-6"></path>
              <path d="M11.5 12c1.5 0 2 6 5 6"></path>
            </svg>
            <span>生成导图</span>
          </button>
        </div>
      </div>

      <!-- 与 PostLayout 高度一致的沉浸文章结构 -->
      <article class="space-y-10 mt-6" data-reader-article>
        <header class="panel flex flex-col" data-post-header id="reader-stage-header">
          <div class="flex flex-wrap items-center gap-3 font-mono text-[0.72rem] tracking-[0.1em] uppercase text-[var(--muted)]">
            <button type="button" id="reader-crumb-shelf" class="transition hover:text-[var(--accent)] cursor-pointer bg-transparent border-0 p-0 font-inherit uppercase tracking-inherit text-inherit">
              Reader
            </button>
            <span class="opacity-40">/</span>
            <span id="reader-meta-date"></span>
            <span class="opacity-40">/</span>
            <span id="reader-meta-category"></span>
            <span class="opacity-40">/</span>
            <span id="reader-meta-minutes"></span>
            <span class="reader-local-badge" id="reader-meta-badge">本地文稿</span>
          </div>

          <h1
            class="section-title post-title mt-7 mb-5 max-w-3xl"
            style="font-size: clamp(2rem, 4.2vw, 3.05rem);"
            data-post-title
          >
            <span class="post-title-calligraphy">
              <span class="post-title-text" id="reader-doc-title"></span>
            </span>
          </h1>

          <p
            id="reader-doc-desc"
            class="mt-3 max-w-2xl text-[1.02rem] leading-[1.78] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
            hidden
          ></p>

          <div
            id="reader-doc-tags-wrap"
            class="mt-8 pt-5 border-t border-[var(--rule)]"
            style="border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;"
            hidden
          >
            <div id="reader-doc-tags" class="flex flex-wrap gap-2"></div>
          </div>
        </header>

        <!-- 本地图片缺失提示条（按需展示） -->
        <div id="reader-missing-assets-banner" class="reader-missing-banner panel" hidden>
          <div class="reader-missing-banner-info">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span id="reader-missing-assets-text">本文引用了尚未导入的本地图片。</span>
          </div>
          <button type="button" id="reader-attach-assets-btn" class="reader-bar-btn is-strong">
            <span>补充上传图片</span>
          </button>
        </div>

        <div class="space-y-6">
          <!-- 动态目录面板（含可打断 WAAPI 平滑展开/收拢） -->
          <details class="post-toc panel" id="reader-toc" open aria-labelledby="reader-toc-title" data-lenis-prevent>
            <summary class="post-toc-summary" data-lenis-prevent>
              <div class="flex items-center gap-2">
                <span class="post-toc-caret" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
                <span class="post-toc-kicker">Navigation</span>
                <span class="opacity-30">/</span>
                <span id="reader-toc-title" class="post-toc-title">文章目录</span>
              </div>
              <div class="post-toc-tools flex items-center gap-2">
                <button
                  type="button"
                  id="post-toc-search-btn"
                  class="post-toc-search-btn max-sm:hidden"
                  data-article-search-trigger
                  aria-label="搜索本文 (⌘F 或 /)"
                  title="搜索本文 (⌘F 或 /)"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <span>搜本文</span>
                  <kbd class="post-toc-search-kbd">⌘F</kbd>
                </button>
                <button
                  type="button"
                  id="post-toc-notes-btn"
                  class="post-toc-search-btn max-sm:hidden"
                  data-article-notes-trigger
                  aria-label="查看文章高亮笔记"
                  title="查看高亮笔记"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 11-6 6v3h3l6-6"></path>
                    <path d="m22 2-2.5 2.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L18 0z"></path>
                    <path d="M14.5 5.5 18.5 9.5"></path>
                  </svg>
                  <span>笔记</span>
                  <span class="post-toc-notes-badge" data-notes-count>0</span>
                </button>
                <button
                  type="button"
                  id="post-toc-bookmarks-btn"
                  class="post-toc-search-btn max-sm:hidden"
                  data-article-bookmarks-trigger
                  aria-label="查看或添加本文夹签 (B)"
                  title="本文书签夹签 (快捷键 B)"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"></path>
                  </svg>
                  <span>夹签</span>
                  <span class="post-toc-notes-badge" data-bookmarks-count>0</span>
                </button>
                <span class="post-toc-badge" id="reader-toc-count">0 节</span>
              </div>
            </summary>
            <div class="post-toc-expander" id="reader-toc-expander">
              <div class="post-toc-inner" data-lenis-prevent>
                <nav class="post-toc-nav" id="reader-toc-nav" aria-label="文章目录" data-lenis-prevent></nav>
              </div>
            </div>
          </details>

          <!-- 正文宣纸容器 -->
          <div class="panel post-body rounded-[20px] px-4 py-6 sm:px-6 md:px-10 md:py-10" data-post-body>
            <div class="post-spine" aria-hidden="true" data-post-spine>
              <svg preserveAspectRatio="none" viewBox="0 0 2 100">
                <line x1="1" y1="0" x2="1" y2="100" pathLength="1" data-post-spine-line />
              </svg>
            </div>
            <div
              class="prose"
              id="reader-prose"
              data-post-prose
              data-article-slug="__inactive__"
            ></div>
          </div>
        </div>
      </article>
    </div>
  </main>

  <!-- 全局拖拽上传提示蒙层（零全屏 backdrop-filter 掉帧） -->
  <div id="reader-drop-overlay" class="reader-drop-overlay" hidden aria-hidden="true">
    <div class="reader-drop-card">
      <div class="reader-drop-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <p class="reader-drop-title">松开即可导入本地书架</p>
      <p class="reader-drop-sub">支持单个/多个 .md 文件，或直接拖入包含图片的整个文件夹</p>
    </div>
  </div>

  <!-- 粘贴新建 Markdown 弹窗 -->
  <div id="reader-paste-modal" class="reader-modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="reader-paste-modal-title">
    <div class="reader-modal-card" data-lenis-prevent>
      <div class="reader-modal-head">
        <div>
          <span class="eyebrow">Quick Paste</span>
          <h2 id="reader-paste-modal-title" class="reader-modal-title">粘贴 Markdown 新建文稿</h2>
        </div>
        <button type="button" class="reader-modal-close" data-modal-close aria-label="关闭弹窗">×</button>
      </div>
      <form id="reader-paste-form" class="reader-modal-body">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <label class="sm:col-span-2 reader-field">
            <span>文稿标题（留空则自动从 Frontmatter 或首行 # 标题提取）</span>
            <input id="reader-paste-title" type="text" placeholder="例如：UE5 渲染管线笔记" />
          </label>
          <label class="reader-field">
            <span>分类</span>
            <select id="reader-paste-category"></select>
          </label>
        </div>
        <label class="reader-field mt-4">
          <span>Markdown 内容</span>
          <textarea
            id="reader-paste-content"
            rows="12"
            required
            placeholder="在此粘贴 Markdown 正文（支持 Frontmatter、LaTeX 公式、Mermaid、代码块与 [!NOTE] 提示框）..."
          ></textarea>
        </label>
        <div class="reader-modal-actions">
          <button type="button" class="btn-secondary" data-modal-close>取消</button>
          <button type="submit" class="btn-primary">导入并立即阅读 →</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 同名文件冲突确认弹窗 -->
  <div id="reader-dup-modal" class="reader-modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="reader-dup-modal-title">
    <div class="reader-modal-card reader-modal-card--sm" data-lenis-prevent>
      <div class="reader-modal-head">
