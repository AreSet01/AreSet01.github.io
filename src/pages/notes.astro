  :global(.prose-preview li) { margin-bottom: 0.25em; line-height: 1.7; }
  :global(.prose-preview li > ul),
  :global(.prose-preview li > ol) { margin-top: 0.25em; margin-bottom: 0.2em; }
  :global(.prose-preview img) {
    max-width: 100%;
