---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const postsMeta = allPosts.map((p) => ({
  slug: p.id,
  title: p.data.title,
  url: `/posts/${p.id}`,
}));
---

<BaseLayout title="笔记管理 - 梦付千秋" description="全站知识笔记、阅读划词批注与墨问 AI 问答摘录管理中心">
  <Header />

  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-16 lg:pt-8 outline-none">
    <!-- 挂载服务端提取的文章元信息供客户端高效索引 -->
    <script id="posts-meta-data" type="application/json" set:html={JSON.stringify(postsMeta)} />

    <!-- 1. 顶部标题与数据概览 -->
    <section class="panel pb-8 border-b border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 3%, var(--rule-strong) 50%, transparent 97%) 1;">
      <p class="eyebrow" data-enter="top">Notes</p>
      <div class="mt-4 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <h1 class="section-title" data-enter="left">
            墨痕记 · 灵感与阅读批注
          </h1>
          <p
            class="mt-3 text-[0.95rem] leading-[1.75] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
            data-enter="left"
          >
            全站阅读批注回溯、墨问 AI 问答摘录以及纯粹的 Markdown 灵感随想。基于 Local-First 架构，多端无缝私密同步。
          </p>
        </div>

        <!-- 磁吸滑块统计长条 (Stats Ribbon with Glider) -->
        <div class="archive-stats-wrap self-start lg:self-auto" data-enter="bloom" data-notes-stats-strip>
          <div class="archive-stats-strip notes-stats-strip" id="notes-stats-strip" aria-label="笔记数据概览">
            <span class="stats-glider" data-notes-stats-glider id="notes-stats-glider" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item" data-stats-item tabindex="0" title="全部笔记条数">
              <span class="stats-label">TOTAL</span>
              <strong class="stats-value" data-count="0" id="stat-total">0</strong>
              <span class="stats-subnote">条总笔记</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item" data-stats-item tabindex="0" title="独立随笔便签">
              <span class="stats-label">MARKDOWN</span>
              <strong class="stats-value" data-count="0" id="stat-free">0</strong>
              <span class="stats-subnote">篇独立便签</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item" data-stats-item tabindex="0" title="文章划线批注">
              <span class="stats-label">HIGHLIGHTS</span>
              <strong class="stats-value" data-count="0" id="stat-highlights">0</strong>
              <span class="stats-subnote">处划词批注</span>
            </div>

            <span class="stats-separator" aria-hidden="true"></span>

            <div class="stats-item notes-stat-item" data-stats-item tabindex="0" title="墨问 AI 问答摘录">
              <span class="stats-label">INK-ASK</span>
              <strong class="stats-value" data-count="0" id="stat-ai">0</strong>
              <span class="stats-subnote">条 AI 摘录</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 控制与过滤工具栏 -->
    <section class="my-6 space-y-4" data-enter="bottom">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <!-- 内部子页签 (带有平滑动效的胶囊滑块) -->
        <div class="subtabs-cluster self-start" id="subtabs-cluster">
          <span class="subtabs-glider" id="subtabs-glider" aria-hidden="true"></span>
          <button type="button" class="sub-tab-btn active" data-kind="all">全部笔记</button>
          <button type="button" class="sub-tab-btn" data-kind="free">Markdown 随记</button>
          <button type="button" class="sub-tab-btn" data-kind="highlight">文章划线批注</button>
          <button type="button" class="sub-tab-btn" data-kind="ai">墨问 AI 问答</button>
        </div>

        <!-- 检索与功能操作按钮群 -->
        <div class="flex items-center gap-2.5 sm:gap-3 flex-wrap">
          <!-- 实时关键词搜索框 -->
          <div class="relative w-full sm:w-64">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--muted)] pointer-events-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="search-input"
              placeholder="搜索标题、正文、批注..."
              class="w-full bg-[var(--bg-elev)] border border-[var(--rule)] text-xs rounded-full pl-9 pr-3 py-2 text-[var(--text-strong)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--ink-strong)] transition duration-200"
            />
          </div>

          <!-- 新建便签按钮 -->
          <button
            id="open-editor-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full text-xs font-semibold bg-[var(--ink-strong)] text-[var(--bg-base)] hover:opacity-90 active:scale-95 transition duration-200 shadow-sm cursor-pointer"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>新建便签</span>
          </button>

          <!-- 导出 Markdown 按钮 -->
          <button
            id="export-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full border border-[var(--rule)] text-xs font-medium text-[var(--muted-strong)] bg-[var(--bg-elev)] hover:text-[var(--text-strong)] hover:border-[var(--ink-strong)] active:scale-95 transition duration-200 cursor-pointer"
            title="将当前筛选的所有笔记导出为 Markdown 研读卡片"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>导出</span>
          </button>

          <!-- 云端同步按钮 -->
          <button
            id="sync-btn"
            type="button"
            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full border border-[var(--rule)] text-xs font-medium text-[var(--muted-strong)] bg-[var(--bg-elev)] hover:text-[var(--text-strong)] hover:border-[var(--ink-strong)] active:scale-95 transition duration-200 cursor-pointer"
            title="手动触发与私有云端增量同步"
          >
            <svg id="sync-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"></path>
            </svg>
            <span id="sync-text">同步</span>
          </button>
        </div>
      </div>

      <!-- 二级维度筛选：文章归属自定义下拉气泡 + 纯色标过滤圆点 -->
      <div class="flex flex-wrap items-center gap-4 pt-1">
        <!-- 自定义「文章归属」下拉气泡组件 -->
        <div class="relative inline-block" id="article-popover-container">
          <button
            type="button"
            id="article-popover-trigger"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-[var(--rule)] bg-[var(--bg-elev)] text-xs text-[var(--text-strong)] hover:border-[var(--ink-strong)] transition duration-200 shadow-sm font-medium cursor-pointer"
            aria-haspopup="dialog"
            aria-expanded="false"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--muted)]">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            <span id="article-trigger-label">来源: 全部文章 (0)</span>
            <span id="article-quick-clear" class="hidden hover:text-red-500 p-0.5 rounded cursor-pointer" title="清除文章筛选">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--muted)] ml-0.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>

          <!-- 展开的气泡面板 (Popover) -->
          <div
            id="article-popover-panel"
            class="article-popover is-closed absolute left-0 top-full mt-2 w-80 max-w-[90vw] p-2.5"
          >
            <!-- 气泡内的即时文章搜索 -->
            <div class="relative mb-2">
              <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 text-[var(--muted)] pointer-events-none" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="article-search-input"
                placeholder="过滤文章来源..."
                class="w-full bg-[var(--bg-soft)] border border-[var(--rule)] text-xs rounded-lg pl-7 pr-2.5 py-1.5 text-[var(--text-strong)] placeholder-[var(--muted)] focus:outline-none focus:border-[var(--ink-strong)]"
              />
            </div>

            <!-- 文章列表 -->
            <div class="max-h-60 overflow-y-auto space-y-1 text-xs" id="article-list-container">
              <!-- 动态渲染文章列表 -->
            </div>
          </div>
        </div>

        <div class="h-4 w-px bg-[var(--rule)]"></div>

        <!-- 纯色彩圆点筛选（极简色环，无文字名称） -->
        <div class="flex items-center gap-1.5">
          <button type="button" class="all-color-pill active" data-color="all">全部</button>
          <button type="button" class="color-dot-btn" data-color="red" style="--dot-color: #ef5350;" title="朱红"></button>
          <button type="button" class="color-dot-btn" data-color="blue" style="--dot-color: #42a5f5;" title="靛青"></button>
          <button type="button" class="color-dot-btn" data-color="green" style="--dot-color: #66bb6a;" title="竹青"></button>
          <button type="button" class="color-dot-btn" data-color="yellow" style="--dot-color: #ffa726;" title="雄黄"></button>
        </div>
      </div>
    </section>

    <!-- 3. 便签卡片多列看板 (自适应栅格，彻底根除多列拆碎卡片问题) -->
    <section id="notes-container" class="notes-grid pt-2">
      <!-- 动态插入卡片 -->
    </section>

    <!-- 空状态提示 (当检索无结果时) -->
    <div id="empty-state" class="hidden text-center py-20">
      <div class="w-16 h-16 rounded-full bg-[var(--bg-soft)] border border-[var(--rule)] mx-auto flex items-center justify-center text-[var(--muted)] mb-4">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="9" y1="15" x2="15" y2="15"></line>
        </svg>
      </div>
      <h3 class="text-base font-semibold text-[var(--text-strong)]">暂无匹配的笔记</h3>
      <p class="text-xs text-[var(--muted-strong)] mt-1">尝试更换筛选条件，或者点击上方“新建便签”添加第一条笔记。</p>
    </div>
  </main>

  <!-- 4. 笔记大窗阅读详情弹层 (Zoom / Maximize Reader Modal，已去底栏，精炼顶栏操作，不换行) -->
  <div id="reader-modal" class="fixed inset-0 z-50 modal-overlay is-closed hidden flex items-center justify-center p-4">
    <div class="bg-[var(--bg-elev)] border border-[var(--rule-strong)] rounded-2xl w-full max-w-3xl overflow-hidden shadow-2xl modal-card flex flex-col max-h-[88vh]">
      <!-- 弹层头部 (严格不换行排布，操作群右对齐) -->
      <div class="px-5 sm:px-6 py-3.5 border-b border-[var(--rule)] flex items-center justify-between gap-3 bg-[var(--bg-soft)] shrink-0 flex-nowrap">
        <!-- 左侧：类型徽标与记录时间 -->
        <div class="flex items-center gap-2.5 min-w-0 shrink flex-nowrap">
          <span id="reader-kind-badge" class="whitespace-nowrap shrink-0"></span>
          <span class="text-xs text-[var(--muted)] whitespace-nowrap truncate" id="reader-time"></span>
        </div>

        <!-- 右侧操作栏 (绝不换行：whitespace-nowrap shrink-0 flex-nowrap) -->
        <div class="flex items-center gap-2 shrink-0 flex-nowrap whitespace-nowrap">
          <!-- 快捷跳转原文按钮 (若是文章笔记，加不换行保护) -->
          <button
            id="reader-jump-btn"
            type="button"
            class="hidden text-xs font-semibold px-3 py-1.5 rounded-full border border-[var(--rule)] bg-[var(--bg-elev)] text-[var(--text-strong)] hover:border-[var(--ink-strong)] transition items-center gap-1.5 shadow-sm whitespace-nowrap shrink-0 cursor-pointer"
            title="在文章正文中定位此段"
          >
            <span class="whitespace-nowrap">跳转原文</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>

          <!-- 复制引用按钮 (纯图标按钮，置于顶部) -->
          <button
            id="reader-copy-btn"
            type="button"
            class="w-8 h-8 rounded-full border border-[var(--rule)] bg-[var(--bg-elev)] text-[var(--muted-strong)] hover:text-[var(--text-strong)] hover:border-[var(--ink-strong)] transition flex items-center justify-center shrink-0 shadow-sm cursor-pointer"
            title="复制 Markdown 引用卡片"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
          </button>

          <!-- 编辑按钮 -->
          <button
            id="reader-edit-btn"
            type="button"
            class="text-xs font-medium px-3 py-1.5 rounded-full border border-[var(--rule)] bg-[var(--bg-elev)] text-[var(--muted-strong)] hover:text-[var(--text-strong)] hover:border-[var(--ink-strong)] transition whitespace-nowrap shrink-0 cursor-pointer"
          >
            编辑
          </button>

          <!-- 关闭按钮 -->
          <button
            id="close-reader-btn"
            type="button"
            class="w-8 h-8 rounded-full flex items-center justify-center text-[var(--muted)] hover:text-[var(--text-strong)] hover:bg-[var(--accent-soft)] transition shrink-0 cursor-pointer"
            title="关闭大窗 (Esc)"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- 放大阅读正文主体 (宽敞舒适的排版，去底栏后空间利用最大化) -->
      <div class="p-6 sm:p-8 overflow-y-auto space-y-5 flex-1" id="reader-body">
        <h2 id="reader-title" class="font-extrabold text-xl sm:text-2xl text-[var(--text-strong)] tracking-tight"></h2>

        <!-- 标签与归属条 -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-[var(--rule)] text-xs text-[var(--muted)]" id="reader-meta-bar">
          <div id="reader-tags" class="flex flex-wrap gap-1.5"></div>
          <div id="reader-source" class="font-medium"></div>
        </div>

        <!-- 详细内容区域 -->
        <div id="reader-content" class="text-sm sm:text-base leading-relaxed text-[var(--text)] prose-preview">
          <!-- 动态渲染完整的 Markdown / 划词与批注 -->
        </div>
      </div>
    </div>
  </div>

  <!-- 5. Markdown 弹层卡片编辑器 (Modal) -->
  <div id="editor-modal" class="fixed inset-0 z-50 modal-overlay is-closed hidden flex items-center justify-center p-4">
    <div class="bg-[var(--bg-elev)] border border-[var(--rule-strong)] rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl modal-card flex flex-col max-h-[90vh]">
      <!-- 弹层头部 -->
      <div class="px-6 py-4 border-b border-[var(--rule)] flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[var(--ink-strong)]"></span>
          <h2 id="modal-title" class="font-bold text-base text-[var(--text-strong)]">新建 Markdown 便签</h2>
        </div>
        <button id="close-modal-btn" type="button" class="text-[var(--muted)] hover:text-[var(--text-strong)] transition cursor-pointer" title="关闭 (Esc)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- 编辑主体 -->
      <div class="p-6 overflow-y-auto space-y-4 flex-1">
        <!-- 标题 -->
        <div id="editor-title-wrap">
          <label class="block text-xs font-semibold text-[var(--muted)] uppercase tracking-wider mb-1.5">便签标题 (可选)</label>
          <input
            type="text"
            id="editor-title-input"
            placeholder="例如：关于 FastArraySerializer 的网络同步坑点..."
            class="w-full bg-[var(--bg-soft)] border border-[var(--rule)] rounded-lg px-3 py-2 text-sm text-[var(--text-strong)] focus:outline-none focus:border-[var(--ink-strong)] transition"
          />
        </div>

        <!-- 属性控制行：纯色标选择与标签输入 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-[var(--muted)] uppercase tracking-wider mb-2">色彩分类</label>
            <div class="flex items-center gap-3" id="modal-color-picker">
              <label class="cursor-pointer" title="朱红">
                <input type="radio" name="note-color" value="red" class="sr-only peer" />
                <div class="w-6 h-6 rounded-full peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-[var(--ink-strong)] peer-checked:scale-110 transition flex items-center justify-center shadow-sm" style="background:#ef5350"></div>
              </label>
              <label class="cursor-pointer" title="靛青">
                <input type="radio" name="note-color" value="blue" class="sr-only peer" checked />
                <div class="w-6 h-6 rounded-full peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-[var(--ink-strong)] peer-checked:scale-110 transition flex items-center justify-center shadow-sm" style="background:#42a5f5"></div>
              </label>
              <label class="cursor-pointer" title="竹青">
                <input type="radio" name="note-color" value="green" class="sr-only peer" />
                <div class="w-6 h-6 rounded-full peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-[var(--ink-strong)] peer-checked:scale-110 transition flex items-center justify-center shadow-sm" style="background:#66bb6a"></div>
              </label>
              <label class="cursor-pointer" title="雄黄">
                <input type="radio" name="note-color" value="yellow" class="sr-only peer" />
                <div class="w-6 h-6 rounded-full peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-[var(--ink-strong)] peer-checked:scale-110 transition flex items-center justify-center shadow-sm" style="background:#ffa726"></div>
              </label>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-[var(--muted)] uppercase tracking-wider mb-1.5">标签 (用空格或逗号分隔)</label>
            <input
              type="text"
              id="editor-tags-input"
              placeholder="架构, UE5, 随感"
              class="w-full bg-[var(--bg-soft)] border border-[var(--rule)] rounded-lg px-3 py-1.5 text-xs text-[var(--text-strong)] focus:outline-none focus:border-[var(--ink-strong)] transition"
            />
          </div>
        </div>

        <!-- Markdown 编辑与预览 Tab 切换 -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-xs font-semibold text-[var(--muted)] uppercase tracking-wider" id="editor-content-label">Markdown 正文内容</label>
            <div class="inline-flex rounded-lg p-0.5 bg-[var(--bg-soft)] border border-[var(--rule)] text-xs">
              <button type="button" id="tab-write-btn" class="px-2.5 py-0.5 rounded-md font-medium text-[var(--bg-base)] bg-[var(--ink-strong)] cursor-pointer">编写</button>
              <button type="button" id="tab-preview-btn" class="px-2.5 py-0.5 rounded-md font-medium text-[var(--muted-strong)] hover:text-[var(--text-strong)] cursor-pointer">预览</button>
            </div>
          </div>

          <textarea
            id="editor-content-input"
            rows="8"
            placeholder="支持完整 Markdown 语法，如：&#10;# 核心思路&#10;- 要点一：避免跨模块裸指针传递&#10;- 要点二：使用 TSharedPtr / TWeakPtr&#10;```cpp&#10;TSharedPtr<FMyWorker> Worker = MakeShared<FMyWorker>();&#10;```"
            class="w-full bg-[var(--bg-soft)] border border-[var(--rule)] rounded-lg p-3 text-xs sm:text-sm font-mono text-[var(--text-strong)] focus:outline-none focus:border-[var(--ink-strong)] transition resize-y"
          ></textarea>

          <div id="editor-preview-area" class="w-full min-h-[200px] p-4 bg-[var(--bg-soft)] border border-[var(--rule)] rounded-lg text-xs sm:text-sm prose-preview hidden overflow-y-auto max-h-[300px]">
          </div>
        </div>
      </div>

      <!-- 弹层底部按钮 -->
      <div class="px-6 py-3.5 bg-[var(--bg-soft)] border-t border-[var(--rule)] flex items-center justify-between">
        <span class="text-xs text-[var(--muted)]">快捷键：⌘ / Ctrl + Enter 保存</span>
        <div class="flex items-center gap-2">
          <button type="button" id="cancel-modal-btn" class="px-4 py-1.5 rounded-lg text-xs font-medium text-[var(--muted-strong)] hover:text-[var(--text-strong)] transition cursor-pointer">取消</button>
          <button type="button" id="save-note-btn" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-[var(--ink-strong)] text-[var(--bg-base)] hover:opacity-90 active:scale-95 transition shadow-sm cursor-pointer">保存便签</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. 浮动 Toast 提示 -->
  <div id="notes-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 transition-all duration-300 pointer-events-none bg-[var(--ink-strong)] text-[var(--bg-base)] px-4 py-2.5 rounded-xl shadow-xl text-xs font-medium flex items-center gap-2">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span id="notes-toast-msg">操作成功</span>
  </div>
</BaseLayout>

<style>
  /* 统计长条 */
  .notes-stats-strip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.35rem 0.6rem;
    border-radius: 9999px;
