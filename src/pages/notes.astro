    margin-bottom: 0.35em;
  }
  :global(.prose-preview h1) { font-size: 1.3em; }
  :global(.prose-preview h2) { font-size: 1.16em; }
  :global(.prose-preview h3) { font-size: 1.06em; }
  :global(.prose-preview h4),
  :global(.prose-preview h5),
  :global(.prose-preview h6) { font-size: 1em; }
  :global(.prose-preview p) { margin-bottom: 0.6em; line-height: 1.75; }
  :global(.prose-preview code) {
    background-color: var(--accent-soft);
    padding: 0.15em 0.35em;
    border-radius: 4px;
    font-size: 0.85em;
    font-family: var(--font-mono, monospace);
    overflow-wrap: anywhere;
  }
  :global(.prose-preview pre) {
    background-color: var(--bg-soft);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.75rem;
    overflow-x: auto;
    font-size: 0.82em;
    font-family: var(--font-mono, monospace);
    margin: 0.6em 0;
    max-width: 100%;
  }
  :global(.prose-preview pre code) {
    background: transparent;
    padding: 0;
