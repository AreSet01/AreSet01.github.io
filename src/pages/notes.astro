  .sub-tab-btn.active {
    color: var(--bg-base) !important;
    font-weight: 600;
  }

  /* 卡片多列网格：使用原生 CSS Grid，原子级栅格单元，彻底根除 column-count 导致的卡片纵向跨列撕裂 BUG */
  .notes-grid {
    display: grid;
    grid-template-columns: 1fr;
