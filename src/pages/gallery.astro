</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import CustomEase from 'gsap/CustomEase';
  import { GALLERY_PHOTOS } from '../data/gallery';

  gsap.registerPlugin(ScrollTrigger, CustomEase);
  CustomEase.create('enter', 'M0,0 C0.16,1 0.3,1 1,1');
  CustomEase.create('ink', '0.25, 1, 0.5, 1');

  const CLEANUP_KEY = '__galleryCleanup';
  const LISTENER_KEY = '__galleryPageLoadBound';

  function initGalleryPage() {
    const container = document.getElementById('gallery-cards-container');
    if (!container) return; // Not on gallery page

    if ((window as any)[CLEANUP_KEY]) {
      (window as any)[CLEANUP_KEY]();
    }

    const controller = new AbortController();
    const signal = controller.signal;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let currentCategory = 'all';
    let searchQuery = '';
    let currentPhotoIndex = 0;
    let isLightboxOpen = false;
    let lastFocusedElement: HTMLElement | null = null;
    let filterTimeline: gsap.core.Timeline | null = null;

    // DOM 元素缓存
    const catTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-tab]'));
    const searchInput = document.getElementById('gallery-search-input') as HTMLInputElement | null;
    const searchClear = document.getElementById('gallery-search-clear');
    const cards = Array.from(container.querySelectorAll<HTMLElement>('.gallery-mat-card'));
    const emptyState = document.getElementById('gallery-empty-state');
    const resetBtn = document.getElementById('gallery-reset-filter');

    // Lightbox 元素缓存
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-main-img') as HTMLImageElement | null;
    const lightboxImgWrapper = document.querySelector('[data-lightbox-img-wrapper]') as HTMLElement | null;
    const lightboxTitle = document.getElementById('lightbox-info-title');
    const lightboxLocation = document.getElementById('lightbox-info-location');
    const lightboxDate = document.getElementById('lightbox-info-date');
    const lightboxStory = document.getElementById('lightbox-info-story');
    const lightboxCounterCurrent = document.querySelector('[data-lightbox-current]');
    const lightboxCounterTotal = document.querySelector('[data-lightbox-total]');
    const lightboxExifCamera = document.getElementById('lightbox-exif-camera');
    const lightboxExifLens = document.getElementById('lightbox-exif-lens');
    const lightboxExifAperture = document.getElementById('lightbox-exif-aperture');
    const lightboxExifShutter = document.getElementById('lightbox-exif-shutter');
    const lightboxExifIso = document.getElementById('lightbox-exif-iso');

    /**
     * 把网格高度钉在「全部影痕」时的高度，防止筛选导致页面跳动与滚动位置钳制
     */
    let maxContainerHeight = 0;
    const syncGridBaseline = () => {
      const hidden = cards.filter((card) => card.classList.contains('is-filtered-out'));
      if (hidden.length === 0) {
        const full = container.offsetHeight;
        if (full > 0) {
          maxContainerHeight = Math.max(maxContainerHeight, full);
          container.style.minHeight = `${maxContainerHeight}px`;
        }
        return;
      }
      if (maxContainerHeight > 0) {
        container.style.minHeight = `${maxContainerHeight}px`;
      }
    };
    syncGridBaseline();

    let baselineTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(baselineTimer);
      baselineTimer = window.setTimeout(() => {
        maxContainerHeight = 0;
        syncGridBaseline();
      }, 180);
    }, { signal });

    /**
     * 将卡片状态从动画或隐藏完全交付给页面，确保在动画结束后不受任何行内样式干扰
     */
    function settleCard(el: HTMLElement) {
      el.classList.remove('is-entering', 'is-reflowing');
      el.classList.add('is-entered');
      el.dataset.enterState = 'in';
      gsap.killTweensOf(el);
      gsap.set(el, { clearProps: 'clipPath,opacity,transform,scale,x,y' });
    }

    function refreshScroll() {
      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.refresh();
      }
      try {
        (window as any).lenis?.resize();
      } catch {}
    }

    /**
     * 方案 B：【书法卷轴徐展】
     * 1. 卷轴卷收 (Roll-up): 退场卡片从右向左古卷合拢 (clip-path: inset(0 100% 0 0), 0.3s)
     * 2. 换骨就位 (DOM Swap): 批量切换过滤状态并预置入场卡片初态
     * 3. 卷轴徐展 (Scroll Unfurling): 入场卡片如素笺宣纸从左向右徐徐舒展 (clip-path: inset(0 0% 0 0), 0.72s, ease: 'enter')
     */
    function applyFilters(animate = true, shouldScroll = false) {
      if (filterTimeline) {
        filterTimeline.kill();
        filterTimeline = null;
      }
      cards.forEach((card) => {
        gsap.killTweensOf(card);
        card.classList.remove('is-reflowing', 'is-entering');
        card.classList.add('is-entered');
        card.dataset.enterState = 'in';
        gsap.set(card, { clearProps: 'clipPath,opacity,transform,scale,x,y' });
      });

      const q = searchQuery.toLowerCase().trim();
      const matchCard = (card: HTMLElement) => {
        const cat = card.getAttribute('data-category') || '';
        const searchText = card.getAttribute('data-search-text') || '';

        const matchesCat = currentCategory === 'all' || cat === currentCategory;
        const matchesSearch = !q || searchText.includes(q);
        return matchesCat && matchesSearch;
      };

      const toShow: HTMLElement[] = [];
      const toHide: HTMLElement[] = [];

      cards.forEach((card) => {
        if (matchCard(card)) {
          toShow.push(card);
        } else {
          toHide.push(card);
        }
      });

      // 切换分类或标签时，若已下滚超出视野，平滑引导回网格顶部
      const tabsEl = document.querySelector('.gallery-category-tabs');
      if (tabsEl && animate && shouldScroll) {
        const tabsRect = tabsEl.getBoundingClientRect();
        if (tabsRect.top < 60) {
          if ((window as any).lenis) {
            (window as any).lenis.scrollTo(tabsEl, { offset: -80, duration: 0.6 });
          } else {
            tabsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

      const currentlyVisible = cards.filter((card) => !card.classList.contains('is-filtered-out'));

      if (
        currentlyVisible.length === toShow.length &&
        currentlyVisible.every((c, i) => c === toShow[i])
      ) {
        toShow.forEach((card) => settleCard(card));
        toHide.forEach((card) => {
          card.classList.add('is-filtered-out');
          settleCard(card);
        });
        if (emptyState) {
          emptyState.classList.toggle('hidden', toShow.length > 0);
        }
        return;
      }

      if (!animate || reduceMotion) {
        toHide.forEach((card) => {
          card.classList.add('is-filtered-out');
          settleCard(card);
        });
        toShow.forEach((card) => {
          card.classList.remove('is-filtered-out');
          settleCard(card);
        });
        if (emptyState) {
          emptyState.classList.toggle('hidden', toShow.length > 0);
        }
        container.style.minHeight = '0px';
        refreshScroll();
        return;
      }

      const currentH = container.offsetHeight;

      // ========================================================
      // 场景 A：搜索无结果（空状态），页面变短时平滑过渡
      // ========================================================
      if (toShow.length === 0) {
        if (currentH > 0) {
          container.style.minHeight = `${currentH}px`;
        }

        // 若用户已向下滚动，调用 Lenis 平滑引导视口回至搜索栏，彻底杜绝单帧瞬变回弹
        const searchWrapper = document.querySelector('.gallery-search-wrapper') || tabsEl;
        if (searchWrapper && window.scrollY > 80) {
          if ((window as any).lenis) {
            (window as any).lenis.scrollTo(searchWrapper, {
              offset: -90,
              duration: 0.65,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
          } else {
            searchWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        const exitingCards = currentlyVisible;
        const tl = gsap.timeline({
          onComplete: () => {
            exitingCards.forEach((c) => {
              c.classList.add('is-filtered-out');
              c.classList.remove('is-reflowing');
              settleCard(c);
            });

            if (emptyState) {
              emptyState.classList.remove('hidden');
              gsap.fromTo(
                emptyState,
                { opacity: 0, y: 16, scale: 0.98 },
                { opacity: 1, y: 0, scale: 1, duration: 0.42, ease: 'power2.out' }
              );
            }

            // 平滑收缩网格容器高度至 0，杜绝顿变
            gsap.to(container, {
              minHeight: 0,
              duration: 0.55,
              ease: 'power2.inOut',
              onUpdate: () => refreshScroll(),
              onComplete: () => {
                container.style.minHeight = '0px';
                refreshScroll();
                filterTimeline = null;
              },
            });
          },
        });
        filterTimeline = tl;

        if (exitingCards.length > 0) {
          exitingCards.forEach((c) => {
            c.classList.add('is-reflowing');
            c.classList.remove('is-entered');
          });
          gsap.set(exitingCards, { clipPath: 'inset(0 0% 0 0)' });
          tl.to(exitingCards, {
            clipPath: 'inset(0 100% 0 0)',
            opacity: 0,
            scale: 0.98,
            duration: 0.28,
            ease: 'power2.inOut',
            stagger: 0.02,
          });
        }
        return;
      }

      // ========================================================
      // 场景 B：正常过滤有结果呈现
      // ========================================================
      if (emptyState) {
        emptyState.classList.add('hidden');
      }

      // 动画期间将高度锁定在当前高度，彻底杜绝切换中的布局抖动
      if (currentH > 0) {
        container.style.minHeight = `${currentH}px`;
      }

      // 若卡片数量减少导致页面变短且用户滚在非常靠下的位置，平滑引导视口
      const searchWrapper = document.querySelector('.gallery-search-wrapper') || tabsEl;
      if (searchWrapper && window.scrollY > 300 && toShow.length <= 3) {
        if ((window as any).lenis) {
          (window as any).lenis.scrollTo(searchWrapper, { offset: -90, duration: 0.6 });
        }
      }

      const exitingCards = currentlyVisible;
      const enteringCards = toShow;

      const tl = gsap.timeline({
        onComplete: () => {
          toShow.forEach((card) => settleCard(card));
          toHide.forEach((card) => {
            card.classList.add('is-filtered-out');
            settleCard(card);
          });
          gsap.to(container, {
            minHeight: 0,
            duration: 0.35,
            ease: 'power2.out',
            onComplete: () => {
              container.style.minHeight = '0px';
              refreshScroll();
              filterTimeline = null;
            },
          });
        },
      });
      filterTimeline = tl;

      // 阶段 1：需退场的卡片卷轴卷收 (Roll-up)
      if (exitingCards.length > 0) {
        exitingCards.forEach((c) => {
          c.classList.add('is-reflowing');
          c.classList.remove('is-entered');
        });
        gsap.set(exitingCards, { clipPath: 'inset(0 0% 0 0)' });
        tl.to(exitingCards, {
          clipPath: 'inset(0 100% 0 0)',
          opacity: 0,
          scale: 0.98,
          duration: 0.28,
          ease: 'power2.inOut',
          stagger: 0.02,
        }, 0);
      }

      const exitStaggerTotal = exitingCards.length > 0 ? Math.min(exitingCards.length - 1, 6) * 0.02 : 0;
      const switchTime = exitingCards.length > 0 ? (0.28 + exitStaggerTotal) : 0;

      // 阶段 2：换骨就位 (DOM 批切换与入场状态预置)
      tl.add(() => {
        toHide.forEach((card) => {
          card.classList.add('is-filtered-out');
          card.classList.remove('is-reflowing');
          settleCard(card);
        });
        enteringCards.forEach((card) => {
          card.classList.remove('is-filtered-out');
          card.classList.add('is-reflowing');
          card.dataset.enterState = 'in';
        });

        // 预置入场卡片卷轴初态
        if (enteringCards.length > 0) {
          gsap.set(enteringCards, {
            clipPath: 'inset(0 100% 0 0)',
            opacity: 0,
            x: -16,
            scale: 0.98,
          });
        }
      }, switchTime);

      // 阶段 3：卷轴徐展 (Scroll Unfurling from left to right)
      if (enteringCards.length > 0) {
        tl.to(enteringCards, {
          clipPath: 'inset(0 0% 0 0)',
          opacity: 1,
          x: 0,
          scale: 1,
          duration: 0.68,
          ease: 'enter',
          stagger: 0.06,
        }, switchTime);
      }
    }

    // 分类 Tab 切换
    catTabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.stopPropagation();
        const catId = tab.dataset.categoryTab;
        if (!catId) return;
        if (catId === currentCategory && !searchQuery) return;

        currentCategory = catId;
        catTabs.forEach((t) => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        // Ink splash
        const rect = tab.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 8);
        }

        applyFilters(true, true);
      }, { signal });
    });

    // 卡片内小标签点击直接填入搜索框并即时过滤
    cards.forEach((card) => {
      const chips = card.querySelectorAll<HTMLElement>('[data-click-tag]');
      chips.forEach((chip) => {
        chip.addEventListener('click', (e) => {
          e.stopPropagation();
          const tag = chip.getAttribute('data-click-tag');
          if (!tag) return;

          // 重置分类至「全部影痕」，以保证全库检索该标签
          currentCategory = 'all';
          catTabs.forEach((t, i) => {
            if (i === 0) {
              t.classList.add('is-active');
              t.setAttribute('aria-selected', 'true');
            } else {
              t.classList.remove('is-active');
              t.setAttribute('aria-selected', 'false');
            }
          });

          if (searchInput) {
            searchInput.value = tag;
            searchQuery = tag;
            if (searchClear) searchClear.classList.remove('hidden');
            applyFilters();
            searchInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }

          const rect = chip.getBoundingClientRect();
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 8);
        }, { signal });
      });
    });

    // 搜索输入防抖与 IME 输入法合成锁
    let searchTimer = 0;
    let isComposing = false;
    if (searchInput) {
      searchInput.addEventListener('compositionstart', () => {
        isComposing = true;
      }, { signal });

      searchInput.addEventListener('compositionend', () => {
        isComposing = false;
        searchQuery = searchInput.value;
        if (searchClear) {
          searchClear.classList.toggle('hidden', searchQuery.length === 0);
        }
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          applyFilters();
        }, 80);
      }, { signal });

      searchInput.addEventListener('input', () => {
        if (isComposing) return;
        searchQuery = searchInput.value;
        if (searchClear) {
          searchClear.classList.toggle('hidden', searchQuery.length === 0);
        }
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          applyFilters();
        }, 120);
      }, { signal });
    }

    searchClear?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      searchClear.classList.add('hidden');
      applyFilters();
      searchInput?.focus();
    }, { signal });

    resetBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentCategory = 'all';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      searchClear?.classList.add('hidden');
      catTabs.forEach((t, i) => {
        if (i === 0) {
          t.classList.add('is-active');
          t.setAttribute('aria-selected', 'true');
        } else {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        }
      });
      const rect = resetBtn.getBoundingClientRect();
      (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 14);
      applyFilters(true, true);
    }, { signal });

    // =========================================================
    // 水墨暗房看图器逻辑 (Ink Darkroom Lightbox)
    // =========================================================
    function getActivePhotoList() {
      const visibleCards = cards.filter((c) => !c.classList.contains('is-filtered-out'));
      const visibleIds = visibleCards.map((c) => c.dataset.photoId);
      const filtered = GALLERY_PHOTOS.filter((p) => visibleIds.includes(p.id));
      return filtered.length > 0 ? filtered : GALLERY_PHOTOS;
    }

    function computeTargetLightboxRect(photo: any) {
      const stage = lightbox?.querySelector<HTMLElement>('.lightbox-stage');
      const stageRect = stage ? stage.getBoundingClientRect() : {
        left: 0,
        top: 60,
        width: window.innerWidth,
        height: window.innerHeight - 180,
      };

      const [aspectW, aspectH] = (photo.aspectRatio || '3:2').split(':').map(Number);
      const aspect = (aspectW && aspectH) ? aspectW / aspectH : 1.5;

      const isMobile = window.innerWidth < 640;
      const paddingH = isMobile ? 32 : 108;
      const paddingV = 20;

      const stageW = stageRect.width > 0 ? stageRect.width : window.innerWidth;
      const stageH = stageRect.height > 0 ? stageRect.height : window.innerHeight - 180;

      const availableW = Math.max(260, stageW - paddingH);
      const availableH = Math.max(200, stageH - paddingV);

      let targetW = Math.min(1120, availableW);
      let targetH = targetW / aspect;

      if (targetH > availableH) {
        targetH = availableH;
        targetW = targetH * aspect;
      }

      targetW = Math.max(200, Math.round(targetW));
      targetH = Math.max(140, Math.round(targetH));

      const targetCenterX = stageRect.left + stageW / 2;
      const targetCenterY = stageRect.top + stageH / 2;

      return {
        width: targetW,
        height: targetH,
        centerX: targetCenterX,
        centerY: targetCenterY,
      };
    }

    function renderLightboxPhoto(index: number, isInitialOpen = false) {
      const list = getActivePhotoList();
      if (list.length === 0) return;
      currentPhotoIndex = (index + list.length) % list.length;
      const photo = list[currentPhotoIndex];
      if (!photo) return;

      if (lightboxImg) {
        lightboxImg.src = photo.url;
        lightboxImg.alt = photo.title;
        const [w, h] = photo.aspectRatio.split(':').map(Number);
        if (w && h) {
          lightboxImg.style.aspectRatio = `${w} / ${h}`;
        }
      }
      if (lightboxImgWrapper) {
        const targetDims = computeTargetLightboxRect(photo);
        lightboxImgWrapper.style.width = `${targetDims.width}px`;
        lightboxImgWrapper.style.height = `${targetDims.height}px`;
        const [w, h] = photo.aspectRatio.split(':').map(Number);
        if (w && h) {
          lightboxImgWrapper.style.setProperty('--lightbox-aspect', `${w} / ${h}`);
        }
      }
      if (lightboxTitle) lightboxTitle.textContent = photo.title;
      if (lightboxLocation) lightboxLocation.textContent = `📍 ${photo.location}`;
      if (lightboxDate) lightboxDate.textContent = `📅 ${photo.date}`;
      if (lightboxStory) lightboxStory.textContent = `“${photo.story}”`;

      if (lightboxCounterCurrent) lightboxCounterCurrent.textContent = String(currentPhotoIndex + 1);
      if (lightboxCounterTotal) lightboxCounterTotal.textContent = String(list.length);

      if (lightboxExifCamera) lightboxExifCamera.textContent = photo.exif.camera;
      if (lightboxExifLens) lightboxExifLens.textContent = photo.exif.lens;
      if (lightboxExifAperture) lightboxExifAperture.textContent = photo.exif.aperture;
      if (lightboxExifShutter) lightboxExifShutter.textContent = photo.exif.shutter;
      if (lightboxExifIso) lightboxExifIso.textContent = photo.exif.iso;

      // Only animate crossfade when switching photos, not during initial openLightbox choreography
      if (!isInitialOpen && lightboxImgWrapper && !reduceMotion) {
        gsap.fromTo(lightboxImgWrapper,
          { opacity: 0.5, scale: 0.97 },
          { opacity: 1, scale: 1, duration: 0.28, ease: 'power2.out', clearProps: 'scale' }
        );
      }

      // 切换照片时，恢复原先打开时可能被暂隐的初始卡片
      if (!isInitialOpen && activeSourceImgEl) {
        activeSourceImgEl.style.opacity = '';
        activeSourceImgEl.style.pointerEvents = '';
        activeSourceImgEl = null;
      }
    }

    let lightboxTimeline: gsap.core.Timeline | null = null;
    let activeSourceImgEl: HTMLElement | null = null;

    function openLightbox(photoId: string, originEl?: HTMLElement) {
      if (!lightbox) return;
      isLightboxOpen = true;
      if (originEl) lastFocusedElement = originEl;

      const list = getActivePhotoList();
      const idx = list.findIndex((p) => p.id === photoId);
      const photo = list[idx >= 0 ? idx : 0] || GALLERY_PHOTOS[0];

      // Lenis 协调：暂停页面滚动
      if ((window as any).lenis) {
        (window as any).lenis.stop();
      }
      document.body.classList.add('gallery-lightbox-open');

      if (lightboxTimeline) {
        lightboxTimeline.kill();
        lightboxTimeline = null;
      }

      // 清除可能残留的暂隐卡片
      if (activeSourceImgEl) {
        activeSourceImgEl.style.opacity = '';
        activeSourceImgEl.style.pointerEvents = '';
        activeSourceImgEl = null;
      }

      // 查找对应卡片与相框元素
      const sourceCard = cards.find((c) => c.dataset.photoId === photoId);
      const sourceImgEl = sourceCard?.querySelector<HTMLElement>('.mat-image-window');

      lightbox.classList.remove('hidden');
      lightbox.classList.add('is-open');

      renderLightboxPhoto(idx >= 0 ? idx : 0, true);

      const backdrop = lightbox.querySelector<HTMLElement>('.lightbox-backdrop');
      const containerEl = lightbox.querySelector<HTMLElement>('.lightbox-container');
      const topBar = lightbox.querySelector<HTMLElement>('.lightbox-top-bar');
      const drawer = lightbox.querySelector<HTMLElement>('.lightbox-info-drawer');
      const closeBtn = lightbox.querySelector<HTMLElement>('.lightbox-close-btn');
      const navArrows = lightbox.querySelectorAll<HTMLElement>('.lightbox-nav-arrow');

      if (!reduceMotion && backdrop && containerEl && lightboxImgWrapper) {
        const targetDims = computeTargetLightboxRect(photo);
        const sourceRect = sourceImgEl?.getBoundingClientRect();

        const isValidSource = Boolean(
          sourceImgEl &&
          sourceRect &&
          sourceRect.width > 20 &&
          sourceRect.height > 20 &&
          sourceRect.bottom > 0 &&
          sourceRect.top < window.innerHeight &&
          sourceRect.right > 0 &&
          sourceRect.left < window.innerWidth
        );

        const tl = gsap.timeline({
          onComplete: () => {
            closeBtn?.focus?.();
            lightboxTimeline = null;
            // 展开完全落定后，静默恢复卡片在暗色幕布下方的正常显示，为后续无缝飞回做好平滑承接
            if (activeSourceImgEl) {
              activeSourceImgEl.style.opacity = '';
              activeSourceImgEl.style.pointerEvents = '';
              activeSourceImgEl = null;
            }
          }
        });
        lightboxTimeline = tl;

        // 重设周边元素基础初始态
        gsap.set(backdrop, { opacity: 0 });
        if (topBar) gsap.set(topBar, { opacity: 0, y: -12 });
        if (drawer) gsap.set(drawer, { opacity: 0, y: 14 });
        if (navArrows.length > 0) gsap.set(navArrows, { opacity: 0, scale: 0.88 });

        if (isValidSource && sourceImgEl && sourceRect) {
          activeSourceImgEl = sourceImgEl;
          activeSourceImgEl.style.opacity = '0';
          activeSourceImgEl.style.pointerEvents = 'none';

          const sourceCenterX = sourceRect.left + sourceRect.width / 2;
          const sourceCenterY = sourceRect.top + sourceRect.height / 2;
          const deltaX = sourceCenterX - targetDims.centerX;
          const deltaY = sourceCenterY - targetDims.centerY;
          const scaleX = Math.max(0.08, Math.min(1.0, sourceRect.width / targetDims.width));
          const scaleY = Math.max(0.08, Math.min(1.0, sourceRect.height / targetDims.height));

          gsap.set(containerEl, { opacity: 1, scale: 1, y: 0 });

          // 核心照片对齐卡片实际屏幕物理坐标 (严格安全的 0.08~1.0 比例缩放)
          gsap.set(lightboxImgWrapper, {
            x: deltaX,
            y: deltaY,
            scaleX: scaleX,
            scaleY: scaleY,
            borderRadius: '6px',
            opacity: 1,
            transformOrigin: 'center center',
          });

          // 1. 暗幕淡入
          tl.to(backdrop, {
            opacity: 1,
            duration: 0.38,
            ease: 'power2.out',
          }, 0);

          // 2. 核心照片原位平滑放大并飞至全屏居中 (约 420ms，舒展物理缓动)
          tl.to(lightboxImgWrapper, {
            x: 0,
            y: 0,
            scaleX: 1,
            scaleY: 1,
            borderRadius: '8px',
            duration: 0.42,
            ease: 'power3.out',
            clearProps: 'transform,borderRadius',
          }, 0);

          // 3. 周边展签、顶栏与箭头分层交错浮现
          if (topBar) {
            tl.to(topBar, {
              opacity: 1,
              y: 0,
              duration: 0.3,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            }, 0.16);
          }
          if (drawer) {
            tl.to(drawer, {
              opacity: 1,
              y: 0,
              duration: 0.3,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            }, 0.16);
          }
          if (navArrows.length > 0) {
            tl.to(navArrows, {
              opacity: 1,
              scale: 1,
              duration: 0.28,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            }, 0.18);
          }
        } else {
          // 容错兜底：屏幕外或无原位卡片时，使用经典水墨淡入与弹性升入
          gsap.set(containerEl, { opacity: 0, scale: 0.92, y: 18 });
          gsap.set(lightboxImgWrapper, { opacity: 0, scale: 0.90, filter: 'blur(10px)' });

          tl.to(backdrop, {
            opacity: 1,
            duration: 0.38,
            ease: 'power2.out',
          }, 0);

          tl.to(containerEl, {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.46,
            ease: 'back.out(1.4)',
          }, 0.02);

          tl.to(lightboxImgWrapper, {
            opacity: 1,
            scale: 1,
            filter: 'blur(0px)',
            duration: 0.5,
            ease: 'power3.out',
            clearProps: 'filter,transform',
          }, 0.04);

          if (topBar) {
            tl.to(topBar, {
              opacity: 1,
              y: 0,
              duration: 0.36,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            }, 0.08);
          }
          if (drawer) {
            tl.to(drawer, {
              opacity: 1,
              y: 0,
              duration: 0.36,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            }, 0.1);
          }
          if (navArrows.length > 0) {
            tl.to(navArrows, {
              opacity: 1,
              scale: 1,
              duration: 0.3,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            }, 0.1);
          }
        }
      } else {
        closeBtn?.focus?.();
      }

      // 笔墨点染印章水花
      (window as any).__inkSplash?.(window.innerWidth / 2, window.innerHeight / 2, 16);
    }

    function closeLightbox() {
      if (!lightbox || !isLightboxOpen) return;
      isLightboxOpen = false;

      // Lenis 协调：恢复页面滚动
      if ((window as any).lenis) {
        (window as any).lenis.start();
      }

      if (lightboxTimeline) {
        lightboxTimeline.kill();
        lightboxTimeline = null;
      }

      const backdrop = lightbox.querySelector<HTMLElement>('.lightbox-backdrop');
      const containerEl = lightbox.querySelector<HTMLElement>('.lightbox-container');
      const topBar = lightbox.querySelector<HTMLElement>('.lightbox-top-bar');
      const drawer = lightbox.querySelector<HTMLElement>('.lightbox-info-drawer');
      const navArrows = lightbox.querySelectorAll<HTMLElement>('.lightbox-nav-arrow');

      // 智能寻找当前正在浏览的照片对应卡片
      const list = getActivePhotoList();
      const currentPhoto = list[currentPhotoIndex] || GALLERY_PHOTOS[0];
      let targetImgEl: HTMLElement | null = null;
      let targetRect: DOMRect | null = null;
      let inViewport = false;

      if (currentPhoto) {
        const targetCard = cards.find(
          (c) => c.dataset.photoId === currentPhoto.id && !c.classList.contains('is-filtered-out')
        );
        if (targetCard) {
          targetImgEl = targetCard.querySelector<HTMLElement>('.mat-image-window');
          if (targetImgEl) {
            const r = targetImgEl.getBoundingClientRect();
            if (r.width > 20 && r.height > 20 && r.bottom > 0 && r.top < window.innerHeight && r.right > 0 && r.left < window.innerWidth) {
              targetRect = r;
              inViewport = true;
            }
          }
        }
      }

      // 确保原底层卡片处于正常可见状态以迎接飞回
      if (activeSourceImgEl) {
        activeSourceImgEl.style.opacity = '';
        activeSourceImgEl.style.pointerEvents = '';
        activeSourceImgEl = null;
      }
      if (targetImgEl) {
        targetImgEl.style.opacity = '';
        targetImgEl.style.pointerEvents = '';
      }

      if (!reduceMotion && backdrop && containerEl && lightboxImgWrapper) {
        const targetDims = computeTargetLightboxRect(currentPhoto);

        const tl = gsap.timeline({
          onComplete: () => {
            // 先完全隐藏暗房，杜绝任何单帧样式清除导致的跳闪
            lightbox.classList.remove('is-open');
            lightbox.classList.add('hidden');
            document.body.classList.remove('gallery-lightbox-open');
            lastFocusedElement?.focus?.({ preventScroll: true });
            lightboxTimeline = null;

            // 延迟 1 帧清理样式，确保 DOM hidden 布局已生效
            requestAnimationFrame(() => {
              gsap.set([backdrop, containerEl, lightboxImgWrapper, topBar, drawer, ...navArrows].filter(Boolean), { clearProps: 'all' });
            });
          }
        });
        lightboxTimeline = tl;

        // 1. 周边附属信息（顶栏、展签、箭头）先行迅速淡出
        if (topBar) {
          tl.to(topBar, { opacity: 0, y: -8, duration: 0.18, ease: 'power2.in' }, 0);
        }
        if (drawer) {
          tl.to(drawer, { opacity: 0, y: 10, duration: 0.18, ease: 'power2.in' }, 0);
        }
        if (navArrows.length > 0) {
          tl.to(navArrows, { opacity: 0, scale: 0.9, duration: 0.18, ease: 'power2.in' }, 0);
        }

        if (inViewport && targetImgEl && targetRect) {
          const targetCenterXOnCard = targetRect.left + targetRect.width / 2;
          const targetCenterYOnCard = targetRect.top + targetRect.height / 2;
          const targetDeltaX = targetCenterXOnCard - targetDims.centerX;
          const targetDeltaY = targetCenterYOnCard - targetDims.centerY;
          const targetScaleX = Math.max(0.08, Math.min(1.0, targetRect.width / targetDims.width));
          const targetScaleY = Math.max(0.08, Math.min(1.0, targetRect.height / targetDims.height));

          // 2. 照片精准缩小飞回原位 (约 320ms 爽脆归位，直接覆盖底层已就位的卡片)
          tl.to(lightboxImgWrapper, {
            x: targetDeltaX,
            y: targetDeltaY,
            scaleX: targetScaleX,
            scaleY: targetScaleY,
            borderRadius: '6px',
            duration: 0.32,
            ease: 'power3.inOut',
          }, 0.02);

          // 3. 幕布随照片同步淡出
          tl.to(backdrop, {
            opacity: 0,
            duration: 0.30,
            ease: 'power2.in',
          }, 0.04);
        } else {
          // 容错兜底：目标不在视口时，居中淡化微缩收回
          tl.to(lightboxImgWrapper, {
            opacity: 0,
            scale: 0.93,
            filter: 'blur(4px)',
            duration: 0.24,
            ease: 'power2.in',
          }, 0);

          tl.to(containerEl, {
            opacity: 0,
            scale: 0.94,
            y: 12,
            duration: 0.26,
            ease: 'power2.in',
          }, 0.02);

          tl.to(backdrop, {
            opacity: 0,
            duration: 0.26,
            ease: 'power2.in',
          }, 0.03);
        }
      } else {
        if (targetImgEl) {
          targetImgEl.style.opacity = '';
          targetImgEl.style.pointerEvents = '';
        }
        if (activeSourceImgEl) {
          activeSourceImgEl.style.opacity = '';
          activeSourceImgEl.style.pointerEvents = '';
          activeSourceImgEl = null;
        }
        lightbox.classList.remove('is-open');
        lightbox.classList.add('hidden');
        document.body.classList.remove('gallery-lightbox-open');
        lastFocusedElement?.focus?.();
      }
    }

    function nextPhoto() {
      renderLightboxPhoto(currentPhotoIndex + 1);
    }

    function prevPhoto() {
      renderLightboxPhoto(currentPhotoIndex - 1);
    }

    window.addEventListener('resize', () => {
      if (isLightboxOpen && lightboxImgWrapper) {
        const list = getActivePhotoList();
        const currentPhoto = list[currentPhotoIndex] || GALLERY_PHOTOS[0];
        if (currentPhoto) {
          const targetDims = computeTargetLightboxRect(currentPhoto);
          lightboxImgWrapper.style.width = `${targetDims.width}px`;
          lightboxImgWrapper.style.height = `${targetDims.height}px`;
        }
      }
    }, { signal });

    // 绑定卡片点击与键盘打开暗房 (Event delegation + direct bindings)
    container.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;
      // If clicked a tag chip, don't open lightbox
      if (target.closest('[data-click-tag]')) return;

      const openTrigger = target.closest<HTMLElement>('[data-open-lightbox]');
      if (openTrigger) {
        e.stopPropagation();
        const photoId = openTrigger.getAttribute('data-open-lightbox');
        if (photoId) openLightbox(photoId, openTrigger);
        return;
      }

      const card = target.closest<HTMLElement>('.gallery-mat-card');
      if (card) {
        e.stopPropagation();
        const photoId = card.getAttribute('data-photo-id');
        if (photoId) openLightbox(photoId, card);
      }
    }, { signal });

    // 键盘支持
    cards.forEach((card) => {
      card.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') {
          ke.preventDefault();
          ke.stopPropagation();
          const photoId = card.getAttribute('data-photo-id');
          if (photoId) openLightbox(photoId, card);
        }
      }, { signal });
    });

    // 绑定关闭按钮与遮罩
    document.querySelectorAll('[data-lightbox-close]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        closeLightbox();
      }, { signal });
    });

    const lightboxStage = lightbox?.querySelector<HTMLElement>('.lightbox-stage');
    if (lightboxStage) {
      lightboxStage.addEventListener('click', (e) => {
        if (e.target === lightboxStage) {
          e.stopPropagation();
          closeLightbox();
        }
      }, { signal });
    }

    const lightboxContainer = lightbox?.querySelector<HTMLElement>('.lightbox-container');
    if (lightboxContainer) {
      lightboxContainer.addEventListener('click', (e) => {
        if (e.target === lightboxContainer) {
          e.stopPropagation();
          closeLightbox();
        }
      }, { signal });
    }

    // 绑定上一张/下一张按钮
    document.querySelectorAll('[data-lightbox-prev]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        prevPhoto();
      }, { signal });
    });

    document.querySelectorAll('[data-lightbox-next]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        nextPhoto();
      }, { signal });
    });

    // 阻止底部展签与 EXIF 滚动冒泡触发全屏切图或关闭
    const lightboxDrawer = lightbox?.querySelector<HTMLElement>('.lightbox-info-drawer');
    if (lightboxDrawer) {
      const stopDrawerTouch = (e: TouchEvent) => {
        e.stopPropagation();
      };
      lightboxDrawer.addEventListener('touchstart', stopDrawerTouch, { passive: true, signal });
      lightboxDrawer.addEventListener('touchmove', stopDrawerTouch, { passive: true, signal });
      lightboxDrawer.addEventListener('touchend', stopDrawerTouch, { passive: true, signal });
    }

    // 触摸滑动左右切图 (Mobile touch gestures)
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;

    lightbox?.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length === 1) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchStartTime = Date.now();
      }
    }, { passive: true, signal });

    lightbox?.addEventListener('touchend', (e: TouchEvent) => {
      if (e.changedTouches.length === 1 && isLightboxOpen) {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        const dt = Date.now() - touchStartTime;
        if (dt < 450 && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.4) {
          if (dx < 0) {
            nextPhoto();
          } else {
            prevPhoto();
          }
        } else if (dt < 450 && dy > 80 && Math.abs(dy) > Math.abs(dx) * 1.5) {
          closeLightbox();
        }
      }
    }, { passive: true, signal });

    // 键盘快捷键监听 (Esc 关闭，左右箭头切换，h/l 切换)
    window.addEventListener('keydown', (e) => {
      if (!isLightboxOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === 'ArrowRight' || e.key === 'l') {
        e.preventDefault();
        nextPhoto();
      } else if (e.key === 'ArrowLeft' || e.key === 'h') {
        e.preventDefault();
        prevPhoto();
      }
    }, { signal });

    // 页面跳转前清理与单例保存
    (window as any)[CLEANUP_KEY] = () => {
      controller.abort();
      if (filterTimeline) {
        filterTimeline.kill();
        filterTimeline = null;
      }
      if (isLightboxOpen) {
        closeLightbox();
      }
      (window as any)[CLEANUP_KEY] = undefined;
    };

    document.addEventListener('astro:before-swap', () => {
      if ((window as any)[CLEANUP_KEY]) {
        (window as any)[CLEANUP_KEY]();
      }
    }, { signal });
  }

  // 初始化并在每次客户端路由跳转时重新挂载
  initGalleryPage();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initGalleryPage);
    (window as any)[LISTENER_KEY] = true;
  }
</script>
