---
// src/pages/gallery.astro — 【拾影 · 山海留痕】个人相册系统
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import {
  PHOTO_CATEGORIES,
  GALLERY_PHOTOS,
  getAllPhotoLocations,
} from '../data/gallery';

const allPhotos = GALLERY_PHOTOS;
const categories = PHOTO_CATEGORIES;
const allLocations = getAllPhotoLocations();

// 统计各分类数目
const countByCategory = {
  all: allPhotos.length,
  nature: allPhotos.filter((p) => p.category === 'nature').length,
  urban: allPhotos.filter((p) => p.category === 'urban').length,
  daily: allPhotos.filter((p) => p.category === 'daily').length,
  humanities: allPhotos.filter((p) => p.category === 'humanities').length,
};
---

<BaseLayout
  title="拾影 · 山海留痕 - 梦付千秋"
  description="写代码之余，也要去吹吹山海晚风。用快门定格光影交错间的山川、草木、街角与静默时刻。"
>
  <Header />

  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-24 lg:pt-8 outline-none">
    <!-- 顶部标题与诗意介绍 -->
    <section class="panel pb-10 border-b border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 5%, var(--rule-strong) 50%, transparent 95%) 1;">
      <p class="eyebrow" data-enter="top">Gallery</p>

      <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <h1 class="section-title" data-enter="left">山海留痕 · 个人光影图卷</h1>
          <p
            class="mt-4 text-[1.02rem] leading-[1.8] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
            data-enter="left"
          >
            写代码之余，也要去吹吹山海晚风。在这里用快门留下行经的山川暮色、古道松风、老街雨夜，以及生活中的一米阳光与静默时刻。
          </p>
        </div>

        <!-- 顶部统计指标与互动 -->
        <div class="gallery-actions-cluster" data-enter="stamp">
          <div class="gallery-quick-stats">
            <span class="gallery-stat-pill">
              <b data-count={allPhotos.length}>{allPhotos.length}</b> 幅影痕
            </span>
            <span class="gallery-stat-pill">
              <b data-count={allLocations.length}>{allLocations.length}</b> 处行迹
            </span>
          </div>
        </div>
      </div>

      <!-- 搜索栏 -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4" data-enter="bottom" data-enter-once>
        <div class="gallery-search-wrapper flex-1">
          <svg class="gallery-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="gallery-search-input"
            class="gallery-search-input"
            placeholder="搜索照片标题、地点、相机参数或手记故事..."
            autocomplete="off"
            spellcheck="false"
          />
          <button
            type="button"
            id="gallery-search-clear"
            class="gallery-search-clear hidden"
            aria-label="清空搜索"
          >
            ✕
          </button>
        </div>
      </div>
    </section>

    <!-- 一级分类切换 Tab (雅致水墨硬折角) -->
    <div class="gallery-category-tabs mt-8" data-enter="bottom" data-enter-once role="tablist" aria-label="照片分类">
      {categories.map((cat) => (
        <button
          type="button"
          class={`gallery-cat-tab ${cat.id === 'all' ? 'is-active' : ''}`}
          data-category-tab={cat.id}
          role="tab"
          aria-selected={cat.id === 'all' ? 'true' : 'false'}
        >
          <span class="cat-icon">{cat.icon}</span>
          <span class="cat-name">{cat.name}</span>
          <i class="cat-count">{countByCategory[cat.id as keyof typeof countByCategory]}</i>
        </button>
      ))}
    </div>

    <!-- 艺术馆装裱留白照片网格 (Museum White-Mat Mount Grid) -->
    <div class="gallery-grid mt-10" id="gallery-cards-container">
      {allPhotos.map((photo, index) => {
        const enterFrom = (['left', 'bottom', 'right'] as const)[index % 3];

        return (
          <article
            class="gallery-mat-card group"
            data-enter={enterFrom}
            data-photo-id={photo.id}
            data-category={photo.category}
            data-location={photo.location}
            data-tags={photo.tags.join(',')}
            data-search-text={`${photo.title} ${photo.location} ${photo.categoryLabel} ${photo.tags.join(' ')} ${photo.story} ${photo.exifDisplay}`.toLowerCase()}
            tabindex="0"
            role="button"
            aria-label={`查看照片与手记详情：${photo.title}`}
          >
            <!-- 艺术装裱外衬 (White-mat Passe-partout) -->
            <div class="mat-frame">
              <!-- 图片窗口与悬浮参数 -->
              <div class="mat-image-window" data-open-lightbox={photo.id} aria-label={`查看全屏大图：${photo.title}`}>
                <img
                  src={photo.url}
                  alt={photo.title}
                  class="mat-photo-img"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index < 2 ? 'high' : 'auto'}
                  width="1200"
                  height="800"
                />
                <div class="mat-image-overlay">
                  <span class="mat-zoom-badge">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      <line x1="11" y1="8" x2="11" y2="14"></line>
                      <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                    <span>鉴赏</span>
                  </span>
                  <div class="mat-exif-pill">
                    {photo.exif.camera} · {photo.exif.aperture} · {photo.exif.shutter}
                  </div>
                </div>
              </div>

              <!-- 留白展签信息 (Gallery Artwork Plaque) -->
              <div class="mat-plaque">
                <div class="mat-plaque-header">
                  <div class="flex items-center gap-2">
                    <span class="mat-location-icon">📍</span>
                    <span class="mat-location-text">{photo.location}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class="mat-date-text">{photo.date}</span>
                  </div>
                </div>

                <h2 class="mat-photo-title" data-open-lightbox={photo.id}>{photo.title}</h2>

                <p class="mat-photo-story">“{photo.story}”</p>

                <!-- EXIF 详细指标与标签栏 -->
                <div class="mat-plaque-footer">
                  <span class="mat-exif-tag" title={photo.exifDisplay}>
                    📷 {photo.exif.lens}
                  </span>
                  <div class="mat-tags-list">
                    {photo.tags.slice(0, 3).map((tag) => (
                      <button type="button" class="mat-tag-chip" data-click-tag={tag} title="按此标签搜索">
                        #{tag}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- 空搜索提示 -->
    <div id="gallery-empty-state" class="gallery-empty-state hidden mt-16 text-center py-16 panel" data-lenis-prevent>
      <div class="text-4xl mb-3">🖼️</div>
      <h3 class="text-lg font-semibold text-[var(--text-strong)]">未寻得相应影痕</h3>
      <p class="text-sm text-[var(--muted)] mt-2 max-w-md mx-auto">
        未匹配到符合当前分类与搜索词的照片。不妨清空搜索词，或切换至「全部影痕」阅览。
      </p>
      <button type="button" id="gallery-reset-filter" class="btn-secondary mt-6">
        重置筛选与搜索
      </button>
    </div>
  </main>

  <!-- 全屏水墨暗房看图器 (Ink Darkroom Lightbox) -->
  <div
    id="gallery-lightbox"
    class="gallery-lightbox hidden"
    role="dialog"
    aria-modal="true"
    aria-label="全屏水墨暗房看图器"
    data-lenis-prevent
  >
    <div class="lightbox-backdrop" data-lightbox-close></div>

    <div class="lightbox-container" role="document">
      <!-- 顶部控制栏 -->
      <div class="lightbox-top-bar">
        <div class="lightbox-brand">
          <span class="lightbox-title-text" data-lightbox-title>拾影暗房</span>
          <span class="lightbox-counter">
            <span data-lightbox-current>1</span> / <span data-lightbox-total>{allPhotos.length}</span>
          </span>
        </div>
        <div class="lightbox-actions">
          <button
            type="button"
            class="lightbox-btn lightbox-close-btn"
            data-lightbox-close
            aria-label="关闭暗房 (Esc)"
            title="关闭暗房 (Esc)"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- 中间图像主舞台 -->
      <div class="lightbox-stage">
        <button
          type="button"
          class="lightbox-nav-arrow arrow-left"
          data-lightbox-prev
          aria-label="上一张照片"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="lightbox-img-wrapper" data-lightbox-img-wrapper>
          <img
            src=""
            alt=""
            id="lightbox-main-img"
            class="lightbox-main-img"
            loading="eager"
            decoding="async"
          />
        </div>

        <button
          type="button"
          class="lightbox-nav-arrow arrow-right"
          data-lightbox-next
          aria-label="下一张照片"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- 底部暗房展签与 EXIF 参数板 -->
      <div class="lightbox-info-drawer">
        <div class="lightbox-info-main">
          <div class="lightbox-info-header">
            <h2 id="lightbox-info-title" class="lightbox-info-title">照片标题</h2>
            <div class="lightbox-meta-pills">
              <span class="meta-pill" id="lightbox-info-location">📍 拍摄地点</span>
              <span class="meta-pill" id="lightbox-info-date">📅 拍摄日期</span>
            </div>
          </div>
          <p id="lightbox-info-story" class="lightbox-info-story">拍摄手记</p>
        </div>

        <!-- EXIF 摄影参数矩阵 -->
        <div class="lightbox-exif-grid">
          <div class="exif-slot">
            <span class="exif-slot-label">相 机</span>
            <span class="exif-slot-val" id="lightbox-exif-camera">Sony A7M4</span>
          </div>
          <div class="exif-slot">
            <span class="exif-slot-label">镜 头</span>
            <span class="exif-slot-val" id="lightbox-exif-lens">FE 35mm F1.4 GM</span>
          </div>
          <div class="exif-slot">
            <span class="exif-slot-label">光 圈</span>
            <span class="exif-slot-val" id="lightbox-exif-aperture">f/1.8</span>
          </div>
          <div class="exif-slot">
            <span class="exif-slot-label">快 门</span>
            <span class="exif-slot-val" id="lightbox-exif-shutter">1/500s</span>
          </div>
          <div class="exif-slot">
            <span class="exif-slot-label">感光度</span>
            <span class="exif-slot-val" id="lightbox-exif-iso">ISO 100</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 顶部指标 */
  .gallery-actions-cluster {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .gallery-quick-stats {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gallery-stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    font-size: 0.8rem;
    color: var(--muted-strong);
  }

  .gallery-stat-pill b {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  /* 搜索框 */
  .gallery-search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    border-radius: 10px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    cursor: default;
    transition: border-color 200ms ease, box-shadow 200ms ease, background 200ms ease;
  }

  .gallery-search-wrapper:focus-within {
    border-color: var(--accent);
    background: var(--bg-elev);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb, 194, 65, 12), 0.15);
  }

  .gallery-search-icon {
    position: absolute;
    left: 0.95rem;
    color: var(--muted);
    pointer-events: none;
  }

  .gallery-search-input {
    width: 100%;
    padding: 0.65rem 2.6rem 0.65rem 2.5rem;
    border-radius: 10px;
    clip-path: inset(0 round 10px);
    border: none;
    background: transparent;
    color: var(--text-strong);
    font-size: 0.9rem;
    outline: none;
  }

  .gallery-search-clear {
    position: absolute;
    right: 0.8rem;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 180ms ease;
  }

  .gallery-search-clear:hover {
    color: var(--text-strong);
  }

  /* 分类 Tab */
  .gallery-category-tabs {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 6px 4px 6px;
    margin-top: calc(2rem - 6px);
  }

  .gallery-category-tabs::-webkit-scrollbar {
    display: none;
  }

  .gallery-cat-tab {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.65rem 0.5rem 0.95rem;
    border-radius: 4px;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--muted-strong);
    font-size: 0.84rem;
    font-family: var(--font-body);
    cursor: pointer;
    white-space: nowrap;
    user-select: none;
    box-sizing: border-box;
    transition:
      color 420ms var(--ease),
      border-color 320ms var(--ease),
      transform 320ms var(--ease-bounce);
  }

  .gallery-cat-tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink-strong);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 520ms var(--ease);
  }

  .gallery-cat-tab.is-active::before {
    transform: scaleX(1);
  }

  .gallery-cat-tab:not(.is-active):hover {
    color: var(--text-strong);
    border-color: var(--accent);
    transform: translateY(-1px);
    background: transparent;
  }

  .gallery-cat-tab:not(.is-active):hover .cat-count {
    color: var(--text-strong);
    border-color: var(--accent);
  }

  .gallery-cat-tab.is-active {
    background: transparent;
    color: var(--bg-base);
    border-color: var(--ink-strong);
    box-shadow: none;
  }

  .gallery-cat-tab.is-active:hover {
    color: var(--bg-base);
    border-color: var(--ink-strong);
    transform: translateY(-1px);
    background: transparent;
  }

  .gallery-cat-tab.is-active:hover .cat-count {
    color: inherit;
    border-color: transparent;
  }

  .gallery-cat-tab .cat-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.45rem;
    height: 1.45rem;
    padding-inline: 0.35rem;
    border-radius: 3px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    transition: background 240ms var(--ease), color 240ms var(--ease), border-color 240ms var(--ease);
  }

  .gallery-cat-tab.is-active .cat-count {
    background: color-mix(in srgb, currentColor 16%, transparent);
    border-color: transparent;
    color: inherit;
  }

  /* ================= 现代艺术影集无框照片网格 ================= */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 3.5rem;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5rem 3rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 4rem 3.5rem;
    }
  }

  /* 无框艺术卡片 (Frameless Fine-Art Card) */
  .gallery-mat-card {
    display: flex;
    flex-direction: column;
    border-radius: 0;
    padding-bottom: 2.2rem;
    cursor: pointer;
    outline: none;
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(to right, transparent 3%, var(--rule) 20%, var(--rule) 80%, transparent 97%) 1;
    will-change: transform, opacity, clip-path;
    clip-path: inset(0 0% 0 0);
  }

  .gallery-mat-card.is-filtered-out {
    display: none !important;
  }

  /* 仅在卡片完全落定且不在动画中时开启 hover 过渡，杜绝 CSS 过渡与 GSAP 逐帧抢控制权 */
  .gallery-mat-card.is-entered:not(.is-reflowing):not(.is-entering) {
    transition: transform 260ms var(--ease);
  }

  .gallery-mat-card.is-entered:not(.is-reflowing):not(.is-entering):hover {
    transform: translateY(-3px);
  }

  .gallery-mat-card.is-reflowing,
  .gallery-mat-card.is-entering {
    transition: none !important;
  }

  .mat-frame {
    display: flex;
    flex-direction: column;
    padding: 0;
    border-radius: 0;
    background: transparent;
    border: none;
    box-shadow: none;
  }

  .gallery-mat-card:hover .mat-frame,
  .gallery-mat-card:focus-visible .mat-frame,
  [data-theme="dark"] .mat-frame,
  [data-theme="dark"] .gallery-mat-card:hover .mat-frame,
  [data-theme="dark"] .gallery-mat-card:focus-visible .mat-frame {
    border: none;
    box-shadow: none;
  }

  /* 图像窗口：纯净微圆角与通透浮光 */
  .mat-image-window {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 6px;
    background: #000000;
    cursor: zoom-in;
    border: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: box-shadow 300ms ease, transform 300ms ease;
  }

  [data-theme="dark"] .mat-image-window {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
  }

  .gallery-mat-card:hover .mat-image-window {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
  }

  [data-theme="dark"] .gallery-mat-card:hover .mat-image-window {
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.65);
  }

  .mat-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mat-image-window:hover .mat-photo-img,
  .gallery-mat-card:hover .mat-photo-img,
  .gallery-mat-card:focus-visible .mat-photo-img {
    transform: scale(1.035);
  }

  .mat-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0) 55%);
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem;
    transition: opacity 280ms ease;
  }

  .mat-image-window:hover .mat-image-overlay {
    opacity: 1;
  }

  .mat-zoom-badge {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.55rem;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .mat-exif-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(8px);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    align-self: flex-start;
  }

  /* 纯净展签信息 (Artwork Plaque) */
  .mat-plaque {
    padding-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .mat-plaque-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.76rem;
