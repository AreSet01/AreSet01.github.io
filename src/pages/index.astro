---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { formatDate, sortPostsByDate } from '../utils/date';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = sortPostsByDate(allPosts);
const latestPost = posts[0];
const totalTags = new Set(posts.flatMap(post => post.data.tags ?? [])).size;
const latestYear = latestPost ? new Date(latestPost.data.pubDate).getFullYear() : new Date().getFullYear();
---

<BaseLayout title="梦付千秋 - 日常记录与技术分享">
  <Header />
  <main class="container-wide flex-1" style="padding-top: 2rem;">
    <section class="home-hero reveal-up" style="padding-block: 4rem 3rem;">
      <div class="home-hero-copy">
        <p class="eyebrow">Vol. 01 / Digital Garden</p>
        <h1 class="home-hero-title" style="font-size: clamp(2rem, 5vw, 3.4rem);">
          欢迎光临AreSetのBlog
        </h1>
        <p class="home-hero-desc">
          这里用来随便分享一点小知识，一些行业看法，或是说些愤青（bushi）言论
        </p>
        <div class="home-actions">
          {latestPost && <a href={`/posts/${latestPost.id}`} class="btn-primary">阅读最新文章</a>}
          <a href="/archive" class="btn-secondary">浏览全部文章</a>
        </div>
      </div>

      <aside class="home-rail" aria-label="站点概览">
        <div class="home-stat">
          <span>Posts</span>
          <strong>{posts.length}</strong>
        </div>
        <div class="home-stat">
          <span>Tags</span>
          <strong>{totalTags}</strong>
        </div>
        <div class="home-stat">
          <span>Year</span>
          <strong>{latestYear}</strong>
        </div>
      </aside>
    </section>

    <section class="home-digest">
      {latestPost && (
        <a
          href={`/posts/${latestPost.id}`}
          data-post-preview={`/posts/${latestPost.id}`}
          class="home-feature reveal-up"
          style="animation-delay: 120ms;"
        >
          <p class="eyebrow">Fresh Ink</p>
          <div class="home-feature-main">
            <time datetime={latestPost.data.pubDate.toISOString()}>
              {formatDate(latestPost.data.pubDate)}
            </time>
            <h2>{latestPost.data.title}</h2>
            <p>{latestPost.data.description ?? '从这篇文章开始逛逛我的博客。'}</p>
          </div>
          <span class="home-feature-link">Preview →</span>
        </a>
      )}

      <div class="home-topics reveal-up" style="animation-delay: 220ms;">
        <p class="eyebrow">What Lives Here</p>
        <h2>写作方向</h2>
        <p>喜欢分享生活，喜欢记录一些很酷的技术。</p>
        <div>
          <span>Astro</span>
          <span>技术</span>
          <span>随笔</span>
          <span>学习笔记</span>
        </div>
      </div>
    </section>

    <section class="notes-section" style="padding-bottom: 6rem;">
      <div class="notes-heading">
        <div>
          <p class="eyebrow">Latest Notes</p>
          <h2 class="section-title mt-4">最近写了什么咧~</h2>
        </div>
        <p>
          又产出一堆啦~
        </p>
      </div>
      {posts.length === 0 ? (
        <div class="empty-note">暂无文章，快去写一篇吧</div>
      ) : (
        <div class="notes-grid">
          {posts.map((post, index) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
              slug={post.id}
              index={index}
              locked={post.data.locked}
            />
          ))}
        </div>
      )}
    </section>
  </main>

</BaseLayout>
