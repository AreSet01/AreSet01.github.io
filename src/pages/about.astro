---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import AboutIntro from '../components/AboutIntro.astro';
import { getCollection } from 'astro:content';
import { sortPostsByDate } from '../utils/date';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = sortPostsByDate(allPosts);
const postCount = posts.length;
const tagCount = new Set(posts.flatMap((post) => post.data.tags ?? [])).size;
const firstYear = posts.length ? new Date(posts[posts.length - 1].data.pubDate).getFullYear() : new Date().getFullYear();

// Rotating "who am I" lines for the typewriter — edit freely
const typedLines = [
  '沉浸式纸境博客开源模板',
  '双卷伴读与卡片笔记空间',
  '支持 AI 划词伴读与流式解答',
  '基于 Astro 5 + Tailwind 4 构建',
];

// Words that drift down the right margin as you scroll
const marqueeWords = ['清浅', '素笺', 'Astro', 'TypeScript', '伴读', '笔记', 'Tailwind', 'GSAP', '开源', '阅读'];

const timeline = [
  {
    date: '2026 · 10',
    title: '伴读工作台与笔记系统升级',
    body: '实现双卷推挤并排工作台、AI 划词伴读、全屏卡片笔记与多端同步',
  },
  {
    date: '2026 · 09',
    title: '东方纸境设计重构',
    body: '基于宣纸纹理、粒子推演与水墨雨境构建沉浸式东方美学体验',
  },
  {
    date: `${firstYear}`,
    title: '项目开源',
    body: '「清浅」博客模板正式开源，欢迎 Star 与自由创作',
  },
];
---

<BaseLayout title="关于 - 清浅">
  <AboutIntro />
  <Header />
  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-16 lg:pt-8 outline-none" style="position: relative;">
    <div class="about-marquee" data-about-marquee aria-hidden="true">
      <div class="about-marquee-track" data-about-marquee-track>
        {[...marqueeWords, ...marqueeWords].map((word) => (
          <span class="about-marquee-word">{word}</span>
        ))}
      </div>
    </div>

    <section class="grid gap-16 lg:grid-cols-[minmax(0,1.25fr)_minmax(280px,0.75fr)] lg:gap-20 lg:pr-16">
      <div class="panel">
        <div class="flex items-center justify-between">
          <p class="eyebrow" data-enter="top">About the Template</p>
          <button type="button" class="about-zen-replay-btn" data-about-zen-replay title="重新播放水墨像素入场动效">
            <span class="replay-icon">↺</span> 墨化推演
          </button>
        </div>
        <h1 class="section-title mt-6 max-w-2xl" data-enter="left">
          静水流深，清浅从容
        </h1>
        <p class="about-typed mt-5" data-enter="left" aria-live="polite">
          <span class="about-typed-prefix">&gt;</span>
          <span data-about-typed data-lines={JSON.stringify(typedLines)}>{typedLines[0]}</span>
          <span class="about-typed-caret" aria-hidden="true"></span>
        </p>
        <div
          class="mt-8 space-y-5 text-[1rem] leading-[1.85] text-[var(--muted-strong)] max-w-2xl"
          style="font-family: var(--font-serif);"
          data-enter="bottom"
        >
          <p>你好，欢迎来到「清浅」演示站点。这是一个专为长文深度阅读、知识沉淀与优雅交互打造的开源博客主题。</p>
          <p>采用 Astro 5 静态构建，集成双卷推挤工作台、划词 AI 伴读、全屏卡片笔记以及细腻入微的水墨动效系统。</p>
        </div>

        <div
          class="about-tilt-stage mt-12 grid gap-4 sm:grid-cols-3 items-stretch pt-8 border-t border-[var(--rule)]"
          style="border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;"
        >
          <div class="about-tilt h-full" data-tilt data-enter="left">
            <div class="stat-card h-full flex flex-col justify-center px-4 py-5 sm:px-5 sm:py-6 pointer-events-none">
              <p class="stat-label text-xs tracking-wider select-none">核心特性</p>
              <h3 class="about-card-heading font-display text-[0.96rem] sm:text-[1rem] font-semibold text-[var(--text-strong)] tracking-tight mt-2.5 whitespace-nowrap overflow-hidden text-ellipsis select-none">
                双卷伴读
              </h3>
            </div>
          </div>
          <div class="about-tilt h-full" data-tilt data-enter="bottom">
            <div class="stat-card h-full flex flex-col justify-center px-4 py-5 sm:px-5 sm:py-6 pointer-events-none">
              <p class="stat-label text-xs tracking-wider select-none">架构基石</p>
              <h3 class="about-card-heading font-display text-[0.96rem] sm:text-[1rem] font-semibold text-[var(--text-strong)] tracking-tight mt-2.5 whitespace-nowrap overflow-hidden text-ellipsis select-none">
                Astro 5
              </h3>
            </div>
          </div>
          <div class="about-tilt h-full" data-tilt data-enter="right">
            <div class="stat-card h-full flex flex-col justify-center px-4 py-5 sm:px-5 sm:py-6 pointer-events-none">
              <p class="stat-label text-xs tracking-wider select-none">设计意境</p>
              <h3 class="about-card-heading font-display text-[0.96rem] sm:text-[1rem] font-semibold text-[var(--text-strong)] tracking-tight mt-2.5 whitespace-nowrap overflow-hidden text-ellipsis select-none">
                纸境流岚
              </h3>
            </div>
          </div>
        </div>

        <section class="mt-16" data-enter="bottom">
          <p class="eyebrow">Footprints</p>
          <h2 class="font-display mt-5 text-[1.65rem] text-[var(--text-strong)]">最近在折腾什么</h2>
          <div class="about-timeline mt-8" data-about-timeline>
            <svg class="about-timeline-spine" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 2 100">
              <line x1="1" y1="0" x2="1" y2="100" pathLength="1" data-about-spine />
            </svg>
            {timeline.map((item) => (
              <div class="about-timeline-item" data-about-timeline-item>
                <time>{item.date}</time>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <aside class="space-y-12">
        <section data-enter="right">
          <p class="eyebrow">By the Numbers</p>
          <div class="mt-6 grid grid-cols-3 gap-3">
            <div class="stat-card" data-count-to={postCount}>
              <p class="stat-label">Posts</p>
              <p class="mt-2 font-display text-[1.7rem] leading-none text-[var(--text-strong)]" data-count-value>0</p>
            </div>
            <div class="stat-card" data-count-to={tagCount}>
              <p class="stat-label">Tags</p>
              <p class="mt-2 font-display text-[1.7rem] leading-none text-[var(--text-strong)]" data-count-value>0</p>
            </div>
            <div class="stat-card" data-count-to={new Date().getFullYear() - firstYear + 1}>
              <p class="stat-label">Years</p>
              <p class="mt-2 font-display text-[1.7rem] leading-none text-[var(--text-strong)]" data-count-value>0</p>
            </div>
          </div>
        </section>

        <section data-enter="right">
          <p class="eyebrow">About the Site</p>
          <h2 class="font-display mt-5 text-[1.65rem] text-[var(--text-strong)]">
            本站用什么搭的？
          </h2>
          <dl class="mt-6 border-t border-dashed border-[var(--rule)]">
            <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-[var(--rule)] py-3.5">
              <dt class="font-display text-[1rem] text-[var(--text-strong)]">Astro</dt>
              <dd class="text-[0.86rem] text-[var(--muted)] text-right" style="font-family: var(--font-serif); font-style: italic;">
                快速、轻量的静态网站
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-[var(--rule)] py-3.5">
              <dt class="font-display text-[1rem] text-[var(--text-strong)]">Tailwind</dt>
              <dd class="text-[0.86rem] text-[var(--muted)] text-right" style="font-family: var(--font-serif); font-style: italic;">
                高效整理样式
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-[var(--rule)] py-3.5">
              <dt class="font-display text-[1rem] text-[var(--text-strong)]">GSAP + Lenis</dt>
              <dd class="text-[0.86rem] text-[var(--muted)] text-right" style="font-family: var(--font-serif); font-style: italic;">
                滚动与动效
              </dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-[var(--rule)] py-3.5">
              <dt class="font-display text-[1rem] text-[var(--text-strong)]">Giscus</dt>
              <dd class="text-[0.86rem] text-[var(--muted)] text-right" style="font-family: var(--font-serif); font-style: italic;">
                GitHub Discussions 评论
              </dd>
            </div>
          </dl>
        </section>

        <section data-enter="right">
          <p class="eyebrow">Open Source</p>
          <h2 class="font-display mt-5 text-[1.65rem] text-[var(--text-strong)]">
            开源仓库
          </h2>
          <p
            class="mt-4 text-[0.94rem] leading-relaxed text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
          >
            欢迎 Star、Fork 或提交 Issue —
          </p>
          <div class="mt-6 border-t border-dashed border-[var(--rule)]">
            <a
              href="https://github.com/AreSet01/AreSet01.github.io"
              class="surface-link flex items-baseline justify-between gap-4"
              target="_blank"
              rel="noopener"
            >
              <span class="stat-label">GitHub</span>
              <span class="font-display text-[1rem] text-[var(--text-strong)]">AreSet01.github.io →</span>
            </a>
            <div class="flex items-baseline justify-between gap-4 border-t border-dashed border-[var(--rule)] py-4">
              <span class="stat-label">License</span>
              <span class="font-mono text-[0.84rem] text-[var(--text-strong)]">MIT License</span>
            </div>
          </div>
          <div class="mt-10 flex justify-end">
            <span class="about-stamp" data-about-stamp aria-hidden="true">素笺留痕</span>
          </div>
        </section>
      </aside>
    </section>
  </main>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const CLEANUP_KEY = '__areSetAboutCleanup__';
  const LISTENER_KEY = '__areSetAboutPageLoadBound__';
  const TRIGGER_PREFIX = 'about:';

  function initAbout() {
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') previousCleanup();

    const typed = document.querySelector<HTMLElement>('[data-about-typed]');
    if (!typed) return; // not on the about page

    const controller = new AbortController();
    const { signal } = controller;
    const timers: number[] = [];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    ScrollTrigger.getAll().forEach((trigger) => {
      if (String(trigger.vars.id || '').startsWith(TRIGGER_PREFIX)) trigger.kill();
    });

    // ---------- Typewriter ----------
    const lines: string[] = JSON.parse(typed.dataset.lines || '[]');
    if (lines.length && !reduceMotion) {
      let lineIndex = 0;
      let charIndex = lines[0].length;
      let deleting = true;

      const step = () => {
        if (signal.aborted) return;
        const line = lines[lineIndex];
        if (deleting) {
          charIndex -= 1;
          typed.textContent = line.slice(0, charIndex);
          if (charIndex <= 0) {
            deleting = false;
            lineIndex = (lineIndex + 1) % lines.length;
            timers.push(window.setTimeout(step, 260));
            return;
          }
          timers.push(window.setTimeout(step, 28));
        } else {
          charIndex += 1;
          typed.textContent = lines[lineIndex].slice(0, charIndex);
          if (charIndex >= lines[lineIndex].length) {
            deleting = true;
            timers.push(window.setTimeout(step, 2400));
            return;
          }
          timers.push(window.setTimeout(step, 60 + Math.random() * 50));
        }
      };
      timers.push(window.setTimeout(step, 2200));
    }

    // ---------- Count-up numbers ----------
    document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((card, index) => {
      const target = Number(card.dataset.countTo || 0);
      const valueEl = card.querySelector<HTMLElement>('[data-count-value]');
      if (!valueEl) return;
      if (reduceMotion) { valueEl.textContent = String(target); return; }
      const counter = { value: 0 };
      ScrollTrigger.create({
        id: `${TRIGGER_PREFIX}count-${index}`,
        trigger: card,
        start: 'top 90%',
        once: true,
        onEnter: () => gsap.to(counter, {
          value: target,
          duration: 1.4,
          ease: 'expo.out',
          delay: index * 0.08,
          onUpdate: () => { valueEl.textContent = String(Math.round(counter.value)); },
        }),
      });
    });

    // 3D tilt cards are handled globally by BaseLayout.astro via unified [data-tilt] engine

    // ---------- Timeline: spine draws with scroll, nodes light up ----------
    const spine = document.querySelector<SVGLineElement>('[data-about-spine]');
    const timelineRoot = document.querySelector<HTMLElement>('[data-about-timeline]');
    if (spine && timelineRoot && !reduceMotion) {
      const spineState = { p: 0 };
      const paint = () => { spine.style.strokeDashoffset = String(1 - spineState.p); };
      paint();
      ScrollTrigger.create({
        id: `${TRIGGER_PREFIX}spine`,
        trigger: timelineRoot,
        start: 'top 80%',
        end: 'bottom 55%',
        onUpdate: (self) => {
          gsap.to(spineState, { p: self.progress, duration: 0.5, ease: 'power2.out', overwrite: true, onUpdate: paint });
        },
      });
      document.querySelectorAll<HTMLElement>('[data-about-timeline-item]').forEach((item, index) => {
        ScrollTrigger.create({
          id: `${TRIGGER_PREFIX}node-${index}`,
          trigger: item,
          start: 'top 72%',
          onEnter: () => item.classList.add('is-lit'),
          onLeaveBack: () => item.classList.remove('is-lit'),
        });
      });
    }

    // ---------- Vertical marquee tied to scroll position ----------
    const marqueeTrack = document.querySelector<HTMLElement>('[data-about-marquee-track]');
    if (marqueeTrack && !reduceMotion) {
      let half = 0;
      const measure = () => { half = marqueeTrack.scrollHeight / 2; };
      measure();
      const setY = gsap.quickTo(marqueeTrack, 'y', { duration: 0.6, ease: 'power2.out' });
      const onScroll = () => {
        if (!half) return;
        setY(-gsap.utils.wrap(0, half, window.scrollY * 0.35));
      };
      window.addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', measure, { signal });
      onScroll();
    }

    // ---------- Stamp lands once the aside has entered ----------
    const stamp = document.querySelector<HTMLElement>('[data-about-stamp]');
    if (stamp) {
      if (reduceMotion) stamp.classList.add('is-stamped');
      else ScrollTrigger.create({
        id: `${TRIGGER_PREFIX}stamp`,
        trigger: stamp,
        start: 'top 92%',
        once: true,
        onEnter: () => timers.push(window.setTimeout(() => stamp.classList.add('is-stamped'), 420)),
      });
    }

    // ---------- Replay button for Zen intro ----------
    const replayBtn = document.querySelector<HTMLElement>('[data-about-zen-replay]');
    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        try {
          sessionStorage.removeItem('about-intro-seen');
          sessionStorage.setItem('site-intro-seen', '1');
        } catch {}
        location.href = '/about?about-intro=1';
      }, { signal });
    }

    (window as any)[CLEANUP_KEY] = () => {
      controller.abort();
      timers.forEach((id) => window.clearTimeout(id));
      ScrollTrigger.getAll().forEach((trigger) => {
        if (String(trigger.vars.id || '').startsWith(TRIGGER_PREFIX)) trigger.kill();
      });
      (window as any)[CLEANUP_KEY] = undefined;
    };
  }

  initAbout();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initAbout);
    (window as any)[LISTENER_KEY] = true;
  }
</script>
