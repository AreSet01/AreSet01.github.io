</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import CustomEase from 'gsap/CustomEase';

  gsap.registerPlugin(ScrollTrigger, CustomEase);
  CustomEase.create('enter', 'M0,0 C0.16,1 0.3,1 1,1');
  CustomEase.create('ink', '0.25, 1, 0.5, 1');

  const CLEANUP_KEY = '__areSetLifePageCleanup__';
  const LISTENER_KEY = '__areSetLifePageBound__';

  function initLifePage() {
    // 若之前已存在清理函数，先执行清理
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') {
      previousCleanup();
    }

    const container = document.getElementById('life-cards-container');
    if (!container) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let currentCategory = 'all';
    let searchQuery = '';
    let currentLotteryCard: HTMLElement | null = null;
    let filterTimeline: gsap.core.Timeline | null = null;

    const cards = Array.from(container.querySelectorAll<HTMLElement>('.life-card'));

    /**
     * 把网格高度钉在「全部拾光」时的高度。
     *
     * 筛选会让网格变矮，页面总高随之变化；一旦用户已经滚到底部，浏览器会在下一次布局里
     * 把滚动位置钳到新上限 —— 页签切换时整页被「拉回」一截就是这么来的。这是本页独有的，
     * 因为只有这里有会改变页面高度的筛选。
     *
     * 钉住之后网格高度恒定：行高本来就取本行最高卡片，min-height 只是把它锁在初始值，
     * 卡片在筛选后依旧等高，页面总高不再变化，钳制也就无从发生。
     */
    const searchInput = document.getElementById('life-search-input') as HTMLInputElement | null;
    const searchClear = document.getElementById('life-search-clear');
    const emptyState = document.getElementById('life-empty-state');
    const resetBtn = document.getElementById('life-reset-filters-btn');
    const catTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-tab]'));
    const diceIcon = document.getElementById('life-dice-icon');

    // 抽签 Modal 相关
    const randomBtn = document.getElementById('life-random-btn');
    const modal = document.getElementById('life-lottery-modal');
    const modalClose = document.getElementById('life-modal-close');
    const modalContent = document.getElementById('life-modal-content');
    const modalReroll = document.getElementById('life-modal-reroll');
    const modalLocate = document.getElementById('life-modal-locate');

    /**
     * 将卡片状态从动画或隐藏完全交付给页面，确保在动画结束后不受任何行内样式干扰
     */
    function settleCard(el: HTMLElement) {
      el.classList.remove('is-entering', 'is-reflowing');
      el.classList.add('is-entered');
      el.dataset.enterState = 'in';
      gsap.killTweensOf(el);
      gsap.set(el, { clearProps: 'clipPath,opacity,transform,scale,x,y' });
    }

    /**
     * 刷新滚动容器与触发器尺寸，防止卡顿与 Lenis 高度不一致
     *
     * clamp = false 用于「空状态塌缩」期间：文档正在连续变矮，如果每帧都把滚动位置硬钳到
     * 新的 limit，整页就会一格一格往下跳；塌缩期间只刷新尺寸，钳制交给回滚动画与收尾那次刷新。
     */
    function refreshScroll(clamp = true) {
      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.refresh();
      }
      try {
        const lenis = (window as any).lenis;
        lenis?.resize?.();
        if (!clamp) return;
        if (lenis && typeof lenis.limit === 'number' && (window.scrollY > lenis.limit || lenis.targetScroll > lenis.limit)) {
          lenis.scrollTo(lenis.limit, { immediate: true });
        }
      } catch {}
    }

    /**
     * 筛选落空时，若用户已经滚到筛选栏以下，就把视口平滑送回搜索栏，
     * 让空状态面板落在视野里 —— 与 gallery 空态完全同一套行为。
     */
    function returnToFilterBar() {
      if (window.scrollY <= 80) return;
      const anchor =
        document.querySelector('.life-search-wrapper') ||
        document.querySelector('.life-category-tabs');
      if (!anchor) return;

      const lenis = (window as any).lenis;
      if (lenis && typeof lenis.scrollTo === 'function') {
        lenis.scrollTo(anchor, {
          offset: -90,
          duration: 0.65,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });
      } else {
        (anchor as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    /**
     * 取「视口里最上面那张卡」当锚点：普通筛选换骨时用它决定滚动落点。
     * offset 是卡片相对视口顶部的位置，筛选后把它校回同一个 offset 就等于「画面没动」。
     */
    function captureViewportAnchor(): { lifeId: string; offset: number } | null {
      const list = cards.filter((c) => c.offsetParent !== null && !c.classList.contains('is-filtered-out'));
      if (!list.length) return null;
      const el = list.find((c) => c.getBoundingClientRect().bottom > 80) || list[0];
      return { lifeId: el.getAttribute('data-life-id') || '', offset: el.getBoundingClientRect().top };
    }

    /**
     * 方案 B：【书法卷轴徐展 + 原位同卡静止】
     * 1. 原位同卡（在切换前后均命中且网格次序未变）保持完全静止；
     * 2. 卷轴卷收 (Roll-up): 仅被筛除或位置发生改变的卡片从右向左合拢 (clip-path: inset(0 100% 0 0), 0.28s)；
     * 3. 卷轴徐展 (Scroll Unfurling): 仅新增或位置发生改变的卡片从左向右舒展 (clip-path: inset(0 0% 0 0), 0.68s, ease: 'enter')。
     */
    function applyFilters(animate = true, _forceRun = false) {
      if (filterTimeline) {
        filterTimeline.kill();
        filterTimeline = null;
      }
      gsap.killTweensOf(container);
      if (emptyState) {
        gsap.killTweensOf(emptyState);
      }
      // 先量再清：若上一次空态塌缩被打断，offsetHeight 里还带着那一帧的钉住高度
      const currentH = container.offsetHeight;
      container.style.minHeight = '';
      cards.forEach((card) => {
        gsap.killTweensOf(card);
        card.classList.remove('is-reflowing', 'is-entering');
        card.classList.add('is-entered');
        card.dataset.enterState = 'in';
        gsap.set(card, { clearProps: 'clipPath,opacity,transform,scale,x,y' });
      });

      const q = searchQuery.toLowerCase().trim();
      const matchCard = (card: HTMLElement) => {
        const itemCategory = card.getAttribute('data-category') || '';
        const searchText = card.getAttribute('data-search-text') || '';

        const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;
        const matchesSearch = !q || searchText.includes(q);
        return matchesCategory && matchesSearch;
      };

      const toShow: HTMLElement[] = [];
      const toHide: HTMLElement[] = [];

      cards.forEach((card) => {
        if (matchCard(card)) {
          toShow.push(card);
        } else {
          toHide.push(card);
        }
      });

      const currentlyVisible = cards.filter(
        (card) => !card.classList.contains('is-filtered-out') && !container.classList.contains('is-empty')
      );

      if (!animate || reduceMotion) {
        toHide.forEach((card) => {
          card.classList.add('is-filtered-out');
          settleCard(card);
        });
        toShow.forEach((card) => {
          card.classList.remove('is-filtered-out');
          settleCard(card);
        });
        if (toShow.length === 0) {
          container.classList.add('is-empty');
          if (emptyState) {
            emptyState.classList.remove('hidden');
            gsap.set(emptyState, { clearProps: 'opacity,transform' });
          }
        } else {
          container.classList.remove('is-empty');
          if (emptyState) {
            emptyState.classList.add('hidden');
            gsap.set(emptyState, { clearProps: 'opacity,transform' });
          }
        }
        refreshScroll();
        return;
      }

      // ========================================================
      // 场景 A：无匹配结果（空状态）
      // ========================================================
      if (toShow.length === 0) {
        const exitingCards = currentlyVisible;

        // 子场景 A1：当前已处于空状态（空切空，例如在两个 0 条分类之间切换），原位执行轻盈浮现反馈
        if (exitingCards.length === 0) {
          container.classList.add('is-empty');
          if (emptyState) {
            emptyState.classList.remove('hidden');
            const tl = gsap.timeline({
              onComplete: () => {
                gsap.set(emptyState, { clearProps: 'opacity,transform' });
                refreshScroll();
                filterTimeline = null;
              },
            });
            filterTimeline = tl;
            tl.fromTo(
              emptyState,
              { opacity: 0, y: 14, scale: 0.98 },
              { opacity: 1, y: 0, scale: 1, duration: 0.38, ease: 'power2.out' }
            );
          }
          return;
        }

        // 子场景 A2：从有卡片切到空状态
        // 与 gallery 空态同一套五段式：钉高 → 视口回流 → 卷收 → 空面板浮现 → 高度塌缩
        if (emptyState) {
          emptyState.classList.add('hidden');
        }

        if (currentH > 0) {
          container.style.minHeight = `${currentH}px`;
        }
        returnToFilterBar();

        exitingCards.forEach((c) => {
          c.classList.add('is-reflowing');
          c.classList.remove('is-entered');
        });
        gsap.set(exitingCards, { clipPath: 'inset(0 0% 0 0)' });

        const switchTime = 0.28 + Math.min(exitingCards.length - 1, 6) * 0.02;
        const tl = gsap.timeline({
          onComplete: () => {
            if (emptyState) {
              gsap.set(emptyState, { clearProps: 'opacity,transform' });
            }
            refreshScroll();
            filterTimeline = null;
          },
        });
        filterTimeline = tl;

        // 阶段 1：卡片从右向左卷收退场 (0..0.28s)
        tl.to(exitingCards, {
          clipPath: 'inset(0 100% 0 0)',
          opacity: 0,
          scale: 0.98,
          duration: 0.28,
          ease: 'power2.inOut',
          stagger: 0.02,
        }, 0);

        // 阶段 2：换骨就位 —— 卡片标记为已筛除，但容器仍被钉在上面的高度上，文档高度此刻不塌
        tl.add(() => {
          if (emptyState) {
            emptyState.classList.remove('hidden');
          }
          exitingCards.forEach((c) => {
            c.classList.add('is-filtered-out');
            c.classList.remove('is-reflowing');
            settleCard(c);
          });
          refreshScroll({ clamp: false });
        }, switchTime);

        // 阶段 3：空状态面板原位浮现
        if (emptyState) {
          tl.fromTo(
            emptyState,
            { opacity: 0, y: 16, scale: 0.98 },
            { opacity: 1, y: 0, scale: 1, duration: 0.42, ease: 'power2.out' },
            switchTime
          );
        }

        // 阶段 4：钉住的空白网格高度在 0.55s 内徐收至 0，空面板随之上浮到位
        tl.to(container, {
          minHeight: 0,
          duration: 0.55,
          ease: 'power2.inOut',
          onUpdate: () => refreshScroll({ clamp: false }),
          onComplete: () => {
            container.style.minHeight = '0px';
            container.classList.add('is-empty');
            refreshScroll();
          },
        }, switchTime);
        return;
      }

      // ========================================================
      // 场景 B：有匹配卡片结果呈现 (空状态 -> 卡片 或 卡片 -> 卡片)
      // ========================================================
      // 计算原位完全未变的卡片前缀集合：这些卡片保持完全静止，绝不重复播放卷轴收展
      const stationarySet = new Set<HTMLElement>();
      for (let i = 0; i < Math.min(currentlyVisible.length, toShow.length); i++) {
        if (currentlyVisible[i] === toShow[i]) {
          stationarySet.add(toShow[i]);
        } else {
          break;
        }
      }

      const exitingCards = currentlyVisible.filter((c) => !stationarySet.has(c));
      const enteringCards = toShow.filter((c) => !stationarySet.has(c));
      const wasEmpty = currentlyVisible.length === 0 && emptyState && !emptyState.classList.contains('hidden');

      // 若切换前后所有可见卡片完全一致且原位未变（例如「全部拾光 1」切到「推荐去处 1」），原位静止直接返回
      if (!wasEmpty && exitingCards.length === 0 && enteringCards.length === 0) {
        toShow.forEach((card) => settleCard(card));
        toHide.forEach((card) => {
          card.classList.add('is-filtered-out');
          settleCard(card);
        });
        container.classList.remove('is-empty');
        if (emptyState) {
          emptyState.classList.add('hidden');
          gsap.set(emptyState, { clearProps: 'opacity,transform' });
        }
        refreshScroll();
        return;
      }

      // ---------------------------------------------------------------
      // 落点预测 + 预滚动（不做高度锁）
      // 换骨会让网格变矮，浏览器会把滚动位置一帧钳到新上限 —— 观感就是「整屏瞬移」。
      // 这里在换骨前同步做一次不可见的布局测量（同一帧内还原，不产生绘制），量出筛完后的
      // 滚动上限与锚点卡的新位置，然后在卷轴卷收的这段时间里用 Lenis 平滑滑到落点；
      // 换骨那一帧视口已经在落点上，就不会再被钳。落点优先「你正在看的那张卡」，
      // 它被筛掉了就退到离原位最近的一张，再兜底到新的滚动上限。
      // ---------------------------------------------------------------
      if (!wasEmpty) {
        const anchor = captureViewportAnchor();
        const scrollBefore = window.scrollY;
        const prevHidden = cards.map((c) => c.classList.contains('is-filtered-out'));

        toShow.forEach((c) => c.classList.remove('is-filtered-out'));
        toHide.forEach((c) => c.classList.add('is-filtered-out'));
        const predictedMax = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);

        let anchorScroll: number | null = null;
        if (anchor) {
          let el: HTMLElement | null =
            cards.find((c) => c.getAttribute('data-life-id') === anchor.lifeId) || null;
          if (!el || el.offsetParent === null || el.classList.contains('is-filtered-out')) {
            let bestDist = Infinity;
            for (const c of toShow) {
              const dist = Math.abs(c.getBoundingClientRect().top - anchor.offset);
              if (dist < bestDist) {
                bestDist = dist;
                el = c;
              }
            }
          }
          if (el) anchorScroll = scrollBefore + el.getBoundingClientRect().top - anchor.offset;
        }

        cards.forEach((c, i) => c.classList.toggle('is-filtered-out', prevHidden[i]));

        const landing = Math.max(0, Math.min(anchorScroll ?? predictedMax, predictedMax));
        if (Math.abs(landing - scrollBefore) > 4) {
          const lenis = (window as any).lenis;
          if (lenis && typeof lenis.scrollTo === 'function') {
            lenis.scrollTo(landing, {
              duration: 0.26,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
          } else {
            window.scrollTo({ top: landing, behavior: 'smooth' });
          }
        }
      }

      const tl = gsap.timeline({
        onComplete: () => {
          toShow.forEach((card) => settleCard(card));
          toHide.forEach((card) => {
            card.classList.add('is-filtered-out');
            settleCard(card);
          });
          refreshScroll();
          filterTimeline = null;
        },
      });
      filterTimeline = tl;

      let switchTime = 0;

      if (wasEmpty && emptyState) {
        // 阶段 1（空状态 -> 卡片）：先在原位平滑淡出空状态
        tl.to(
          emptyState,
          {
            opacity: 0,
            y: -12,
            scale: 0.98,
            duration: 0.18,
            ease: 'power2.in',
          },
          0
        );
        switchTime = 0.18;
      } else if (exitingCards.length > 0) {
        // 阶段 1（卡片 -> 卡片）：仅退场/换位卡片卷轴卷收，原位卡片保持静止
        container.classList.remove('is-empty');
        if (emptyState) {
          emptyState.classList.add('hidden');
          gsap.set(emptyState, { clearProps: 'opacity,transform' });
        }
        exitingCards.forEach((c) => {
          c.classList.add('is-reflowing');
          c.classList.remove('is-entered');
        });
        gsap.set(exitingCards, { clipPath: 'inset(0 0% 0 0)' });
        tl.to(
          exitingCards,
          {
            clipPath: 'inset(0 100% 0 0)',
            opacity: 0,
            scale: 0.98,
            duration: 0.28,
            ease: 'power2.inOut',
            stagger: 0.02,
          },
          0
        );
        const exitStaggerTotal = Math.min(exitingCards.length - 1, 6) * 0.02;
        switchTime = 0.28 + exitStaggerTotal;
      }

      // 阶段 2：先展开卡片容器再隐藏空状态面板，立即刷新 Lenis 滚动上限
      tl.add(() => {
        container.classList.remove('is-empty');

        enteringCards.forEach((card) => {
          card.classList.remove('is-filtered-out');
          card.classList.add('is-reflowing');
          card.dataset.enterState = 'in';
        });
        toHide.forEach((card) => {
          card.classList.add('is-filtered-out');
          card.classList.remove('is-reflowing');
          settleCard(card);
        });

        if (emptyState) {
          emptyState.classList.add('hidden');
          gsap.set(emptyState, { clearProps: 'opacity,transform' });
        }

        if (enteringCards.length > 0) {
          gsap.set(enteringCards, {
            clipPath: 'inset(0 100% 0 0)',
            opacity: 0,
            x: -16,
            scale: 0.98,
          });
        }
        // 换骨这一帧不钳制滚动：Lenis 正在把视口滑向预测落点，钳一下会打断这次滑动
        refreshScroll({ clamp: false });
      }, switchTime);

      // 阶段 3：仅新增/换位卡片从左向右卷轴徐展
      if (enteringCards.length > 0) {
        tl.to(
          enteringCards,
          {
            clipPath: 'inset(0 0% 0 0)',
            opacity: 1,
            x: 0,
            scale: 1,
            duration: 0.68,
            ease: 'enter',
            stagger: 0.06,
          },
          switchTime
        );
      }
    }

    // 分类 Tab 切换
    catTabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.stopPropagation();
        const newCat = tab.getAttribute('data-category-tab') || 'all';
        if (newCat === currentCategory && !searchQuery) return; // 避免重复点击相同激活项

        catTabs.forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
        currentCategory = newCat;

        const rect = tab.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0) {
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 6);
        }

        applyFilters(true, true);
      }, { signal });
    });

    // 卡片内小标签点击直接填入搜索框并即时过滤
    cards.forEach((card) => {
      const chips = card.querySelectorAll<HTMLElement>('[data-click-tag]');
      chips.forEach((chip) => {
        chip.addEventListener('click', (e) => {
          e.stopPropagation();
          const tag = chip.getAttribute('data-click-tag');
          if (!tag) return;

          if (searchInput) {
            searchInput.value = tag;
            searchQuery = tag;
            if (searchClear) searchClear.classList.remove('hidden');
            applyFilters(true, true);
            searchInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }

          const rect = chip.getBoundingClientRect();
          (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 8);
        }, { signal });
      });
    });

    // 实时搜索防抖处理
    let searchTimer = 0;
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        if (searchClear) {
          if (searchQuery) {
            searchClear.classList.remove('hidden');
          } else {
            searchClear.classList.add('hidden');
          }
        }
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => {
          applyFilters(true, true);
        }, 120);
      }, { signal });
    }

    // 清空搜索
    if (searchClear && searchInput) {
      searchClear.addEventListener('click', (e) => {
        e.stopPropagation();
        searchInput.value = '';
        searchQuery = '';
        searchClear.classList.add('hidden');
        applyFilters(true, true);
        searchInput.focus();
      }, { signal });
    }

    // 重置所有筛选
    if (resetBtn) {
      resetBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        currentCategory = 'all';
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        if (searchClear) searchClear.classList.add('hidden');

        catTabs.forEach((t) => t.classList.remove('is-active'));
        catTabs[0]?.classList.add('is-active');

        const rect = resetBtn.getBoundingClientRect();
        (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 14);

        applyFilters(true, true);
      }, { signal });
    }

    // =========================================================
    // 灵感抽签 Modal 与交互动效
    // =========================================================
    let isModalOpen = false;

    function openModal() {
      if (!modal) return;
      isModalOpen = true;

      // 避免 Lenis 与弹窗内滚动打架
      if ((window as any).lenis) {
        (window as any).lenis.stop();
      }

      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.add('is-open');
      });
      document.body.classList.add('life-modal-open');

      // 掷骰子动画与水墨飞溅
      if (diceIcon && !reduceMotion) {
        gsap.fromTo(diceIcon, { rotation: 0, scale: 1 }, { rotation: 720, scale: 1.35, duration: 0.65, ease: 'back.out(2)', clearProps: 'scale' });
      }

      const btnRect = randomBtn?.getBoundingClientRect();
      if (btnRect) {
        (window as any).__inkSplash?.(btnRect.left + btnRect.width / 2, btnRect.top + btnRect.height / 2, 16);
      }
    }

    function closeModal() {
      if (!modal || !isModalOpen) return;
      isModalOpen = false;

      modal.classList.remove('is-open');
      document.body.classList.remove('life-modal-open');

      if ((window as any).lenis) {
        (window as any).lenis.start();
      }

      window.setTimeout(() => {
        if (!isModalOpen) {
          modal.classList.add('hidden');
        }
      }, 300);
    }

    let lastPickedId = '';
    function rollLottery() {
      // 优先从当前未被过滤的卡片抽选，若均被过滤则从全部卡片抽选
      const pool = cards.filter((c) => !c.classList.contains('is-filtered-out'));
      const candidates = pool.length > 0 ? pool : cards;
      if (candidates.length === 0) return;

      // 尽量避免连续抽中同一个
      let poolToPick = candidates;
      if (candidates.length > 1 && lastPickedId) {
        const filtered = candidates.filter((c) => c.getAttribute('data-life-id') !== lastPickedId);
        if (filtered.length > 0) poolToPick = filtered;
      }

      const pickedCard = poolToPick[Math.floor(Math.random() * poolToPick.length)];
      currentLotteryCard = pickedCard;
      lastPickedId = pickedCard.getAttribute('data-life-id') || '';

      const title = pickedCard.querySelector('.life-card-title')?.textContent || '';
      const categoryBadge = pickedCard.querySelector('.life-card-category-badge')?.textContent || '';
      const city = pickedCard.querySelector('.life-card-city')?.textContent || '';
      const summary = pickedCard.querySelector('.life-card-summary')?.textContent || '';
      const bestTime = pickedCard.querySelector('.life-card-best-time')?.textContent || '';

      if (modalContent) {
        modalContent.innerHTML = `
          <div class="p-4 rounded-lg bg-[var(--bg-soft)] border border-[var(--rule)]">
            <div class="flex items-center justify-between text-xs mb-2">
              <span class="px-2 py-0.5 rounded border border-[var(--rule)] bg-[var(--bg-base)] font-medium text-[var(--text-strong)]">${categoryBadge}</span>
              <span class="font-mono text-[var(--muted)]">${city}</span>
            </div>
            <h4 class="text-xl font-bold text-[var(--text-strong)] mb-2" style="font-family: var(--font-hand);">${title}</h4>
            <p class="text-sm italic text-[var(--muted-strong)] mb-3" style="font-family: var(--font-serif);">${summary}</p>
            ${bestTime ? `<p class="text-xs font-mono text-[var(--muted)]">${bestTime}</p>` : ''}
          </div>
        `;

        if (!reduceMotion) {
          gsap.fromTo(modalContent, { opacity: 0, y: 12, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.38, ease: 'ink' });
        }
      }

      openModal();
    }

    if (randomBtn) {
      randomBtn.addEventListener('click', rollLottery, { signal });
    }

    if (modalReroll) {
      modalReroll.addEventListener('click', () => {
        const rerollBtnRect = modalReroll.getBoundingClientRect();
        (window as any).__inkSplash?.(rerollBtnRect.left + rerollBtnRect.width / 2, rerollBtnRect.top + rerollBtnRect.height / 2, 12);
        rollLottery();
      }, { signal });
    }

    if (modalClose && modal) {
      modalClose.addEventListener('click', closeModal, { signal });
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      }, { signal });
    }

    // 支持按下 Esc 键关闭弹窗
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isModalOpen) {
        closeModal();
      }
    }, { signal });

    // 定位到选中的卡片
    if (modalLocate) {
      modalLocate.addEventListener('click', () => {
        if (!currentLotteryCard) return;
        const target = currentLotteryCard;

        // 若当前处于过滤状态导致该卡片不可见，则自动重置过滤条件使卡片可见
        if (target.classList.contains('is-filtered-out')) {
          currentCategory = 'all';
          searchQuery = '';
          if (searchInput) searchInput.value = '';
          if (searchClear) searchClear.classList.add('hidden');
          catTabs.forEach((t) => t.classList.remove('is-active'));
          catTabs[0]?.classList.add('is-active');
          applyFilters(false);
        }

        closeModal();

        // 统一使用 Lenis 平滑滚动，严防原生 smooth scroll 与 Lenis 冲突导致卡住
        window.setTimeout(() => {
          if ((window as any).lenis) {
            (window as any).lenis.scrollTo(target, {
              offset: -100,
              duration: 1.1,
              easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            });
          } else {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }

          // 施加聚焦高光动画与水墨飞溅
          target.classList.add('is-spotlight');
          window.setTimeout(() => {
            const rect = target.getBoundingClientRect();
            (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 20);
          }, 550);

          window.setTimeout(() => {
            target.classList.remove('is-spotlight');
          }, 3200);
        }, 150);
      }, { signal });
    }

    // 页面卸载或重新载入时的清理函数
    (window as any)[CLEANUP_KEY] = () => {
      controller.abort();
      window.clearTimeout(searchTimer);
      if (filterTimeline) {
        filterTimeline.kill();
        filterTimeline = null;
      }
      if (isModalOpen) {
        if ((window as any).lenis) {
          (window as any).lenis.start();
        }
        document.body.classList.remove('life-modal-open');
        isModalOpen = false;
      }
      cards.forEach((card) => {
        if (!card.classList.contains('is-filtered-out')) {
          settleCard(card);
        }
        card.classList.remove('is-spotlight');
      });
      (window as any)[CLEANUP_KEY] = undefined;
    };
  }

  // 初始化并在每次 View Transition 后重新挂载
  initLifePage();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initLifePage);
    document.addEventListener('astro:before-swap', () => {
      const previousCleanup = (window as any)[CLEANUP_KEY];
      if (typeof previousCleanup === 'function') previousCleanup();
    });
    (window as any)[LISTENER_KEY] = true;
  }
</script>
