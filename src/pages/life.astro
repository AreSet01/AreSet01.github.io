---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import {
  LIFE_CATEGORIES,
  LIFE_ITEMS,
} from '../data/life';

const allItems = LIFE_ITEMS;
const categories = LIFE_CATEGORIES;

// 统计各分类数目
const countByCategory = {
  all: allItems.length,
  places: allItems.filter((i) => i.category === 'places').length,
  activities: allItems.filter((i) => i.category === 'activities').length,
  items: allItems.filter((i) => i.category === 'items').length,
};
---

<BaseLayout
  title="好去处"
  description="记录吹过晚风的山海、静谧的小馆，以及给生活带来光亮的心头好。"
>
  <Header />

  <main id="main-content" tabindex="-1" class="container-wide flex-1 pt-6 pb-20 lg:pt-8 outline-none min-h-[calc(100vh-140px)]">
    <!-- 顶部标题与介绍 -->
    <section class="panel pb-10 border-b border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 5%, var(--rule-strong) 50%, transparent 95%) 1;">
      <p class="eyebrow" data-enter="top">Life</p>

      <div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <h1 class="section-title" data-enter="left">这么多好去处</h1>
          <p
            class="mt-4 text-[1.02rem] leading-[1.8] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
            data-enter="left"
          >
            马路戏院商店天空海阔任你行～
          </p>
        </div>

        <!-- 顶部互动快捷栏：随机抽签 + 统计指标（防换行排版） -->
        <div class="life-actions-cluster" data-enter="stamp">
          <button
            type="button"
            class="life-random-btn btn-secondary"
            id="life-random-btn"
            title="纠结去哪或做点啥？点此随机摇出灵感"
          >
            <span class="life-random-dice" id="life-dice-icon" aria-hidden="true">🎲</span>
            <span class="life-random-label">灵感抽签</span>
          </button>

          <div class="life-quick-stats">
            <span class="life-stat-pill">
              <b data-count={allItems.length}>{allItems.length}</b> 处拾光
            </span>
          </div>
        </div>
      </div>

      <!-- 搜索栏 -->
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4" data-enter="bottom" data-enter-once>
        <div class="life-search-wrapper flex-1">
          <svg class="life-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="life-search-input"
            class="life-search-input"
            placeholder="搜索地点、玩法、标签或心得内容..."
            autocomplete="off"
            spellcheck="false"
          />
          <button
            type="button"
            id="life-search-clear"
            class="life-search-clear hidden"
            aria-label="清空搜索"
          >
            ✕
          </button>
        </div>
      </div>
    </section>

    <!-- 一级分类切换 Tab -->
    <div class="life-category-tabs" data-enter="bottom" data-enter-once>
      {categories.map((cat) => (
        <button
          type="button"
          class={`life-cat-tab ${cat.id === 'all' ? 'is-active' : ''}`}
          data-category-tab={cat.id}
        >
          <span class="cat-icon">{cat.icon}</span>
          <span class="cat-name">{cat.name}</span>
          <i class="cat-count">{countByCategory[cat.id as keyof typeof countByCategory]}</i>
        </button>
      ))}
    </div>

    <!-- 卡片展示列表 -->
    <div class="life-grid mt-8" id="life-cards-container">
      {allItems.map((item, index) => {
        const enterFrom = (['left', 'bottom', 'right'] as const)[index % 3];
        return (
          <article
            class="life-card"
            data-tilt
            data-enter={enterFrom}
            data-life-id={item.id}
            data-category={item.category}
            data-city={item.city}
            data-tags={item.tags.join(',')}
            data-search-text={`${item.title} ${item.city} ${item.categoryLabel} ${item.tags.join(' ')} ${item.summary} ${(item.tips || []).join(' ')}`.toLowerCase()}
          >
            <!-- 卡片顶栏 -->
            <div class="life-card-header">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="life-card-category-badge">
                  {item.category === 'places' ? '📍 去处' : item.category === 'activities' ? '🎈 玩乐' : '☕ 好物'}
                </span>
                <span class="life-card-divider" aria-hidden="true">·</span>
                <span class="life-card-city">
                  {item.city}
                </span>
              </div>
            </div>

            <!-- 卡片主标题与星级 -->
            <div class="life-card-title-group">
              <h2 class="life-card-title">{item.title}</h2>
              <div class="life-card-rating" title={`推荐星级：${item.rating} 星`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < item.rating ? 'star-filled' : 'star-empty'}>★</span>
                ))}
              </div>
            </div>

            <!-- 推荐短评 -->
            <blockquote class="life-card-summary">
              “{item.summary}”
            </blockquote>

            <!-- 避坑与打卡建议（古籍批注式排版） -->
            {item.tips && item.tips.length > 0 && (
              <div class="life-card-tips-box">
                <div class="life-card-tips-header">
                  <span class="tips-pillar-mark" aria-hidden="true">▍</span>
                  <span>游历小笺 · 避坑备忘</span>
                </div>
                <ul class="life-card-tips-list">
                  {item.tips.map((tip) => (
                    <li>{tip}</li>
                  ))}
                </ul>
              </div>
            )}

            <!-- 最佳时机 -->
            {item.bestTime && (
              <div class="life-card-best-time">
                <span class="best-time-icon">⏱</span>
                <span>适宜：{item.bestTime}</span>
              </div>
            )}

            <!-- 底部标签与导航链接 -->
            <div class="life-card-footer">
              <div class="life-card-tags">
                {item.tags.map((tag) => (
                  <button type="button" class="life-chip" data-click-tag={tag} title="按此标签搜索">
                    #{tag}
                  </button>
                ))}
              </div>

              {item.locationUrl && (
                <a
                  href={item.locationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="life-map-link"
                  title="打开地图导航"
                >
                  <span>地图导航</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>

    <!-- 搜索/过滤无结果空状态 -->
    <div id="life-empty-state" class="life-empty-state hidden">
      <div class="empty-ink-circle">空</div>
      <h3 class="empty-title">空山不见人，但闻人语响</h3>
      <p class="empty-desc">没有找到符合条件的推荐，换个关键词或重置筛选试试吧。</p>
      <button type="button" id="life-reset-filters-btn" class="life-reset-btn btn-secondary">
        重置所有筛选
      </button>
    </div>

    <!-- 灵感抽签弹窗 Modal -->
    <div
      id="life-lottery-modal"
      class="life-modal-backdrop hidden"
      aria-modal="true"
      role="dialog"
      aria-labelledby="modal-life-title"
      data-lenis-prevent
    >
      <div class="life-modal-dialog" data-lenis-prevent>
        <button type="button" class="life-modal-close" id="life-modal-close" aria-label="关闭弹窗">✕</button>
        <div class="life-modal-header">
          <span class="modal-seal">抽签</span>
          <h3 class="modal-title" id="modal-life-title">🎲 今日灵感签</h3>
          <p class="modal-subtitle">既然犹豫不决，不妨把脚步交给机缘~</p>
        </div>

        <div id="life-modal-content" class="life-modal-body">
          <!-- 动态注入抽签卡片内容 -->
        </div>

        <div class="life-modal-actions">
          <button type="button" id="life-modal-reroll" class="btn-primary life-modal-reroll-btn">
            再摇一次 🎲
          </button>
          <button type="button" id="life-modal-locate" class="btn-secondary life-modal-locate-btn">
            定位到卡片 📍
          </button>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  /* =========================================================
     Life Page Styles (Editorial Minimal & Ink Glassmorphism)
     ========================================================= */

  .life-actions-cluster {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: nowrap;
    user-select: none;
  }

  .life-random-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    font-size: 0.85rem;
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--text-strong);
    background: var(--bg-soft);
    border: 1px solid var(--rule-strong);
    border-radius: 9999px;
    cursor: pointer;
    transition: all 260ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    white-space: nowrap !important;
    flex-shrink: 0;
    line-height: 1;
  }

  /* .btn-secondary 的 ::after 下划线是给纯文字按钮准备的：带背景和边框的胶囊/方框按钮
     叠加它会在底边多出一条横穿的杂线，这里把本页这类按钮统一禁用 */
  .life-random-btn::after,
  .life-reset-btn::after {
    display: none;
  }

  .life-random-btn:hover {
    background: var(--text-strong);
    color: var(--bg-base);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
  }

  .life-random-btn:active {
    transform: translateY(1px) scale(0.98);
  }

  .life-random-dice {
    display: inline-block;
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .life-random-label {
    display: inline-block;
    white-space: nowrap !important;
    line-height: 1;
  }

  .life-random-btn:hover .life-random-dice {
    transform: rotate(25deg) scale(1.18);
  }

  .life-quick-stats {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .life-stat-pill {
    padding: 0.45rem 0.85rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--muted-strong);
    background: var(--bg-soft);
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
    white-space: nowrap;
  }

  .life-stat-pill b {
    color: var(--text-strong);
    font-weight: 600;
  }

  /* 搜索框 */
  .life-search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 480px;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: var(--bg-soft);
    cursor: default;
    transition: border-color 200ms ease, background 200ms ease, box-shadow 200ms ease;
  }

  .life-search-wrapper:focus-within {
    border-color: var(--text-strong);
    background: var(--bg-base);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
  }

  [data-theme="dark"] .life-search-wrapper:focus-within {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
  }

  .life-search-icon {
    position: absolute;
    left: 1rem;
    color: var(--muted);
    pointer-events: none;
    transition: color 200ms ease;
  }

  .life-search-wrapper:focus-within .life-search-icon {
    color: var(--text-strong);
  }

  .life-search-input {
    width: 100%;
    padding: 0.65rem 2.2rem 0.65rem 2.6rem;
    font-size: 0.88rem;
    color: var(--text-strong);
    background: transparent;
    border: none;
    border-radius: 8px;
    clip-path: inset(0 round 8px);
    outline: none;
  }

  .life-search-clear {
    position: absolute;
    right: 0.75rem;
    padding: 0.2rem 0.4rem;
    font-size: 0.75rem;
    color: var(--muted);
    background: transparent;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: color 180ms ease, transform 180ms ease;
  }

  .life-search-clear:hover {
    color: var(--text-strong);
    transform: scale(1.15);
  }

  /* 一级分类 Tab */
  .life-category-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 4px 2px;
    margin-top: calc(1.75rem - 4px);
  }

  .life-cat-tab {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.65rem 0.5rem 0.95rem;
    font-size: 0.84rem;
    font-family: var(--font-body);
    color: var(--muted-strong);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    cursor: pointer;
    user-select: none;
    box-sizing: border-box;
    transition:
      color 420ms var(--ease),
      border-color 320ms var(--ease),
      transform 320ms var(--ease-bounce);
  }

  .life-cat-tab::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink-strong);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 520ms var(--ease);
  }

  .life-cat-tab.is-active::before {
    transform: scaleX(1);
  }

  .life-cat-tab:not(.is-active):hover {
    color: var(--text-strong);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .life-cat-tab:not(.is-active):hover .cat-count {
    color: var(--text-strong);
    border-color: var(--accent);
  }

  .life-cat-tab.is-active {
    background: transparent;
    color: var(--bg-base);
    border-color: var(--ink-strong);
    font-weight: 500;
    box-shadow: none;
  }

  .life-cat-tab.is-active:hover {
    color: var(--bg-base);
    border-color: var(--ink-strong);
    transform: translateY(-1px);
  }

  .life-cat-tab.is-active:hover .cat-count {
    color: inherit;
    border-color: transparent;
  }

  .life-cat-tab .cat-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.45rem;
    height: 1.45rem;
    padding-inline: 0.35rem;
    border-radius: 3px;
    background: var(--bg-soft);
    border: 1px solid var(--rule);
    font-size: 0.68rem;
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--muted);
    transition: background 240ms var(--ease), color 240ms var(--ease), border-color 240ms var(--ease);
  }

  .life-cat-tab.is-active .cat-count {
    background: color-mix(in srgb, currentColor 16%, transparent);
    border-color: transparent;
    color: inherit;
  }

  /* 卡片网格（无框手札布局） */
  .life-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 3.5rem 2.8rem;
    position: relative;
    min-height: 200px;
    overflow: visible;
    padding: 0.5rem 0.25rem;
  }

  .life-grid.is-empty {
    display: none !important;
  }

  @media (max-width: 640px) {
    .life-grid {
      grid-template-columns: 1fr;
      gap: 2.75rem;
    }
  }

  /* 卡片本体（文人雅集生活卡片，统一 12px 圆角与柔和底色） */
  .life-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.8rem;
    background: rgba(248, 246, 242, 0.9);
    border: 1px solid var(--rule);
    border-radius: 12px !important;
    box-shadow: 0 4px 18px -2px rgba(0, 0, 0, 0.04);
    will-change: transform, opacity;
  }

  .life-card.is-filtered-out {
    display: none !important;
  }

  /* 由统一 GSAP tilt 引擎管理 3D 变换，杜绝 CSS transform 过渡与 GSAP 逐帧抢控制权 */
  .life-card.is-entered:not(.is-reflowing):not(.is-entering) {
    transition: box-shadow 240ms var(--ease), border-color 240ms var(--ease);
  }

  .life-card.is-reflowing,
  .life-card.is-entering {
    transition: none !important;
  }

  /* 抽签选中的聚焦动画 */
  .life-card.is-spotlight {
    animation: life-card-pulse 1.8s cubic-bezier(0.22, 1, 0.36, 1) 2;
    z-index: 2;
  }
  .life-card.is-spotlight .life-card-title {
    color: var(--vermilion) !important;
    text-shadow: 0 0 14px var(--vermilion-soft);
  }

  @keyframes life-card-pulse {
    0% { transform: scale(1); }
    40% { transform: scale(1.02); }
    100% { transform: scale(1); }
  }

  /* 卡片内部元素 */
  .life-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .life-card-category-badge {
    display: inline-flex;
    align-items: center;
    padding: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-strong);
    background: transparent;
    border: none;
    letter-spacing: 0.06em;
  }

  .life-card-divider {
    font-size: 0.75rem;
    color: var(--rule-strong);
    user-select: none;
  }

  .life-card-city {
    font-size: 0.76rem;
    font-family: var(--font-mono);
    color: var(--muted-strong);
    font-weight: 600;
  }


  .life-card-title-group {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .life-card-title {
    font-family: var(--font-hand-title);
    font-size: 1.42rem;
    font-weight: 500;
    font-synthesis: none;
    color: var(--text-strong);
    line-height: 1.35;
    letter-spacing: 0.02em;
    transition: color 240ms ease;
  }

  .life-card:hover .life-card-title {
    color: var(--accent);
  }

  .life-card-rating {
    display: inline-flex;
    gap: 0.12rem;
    font-size: 0.85rem;
    color: var(--vermilion);
    user-select: none;
    transition: transform 200ms ease;
  }

  .life-card:hover .life-card-rating {
    transform: scale(1.08);
  }

  .star-filled {
    color: var(--vermilion);
    opacity: 0.95;
  }

  .star-empty {
    color: var(--muted);
    opacity: 0.22;
  }

  .life-card-summary {
    margin: 0.35rem 0 1.1rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.74;
    color: var(--text);
  }

  /* 避坑建议（古籍眉批式排版，彻底消灭灰底方盒） */
  .life-card-tips-box {
    margin-top: auto;
    margin-bottom: 0.85rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 0;
  }

  .life-card-tips-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-family: var(--font-serif);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-strong);
    margin-bottom: 0.45rem;
  }

  .tips-pillar-mark {
    color: var(--vermilion);
    font-size: 0.85rem;
    line-height: 1;
  }

  .life-card-tips-list {
    list-style: none;
    padding: 0.1rem 0 0.1rem 0.85rem;
    margin: 0;
    border-left: 1px solid var(--rule-strong);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .life-card-tips-list li {
    position: relative;
    padding-left: 0.85rem;
    line-height: 1.65;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--text);
  }

  .life-card-tips-list li::before {
    content: '•';
    position: absolute;
    left: 0.1rem;
    top: -0.05rem;
    color: var(--accent);
    opacity: 0.7;
  }

  .life-card-best-time {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    font-family: var(--font-mono);
    color: var(--muted-strong);
    font-weight: 600;
    margin: 0.6rem 0 0.85rem;
  }

  .best-time-icon {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .life-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.5rem;
    border-top: none;
  }

