---
const navItems = [
  { label: 'Home', labelZh: 'Main*', href: '/' },
  { label: 'Archive', labelZh: 'All Doc', href: '/archive' },
  { label: 'Timeline', labelZh: 'Timeline', href: '/timeline' },
  { label: 'Tags', labelZh: 'Tags', href: '/tags' },
  { label: 'Stats', labelZh: 'Stats', href: '/stats' },
  { label: 'About', labelZh: 'About Me', href: '/about' },
];

const normalizePath = (path: string) =>
  path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;

const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const year = new Date().getFullYear();
---

<header class="glass-nav" data-enter="left" data-enter-once>
  <div class="glass-nav-inner h-full flex flex-col justify-between">
    <div class="flex flex-col gap-10 lg:gap-14 w-full">
      <div class="flex items-center justify-between w-full">
        <a href="/" class="brand-mark">
          <span class="brand-seal" aria-hidden="true">汐</span>
          <span>梦付千秋</span>
        </a>
        <button
          class="sidebar-collapse-btn hidden lg:inline-flex"
          type="button"
          data-sidebar-collapse
          aria-label="收起侧边栏"
          title="收起侧边栏"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="11 17 6 12 11 7"></polyline>
            <polyline points="18 17 13 12 18 7"></polyline>
          </svg>
        </button>
      </div>
      <div class="nav-cluster">
        <button
          class="nav-search-trigger"
          type="button"
          data-search-trigger
          aria-haspopup="dialog"
          aria-controls="site-search"
          aria-label="打开搜索"
        >
          <span class="nav-search-label">Search<i class="nav-search-caret" aria-hidden="true"></i></span>
          <span class="nav-search-kbd">⌘K</span>
        </button>
        <nav class="nav-links">
          {navItems.map(item => (
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? 'is-active' : ''}`}
            >
              {item.labelZh}
            </a>
          ))}
        </nav>
        <button
          class="theme-toggle"
          type="button"
          aria-label="切换主题"
          data-theme-toggle
        >
          <svg class="icon-sun" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" />
          </svg>
          <svg class="icon-moon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
          </svg>
          <svg class="icon-leaf" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M17 3c-6.5 0-11 2.6-12.6 7.4-.9 2.7-.4 5.2.1 6.4l1.3-2.3c1.1-2 3.1-4.4 6.4-6.2-2.6 2.4-4.4 5-5.4 7.7 1.3.3 3.6.3 5.6-.7C16.2 13.4 17.3 8.3 17 3z" />
          </svg>
        </button>
      </div>
    </div>
    
    <div class="hidden lg:flex flex-col gap-4 mt-auto pt-10 text-[0.75rem] leading-relaxed text-[var(--muted)]" style="font-family: var(--font-serif); font-style: italic;">
      <div class="w-8 h-[1px] bg-[var(--rule)] mb-2"></div>
      <p>不持续且间断更新<br/>诶嘿？你怎么找到这里来的！！！</p>
      <p class="font-mono not-italic tracking-[0.05em] uppercase text-[var(--text-strong)] mt-4">
        &copy; {year} &middot; 梦付千秋
      </p>
      <p class="not-italic">
        Built with
        <a href="https://astro.build" class="text-[var(--accent)] underline decoration-[var(--accent)] underline-offset-4 hover:text-[var(--accent-deep)]" target="_blank" rel="noopener">Astro</a>
      </p>
    </div>
  </div>
</header>

<canvas id="inkCanvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 100005;"></canvas>

<script>
(function () {
  // ── State (re-initialized on every page load) ────────────────────────────
  let canvas, ctx;
  let points   = [];
  let strokeId = 0;
  let isDrawing = false;
  let isMobile  = false;
  let cleanupFns = [];   // window-level listeners to remove on next init
  let hasPointerPosition = false;

  const mouse = { x: 0, y: 0 };
  const brush = {
    x: 0, y: 0, vx: 0, vy: 0,
    radius: 6, isPressed: false, isVisible: false,
  };
  const springTension = 0.12;
  const springDamping  = 0.65;

  // ── InkPoint ─────────────────────────────────────────────────────────────
  class InkPoint {
    constructor(x, y, radius, color, opacity = 0.85, speed = 0) {
      this.x = x; this.y = y;
      this.baseRadius = radius; this.radius = radius;
      this.color = color; this.opacity = opacity;
      this.currentOpacity = opacity;
      this.age = 0; this.maxAge = 45 + Math.random() * 15;
      this.speed = speed;
      this.nx = 0; this.ny = 0;
    }
    update() {
      this.age++;
      const p = this.age / this.maxAge;
      this.radius = this.baseRadius * (1 + p * 0.2);
      this.currentOpacity = this.opacity * (1 - p);
    }
  }

  // ── Canvas resize ─────────────────────────────────────────────────────────
  function resize() {
    if (!canvas) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.style.width = window.innerWidth + 'px';
    canvas.style.height = window.innerHeight + 'px';
    canvas.width  = window.innerWidth  * dpr;
    canvas.height = window.innerHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0); // absolute set, never accumulates
  }

  // ── Drawing ───────────────────────────────────────────────────────────────
  function updateAndDraw() {
    if (!canvas || !ctx || !hasPointerPosition) return;
    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

    const theme = document.documentElement.getAttribute('data-theme') || 'light';
    const color = theme === 'dark' ? '255,255,255' : theme === 'moss' ? '255,241,244' : '26,24,20';
    const [baseR, baseG, baseB] = color.split(',').map(Number);

    // Spring physics
    const dx = mouse.x - brush.x;
    const dy = mouse.y - brush.y;
    brush.vx = (brush.vx + dx * springTension) * springDamping;
    brush.vy = (brush.vy + dy * springTension) * springDamping;
    brush.x += brush.vx;
    brush.y += brush.vy;

    const speed = Math.hypot(brush.vx, brush.vy);

    if (brush.isVisible && speed > 0.15) {
      let targetR = Math.max(3, 11 - speed * 0.2);
      let opacity = 0.85;
      if (brush.isPressed) { targetR = Math.max(7, 22 - speed * 0.3); opacity = 0.95; }
      brush.radius = brush.radius * 0.85 + targetR * 0.15;
      points.push(new InkPoint(brush.x, brush.y, brush.radius, color, opacity, speed));
    } else if (speed <= 0.15 && points.length > 0) {
      strokeId += 0.05;
    }

    points.forEach(p => p.update());
    points = points.filter(p => p.age < p.maxAge);

    // ── Render ──────────────────────────────────────────────────────────────
    if (points.length >= 2) {
      const N = points.length;

      // Compute smooth normals
      for (let i = 0; i < N; i++) {
        let ex, ey;
        if (i === 0)     { ex = points[1].x - points[0].x; ey = points[1].y - points[0].y; }
        else if (i===N-1){ ex = points[i].x - points[i-1].x; ey = points[i].y - points[i-1].y; }
        else             { ex = points[i+1].x - points[i-1].x; ey = points[i+1].y - points[i-1].y; }
        const len = Math.hypot(ex, ey) || 0.001;
        points[i].nx = -ey / len;
        points[i].ny =  ex / len;
      }

      ctx.beginPath();
      // Right side
      for (let i = 0; i < N; i++) {
        const p = points[i];
        const prog = i / (N - 1);
        const spindle = Math.sin(prog * Math.PI) * 1.15;
        const thickness = p.radius * Math.max(0.1, spindle);
        const px = p.x + p.nx * thickness;
        const py = p.y + p.ny * thickness;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      // Left side
      for (let i = N - 1; i >= 0; i--) {
        const p = points[i];
        const prog = i / (N - 1);
        const spindle = Math.sin(prog * Math.PI) * 1.15;
        const thickness = p.radius * Math.max(0.1, spindle);
        const px = p.x - p.nx * thickness;
        const py = p.y - p.ny * thickness;
        ctx.lineTo(px, py);
      }
      ctx.closePath();
      
      const head = points[N - 1];
      
      // Apply slight blur to edges
      ctx.shadowBlur = 2;
      ctx.shadowColor = `rgba(${baseR},${baseG},${baseB},${head.currentOpacity})`;
      
      // Use higher opacity for a more solid look
      ctx.fillStyle = `rgba(${baseR},${baseG},${baseB},${head.currentOpacity * 0.9})`;
      ctx.fill();
      
      // Reset shadow for subsequent drawings
      ctx.shadowBlur = 0;
    }

    // Hollow pointer circle at exact mouse location
    if (brush.isVisible) {
      ctx.beginPath();
      ctx.arc(mouse.x, mouse.y, 4, 0, Math.PI * 2);
      ctx.lineWidth   = 1;
      ctx.strokeStyle = `rgba(${baseR},${baseG},${baseB},0.5)`;
      ctx.stroke();
    }

    const isStationary = points.length === 0 && speed <= 0.05;
    if (!brush.isVisible || isStationary) {
      isDrawing = false;
    } else if (isDrawing) {
      requestAnimationFrame(updateAndDraw);
    }
  }

  // ── Init (called on every Astro page-load) ────────────────────────────────
  function init() {
    // Remove previous window listeners
    cleanupFns.forEach(fn => fn());
    cleanupFns = [];
    isDrawing = false;
    points    = [];

    // Re-acquire canvas (Astro swaps the DOM on navigation)
    canvas = document.getElementById('inkCanvas');
    if (!canvas) return;

    // ★ Move canvas to <body> to escape any backdrop-filter containing block
    //   (backdrop-filter on an ancestor breaks position:fixed for children)
    if (canvas.parentElement !== document.body) {
      document.body.appendChild(canvas);
    }

    ctx = canvas.getContext('2d');
    brush.isVisible = false;
    brush.isPressed = false;
    brush.vx = brush.vy = 0;
    hasPointerPosition = false;

    resize();

    // ── Event listeners ──────────────────────────────────────────────────
    function updateMouse(e) {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      if (!hasPointerPosition) {
        brush.x = mouse.x;
        brush.y = mouse.y;
        brush.vx = 0;
        brush.vy = 0;
        hasPointerPosition = true;
      }
    }

    function onResize() { resize(); }

    function onPointerEnter(e) {
      brush.isVisible = true;
      updateMouse(e);
      brush.x = mouse.x;   brush.y = mouse.y;
      brush.vx = brush.vy = 0;
      hasPointerPosition = true;
      strokeId++;
    }
    function onPointerLeave() {
      brush.isVisible = false;
      brush.isPressed = false;
      hasPointerPosition = false;
    }

    function onPointerMove(e) {
      updateMouse(e);
      brush.isVisible = true;
      const t = e.target;
      if (t && t.matches('input,textarea,[contenteditable="true"],.search-input')) {
        brush.isVisible = false;
      }
      if (!isDrawing) {
        isDrawing = true;
        requestAnimationFrame(updateAndDraw);
      }
    }
    function onPointerDown(e) {
      if (e.button === 0) {
        updateMouse(e);
        brush.isPressed = true;
        strokeId++;
      }
    }
    function onPointerUp()    { brush.isPressed = false; strokeId++; }

    window.addEventListener('resize',       onResize);
    window.addEventListener('pointerenter', onPointerEnter);
    window.addEventListener('pointerleave', onPointerLeave);
    window.addEventListener('pointermove',  onPointerMove);
    window.addEventListener('pointerdown',  onPointerDown);
    window.addEventListener('pointerup',    onPointerUp);

    // Check mobile
    const onMobileCheck = () => {
      isMobile = !window.matchMedia('(pointer: fine)').matches;
    };
    onMobileCheck();
    window.addEventListener('resize', onMobileCheck);

    cleanupFns.push(
      () => window.removeEventListener('resize',       onMobileCheck),
      () => window.removeEventListener('resize',       onResize),
      () => window.removeEventListener('pointerenter', onPointerEnter),
      () => window.removeEventListener('pointerleave', onPointerLeave),
      () => window.removeEventListener('pointermove',  onPointerMove),
      () => window.removeEventListener('pointerdown',  onPointerDown),
      () => window.removeEventListener('pointerup',    onPointerUp),
    );
  }

  // ★ Re-run init on every Astro View Transition navigation
  document.addEventListener('astro:page-load', init);
  // Also run immediately for the first (non-transition) page load
  init();

  document.addEventListener('astro:before-swap', () => {
     if (typeof ctx !== 'undefined' && ctx) {
       ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
     }
     points = [];
     isDrawing = false;
  });
})();
</script>

<script>
import gsap from 'gsap';

// Sidebar folds away like a paper door: items file out to the left, the panel swings on its
// left hinge (rotateY), then the column width collapses. Expanding runs it in reverse.
(function setupSidebarController() {
  let folding = null;

  function persist(collapsed) {
    try { localStorage.setItem('sidebar-collapsed', collapsed ? 'true' : 'false'); } catch (e) {}
  }

  function parts(inner) {
    // Direct visual groups of the sidebar, top to bottom: the brand row, the nav cluster, the footer
    return Array.from(inner.querySelectorAll(':scope > div:first-child > *, :scope > div:last-child'));
  }

  function collapse(nav, inner) {
    if (folding) folding.kill();
    const items = parts(inner);
    document.documentElement.setAttribute('data-sidebar-folding', 'true');
    folding = gsap.timeline({
      defaults: { overwrite: 'auto' },
      onComplete: () => {
        document.documentElement.removeAttribute('data-sidebar-folding');
        folding = null;
        window.dispatchEvent(new Event('resize'));
      },
    });
    folding
      .to(items, { x: -28, opacity: 0, duration: 0.34, ease: 'power3.in', stagger: 0.04 }, 0)
      .to(inner, { rotationY: -78, opacity: 0, duration: 0.58, ease: 'power3.in', transformOrigin: 'left center' }, 0.12)
      .add(() => {
        document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
        persist(true);
      }, 0.3)
      .to({}, { duration: 0.85 }); // let the CSS column transition finish before onComplete
  }

  function expand(nav, inner) {
    if (folding) folding.kill();
    const items = parts(inner);
    document.documentElement.setAttribute('data-sidebar-folding', 'true');
    gsap.set(inner, { rotationY: -78, opacity: 0, transformOrigin: 'left center' });
    gsap.set(items, { x: -28, opacity: 0 });
    document.documentElement.removeAttribute('data-sidebar-collapsed');
    persist(false);
    folding = gsap.timeline({
      defaults: { overwrite: 'auto' },
      onComplete: () => {
        gsap.set([inner, ...items], { clearProps: 'transform,opacity' });
        document.documentElement.removeAttribute('data-sidebar-folding');
        folding = null;
        window.dispatchEvent(new Event('resize'));
      },
    });
    folding
      .to(inner, { rotationY: 0, opacity: 1, duration: 0.9, ease: 'expo.out' }, 0.26)
      .to(items, { x: 0, opacity: 1, duration: 0.8, ease: 'expo.out', stagger: 0.05 }, 0.42);
  }

  function setupSidebar() {
    const nav = document.querySelector('.glass-nav');
    const inner = nav?.querySelector('.glass-nav-inner');
    const collapseBtn = document.querySelector('[data-sidebar-collapse]');
    const expandBtn = document.querySelector('[data-sidebar-expand]');
    if (!nav || !inner) return;
    if (nav.dataset.sidebarBound === 'true') return;
    nav.dataset.sidebarBound = 'true';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    collapseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (reduceMotion) {
        document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
        persist(true);
        window.dispatchEvent(new Event('resize'));
        return;
      }
      collapse(nav, inner);
    });

    expandBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (reduceMotion) {
        document.documentElement.removeAttribute('data-sidebar-collapsed');
        persist(false);
        window.dispatchEvent(new Event('resize'));
        return;
      }
      expand(nav, inner);
    });
  }

  document.addEventListener('astro:page-load', setupSidebar);
  setupSidebar();
})();
</script>

<style is:global>
  .sidebar-expand-btn {
    display: none;
  }

  @media (min-width: 1024px) {
    .site-shell {
      padding-left: 0 !important;
      gap: clamp(2.5rem, 5vw, 4.5rem);
      transition: gap 820ms cubic-bezier(0.22, 1, 0.36, 1),
                  padding 820ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* The reading column keeps the same flex basis in both states; only max-width, margins and
       padding change — all explicit lengths, so they interpolate. (margin:auto never animates,
       which is what made the old version snap.) */
    .site-shell > main,
    .container-wide,
    .container-medium {
      flex: 1 1 0% !important;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      padding-right: clamp(2rem, 4vw, 3rem) !important;
      transition: max-width 820ms cubic-bezier(0.22, 1, 0.36, 1),
                  margin 820ms cubic-bezier(0.22, 1, 0.36, 1),
                  padding 820ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .glass-nav {
      position: sticky !important;
      height: 100vh !important;
      height: 100dvh !important;
      width: clamp(14rem, 20vw, 18rem);
      min-width: clamp(14rem, 20vw, 18rem);
      flex-shrink: 0;
      overflow: visible;
      perspective: 1400px;
      transition: width 820ms cubic-bezier(0.22, 1, 0.36, 1),
                  min-width 820ms cubic-bezier(0.22, 1, 0.36, 1),
                  margin-left 820ms cubic-bezier(0.22, 1, 0.36, 1),
                  opacity 320ms ease !important;
    }

    /* GSAP owns transform/opacity here (the hinge fold) — no CSS transition to fight it */
    .glass-nav-inner {
      width: clamp(14rem, 20vw, 18rem) !important;
      min-width: clamp(14rem, 20vw, 18rem) !important;
      transform-origin: left center;
      transform-style: preserve-3d;
      backface-visibility: hidden;
      transition: none !important;
    }

    html[data-sidebar-folding="true"] .glass-nav-inner {
      will-change: transform, opacity;
    }

    html[data-sidebar-folding="true"] .glass-nav {
      pointer-events: none;
    }

    .home-topics {
      padding-right: 0 !important;
    }
    .home-topics h2 {
      position: relative !important;
      writing-mode: horizontal-tb !important;
      height: auto !important;
    }

    /* Collapse button in sidebar */
    .sidebar-collapse-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      border-radius: 4px;
      border: 1px solid var(--rule);
      background: var(--bg-soft);
      color: var(--muted-strong);
      cursor: pointer;
      opacity: 0.75;
      transition: color 200ms ease,
                  background 200ms ease,
                  border-color 200ms ease,
                  opacity 200ms ease,
                  transform 220ms var(--ease-bounce);
    }

    .sidebar-collapse-btn:hover {
      opacity: 1;
      color: var(--accent);
      border-color: var(--accent);
      background: var(--bg-elev);
      transform: scale(1.08) translateX(-2px);
    }

    /* COLLAPSED STATE */
    /* Only width / min-width / opacity change here — all three are in the transition list.
       (max-width:0 and padding:0 used to snap on the same frame the fold started.) */
    html[data-sidebar-collapsed="true"] .glass-nav {
      width: 0 !important;
      min-width: 0 !important;
      border-right-color: transparent !important;
      opacity: 0 !important;
      pointer-events: none !important;
      overflow: hidden !important;
    }

    /* While the column is animating in either direction the panel must not spill over the page */
    html[data-sidebar-folding="true"] .glass-nav {
      overflow: hidden !important;
    }

    html[data-sidebar-collapsed="true"] .glass-nav-inner {
      opacity: 0;
    }

    html[data-sidebar-collapsed="true"] .site-shell {
      gap: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      width: 100% !important;
    }

    /* Centered reading column: explicit symmetric margins do the centering, so the move animates */
    html[data-sidebar-collapsed="true"] .site-shell > main.container-wide,
    html[data-sidebar-collapsed="true"] main.container-wide,
    html[data-sidebar-collapsed="true"] .container-wide {
      max-width: 78rem !important;
      margin-left: max(3rem, calc((100% - 78rem) / 2)) !important;
      margin-right: max(3rem, calc((100% - 78rem) / 2)) !important;
      padding-left: clamp(1.5rem, 3.5vw, 3rem) !important;
      padding-right: clamp(1.5rem, 3.5vw, 3rem) !important;
    }

    html[data-sidebar-collapsed="true"] .site-shell > main.container-medium,
    html[data-sidebar-collapsed="true"] main.container-medium,
    html[data-sidebar-collapsed="true"] .container-medium {
      max-width: 56rem !important;
      margin-left: max(3rem, calc((100% - 56rem) / 2)) !important;
      margin-right: max(3rem, calc((100% - 56rem) / 2)) !important;
      padding-left: clamp(1.5rem, 3.5vw, 3rem) !important;
      padding-right: clamp(1.5rem, 3.5vw, 3rem) !important;
    }

    /* Floating retro pixel expand button */
    html[data-sidebar-collapsed="true"] .sidebar-expand-btn {
      display: inline-flex;
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      z-index: 99;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 0.95rem 0.45rem 0.75rem;
      border-radius: 6px;
      background: var(--glass-bg);
      backdrop-filter: blur(14px) saturate(120%);
      -webkit-backdrop-filter: blur(14px) saturate(120%);
      border: 1px solid var(--rule-strong);
      box-shadow:
        0 6px 24px rgba(0, 0, 0, 0.08),
        0 1px 3px rgba(0, 0, 0, 0.04),
