<script>
(function () {
  // ── Cursor & Ink Brush Trail (rAF-coalesced, offscreen-hibernated, calligraphy taper) ──
  let canvas, ctx;
  let customCursorEl = null;
  let points   = [];
  let strokeId = 0;
  let isDrawing = false;
  let cursorRafId = 0;
  let cursorDomDirty = false;
  let isMobile  = false;
  let cleanupFns = [];
  let hasPointerPosition = false;
  let lastFrameStamp = 0;

  const MAX_TRAIL_POINTS = 52;
  const mouse = { x: 0, y: 0 };
  const brush = {
    x: 0, y: 0, vx: 0, vy: 0,
    radius: 6, isPressed: false, isVisible: false,
    outerRadius: 6, isHoveringInteractive: false, isOverControl: false,
  };
  const springTension = 0.13;
  const springDamping  = 0.64;

  let cachedInkRgb = [26, 24, 20];
  function refreshInkRgb() {
    const theme = document.documentElement.getAttribute('data-theme') || 'light';
    cachedInkRgb =
      theme === 'dark' ? [255, 255, 255] :
      theme === 'moss' ? [255, 241, 244] :
      theme === 'rice' ? [43, 36, 28] : [26, 24, 20];
  }

  function updateCursorDOM() {
    cursorDomDirty = false;
    if (!customCursorEl) return;
    if (!brush.isVisible) {
      customCursorEl.classList.remove('is-visible');
      return;
    }
    customCursorEl.classList.add('is-visible');
    customCursorEl.style.transform = `translate3d(${mouse.x}px, ${mouse.y}px, 0)`;
    customCursorEl.classList.toggle('is-hovering', brush.isHoveringInteractive);
    customCursorEl.classList.toggle('is-pressed', brush.isPressed);
  }

  function scheduleCursorFrame() {
    if (document.hidden) return;
    if (!cursorRafId) {
      isDrawing = true;
      cursorRafId = requestAnimationFrame(updateAndDraw);
    }
  }

  // ── InkPoint ─────────────────────────────────────────────────────────────
  class InkPoint {
    constructor(x, y, radius, opacity = 0.85, speed = 0) {
      this.x = x; this.y = y;
      this.baseRadius = radius; this.radius = radius;
      this.opacity = opacity;
      this.currentOpacity = opacity;
      this.age = 0; this.maxAge = 42 + Math.random() * 14;
      this.speed = speed;
      this.nx = 0; this.ny = 0;
    }
    update(dtScale = 1) {
      this.age += dtScale;
      const p = Math.min(1, this.age / this.maxAge);
      this.radius = this.baseRadius * (1 + p * 0.22);
      this.currentOpacity = this.opacity * (1 - p);
    }
  }

  // ── Canvas resize ─────────────────────────────────────────────────────────
  function resize() {
    const dpr = 1; // 1x DPR 渲染水墨流体，减轻合成器带宽
    if (canvas && ctx) {
      canvas.style.width = window.innerWidth + 'px';
      canvas.style.height = window.innerHeight + 'px';
      canvas.width  = window.innerWidth  * dpr;
      canvas.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
  }

  // ── Coalesced rAF Frame: Cursor DOM + Ink Brush Simulation ────────────────
  function updateAndDraw(stamp) {
    cursorRafId = 0;
    if (document.hidden) {
      isDrawing = false;
      lastFrameStamp = 0;
      return;
    }

    if (cursorDomDirty) {
      updateCursorDOM();
    }

    if (!canvas || !ctx || !hasPointerPosition) {
      isDrawing = false;
      lastFrameStamp = 0;
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const trailDisabled = isCursorTrailDisabled() || reducedMotion;
    if (trailDisabled || (points.length === 0 && !brush.isVisible)) {
      if (points.length > 0) {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
        points = [];
      } else if (!brush.isVisible) {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
      isDrawing = false;
      lastFrameStamp = 0;
      return;
    }

    const now = typeof stamp === 'number' && stamp > 0 ? stamp : performance.now();
    const dtScale = lastFrameStamp > 0 ? Math.min(2.2, Math.max(0.35, (now - lastFrameStamp) / 16.6667)) : 1;
    lastFrameStamp = now;

    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);

    const [baseR, baseG, baseB] = cachedInkRgb;

    // Spring physics for ink flow
    const dx = mouse.x - brush.x;
    const dy = mouse.y - brush.y;
    brush.vx = (brush.vx + dx * springTension * dtScale) * Math.pow(springDamping, dtScale);
    brush.vy = (brush.vy + dy * springTension * dtScale) * Math.pow(springDamping, dtScale);
    brush.x += brush.vx * dtScale;
    brush.y += brush.vy * dtScale;

    const speed = Math.hypot(brush.vx, brush.vy);

    if (!trailDisabled && !brush.isOverControl) {
      if (brush.isVisible && speed > 0.15) {
        let targetR = Math.max(2.8, 10.5 - speed * 0.22);
        let opacity = 0.85;
        if (brush.isPressed) { targetR = Math.max(6.5, 20 - speed * 0.28); opacity = 0.94; }
        brush.radius = brush.radius * 0.82 + targetR * 0.18;
        if (points.length >= MAX_TRAIL_POINTS) points.shift();
        points.push(new InkPoint(brush.x, brush.y, brush.radius, opacity, speed));
      } else if (speed <= 0.15 && points.length > 0) {
        strokeId += 0.05;
      }
    } else if (trailDisabled) {
      points = [];
    }

    if (points.length > 0) {
      let writeIdx = 0;
      for (let i = 0; i < points.length; i++) {
        const pt = points[i];
        pt.update(dtScale);
        if (pt.age < pt.maxAge) {
          points[writeIdx++] = pt;
        }
      }
      points.length = writeIdx;
    }

    // ── Render Dual-Layer Calligraphy Trail (浓墨中锋 + 淡墨渗边) ──────────
    if (!trailDisabled && points.length >= 2) {
      const N = points.length;

      for (let i = 0; i < N; i++) {
        let ex, ey;
        if (i === 0)      { ex = points[1].x - points[0].x; ey = points[1].y - points[0].y; }
        else if (i===N-1) { ex = points[i].x - points[i-1].x; ey = points[i].y - points[i-1].y; }
        else              { ex = points[i+1].x - points[i-1].x; ey = points[i+1].y - points[i-1].y; }
        const len = Math.hypot(ex, ey) || 0.001;
        points[i].nx = -ey / len;
        points[i].ny =  ex / len;
      }

      const haloPath = new Path2D();
      const corePath = new Path2D();

      for (let i = 0; i < N; i++) {
        const p = points[i];
        const prog = i / (N - 1);
        const spindle = Math.sin(prog * Math.PI) * (0.45 + prog * 0.72);
        const coreThick = p.radius * Math.max(0.08, spindle * 0.86);
        const haloThick = coreThick * 1.38;
        const cxR = p.x + p.nx * coreThick, cyR = p.y + p.ny * coreThick;
        const hxR = p.x + p.nx * haloThick, hyR = p.y + p.ny * haloThick;
        if (i === 0) {
          corePath.moveTo(cxR, cyR);
          haloPath.moveTo(hxR, hyR);
        } else {
          corePath.lineTo(cxR, cyR);
          haloPath.lineTo(hxR, hyR);
        }
      }
      for (let i = N - 1; i >= 0; i--) {
        const p = points[i];
        const prog = i / (N - 1);
        const spindle = Math.sin(prog * Math.PI) * (0.45 + prog * 0.72);
        const coreThick = p.radius * Math.max(0.08, spindle * 0.86);
        const haloThick = coreThick * 1.38;
        corePath.lineTo(p.x - p.nx * coreThick, p.y - p.ny * coreThick);
        haloPath.lineTo(p.x - p.nx * haloThick, p.y - p.ny * haloThick);
      }
      corePath.closePath();
      haloPath.closePath();

      const head = points[N - 1];
      ctx.fillStyle = `rgba(${baseR},${baseG},${baseB},${(head.currentOpacity * 0.24).toFixed(3)})`;
      ctx.fill(haloPath);
      ctx.fillStyle = `rgba(${baseR},${baseG},${baseB},${(head.currentOpacity * 0.86).toFixed(3)})`;
      ctx.fill(corePath);
    }

    if (brush.isVisible && !brush.isOverControl && !customCursorEl) {
      ctx.beginPath();
      ctx.arc(mouse.x, mouse.y, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();

      ctx.beginPath();
      ctx.arc(mouse.x, mouse.y, brush.outerRadius, 0, Math.PI * 2);
      ctx.lineWidth   = 1.35;
      ctx.strokeStyle = '#ffffff';
      ctx.stroke();
    }

    const isStationary = points.length === 0 && (!brush.isVisible || speed <= 0.05);
    if (isStationary || points.length === 0) {
      if (points.length === 0 && !brush.isVisible) {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      } else if (points.length === 0) {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
      isDrawing = false;
      lastFrameStamp = 0;
    } else if (isDrawing) {
      cursorRafId = requestAnimationFrame(updateAndDraw);
    }
  }

  // ── Cursor Trail Preferences ─────────────────────────────────────────────
  function isCursorTrailDisabled() {
    return document.documentElement.getAttribute('data-cursor-trail') === 'disabled';
  }

  function syncToggleButtons() {
    const disabled = isCursorTrailDisabled();
    document.querySelectorAll('[data-cursor-trail-toggle]').forEach(btn => {
      btn.setAttribute('aria-label', disabled ? '开启指针拖尾' : '关闭指针拖尾');
      btn.setAttribute('title', disabled ? '开启指针拖尾' : '关闭指针拖尾');
      btn.setAttribute('aria-pressed', disabled ? 'false' : 'true');
    });
  }

  function clearCursorTrail() {
    points = [];
    isDrawing = false;
    lastFrameStamp = 0;
    if (cursorRafId) {
      cancelAnimationFrame(cursorRafId);
      cursorRafId = 0;
    }
    brush.isVisible = false;
    brush.isPressed = false;
    if (ctx && canvas) {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    }
    updateCursorDOM();
  }
  window.__clearCursorTrail = clearCursorTrail;

  function setCursorTrailDisabled(disabled) {
    if (disabled) {
      document.documentElement.setAttribute('data-cursor-trail', 'disabled');
      try { localStorage.setItem('cursor-trail', 'disabled'); } catch (e) {}
      points = [];
      if (ctx && canvas) {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
      isDrawing = false;
    } else {
      document.documentElement.removeAttribute('data-cursor-trail');
      try { localStorage.removeItem('cursor-trail'); } catch (e) {}
      if (!isDrawing && points.length > 0) {
        scheduleCursorFrame();
      }
    }
    syncToggleButtons();
  }
  window.__setCursorTrailDisabled = setCursorTrailDisabled;
  window.__isCursorTrailDisabled = isCursorTrailDisabled;

  // ── Init (called on every Astro page-load) ────────────────────────────────
  function init() {
    cleanupFns.forEach(fn => fn());
    cleanupFns = [];
    if (cursorRafId) {
      cancelAnimationFrame(cursorRafId);
      cursorRafId = 0;
    }
    isDrawing = false;
    lastFrameStamp = 0;
    points    = [];

    refreshInkRgb();
    syncToggleButtons();

    canvas = document.getElementById('inkCanvas');
    customCursorEl = document.getElementById('custom-cursor');
    const legacyCursorCanvas = document.getElementById('cursorCanvas');
    if (legacyCursorCanvas) {
      legacyCursorCanvas.remove();
    }
    if (!canvas) return;

    canvas.style.removeProperty('display');

    if (canvas.parentElement !== document.body) {
      document.body.appendChild(canvas);
    }
    canvas.style.zIndex = '2147483646';
    canvas.style.pointerEvents = 'none';

    if (customCursorEl) {
      if (customCursorEl.parentElement !== document.body) {
        document.body.appendChild(customCursorEl);
      }
      customCursorEl.style.zIndex = '2147483647';
      customCursorEl.style.pointerEvents = 'none';
    }

    ctx = canvas.getContext('2d');
    brush.isVisible = false;
    brush.isPressed = false;
    brush.isOverControl = false;
    brush.vx = brush.vy = 0;
    hasPointerPosition = false;

    const finePointerMedia = window.matchMedia('(pointer: fine)');
    let isFinePointer = finePointerMedia.matches;
    let lastCheckedTarget = null;
    let cachedNativeCursorTarget = false;
    let cachedInteractiveTarget = false;
    let cachedControlTarget = false;

    resize();

    function updateMouse(e) {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      if (!hasPointerPosition) {
        brush.x = mouse.x;
        brush.y = mouse.y;
        brush.vx = 0;
        brush.vy = 0;
        hasPointerPosition = true;
      }
    }

    function onResize() {
      isFinePointer = finePointerMedia.matches;
      isMobile = !isFinePointer;
      resize();
    }

    function isInteractive(el) {
      if (!el || typeof el.closest !== 'function') return false;
      if (el.closest(':disabled, [aria-disabled="true"]')) return false;
      return !!el.closest('a, button, select, summary, label, [role="button"], [role="option"], [role="menuitem"], .btn-primary, .btn-secondary, .tag-chip, .nav-link, .timeline-link, [data-search-trigger], [data-search-result], [data-post-preview], .gallery-mat-card, .life-card, .notes-card, .mm-card, .mm-node, .mm-seg-btn, .mm-cselect-trigger, .mm-cselect-opt, .mm-pill-btn, .mm-node-cdot, .mm-zoom-btn, .mm-zoom-text-btn, .mm-collapse-btn, .mm-card-action-btn, .mm-wb-chip-btn, .mm-wb-icon-btn, .mm-wb-primary-btn, .mm-export-item, .mermaid-viewport, .theme-toggle, .font-toggle, .cursor-trail-toggle, .zen-sound-toggle, .sidebar-collapse-btn');
    }

    function classifyTarget(t) {
      if (t === lastCheckedTarget) return;
      lastCheckedTarget = t;
      cachedNativeCursorTarget =
        t instanceof Element &&
        Boolean(
          t.closest(
            'input:not([type="button"]):not([type="submit"]):not([type="checkbox"]):not([type="radio"]), textarea, [contenteditable="true"], .search-input, #companion-splitter, .mm-split-resizer, .settings-viewport'
          )
        );
      if (cachedNativeCursorTarget) {
        cachedInteractiveTarget = false;
        cachedControlTarget = false;
        return;
      }
      cachedControlTarget = Boolean(t && typeof t.closest === 'function' && t.closest('[data-theme-toggle],[data-font-toggle]'));
      cachedInteractiveTarget = isInteractive(t);
    }

    function onPointerEnter(e) {
      isFinePointer = finePointerMedia.matches;
      isMobile = !isFinePointer;
      if (e.pointerType === 'touch' || isMobile || !window.matchMedia('(pointer: fine)').matches) return;
      brush.isVisible = true;
      updateMouse(e);
      brush.x = mouse.x; brush.y = mouse.y;
      brush.vx = brush.vy = 0;
      hasPointerPosition = true;
      strokeId++;
      cursorDomDirty = true;
      scheduleCursorFrame();
    }

    function onPointerLeave() {
      brush.isVisible = false;
      brush.isPressed = false;
      hasPointerPosition = false;
      lastCheckedTarget = null;
      updateCursorDOM();
      if (points.length > 0 && !isCursorTrailDisabled()) {
        scheduleCursorFrame();
      } else if (ctx && canvas && points.length === 0) {
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
    }

    function onPointerMove(e) {
      if (e.pointerType === 'touch' || isMobile || !isFinePointer) return;
      classifyTarget(e.target);
      if (cachedNativeCursorTarget) {
        if (brush.isVisible) {
          brush.isVisible = false;
          cursorDomDirty = true;
          scheduleCursorFrame();
        } else if (points.length > 0 && !isCursorTrailDisabled()) {
          scheduleCursorFrame();
        }
        return;
      }
      brush.isHoveringInteractive = cachedInteractiveTarget;
      brush.isOverControl = cachedControlTarget;
      updateMouse(e);
      brush.isVisible = true;
      cursorDomDirty = true;
      scheduleCursorFrame();
    }

    function onPointerDown(e) {
      if (e.pointerType === 'touch' || isMobile || !isFinePointer) return;
      const t = e.target;
      const isThemeOrFontToggle = t && typeof t.closest === 'function' && t.closest('[data-theme-toggle],[data-font-toggle]');
      if (e.button === 0) {
        updateMouse(e);
        brush.isPressed = true;
        brush.isVisible = !cachedNativeCursorTarget;
        brush.isOverControl = !!isThemeOrFontToggle;
        if (!isThemeOrFontToggle) {
          strokeId++;
        }
        cursorDomDirty = true;
        scheduleCursorFrame();
      }
    }

    function onPointerUp() {
      brush.isPressed = false;
      cursorDomDirty = true;
      scheduleCursorFrame();
    }

    function onVisibilityChange() {
      if (document.hidden) {
        clearCursorTrail();
      }
    }

    function onWindowBlur() {
      clearCursorTrail();
    }

    isMobile = !isFinePointer;

    window.addEventListener('resize',       onResize, { passive: true });
    window.addEventListener('pointerenter', onPointerEnter, { passive: true });
    window.addEventListener('pointerleave', onPointerLeave, { passive: true });
    window.addEventListener('pointermove',  onPointerMove, { passive: true });
    window.addEventListener('pointerdown',  onPointerDown, { passive: true });
    window.addEventListener('pointerup',    onPointerUp);
    window.addEventListener('blur',         onWindowBlur);
    window.addEventListener('theme-change', refreshInkRgb);
    document.addEventListener('visibilitychange', onVisibilityChange);

    cleanupFns.push(
      () => window.removeEventListener('resize',       onResize),
      () => window.removeEventListener('pointerenter', onPointerEnter),
      () => window.removeEventListener('pointerleave', onPointerLeave),
      () => window.removeEventListener('pointermove',  onPointerMove),
      () => window.removeEventListener('pointerdown',  onPointerDown),
      () => window.removeEventListener('pointerup',    onPointerUp),
      () => window.removeEventListener('blur',         onWindowBlur),
      () => window.removeEventListener('theme-change', refreshInkRgb),
      () => document.removeEventListener('visibilitychange', onVisibilityChange),
    );
  }

  document.addEventListener('astro:page-load', init);
  init();

  const toggleKey = '__cursorTrailToggleBound__';
  if (!window[toggleKey]) {
    document.addEventListener('click', (e) => {
      const target = e.target;
      const btn = target instanceof Element ? target.closest('[data-cursor-trail-toggle]') : null;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      setCursorTrailDisabled(!isCursorTrailDisabled());
    });
    window[toggleKey] = true;
  }

  document.addEventListener('astro:before-swap', () => {
    if (cursorRafId) {
      cancelAnimationFrame(cursorRafId);
      cursorRafId = 0;
    }
    if (typeof ctx !== 'undefined' && ctx) {
      ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
    }
    points = [];
    isDrawing = false;
    lastFrameStamp = 0;
  });
})();
</script>

<script>
import gsap from 'gsap';
import CustomEase from 'gsap/CustomEase';
import { readArticleMotion, cubicBezierPoints } from '../utils/articleMotion';
import { lockScrollAnchor } from '../utils/scrollAnchorLock';

gsap.registerPlugin(CustomEase);
CustomEase.create('sidebar-layout', cubicBezierPoints(readArticleMotion().layoutEase));

// The column and its contents share one restrained slide, with no hinge or overshoot.
(function setupSidebarController() {
  let folding = null;
  let releaseAnchor = null;

  function persist(collapsed) {
    try { localStorage.setItem('sidebar-collapsed', collapsed ? 'true' : 'false'); } catch (e) {}
  }

  function setCollapsed(inner, collapsed) {
    const interrupted = Boolean(folding);
    folding?.kill();
    releaseAnchor?.();
    const root = document.documentElement;
    const duration = readArticleMotion().panelMs;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    releaseAnchor = lockScrollAnchor(reduced ? 0 : duration + 80);
    root.setAttribute('data-sidebar-folding', 'true');
    if (!interrupted && !collapsed) gsap.set(inner, { x: -12, opacity: 0 });
    if (collapsed) root.setAttribute('data-sidebar-collapsed', 'true');
    else root.removeAttribute('data-sidebar-collapsed');
    persist(collapsed);
    const finish = () => {
      gsap.set(inner, { clearProps: 'transform,opacity' });
      root.removeAttribute('data-sidebar-folding');
      folding = null;
      releaseAnchor?.();
      releaseAnchor = null;
      window.dispatchEvent(new Event('resize'));
    };
    if (reduced) { finish(); return; }
    folding = gsap.to(inner, {
      x: collapsed ? -12 : 0, opacity: collapsed ? 0 : 1,
      duration: duration / 1000, ease: 'sidebar-layout', overwrite: 'auto',
      onComplete: finish,
    });
  }

  function setupSidebar() {
    const nav = document.querySelector('.glass-nav');
    const inner = nav?.querySelector('.glass-nav-inner');
    const collapseBtn = document.querySelector('[data-sidebar-collapse]');
    const expandBtn = document.querySelector('[data-sidebar-expand]');
    if (!nav || !inner) return;

    const resetScroll = () => {
      if (nav.scrollTop !== 0) nav.scrollTop = 0;
    };
    resetScroll();

    if (nav.dataset.sidebarBound === 'true') return;
    nav.dataset.sidebarBound = 'true';

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        resetScroll();
        requestAnimationFrame(resetScroll);
      });
    });

    collapseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setCollapsed(inner, true);
    });

    expandBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setCollapsed(inner, false);
    });
  }

  document.addEventListener('astro:page-load', setupSidebar);
  document.addEventListener('astro:before-swap', () => {
    folding?.kill();
    folding = null;
    releaseAnchor?.();
    releaseAnchor = null;
    document.documentElement.removeAttribute('data-sidebar-folding');
  });
  setupSidebar();
})();
</script>

<script>
import gsap from 'gsap';

(function setupNavMagneticGliderController() {
  function initGlider() {
    const nav = document.querySelector<HTMLElement>('[data-nav-links]');
    const glider = nav?.querySelector<HTMLElement>('[data-nav-glider]');
    if (!nav || !glider) return;

    const items = Array.from(nav.querySelectorAll<HTMLElement>('[data-nav-link]'));
    if (items.length === 0) return;

    const desktopQuery = window.matchMedia('(min-width: 1024px)');
    const reducedQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const isDesktop = () => desktopQuery.matches;
    const isReduced = () => reducedQuery.matches;

    interface CachedItemMetric {
      centerX: number;
      centerY: number;
      gliderTop: number;
    }

    const metricMap = new WeakMap<HTMLElement, CachedItemMetric>();
    let metricsDirty = true;
    let lastGliderY = 0;
    let stretchTimer = 0;

    // 批量预缓存导航项几何坐标，彻底消除 pointermove 内 getBoundingClientRect 强制同步回流
    function refreshMetrics() {
      if (!isDesktop()) return;
      const navRect = nav!.getBoundingClientRect();
      const gliderH = glider!.offsetHeight || 18;
      items.forEach((item) => {
        const rect = item.getBoundingClientRect();
        const curX = (gsap.getProperty(item, 'x') as number) || 0;
        const curY = (gsap.getProperty(item, 'y') as number) || 0;
        const originLeft = rect.left - curX;
        const originTop = rect.top - curY;
        metricMap.set(item, {
          centerX: originLeft + rect.width / 2,
          centerY: originTop + rect.height / 2,
          gliderTop: (originTop - navRect.top) + (rect.height - gliderH) / 2,
        });
      });
      metricsDirty = false;
    }

    function getActiveItem() {
      return nav!.querySelector<HTMLElement>('.nav-link.is-active');
    }

    function positionGlider(target: HTMLElement, immediate = false) {
      if (!isDesktop()) {
        glider!.style.opacity = '0';
        return;
      }
      if (metricsDirty) refreshMetrics();
      const metric = metricMap.get(target);
      const targetTop = metric ? metric.gliderTop : 0;
      const travel = Math.abs(targetTop - lastGliderY);
      lastGliderY = targetTop;

      if (immediate || isReduced()) {
        glider!.style.transition = 'none';
        glider!.style.transform = `translate3d(0, ${targetTop}px, 0) scaleY(1)`;
        glider!.style.opacity = '1';
        requestAnimationFrame(() => {
          if (glider) glider.style.transition = '';
        });
      } else {
        // 毛笔行锋微拉伸：跨越多行时笔毫微伸展并回敛，模拟湿墨运笔手感
        const stretch = travel > 28 ? Math.min(1.32, 1 + travel * 0.0022) : 1;
        glider!.style.opacity = '1';
        glider!.style.transform = `translate3d(0, ${targetTop}px, 0) scaleY(${stretch.toFixed(3)})`;
        window.clearTimeout(stretchTimer);
        if (stretch > 1.01) {
          stretchTimer = window.setTimeout(() => {
            if (glider) glider.style.transform = `translate3d(0, ${targetTop}px, 0) scaleY(1)`;
          }, 185);
        }
      }
    }

    function resetToActive() {
      const active = getActiveItem();
      if (active) {
        positionGlider(active);
      } else {
        glider!.style.opacity = '0';
      }

      if (!isDesktop() || isReduced()) {
        items.forEach((item) => gsap.set(item, { clearProps: 'x,y' }));
        return;
      }

      items.forEach((item) => {
        const isActive = item.classList.contains('is-active');
        gsap.to(item, {
          x: isActive ? 4 : 0,
          y: 0,
          duration: 0.85,
          ease: 'elastic.out(1, 0.45)',
          overwrite: 'auto',
        });
      });
    }

    // Expose sync helper for layout transitions
    (window as any).__syncNavMagneticGlider = () => {
      metricsDirty = true;
      const active = getActiveItem();
      if (active) {
        positionGlider(active, true);
        if (isDesktop() && !isReduced()) {
          gsap.set(active, { x: 4, y: 0 });
        }
      } else {
        glider!.style.opacity = '0';
      }
    };

    const initialActive = getActiveItem();
    if (initialActive) {
      requestAnimationFrame(() => {
        metricsDirty = true;
        positionGlider(initialActive, true);
        if (isDesktop() && !isReduced()) {
          gsap.set(initialActive, { x: 4, y: 0 });
        }
      });
    } else {
      glider.style.opacity = '0';
    }

    items.forEach((item) => {
      if ((item as any).__gliderBound) return;
      (item as any).__gliderBound = true;

      let moveRaf = 0;
      let pendingClientX = 0;
      let pendingClientY = 0;

      item.addEventListener('pointerenter', () => {
        if (metricsDirty) refreshMetrics();
        positionGlider(item);
        if (!isDesktop() || isReduced()) return;
        gsap.to(item, {
          x: 8,
          y: 0,
          duration: 0.28,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      });

      item.addEventListener('pointermove', (e) => {
        if (!isDesktop() || isReduced()) return;
        pendingClientX = e.clientX;
        pendingClientY = e.clientY;
        if (moveRaf) return;
        moveRaf = requestAnimationFrame(() => {
          moveRaf = 0;
          const metric = metricMap.get(item);
          if (!metric) return;
          const relX = (pendingClientX - metric.centerX) * 0.22;
          const relY = (pendingClientY - metric.centerY) * 0.22;
          const clampedRelX = Math.max(-4, Math.min(4, relX));
          const clampedRelY = Math.max(-3, Math.min(3, relY));

          gsap.to(item, {
            x: 8 + clampedRelX,
            y: clampedRelY,
            duration: 0.26,
            ease: 'power2.out',
            overwrite: 'auto',
          });
        });
      });

      item.addEventListener('pointerleave', () => {
        if (moveRaf) {
          cancelAnimationFrame(moveRaf);
          moveRaf = 0;
        }
        if (!isDesktop() || isReduced()) return;
        const isActive = item.classList.contains('is-active');
        gsap.to(item, {
          x: isActive ? 4 : 0,
          y: 0,
          duration: 0.85,
          ease: 'elastic.out(1, 0.45)',
          overwrite: 'auto',
        });
      });

      item.addEventListener('focus', () => {
        if (metricsDirty) refreshMetrics();
        positionGlider(item);
        if (isDesktop() && !isReduced()) {
          gsap.to(item, { x: 8, y: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
        }
      });

      item.addEventListener('blur', () => {
        if (isDesktop() && !isReduced()) {
          const isActive = item.classList.contains('is-active');
          gsap.to(item, { x: isActive ? 4 : 0, y: 0, duration: 0.85, ease: 'elastic.out(1, 0.45)', overwrite: 'auto' });
        }
      });

      item.addEventListener('click', () => {
        const metric = metricMap.get(item);
        if (metric) {
          (window as any).__inkSplash?.(metric.centerX - 18, metric.centerY, 6);
        }
      });
    });

    if ((nav as any).__navGliderCleanup) {
      (nav as any).__navGliderCleanup();
    }
    const sidebarHost = nav.closest('.glass-nav');
    const onNavLeave = () => resetToActive();
    const onWinResize = () => {
      metricsDirty = true;
      resetToActive();
    };
    const onNavScroll = () => {
      metricsDirty = true;
    };
    nav.addEventListener('pointerleave', onNavLeave);
    window.addEventListener('resize', onWinResize, { passive: true });
    sidebarHost?.addEventListener('scroll', onNavScroll, { passive: true });
    (nav as any).__navGliderCleanup = () => {
      window.clearTimeout(stretchTimer);
      nav.removeEventListener('pointerleave', onNavLeave);
      window.removeEventListener('resize', onWinResize);
      sidebarHost?.removeEventListener('scroll', onNavScroll);
    };
  }

  document.addEventListener('astro:page-load', initGlider);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlider);
  } else {
    initGlider();
  }
})();
</script>

<script>
(function setupMobileDrawerController() {
  const CLEANUP_KEY = '__areSetMobileDrawerCleanup__';

  function setupDrawer() {
    (window as any)[CLEANUP_KEY]?.();
    const toggleBtn = document.querySelector<HTMLElement>('[data-mobile-menu-toggle]');
    const closeBtn = document.querySelector<HTMLElement>('[data-mobile-drawer-close]');
    const overlay = document.querySelector<HTMLElement>('[data-mobile-drawer-overlay]');
    const panel = document.querySelector<HTMLElement>('[data-mobile-drawer-panel]');
    if (!panel || !toggleBtn) return;

    const controller = new AbortController();
    const { signal } = controller;
    let swipeRaf = 0;

    function openDrawer() {
      panel!.style.removeProperty('transform');
      panel!.style.removeProperty('transition');
      document.documentElement.classList.add('mobile-menu-open');
      document.body.classList.add('mobile-menu-open');
      panel!.classList.add('is-open');
      panel!.setAttribute('aria-hidden', 'false');
      toggleBtn!.classList.add('is-active');
      toggleBtn!.setAttribute('aria-expanded', 'true');
      overlay?.classList.add('is-open');
      overlay?.setAttribute('aria-hidden', 'false');
    }

    function closeDrawer() {
      panel!.style.removeProperty('transform');
      panel!.style.removeProperty('transition');
      document.documentElement.classList.remove('mobile-menu-open');
      document.body.classList.remove('mobile-menu-open');
      panel!.classList.remove('is-open');
      panel!.setAttribute('aria-hidden', 'true');
      toggleBtn!.classList.remove('is-active');
      toggleBtn!.setAttribute('aria-expanded', 'false');
      overlay?.classList.remove('is-open');
      overlay?.setAttribute('aria-hidden', 'true');
    }

    function toggle() {
      if (panel!.classList.contains('is-open')) {
        closeDrawer();
      } else {
        openDrawer();
      }
    }

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    }, { signal });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeDrawer();
    }, { signal });

    overlay?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeDrawer();
    }, { signal });

    panel.querySelectorAll('[data-mobile-nav-link]').forEach((link) => {
      link.addEventListener('click', () => {
        closeDrawer();
      }, { signal });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('is-open')) {
        closeDrawer();
      }
    }, { signal });

    // Touch gesture: interactive GPU translate3d swipe-right to dismiss
    let touchStartX = 0;
    let touchStartY = 0;
    let isHorizontalSwipe = false;

    panel.addEventListener('touchstart', (e) => {
      touchStartX = 0;
      touchStartY = 0;
      isHorizontalSwipe = false;
      if (e.touches && e.touches.length > 0) {
        if (e.touches[0].clientX < 30) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }
    }, { passive: true, signal });

    panel.addEventListener('touchmove', (e) => {
      if (!touchStartX || !panel.classList.contains('is-open')) return;
      if (!e.touches || e.touches.length === 0) return;
      const dx = e.touches[0].clientX - touchStartX;
      const dy = e.touches[0].clientY - touchStartY;
      if (!isHorizontalSwipe) {
        if (Math.abs(dy) > Math.abs(dx)) {
          touchStartX = 0;
          return;
        }
        if (dx > 10) isHorizontalSwipe = true;
      }
      if (isHorizontalSwipe && dx > 0) {
        const clampedX = Math.round(dx * 0.92);
        if (!swipeRaf) {
          swipeRaf = requestAnimationFrame(() => {
            swipeRaf = 0;
            panel.style.transition = 'none';
            panel.style.transform = `translate3d(${clampedX}px, 0, 0)`;
          });
        }
      }
    }, { passive: true, signal });

    panel.addEventListener('touchend', (e) => {
      if (swipeRaf) {
        cancelAnimationFrame(swipeRaf);
        swipeRaf = 0;
      }
      if (!touchStartX) return;
      if (e.changedTouches && e.changedTouches.length > 0) {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        if (deltaX > 48 && deltaX > Math.abs(deltaY) * 1.2) {
          closeDrawer();
        } else if (isHorizontalSwipe) {
          panel.style.removeProperty('transition');
          panel.style.removeProperty('transform');
        }
      }
      touchStartX = 0;
      touchStartY = 0;
      isHorizontalSwipe = false;
    }, { passive: true, signal });

    (window as any)[CLEANUP_KEY] = () => {
      if (swipeRaf) cancelAnimationFrame(swipeRaf);
      controller.abort();
    };
  }

  document.addEventListener('astro:before-swap', () => {
    (window as any)[CLEANUP_KEY]?.();
    document.documentElement.classList.remove('mobile-menu-open');
    document.body.classList.remove('mobile-menu-open');
    const panel = document.querySelector<HTMLElement>('[data-mobile-drawer-panel]');
    const toggleBtn = document.querySelector('[data-mobile-menu-toggle]');
    const overlay = document.querySelector('[data-mobile-drawer-overlay]');
    panel?.style.removeProperty('transform');
    panel?.style.removeProperty('transition');
    panel?.classList.remove('is-open');
    panel?.setAttribute('aria-hidden', 'true');
    toggleBtn?.classList.remove('is-active');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    overlay?.classList.remove('is-open');
    overlay?.setAttribute('aria-hidden', 'true');
  });

  document.addEventListener('astro:page-load', setupDrawer);
  setupDrawer();
})();
</script>

