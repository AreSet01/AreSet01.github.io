---
const navItems = [
  { label: 'Home', labelZh: 'Main*', href: '/' },
  { label: 'Archive', labelZh: 'All Doc', href: '/archive' },
  { label: 'Notes', labelZh: 'Notes', href: '/notes' },
  { label: 'MindMap', labelZh: 'MindMap', href: '/mindmap' },
  { label: 'Life', labelZh: 'Life', href: '/life' },
  { label: 'Gallery', labelZh: 'Gallery', href: '/gallery' },
  { label: 'Timeline', labelZh: 'Timeline', href: '/timeline' },
  { label: 'Tags', labelZh: 'Tags', href: '/tags' },
  { label: 'Stats', labelZh: 'Stats', href: '/stats' },
  { label: 'About', labelZh: 'About Me', href: '/about' },
  { label: 'Account', labelZh: 'Account', href: '/account' },
];

const normalizePath = (path: string) =>
  path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;

const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const year = new Date().getFullYear();
---

<header class="glass-nav" data-enter="left" data-enter-once>
  <div class="glass-nav-inner min-h-full flex flex-col justify-between">
    <div class="nav-top-block flex flex-col gap-4 lg:gap-6 w-full">
      <div class="flex items-center justify-between w-full mobile-top-bar">
        <a href="/" class="brand-mark">
          <span>梦付千秋</span>
        </a>
        <button
          class="sidebar-collapse-btn hidden lg:inline-flex"
          type="button"
          data-sidebar-collapse
          aria-label="收起侧边栏"
          title="收起侧边栏"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="11 17 6 12 11 7"></polyline>
            <polyline points="18 17 13 12 18 7"></polyline>
          </svg>
        </button>

        <!-- 移动端顶部精炼操作群 (仅在 < 1024px 显示) -->
        <div class="mobile-actions-cluster flex items-center gap-2 lg:hidden">
          <button
            class="mobile-search-btn"
            type="button"
            data-search-trigger
            aria-label="打开搜索"
            title="搜索 (⌘K)"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <button
            class="zen-sound-toggle mobile-zen-btn"
            type="button"
            aria-label="打开白噪音伴读"
            title="墨池听雨 · 伴读音景"
            aria-haspopup="dialog"
            aria-controls="zen-sound-capsule"
            aria-expanded="false"
            data-zen-sound-toggle
          >
            <span class="zen-toggle-inner">
              <svg class="icon-zen-sound" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
              </svg>
              <span class="zen-toggle-ripple" aria-hidden="true"></span>
              <span class="zen-toggle-dot" aria-hidden="true"></span>
            </span>
          </button>
          <button
            class="mobile-menu-toggle"
            type="button"
            aria-label="打开导航菜单"
            aria-expanded="false"
            aria-controls="mobile-drawer-panel"
