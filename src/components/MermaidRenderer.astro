---
// MermaidRenderer.astro
// Dynamically renders .mermaid-block elements with full theme support,
// copy, source toggle, and full-screen preview.
---

<!-- Modal for full-screen diagram expansion -->
<div class="mermaid-modal-overlay" id="mermaid-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" data-lenis-prevent>
  <div class="mermaid-modal-backdrop" data-mermaid-modal-close></div>
  <div class="mermaid-modal-shell panel" data-lenis-prevent>
    <div class="mermaid-modal-header">
      <div class="mermaid-modal-title">
        <svg class="mermaid-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="6" height="6" rx="1"></rect>
          <rect x="15" y="15" width="6" height="6" rx="1"></rect>
          <path d="M6 9v3a3 3 0 0 0 3 3h6"></path>
        </svg>
        <span id="mermaid-modal-label">Mermaid 预览</span>
      </div>
      <div class="mermaid-modal-actions">
        <div class="mermaid-zoom-group">
          <button type="button" class="mermaid-action-btn" id="mermaid-modal-zoom-out" aria-label="缩小" title="缩小 (−)">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
          <button type="button" class="mermaid-action-btn" id="mermaid-modal-zoom-reset" aria-label="重置" title="重置缩放 (100%)">
            <span id="mermaid-modal-zoom-val" class="mermaid-zoom-val">100%</span>
          </button>
          <button type="button" class="mermaid-action-btn" id="mermaid-modal-zoom-in" aria-label="放大" title="放大 (+)">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
        </div>
        <button type="button" class="mermaid-modal-close" data-mermaid-modal-close aria-label="关闭预览" title="关闭 (Esc)">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <div class="mermaid-modal-body" id="mermaid-modal-content" data-lenis-prevent>
      <div class="mermaid-modal-canvas" id="mermaid-modal-canvas"></div>
    </div>
  </div>
</div>

<script>
  let renderCounter = 0;
  let activeSessionId = 0;
  let globalDelegationBound = false;
  let modalBound = false;

  // Modal elements & state
  let modalScale = 1.0;
  let modalTranslateX = 0;
  let modalTranslateY = 0;

  function updateModalTransform() {
    const modalCanvas = document.getElementById('mermaid-modal-canvas');
    const modalZoomVal = document.getElementById('mermaid-modal-zoom-val');
    if (!modalCanvas) return;
    modalCanvas.style.transform = `translate(${modalTranslateX}px, ${modalTranslateY}px) scale(${modalScale})`;
    if (modalZoomVal) {
      modalZoomVal.textContent = `${Math.round(modalScale * 100)}%`;
    }
  }

  function openModal(title: string, svgContent: string) {
    const modal = document.getElementById('mermaid-modal');
    const modalCanvas = document.getElementById('mermaid-modal-canvas');
    const modalLabel = document.getElementById('mermaid-modal-label');
    if (!modal || !modalCanvas) return;

    if (modalLabel) modalLabel.textContent = title || 'Mermaid 架构预览';
    modalScale = 1.0;
    modalTranslateX = 0;
    modalTranslateY = 0;
    modalCanvas.innerHTML = svgContent;
    updateModalTransform();

    const modalSvg = modalCanvas.querySelector<SVGSVGElement>('svg');
    if (modalSvg) {
      modalSvg.style.maxWidth = 'min(86vw, 1120px)';
      modalSvg.style.width = '100%';
      modalSvg.style.height = 'auto';
      modalSvg.style.opacity = '1';
      modalSvg.style.transform = 'none';
      modalSvg.style.transition = 'none';
      modalSvg.querySelectorAll<SVGElement>('*').forEach((el) => {
        el.style.opacity = '1';
        el.style.strokeDashoffset = '0';
        el.style.transition = 'none';
      });
    }
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('mermaid-modal-open');
    if ((window as any).lenis) {
      (window as any).lenis.stop();
    }
  }

  function closeModal() {
    const modal = document.getElementById('mermaid-modal');
    const modalCanvas = document.getElementById('mermaid-modal-canvas');
    if (!modal || !modalCanvas) return;
    modal.hidden = true;
    modal.setAttribute('aria-hidden', 'true');
    modalCanvas.innerHTML = '';
    modalScale = 1.0;
    modalTranslateX = 0;
    modalTranslateY = 0;
    updateModalTransform();
    document.body.classList.remove('mermaid-modal-open');
    if ((window as any).lenis) {
      (window as any).lenis.start();
    }
  }

  function ensureModalBound() {
    if (modalBound) return;
    const modal = document.getElementById('mermaid-modal');
    if (!modal) return;
    modalBound = true;

    const modalContent = document.getElementById('mermaid-modal-content');
    const modalZoomIn = document.getElementById('mermaid-modal-zoom-in');
    const modalZoomOut = document.getElementById('mermaid-modal-zoom-out');
    const modalZoomReset = document.getElementById('mermaid-modal-zoom-reset');

    modal.addEventListener('wheel', (e) => {
      e.preventDefault();
      e.stopPropagation();
    }, { passive: false });

    modal.querySelectorAll('[data-mermaid-modal-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) {
        closeModal();
      }
    });

    modalZoomIn?.addEventListener('click', () => {
      modalScale = Math.min(5.0, Math.round((modalScale + 0.25) * 100) / 100);
      updateModalTransform();
    });

    modalZoomOut?.addEventListener('click', () => {
      modalScale = Math.max(0.4, Math.round((modalScale - 0.25) * 100) / 100);
      updateModalTransform();
    });

    modalZoomReset?.addEventListener('click', () => {
      modalScale = 1.0;
      modalTranslateX = 0;
      modalTranslateY = 0;
      updateModalTransform();
    });

    if (modalContent) {
      let isModalDragging = false;
      let modalDragStartX = 0;
      let modalDragStartY = 0;

      modalContent.addEventListener('pointerdown', (e) => {
        isModalDragging = true;
        modalDragStartX = e.clientX - modalTranslateX;
        modalDragStartY = e.clientY - modalTranslateY;
        modalContent.classList.add('is-dragging');
      });

      window.addEventListener('pointermove', (e) => {
        if (!isModalDragging) return;
        modalTranslateX = e.clientX - modalDragStartX;
        modalTranslateY = e.clientY - modalDragStartY;
        updateModalTransform();
      });

      window.addEventListener('pointerup', () => {
        if (isModalDragging) {
          isModalDragging = false;
          modalContent.classList.remove('is-dragging');
        }
      });

      modalContent.addEventListener('wheel', (e) => {
        e.preventDefault();
        e.stopPropagation();
        (e as any).stopImmediatePropagation?.();
        const step = e.deltaY < 0 ? 0.12 : -0.12;
        modalScale = Math.min(5.0, Math.max(0.4, Math.round((modalScale + step) * 100) / 100));
        updateModalTransform();
      }, { passive: false });
    }
  }

  // ---------- 全局事件委托（坚不可摧，永远不会丢失监听） ----------

  function ensureGlobalDelegation() {
    if (globalDelegationBound) return;
    globalDelegationBound = true;

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // 1. 复制 Mermaid 代码
      const copyBtn = target.closest<HTMLElement>('.mermaid-btn-copy');
      if (copyBtn) {
        const block = copyBtn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;
        const encoded = block.dataset.mermaidCode || '';
        const rawCode = decodeURIComponent(encoded);
        if (!rawCode) return;
        try {
          await navigator.clipboard.writeText(rawCode);
          const span = copyBtn.querySelector('span') || copyBtn;
          const original = span.textContent;
          span.textContent = 'Copied!';
          setTimeout(() => { span.textContent = original; }, 1500);
        } catch {}
        return;
      }

      // 2. 切换源码/图表视图
      const sourceBtn = target.closest<HTMLElement>('.mermaid-btn-source');
      if (sourceBtn) {
        const block = sourceBtn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;
        const sourceEl = block.querySelector<HTMLElement>('.mermaid-source');
        const stageEl = block.querySelector<HTMLElement>('.mermaid-stage');
        if (!sourceEl || !stageEl) return;
        const isShowingSource = !sourceEl.hidden;
        if (isShowingSource) {
          sourceEl.hidden = true;
          stageEl.hidden = false;
          sourceBtn.classList.remove('is-active');
          const span = sourceBtn.querySelector('span') || sourceBtn;
          span.textContent = 'Code';
        } else {
          sourceEl.hidden = false;
          stageEl.hidden = true;
          sourceBtn.classList.add('is-active');
          const span = sourceBtn.querySelector('span') || sourceBtn;
          span.textContent = 'Diagram';
        }
        return;
      }

      // 3. 全屏放大预览
      const expandBtn = target.closest<HTMLElement>('.mermaid-btn-expand');
      if (expandBtn) {
        const block = expandBtn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;
        const renderEl = block.querySelector<HTMLElement>('.mermaid-render');
        const titleText = block.getAttribute('data-title') ? decodeURIComponent(block.getAttribute('data-title') || '') : '';
        if (renderEl) {
          openModal(titleText, renderEl.innerHTML);
        }
        return;
      }

  function setBlockZoom(block: HTMLElement, zoom: number) {
    const renderEl = block.querySelector<HTMLElement>('.mermaid-render');
    const stageEl = block.querySelector<HTMLElement>('.mermaid-stage');
    const zoomVal = block.querySelector<HTMLElement>('.mermaid-zoom-val');
    if (!renderEl) return;

    const clamped = Math.min(5.0, Math.max(0.4, Math.round(zoom * 100) / 100));
    block.dataset.currentZoom = `${clamped}`;
    if (zoomVal) zoomVal.textContent = `${Math.round(clamped * 100)}%`;
    renderEl.style.transform = clamped === 1.0 ? '' : `scale(${clamped})`;
    if (clamped > 1.0) {
      stageEl?.classList.add('is-zoomed');
    } else {
      stageEl?.classList.remove('is-zoomed');
      if (stageEl) {
        stageEl.scrollLeft = 0;
        stageEl.scrollTop = 0;
      }
    }
  }

      // 4. 局部缩放（放大、缩小、复位）
      const zoomInBtn = target.closest<HTMLElement>('.mermaid-btn-zoom-in');
      const zoomOutBtn = target.closest<HTMLElement>('.mermaid-btn-zoom-out');
      const zoomResetBtn = target.closest<HTMLElement>('.mermaid-btn-zoom-reset');
      if (zoomInBtn || zoomOutBtn || zoomResetBtn) {
        const btn = (zoomInBtn || zoomOutBtn || zoomResetBtn)!;
        const block = btn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;

        let currentZoom = parseFloat(block.dataset.currentZoom || '1.0') || 1.0;
        if (zoomInBtn) {
          currentZoom += 0.2;
        } else if (zoomOutBtn) {
          currentZoom -= 0.2;
        } else if (zoomResetBtn) {
          currentZoom = 1.0;
        }

        setBlockZoom(block, currentZoom);
        return;
      }
    });

    // 局部缩放后的拖拽平移、双指缩放与双击重置（指针事件统一升级）
    let isStageDragging = false;
    let activeStageEl: HTMLElement | null = null;
    let stageStartX = 0;
    let stageStartY = 0;
    let stageScrollLeft = 0;
    let stageScrollTop = 0;
    const activePointers = new Map<number, { x: number; y: number }>();
    let initialPinchDistance = 0;
    let initialPinchZoom = 1.0;
    let lastTapTime = 0;
    let lastTapStage: HTMLElement | null = null;

    document.addEventListener('pointerdown', (e) => {
      const target = e.target as HTMLElement | null;
      const stage = target?.closest<HTMLElement>('.mermaid-stage');
      if (!stage) return;
      const block = stage.closest<HTMLElement>('.mermaid-block');
      if (!block) return;

      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      // 双击/双触快速复位 (Double tap to reset zoom)
      const now = Date.now();
      if (lastTapStage === stage && now - lastTapTime < 320) {
        setBlockZoom(block, 1.0);
        lastTapTime = 0;
        lastTapStage = null;
        activePointers.clear();
        if (activeStageEl) {
          try { activeStageEl.releasePointerCapture(e.pointerId); } catch {}
          activeStageEl.classList.remove('is-dragging');
          isStageDragging = false;
          activeStageEl = null;
        }
        return;
      }
      lastTapTime = now;
      lastTapStage = stage;
      activeStageEl = stage;

      // 双指捏合缩放初始判定 (Pinch-to-zoom)
      if (activePointers.size === 2) {
        const pts = Array.from(activePointers.values());
        initialPinchDistance = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        initialPinchZoom = parseFloat(block.dataset.currentZoom || '1.0') || 1.0;
        if (isStageDragging && activeStageEl) {
          try { activeStageEl.releasePointerCapture(e.pointerId); } catch {}
          activeStageEl.classList.remove('is-dragging');
        }
        isStageDragging = false;
        return;
      }

      const currentZoom = parseFloat(block.dataset.currentZoom || '1.0') || 1.0;
      if (currentZoom <= 1.0) return;

      isStageDragging = true;
      stage.classList.add('is-dragging');
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {}
      stageStartX = e.clientX;
      stageStartY = e.clientY;
      stageScrollLeft = stage.scrollLeft;
      stageScrollTop = stage.scrollTop;
    });

    document.addEventListener('pointermove', (e) => {
      if (!activePointers.has(e.pointerId)) return;
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      // 双指手势 Pinch-to-zoom 运算
      if (activePointers.size === 2 && activeStageEl) {
        const block = activeStageEl.closest<HTMLElement>('.mermaid-block');
        if (!block) return;
        const pts = Array.from(activePointers.values());
        const curDist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        if (initialPinchDistance > 10) {
          const ratio = curDist / initialPinchDistance;
          setBlockZoom(block, initialPinchZoom * ratio);
        }
        return;
      }

      if (!isStageDragging || !activeStageEl) return;
      const dx = e.clientX - stageStartX;
      const dy = e.clientY - stageStartY;
      activeStageEl.scrollLeft = stageScrollLeft - dx;
      activeStageEl.scrollTop = stageScrollTop - dy;
    });

    const stopStageInteraction = (e: PointerEvent) => {
      activePointers.delete(e.pointerId);
      if (activePointers.size < 2) {
        initialPinchDistance = 0;
      }
      if (activePointers.size === 0) {
        if (activeStageEl) {
          if (isStageDragging) {
            try {
              activeStageEl.releasePointerCapture(e.pointerId);
            } catch {}
            activeStageEl.classList.remove('is-dragging');
          }
          activeStageEl = null;
        }
        isStageDragging = false;
      }
    };

    document.addEventListener('pointerup', stopStageInteraction);
    document.addEventListener('pointercancel', stopStageInteraction);
  }

  // ---------- 渲染等待与动画 ----------

  const ENTRANCE_SETTLE_MS = 1100;
  const NEAR_VIEWPORT_PX = 1500;

  function waitForQuietMoment(blocks: NodeListOf<HTMLElement>): Promise<void> {
    const afterEntrance = new Promise<void>((resolve) => {
      if ((window as any).__postTransitionPending) {
        window.addEventListener('post-transition-release', () => window.setTimeout(resolve, ENTRANCE_SETTLE_MS), { once: true });
      } else {
        window.setTimeout(resolve, ENTRANCE_SETTLE_MS);
      }
    });

    const scrolledClose = new Promise<void>((resolve) => {
      if (!('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          io.disconnect();
          resolve();
        }
      }, { rootMargin: `${NEAR_VIEWPORT_PX}px 0px ${NEAR_VIEWPORT_PX}px 0px` });
      blocks.forEach((block) => io.observe(block));
    });

    return Promise.race([afterEntrance, scrolledClose]);
  }

  function getMermaidTheme(themeName: string) {
    if (themeName === 'dark') return 'dark';
    if (themeName === 'moss') return 'forest';
    if (themeName === 'rice') return 'neutral';
    return 'default';
  }

  function getCurrentTheme() {
    return document.documentElement.getAttribute('data-theme') || 'light';
  }

  function animateMermaidSvg(renderEl: HTMLElement) {
    const svg = renderEl.querySelector<SVGSVGElement>('svg');
    if (!svg) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      svg.style.opacity = '1';
      return;
    }

    svg.style.opacity = '0';
    svg.style.transform = 'translateY(10px) scale(0.98)';
    svg.style.transition = 'opacity 500ms cubic-bezier(0.16, 1, 0.3, 1), transform 550ms cubic-bezier(0.16, 1, 0.3, 1)';

    const nodes = Array.from(svg.querySelectorAll<SVGElement>('.node, .actor, .note, g.cluster, .label, .actor-man'));
    nodes.forEach((node, i) => {
      node.style.opacity = '0';
      node.style.transition = `opacity 350ms cubic-bezier(0.16, 1, 0.3, 1) ${30 + i * 20}ms`;
    });

    const lines = Array.from(svg.querySelectorAll<SVGElement>('.edgePath path, .messageLine0, .messageLine1, line, .flowchart-link'));
    lines.forEach((line, i) => {
      const len = (line as any).getTotalLength ? (line as any).getTotalLength() : 0;
      if (len > 0) {
        line.style.strokeDasharray = `${len}`;
        line.style.strokeDashoffset = `${len}`;
        line.style.opacity = '0';
        line.style.transition = `stroke-dashoffset 550ms cubic-bezier(0.16, 1, 0.3, 1) ${60 + i * 25}ms, opacity 250ms ease ${60 + i * 25}ms`;
      } else {
        line.style.opacity = '0';
        line.style.transition = `opacity 350ms ease ${60 + i * 25}ms`;
      }
    });

    const showAll = () => {
      svg.style.opacity = '1';
      svg.style.transform = 'translateY(0) scale(1)';
      nodes.forEach((node) => { node.style.opacity = '1'; });
      lines.forEach((line) => { line.style.strokeDashoffset = '0'; line.style.opacity = '1'; });
    };

    const cleanup = () => {
      svg.style.opacity = '';
      svg.style.transform = '';
      svg.style.transition = '';
      nodes.forEach((node) => {
        node.style.transition = '';
        node.style.opacity = '';
      });
      lines.forEach((line) => {
        line.style.transition = '';
        line.style.opacity = '';
        line.style.strokeDasharray = '';
        line.style.strokeDashoffset = '';
      });
    };

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        showAll();
        window.setTimeout(cleanup, 1200);
      });
    });

    window.setTimeout(() => {
      showAll();
      cleanup();
    }, 1400);
  }

  // ---------- 核心初始化与渲染管线 ----------

  async function initMermaid() {
    const blocks = document.querySelectorAll<HTMLElement>('.mermaid-block');
    if (!blocks.length) return;

    // 1. 确保全局交互事件委托与全屏 Modal 监听已注册（即使渲染还未完成，按钮点击也绝不会失效）
    ensureGlobalDelegation();
    ensureModalBound();

    // 2. 渲染会话管理（防重入竞争）
    const sessionId = ++activeSessionId;

    await waitForQuietMoment(blocks);
    if (sessionId !== activeSessionId || !blocks[0].isConnected) return;

    const { default: mermaid } = await import('mermaid');
    if (sessionId !== activeSessionId) return;

    const themeName = getCurrentTheme();
    const isDark = themeName === 'dark';
    const isMoss = themeName === 'moss';
    const isRice = themeName === 'rice';
    const mTheme = getMermaidTheme(themeName);

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: mTheme,
      fontFamily: 'var(--font-mono, ui-monospace, monospace)',
      themeVariables: {
        darkMode: isDark,
        background: 'transparent',
        fontFamily: 'var(--font-mono, ui-monospace, monospace)',
        primaryColor: isDark ? '#1a1f26' : isMoss ? '#EAF4EC' : isRice ? '#EBE0CB' : '#f4f5f7',
        primaryTextColor: isDark ? '#e2e8f0' : isMoss ? '#1F3A24' : isRice ? '#2B241C' : '#1e293b',
        primaryBorderColor: isDark ? 'rgba(255, 255, 255, 0.16)' : isMoss ? 'rgba(31, 58, 36, 0.25)' : isRice ? 'rgba(92, 76, 55, 0.3)' : 'rgba(0, 0, 0, 0.18)',
        lineColor: isDark ? '#94a3b8' : isMoss ? '#43764E' : isRice ? '#7D6B52' : '#64748b',
        secondaryColor: isDark ? '#111827' : isMoss ? '#D7EBDC' : isRice ? '#E2D5BC' : '#e2e8f0',
        tertiaryColor: isDark ? '#1f2937' : isMoss ? '#C3E0CB' : isRice ? '#D7C7A9' : '#cbd5e1',
      },
    });

    for (let i = 0; i < blocks.length; i++) {
      if (sessionId !== activeSessionId) return;
      const block = blocks[i];
      const encoded = block.dataset.mermaidCode || '';
      const rawCode = decodeURIComponent(encoded);
      if (!rawCode) continue;

      const renderEl = block.querySelector<HTMLElement>('.mermaid-render');
      const loadingEl = block.querySelector<HTMLElement>('.mermaid-loading');
      const sourceEl = block.querySelector<HTMLElement>('.mermaid-source');
      const stageEl = block.querySelector<HTMLElement>('.mermaid-stage');

      if (!renderEl) continue;

      try {
        const uniqueId = `mermaid-graph-${++renderCounter}`;
        const { svg, bindFunctions } = await mermaid.render(uniqueId, rawCode);
        if (sessionId !== activeSessionId) return;

        renderEl.innerHTML = svg;
        renderEl.dataset.rendered = 'true';
        if (typeof bindFunctions === 'function') {
          try { bindFunctions(renderEl); } catch (e) {}
        }
        if (loadingEl) loadingEl.remove();

        const svgEl = renderEl.querySelector<SVGSVGElement>('svg');
        if (svgEl && stageEl) {
          const naturalWidth = svgEl.viewBox?.baseVal?.width || parseFloat(svgEl.getAttribute('width') || '0') || 0;
          if (naturalWidth > 640 && stageEl.clientWidth > 0 && naturalWidth > stageEl.clientWidth - 40) {
            stageEl.dataset.scrollable = 'true';
          } else {
            delete stageEl.dataset.scrollable;
          }
        }

        animateMermaidSvg(renderEl);
      } catch (error: any) {
        console.error('[Mermaid Render Error]:', error);
        if (loadingEl) loadingEl.remove();
        renderEl.innerHTML = `
          <div class="mermaid-error">
            <div class="mermaid-error-head">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Mermaid 语法解析失败</span>
            </div>
            <p class="mermaid-error-msg">${error?.message || '图表语法有误，请点击上方 Code 查看源码并修正'}</p>
          </div>
        `;
        if (sourceEl) sourceEl.hidden = false;
      }
    }
  }

  // ---------- 生命周期注册 ----------

  // 1. Astro View Transitions 统一入口（每次页面载入/切页均会派发）
  document.addEventListener('astro:page-load', () => {
    initMermaid();
  });

  // 2. 首次非 SPA 运行环境或脚本晚于 page-load 执行的兜底
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initMermaid();
  }

  // 3. 主题切换时重新渲染
  window.addEventListener('theme-change', () => {
    initMermaid();
  });

  // 4. 页面即将切换时清理 Modal 状态
  document.addEventListener('astro:before-swap', () => {
    activeSessionId++;
    closeModal();
  });
</script>
