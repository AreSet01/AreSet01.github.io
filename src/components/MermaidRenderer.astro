---
// MermaidRenderer.astro
// Dynamically renders .mermaid-block elements with full theme support,
// copy, source toggle, and full-screen preview.
---

<!-- Modal for full-screen diagram expansion -->
<div class="mermaid-modal-overlay" id="mermaid-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" data-lenis-prevent>
  <div class="mermaid-modal-backdrop" data-mermaid-modal-close></div>
  <div class="mermaid-modal-shell panel" data-lenis-prevent>
    <div class="mermaid-modal-header">
      <div class="mermaid-modal-title">
        <svg class="mermaid-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="6" height="6" rx="1"></rect>
          <rect x="15" y="15" width="6" height="6" rx="1"></rect>
          <path d="M6 9v3a3 3 0 0 0 3 3h6"></path>
        </svg>
        <span id="mermaid-modal-label">Mermaid 预览</span>
      </div>
      <div class="mermaid-modal-actions">
        <div class="mermaid-zoom-group">
          <button type="button" class="mermaid-action-btn" id="mermaid-modal-zoom-out" aria-label="缩小" title="缩小 (−)">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
          <button type="button" class="mermaid-action-btn" id="mermaid-modal-zoom-reset" aria-label="重置" title="重置缩放 (100%)">
            <span id="mermaid-modal-zoom-val" class="mermaid-zoom-val">100%</span>
          </button>
          <button type="button" class="mermaid-action-btn" id="mermaid-modal-zoom-in" aria-label="放大" title="放大 (+)">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
        </div>
        <button type="button" class="mermaid-modal-close" data-mermaid-modal-close aria-label="关闭预览" title="关闭 (Esc)">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
    <div class="mermaid-modal-body" id="mermaid-modal-content" data-lenis-prevent>
      <div class="mermaid-modal-canvas" id="mermaid-modal-canvas"></div>
    </div>
  </div>
</div>

<script>
  import { waitForPostEntrance } from '../utils/postEntranceGate';

  let renderCounter = 0;
  let activeSessionId = 0;
  let renderController: AbortController | null = null;
  let globalDelegationBound = false;
  let boundModal: HTMLElement | null = null;
  let modalController: AbortController | null = null;

  // Modal elements & state
  let modalScale = 1.0;
  let modalTranslateX = 0;
  let modalTranslateY = 0;
  let modalInertiaRaf = 0;
  let stageInertiaRaf = 0;
  let modalPanRaf = 0;
  let stagePanRaf = 0;
  const copyTimers = new Set<number>();
  let resetStageInteractionState: (() => void) | null = null;

  function cancelModalInertia() {
    if (modalPanRaf) {
      cancelAnimationFrame(modalPanRaf);
      modalPanRaf = 0;
    }
    if (modalInertiaRaf) {
      cancelAnimationFrame(modalInertiaRaf);
      modalInertiaRaf = 0;
    }
  }

  function cancelStageInertia() {
    if (stagePanRaf) {
      cancelAnimationFrame(stagePanRaf);
      stagePanRaf = 0;
    }
    if (stageInertiaRaf) {
      cancelAnimationFrame(stageInertiaRaf);
      stageInertiaRaf = 0;
    }
    document.querySelectorAll('.mermaid-stage.is-inertia').forEach((el) => el.classList.remove('is-inertia'));
  }

  function updateModalTransform() {
    const modalCanvas = document.getElementById('mermaid-modal-canvas');
    const modalZoomVal = document.getElementById('mermaid-modal-zoom-val');
    if (!modalCanvas) return;
    modalCanvas.style.transform = `translate(${modalTranslateX}px, ${modalTranslateY}px) scale(${modalScale})`;
    if (modalZoomVal) {
      modalZoomVal.textContent = `${Math.round(modalScale * 100)}%`;
    }
  }

  function openModal(title: string, svgContent: string) {
    cancelModalInertia();
    ensureModalBound();
    const modal = document.getElementById('mermaid-modal');
    const modalCanvas = document.getElementById('mermaid-modal-canvas');
    const modalLabel = document.getElementById('mermaid-modal-label');
    if (!modal || !modalCanvas) return;

    if (modalLabel) modalLabel.textContent = title || 'Mermaid 架构预览';
    modalScale = 1.0;
    modalTranslateX = 0;
    modalTranslateY = 0;
    modalCanvas.innerHTML = svgContent;
    updateModalTransform();

    const modalSvg = modalCanvas.querySelector<SVGSVGElement>('svg');
    if (modalSvg) {
      modalSvg.style.maxWidth = 'min(86vw, 1120px)';
      modalSvg.style.width = '100%';
      modalSvg.style.height = 'auto';
      modalSvg.style.opacity = '1';
      modalSvg.style.transform = 'none';
      modalSvg.style.transition = 'none';
      modalSvg.querySelectorAll<SVGElement>('*').forEach((el) => {
        el.style.opacity = '1';
        el.style.strokeDashoffset = '0';
        el.style.transition = 'none';
      });
    }
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('mermaid-modal-open');
    if ((window as any).lenis) {
      (window as any).lenis.stop();
    }
  }

  function closeModal() {
    cancelModalInertia();
    const modal = document.getElementById('mermaid-modal');
    const modalCanvas = document.getElementById('mermaid-modal-canvas');
    if (!modal || !modalCanvas) return;
    modal.hidden = true;
    modal.setAttribute('aria-hidden', 'true');
    modalCanvas.innerHTML = '';
    modalScale = 1.0;
    modalTranslateX = 0;
    modalTranslateY = 0;
    updateModalTransform();
    document.body.classList.remove('mermaid-modal-open');
    if ((window as any).lenis) {
      (window as any).lenis.start();
    }
  }

  function ensureModalBound() {
    const modal = document.getElementById('mermaid-modal');
    if (modal === boundModal) return;
    modalController?.abort();
    modalController = null;
    boundModal = modal;
    if (!modal) return;
    modalController = new AbortController();
    const { signal } = modalController;

    const modalContent = document.getElementById('mermaid-modal-content');
    const modalZoomIn = document.getElementById('mermaid-modal-zoom-in');
    const modalZoomOut = document.getElementById('mermaid-modal-zoom-out');
    const modalZoomReset = document.getElementById('mermaid-modal-zoom-reset');

    modal.addEventListener('wheel', (e) => {
      e.preventDefault();
      e.stopPropagation();
    }, { passive: false, signal });

    modal.querySelectorAll('[data-mermaid-modal-close]').forEach((el) => {
      el.addEventListener('click', closeModal, { signal });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) {
        closeModal();
      }
    }, { signal });

    modalZoomIn?.addEventListener('click', () => {
      cancelModalInertia();
      modalScale = Math.min(5.0, Math.round((modalScale + 0.25) * 100) / 100);
      updateModalTransform();
    }, { signal });

    modalZoomOut?.addEventListener('click', () => {
      cancelModalInertia();
      modalScale = Math.max(0.4, Math.round((modalScale - 0.25) * 100) / 100);
      updateModalTransform();
    }, { signal });

    modalZoomReset?.addEventListener('click', () => {
      cancelModalInertia();
      modalScale = 1.0;
      modalTranslateX = 0;
      modalTranslateY = 0;
      updateModalTransform();
    }, { signal });

    if (modalContent) {
      let isModalDragging = false;
      let hasPendingModalPan = false;
      let modalDragStartX = 0;
      let modalDragStartY = 0;
      let modalLastX = 0;
      let modalLastY = 0;
      let modalLastT = 0;
      let modalVx = 0;
      let modalVy = 0;
      let modalMoveSamples = 0;

      modalContent.addEventListener('pointerdown', (e) => {
        cancelModalInertia();
        hasPendingModalPan = false;
        isModalDragging = true;
        modalDragStartX = e.clientX - modalTranslateX;
        modalDragStartY = e.clientY - modalTranslateY;
        modalLastX = e.clientX;
        modalLastY = e.clientY;
        modalLastT = performance.now();
        modalVx = 0;
        modalVy = 0;
        modalMoveSamples = 0;
        modalContent.classList.add('is-dragging');
      }, { signal });

      window.addEventListener('pointermove', (e) => {
        if (!isModalDragging || modal.hidden) return;
        const now = performance.now();
        const dt = now - modalLastT;
        if (dt > 0) {
          modalVx = ((e.clientX - modalLastX) / dt) * 16;
          modalVy = ((e.clientY - modalLastY) / dt) * 16;
        }
        modalLastX = e.clientX;
        modalLastY = e.clientY;
        modalLastT = now;
        modalMoveSamples += 1;
        modalTranslateX = e.clientX - modalDragStartX;
        modalTranslateY = e.clientY - modalDragStartY;
        hasPendingModalPan = true;
        if (!modalPanRaf) {
          modalPanRaf = requestAnimationFrame(() => {
            modalPanRaf = 0;
            if (!hasPendingModalPan || modal.hidden || signal.aborted) return;
            hasPendingModalPan = false;
            updateModalTransform();
          });
        }
      }, { signal });

      const stopDragging = () => {
        if (isModalDragging) {
          isModalDragging = false;
          if (modalPanRaf) {
            cancelAnimationFrame(modalPanRaf);
            modalPanRaf = 0;
          }
          if (hasPendingModalPan && !modal.hidden && !signal.aborted) {
            hasPendingModalPan = false;
            updateModalTransform();
          }
          modalContent.classList.remove('is-dragging');
          const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
          const speed = Math.hypot(modalVx, modalVy);
          if (!reduce && !modal.hidden && modalMoveSamples >= 2 && performance.now() - modalLastT < 60 && speed > 1.2) {
            const stepModalInertia = () => {
              modalInertiaRaf = 0;
              if (modal.hidden || signal.aborted) return;
              modalVx *= 0.9;
              modalVy *= 0.9;
              if (Math.hypot(modalVx, modalVy) < 0.35) {
                modalTranslateX = Math.round(modalTranslateX);
                modalTranslateY = Math.round(modalTranslateY);
                updateModalTransform();
                return;
              }
              modalTranslateX = Math.round((modalTranslateX + modalVx) * 10) / 10;
              modalTranslateY = Math.round((modalTranslateY + modalVy) * 10) / 10;
              updateModalTransform();
              modalInertiaRaf = requestAnimationFrame(stepModalInertia);
            };
            modalInertiaRaf = requestAnimationFrame(stepModalInertia);
          }
        }
      };
      window.addEventListener('pointerup', stopDragging, { signal });
      window.addEventListener('pointercancel', stopDragging, { signal });

      modalContent.addEventListener('wheel', (e) => {
        cancelModalInertia();
        e.preventDefault();
        e.stopPropagation();
        (e as any).stopImmediatePropagation?.();
        const step = e.deltaY < 0 ? 0.12 : -0.12;
        modalScale = Math.min(5.0, Math.max(0.4, Math.round((modalScale + step) * 100) / 100));
        updateModalTransform();
      }, { passive: false, signal });
    }
  }

  // ---------- 全局事件委托（坚不可摧，永远不会丢失监听） ----------

  function applyBlockTransform(block: HTMLElement) {
    const renderEl = block.querySelector<HTMLElement>('.mermaid-render');
    if (!renderEl) return;
    const zoom = parseFloat(block.dataset.currentZoom || '1.0') || 1.0;
    const panX = parseFloat(block.dataset.panX || '0') || 0;
    const panY = parseFloat(block.dataset.panY || '0') || 0;
    if (zoom === 1.0 && panX === 0 && panY === 0) {
      renderEl.style.transform = '';
    } else {
      renderEl.style.transform = `translate3d(${Math.round(panX)}px, ${Math.round(panY)}px, 0) scale(${zoom})`;
    }
  }

  function setBlockZoom(block: HTMLElement, zoom: number, resetPan = false) {
    cancelStageInertia();
    const renderEl = block.querySelector<HTMLElement>('.mermaid-render');
    const stageEl = block.querySelector<HTMLElement>('.mermaid-stage');
    const zoomVal = block.querySelector<HTMLElement>('.mermaid-zoom-val');
    if (!renderEl) return;

    const clamped = Math.min(5.0, Math.max(0.4, Math.round(zoom * 100) / 100));
    block.dataset.currentZoom = `${clamped}`;
    if (zoomVal) zoomVal.textContent = `${Math.round(clamped * 100)}%`;
    if (clamped === 1.0 || resetPan) {
      block.dataset.panX = '0';
      block.dataset.panY = '0';
    }
    applyBlockTransform(block);
    if (clamped > 1.0) {
      stageEl?.classList.add('is-zoomed');
    } else {
      stageEl?.classList.remove('is-zoomed');
      if (stageEl && (clamped === 1.0 || resetPan)) {
        stageEl.scrollLeft = 0;
        stageEl.scrollTop = 0;
      }
    }
  }

  /**
   * 自动修正 Mermaid SVG 的 foreignObject 与 viewBox 边界：
   * 解决 stateDiagram-v2 / flowchart 中长中文标签超出 foreignObject 或 SVG viewBox 导致右侧/上下文字被一刀切的问题。
   */
  function fixMermaidSvgBounds(svgEl: SVGSVGElement) {
    try {
      if (svgEl.dataset.boundsFixed === 'true') return;
      svgEl.style.overflow = 'visible';
      const foreignObjects = svgEl.querySelectorAll<SVGForeignObjectElement>('foreignObject');
      foreignObjects.forEach((fo) => {
        fo.style.overflow = 'visible';
        const inner = fo.firstElementChild as HTMLElement | null;
        if (!inner) return;
        inner.style.overflow = 'visible';
        const isEdgeLabel = Boolean(fo.closest('.edgeLabel, .transition, .note'));
        if (isEdgeLabel) {
          inner.style.whiteSpace = 'nowrap';
          inner.style.width = 'max-content';
          inner.style.maxWidth = 'none';
        }
        const foW = parseFloat(fo.getAttribute('width') || '0') || 0;
        const foH = parseFloat(fo.getAttribute('height') || '0') || 0;
        const reqW = Math.ceil(Math.max(inner.scrollWidth || 0, inner.offsetWidth || 0));
        const reqH = Math.ceil(Math.max(inner.scrollHeight || 0, inner.offsetHeight || 0));
        if (reqW > foW && reqW > 0) {
          fo.setAttribute('width', String(reqW + 8));
        }
        if (reqH > foH && reqH > 0) {
          fo.setAttribute('height', String(reqH + 4));
        }
      });

      const vb = svgEl.viewBox?.baseVal;
      const vbX = vb && vb.width > 0 ? vb.x : 0;
      const vbY = vb && vb.height > 0 ? vb.y : 0;
      const vbW = vb && vb.width > 0 ? vb.width : (parseFloat(svgEl.getAttribute('width') || '0') || 600);
      const vbH = vb && vb.height > 0 ? vb.height : (parseFloat(svgEl.getAttribute('height') || '0') || 400);

      const bbox = svgEl.getBBox();
      let minX = Math.min(vbX, bbox.x);
      let minY = Math.min(vbY, bbox.y);
      let maxX = Math.max(vbX + vbW, bbox.x + bbox.width);
      let maxY = Math.max(vbY + vbH, bbox.y + bbox.height);

      // 补充检测 DOM 级 foreignObject / text 的真实屏幕矩形，以初始固定 viewBox (vbX, vbY, vbW, vbH) 为基准换算回 SVG 坐标系
      const svgRect = svgEl.getBoundingClientRect();
      if (svgRect.width > 0 && svgRect.height > 0) {
        const scaleX = vbW / svgRect.width;
        const scaleY = vbH / svgRect.height;
        svgEl.querySelectorAll<Element>('foreignObject, text, .edgeLabel, .node, .stateGroup, .cluster').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.width <= 0 || r.height <= 0) return;
          const relLeft = vbX + (r.left - svgRect.left) * scaleX;
          const relRight = vbX + (r.right - svgRect.left) * scaleX;
          const relTop = vbY + (r.top - svgRect.top) * scaleY;
          const relBottom = vbY + (r.bottom - svgRect.top) * scaleY;
          if (relLeft < minX) minX = relLeft;
          if (relRight > maxX) maxX = relRight;
          if (relTop < minY) minY = relTop;
          if (relBottom > maxY) maxY = relBottom;
        });
      }

      const pad = 16;
      const finalX = Math.floor(minX - pad);
      const finalY = Math.floor(minY - pad);
      const finalW = Math.max(120, Math.ceil(maxX - minX + pad * 2));
      const finalH = Math.max(80, Math.ceil(maxY - minY + pad * 2));

      svgEl.setAttribute('viewBox', `${finalX} ${finalY} ${finalW} ${finalH}`);
      svgEl.style.maxWidth = `${finalW}px`;
      svgEl.dataset.naturalWidth = String(finalW);
      svgEl.dataset.naturalHeight = String(finalH);
      svgEl.dataset.boundsFixed = 'true';
    } catch {}
  }
  (window as any).__fixMermaidSvgBounds = fixMermaidSvgBounds;

  function ensureGlobalDelegation() {
    if (globalDelegationBound || (window as any).__areSetMermaidDelegationBound__) return;
    globalDelegationBound = true;
    (window as any).__areSetMermaidDelegationBound__ = true;

    document.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // 1. 复制 Mermaid 代码（细线对勾 SVG + 已复制 + 单色水墨微澜）
      const copyBtn = target.closest<HTMLElement>('.mermaid-btn-copy');
      if (copyBtn) {
        const block = copyBtn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;
        const encoded = block.dataset.mermaidCode || '';
        const rawCode = decodeURIComponent(encoded);
        if (!rawCode) return;
        try {
          await navigator.clipboard.writeText(rawCode);
          const CHECK_SVG = '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          if (!copyBtn.dataset.originalHtml) {
            copyBtn.dataset.originalHtml = copyBtn.innerHTML;
          }
          const prevTimer = Number(copyBtn.dataset.copyTimer || 0);
          if (prevTimer) {
            window.clearTimeout(prevTimer);
            copyTimers.delete(prevTimer);
          }
          copyBtn.classList.remove('is-copied');
          void copyBtn.offsetWidth;
          copyBtn.classList.add('is-copied');
          copyBtn.innerHTML = `${CHECK_SVG}<span>已复制</span>`;
          const copyTimer = window.setTimeout(() => {
            copyTimers.delete(copyTimer);
            delete copyBtn.dataset.copyTimer;
            copyBtn.classList.remove('is-copied');
            if (copyBtn.dataset.originalHtml) {
              copyBtn.innerHTML = copyBtn.dataset.originalHtml;
            }
          }, 1500);
          copyBtn.dataset.copyTimer = String(copyTimer);
          copyTimers.add(copyTimer);
        } catch {}
        return;
      }

      // 2. 切换源码/图表视图
      const sourceBtn = target.closest<HTMLElement>('.mermaid-btn-source');
      if (sourceBtn) {
        const block = sourceBtn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;
        const sourceEl = block.querySelector<HTMLElement>('.mermaid-source');
        const stageEl = block.querySelector<HTMLElement>('.mermaid-stage');
        if (!sourceEl || !stageEl) return;
        const isShowingSource = sourceEl.style.display !== 'none' && !sourceEl.hidden;
        if (isShowingSource) {
          sourceEl.hidden = true;
          sourceEl.style.display = 'none';
          stageEl.hidden = false;
          stageEl.style.display = '';
          sourceBtn.classList.remove('is-active');
          const span = sourceBtn.querySelector('span') || sourceBtn;
          span.textContent = 'Code';
        } else {
          sourceEl.hidden = false;
          sourceEl.style.display = 'block';
          stageEl.hidden = true;
          stageEl.style.display = 'none';
          sourceBtn.classList.add('is-active');
          const span = sourceBtn.querySelector('span') || sourceBtn;
          span.textContent = 'Diagram';
        }
        return;
      }

      // 3. 全屏放大预览
      const expandBtn = target.closest<HTMLElement>('.mermaid-btn-expand');
      if (expandBtn) {
        const block = expandBtn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;
        const renderEl = block.querySelector<HTMLElement>('.mermaid-render');
        const titleText = block.getAttribute('data-title') ? decodeURIComponent(block.getAttribute('data-title') || '') : '';
        if (renderEl) {
          openModal(titleText, renderEl.innerHTML);
        }
        return;
      }

      // 4. 局部缩放（放大、缩小、复位）
      const zoomInBtn = target.closest<HTMLElement>('.mermaid-btn-zoom-in');
      const zoomOutBtn = target.closest<HTMLElement>('.mermaid-btn-zoom-out');
      const zoomResetBtn = target.closest<HTMLElement>('.mermaid-btn-zoom-reset');
      if (zoomInBtn || zoomOutBtn || zoomResetBtn) {
        const btn = (zoomInBtn || zoomOutBtn || zoomResetBtn)!;
        const block = btn.closest<HTMLElement>('.mermaid-block');
        if (!block) return;

        let currentZoom = parseFloat(block.dataset.currentZoom || '1.0') || 1.0;
        if (zoomInBtn) {
          currentZoom += 0.2;
        } else if (zoomOutBtn) {
          currentZoom -= 0.2;
        } else if (zoomResetBtn) {
          currentZoom = 1.0;
        }

        setBlockZoom(block, currentZoom, Boolean(zoomResetBtn));
        return;
      }
    });

    // 卡片内任意缩放比例（含默认 100%）直接按住拖拽漫游、单帧 rAF 合帧、丝滑阻尼惯性、双指缩放与双击复位
    let isStageDragging = false;
    let activeStageEl: HTMLElement | null = null;
    let stageStartX = 0;
    let stageStartY = 0;
    let stageScrollLeft = 0;
    let stageScrollTop = 0;
    let stageMaxScrollLeft = 0;
    let stageMaxScrollTop = 0;
    let stageStartPanX = 0;
    let stageStartPanY = 0;
    let stageLastX = 0;
    let stageLastY = 0;
    let stageLastT = 0;
    let stageVx = 0;
    let stageVy = 0;
    let stageMoveSamples = 0;
    let hasPendingStagePan = false;
    let pendingStageDx = 0;
    let pendingStageDy = 0;
    let pendingPinchRatio: number | null = null;
    const activePointers = new Map<number, { x: number; y: number }>();
    let initialPinchDistance = 0;
    let initialPinchZoom = 1.0;
    let lastTapTime = 0;
    let lastTapStage: HTMLElement | null = null;

    const flushStagePan = () => {
      stagePanRaf = 0;
      if (!activeStageEl) {
        hasPendingStagePan = false;
        pendingPinchRatio = null;
        return;
      }
      const block = activeStageEl.closest<HTMLElement>('.mermaid-block');
      if (!block) {
        hasPendingStagePan = false;
        pendingPinchRatio = null;
        return;
      }
      if (pendingPinchRatio !== null) {
        const ratio = pendingPinchRatio;
        pendingPinchRatio = null;
        setBlockZoom(block, initialPinchZoom * ratio);
        return;
      }
      if (!hasPendingStagePan) return;
      hasPendingStagePan = false;

      const dx = pendingStageDx;
      const dy = pendingStageDy;

      const nextScrollLeft = Math.max(0, Math.min(stageMaxScrollLeft, stageScrollLeft - dx));
      const consumedX = stageScrollLeft - nextScrollLeft;
      activeStageEl.scrollLeft = nextScrollLeft;
      block.dataset.panX = `${stageStartPanX + (dx - consumedX)}`;

      const nextScrollTop = Math.max(0, Math.min(stageMaxScrollTop, stageScrollTop - dy));
      const consumedY = stageScrollTop - nextScrollTop;
      activeStageEl.scrollTop = nextScrollTop;
      block.dataset.panY = `${stageStartPanY + (dy - consumedY)}`;

      applyBlockTransform(block);
    };

    resetStageInteractionState = () => {
      if (stagePanRaf) {
        cancelAnimationFrame(stagePanRaf);
        stagePanRaf = 0;
      }
      hasPendingStagePan = false;
      pendingPinchRatio = null;
      isStageDragging = false;
      initialPinchDistance = 0;
      activePointers.clear();
      if (activeStageEl) {
        activeStageEl.classList.remove('is-dragging');
        activeStageEl = null;
      }
    };

    document.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 && e.pointerType === 'mouse') return;
      const target = e.target as HTMLElement | null;
      const stage = target?.closest<HTMLElement>('.mermaid-stage');
      if (!stage) return;
      const block = stage.closest<HTMLElement>('.mermaid-block');
      if (!block) return;

      cancelStageInertia();
      hasPendingStagePan = false;
      pendingPinchRatio = null;
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      // 双击/双触快速复位 (Double tap to reset zoom & pan)
      const now = Date.now();
      if (lastTapStage === stage && now - lastTapTime < 320) {
        setBlockZoom(block, 1.0);
        lastTapTime = 0;
        lastTapStage = null;
        activePointers.clear();
        if (activeStageEl) {
          try { activeStageEl.releasePointerCapture(e.pointerId); } catch {}
          activeStageEl.classList.remove('is-dragging');
          isStageDragging = false;
          activeStageEl = null;
        }
        return;
      }
      lastTapTime = now;
      lastTapStage = stage;
      activeStageEl = stage;

      // 双指捏合缩放初始判定 (Pinch-to-zoom)
      if (activePointers.size === 2) {
        const pts = Array.from(activePointers.values());
        initialPinchDistance = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        initialPinchZoom = parseFloat(block.dataset.currentZoom || '1.0') || 1.0;
        if (isStageDragging && activeStageEl) {
          try { activeStageEl.releasePointerCapture(e.pointerId); } catch {}
          activeStageEl.classList.remove('is-dragging');
        }
        isStageDragging = false;
        return;
      }

      isStageDragging = true;
      stage.classList.add('is-dragging');
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {}
      stageStartX = e.clientX;
      stageStartY = e.clientY;
      stageLastX = e.clientX;
      stageLastY = e.clientY;
      stageLastT = performance.now();
      stageVx = 0;
      stageVy = 0;
      stageMoveSamples = 0;
      stageScrollLeft = stage.scrollLeft;
      stageScrollTop = stage.scrollTop;
      stageMaxScrollLeft = Math.max(0, stage.scrollWidth - stage.clientWidth);
      stageMaxScrollTop = Math.max(0, stage.scrollHeight - stage.clientHeight);
      stageStartPanX = parseFloat(block.dataset.panX || '0') || 0;
      stageStartPanY = parseFloat(block.dataset.panY || '0') || 0;
    });

    document.addEventListener('pointermove', (e) => {
      if (!activePointers.has(e.pointerId)) return;
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      // 双指手势 Pinch-to-zoom 运算（合并至单帧 rAF）
      if (activePointers.size === 2 && activeStageEl) {
        const pts = Array.from(activePointers.values());
        const curDist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        if (initialPinchDistance > 10) {
          const ratio = curDist / initialPinchDistance;
          pendingPinchRatio = ratio;
          if (!stagePanRaf) stagePanRaf = requestAnimationFrame(flushStagePan);
        }
        return;
      }

      if (!isStageDragging || !activeStageEl) return;
      const now = performance.now();
      const dt = now - stageLastT;
      if (dt > 0) {
        stageVx = ((e.clientX - stageLastX) / dt) * 16;
        stageVy = ((e.clientY - stageLastY) / dt) * 16;
      }
      stageLastX = e.clientX;
      stageLastY = e.clientY;
      stageLastT = now;
      stageMoveSamples += 1;

      pendingStageDx = e.clientX - stageStartX;
      pendingStageDy = e.clientY - stageStartY;
      hasPendingStagePan = true;
      if (!stagePanRaf) {
        stagePanRaf = requestAnimationFrame(flushStagePan);
      }
    });

    const stopStageInteraction = (e: PointerEvent) => {
      activePointers.delete(e.pointerId);
      if (activePointers.size < 2) {
        initialPinchDistance = 0;
      }
      if (activePointers.size === 0) {
        if (stagePanRaf) {
          cancelAnimationFrame(stagePanRaf);
          stagePanRaf = 0;
        }
        if (hasPendingStagePan || pendingPinchRatio !== null) {
          flushStagePan();
        }
        const releasedStage = activeStageEl;
        const wasDragging = isStageDragging;
        if (activeStageEl) {
          if (isStageDragging) {
            try {
              activeStageEl.releasePointerCapture(e.pointerId);
            } catch {}
            activeStageEl.classList.remove('is-dragging');
          }
          activeStageEl = null;
        }
        isStageDragging = false;

        // 松手阻尼惯性滑行（Damped Pan Inertia）
        const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        const speed = Math.hypot(stageVx, stageVy);
        if (wasDragging && releasedStage && !reduce && stageMoveSamples >= 2 && performance.now() - stageLastT < 60 && speed > 1.2) {
          const block = releasedStage.closest<HTMLElement>('.mermaid-block');
          if (block) {
            releasedStage.classList.add('is-inertia');
            let vx = stageVx;
            let vy = stageVy;
            const maxSL = Math.max(0, releasedStage.scrollWidth - releasedStage.clientWidth);
            const maxST = Math.max(0, releasedStage.scrollHeight - releasedStage.clientHeight);
            const stepStageInertia = () => {
              stageInertiaRaf = 0;
              if (!releasedStage.isConnected) return;
              vx *= 0.9;
              vy *= 0.9;
              if (Math.hypot(vx, vy) < 0.35) {
                releasedStage.classList.remove('is-inertia');
                applyBlockTransform(block);
                return;
              }
              const prevSL = releasedStage.scrollLeft;
              const nextSL = Math.max(0, Math.min(maxSL, prevSL - vx));
              const remX = vx - (prevSL - nextSL);
              releasedStage.scrollLeft = nextSL;
              block.dataset.panX = `${(parseFloat(block.dataset.panX || '0') || 0) + remX}`;

              const prevST = releasedStage.scrollTop;
              const nextST = Math.max(0, Math.min(maxST, prevST - vy));
              const remY = vy - (prevST - nextST);
              releasedStage.scrollTop = nextST;
              block.dataset.panY = `${(parseFloat(block.dataset.panY || '0') || 0) + remY}`;

              applyBlockTransform(block);
              stageInertiaRaf = requestAnimationFrame(stepStageInertia);
            };
            stageInertiaRaf = requestAnimationFrame(stepStageInertia);
          }
        }
      }
    };

    document.addEventListener('pointerup', stopStageInteraction);
    document.addEventListener('pointercancel', stopStageInteraction);
  }

  // ---------- 渲染等待与动画 ----------

  function waitForScrollIdle(idleMs: number, signal: AbortSignal) {
    if (signal.aborted) return Promise.resolve(false);
    return new Promise<boolean>((resolve) => {
      let last = 0;
      let frame = 0;
      const bump = () => { last = performance.now(); };
      const finish = (ready: boolean) => {
        cancelAnimationFrame(frame);
        window.removeEventListener('scroll', bump);
        signal.removeEventListener('abort', cancel);
        resolve(ready);
      };
      const cancel = () => finish(false);
      window.addEventListener('scroll', bump, { passive: true, signal });
      signal.addEventListener('abort', cancel, { once: true });
      const tick = () => {
        if (last === 0 || performance.now() - last >= idleMs) {
          finish(true);
          return;
        }
        frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    });
  }

  function getMermaidTheme(themeName: string) {
    if (themeName === 'dark') return 'dark';
    if (themeName === 'moss') return 'forest';
    if (themeName === 'rice') return 'neutral';
    return 'default';
  }

  function getCurrentTheme() {
    return document.documentElement.getAttribute('data-theme') || 'light';
  }

  function animateMermaidSvg(renderEl: HTMLElement, signal?: AbortSignal) {
    const svg = renderEl.querySelector<SVGSVGElement>('svg');
    if (!svg) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      svg.style.opacity = '1';
      return;
    }

    const revealEase = getComputedStyle(document.documentElement).getPropertyValue('--article-ease-reveal').trim() || 'cubic-bezier(0.25, 0.46, 0.45, 1)';
    svg.style.opacity = '0';
    svg.style.transform = 'translate3d(0, 8px, 0) scale(0.99)';
    svg.style.transition = `opacity 480ms ${revealEase}, transform 540ms ${revealEase}`;

    const nodes = Array.from(svg.querySelectorAll<SVGElement>('.node, .actor, .note, g.cluster, .label, .actor-man'));
    nodes.forEach((node, i) => {
      const delay = 20 + Math.min(i * 14, 150);
      node.style.opacity = '0';
      node.style.transition = `opacity 340ms ${revealEase} ${delay}ms`;
    });

    const lines = Array.from(svg.querySelectorAll<SVGElement>('.edgePath path, .messageLine0, .messageLine1, line, .flowchart-link'));
    lines.forEach((line, i) => {
      const delay = 40 + Math.min(i * 16, 170);
      const len = (line as any).getTotalLength ? (line as any).getTotalLength() : 0;
      if (len > 0) {
        line.style.strokeDasharray = `${len}`;
        line.style.strokeDashoffset = `${len}`;
        line.style.opacity = '0';
        line.style.transition = `stroke-dashoffset 480ms ${revealEase} ${delay}ms, opacity 240ms ease ${delay}ms`;
      } else {
        line.style.opacity = '0';
        line.style.transition = `opacity 320ms ease ${delay}ms`;
      }
    });

    const showAll = () => {
      svg.style.opacity = '1';
      svg.style.transform = 'translate3d(0, 0, 0) scale(1)';
      nodes.forEach((node) => { node.style.opacity = '1'; });
      lines.forEach((line) => { line.style.strokeDashoffset = '0'; line.style.opacity = '1'; });
    };

    const cleanup = () => {
      svg.style.opacity = '';
      svg.style.transform = '';
      svg.style.transition = '';
      nodes.forEach((node) => {
        node.style.transition = '';
        node.style.opacity = '';
      });
      lines.forEach((line) => {
        line.style.transition = '';
        line.style.opacity = '';
        line.style.strokeDasharray = '';
        line.style.strokeDashoffset = '';
      });
    };

    let t1 = 0;
    let t2 = 0;
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (signal?.aborted) return;
        showAll();
        t1 = window.setTimeout(cleanup, 780);
      });
    });

    t2 = window.setTimeout(() => {
      showAll();
      cleanup();
    }, 920);

    signal?.addEventListener('abort', () => {
      window.clearTimeout(t1);
      window.clearTimeout(t2);
    }, { once: true });
  }

  // ---------- 核心初始化与渲染管线 ----------

  async function initMermaid() {
    const blocks = document.querySelectorAll<HTMLElement>('.mermaid-block');
    if (!blocks.length) return;

    // 1. 确保全局交互事件委托与全屏 Modal 监听已注册（即使渲染还未完成，按钮点击也绝不会失效）
    ensureGlobalDelegation();
    ensureModalBound();

    // 2. 渲染会话管理（防重入竞争）
    const sessionId = ++activeSessionId;
    renderController?.abort();
    renderController = new AbortController();
    const { signal } = renderController;

    if (!await waitForPostEntrance(signal)) return;
    if (!await waitForScrollIdle(100, signal)) return;
    if (sessionId !== activeSessionId || !blocks[0].isConnected) return;

    const { default: mermaid } = await import('mermaid');
    if (sessionId !== activeSessionId) return;

    const themeName = getCurrentTheme();
    const isDark = themeName === 'dark';
    const isMoss = themeName === 'moss';
    const isRice = themeName === 'rice';
    const mTheme = getMermaidTheme(themeName);

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: mTheme,
      fontFamily: 'var(--font-mono, ui-monospace, monospace)',
      themeVariables: {
        darkMode: isDark,
        background: 'transparent',
        fontFamily: 'var(--font-mono, ui-monospace, monospace)',
        primaryColor: isDark ? '#1a1f26' : isMoss ? '#EAF4F2' : isRice ? '#EBE0CB' : '#f4f5f7',
        primaryTextColor: isDark ? '#e2e8f0' : isMoss ? '#004D40' : isRice ? '#2B241C' : '#1e293b',
        primaryBorderColor: isDark ? 'rgba(255, 255, 255, 0.16)' : isMoss ? 'rgba(0, 77, 64, 0.25)' : isRice ? 'rgba(92, 76, 55, 0.3)' : 'rgba(0, 0, 0, 0.18)',
        lineColor: isDark ? '#94a3b8' : isMoss ? '#00796B' : isRice ? '#7D6B52' : '#64748b',
        secondaryColor: isDark ? '#111827' : isMoss ? '#D0EAE5' : isRice ? '#E2D5BC' : '#e2e8f0',
        tertiaryColor: isDark ? '#1f2937' : isMoss ? '#B8DFD8' : isRice ? '#D7C7A9' : '#cbd5e1',
      },
    });

    for (let i = 0; i < blocks.length; i++) {
      if (sessionId !== activeSessionId) return;
      if (i > 0) {
        if (!await waitForScrollIdle(100, signal)) return;
      }
      if (sessionId !== activeSessionId || !blocks[i].isConnected) return;
      const block = blocks[i];
      const encoded = block.dataset.mermaidCode || '';
      const rawCode = decodeURIComponent(encoded);
      if (!rawCode) continue;

      const renderEl = block.querySelector<HTMLElement>('.mermaid-render');
      const loadingEl = block.querySelector<HTMLElement>('.mermaid-loading');
      const sourceEl = block.querySelector<HTMLElement>('.mermaid-source');
      const stageEl = block.querySelector<HTMLElement>('.mermaid-stage');

      if (!renderEl) continue;

      try {
        const uniqueId = `mermaid-graph-${++renderCounter}`;
        const { svg, bindFunctions } = await mermaid.render(uniqueId, rawCode);
        if (sessionId !== activeSessionId) return;

        renderEl.innerHTML = svg;
        renderEl.dataset.rendered = 'true';
        if (typeof bindFunctions === 'function') {
          try { bindFunctions(renderEl); } catch (e) {}
        }
        if (loadingEl) loadingEl.remove();
        if (sourceEl) {
          sourceEl.hidden = true;
          sourceEl.style.display = 'none';
        }

        const svgEl = renderEl.querySelector<SVGSVGElement>('svg');
        if (svgEl) {
          fixMermaidSvgBounds(svgEl);
        }
        if (svgEl && stageEl) {
          const naturalWidth = svgEl.viewBox?.baseVal?.width || parseFloat(svgEl.getAttribute('width') || '0') || 0;
          if (naturalWidth > 640 && stageEl.clientWidth > 0 && naturalWidth > stageEl.clientWidth - 40) {
            stageEl.dataset.scrollable = 'true';
          } else {
            delete stageEl.dataset.scrollable;
          }
        }

        animateMermaidSvg(renderEl, signal);
      } catch (error: any) {
        if (sessionId !== activeSessionId) return;
        console.error('[Mermaid Render Error]:', error);
        if (loadingEl) loadingEl.remove();
        renderEl.innerHTML = `
          <div class="mermaid-error">
            <div class="mermaid-error-head">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Mermaid 语法解析失败</span>
            </div>
            <p class="mermaid-error-msg">${error?.message || '图表语法有误，请点击上方 Code 查看源码并修正'}</p>
          </div>
        `;
        if (sourceEl) {
          sourceEl.hidden = false;
          sourceEl.style.display = 'block';
        }
      }
    }
  }

  // ---------- 幂等销毁与生命周期注册 ----------

  (window as any).__areSetMermaidCleanup__?.();
  (window as any).__initMermaid = initMermaid;

  (window as any).__areSetMermaidCleanup__ = () => {
    activeSessionId++;
    cancelModalInertia();
    cancelStageInertia();
    resetStageInteractionState?.();
    copyTimers.forEach((id) => window.clearTimeout(id));
    copyTimers.clear();
    renderController?.abort();
    renderController = null;
    closeModal();
    modalController?.abort();
    modalController = null;
    boundModal = null;
  };

  if (!(window as any).__areSetMermaidBound__) {
    (window as any).__areSetMermaidBound__ = true;

    // 1. Astro View Transitions 统一入口（每次页面载入/切页均会派发）
    document.addEventListener('astro:page-load', () => {
      (window as any).__initMermaid?.();
    });

    // 2. 主题切换时重新渲染
    window.addEventListener('theme-change', () => {
      (window as any).__initMermaid?.();
    });

    // 3. 页面即将切换时执行幂等清理契约
    document.addEventListener('astro:before-swap', () => {
      (window as any).__areSetMermaidCleanup__?.();
    });
  }

  // 首次加载时立即挂载全局委托，并在非 SPA 或脚本晚于 page-load 执行时兜底初始化
  ensureGlobalDelegation();
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initMermaid();
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      (window as any).__initMermaid?.();
    }, { once: true });
  }
</script>
