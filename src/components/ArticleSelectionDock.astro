---
// ArticleSelectionDock.astro — 划词浮动微托盘与文章持久化高亮笔记系统
---

<!-- 1. 底部居中微托盘 (Screen Bottom Floating Micro-Capsule, 100% 零遮挡正文) -->
<aside
  id="article-selection-dock"
  class="article-selection-dock"
  hidden
  role="toolbar"
  aria-label="划词快捷操作微托盘"
  data-lenis-prevent
>
  <div class="selection-dock-capsule" id="selection-dock-capsule">
    <!-- Mode A: 划词创建模式 (Selection Mode) -->
    <div class="dock-actions-row dock-mode-create" id="dock-mode-create">
      <button
        type="button"
        class="dock-action-btn dock-btn-highlight"
        id="dock-act-highlight"
        aria-label="高亮划线 (H)"
        title="高亮划线 (H)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 11-6 6v3h3l6-6"></path>
          <path d="m22 2-2.5 2.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L18 0z"></path>
          <path d="M14.5 5.5 18.5 9.5"></path>
        </svg>
        <span>划线</span>
        <kbd class="dock-kbd">H</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-pin"
        id="dock-act-pin"
        aria-label="钉入工作台 (P)"
        title="钉入分屏工作台对照 (P)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="17" x2="12" y2="22"></line>
          <path d="M5 17h14v-2l-2-2V5a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v8l-2 2v2z"></path>
        </svg>
        <span>钉住</span>
        <kbd class="dock-kbd">P</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-search"
        id="dock-act-search"
        aria-label="搜本文 (F)"
        title="在本文中检索选中文本 (F)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>搜文</span>
        <kbd class="dock-kbd">F</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-ask"
        id="dock-act-ask"
        aria-label="问墨问 AI (A)"
        title="向墨问 AI 发起针对选区的提问 (A)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>墨问</span>
        <kbd class="dock-kbd">A</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-copy"
        id="dock-act-copy"
        aria-label="复制标准引用 (C)"
        title="复制 Markdown 引用卡片 (C)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>引用</span>
        <kbd class="dock-kbd">C</kbd>
      </button>
    </div>

    <!-- Mode B: 已高亮标注管理模式 (Manage Mode) -->
    <div class="dock-actions-row dock-mode-manage" id="dock-mode-manage" hidden style="display: none;">
      <div class="dock-status-tag">
        <span class="dock-status-dot"></span>
        <span class="dock-status-text">已划线</span>
      </div>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-delete"
        id="dock-act-delete"
        aria-label="取消划线 (Delete / Backspace)"
        title="取消高亮划线 (Delete)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        <span>删除</span>
        <kbd class="dock-kbd">Del</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-pin"
        id="dock-act-manage-pin"
        aria-label="钉入工作台 (P)"
        title="钉入工作台 (P)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="17" x2="12" y2="22"></line>
          <path d="M5 17h14v-2l-2-2V5a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v8l-2 2v2z"></path>
        </svg>
        <span>钉住</span>
        <kbd class="dock-kbd">P</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-copy"
        id="dock-act-manage-copy"
        aria-label="复制引用 (C)"
        title="复制引用 (C)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>引用</span>
        <kbd class="dock-kbd">C</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-dismiss"
        id="dock-act-manage-close"
        aria-label="关闭 (Esc)"
        title="关闭管理托盘 (Esc)"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- 水墨复印盖印反馈气泡 (独立顶层容器，托盘或抽屉均能优雅展现) -->
<div class="dock-copy-stamp" id="dock-copy-stamp" aria-hidden="true">
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
  <span id="dock-copy-stamp-text">已复制引用</span>
</div>

<!-- 2. 阅读角常驻高亮笔记悬浮胶囊 (Alongside "搜本文") -->
<button
  type="button"
  id="article-highlights-floating-pill"
  class="article-highlights-floating-pill"
  data-article-notes-trigger
  aria-label="打开高亮笔记列表"
  title="文章高亮笔记 (点击展开批注列表)"
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m9 11-6 6v3h3l6-6"></path>
    <path d="m22 2-2.5 2.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L18 0z"></path>
    <path d="M14.5 5.5 18.5 9.5"></path>
  </svg>
  <span class="article-highlights-pill-text">笔记</span>
  <span class="article-highlights-pill-badge" data-notes-count>0</span>
</button>

<!-- 3. 右侧“高亮笔记 (N)”全景抽屉 (Slide-Over Notes Drawer) -->
<div class="article-notes-drawer-backdrop" id="article-notes-backdrop" hidden style="display: none;"></div>
<aside
  class="article-notes-drawer"
  id="article-notes-drawer"
  hidden
  style="display: none;"
  role="dialog"
  aria-label="文章高亮笔记"
  data-lenis-prevent
>
  <!-- 抽屉头部 -->
  <div class="notes-drawer-header">
    <div class="notes-drawer-title-area">
      <span class="notes-drawer-icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 11-6 6v3h3l6-6"></path>
          <path d="m22 2-2.5 2.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L18 0z"></path>
          <path d="M14.5 5.5 18.5 9.5"></path>
        </svg>
      </span>
      <h2 class="notes-drawer-heading">高亮笔记</h2>
      <span class="notes-count-tag" id="notes-header-count">0 条划线</span>
    </div>
    <div class="notes-drawer-actions">
      <button
        type="button"
        class="notes-drawer-close-btn"
        id="notes-drawer-close-btn"
        aria-label="关闭笔记抽屉 (Esc)"
        title="关闭 (Esc)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- 抽屉列表内容区域 -->
  <div class="notes-drawer-body" id="notes-drawer-list" data-lenis-prevent>
    <!-- Dynamic note items rendered here -->
  </div>

  <!-- 抽屉底栏导出 -->
  <div class="notes-drawer-footer">
    <button type="button" class="notes-export-btn" id="notes-export-btn" title="将所有高亮整理导出为 Markdown">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
        <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
      </svg>
      <span id="notes-export-btn-text">导出 Markdown 笔记</span>
    </button>
    <button type="button" class="notes-clear-btn" id="notes-clear-all-btn" title="清空此文全部高亮划线">
      清空
    </button>
  </div>
</aside>

<script>
  import {
    loadHighlights,
    saveHighlights,
    serializeHighlight,
    applyHighlightToRange,
    removeHighlightFromDOM,
    rehydrateHighlights,
    formatCitation,
    exportHighlightsAsMarkdown,
    type ArticleHighlightRecord,
  } from '../utils/articleHighlightEngine';

  const CLEANUP_KEY = '__areSetArticleHighlightsCleanup__';
  const LISTENER_KEY = '__areSetArticleHighlightsBound__';

  function initArticleHighlights() {
    const prevCleanup = (window as any)[CLEANUP_KEY];
    if (typeof prevCleanup === 'function') prevCleanup();

    const prose = document.querySelector<HTMLElement>('[data-post-prose]');
    if (!prose) return;

    const controller = new AbortController();
    const { signal } = controller;

    const postSlug = window.location.pathname;
    let storedRecords: ArticleHighlightRecord[] = loadHighlights(postSlug);

    // DOM Elements
    const dock = document.getElementById('article-selection-dock');
    const dockCapsule = document.getElementById('selection-dock-capsule');
    const modeCreate = document.getElementById('dock-mode-create');
    const modeManage = document.getElementById('dock-mode-manage');
    const copyStamp = document.getElementById('dock-copy-stamp');
    const stampText = document.getElementById('dock-copy-stamp-text');

    const floatingPill = document.getElementById('article-highlights-floating-pill');
    const drawer = document.getElementById('article-notes-drawer');
    const backdrop = document.getElementById('article-notes-backdrop');
    const drawerList = document.getElementById('notes-drawer-list');
    const drawerCloseBtn = document.getElementById('notes-drawer-close-btn');
    const exportBtn = document.getElementById('notes-export-btn');
    const exportBtnText = document.getElementById('notes-export-btn-text');
    const clearAllBtn = document.getElementById('notes-clear-all-btn');

    let currentSelectedRange: Range | null = null;
    let activeHighlightId: string | null = null;
    let dockTimeoutId: number | null = null;
    let isDockVisible = false;
    let stampTimeoutId: number | null = null;

    // 1. 初次加载：扫描并重新挂载持久化高亮
    rehydrateHighlights(storedRecords, prose);
    updateBadges();

    // ---------- UI 状态同步 ----------
    function updateBadges() {
      const count = storedRecords.length;
      document.querySelectorAll<HTMLElement>('[data-notes-count]').forEach((badge) => {
        badge.textContent = String(count);
        badge.classList.remove('has-bump');
        void badge.offsetWidth;
        badge.classList.add('has-bump');
      });

      const headerCount = document.getElementById('notes-header-count');
      if (headerCount) {
        headerCount.textContent = `${count} 条划线`;
      }

      if (floatingPill) {
        floatingPill.classList.toggle('has-notes', count > 0);
      }
    }

    function showStamp(msg: string) {
      if (!copyStamp || !stampText) return;
      stampText.textContent = msg;
      copyStamp.classList.remove('is-active');
      void copyStamp.offsetWidth;
      copyStamp.classList.add('is-active');

      if (stampTimeoutId !== null) window.clearTimeout(stampTimeoutId);
      stampTimeoutId = window.setTimeout(() => {
        copyStamp.classList.remove('is-active');
        stampTimeoutId = null;
      }, 1600);
    }

    // ---------- 底部浮动微托盘展示与隐藏 ----------
    function showDock(mode: 'create' | 'manage') {
      if (!dock || !dockCapsule) return;
      if (dockTimeoutId !== null) {
        window.clearTimeout(dockTimeoutId);
        dockTimeoutId = null;
      }

      // 零遮挡保护 (100% Zero Text Obstruction)
      let targetRect: DOMRect | null = null;
      if (mode === 'create' && currentSelectedRange) {
        targetRect = currentSelectedRange.getBoundingClientRect();
      } else if (mode === 'manage' && activeHighlightId) {
        const mark = prose.querySelector<HTMLElement>(`mark[data-highlight-id="${activeHighlightId}"]`);
        targetRect = mark ? mark.getBoundingClientRect() : null;
      }

      if (targetRect && targetRect.bottom > window.innerHeight - 90) {
        dock.classList.add('is-flipped-top');
        copyStamp?.classList.add('is-flipped-top');
      } else {
        dock.classList.remove('is-flipped-top');
        copyStamp?.classList.remove('is-flipped-top');
      }

      isDockVisible = true;
      document.body.classList.add('has-selection-dock-open');
      dock.hidden = false;
      dock.style.display = 'block';

      if (mode === 'create') {
        if (modeCreate) {
          modeCreate.hidden = false;
          modeCreate.style.display = 'flex';
        }
        if (modeManage) {
          modeManage.hidden = true;
          modeManage.style.display = 'none';
        }
      } else {
        if (modeCreate) {
          modeCreate.hidden = true;
          modeCreate.style.display = 'none';
        }
        if (modeManage) {
          modeManage.hidden = false;
          modeManage.style.display = 'flex';
        }
      }

      dock.classList.remove('is-exiting');
      dock.classList.add('is-entering');

      const onEnterEnd = () => {
        dock?.classList.remove('is-entering');
      };
      dock.addEventListener('animationend', onEnterEnd, { once: true });
    }

    let isDockInteracting = false;

    function hideDock() {
      if (!dock || !isDockVisible) return;
      isDockVisible = false;
      document.body.classList.remove('has-selection-dock-open');

      dock.classList.remove('is-entering');
      dock.classList.add('is-exiting');

      dockTimeoutId = window.setTimeout(() => {
        dock.classList.remove('is-exiting', 'is-flipped-top');
        copyStamp?.classList.remove('is-flipped-top');
        dock.hidden = true;
        dock.style.display = 'none';
        dockTimeoutId = null;
        currentSelectedRange = null;
        activeHighlightId = null;
      }, 320);
    }

    // ---------- 划词检测逻辑 ----------
    let selectionTimer = 0;
    function checkProseSelection() {
      if (isDockInteracting) return;
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0 || selection.isCollapsed) {
        // 如果当前没有点击在已划线 mark 上，则收起 dock
        if (!activeHighlightId) {
          hideDock();
        }
        return;
      }

      const range = selection.getRangeAt(0);
      if (!prose.contains(range.commonAncestorContainer)) {
        if (!activeHighlightId) hideDock();
        return;
      }

      const text = selection.toString().trim();
      if (text.length === 0) {
        if (!activeHighlightId) hideDock();
        return;
      }

      // 有效选区，保存引用并展示创建微托盘
      currentSelectedRange = range.cloneRange();
      activeHighlightId = null;
      showDock('create');
    }

    document.addEventListener('selectionchange', () => {
      window.clearTimeout(selectionTimer);
      selectionTimer = window.setTimeout(checkProseSelection, 120);
    }, { signal });

    // ---------- 点击已有高亮 Mark 触发管理模式 ----------
    prose.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const mark = target?.closest<HTMLElement>('.article-highlight-mark');
      if (mark) {
        e.stopPropagation();
        const id = mark.dataset.highlightId;
        if (id) {
          activeHighlightId = id;
          currentSelectedRange = null;
          try {
            window.getSelection()?.removeAllRanges();
          } catch {}
          showDock('manage');
        }
      }
    }, { signal });

    // 阻止点击微托盘本体导致选区收起或焦点漂移（仅鼠标拦截，触屏设备绝不 preventDefault 以免破坏 iOS Safari 的 click 派发）
    dockCapsule?.addEventListener('pointerdown', (e) => {
      isDockInteracting = true;
      if (e.pointerType === 'mouse') {
        e.preventDefault();
      }
    }, { signal });

    window.addEventListener('pointerup', () => {
      isDockInteracting = false;
    }, { signal });
    window.addEventListener('pointercancel', () => {
      isDockInteracting = false;
    }, { signal });

    // 点击页面空白处关闭 Dock
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('#article-selection-dock, .article-highlight-mark, #article-highlights-floating-pill, #article-notes-drawer')) {
        return;
      }
      if (isDockVisible) {
        hideDock();
      }
    }, { signal });

    // ---------- 五大核心快捷操作实现 ----------

    // 1. 🖍️ 划线高亮
    function triggerHighlight() {
      if (!currentSelectedRange) return;
      const record = serializeHighlight(currentSelectedRange, prose);
      if (!record) return;

      const marks = applyHighlightToRange(currentSelectedRange, record);
      if (marks.length > 0) {
        storedRecords.push(record);
        saveHighlights(postSlug, storedRecords);
        updateBadges();

        // 柔和微波反馈
        marks[0]?.classList.add('has-pulse');
        setTimeout(() => marks[0]?.classList.remove('has-pulse'), 1800);
      }

      try {
        window.getSelection()?.removeAllRanges();
      } catch {}
      hideDock();
    }

    // 2. 📌 钉入工作台
    function triggerPin(triggerEl?: HTMLElement) {
      let excerptText = '';
      let headingText = '引文片段';
      let sourceAnchor: HTMLElement | null = null;
      let recordId = activeHighlightId;

      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) {
          excerptText = found.text;
          headingText = found.headingText || '引文片段';
        }
        sourceAnchor = prose.querySelector<HTMLElement>(`mark[data-highlight-id="${activeHighlightId}"]`);
      } else if (currentSelectedRange) {
        excerptText = currentSelectedRange.toString().trim();
        const info = serializeHighlight(currentSelectedRange, prose);
        if (info) {
          headingText = info.headingText || '引文片段';
        }
        const sc = currentSelectedRange.startContainer;
        sourceAnchor = (sc.nodeType === Node.TEXT_NODE ? sc.parentElement : sc as HTMLElement) || prose;
      }

      if (!excerptText) return;

      const articleTitle = document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title;
      const fullTitle = `${articleTitle} · ${headingText.replace(/^§\s*/, '')}`;

      if ((window as any).__pinWorkbench && typeof (window as any).__pinWorkbench.pinExcerpt === 'function') {
        (window as any).__pinWorkbench.pinExcerpt({
          id: recordId || `quote-${Date.now().toString(36)}`,
          title: fullTitle,
          badge: '引文',
          text: excerptText,
          sourceEl: sourceAnchor,
          triggerBtn: triggerEl,
        });
      } else {
        window.dispatchEvent(new CustomEvent('pin-workbench:add-excerpt', {
          detail: {
            id: recordId || `quote-${Date.now().toString(36)}`,
            title: fullTitle,
            badge: '引文',
            text: excerptText,
            sourceEl: sourceAnchor,
            triggerBtn: triggerEl,
          }
        }));
      }

      showStamp('已钉入工作台');
      hideDock();
    }

    // 3. 🔍 搜本文
    function triggerSearch() {
      let queryText = '';
      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) queryText = found.text;
      } else if (currentSelectedRange) {
        queryText = currentSelectedRange.toString().trim();
      }

      if (!queryText) return;
      const cleanQuery = queryText.replace(/\s+/g, ' ').trim().slice(0, 60);

      hideDock();

      if ((window as any).__articleSearch) {
        (window as any).__articleSearch.open();
        (window as any).__articleSearch.search(cleanQuery);
      } else {
        const trigger = document.querySelector<HTMLElement>('[data-article-search-trigger]');
        trigger?.click();
      }
    }

    // 4. 💬 问墨问
    function triggerAsk() {
      let snippet = '';
      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) snippet = found.text;
      } else if (currentSelectedRange) {
        snippet = currentSelectedRange.toString().trim();
      }

      if (!snippet) return;
      hideDock();

      if ((window as any).__inkAsk && typeof (window as any).__inkAsk.openSidebarWithContext === 'function') {
        (window as any).__inkAsk.openSidebarWithContext(snippet);
      } else {
        window.dispatchEvent(new CustomEvent('inkask:open-with-context', {
          detail: { snippet }
        }));
      }
    }

    // 5. 📋 复制引用
    async function triggerCopy() {
      let text = '';
      let section = '§ 导言 / 正文';
      let headingId: string | undefined = undefined;

      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) {
          text = found.text;
          section = found.headingText || section;
          headingId = found.headingId;
        }
      } else if (currentSelectedRange) {
        text = currentSelectedRange.toString().trim();
        const info = serializeHighlight(currentSelectedRange, prose);
        if (info) {
          section = info.headingText || section;
          headingId = info.headingId;
        }
      }

      if (!text) return;
      const title = document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title;
      const formatted = formatCitation(title, section, window.location.href, text, headingId);

      try {
        await navigator.clipboard.writeText(formatted);
        showStamp('已复制 Markdown 引用');
      } catch {
        showStamp('复制失败');
      }

      setTimeout(() => {
        hideDock();
      }, 700);
    }

    // 6. 🗑️ 取消划线
    function triggerDeleteHighlight(targetId?: string, skipDrawerSync = false) {
      const id = targetId || activeHighlightId;
      if (!id) return;

      removeHighlightFromDOM(id, prose);
      storedRecords = storedRecords.filter((r) => r.id !== id);
      saveHighlights(postSlug, storedRecords);
      updateBadges();

      if (drawer?.classList.contains('is-open')) {
        if (!skipDrawerSync || storedRecords.length === 0) {
          renderDrawerNotes();
        }
      }

      showStamp('已取消划线');
      hideDock();
    }

    // 7. 优雅卡片退出动画（向右轻盈滑出并折叠高度，与 Pin 工作台卡片保持一致的物理质感）
    function smoothRemoveNoteCard(targetEl: HTMLElement, isGroup: boolean, onComplete: () => void) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targetEl.remove();
        onComplete();
        return;
      }
      targetEl.style.pointerEvents = 'none';
      const startHeight = targetEl.offsetHeight;
      const marginAbsorb = isGroup ? '-1.2rem' : '-0.65rem';

      const anim = targetEl.animate([
        {
          opacity: 1,
          transform: 'translate3d(0, 0, 0) scale(1)',
          maxHeight: `${startHeight}px`,
          marginBottom: '0px',
          paddingTop: '',
          paddingBottom: '',
          overflow: 'hidden',
        },
        {
          opacity: 0.65,
          transform: 'translate3d(28px, -2px, 0) scale(0.98)',
          maxHeight: `${Math.round(startHeight * 0.65)}px`,
          marginBottom: '0px',
          offset: 0.44,
        },
        {
          opacity: 0,
          transform: 'translate3d(56px, -4px, 0) scale(0.92)',
          maxHeight: '0px',
          marginBottom: marginAbsorb,
          paddingTop: '0px',
          paddingBottom: '0px',
          borderWidth: '0px',
          overflow: 'hidden',
          offset: 1,
        }
      ], {
        duration: 380,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards'
      });

      anim.onfinish = () => {
        targetEl.remove();
        onComplete();
      };
    }

    // ---------- Dock 按钮事件绑定 ----------
    document.getElementById('dock-act-highlight')?.addEventListener('click', () => triggerHighlight(), { signal });
    document.getElementById('dock-act-pin')?.addEventListener('click', (e) => triggerPin(e.currentTarget as HTMLElement), { signal });
    document.getElementById('dock-act-search')?.addEventListener('click', () => triggerSearch(), { signal });
    document.getElementById('dock-act-ask')?.addEventListener('click', () => triggerAsk(), { signal });
    document.getElementById('dock-act-copy')?.addEventListener('click', () => triggerCopy(), { signal });

    document.getElementById('dock-act-delete')?.addEventListener('click', () => triggerDeleteHighlight(), { signal });
    document.getElementById('dock-act-manage-pin')?.addEventListener('click', (e) => triggerPin(e.currentTarget as HTMLElement), { signal });
    document.getElementById('dock-act-manage-copy')?.addEventListener('click', () => triggerCopy(), { signal });
    document.getElementById('dock-act-manage-close')?.addEventListener('click', () => hideDock(), { signal });

    // 全局快捷键监听 (H / P / F / A / C / Esc / Delete)
    window.addEventListener('keydown', (e) => {
      // 避免输入框内冲突
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || (activeEl as HTMLElement).isContentEditable)) {
        return;
      }

      if (e.key === 'Escape') {
        if (drawer?.classList.contains('is-open')) {
          closeNotesDrawer();
          return;
        }
        if (isDockVisible) {
          try {
            window.getSelection()?.removeAllRanges();
          } catch {}
          hideDock();
          return;
        }
      }

      if (isDockVisible) {
        const key = e.key.toUpperCase();
        if (key === 'H' && currentSelectedRange) {
          e.preventDefault();
          triggerHighlight();
        } else if (key === 'P') {
          e.preventDefault();
          triggerPin();
        } else if (key === 'F') {
          e.preventDefault();
          triggerSearch();
        } else if (key === 'A') {
          e.preventDefault();
          triggerAsk();
        } else if (key === 'C') {
          e.preventDefault();
          triggerCopy();
        } else if (activeHighlightId && (e.key === 'Delete' || e.key === 'Backspace')) {
          e.preventDefault();
          triggerDeleteHighlight();
        }
      }
    }, { signal });

    // ---------- 高亮笔记抽屉 (Notes Drawer) ----------
    function renderDrawerNotes() {
      if (!drawerList) return;
      drawerList.innerHTML = '';

      if (storedRecords.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'notes-empty-state';
        empty.innerHTML = `
          <div class="notes-empty-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
          </div>
          <p class="notes-empty-title">暂无高亮划线</p>
          <p class="notes-empty-desc">在正文中选中任意文字或代码，即可快速划线、批注与对照～</p>
        `;
        drawerList.appendChild(empty);
        return;
      }

      // 按小节分组展示
      const sectionMap = new Map<string, ArticleHighlightRecord[]>();
      for (const rec of storedRecords) {
        const sec = rec.headingText || '§ 导言 / 正文';
        const list = sectionMap.get(sec) || [];
        list.push(rec);
        sectionMap.set(sec, list);
      }

      for (const [section, items] of sectionMap.entries()) {
        const secEl = document.createElement('div');
        secEl.className = 'notes-section-group';

        const headEl = document.createElement('div');
        headEl.className = 'notes-section-head';
        headEl.textContent = section;
        secEl.appendChild(headEl);

        for (const item of items) {
          const card = document.createElement('div');
          card.className = 'notes-item-card';
          card.dataset.noteId = item.id;

          const quoteText = document.createElement('p');
          quoteText.className = 'notes-item-text';
          quoteText.textContent = item.text;

          const metaRow = document.createElement('div');
          metaRow.className = 'notes-item-meta';

          const timeSpan = document.createElement('span');
          timeSpan.className = 'notes-item-time';
          timeSpan.textContent = new Date(item.timestamp).toLocaleDateString('zh-CN', {
            month: 'numeric',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });

          const actGroup = document.createElement('div');
          actGroup.className = 'notes-item-actions';

          // 定位按钮
          const jumpBtn = document.createElement('button');
          jumpBtn.type = 'button';
          jumpBtn.className = 'notes-btn notes-btn-jump';
          jumpBtn.title = '定位到原文';
          jumpBtn.innerHTML = `<span>定位</span>`;
          jumpBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            jumpToHighlight(item.id);
          });

          // 钉住按钮
          const pinBtn = document.createElement('button');
          pinBtn.type = 'button';
          pinBtn.className = 'notes-btn notes-btn-pin';
          pinBtn.title = '钉入对照工作台';
          pinBtn.innerHTML = `<span>钉住</span>`;
          pinBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            activeHighlightId = item.id;
            triggerPin(pinBtn);
            const span = pinBtn.querySelector('span') || pinBtn;
            const original = span.textContent;
            span.textContent = '已钉住!';
            setTimeout(() => { span.textContent = original; }, 1400);
          });

          // 复制按钮
          const copyBtn = document.createElement('button');
          copyBtn.type = 'button';
          copyBtn.className = 'notes-btn notes-btn-copy';
          copyBtn.title = '复制 Markdown 引用';
          copyBtn.innerHTML = `<span>复制</span>`;
          copyBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            activeHighlightId = item.id;
            triggerCopy();
            const span = copyBtn.querySelector('span') || copyBtn;
            const original = span.textContent;
            span.textContent = '已复制!';
            setTimeout(() => { span.textContent = original; }, 1400);
          });

          // 删除按钮
          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'notes-btn notes-btn-del';
          delBtn.title = '删除此条高亮';
          delBtn.innerHTML = `
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          `;
          delBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (card.dataset.deleting === 'true') return;
            card.dataset.deleting = 'true';

            const isSoleCard = (secEl.querySelectorAll('.notes-item-card').length <= 1);
            const targetEl = isSoleCard ? secEl : card;

            smoothRemoveNoteCard(targetEl, isSoleCard, () => {
              if (!isSoleCard && secEl.querySelectorAll('.notes-item-card').length === 0) {
                secEl.remove();
              }
              triggerDeleteHighlight(item.id, true);
            });
          });

          actGroup.append(jumpBtn, pinBtn, copyBtn, delBtn);
          metaRow.append(timeSpan, actGroup);

          card.append(quoteText, metaRow);
          card.addEventListener('click', () => jumpToHighlight(item.id));
          secEl.appendChild(card);
        }

        drawerList.appendChild(secEl);
      }
    }

    function jumpToHighlight(id: string) {
      const mark = prose.querySelector<HTMLElement>(`mark[data-highlight-id="${id}"]`);
      if (!mark) return;

      if (window.innerWidth < 768) {
        closeNotesDrawer();
      }

      // 展开可能收起的 details 折叠块
      let parent = mark.parentElement;
      while (parent && parent !== prose) {
        if (parent.tagName === 'DETAILS') {
          (parent as HTMLDetailsElement).open = true;
        }
        if (parent.classList.contains('is-collapsed')) {
          parent.classList.remove('is-collapsed');
        }
        parent = parent.parentElement;
      }

      const rect = mark.getBoundingClientRect();
      const targetY = Math.max(0, window.scrollY + rect.top - (window.innerHeight / 2) + (rect.height / 2));

      if ((window as any).lenis && typeof (window as any).lenis.scrollTo === 'function') {
        (window as any).lenis.scrollTo(targetY, {
          duration: 0.8,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });
      } else {
        window.scrollTo({
          top: targetY,
          behavior: 'smooth',
        });
      }

      // 触发温润的高亮水墨波动
      mark.classList.remove('has-pulse');
      void mark.offsetWidth;
      mark.classList.add('has-pulse');
      setTimeout(() => mark.classList.remove('has-pulse'), 2200);
    }

    function openNotesDrawer() {
      if (!drawer || !backdrop) return;
      hideDock();
      renderDrawerNotes();

      drawer.hidden = false;
      drawer.style.display = 'flex';
      backdrop.hidden = false;
      backdrop.style.display = 'block';

      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        document.body.classList.add('notes-drawer-open');
      });
    }

    function closeNotesDrawer() {
      if (!drawer || !backdrop) return;
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      document.body.classList.remove('notes-drawer-open');

      setTimeout(() => {
        drawer.hidden = true;
        drawer.style.display = 'none';
        backdrop.hidden = true;
        backdrop.style.display = 'none';
      }, 340);
    }

    floatingPill?.addEventListener('click', openNotesDrawer, { signal });
    drawerCloseBtn?.addEventListener('click', closeNotesDrawer, { signal });
    backdrop?.addEventListener('click', closeNotesDrawer, { signal });

    // 委派支持页面内其它触发按钮 (如 PostLayout TOC 上的笔记按钮)
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('[data-article-notes-trigger]') && !target.closest('#article-highlights-floating-pill')) {
        openNotesDrawer();
      }
    }, { signal });

    // 导出 Markdown 笔记按钮
    exportBtn?.addEventListener('click', async () => {
      if (!storedRecords.length) {
        showStamp('暂无可导出的划线');
        return;
      }
      const title = document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title;
      const md = exportHighlightsAsMarkdown(title, window.location.href, storedRecords);

      try {
        await navigator.clipboard.writeText(md);
        if (exportBtnText) {
          const original = exportBtnText.textContent;
          exportBtnText.textContent = '✓ 已复制全部笔记！';
          setTimeout(() => {
            exportBtnText.textContent = original;
          }, 1800);
        }
      } catch {
        showStamp('导出复制失败');
      }
    }, { signal });

    // 清空全部高亮
    clearAllBtn?.addEventListener('click', () => {
      if (!storedRecords.length) return;
      if (!window.confirm('确定要清空本文的所有高亮划线吗？')) return;

      for (const rec of storedRecords) {
        removeHighlightFromDOM(rec.id, prose);
      }
      const orphanMarks = prose.querySelectorAll<HTMLElement>('mark.article-highlight-mark');
      orphanMarks.forEach((mark) => {
        const parent = mark.parentNode;
        if (parent) {
          while (mark.firstChild) parent.insertBefore(mark.firstChild, mark);
          mark.remove();
          parent.normalize();
        }
      });

      storedRecords = [];
      saveHighlights(postSlug, []);
      updateBadges();
      renderDrawerNotes();
      showStamp('已清空全部划线');
    }, { signal });

    // 对外暴露 API 以供外部组件/测试交互
    (window as any).__articleHighlights = {
      getHighlights: () => [...storedRecords],
      highlightSelection: triggerHighlight,
      removeHighlight: triggerDeleteHighlight,
      openDrawer: openNotesDrawer,
      closeDrawer: closeNotesDrawer,
      exportMarkdown: () => exportHighlightsAsMarkdown(
        document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title,
        window.location.href,
        storedRecords
      ),
    };

    // astro 换页清理
    (window as any)[CLEANUP_KEY] = () => {
      document.body.classList.remove('has-selection-dock-open');
      controller.abort();
      if (dockTimeoutId) window.clearTimeout(dockTimeoutId);
      if (stampTimeoutId) window.clearTimeout(stampTimeoutId);
      (window as any)[CLEANUP_KEY] = undefined;
      (window as any).__articleHighlights = undefined;
    };
  }

  let initialized = false;
  function runInit() {
    if (initialized) return;
    initialized = true;
    initArticleHighlights();
  }

  runInit();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', () => {
      initArticleHighlights();
    });
    document.addEventListener('astro:after-swap', () => {
      document.body.classList.remove('has-selection-dock-open');
      initialized = false;
    });
    (window as any)[LISTENER_KEY] = true;
  }
</script>

<style is:global>
  /* =========================================================
     划线高亮样式规范 (Gold Water-Ink Wash & Soft Underline)
     ========================================================= */
  mark.article-highlight-mark {
    background-color: rgba(255, 197, 61, 0.35) !important;
    border-bottom: 1.5px solid rgba(225, 150, 10, 0.75) !important;
