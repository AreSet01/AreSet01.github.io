---
// ArticleSelectionDock.astro — 划词浮动微托盘与文章持久化高亮笔记系统
---

<!-- 1. 底部居中微托盘 (Screen Bottom Floating Micro-Capsule, 100% 零遮挡正文) -->
<aside
  id="article-selection-dock"
  class="article-selection-dock"
  hidden
  role="toolbar"
  aria-label="划词快捷操作微托盘"
  data-lenis-prevent
>
  <div class="selection-dock-capsule" id="selection-dock-capsule">
    <!-- Mode A: 划词创建模式 (Selection Mode) -->
    <div class="dock-actions-row dock-mode-create" id="dock-mode-create">
      <button
        type="button"
        class="dock-action-btn dock-btn-highlight"
        id="dock-act-highlight"
        aria-label="高亮划线 (H)"
        title="高亮划线 (H)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 11-6 6v3h3l6-6"></path>
          <path d="m22 2-2.5 2.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L18 0z"></path>
          <path d="M14.5 5.5 18.5 9.5"></path>
        </svg>
        <span>划线</span>
        <kbd class="dock-kbd">H</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-pin"
        id="dock-act-pin"
        aria-label="钉入工作台 (P)"
        title="钉入分屏工作台对照 (P)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="17" x2="12" y2="22"></line>
          <path d="M5 17h14v-2l-2-2V5a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v8l-2 2v2z"></path>
        </svg>
        <span>钉住</span>
        <kbd class="dock-kbd">P</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-search"
        id="dock-act-search"
        aria-label="搜本文 (F)"
        title="在本文中检索选中文本 (F)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>搜文</span>
        <kbd class="dock-kbd">F</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-ask"
        id="dock-act-ask"
        aria-label="问墨问 AI (A)"
        title="向墨问 AI 发起针对选区的提问 (A)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>墨问</span>
        <kbd class="dock-kbd">A</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-copy"
        id="dock-act-copy"
        aria-label="复制标准引用 (C)"
        title="复制 Markdown 引用卡片 (C)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>引用</span>
        <kbd class="dock-kbd">C</kbd>
      </button>
    </div>

    <!-- Mode B: 已高亮标注管理模式 (Manage Mode) -->
    <div class="dock-actions-row dock-mode-manage" id="dock-mode-manage" hidden style="display: none;">
      <div class="dock-status-tag">
        <span class="dock-status-dot"></span>
        <span class="dock-status-text">已划线</span>
      </div>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-delete"
        id="dock-act-delete"
        aria-label="取消划线 (Delete / Backspace)"
        title="取消高亮划线 (Delete)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        </svg>
        <span>删除</span>
        <kbd class="dock-kbd">Del</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-pin"
        id="dock-act-manage-pin"
        aria-label="钉入工作台 (P)"
        title="钉入工作台 (P)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="17" x2="12" y2="22"></line>
          <path d="M5 17h14v-2l-2-2V5a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v8l-2 2v2z"></path>
        </svg>
        <span>钉住</span>
        <kbd class="dock-kbd">P</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-copy"
        id="dock-act-manage-copy"
        aria-label="复制引用 (C)"
        title="复制引用 (C)"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span>引用</span>
        <kbd class="dock-kbd">C</kbd>
      </button>

      <span class="dock-sep" aria-hidden="true"></span>

      <button
        type="button"
        class="dock-action-btn dock-btn-dismiss"
        id="dock-act-manage-close"
        aria-label="关闭 (Esc)"
        title="关闭管理托盘 (Esc)"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- 水墨复印盖印反馈气泡 (独立顶层容器，托盘或抽屉均能优雅展现) -->
<div class="dock-copy-stamp" id="dock-copy-stamp" aria-hidden="true">
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
  <span id="dock-copy-stamp-text">已复制引用</span>
</div>

<!-- 2. 阅读角常驻高亮笔记悬浮胶囊 (Alongside "搜本文") -->
<button
  type="button"
  id="article-highlights-floating-pill"
  class="article-highlights-floating-pill"
  data-article-notes-trigger
  aria-label="打开高亮笔记列表"
  title="文章高亮笔记 (点击展开批注列表)"
>
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m9 11-6 6v3h3l6-6"></path>
    <path d="m22 2-2.5 2.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L18 0z"></path>
    <path d="M14.5 5.5 18.5 9.5"></path>
  </svg>
  <span class="article-highlights-pill-text">笔记</span>
  <span class="article-highlights-pill-badge" data-notes-count>0</span>
</button>

<!-- 3. 右侧“高亮笔记 (N)”全景抽屉 (Slide-Over Notes Drawer) -->
<div class="article-notes-drawer-backdrop" id="article-notes-backdrop" hidden style="display: none;"></div>
<aside
  class="article-notes-drawer"
  id="article-notes-drawer"
  hidden
  style="display: none;"
  role="dialog"
  aria-label="文章高亮笔记"
  data-lenis-prevent
>
  <div class="drawer-drag-handle max-lg:block hidden" aria-hidden="true"></div>
  <!-- 抽屉头部（52px 通透一体顶栏；单卷态左侧由 CompanionLayout 注入分段切换器，双卷并排态展示此静态标题） -->
  <div class="notes-drawer-header">
    <div class="notes-drawer-header-inner">
      <div class="notes-drawer-title-area">
        <span class="notes-drawer-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </span>
        <h2 class="notes-drawer-heading">高亮笔记</h2>
        <span class="notes-count-tag" id="notes-header-count">0</span>
      </div>
      <div class="notes-drawer-actions">
        <button
          type="button"
          class="notes-drawer-new-icon-btn"
          id="notes-quick-new-btn"
          aria-label="新建随笔"
          data-tip="新建随笔"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
        </button>

        <!-- 更多操作下拉菜单 (新建、导出、同步、清空) -->
        <div class="notes-drawer-menu-wrap" id="notes-drawer-menu-wrap">
          <button
            type="button"
            class="notes-drawer-menu-btn"
            id="notes-drawer-menu-btn"
            aria-label="更多操作"
            aria-haspopup="true"
            aria-expanded="false"
            data-tip="更多操作"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="1.4"></circle>
              <circle cx="19" cy="12" r="1.4"></circle>
              <circle cx="5" cy="12" r="1.4"></circle>
            </svg>
          </button>
          <div class="notes-drawer-dropdown" id="notes-drawer-dropdown" hidden role="menu">
            <button type="button" class="notes-dropdown-item" id="notes-new-btn" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>新建独立笔记</span>
            </button>
            <button type="button" class="notes-dropdown-item" id="notes-export-btn" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
              </svg>
              <span id="notes-export-btn-text">导出 Markdown</span>
            </button>
            <div class="notes-dropdown-divider" aria-hidden="true"></div>
            <button type="button" class="notes-dropdown-item" id="notes-sync-check-btn" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/>
              </svg>
              <span>校验最新状态</span>
            </button>
            <button type="button" class="notes-dropdown-item" id="notes-sync-push-btn" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5M5 12l7-7 7 7"/>
              </svg>
              <span>提交同步 (Push)</span>
            </button>
            <button type="button" class="notes-dropdown-item" id="notes-sync-pull-btn" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
              <span>拉取同步 (Pull)</span>
            </button>
            <div class="notes-dropdown-divider" aria-hidden="true"></div>
            <button type="button" class="notes-dropdown-item is-danger" id="notes-clear-all-btn" role="menuitem">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
              <span>清空全部划线</span>
            </button>
          </div>
        </div>

        <button
          type="button"
          class="notes-drawer-maximize-btn"
          id="notes-drawer-maximize-btn"
          aria-label="全屏展开"
          data-tip="全屏展开"
        >
          <svg width="13.5" height="13.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        </button>
        <button
          type="button"
          class="notes-drawer-close-btn"
          id="notes-drawer-close-btn"
          aria-label="关闭"
          data-tip="关闭"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- 次级细线分类筛选栏（有笔记时在浮岛 / 并排 / 全屏全态常驻，空状态自动隐去保持清净） -->
  <div class="notes-drawer-filter-bar" id="notes-drawer-filter-bar" hidden>
    <div class="notes-drawer-filter-group" id="notes-drawer-filter-group">
      <button type="button" class="notes-filter-pill is-active" data-notes-filter="all">全部</button>
      <button type="button" class="notes-filter-pill" data-notes-filter="highlight">划线</button>
      <button type="button" class="notes-filter-pill" data-notes-filter="ai">墨问摘录</button>
      <button type="button" class="notes-filter-pill" data-notes-filter="free">随笔</button>
      <button type="button" class="notes-filter-pill" data-notes-filter="comment">带备注</button>
    </div>
  </div>

  <!-- 抽屉列表内容区域 -->
  <div class="notes-drawer-body" id="notes-drawer-list" data-lenis-prevent>
    <!-- Dynamic note items rendered here -->
  </div>
</aside>

<script>
  import {
    loadHighlights,
    saveHighlights,
    serializeHighlight,
    applyHighlightToRange,
    removeHighlightFromDOM,
    rehydrateHighlights,
    formatCitation,
    exportHighlightsAsMarkdown,
    saveStandaloneNote,
    deleteStoredNote,
    type ArticleHighlightRecord,
  } from '../utils/articleHighlightEngine';
  import { initNotesSync } from '../utils/notesSync';
  import { renderMarkdown } from '../utils/inkAskMarkdown';
  import { bindScrollIsolation } from '../utils/scrollIsolation';
  import { lockScrollAnchor } from '../utils/scrollAnchorLock';
  import { handleMarkdownKeydown, createMarkdownToolbar } from '../utils/markdownShortcuts';

  initNotesSync();

  const CLEANUP_KEY = '__areSetArticleHighlightsCleanup__';
  const LISTENER_KEY = '__areSetArticleHighlightsBound__';

  function initArticleHighlights() {
    const prevCleanup = (window as any)[CLEANUP_KEY];
    if (typeof prevCleanup === 'function') prevCleanup();

    const prose = document.querySelector<HTMLElement>('[data-post-prose]');
    if (!prose) return;

    const controller = new AbortController();
    const { signal } = controller;

    const postSlug = window.location.pathname;
    let storedRecords: ArticleHighlightRecord[] = loadHighlights(postSlug);
    const postTitle = () => document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title;

    function notifyNotesChanged() {
      document.dispatchEvent(new CustomEvent('article-notes:changed'));
      window.dispatchEvent(new CustomEvent('article-notes:changed'));
    }

    function saveRecords() {
      saveHighlights(postSlug, storedRecords);
      updateBadges();
      const currentDrawer = drawer || document.getElementById('article-notes-drawer');
      if (currentDrawer?.classList.contains('is-open')) {
        renderDrawerNotes();
      }
      notifyNotesChanged();
    }

    function createId(prefix: string) {
      return `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`;
    }

    // DOM Elements
    const dock = document.getElementById('article-selection-dock');
    const dockCapsule = document.getElementById('selection-dock-capsule');
    const modeCreate = document.getElementById('dock-mode-create');
    const modeManage = document.getElementById('dock-mode-manage');
    const copyStamp = document.getElementById('dock-copy-stamp');
    const stampText = document.getElementById('dock-copy-stamp-text');

    const floatingPill = document.getElementById('article-highlights-floating-pill');
    const drawer = document.getElementById('article-notes-drawer');
    const backdrop = document.getElementById('article-notes-backdrop');
    const drawerList = document.getElementById('notes-drawer-list');
    const drawerCloseBtn = document.getElementById('notes-drawer-close-btn');
    const drawerMaxBtn = document.getElementById('notes-drawer-maximize-btn') as HTMLButtonElement | null;
    const notesDrawerHeader = drawer?.querySelector('.notes-drawer-header');

    function captureDrawerCardRects(): Map<string, DOMRect> {
      const rects = new Map<string, DOMRect>();
      if (!drawerList) return rects;
      drawerList.querySelectorAll<HTMLElement>('.notes-item-card').forEach((card) => {
        const id = card.dataset.noteId;
        if (id) rects.set(id, card.getBoundingClientRect());
      });
      return rects;
    }

    let currentNotesFilter = 'all';
    const expandedNoteIds = new Set<string>();
    const useTwoNoteColumns = () =>
      Boolean(
        drawer?.classList.contains('is-maximized') &&
        document.documentElement.getAttribute('data-companion-mode') !== 'split' &&
        window.innerWidth > 960
      );

    const NOTES_MAX_ICON =
      '<svg width="13.5" height="13.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';
    const NOTES_RESTORE_ICON =
      '<svg width="13.5" height="13.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M10 14l-7 7"/></svg>';

    const applyNotesMaxState = (isMax: boolean) => {
      if (!drawer) return;
      drawer.classList.toggle('is-maximized', isMax);
      document.body.classList.toggle('notes-drawer-maximized', isMax);
      if (drawerMaxBtn) {
        drawerMaxBtn.innerHTML = isMax ? NOTES_RESTORE_ICON : NOTES_MAX_ICON;
        drawerMaxBtn.dataset.tip = isMax ? '收为浮岛' : '全屏展开';
        drawerMaxBtn.setAttribute('aria-label', isMax ? '收为浮岛' : '全屏展开');
      }
      if (drawer.classList.contains('is-open')) {
        renderDrawerNotes({ suppressAnimation: true });
      }
    };

    const toggleNotesMaximize = () => {
      if (!drawer) return;
      lockScrollAnchor(400);

      const first = drawer.getBoundingClientRect();
      const isMax = !drawer.classList.contains('is-maximized');
      applyNotesMaxState(isMax);

      const last = drawer.getBoundingClientRect();
      const dx = first.left - last.left;
      const dy = first.top - last.top;
      const sx = first.width / (last.width || 1);
      const sy = first.height / (last.height || 1);

      drawer.style.transformOrigin = 'top left';
      drawer.style.transition = 'none';
      drawer.style.transform = `translate3d(${dx}px, ${dy}px, 0) scale(${sx}, ${sy})`;
      void drawer.offsetHeight; // Force browser layout flush so the inverted transform takes effect!

      drawer.style.transition = 'transform 380ms cubic-bezier(0.16, 1, 0.3, 1), border-radius 380ms ease';
      drawer.style.transform = 'translate3d(0, 0, 0) scale(1, 1)';

      const onEnd = (e: TransitionEvent) => {
        if (e.target !== drawer || e.propertyName !== 'transform') return;
        drawer.style.transition = '';
        drawer.style.transform = '';
        drawer.style.transformOrigin = '';
        drawer.removeEventListener('transitionend', onEnd);
      };
      drawer.addEventListener('transitionend', onEnd);
      setTimeout(() => {
        drawer.style.transition = '';
        drawer.style.transform = '';
        drawer.style.transformOrigin = '';
        drawer.removeEventListener('transitionend', onEnd);
      }, 450);
    };
    const setNotesMaximized = (want: boolean, opts?: { silent?: boolean }) => {
      if (!drawer) return;
      if (drawer.classList.contains('is-maximized') === want) return;
      if (opts?.silent) {
        applyNotesMaxState(want);
        return;
      }
      toggleNotesMaximize();
    };
    drawerMaxBtn?.addEventListener('click', toggleNotesMaximize, { signal });
    notesDrawerHeader?.addEventListener('dblclick', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      toggleNotesMaximize();
    }, { signal });

    const filterBar = document.getElementById('notes-drawer-filter-bar');
    const filterGroup = document.getElementById('notes-drawer-filter-group');
    const quickNewBtn = document.getElementById('notes-quick-new-btn');
    let isFilterSwitching = false;
    function switchNotesFilter(targetFilter: string) {
      if (isFilterSwitching || targetFilter === currentNotesFilter) return;
      if (!drawerList) return;

      currentNotesFilter = targetFilter;
      filterGroup?.querySelectorAll('.notes-filter-pill').forEach((pill) => {
        pill.classList.toggle('is-active', (pill as HTMLElement).dataset.notesFilter === targetFilter);
      });

      const standaloneRecords = loadHighlights('__standalone__').filter((r) => !r.deleted);
      const seenIds = new Set(storedRecords.map((r) => r.id));
      const allRecords = [
        ...storedRecords.filter((r) => !r.deleted),
        ...standaloneRecords.filter((r) => !seenIds.has(r.id)),
      ];
      let nextVisible = allRecords;
      if (targetFilter === 'highlight') {
        nextVisible = nextVisible.filter((r) => (r.kind || 'highlight') === 'highlight');
      } else if (targetFilter === 'ai') {
        nextVisible = nextVisible.filter((r) => r.kind === 'ai');
      } else if (targetFilter === 'free') {
        nextVisible = nextVisible.filter((r) => r.kind === 'free');
      } else if (targetFilter === 'comment') {
        nextVisible = nextVisible.filter((r) => !!r.comment?.trim());
      }
      const nextVisibleIds = new Set(nextVisible.map((r) => r.id));

      const existingCards = Array.from(drawerList.querySelectorAll<HTMLElement>('.notes-item-card'));
      const leavingCards: HTMLElement[] = [];
      const retainedFirstRects = new Map<string, DOMRect>();

      for (const card of existingCards) {
        const id = card.dataset.noteId;
        if (id && nextVisibleIds.has(id)) {
          retainedFirstRects.set(id, card.getBoundingClientRect());
        } else {
          leavingCards.push(card);
        }
      }

      if (leavingCards.length > 0) {
        isFilterSwitching = true;
        // 用 WAAPI 显式播放退场，避免被内联 animation:none / 其它样式覆盖而“瞬间消失”
        const exits = leavingCards.map((card) => {
          card.classList.add('is-filtering-out');
          return card.animate([
            { opacity: 1, transform: 'translate3d(0, 0, 0) scale(1)', filter: 'blur(0px)' },
            { opacity: 0, transform: 'translate3d(0, -8px, 0) scale(0.95)', filter: 'blur(2px)' },
          ], {
            duration: 220,
            easing: 'cubic-bezier(0.4, 0, 1, 1)',
            fill: 'forwards',
          }).finished.catch(() => undefined);
        });
        let switched = false;
        const finishSwitch = () => {
          if (switched) return;
          switched = true;
          renderDrawerNotes({ retainedFirstRects });
          isFilterSwitching = false;
        };
        Promise.all(exits).then(finishSwitch);
        setTimeout(finishSwitch, 320);
      } else {
        renderDrawerNotes({ retainedFirstRects });
      }
    }

    filterGroup?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-notes-filter]');
      if (!btn) return;
      const target = btn.dataset.notesFilter || 'all';
      switchNotesFilter(target);
    }, { signal });
    let unbindDrawerScroll: (() => void) | null = null;
    if (drawer) {
      unbindDrawerScroll = bindScrollIsolation(drawer, {
        scrollableSelector: '.notes-drawer-body',
      });
    }
    const exportBtn = document.getElementById('notes-export-btn');
    const exportBtnText = document.getElementById('notes-export-btn-text');
    const clearAllBtn = document.getElementById('notes-clear-all-btn');
    const newNoteBtn = document.getElementById('notes-new-btn');
    const syncCheckBtn = document.getElementById('notes-sync-check-btn');
    const syncPushBtn = document.getElementById('notes-sync-push-btn');
    const syncPullBtn = document.getElementById('notes-sync-pull-btn');

    // 更多操作下拉菜单逻辑
    const menuBtn = document.getElementById('notes-drawer-menu-btn') as HTMLButtonElement | null;
    const menuDropdown = document.getElementById('notes-drawer-dropdown') as HTMLElement | null;

    const closeMenu = () => {
      if (!menuDropdown || menuDropdown.hidden) return;
      menuDropdown.hidden = true;
      menuBtn?.setAttribute('aria-expanded', 'false');
    };

    menuBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!menuDropdown) return;
      const willOpen = menuDropdown.hidden;
      menuDropdown.hidden = !willOpen;
      menuBtn.setAttribute('aria-expanded', String(willOpen));
    }, { signal });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#notes-drawer-menu-wrap')) {
        closeMenu();
      }
    }, { signal });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuDropdown && !menuDropdown.hidden) {
        e.stopPropagation();
        closeMenu();
      }
    }, { signal });

    menuDropdown?.addEventListener('click', () => {
      closeMenu();
    }, { signal });

    // 检查卡片内容是否超长（> 185px），设置 has-overflow 以激活规整折叠与展开功能
    function checkCardOverflow(card: HTMLElement) {
      const content = card.querySelector<HTMLElement>('.notes-card-content');
      if (!content) return;
      const isOverflow = content.scrollHeight > 185;
      const hadOverflow = card.classList.contains('has-overflow');
      if (isOverflow === hadOverflow) return;
      // 首次渲染/筛选时不要播放 170px 的 max-height 收缩过渡，否则会先撑开再缩回
      content.style.transition = 'none';
      card.classList.toggle('has-overflow', isOverflow);
      void content.offsetHeight;
      content.style.transition = '';
    }

    function restoreExpandedCard(card: HTMLElement) {
      const id = card.dataset.noteId;
      if (!id || !expandedNoteIds.has(id) || card.classList.contains('is-expanded')) return;
      const content = card.querySelector<HTMLElement>('.notes-card-content');
      if (!content) return;
      card.classList.add('is-expanded');
      content.style.maxHeight = 'none';
      const indicator = card.querySelector('.notes-card-expand-indicator');
      if (indicator) indicator.setAttribute('aria-label', '收起笔记');
      const footerText = card.querySelector('.notes-expand-footer-text');
      if (footerText) footerText.textContent = '收起全文';
    }

    function refreshVisibleCardOverflow() {
      if (!drawerList || !drawer?.classList.contains('is-open')) return;
      drawerList.querySelectorAll<HTMLElement>('.notes-item-card').forEach((card) => {
        checkCardOverflow(card);
        restoreExpandedCard(card);
      });
    }

    // 笔记卡片折叠/展开：Web Animations API 真实高度平滑手风琴补间
    function toggleCardExpansion(card: HTMLElement) {
      // 按卡片加锁：卡片被重绘/移除导致动画取消时不会把全局锁卡死
      if (card.dataset.expansionAnimating === 'true') return;
      const content = card.querySelector<HTMLElement>('.notes-card-content');
      if (!content) return;

      const isExpanding = !card.classList.contains('is-expanded');
      const noteId = card.dataset.noteId;
      if (noteId) {
        if (isExpanding) expandedNoteIds.add(noteId);
        else expandedNoteIds.delete(noteId);
      }
      const indicator = card.querySelector('.notes-card-expand-indicator');
      const footerText = card.querySelector('.notes-expand-footer-text');

      card.dataset.expansionAnimating = 'true';
      const releaseLock = () => { delete card.dataset.expansionAnimating; };
      // 高度差越大时长越长，避免长文一帧“闪开”看不到过程
      const durationFor = (delta: number) => Math.round(Math.min(640, Math.max(360, Math.abs(delta) * 0.9)));

      if (isExpanding) {
        const startH = content.getBoundingClientRect().height;
        card.classList.add('is-expanded');
        content.style.maxHeight = 'none';
        const targetH = content.scrollHeight;

        if (indicator) indicator.setAttribute('aria-label', '收起笔记');
        if (footerText) footerText.textContent = '收起全文';

        const anim = content.animate([
          { maxHeight: `${startH}px` },
          { maxHeight: `${targetH}px` }
        ], {
          duration: durationFor(targetH - startH),
          easing: 'cubic-bezier(0.33, 1, 0.68, 1)',
        });

        const onDone = () => {
          content.style.maxHeight = 'none';
          releaseLock();
        };
        anim.onfinish = onDone;
        anim.oncancel = onDone;
      } else {
        const startH = content.getBoundingClientRect().height;
        const targetH = 170; // 规整预览基准高度

        // 若视口已在卡片中下部，收起时平滑将滚动位置对齐到卡片顶部，确保收起后视线始终锁定在当前卡片
        const cardRect = card.getBoundingClientRect();
        const scrollContainer = drawer?.querySelector<HTMLElement>('.notes-drawer-body');
        if (scrollContainer && cardRect.top < 70) {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        if (indicator) indicator.setAttribute('aria-label', '展开笔记');
        if (footerText) footerText.textContent = '展开阅读全文';

        const anim = content.animate([
          { maxHeight: `${startH}px` },
          { maxHeight: `${targetH}px` }
        ], {
          duration: durationFor(startH - targetH),
          easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
          fill: 'forwards'
        });

        let collapsed = false;
        const onDone = () => {
          if (collapsed) return;
          collapsed = true;
          // 先切回折叠态的 CSS max-height，再撤掉动画，避免末帧回弹
          card.classList.remove('is-expanded');
          content.style.maxHeight = '';
          anim.cancel();
          releaseLock();
        };
        anim.onfinish = onDone;
        anim.oncancel = onDone;
      }
    }

    let currentSelectedRange: Range | null = null;
    let activeHighlightId: string | null = null;
    let dockTimeoutId: number | null = null;
    let isDockVisible = false;
    let stampTimeoutId: number | null = null;

    // 1. 初次加载：扫描并重新挂载持久化高亮
    rehydrateHighlights(storedRecords, prose);
    updateBadges();

    window.addEventListener('article-notes:synced', () => {
      const incomingRecords = loadHighlights(postSlug);
      const incomingIds = new Set(
        incomingRecords
          .filter((r) => !r.deleted && (r.kind || 'highlight') === 'highlight')
          .map((r) => r.id)
      );

      // 1. 只有当某条高亮在最新数据中已被删除（或不存在）时，才从 DOM 解包卸载
      for (const record of storedRecords) {
        if (!incomingIds.has(record.id)) {
          removeHighlightFromDOM(record.id, prose);
        }
      }

      // 2. 仅对 DOM 中当前尚不存在的有效记录执行增量挂载，绝不无故拆卸已就位且正常显示的已有高亮
      const missingRecords = incomingRecords.filter((record) => {
        if (record.deleted || (record.kind || 'highlight') !== 'highlight') return false;
        return !prose.querySelector(`mark[data-highlight-id="${record.id}"]`);
      });

      if (missingRecords.length > 0) {
        rehydrateHighlights(missingRecords, prose);
      }

      storedRecords = incomingRecords;
      updateBadges();
      if (drawer?.classList.contains('is-open')) renderDrawerNotes();
    }, { signal });

    // ---------- UI 状态同步 ----------
    function updateBadges() {
      const standaloneCount = loadHighlights('__standalone__').filter((r) => !r.deleted).length;
      const articleCount = storedRecords.filter((r) => !r.deleted).length;
      const count = articleCount + standaloneCount;
      document.querySelectorAll<HTMLElement>('[data-notes-count]').forEach((badge) => {
        badge.textContent = String(count);
        badge.classList.remove('has-bump');
        void badge.offsetWidth;
        badge.classList.add('has-bump');
      });

      const headerCount = document.getElementById('notes-header-count');
      if (headerCount) {
        headerCount.textContent = String(count);
      }

      if (filterBar) {
        filterBar.hidden = count === 0;
        if (count === 0 && currentNotesFilter !== 'all') {
          currentNotesFilter = 'all';
          filterGroup?.querySelectorAll('.notes-filter-pill').forEach((pill) => {
            pill.classList.toggle('is-active', (pill as HTMLElement).dataset.notesFilter === 'all');
          });
        }
      }

      if (floatingPill) {
        floatingPill.classList.toggle('has-notes', count > 0);
      }
    }

    function showStamp(msg: string) {
      if (!copyStamp || !stampText) return;
      stampText.textContent = msg;
      copyStamp.classList.remove('is-active');
      void copyStamp.offsetWidth;
      copyStamp.classList.add('is-active');

      if (stampTimeoutId !== null) window.clearTimeout(stampTimeoutId);
      stampTimeoutId = window.setTimeout(() => {
        copyStamp.classList.remove('is-active');
        stampTimeoutId = null;
      }, 1600);
    }

    // ---------- 底部浮动微托盘展示与隐藏 ----------
    function showDock(mode: 'create' | 'manage') {
      if (!dock || !dockCapsule) return;
      if (dockTimeoutId !== null) {
        window.clearTimeout(dockTimeoutId);
        dockTimeoutId = null;
      }

      // 零遮挡保护 (100% Zero Text Obstruction)
      let targetRect: DOMRect | null = null;
      if (mode === 'create' && currentSelectedRange) {
        targetRect = currentSelectedRange.getBoundingClientRect();
      } else if (mode === 'manage' && activeHighlightId) {
        const mark = prose.querySelector<HTMLElement>(`mark[data-highlight-id="${activeHighlightId}"]`);
        targetRect = mark ? mark.getBoundingClientRect() : null;
      }

      if (targetRect && targetRect.bottom > window.innerHeight - 90) {
        dock.classList.add('is-flipped-top');
        copyStamp?.classList.add('is-flipped-top');
      } else {
        dock.classList.remove('is-flipped-top');
        copyStamp?.classList.remove('is-flipped-top');
      }

      isDockVisible = true;
      document.body.classList.add('has-selection-dock-open');
      dock.hidden = false;
      dock.style.display = 'block';

      if (mode === 'create') {
        if (modeCreate) {
          modeCreate.hidden = false;
          modeCreate.style.display = 'flex';
        }
        if (modeManage) {
          modeManage.hidden = true;
          modeManage.style.display = 'none';
        }
      } else {
        if (modeCreate) {
          modeCreate.hidden = true;
          modeCreate.style.display = 'none';
        }
        if (modeManage) {
          modeManage.hidden = false;
          modeManage.style.display = 'flex';
        }
      }

      dock.classList.remove('is-exiting');
      dock.classList.add('is-entering');

      const onEnterEnd = () => {
        dock?.classList.remove('is-entering');
      };
      dock.addEventListener('animationend', onEnterEnd, { once: true });
    }

    let isDockInteracting = false;

    function hideDock() {
      if (!dock || !isDockVisible) return;
      isDockVisible = false;
      document.body.classList.remove('has-selection-dock-open');

      dock.classList.remove('is-entering');
      dock.classList.add('is-exiting');

      dockTimeoutId = window.setTimeout(() => {
        dock.classList.remove('is-exiting', 'is-flipped-top');
        copyStamp?.classList.remove('is-flipped-top');
        dock.hidden = true;
        dock.style.display = 'none';
        dockTimeoutId = null;
        currentSelectedRange = null;
        activeHighlightId = null;
      }, 320);
    }

    // ---------- 划词检测逻辑 ----------
    let selectionTimer = 0;
    function checkProseSelection() {
      if (isDockInteracting) return;
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0 || selection.isCollapsed) {
        // 如果当前没有点击在已划线 mark 上，则收起 dock
        if (!activeHighlightId) {
          hideDock();
        }
        return;
      }

      const range = selection.getRangeAt(0);
      if (!prose.contains(range.commonAncestorContainer)) {
        if (!activeHighlightId) hideDock();
        return;
      }

      const text = selection.toString().trim();
      if (text.length === 0) {
        if (!activeHighlightId) hideDock();
        return;
      }

      // 有效选区，保存引用并展示创建微托盘
      currentSelectedRange = range.cloneRange();
      activeHighlightId = null;
      showDock('create');
    }

    document.addEventListener('selectionchange', () => {
      window.clearTimeout(selectionTimer);
      selectionTimer = window.setTimeout(checkProseSelection, 120);
    }, { signal });

    // ---------- 点击已有高亮 Mark 触发管理模式 ----------
    prose.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const mark = target?.closest<HTMLElement>('.article-highlight-mark');
      if (mark) {
        e.stopPropagation();
        const id = mark.dataset.highlightId;
        if (id) {
          activeHighlightId = id;
          currentSelectedRange = null;
          try {
            window.getSelection()?.removeAllRanges();
          } catch {}
          showDock('manage');
        }
      }
    }, { signal });

    // 阻止点击微托盘本体导致选区收起或焦点漂移（仅鼠标拦截，触屏设备绝不 preventDefault 以免破坏 iOS Safari 的 click 派发）
    dockCapsule?.addEventListener('pointerdown', (e) => {
      isDockInteracting = true;
      if (e.pointerType === 'mouse') {
        e.preventDefault();
      }
    }, { signal });

    window.addEventListener('pointerup', () => {
      isDockInteracting = false;
    }, { signal });
    window.addEventListener('pointercancel', () => {
      isDockInteracting = false;
    }, { signal });

    // 点击页面空白处关闭 Dock
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as HTMLElement | null;
      if (target?.closest('#article-selection-dock, .article-highlight-mark, #article-highlights-floating-pill, #article-notes-drawer')) {
        return;
      }
      if (isDockVisible) {
        hideDock();
      }
    }, { signal });

    // ---------- 五大核心快捷操作实现 ----------

    // 1. 🖍️ 划线高亮
    function triggerHighlight() {
      if (!currentSelectedRange) return;
      const record = serializeHighlight(currentSelectedRange, prose);
      if (!record) return;

      const marks = applyHighlightToRange(currentSelectedRange, record, true);
      if (marks.length > 0) {
        const now = Date.now();
        const newRecord: ArticleHighlightRecord = {
          ...record,
          kind: 'highlight',
          comment: '',
          postSlug,
          postTitle: postTitle(),
          updatedAt: now,
          dirty: true,
        };
        storedRecords.push(newRecord);

        // 如果抽屉处于打开状态，捕获现有卡片的物理矩形，杜绝旧卡片闪白，并优雅播放 FLIP 下移让位
        const isDrawerOpen = Boolean(drawer?.classList.contains('is-open'));
        const retainedFirstRects = isDrawerOpen ? captureDrawerCardRects() : undefined;

        saveHighlights(postSlug, storedRecords);
        updateBadges();
        if (isDrawerOpen) {
          renderDrawerNotes({ retainedFirstRects, newNoteId: newRecord.id });
        }
        notifyNotesChanged();

        // 水墨笔意舒展动效 (Ink-Sweep: 0.4x 优雅慢调，单笔笔势如流水贯穿整句)
        const totalChars = marks.reduce((sum, m) => sum + Math.max(1, m.textContent?.length || 1), 0);
        const totalDuration = 450; // 0.4x 呼吸节奏

        let accumulatedChars = 0;
        marks.forEach((m) => {
          const charCount = Math.max(1, m.textContent?.length || 1);
          const fraction = charCount / totalChars;
          const delay = Math.round((accumulatedChars / totalChars) * totalDuration);
          const duration = Math.max(30, Math.round(fraction * totalDuration));
          accumulatedChars += charCount;

          m.style.setProperty('--mark-draw-delay', `${delay}ms`);
          m.style.setProperty('--mark-draw-duration', `${duration}ms`);
          m.classList.add('is-drawing');
        });

        // 划完立即清掉原生选区，避免橙红选区与黄色 mark 同时存在，看起来像闪一下
        try {
          window.getSelection()?.removeAllRanges();
        } catch {}

        // 统一在整句笔势绘制完毕后温和清理动效类名，避免分段逐个移除产生图层跳跃或闪烁重演
        setTimeout(() => {
          marks.forEach((m) => {
            m.classList.remove('is-drawing');
            m.style.removeProperty('--mark-draw-delay');
            m.style.removeProperty('--mark-draw-duration');
          });
        }, totalDuration + 60);
      }

      try {
        window.getSelection()?.removeAllRanges();
      } catch {}
      hideDock();
    }

    // 2. 📌 钉入工作台
    function triggerPin(triggerEl?: HTMLElement) {
      let excerptText = '';
      let headingText = '引文片段';
      let sourceAnchor: HTMLElement | null = null;
      let recordId = activeHighlightId;

      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) {
          excerptText = found.text;
          headingText = found.headingText || '引文片段';
        }
        sourceAnchor = prose.querySelector<HTMLElement>(`mark[data-highlight-id="${activeHighlightId}"]`);
      } else if (currentSelectedRange) {
        const info = serializeHighlight(currentSelectedRange, prose);
        excerptText = info?.text || currentSelectedRange.toString().trim();
        if (info) {
          headingText = info.headingText || '引文片段';
        }
        const sc = currentSelectedRange.startContainer;
        sourceAnchor = (sc.nodeType === Node.TEXT_NODE ? sc.parentElement : sc as HTMLElement) || prose;
      }

      if (!excerptText) return;

      const articleTitle = document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title;
      const fullTitle = `${articleTitle} · ${headingText.replace(/^§\s*/, '')}`;

      if ((window as any).__pinWorkbench && typeof (window as any).__pinWorkbench.pinExcerpt === 'function') {
        (window as any).__pinWorkbench.pinExcerpt({
          id: recordId || `quote-${Date.now().toString(36)}`,
          title: fullTitle,
          badge: '引文',
          text: excerptText,
          sourceEl: sourceAnchor,
          triggerBtn: triggerEl,
        });
      } else {
        window.dispatchEvent(new CustomEvent('pin-workbench:add-excerpt', {
          detail: {
            id: recordId || `quote-${Date.now().toString(36)}`,
            title: fullTitle,
            badge: '引文',
            text: excerptText,
            sourceEl: sourceAnchor,
            triggerBtn: triggerEl,
          }
        }));
      }

      showStamp('已钉入工作台');
      hideDock();
    }

    // 3. 🔍 搜本文
    function triggerSearch() {
      let queryText = '';
      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) queryText = found.text;
      } else if (currentSelectedRange) {
        queryText = currentSelectedRange.toString().trim();
      }

      if (!queryText) return;
      const cleanQuery = queryText.replace(/\s+/g, ' ').trim().slice(0, 60);

      hideDock();

      if ((window as any).__articleSearch) {
        (window as any).__articleSearch.open();
        (window as any).__articleSearch.search(cleanQuery);
      } else {
        const trigger = document.querySelector<HTMLElement>('[data-article-search-trigger]');
        trigger?.click();
      }
    }

    // 4. 💬 问墨问
    function triggerAsk() {
      let snippet = '';
      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) snippet = found.text;
      } else if (currentSelectedRange) {
        const info = serializeHighlight(currentSelectedRange, prose);
        snippet = info?.text || currentSelectedRange.toString().trim();
      }

      if (!snippet) return;
      hideDock();

      if ((window as any).__inkAsk && typeof (window as any).__inkAsk.openSidebarWithContext === 'function') {
        (window as any).__inkAsk.openSidebarWithContext(snippet);
      } else {
        window.dispatchEvent(new CustomEvent('inkask:open-with-context', {
          detail: { snippet }
        }));
      }
    }

    // 5. 📋 复制引用
    async function triggerCopy() {
      let text = '';
      let section = '§ 导言 / 正文';
      let headingId: string | undefined = undefined;

      if (activeHighlightId) {
        const found = storedRecords.find((r) => r.id === activeHighlightId);
        if (found) {
          text = found.text;
          section = found.headingText || section;
          headingId = found.headingId;
        }
      } else if (currentSelectedRange) {
        const info = serializeHighlight(currentSelectedRange, prose);
        text = info?.text || currentSelectedRange.toString().trim();
        if (info) {
          section = info.headingText || section;
          headingId = info.headingId;
        }
      }

      if (!text) return;
      const title = document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title;
      const formatted = formatCitation(title, section, window.location.href, text, headingId);

      try {
        await navigator.clipboard.writeText(formatted);
        showStamp('已复制 Markdown 引用');
      } catch {
        showStamp('复制失败');
      }

      setTimeout(() => {
        hideDock();
      }, 700);
    }

    // 6. 🗑️ 取消划线 / 删除笔记（正文平滑褪色 + 抽屉卡片物理淡出 + 唯一单次 FLIP 补位，采用 0.4x 呼吸感节奏）
    function fadeOutAndRemoveHighlight(id: string) {
      const marks = Array.from(prose.querySelectorAll<HTMLElement>(`mark[data-highlight-id="${id}"]`));
      if (marks.length === 0) {
        removeHighlightFromDOM(id, prose);
        return;
      }
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        removeHighlightFromDOM(id, prose);
        return;
      }

      // 只收走底纹，不隐藏文字；文字一旦 opacity:0，解包后会立刻重新出现，造成闪跳 (duration: 550)
      marks.forEach((mark) => {
        mark.classList.remove('is-drawing');
        mark.classList.add('is-fading-out');
        mark.style.setProperty('animation', 'none', 'important');
        mark.style.setProperty('transition', 'background-size 380ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 380ms cubic-bezier(0.4, 0, 0.2, 1)', 'important');
        mark.style.setProperty('background-size', '0% 1.5px, 0% 100%', 'important');
        mark.style.setProperty('box-shadow', 'none', 'important');
      });

      // 380ms 底纹收束完毕后再解包；此时文字始终可见，不会出现空白帧
      setTimeout(() => {
        removeHighlightFromDOM(id, prose);
      }, 380);
    }

    let isDeletingHighlight = false;
    function triggerDeleteHighlight(targetId?: string) {
      if (isDeletingHighlight) return;
      const id = targetId || activeHighlightId;
      if (!id) return;

      isDeletingHighlight = true;
      const target = storedRecords.find((r) => r.id === id);

      // 1. 正文高亮 mark 平滑褪色渐隐（550ms 优雅慢调节奏）
      fadeOutAndRemoveHighlight(id);

      // 2. 更新本地与持久化数据，但【绝不】在此时同步重刷抽屉 DOM，防止卡片被提前抹除
      if (target) {
        target.deleted = true;
        target.updatedAt = Date.now();
        target.dirty = true;
      } else {
        storedRecords = storedRecords.filter((r) => r.id !== id);
      }
      saveHighlights(postSlug, storedRecords);
      updateBadges();
      notifyNotesChanged();

      showStamp((target?.kind || 'highlight') === 'highlight' ? '已取消划线' : '已删除笔记');
      hideDock();

      // 3. 抽屉卡片退出与 FLIP 补位动效
      const isDrawerOpen = drawer?.classList.contains('is-open');
      if (!isDrawerOpen || !drawerList) {
        isDeletingHighlight = false;
        return;
      }

      const targetCard = drawerList.querySelector<HTMLElement>(`.notes-item-card[data-note-id="${id}"]`);
      if (!targetCard) {
        renderDrawerNotes();
        isDeletingHighlight = false;
        return;
      }

      // 卡片在抽屉中：执行纯视觉向右微滑并淡出（450ms），绝对不改变文档流占位高度，其余卡片保持静止
      targetCard.dataset.deleting = 'true';
      smoothRemoveNoteCard(targetCard, false, () => {
        // 第一步：目标卡片已经完全透明隐形，捕获其余所有存留卡片的精确物理视口位置 (First)
        const allCards = Array.from(drawerList.querySelectorAll<HTMLElement>('.notes-item-card'));
        const remainingCards = allCards.filter(c => c !== targetCard);
        const retainedFirstRects = new Map<string, DOMRect>();
        for (const c of remainingCards) {
          const cId = c.dataset.noteId;
          if (cId) retainedFirstRects.set(cId, c.getBoundingClientRect());
        }

        // 第二步：从 DOM 移除目标卡片，重绘列表并执行唯一一次标准 FLIP
        targetCard.remove();
        renderDrawerNotes({ retainedFirstRects });
        isDeletingHighlight = false;
      });
    }

    // 7. 优雅卡片退出动画（保持原位占位纯视觉平移淡出，动画结束后统一重排并执行唯一一次标准 FLIP，彻底消除重复重排与高度突跳）
    function smoothRemoveNoteCard(targetEl: HTMLElement, isGroup: boolean, onComplete: () => void) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        targetEl.remove();
        onComplete();
        return;
      }
      targetEl.style.pointerEvents = 'none';

      const anim = targetEl.animate([
        {
          opacity: 1,
          transform: 'translate3d(0, 0, 0) scale(1)',
          filter: 'blur(0px)',
        },
        {
          opacity: 0,
          transform: 'translate3d(36px, -4px, 0) scale(0.92)',
          filter: 'blur(2px)',
        }
      ], {
        duration: 450, // 0.4x 优雅滑出
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        fill: 'forwards'
      });

      anim.onfinish = () => {
        onComplete();
      };
    }

    // ---------- Dock 按钮事件绑定 ----------
    document.getElementById('dock-act-highlight')?.addEventListener('click', () => triggerHighlight(), { signal });
    document.getElementById('dock-act-pin')?.addEventListener('click', (e) => triggerPin(e.currentTarget as HTMLElement), { signal });
    document.getElementById('dock-act-search')?.addEventListener('click', () => triggerSearch(), { signal });
    document.getElementById('dock-act-ask')?.addEventListener('click', () => triggerAsk(), { signal });
    document.getElementById('dock-act-copy')?.addEventListener('click', () => triggerCopy(), { signal });

    document.getElementById('dock-act-delete')?.addEventListener('click', () => triggerDeleteHighlight(), { signal });
    document.getElementById('dock-act-manage-pin')?.addEventListener('click', (e) => triggerPin(e.currentTarget as HTMLElement), { signal });
    document.getElementById('dock-act-manage-copy')?.addEventListener('click', () => triggerCopy(), { signal });
    document.getElementById('dock-act-manage-close')?.addEventListener('click', () => hideDock(), { signal });

    // 全局快捷键监听 (H / P / F / A / C / Esc / Delete)
    window.addEventListener('keydown', (e) => {
      // 避免输入框内冲突
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || (activeEl as HTMLElement).isContentEditable)) {
        return;
      }

      if (e.key === 'Escape') {
        if (drawer?.classList.contains('is-open')) {
          if (drawer.classList.contains('is-maximized')) {
            e.preventDefault();
            e.stopPropagation();
            toggleNotesMaximize();
            return;
          }
          closeNotesDrawer();
          return;
        }
        if (isDockVisible) {
          try {
            window.getSelection()?.removeAllRanges();
          } catch {}
          hideDock();
          return;
        }
      }

      if (isDockVisible) {
        const key = e.key.toUpperCase();
        if (key === 'H' && currentSelectedRange) {
          e.preventDefault();
          triggerHighlight();
        } else if (key === 'P') {
          e.preventDefault();
          triggerPin();
        } else if (key === 'F') {
          e.preventDefault();
          triggerSearch();
        } else if (key === 'A') {
          e.preventDefault();
          triggerAsk();
        } else if (key === 'C') {
          e.preventDefault();
          triggerCopy();
        } else if (activeHighlightId && (e.key === 'Delete' || e.key === 'Backspace')) {
          e.preventDefault();
          triggerDeleteHighlight();
        }
      }
    }, { signal });

    // ---------- 高亮笔记抽屉 (Notes Drawer) ----------
    // ---------- 草稿保护 ----------
    // 抽屉列表是 innerHTML 全量重绘的（存入 AI 摘录、云端同步、切筛选都会触发），
    // 重绘前把「正在写的便签 / 备注」抓下来，重绘后原位接回去。
    type EditorDraftSnapshot = {
      composerOpen: boolean;
      composerValue: string;
      editorNoteId: string;
      editorValue: string;
      editorIsFree: boolean;
    };

    function captureEditorDrafts(): EditorDraftSnapshot | null {
      if (!drawerList) return null;
      const composer = drawerList.querySelector<HTMLElement>('.notes-composer:not(.is-closing)');
      const composerInput = composer?.querySelector<HTMLTextAreaElement>('textarea');
      const openEditor = drawerList.querySelector<HTMLElement>('.notes-item-comment-editor:not(.is-closing)');
      const editorCard = openEditor?.closest<HTMLElement>('.notes-item-card');
      const editorInput = openEditor?.querySelector<HTMLTextAreaElement>('textarea');
      if (!composer && !openEditor) return null;
      return {
        composerOpen: Boolean(composer),
        composerValue: composerInput?.value ?? '',
        editorNoteId: editorCard?.dataset.noteId || '',
        editorValue: editorInput?.value ?? '',
        editorIsFree: Boolean(editorCard?.querySelector('.notes-btn-edit')),
      };
    }

    function restoreEditorDrafts(snapshot: EditorDraftSnapshot | null, activeBefore: HTMLElement | null = null) {
      if (!snapshot || !drawerList) return;
      const composerHadFocus = Boolean(activeBefore?.classList?.contains('notes-composer-input'));
      if (snapshot.composerOpen) mountNoteComposer(snapshot.composerValue, composerHadFocus);
      if (snapshot.editorNoteId) {
        const card = drawerList.querySelector<HTMLElement>(
          `.notes-item-card[data-note-id="${CSS.escape(snapshot.editorNoteId)}"]`
        );
        const trigger = card?.querySelector<HTMLButtonElement>(
          snapshot.editorIsFree ? '.notes-btn-edit' : '.notes-btn-comment'
        );
        trigger?.click();
        const input = card?.querySelector<HTMLTextAreaElement>('.notes-item-comment-input');
        if (input && snapshot.editorValue) {
          input.value = snapshot.editorValue;
          // 让编辑器按回填后的内容重新量一次高度，避免比原内容长时出现内部滚动条
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
      // 重绘不该抢焦点：如果重绘前焦点在别处（例如墨问输入框），下一帧还回去
      if (activeBefore && !composerHadFocus && !activeBefore.classList?.contains('notes-item-comment-input')) {
        requestAnimationFrame(() => {
          if (activeBefore.isConnected) activeBefore.focus({ preventScroll: true });
        });
      }
    }

    function renderDrawerNotes(opts?: { retainedFirstRects?: Map<string, DOMRect>; suppressAnimation?: boolean; newNoteId?: string }) {
      if (!drawerList) return;
      const prevScrollTop = drawerList.scrollTop;
      const activeBeforeRender = document.activeElement as HTMLElement | null;
      const draftSnapshot = captureEditorDrafts();
      drawerList.innerHTML = '';

      const standaloneRecords = loadHighlights('__standalone__').filter((r) => !r.deleted);
      const seenIds = new Set(storedRecords.map((r) => r.id));
      const allRecords = [
        ...storedRecords.filter((r) => !r.deleted),
        ...standaloneRecords.filter((r) => !seenIds.has(r.id)),
      ];
      let visible = allRecords;
      if (currentNotesFilter === 'highlight') {
        visible = visible.filter((r) => (r.kind || 'highlight') === 'highlight');
      } else if (currentNotesFilter === 'ai') {
        visible = visible.filter((r) => r.kind === 'ai');
      } else if (currentNotesFilter === 'free') {
        visible = visible.filter((r) => r.kind === 'free');
      } else if (currentNotesFilter === 'comment') {
        visible = visible.filter((r) => !!r.comment?.trim());
      }

      if (visible.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'notes-empty-state' + (opts?.retainedFirstRects ? ' is-filtering-in' : '');
        const isTotallyEmpty = allRecords.length === 0;
        empty.innerHTML = `
          <div class="notes-empty-emblem" aria-hidden="true">
            <span class="notes-empty-line"></span>
            <span class="notes-empty-seal">注</span>
            <span class="notes-empty-line"></span>
          </div>
          <p class="notes-empty-title">${isTotallyEmpty ? '卷中尚无批注' : '此分类下暂无记录'}</p>
          <p class="notes-empty-desc">${
            isTotallyEmpty
              ? '展读正文时选中词句即可划线批注，亦可将墨问解答一键摘入此卷，或随手记下一段读书所得。'
              : '当前筛选分类下暂无对应记录，可切换上方标签查看全部批注。'
          }</p>
          ${
            isTotallyEmpty
              ? `<button type="button" class="notes-empty-cta">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                  <span>随手记一笔</span>
                </button>`
              : ''
          }
        `;
        empty.querySelector<HTMLButtonElement>('.notes-empty-cta')?.addEventListener('click', () => {
          mountNoteComposer();
        });
        drawerList.appendChild(empty);
        restoreEditorDrafts(draftSnapshot, activeBeforeRender);
        return;
      }

      const highlights = visible.filter((r) => (r.kind || 'highlight') === 'highlight');
      const aiNotes = visible.filter((r) => r.kind === 'ai');
      const freeNotes = visible.filter((r) => r.kind === 'free');

      const formatTime = (ts: number) => new Date(ts).toLocaleDateString('zh-CN', {
        month: 'numeric',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });

      const COMMENT_CODE_RE = /[{};]|\b(?:class|struct|virtual|void|public|private|protected|return|template|namespace|#include)\b/;

      function splitComment(comment: string): { prose: string; code: string } {
        const lines = comment.split(/\r?\n/);
        const firstCode = lines.findIndex((line, index) => index > 0 && COMMENT_CODE_RE.test(line));
        if (firstCode > 0) {
          const code = lines.slice(firstCode).join('\n').trim();
          if (code) return { prose: lines.slice(0, firstCode).join('\n').trim(), code };
        }
        // 整段都是代码（没有中文说明）时也走代码块，避免逐行软换行
        if (firstCode === 0 && lines.length > 1 && !/[\u4e00-\u9fff]/.test(comment)) {
          return { prose: '', code: comment.trim() };
        }
        return { prose: comment.trim(), code: '' };
      }

      function appendCodeWithBreakPoints(target: HTMLElement, code: string) {
        let buffer = '';
        const flush = () => {
          if (buffer) {
            target.appendChild(document.createTextNode(buffer));
            buffer = '';
          }
        };
        for (const ch of code) {
          buffer += ch;
          if ('(),{};&*'.includes(ch)) {
            flush();
            target.appendChild(document.createElement('wbr'));
          }
        }
        flush();
      }

      function paintComment(container: HTMLElement, comment: string) {
        container.replaceChildren();
        container.hidden = !comment;
        if (!comment) return;

        const { prose, code } = splitComment(comment);
        if (prose) {
          const text = document.createElement('p');
          text.className = 'notes-item-comment-text';
          const label = document.createElement('span');
          label.className = 'notes-item-comment-label';
          label.textContent = '备注：';
          text.append(label, document.createTextNode(prose));
          container.appendChild(text);
        } else {
          const label = document.createElement('span');
          label.className = 'notes-item-comment-label';
          label.textContent = '备注：';
          container.appendChild(label);
        }
        if (code) {
          const pre = document.createElement('pre');
          pre.className = 'notes-item-comment-code';
          const codeEl = document.createElement('code');
          appendCodeWithBreakPoints(codeEl, code);
          pre.appendChild(codeEl);
          container.appendChild(pre);
        }
      }

      function buildCard(item: ArticleHighlightRecord, jumpable: boolean, index = 0, retainedRects?: Map<string, DOMRect>): HTMLElement {
        const card = document.createElement('div');
        card.className = 'notes-item-card';
        card.dataset.noteId = item.id;
        card.dataset.noteKind = item.kind || 'highlight';

        if (retainedRects) {
          // 筛选切换：保留卡只做位置 FLIP，新出现的卡片在渲染后用 WAAPI 补入场
          card.style.animation = 'none';
        } else {
          card.style.animationDelay = `${Math.min(index, 8) * 35}ms`;
        }

        const cardTopRow = document.createElement('div');
        cardTopRow.className = 'notes-card-top-row';

        const metaLead = document.createElement('div');
        metaLead.className = 'notes-card-meta-lead';

        const kindPill = document.createElement('span');
        kindPill.className = 'notes-card-kind-pill';
        kindPill.textContent = item.kind === 'ai' ? '墨问' : item.kind === 'free' ? '随笔' : '划线';

        const chapterTag = document.createElement('span');
        chapterTag.className = 'notes-card-chapter-tag';
        const sectionText = String(item.headingText || '').replace(/^§\s*/, '').trim();
        chapterTag.textContent = sectionText ? `§ ${sectionText}` : '§ 正文段落';

        metaLead.append(kindPill, chapterTag);

        const expandIndicator = document.createElement('button');
        expandIndicator.type = 'button';
        expandIndicator.className = 'notes-card-expand-indicator';
        expandIndicator.setAttribute('aria-label', '展开或收起笔记');
        expandIndicator.title = '展开/收起笔记';
        expandIndicator.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        `;
        expandIndicator.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleCardExpansion(card);
        });

        cardTopRow.append(metaLead, expandIndicator);
        card.appendChild(cardTopRow);

        const contentWrap = document.createElement('div');
        contentWrap.className = 'notes-card-content';

        if (item.kind === 'ai' && item.question) {
          const questionEl = document.createElement('p');
          questionEl.className = 'notes-item-question';
          questionEl.textContent = `问：${item.question}`;
          contentWrap.appendChild(questionEl);
        }

        const body = document.createElement('div');
        body.className = 'notes-item-text notes-item-markdown' + (item.kind === 'highlight' ? ' is-highlight-quote' : '');
        body.innerHTML = renderMarkdown(item.text);
        contentWrap.appendChild(body);

        const commentEl = document.createElement('div');
        commentEl.className = 'notes-item-comment';
        paintComment(commentEl, item.comment || '');
        contentWrap.appendChild(commentEl);

        const fadeVeil = document.createElement('div');
        fadeVeil.className = 'notes-card-fade-veil';
        contentWrap.appendChild(fadeVeil);

        card.appendChild(contentWrap);

        const expandFooter = document.createElement('div');
        expandFooter.className = 'notes-card-expand-footer';
        expandFooter.innerHTML = `
          <button type="button" class="notes-expand-footer-btn">
            <span class="notes-expand-footer-text">展开阅读全文</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
        `;
        expandFooter.querySelector('button')?.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleCardExpansion(card);
        });
        card.appendChild(expandFooter);

        const metaRow = document.createElement('div');
        metaRow.className = 'notes-item-meta';

        const timeSpan = document.createElement('span');
        timeSpan.className = 'notes-item-time';
        timeSpan.textContent = formatTime(item.timestamp);

        const actGroup = document.createElement('div');
        actGroup.className = 'notes-item-actions';

        if (jumpable) {
          const jumpBtn = document.createElement('button');
          jumpBtn.type = 'button';
          jumpBtn.className = 'notes-btn notes-btn-jump';
          jumpBtn.title = '定位到原文';
          jumpBtn.innerHTML = `<span>定位</span>`;
          jumpBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (drawer?.classList.contains('is-maximized')) {
              toggleNotesMaximize();
            }
            jumpToHighlight(item.id);
          });
          actGroup.appendChild(jumpBtn);
        }

        const pinBtn = document.createElement('button');
        pinBtn.type = 'button';
        pinBtn.className = 'notes-btn notes-btn-pin';
        pinBtn.title = '钉入对照工作台';
        pinBtn.innerHTML = `<span>钉住</span>`;
        pinBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          activeHighlightId = item.id;
          triggerPin(pinBtn);
          const span = pinBtn.querySelector('span') || pinBtn;
          const original = span.textContent;
          span.textContent = '已钉住!';
          setTimeout(() => { span.textContent = original; }, 1400);
        });
        actGroup.appendChild(pinBtn);

        if (item.kind === 'free') {
          const editBtn = document.createElement('button');
          editBtn.type = 'button';
          editBtn.className = 'notes-btn notes-btn-edit';
          editBtn.title = '编辑便签正文';
          editBtn.innerHTML = `<span>编辑</span>`;
          editBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (card.querySelector('.notes-item-comment-editor')) {
              card.querySelector<HTMLTextAreaElement>('.notes-item-comment-input')?.focus();
              return;
            }

            const editor = document.createElement('div');
            editor.className = 'notes-item-comment-editor';
            const inner = document.createElement('div');
            inner.className = 'notes-item-comment-editor-inner';
            const textarea = document.createElement('textarea');
            textarea.className = 'notes-item-comment-input';
            textarea.maxLength = 20000;
            textarea.placeholder = '写便签内容…';
            textarea.value = item.text || item.markdown || '';

            const toolbar = createMarkdownToolbar(textarea);

            const actions = document.createElement('div');
            actions.className = 'notes-item-comment-actions';
            const btnGroup = document.createElement('div');
            btnGroup.className = 'notes-composer-btn-group';

            const saveBtn = document.createElement('button');
            saveBtn.type = 'button';
            saveBtn.className = 'notes-btn notes-btn-save';
