  }

  [data-theme="dark"] mark.article-highlight-mark:hover {
    background-color: rgba(255, 197, 61, 0.52) !important;
    border-bottom-color: rgba(255, 215, 80, 0.95) !important;
    box-shadow: 0 0 12px rgba(255, 197, 61, 0.35);
  }

  [data-theme="moss"] mark.article-highlight-mark:hover {
    background-color: rgba(255, 215, 95, 0.52) !important;
    border-bottom-color: rgba(255, 230, 120, 0.95) !important;
  }

  /* 导航定位脉冲动效 */
  mark.article-highlight-mark.has-pulse {
    animation: article-highlight-pulse 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes article-highlight-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 197, 61, 0.85);
      background-color: rgba(255, 197, 61, 0.75) !important;
    }
    45% {
      box-shadow: 0 0 0 10px rgba(255, 197, 61, 0);
      background-color: rgba(255, 197, 61, 0.48) !important;
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 197, 61, 0);
    }
  }

  /* =========================================================
     1. 底部居中微托盘 (Screen Bottom Floating Micro-Capsule)
     ========================================================= */
  .article-selection-dock {
    position: fixed;
    bottom: max(20px, calc(env(safe-area-inset-bottom, 0px) + 16px));
    left: 50%;
    transform: translateX(-50%);
    z-index: 100020;
    pointer-events: auto;
    font-family: var(--font-body);
  }

  .article-selection-dock.is-flipped-top {
    bottom: auto;
    top: max(20px, calc(env(safe-area-inset-top, 0px) + 16px));
  }

  .selection-dock-capsule {
    display: inline-flex;
    align-items: center;
    background: var(--glass-bg-strong, rgba(252, 250, 246, 0.92));
    border: 1px solid var(--rule-strong, rgba(0, 0, 0, 0.22));
    border-radius: 9999px;
    padding: 4px 6px;
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.14),
      0 2px 8px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    user-select: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  [data-theme="dark"] .selection-dock-capsule {
    background: rgba(26, 26, 26, 0.92);
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow:
      0 20px 48px rgba(0, 0, 0, 0.55),
      0 2px 10px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  /* 入场与退场动画 (~420ms enter, ~320ms exit) */
  .article-selection-dock.is-entering {
    animation: selection-dock-in 420ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .article-selection-dock.is-exiting {
    animation: selection-dock-out 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .article-selection-dock.is-flipped-top.is-entering {
    animation: selection-dock-in-top 420ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .article-selection-dock.is-flipped-top.is-exiting {
    animation: selection-dock-out-top 320ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes selection-dock-in {
    from {
      opacity: 0;
      transform: translate3d(-50%, 26px, 0) scale(0.95);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translate3d(-50%, 0, 0) scale(1);
      filter: blur(0);
    }
