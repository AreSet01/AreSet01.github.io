            };
            textarea.addEventListener('input', autoResize);

            // Smooth accordion open animation
            requestAnimationFrame(() => {
              editor.classList.add('is-open');
              textarea.focus({ preventScroll: true });
              autoResize();
            });

            let isClosing = false;
            const closeEditor = () => {
              if (isClosing) return;
              isClosing = true;
              editor.classList.remove('is-open');
              editor.classList.add('is-closing');
              let removed = false;
              const onEnd = () => {
                if (removed) return;
                removed = true;
                editor.removeEventListener('transitionend', onEnd);
                editor.remove();
              };
              editor.addEventListener('transitionend', onEnd);
