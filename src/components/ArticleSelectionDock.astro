            const inner = document.createElement('div');
            inner.className = 'notes-item-comment-editor-inner';
            const textarea = document.createElement('textarea');
            textarea.className = 'notes-item-comment-input';
            textarea.maxLength = 2000;
            textarea.placeholder = '写点备注，比如自己的理解、疑问或补充…';
            textarea.value = item.comment || '';

            const toolbar = createMarkdownToolbar(textarea);

            const actions = document.createElement('div');
            actions.className = 'notes-item-comment-actions';
            const btnGroup = document.createElement('div');
            btnGroup.className = 'notes-composer-btn-group';

            const saveBtn = document.createElement('button');
            saveBtn.type = 'button';
            saveBtn.className = 'notes-btn notes-btn-save';
            saveBtn.textContent = '保存';
            const cancelBtn = document.createElement('button');
            cancelBtn.type = 'button';
            cancelBtn.className = 'notes-btn';
            cancelBtn.textContent = '取消';
            btnGroup.append(cancelBtn, saveBtn);
            actions.append(toolbar, btnGroup);

            inner.append(textarea, actions);
            editor.append(inner);
            card.appendChild(editor);

            const autoResize = () => {
              textarea.style.height = 'auto';
              textarea.style.height = Math.max(68, textarea.scrollHeight) + 'px';
            };
            textarea.addEventListener('input', autoResize);

            // Smooth accordion open animation
            requestAnimationFrame(() => {
              editor.classList.add('is-open');
              textarea.focus({ preventScroll: true });
              autoResize();
            });

            let isClosing = false;
            const closeEditor = () => {
              if (isClosing) return;
              isClosing = true;
              editor.classList.remove('is-open');
              editor.classList.add('is-closing');
              let removed = false;
              const onEnd = () => {
                if (removed) return;
                removed = true;
                editor.removeEventListener('transitionend', onEnd);
                editor.remove();
              };
              editor.addEventListener('transitionend', onEnd);
              setTimeout(onEnd, 320);
            };
            const commit = () => {
              const value = textarea.value.trim();
              item.comment = value;
              item.updatedAt = Date.now();
              item.dirty = true;
              commentEl.hidden = !value;
              paintComment(commentEl, value);
              if (value) {
                commentEl.classList.remove('is-pop');
                void commentEl.offsetWidth;
                commentEl.classList.add('is-pop');
              }
              commentBtn.innerHTML = `<span>${value ? '改备注' : '备注'}</span>`;
              if (item.postSlug === '__standalone__' || item.storageSlug === '__standalone__') {
                saveStandaloneNote(item);
              } else {
                saveHighlights(postSlug, storedRecords);
              }
