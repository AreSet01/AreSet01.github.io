        }

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'notes-btn notes-btn-copy';
        copyBtn.title = '复制 Markdown 引用';
        copyBtn.innerHTML = `<span>复制</span>`;
        copyBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          activeHighlightId = item.id;
          triggerCopy();
          const span = copyBtn.querySelector('span') || copyBtn;
          const original = span.textContent;
          span.textContent = '已复制!';
          setTimeout(() => { span.textContent = original; }, 1400);
