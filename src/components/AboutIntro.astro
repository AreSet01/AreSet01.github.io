---
// About-entry curtain: 「水墨粒子推演 · WELCOME!」
// Dynamic ink-to-pixel particle assembly for About Me Page.
// Harmonized strictly with SiteIntro (rice paper texture, ink wash, uniform swirling ring, page-enter homing).
// Skippable at any moment (Click, Esc / Enter / Space, or Skip button).
---

<div class="about-intro" data-about-intro data-enter-hold aria-hidden="true">
  <canvas class="about-intro-canvas" data-about-canvas></canvas>
  <div class="about-intro-foot" data-about-foot>
    <span class="about-intro-status" data-about-status>ABOUT · 00% · 凝</span>
    <span class="about-intro-progress"><i data-about-progress></i></span>
    <button type="button" class="about-intro-skip" data-about-skip>跳过 <span aria-hidden="true">→</span></button>
  </div>
</div>

<style>
  .about-intro {
    position: fixed;
    inset: 0;
    z-index: 9995;
    background: var(--bg-base);
    overflow: hidden;
    user-select: none;
    touch-action: none;
    opacity: 1;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .about-intro.is-lifting {
    pointer-events: none;
    opacity: 0;
  }

  .about-intro-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .about-intro-foot {
    position: absolute;
    left: 2rem;
    right: 2rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted, #888888);
    opacity: 0;
  }

  .about-intro-progress {
    flex: 1;
    max-width: 240px;
    height: 1px;
    background: var(--rule, rgba(0, 0, 0, 0.12));
    position: relative;
    overflow: hidden;
  }

  .about-intro-progress i {
    position: absolute;
    inset: 0;
    background: var(--ink-strong, #111111);
    transform-origin: left center;
    transform: scaleX(0);
  }

  .about-intro-skip {
    background: none;
    border: none;
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    color: var(--muted-strong, #555555);
    cursor: pointer;
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .about-intro-skip:hover {
    color: var(--text-strong);
    background: var(--ink-mist);
  }
</style>

<script>
  import gsap from 'gsap';

  const TARGET_WORD = 'WELCOME!';

  // Compact, poetic rhythm (total ~5.5s): 凝 → 落 → 散 → 聚 → 成 → 归
  const T = {
    dropForm: 0.2,       // Ink drop begins to form
    detach: 0.5,         // Drop detaches & falls
    impact: 0.85,        // Drop hits canvas & bursts outward radially
    vortex: 1.15,        // Radial burst curls into uniform swirling ring
    converge: 2.1,       // Particles peel off orbit and home inward to assemble "welcome!"
    convergeEnd: 3.1,    // "welcome!" is fully locked and legible
    lift: 4.0,           // Paper begins translucent lift; page elements awaken
    release: 4.25,       // Release page enter; particles disperse toward page elements
    end: 5.5,            // Complete teardown
  };

  const PHASES: Array<[number, string]> = [
    [T.detach, '凝'],
    [T.impact, '落'],
    [T.converge, '散'],
    [T.convergeEnd, '聚'],
    [T.lift, '成'],
    [Infinity, '归'],
  ];

  const STEP = 1 / 120;
  const SKIP_KEYS = new Set(['Escape', 'Enter', ' ', 'Spacebar']);
  const SCROLL_KEYS = new Set(['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End']);

  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const smooth = (a: number, b: number, v: number) => {
    const q = clamp01((v - a) / (b - a));
    return q * q * (3 - 2 * q);
  };
  const rnd = Math.random;

  function cssVar(name: string, fallback: string) {
    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return value || fallback;
  }

  // Rasterize offscreen text into discrete cell center points
  function rasterCells(
    box: { x: number; y: number; w: number; h: number },
    cell: number,
    draw: (c: CanvasRenderingContext2D) => void
  ) {
    const off = document.createElement('canvas');
    off.width = Math.max(1, Math.ceil(box.w));
    off.height = Math.max(1, Math.ceil(box.h));
    const c = off.getContext('2d', { willReadFrequently: true })!;
    c.translate(-box.x, -box.y);
    c.fillStyle = '#000';
    draw(c);
    const { data } = c.getImageData(0, 0, off.width, off.height);
    const out: number[] = [];
    const half = cell >> 1;
    for (let gy = 0; gy + cell <= off.height; gy += cell) {
      const row = (gy + half) * off.width;
      for (let gx = 0; gx + cell <= off.width; gx += cell) {
        if (data[(row + gx + half) * 4 + 3] > 120) {
          out.push(box.x + gx, box.y + gy);
        }
      }
    }
    return out;
  }

  function runAboutIntro() {
    const intro = document.querySelector<HTMLElement>('[data-about-intro]');
    if (!intro) return;
    if (intro.dataset.started === 'true') return;
    intro.dataset.started = 'true';

    // Once per session unless forced via ?about-intro=1 or #about-intro or ?zen=1
    const forced =
      /[?&]about-intro=1(&|$)/.test(location.search) ||
      location.hash === '#about-intro' ||
      /[?&]zen=1(&|$)/.test(location.search);
    let seen = false;
    try {
      seen = sessionStorage.getItem('about-intro-seen') === '1';
    } catch {}
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let released = false;
    const releasePage = (options?: { timeScale?: number }) => {
      if (released) return;
      released = true;
      (window as any).__releasePageEnter?.(options);
    };

    // If SiteIntro is currently active/pending, AboutIntro must NOT run simultaneously
    const siteIntroActive =
      document.documentElement.classList.contains('site-intro-active') ||
      (window as any).__siteIntroPending;

    if (siteIntroActive || (!forced && (seen || reducedMotion))) {
      releasePage();
      intro.remove();
      return;
    }
    try {
      sessionStorage.setItem('about-intro-seen', '1');
    } catch {}

    const canvas = intro.querySelector<HTMLCanvasElement>('[data-about-canvas]')!;
    const foot = intro.querySelector<HTMLElement>('[data-about-foot]')!;
    const status = intro.querySelector<HTMLElement>('[data-about-status]')!;
    const progress = intro.querySelector<HTMLElement>('[data-about-progress]')!;
    const skipBtn = intro.querySelector<HTMLElement>('[data-about-skip]')!;
    const ctx = canvas.getContext('2d');

    const controller = new AbortController();
    const { signal } = controller;

    let finished = false;
    let skipping = false;
    let skipAt = 0;
    let lifted = false;

    if (!ctx) {
      releasePage();
      intro.remove();
      return;
    }

    const holdScroll = () => {
      try {
        const lenis = (window as any).lenis;
        if (lenis && !lenis.isStopped) lenis.stop();
      } catch {}
    };
    holdScroll();

    // Stage dimensions & DPR
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const dpr = Math.min(window.devicePixelRatio || 1, coarse ? 1.5 : 2);
    const W = intro.clientWidth || window.innerWidth;
    const H = intro.clientHeight || window.innerHeight;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);

    const ink = cssVar('--ink-strong', '#111111');
    const theme = document.documentElement.getAttribute('data-theme');
    const grainAlpha = theme === null || theme === 'light' ? 0.05 : 0.075;
    const cx = W / 2;
    const cy = Math.round(H * 0.44);
    const dropX = cx;
    const dropY = Math.round(H * 0.12);

    // Responsive font and cell sizing for "WELCOME!" with wide letter spacing and open counters
    const fontSize = Math.round(Math.max(50, Math.min(W * 0.11, H * 0.16, 92)));
    const font = `700 ${fontSize}px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif`;
    const charSpacing = Math.round(fontSize * 0.22);
    const vortexR = Math.min(W, H) * 0.26;

    // Rasterize "WELCOME!" with crisp 4px cell grid
    let cell = 4;
    let glyphPoints: number[] = [];
    let bx0 = 0, by0 = 0, bx1 = 0, by1 = 0;

    try {
      const off = document.createElement('canvas');
      const meas = off.getContext('2d')!;
      meas.font = font;

      let totalW = 0;
      const charWidths: number[] = [];
      for (const ch of TARGET_WORD) {
        const w = meas.measureText(ch).width;
        charWidths.push(w);
        totalW += w;
      }
      totalW += charSpacing * (TARGET_WORD.length - 1);

      let startX = cx - totalW / 2;
      const charPositions: number[] = [];
      for (let i = 0; i < TARGET_WORD.length; i++) {
        charPositions.push(startX + charWidths[i] / 2);
        startX += charWidths[i] + charSpacing;
      }

      const textH = fontSize * 1.2;
      const box = {
        x: Math.floor(cx - totalW / 2 - cell * 3),
        y: Math.floor(cy - textH / 2 - cell * 3),
        w: Math.ceil(totalW + cell * 6),
        h: Math.ceil(textH + cell * 6),
      };

      glyphPoints = rasterCells(box, cell, (c) => {
        c.font = font;
        c.textBaseline = 'middle';
        c.textAlign = 'center';
        for (let i = 0; i < TARGET_WORD.length; i++) {
          c.fillText(TARGET_WORD[i], charPositions[i], cy);
        }
      });

      bx0 = box.x;
      by0 = box.y;
      bx1 = box.x + box.w;
      by1 = box.y + box.h;
    } catch {
      // Fallback if measurement fails
      glyphPoints = [];
    }

    const G = glyphPoints.length / 2;
    // Total particle count: enough to cover all glyph cells plus ambient mist
    const N = Math.max(coarse ? 900 : 1600, G + 200);

    // Particle state
    // Mode: 0: idle, 1: burst/fly, 2: seek glyph, 3: lock glyph, 4: home to page, 5: dead
    const M_IDLE = 0,
      M_FLY = 1,
      M_SEEK = 2,
      M_LOCK = 3,
      M_HOME = 4,
      M_DEAD = 5;

    const px = new Float32Array(N);
    const py = new Float32Array(N);
    const vx = new Float32Array(N);
    const vy = new Float32Array(N);
    const tx = new Float32Array(N);
    const ty = new Float32Array(N);
    const hx = new Float32Array(N);
    const hy = new Float32Array(N);
    const tA = new Float32Array(N);
    const tH = new Float32Array(N);
    const pref = new Float32Array(N);
    const mode = new Uint8Array(N);
    const isGlyph = new Uint8Array(N);

    let alive = 0;
    let homesAssigned = false;
    let impactOccurred = false;
    let shockRadius = 0;

    // Assign glyph targets to the first G particles, sorted in smooth horizontal flow
    if (G > 0) {
      const indices = Array.from({ length: G }, (_, i) => i);
      indices.sort((a, b) => glyphPoints[a * 2] - glyphPoints[b * 2]);

      for (let k = 0; k < G; k++) {
        const idx = indices[k];
        tx[k] = glyphPoints[idx * 2];
        ty[k] = glyphPoints[idx * 2 + 1];
        isGlyph[k] = 1;
        // Stagger assembly across 2.1s -> 2.9s with slight organic jitter
        const progressFrac = k / G;
        tA[k] = T.converge + progressFrac * 0.75 + (rnd() - 0.5) * 0.12;
      }
    }

    // Set preferred orbital radius for each particle in the vortex
    for (let i = 0; i < N; i++) {
      pref[i] = vortexR * (0.75 + rnd() * 0.45);
    }

    // Spawn all particles on impact with UNIFORM polar angle distribution (zero clumping)
    function spawnRadialBurst() {
      for (let i = 0; i < N; i++) {
        // Uniformly spaced angle with subtle organic jitter to prevent grid lines
        const baseAngle = (i / N) * Math.PI * 2;
        const jitter = (rnd() - 0.5) * (Math.PI * 2 / N) * 0.8;
        const a = baseAngle + jitter;

        const speed = 160 + rnd() * 260;
        const r0 = rnd() * 12;

        px[i] = cx + Math.cos(a) * r0;
        py[i] = cy + Math.sin(a) * r0;
        vx[i] = Math.cos(a) * speed;
        vy[i] = Math.sin(a) * speed;

        mode[i] = M_FLY;
      }
      alive = N;
    }

    // Paper grain tiles
    const grainTiles = [0, 1, 2].map(() => {
      const tile = document.createElement('canvas');
      tile.width = tile.height = 128;
      const c = tile.getContext('2d')!;
      c.fillStyle = ink;
      for (let i = 0; i < 400; i += 1) {
        c.globalAlpha = 0.2 + rnd() * 0.5;
        c.fillRect(Math.floor(rnd() * 128), Math.floor(rnd() * 128), 1, 1);
      }
      return ctx.createPattern(tile, 'repeat')!;
    });
    let grainTile = 0,
      grainX = 0,
      grainY = 0,
      grainAt = -1;

    function dropPos(t: number) {
      if (t < T.detach) return { x: dropX, y: dropY + 8 * smooth(T.dropForm, T.detach, t) };
      const q = clamp01((t - T.detach) / (T.impact - T.detach));
      return { x: dropX, y: dropY + (cy - dropY) * q * q };
    }

    function drawInitialDrop(c: CanvasRenderingContext2D, t: number) {
      if (t >= T.impact) return;
      c.fillStyle = ink;
      const stretch = smooth(T.dropForm, T.detach, t);
      const { x, y } = dropPos(t);
      const rb = 3.5 + 4.5 * smooth(0.1, 0.5, t);
      let rx = rb * (1 - 0.25 * stretch);
      let ry = rb * (1 + 1.1 * stretch);
      if (t >= T.detach) {
        const q = clamp01((t - T.detach) / (T.impact - T.detach));
        rx = rb * 0.75;
        ry = rb * (1.3 + 1.8 * q);
      }
      c.beginPath();
      c.ellipse(x, y, rx, ry, 0, 0, Math.PI * 2);
      c.fill();
    }

    // Compute home positions on the About page
    function computeAboutHomes() {
      const plan: Array<{ el: HTMLElement; at: number }> =
        (window as any).__peekPageEnter?.() ?? [];
      const homes: Array<{ x: number; y: number; at: number }> = [];
      const base = T.release + 0.05;

      plan.forEach((p) => {
        const r = p.el.getBoundingClientRect();
        if (r.width > 4 && r.height > 4 && r.bottom > 0 && r.top < H) {
          const pts = Math.min(100, Math.max(16, Math.round((r.width * r.height) / 200)));
          for (let k = 0; k < pts; k++) {
            homes.push({
              x: r.left + r.width * (0.05 + rnd() * 0.9),
              y: r.top + r.height * (0.05 + rnd() * 0.9),
              at: base + p.at * 0.6,
            });
          }
        }
      });
      return homes;
    }

    function assignHomes(now: number, fast: boolean) {
      if (homesAssigned) return;
      homesAssigned = true;
      const targetHomes = computeAboutHomes();
      const count = targetHomes.length;

      let hIdx = 0;
      for (let i = 0; i < N; i++) {
        if (mode[i] !== M_DEAD) {
          if (count > 0 && hIdx < count) {
            const h = targetHomes[hIdx++];
            hx[i] = h.x + (rnd() - 0.5) * 4;
            hy[i] = h.y + (rnd() - 0.5) * 4;
            tH[i] = fast ? now + 0.05 + rnd() * 0.2 : h.at + rnd() * 0.2;
            mode[i] = M_HOME;
          } else {
            // Dissipate ambient particles cleanly
            mode[i] = M_DEAD;
            alive--;
          }
        }
      }
    }

    // Particle Physics
    function stepPhysics(dt: number, t: number) {
      const vortexMix = smooth(T.vortex, T.vortex + 0.5, t);
      const drag = Math.exp(-2.4 * dt);

      for (let i = 0; i < N; i++) {
        const m = mode[i];
        if (m === M_IDLE || m === M_DEAD) continue;

        // 1. Homeward flight to About page elements
        if (m === M_HOME) {
          if (t < tH[i]) continue;
          const dx = hx[i] - px[i];
          const dy = hy[i] - py[i];
          vx[i] += (dx * 60 - vx[i] * 15) * dt;
          vy[i] += (dy * 60 - vy[i] * 15) * dt;
          const sp = Math.hypot(vx[i], vy[i]);
          if (sp > 2600) {
            vx[i] *= 2600 / sp;
            vy[i] *= 2600 / sp;
          }
          px[i] += vx[i] * dt;
          py[i] += vy[i] * dt;
          if (dx * dx + dy * dy < 9 || t > tH[i] + 0.55) {
            mode[i] = M_DEAD;
            alive--;
          }
          continue;
        }

        // 2. Locked in "welcome!" glyph position
        if (m === M_LOCK) {
          // If curtain lifts and enters release phase, break out of lock to fly home
          if (t >= T.release) {
            mode[i] = M_FLY;
            vx[i] = (rnd() - 0.5) * 80;
            vy[i] = 40 + rnd() * 120;
          }
          continue;
        }

        // 3. Seeking glyph cell
        if (m === M_SEEK) {
          const dx = tx[i] - px[i];
          const dy = ty[i] - py[i];
          vx[i] += (dx * 130 - vx[i] * 24) * dt;
          vy[i] += (dy * 130 - vy[i] * 24) * dt;
          const sp = Math.hypot(vx[i], vy[i]);
          if (sp > 1800) {
            vx[i] *= 1800 / sp;
            vy[i] *= 1800 / sp;
          }
          px[i] += vx[i] * dt;
          py[i] += vy[i] * dt;

          // Lock in place when close and calm
          if ((dx * dx + dy * dy < 2 && sp < 80) || t > tA[i] + 0.6) {
            px[i] = tx[i];
            py[i] = ty[i];
            vx[i] = 0;
            vy[i] = 0;
            mode[i] = M_LOCK;
          }
          continue;
        }

        // 4. M_FLY: check if glyph particle should begin seeking
        if (isGlyph[i] && t >= tA[i]) {
          mode[i] = M_SEEK;
          continue;
        }

        // 5. M_FLY in swirling uniform vortex
        if (vortexMix > 0) {
          const dx = px[i] - cx;
          const dy = py[i] - cy;
          const r = Math.max(1, Math.hypot(dx, dy));
          const nx = dx / r,
            ny = dy / r;
          const tang = Math.min(420, 140 + 72000 / (r + 100));
          const inward = Math.max(-140, Math.min(260, (r - pref[i]) * 0.85));
          const wantX = -ny * tang - nx * inward;
          const wantY = nx * tang - ny * inward;
          const steer = 1 - Math.exp(-3.8 * dt);
          vx[i] += (wantX - vx[i]) * steer * vortexMix;
          vy[i] += (wantY - vy[i]) * steer * vortexMix;
        }

        vx[i] *= drag;
        vy[i] *= drag;
        px[i] += vx[i] * dt;
        py[i] += vy[i] * dt;
      }
    }

    // Render Canvas Frame
    function draw(t: number) {
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx!.clearRect(0, 0, W, H);

      // Paper grain background
      if (!lifted) {
        if (t - grainAt > 0.08) {
          grainAt = t;
          grainTile = (grainTile + 1) % 3;
          grainX = Math.floor(rnd() * 128);
          grainY = Math.floor(rnd() * 128);
        }
        ctx!.globalAlpha = grainAlpha;
        ctx!.fillStyle = grainTiles[grainTile];
        ctx!.save();
        ctx!.translate(grainX, grainY);
        ctx!.fillRect(-grainX - 128, -grainY - 128, W + 256, H + 256);
        ctx!.restore();
        ctx!.globalAlpha = 1;
      }

      // Initial falling drop
      drawInitialDrop(ctx!, t);

      // Shockwave ring on impact
      if (shockRadius > 0) {
        ctx!.save();
        ctx!.strokeStyle = ink;
        ctx!.lineWidth = 1.2;
        ctx!.globalAlpha = Math.max(0, 1 - shockRadius / (vortexR * 1.6));
        ctx!.beginPath();
        ctx!.arc(cx, cy, shockRadius, 0, Math.PI * 2);
        ctx!.stroke();
        ctx!.restore();
      }

      // Draw all active particles
      ctx!.fillStyle = ink;
      const dotSize = coarse ? 3 : 2.5;

      // Render flying & locked particles with clean pixel precision
      for (let i = 0; i < N; i++) {
        const m = mode[i];
        if (m === M_IDLE || m === M_DEAD) continue;

        if (m === M_LOCK) {
          // Locked in "welcome!"
          ctx!.fillRect(px[i], py[i], dotSize, dotSize);
        } else {
          // Flying / seeking / homing
          ctx!.fillRect(px[i], py[i], dotSize, dotSize);
        }
      }
    }

    // Clock and animation loop
    let started = 0,
      last = 0,
      acc = 0,
      simT = 0,
      frameId = 0;
    let currentPhase = '凝';

    function loop(stamp: number) {
      if (finished) return;
      if (!started) {
        started = stamp;
        last = stamp;
      }
      holdScroll();
      const t = (stamp - started) / 1000;
      const dtFrame = Math.min(0.1, (stamp - last) / 1000);
      last = stamp;

      // Handle drop impact
      if (!impactOccurred && t >= T.impact) {
        impactOccurred = true;
        spawnRadialBurst();
        shockRadius = 3;
        (window as any).__inkSplash?.(cx, cy, 22);
      }
      if (shockRadius > 0 && shockRadius < vortexR * 1.6) {
        shockRadius += dtFrame * 340;
      }

      // Physics stepping
      acc += dtFrame;
      let n = 0;
      while (acc >= STEP && n < 10) {
        stepPhysics(STEP, simT);
        simT += STEP;
        acc -= STEP;
        n++;
      }
      if (n >= 10) {
        acc = 0;
        simT = t;
      }

      if (!skipping && !homesAssigned && t >= T.release) {
        assignHomes(t, false);
      }

      draw(t);

      const phase = PHASES.find(([until]) => t < until)?.[1] ?? '归';
      if (phase !== currentPhase) {
        currentPhase = phase;
        intro.dataset.phase = phase;
      }

      if (skipping && (t > skipAt + 0.8 || alive === 0)) {
        finish();
        return;
      }

      frameId = requestAnimationFrame(loop);
    }

    // DOM Timeline for footer & lift
    gsap.set(foot, { opacity: 0, y: 10 });

    const meter = { value: 0 };
    const tl = gsap.timeline();
    tl.to(
      meter,
      {
        value: 1,
        duration: T.release,
        ease: 'none',
        onUpdate: () => {
          progress.style.transform = `scaleX(${meter.value})`;
          status.textContent = `ABOUT · ${String(Math.round(meter.value * 100)).padStart(2, '0')}% · ${currentPhase}`;
        },
      },
      0
    );
    tl.to(foot, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 0.3);

    // Lift and release
    tl.call(
      () => {
        lifted = true;
        intro.classList.add('is-lifting');
      },
      undefined,
      T.lift
    );
    tl.to(foot, { opacity: 0, duration: 0.3, ease: 'power2.in' }, T.lift);
    tl.call(
      () => {
        assignHomes(simT, false);
        releasePage();
      },
      undefined,
      T.release
    );
    tl.call(finish, undefined, T.end);

    let skipFallbackTimer = 0;

    function skip() {
      if (finished) return;
      if (skipping) {
        finish();
        return;
      }
      skipping = true;
      const t = (performance.now() - started) / 1000;
      skipAt = t;
      tl.kill();
      lifted = true;
      intro.classList.add('is-lifting');
      gsap.to(foot, { opacity: 0, duration: 0.2, ease: 'power2.in', overwrite: 'auto' });

      // Guarantee finish() within 300ms fallback
      window.clearTimeout(skipFallbackTimer);
      skipFallbackTimer = window.setTimeout(finish, 300);

      if (!homesAssigned) {
        assignHomes(t, true);
      }
      releasePage();
    }

    function finish() {
      if (finished) return;
      finished = true;
      window.clearTimeout(skipFallbackTimer);
      cancelAnimationFrame(frameId);
      controller.abort();
      tl.kill();
      gsap.killTweensOf([intro, foot]);
      releasePage();
      try {
        sessionStorage.setItem('about-intro-seen', '1');
        if (
          /[?&]about-intro=1(&|$)/.test(location.search) ||
          /[?&]zen=1(&|$)/.test(location.search)
        ) {
          const url = new URL(location.href);
          url.searchParams.delete('about-intro');
          url.searchParams.delete('zen');
          history.replaceState(null, '', url.pathname + (url.search ? url.search : '') + url.hash);
        }
      } catch {}
      intro.remove();
      try {
        (window as any).lenis?.start();
        (window as any).lenis?.resize();
      } catch {}
    }

    skipBtn.addEventListener('click', skip, { signal });
    intro.addEventListener('click', skip, { signal });
    intro.addEventListener('wheel', (e) => e.preventDefault(), { passive: false, signal });
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (SKIP_KEYS.has(e.key)) {
          e.preventDefault();
          skip();
        } else if (SCROLL_KEYS.has(e.key)) {
          e.preventDefault();
        }
      },
      { signal }
    );

    window.addEventListener(
      'resize',
      () => {
        if (!finished) skip();
      },
      { signal, once: true }
    );

    frameId = requestAnimationFrame(loop);
  }

  runAboutIntro();

  document.addEventListener('astro:page-load', () => {
    runAboutIntro();
  });

  document.addEventListener('astro:before-swap', () => {
    try {
      (window as any).lenis?.start();
    } catch {}
  });
</script>
