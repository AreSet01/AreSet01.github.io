---
const year = new Date().getFullYear();
---

<footer class="site-colophon-footer container-wide pb-14 pt-10 md:pb-16 md:pt-14" data-enter="bottom">
  <div class="glow-divider colophon-brush-rule mb-10" aria-hidden="true"></div>
  <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
    <div class="max-w-xl">
      <p class="eyebrow">Colophon</p>
      <h2 class="section-title mt-4">
        不持续且间断更新
      </h2>
      <p class="mt-5 max-w-md text-[0.95rem] leading-relaxed text-[var(--muted)]" style="font-family: var(--font-serif); font-style: italic;">
        这里收集教程、学习记录和一些正在发酵的灵感，让每次更新都更耐读一点。
      </p>
    </div>
    <div class="flex flex-col gap-2.5 text-[0.78rem] md:items-end md:text-right">
      <div class="footer-seal-cluster">
        <span class="footer-seal-whisper" data-footer-whisper aria-live="polite">纸短情长 · 墨落留香</span>
        <button
          type="button"
          class="footer-cinnabar-seal"
          data-footer-seal
          aria-label="钤盖千秋闲章"
          title="轻钤闲章"
        >
          <span class="footer-seal-ring" aria-hidden="true"></span>
          <span class="footer-seal-glyph" aria-hidden="true">千秋</span>
        </button>
        <p class="font-semibold tracking-[0.12em] uppercase text-[var(--text-strong)]">
          &copy; {year} &middot; 梦付千秋
        </p>
      </div>
      <p class="text-[var(--muted)]">
        Built with
        <a
          href="https://astro.build"
          class="footer-astro-link text-[var(--accent)] underline decoration-[var(--accent)] underline-offset-4 hover:text-[var(--accent-deep)]"
          target="_blank"
          rel="noopener"
        >
          Astro
        </a>
        &middot;
        <span class="font-mono">v1.0</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .colophon-brush-rule {
    position: relative;
    overflow: visible;
  }

  .colophon-brush-rule::after {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    width: 64px;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, #b83b28 0%, transparent 100%);
    opacity: 0.72;
    pointer-events: none;
  }

  :global([data-theme="dark"]) .colophon-brush-rule::after {
    background: linear-gradient(90deg, #d9533f 0%, transparent 100%);
  }

  :global([data-theme="moss"]) .colophon-brush-rule::after {
    background: linear-gradient(90deg, #ffc2d1 0%, transparent 100%);
  }

  .footer-seal-cluster {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    position: relative;
  }

  .footer-cinnabar-seal {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.68rem;
    height: 1.68rem;
    padding: 0;
    border-radius: 3px;
    border: 1.25px solid #b83b28;
    background: rgba(184, 59, 40, 0.08);
    color: #b83b28;
    font-family: var(--font-hand-title, serif);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    cursor: pointer;
    transform: rotate(-3.5deg);
    transition:
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      color 220ms ease,
      border-color 220ms ease;
  }

  .footer-cinnabar-seal:hover {
    background: #b83b28;
    color: #fcfaf7;
    transform: rotate(0deg) scale(1.06);
  }

  .footer-cinnabar-seal.is-stamped {
    animation: footerSealPress 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-seal-ring {
    position: absolute;
    inset: -2px;
    border-radius: 4px;
    border: 1px solid #b83b28;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.9);
  }

  .footer-cinnabar-seal.is-stamped .footer-seal-ring {
    animation: footerSealWave 580ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global([data-theme="dark"]) .footer-cinnabar-seal {
    border-color: #d9533f;
    color: #e46653;
    background: rgba(217, 83, 63, 0.12);
  }

  :global([data-theme="dark"]) .footer-cinnabar-seal:hover {
    background: #cf4a36;
    color: #faf8f5;
  }

  :global([data-theme="dark"]) .footer-seal-ring {
    border-color: #d9533f;
  }

  :global([data-theme="moss"]) .footer-cinnabar-seal {
    border-color: rgba(255, 194, 209, 0.78);
    color: #ffd3de;
    background: rgba(255, 194, 209, 0.12);
  }

  :global([data-theme="moss"]) .footer-cinnabar-seal:hover {
    background: #ffc2d1;
    color: #004d40;
  }

  :global([data-theme="moss"]) .footer-seal-ring {
    border-color: #ffc2d1;
  }

  .footer-seal-whisper {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.72rem;
    color: var(--muted);
    opacity: 0;
    transform: translate3d(6px, 0, 0);
    pointer-events: none;
    white-space: nowrap;
    transition:
      opacity 260ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-seal-whisper.is-visible {
    opacity: 0.92;
    transform: translate3d(0, 0, 0);
  }

  @keyframes footerSealPress {
    0% { transform: rotate(-7deg) scale(1.22); }
    42% { transform: rotate(0deg) scale(0.92); }
    100% { transform: rotate(-3.5deg) scale(1); }
  }

  @keyframes footerSealWave {
    0% { opacity: 0.78; transform: scale(0.92); }
    100% { opacity: 0; transform: scale(1.85); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-cinnabar-seal,
    .footer-seal-whisper {
      transition: none !important;
      animation: none !important;
    }
    .footer-cinnabar-seal.is-stamped .footer-seal-ring {
      animation: none !important;
    }
  }
</style>

<script>
  (() => {
    const CLEANUP_KEY = '__areSetFooterSealCleanup__';
    const BOUND_KEY = '__areSetFooterSealBound__';
    const WHISPERS = [
      '纸短情长 · 墨落留香',
      '一期一会 · 岁岁千秋',
      '清风翻卷 · 静水深流',
      '偶得佳句 · 钤印成章',
    ];
    let whisperIdx = 0;

    function initFooterSeal() {
      (window as any)[CLEANUP_KEY]?.();
      const controller = new AbortController();
      const { signal } = controller;
      let whisperTimer = 0;
      let stampTimer = 0;

      document.querySelectorAll<HTMLButtonElement>('[data-footer-seal]').forEach((btn) => {
        const cluster = btn.closest('.footer-seal-cluster');
        const whisperEl = cluster?.querySelector<HTMLElement>('[data-footer-whisper]');

        btn.addEventListener(
          'click',
          (e) => {
            e.stopPropagation();
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduced) {
              btn.classList.remove('is-stamped');
              void btn.offsetWidth;
              btn.classList.add('is-stamped');
              window.clearTimeout(stampTimer);
              stampTimer = window.setTimeout(() => btn.classList.remove('is-stamped'), 460);

              const rect = btn.getBoundingClientRect();
              (window as any).__inkSplash?.(rect.left + rect.width / 2, rect.top + rect.height / 2, 10);
            }

            if (whisperEl) {
              whisperEl.textContent = WHISPERS[whisperIdx % WHISPERS.length];
              whisperIdx += 1;
              whisperEl.classList.add('is-visible');
              window.clearTimeout(whisperTimer);
              whisperTimer = window.setTimeout(() => {
                whisperEl.classList.remove('is-visible');
              }, 2200);
            }
          },
          { signal }
        );
      });

      (window as any)[CLEANUP_KEY] = () => {
        controller.abort();
        window.clearTimeout(whisperTimer);
        window.clearTimeout(stampTimer);
      };
    }

    initFooterSeal();
    if (!(window as any)[BOUND_KEY]) {
      document.addEventListener('astro:page-load', initFooterSeal);
      document.addEventListener('astro:before-swap', () => (window as any)[CLEANUP_KEY]?.());
      (window as any)[BOUND_KEY] = true;
    }
  })();
</script>
