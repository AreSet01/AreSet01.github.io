---
// ZenRainscape.astro — 全站「檐下听雨 · 雨落宣纸微澜」音画微气象背景系统
// 平时保持纯净宣纸底色（0% 开销），开启「墨池听雨」伴读音景时，漫入远近三层斜风细雨、屋檐垂珠与宣纸水晕微澜
---

<canvas
  id="zenRainCanvas"
  transition:persist="zen-rain-canvas"
  class="zen-rain-canvas"
  aria-hidden="true"
  tabindex="-1"
></canvas>

<style>
  .zen-rain-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1; /* 位于纸张底纹之上，正文与交互容器之下 */
    opacity: 0;
    transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity;
  }

  .zen-rain-canvas.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .zen-rain-canvas {
      display: none !important;
      transition: none !important;
    }
  }
</style>

<script>
import { getZenAudioEngine } from '../utils/zenAudioEngine';

(function setupZenRainscape() {
  const CLEANUP_KEY = '__areSetZenRainscapeCleanup__';
  (window as any)[CLEANUP_KEY]?.();

  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let animId: number | null = null;
  let isRunning = false;
  let isModalActive = false;
  let currentOpacity = 0;
  let targetOpacity = 0;
  let width = 0;
  let height = 0;
  let lastFrameTime = 0;
  let unsubscribeEngine: (() => void) | null = null;

  const controller = new AbortController();
  const { signal } = controller;

  interface RainDrop {
    x: number;
    y: number;
    len: number;
    speed: number;
    layer: 0 | 1 | 2; // 0: 远山细雨, 1: 中景青丝, 2: 檐前浓丝
  }

  interface EaveDrip {
    x: number;
    y: number;
    vy: number;
    targetY: number;
    radius: number;
  }

  type RippleTier = 'micro' | 'main' | 'deep';

  interface LakeRipple {
    x: number;
    y: number;
    r: number;
    maxR: number;
    opacity: number;
    speed: number;
    color: string;
    tier: RippleTier;
    isEaveOrigin?: boolean;
  }

  const drops: RainDrop[] = [];
  const eaveDrips: EaveDrip[] = [];
  const lakeRipples: LakeRipple[] = [];
  let nextRippleTime = 0;
  let nextEaveDripTime = 0;

  const maxDrops = 140;
  const maxRipplesDesktop = 55;
  const maxRipplesMobile = 32;
  const baseWindAngle = Math.PI / 11; // ~16 度清风斜雨

  interface RainPalette {
    rain: string;
    ripple: string;
    sealAccent: string;
  }

  function computePalette(): RainPalette {
    const theme = document.documentElement.getAttribute('data-theme') || 'light';
    if (theme === 'dark') {
      return {
        rain: '234, 232, 227',
        ripple: '234, 232, 227',
        sealAccent: '217, 92, 72',
      };
    } else if (theme === 'moss') {
      return {
        rain: '255, 236, 242',
        ripple: '255, 214, 226',
        sealAccent: '255, 194, 209',
      };
    } else if (theme === 'rice') {
      return {
        rain: '43, 36, 28',
        ripple: '52, 43, 33',
        sealAccent: '168, 59, 40',
      };
    }
    return {
      rain: '26, 24, 20',
      ripple: '30, 28, 24',
      sealAccent: '184, 59, 40',
    };
  }

  let cachedPalette: RainPalette = computePalette();

  function refreshPalette() {
    cachedPalette = computePalette();
  }

  function getMaxRipples() {
    return width < 768 ? maxRipplesMobile : maxRipplesDesktop;
  }

  function getNextRippleInterval() {
    return width < 768
      ? 140 + Math.random() * 100 // 移动端 140ms ~ 240ms
      : 80 + Math.random() * 80;   // 桌面端 80ms ~ 160ms，连绵不绝
  }

  function resize() {
    if (!canvas) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
    width = window.innerWidth;
    height = window.innerHeight;
    const targetW = Math.floor(width * dpr);
    const targetH = Math.floor(height * dpr);
    if (canvas.width !== targetW || canvas.height !== targetH) {
      canvas.width = targetW;
      canvas.height = targetH;
    }
    if (ctx) {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
  }

  function initDrops() {
    drops.length = 0;
    eaveDrips.length = 0;
    const count = width < 768 ? Math.floor(maxDrops * 0.6) : maxDrops;
    for (let i = 0; i < count; i++) {
      const roll = Math.random();
      const layer: 0 | 1 | 2 = roll < 0.46 ? 0 : roll < 0.84 ? 1 : 2;
      drops.push({
        x: Math.random() * (width + 320) - 160,
        y: Math.random() * height,
        len: layer === 0 ? 12 + Math.random() * 14 : layer === 1 ? 20 + Math.random() * 18 : 28 + Math.random() * 20,
        speed: layer === 0 ? 5.2 + Math.random() * 2.4 : layer === 1 ? 7.4 + Math.random() * 3.0 : 9.6 + Math.random() * 3.2,
        layer,
      });
    }

    lakeRipples.length = 0;
    const now = performance.now();
    nextRippleTime = now + 90;
    nextEaveDripTime = now + 680;
  }

  function spawnLakeRipple(palette: RainPalette, fixedX?: number, fixedY?: number, fromEave = false) {
    if (lakeRipples.length >= getMaxRipples()) return;

    const rand = Math.random();
    let tier: RippleTier;
    let maxR: number;
    let speed: number;
    let opacity: number;

    if (fromEave) {
      tier = Math.random() < 0.68 ? 'main' : 'deep';
      maxR = tier === 'main' ? 26 + Math.random() * 22 : 52 + Math.random() * 22;
      speed = tier === 'main' ? 0.32 + Math.random() * 0.14 : 0.22 + Math.random() * 0.1;
      opacity = 0.28 + Math.random() * 0.12;
    } else if (rand < 0.45) {
      // 1. 微落点圈 (半径 2~14px)：细雨初触宣纸的灵动微晕
      tier = 'micro';
      maxR = 2.5 + Math.random() * 11.5;
      speed = 0.22 + Math.random() * 0.16;
      opacity = 0.26 + Math.random() * 0.15;
    } else if (rand < 0.88) {
      // 2. 主椭圆双环 (半径 20~45px)：遵循透视比例的宣纸水墨同心微澜
      tier = 'main';
      maxR = 20 + Math.random() * 25;
      speed = 0.30 + Math.random() * 0.18;
      opacity = 0.22 + Math.random() * 0.15;
    } else {
      // 3. 深漫水澜 (半径 50~75px)：悠远扩散的清浅水韵
      tier = 'deep';
      maxR = 50 + Math.random() * 25;
      speed = 0.20 + Math.random() * 0.12;
      opacity = 0.15 + Math.random() * 0.09;
    }

    lakeRipples.push({
      x: fixedX ?? (30 + Math.random() * Math.max(100, width - 60)),
      y: fixedY ?? (40 + Math.random() * Math.max(100, height - 80)),
      r: 1,
      maxR,
      opacity,
      speed,
      color: palette.ripple,
      tier,
      isEaveOrigin: fromEave,
    });
  }

  function spawnEaveDrip() {
    if (eaveDrips.length >= (width < 768 ? 3 : 6)) return;
    eaveDrips.push({
      x: 48 + Math.random() * Math.max(120, width - 96),
      y: -6,
      vy: 3.4 + Math.random() * 1.8,
      targetY: height * (0.18 + Math.random() * 0.64),
      radius: 1.4 + Math.random() * 0.8,
    });
  }

  function loop(stamp?: number) {
    if (!ctx || !canvas || isModalActive) return;
    if (document.hidden) {
      animId = null;
      lastFrameTime = 0;
      return;
    }

    const now = typeof stamp === 'number' && stamp > 0 ? stamp : performance.now();
    // 固定 60fps 基准归一化步长，钳制突发长帧，保证 60/120/165Hz 物理速率恒定
    const dtScale = lastFrameTime > 0 ? Math.min(2.2, Math.max(0.25, (now - lastFrameTime) / 16.6667)) : 1;
    lastFrameTime = now;

    // 帧率无关指数阻尼渐隐渐显
    const alphaLerp = 1 - Math.pow(0.95, dtScale);
    currentOpacity += (targetOpacity - currentOpacity) * alphaLerp;

    if (currentOpacity < 0.005 && targetOpacity === 0) {
      currentOpacity = 0;
      lastFrameTime = 0;
      ctx.clearRect(0, 0, width, height);
      isRunning = false;
      animId = null;
      lakeRipples.length = 0;
      eaveDrips.length = 0;
      return;
    }

    ctx.clearRect(0, 0, width, height);

    const palette = cachedPalette;

    // 1. 连绵宣纸水澜调度器
    if (now >= nextRippleTime && currentOpacity > 0.04) {
      spawnLakeRipple(palette);
      if (lakeRipples.length < getMaxRipples() && Math.random() < 0.40) {
        spawnLakeRipple(palette);
      }
      nextRippleTime = now + getNextRippleInterval();
    }

    // 1.2 檐前垂珠调度器（模拟瓦当檐滴垂落宣纸生起水晕）
    if (now >= nextEaveDripTime && currentOpacity > 0.12) {
      spawnEaveDrip();
      nextEaveDripTime = now + (width < 768 ? 1100 + Math.random() * 900 : 680 + Math.random() * 720);
    }

    // 2. 批量构建多层级微澜 Path2D（零 save/restore，仅 4 档透明度批绘制，消除每帧数十次 Draw Call）
    const ripHigh = new Path2D();
    const ripMid = new Path2D();
    const ripSoft = new Path2D();
    const ripFaint = new Path2D();
    const ripCores = new Path2D();
    const ripEaveRings = new Path2D();
    let cHigh = 0, cMid = 0, cSoft = 0, cFaint = 0, cCores = 0, cEave = 0;

    for (let i = lakeRipples.length - 1; i >= 0; i--) {
      const rip = lakeRipples[i];
      rip.r += rip.speed * dtScale;
      const progress = rip.r / rip.maxR;
      const currentAlpha = rip.opacity * (1 - progress) * currentOpacity;

      // 仅根据物理几何扩展生命周期判断消亡，彻底杜绝淡入淡出阶段误杀年轻波纹
      if (progress >= 1 || rip.r >= rip.maxR) {
        lakeRipples.splice(i, 1);
        continue;
      }

      if (currentAlpha <= 0.003) {
        continue;
      }

      const targetBucket =
        currentAlpha >= 0.20 ? (cHigh++, ripHigh) :
        currentAlpha >= 0.11 ? (cMid++, ripMid) :
        currentAlpha >= 0.05 ? (cSoft++, ripSoft) :
        (cFaint++, ripFaint);

      const aspect = rip.tier === 'micro' ? 0.45 : rip.tier === 'main' ? 0.42 : 0.40;
      const rx = rip.r;
      const ry = rx * aspect;
      targetBucket.moveTo(rip.x + rx, rip.y);
      targetBucket.ellipse(rip.x, rip.y, rx, ry, 0, 0, Math.PI * 2);

      if (rip.tier === 'micro') {
        if (rip.r < 4.2) {
          ripCores.moveTo(rip.x + 1.25, rip.y);
          ripCores.arc(rip.x, rip.y, 1.25, 0, Math.PI * 2);
          cCores++;
        }
      } else if (rip.tier === 'main') {
        if (rip.r > 7.5) {
          const innerRx = rx * 0.62;
          const innerRy = innerRx * 0.42;
          ripSoft.moveTo(rip.x + innerRx, rip.y);
          ripSoft.ellipse(rip.x, rip.y, innerRx, innerRy, 0, 0, Math.PI * 2);
          cSoft++;
        }
        if (rip.r < 6) {
          ripCores.moveTo(rip.x + 1.5, rip.y);
          ripCores.arc(rip.x, rip.y, 1.5, 0, Math.PI * 2);
          cCores++;
        }
        if (rip.isEaveOrigin && rip.r < 18) {
          const eRx = rx * 0.36;
          const eRy = eRx * 0.42;
          ripEaveRings.moveTo(rip.x + eRx, rip.y);
          ripEaveRings.ellipse(rip.x, rip.y, eRx, eRy, 0, 0, Math.PI * 2);
          cEave++;
        }
      } else {
        if (rip.r > 14) {
          const innerRx = rx * 0.70;
          const innerRy = innerRx * 0.40;
          ripFaint.moveTo(rip.x + innerRx, rip.y);
          ripFaint.ellipse(rip.x, rip.y, innerRx, innerRy, 0, 0, Math.PI * 2);
          cFaint++;
        }
      }
    }

    if (cFaint > 0) {
      ctx.lineWidth = 0.6;
      ctx.strokeStyle = `rgba(${palette.ripple}, ${(0.045 * currentOpacity).toFixed(3)})`;
      ctx.stroke(ripFaint);
    }
    if (cSoft > 0) {
      ctx.lineWidth = 0.7;
      ctx.strokeStyle = `rgba(${palette.ripple}, ${(0.095 * currentOpacity).toFixed(3)})`;
      ctx.stroke(ripSoft);
    }
    if (cMid > 0) {
      ctx.lineWidth = 0.8;
      ctx.strokeStyle = `rgba(${palette.ripple}, ${(0.165 * currentOpacity).toFixed(3)})`;
      ctx.stroke(ripMid);
    }
    if (cHigh > 0) {
      ctx.lineWidth = 0.9;
      ctx.strokeStyle = `rgba(${palette.ripple}, ${(0.255 * currentOpacity).toFixed(3)})`;
      ctx.stroke(ripHigh);
    }
    if (cEave > 0) {
      ctx.lineWidth = 0.75;
      ctx.strokeStyle = `rgba(${palette.sealAccent}, ${(0.18 * currentOpacity).toFixed(3)})`;
      ctx.stroke(ripEaveRings);
    }
    if (cCores > 0) {
      ctx.fillStyle = `rgba(${palette.ripple}, ${(0.24 * currentOpacity).toFixed(3)})`;
      ctx.fill(ripCores);
    }

    // 3. 檐前垂珠运动与触纸成澜（单次 Path2D 批绘制）
    if (eaveDrips.length > 0) {
      const dripBeads = new Path2D();
      const dripTails = new Path2D();
      for (let i = eaveDrips.length - 1; i >= 0; i--) {
        const bead = eaveDrips[i];
        bead.vy = Math.min(11.5, bead.vy + 0.16 * dtScale);
        bead.y += bead.vy * dtScale;

        if (bead.y >= bead.targetY) {
          spawnLakeRipple(palette, bead.x, bead.targetY, true);
          eaveDrips.splice(i, 1);
          continue;
        }

        const tailLen = Math.min(16, bead.vy * 1.6);
        dripTails.moveTo(bead.x, bead.y - tailLen);
        dripTails.lineTo(bead.x, bead.y);
        dripBeads.moveTo(bead.x + bead.radius, bead.y);
        dripBeads.ellipse(bead.x, bead.y, bead.radius * 0.78, bead.radius * 1.35, 0, 0, Math.PI * 2);
      }
      ctx.lineWidth = 0.75;
      ctx.strokeStyle = `rgba(${palette.rain}, ${(0.20 * currentOpacity).toFixed(3)})`;
      ctx.stroke(dripTails);
      ctx.fillStyle = `rgba(${palette.rain}, ${(0.28 * currentOpacity).toFixed(3)})`;
      ctx.fill(dripBeads);
    }

    // 4. 远近三层斜风细雨丝批量路径绘制（仅 3 次 stroke 调用替代原 140 次逐根调用）
    const windSway = Math.sin(now * 0.00042) * 0.036;
    const angle = baseWindAngle + windSway;
    const sinAngle = Math.sin(angle);
    const cosAngle = Math.cos(angle);

    const rainFar = new Path2D();
    const rainMid = new Path2D();
    const rainNear = new Path2D();

    for (let i = 0; i < drops.length; i++) {
      const d = drops[i];
      const stepDist = d.speed * dtScale;
      d.x += sinAngle * stepDist;
      d.y += cosAngle * stepDist;

      const endX = d.x + sinAngle * d.len;
      const endY = d.y + cosAngle * d.len;
      if (d.layer === 0) {
        rainFar.moveTo(d.x, d.y);
        rainFar.lineTo(endX, endY);
      } else if (d.layer === 1) {
        rainMid.moveTo(d.x, d.y);
        rainMid.lineTo(endX, endY);
      } else {
        rainNear.moveTo(d.x, d.y);
        rainNear.lineTo(endX, endY);
      }

      // 超出屏幕下边缘即循环回顶部，保持纸面清透无积留
      if (d.y > height + d.len) {
        d.y = -d.len - Math.random() * 44;
        d.x = Math.random() * (width + 320) - 160;
      }
    }

    ctx.lineCap = 'round';
    ctx.lineWidth = 0.65;
    ctx.strokeStyle = `rgba(${palette.rain}, ${(0.11 * currentOpacity).toFixed(3)})`;
    ctx.stroke(rainFar);

    ctx.lineWidth = 0.9;
    ctx.strokeStyle = `rgba(${palette.rain}, ${(0.18 * currentOpacity).toFixed(3)})`;
    ctx.stroke(rainMid);

    ctx.lineWidth = 1.15;
    ctx.strokeStyle = `rgba(${palette.rain}, ${(0.25 * currentOpacity).toFixed(3)})`;
    ctx.stroke(rainNear);

    animId = requestAnimationFrame(loop);
  }

  function start() {
    if (document.documentElement.getAttribute('data-zen-rain') === 'disabled') {
      stop();
      return;
    }
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;

    refreshPalette();
    targetOpacity = 1;
    if (canvas) canvas.classList.add('is-active');

    if (!isRunning) {
      isRunning = true;
      lastFrameTime = 0;
      if (drops.length === 0) initDrops();
      if (animId) cancelAnimationFrame(animId);
      animId = null;
      if (!isModalActive && !document.hidden) {
        animId = requestAnimationFrame(loop);
      }
    } else if (!animId && !isModalActive && !document.hidden) {
      lastFrameTime = 0;
      animId = requestAnimationFrame(loop);
    }
  }

  function stop() {
    targetOpacity = 0;
    if (canvas) canvas.classList.remove('is-active');
  }

  function ensureCanvas() {
    const el = document.getElementById('zenRainCanvas') as HTMLCanvasElement;
    if (!el) return;
    if (el !== canvas || !ctx) {
      canvas = el;
      ctx = canvas.getContext('2d');
    }
    resize();
    refreshPalette();
  }

  function syncWithAudio() {
    try {
      const engine = getZenAudioEngine();
      if (engine.getState().isPlaying) {
        start();
      } else {
        stop();
      }
    } catch (e) {}
  }

  function attachEngineListener() {
    if (unsubscribeEngine) return;
    try {
      const engine = getZenAudioEngine();
      unsubscribeEngine = engine.onStateChange((state) => {
        if (state.isPlaying) {
          start();
        } else {
          stop();
        }
      });
    } catch (e) {
      console.warn('[ZenRainscape] Failed to attach audio listener', e);
    }
  }

  function init() {
    ensureCanvas();
    window.addEventListener('resize', resize, { passive: true, signal });
    window.addEventListener('theme-change', refreshPalette, { signal });
    window.addEventListener('app:modal-enter', () => {
      isModalActive = true;
      lastFrameTime = 0;
      if (animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
    }, { signal });
    window.addEventListener('app:modal-leave', () => {
      isModalActive = false;
      lastFrameTime = 0;
      if (isRunning && !animId && !document.hidden) {
        animId = requestAnimationFrame(loop);
      }
    }, { signal });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        lastFrameTime = 0;
        if (animId) {
          cancelAnimationFrame(animId);
          animId = null;
        }
      } else {
        lastFrameTime = 0;
        if (isRunning && !animId && !isModalActive) {
          animId = requestAnimationFrame(loop);
        }
      }
    }, { signal });
    attachEngineListener();
    syncWithAudio();
  }

  document.addEventListener('astro:page-load', () => {
    isModalActive = false;
    ensureCanvas();
    syncWithAudio();
  }, { signal });

  (window as any)[CLEANUP_KEY] = () => {
    controller.abort();
    if (animId) {
      cancelAnimationFrame(animId);
      animId = null;
    }
    unsubscribeEngine?.();
    unsubscribeEngine = null;
    isRunning = false;
    lastFrameTime = 0;
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true, signal });
  } else {
    init();
  }
})();
</script>
