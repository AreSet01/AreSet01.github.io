---
interface TickerPost {
  title: string;
  href: string;
}

interface Props {
  posts: number;
  tags: number;
  year: number;
  latest: TickerPost[];
  topTags: string[];
}

const { posts, tags, year, latest, topTags } = Astro.props;

type TickerItem =
  | { kind: 'text'; label: string; strong?: boolean }
  | { kind: 'link'; label: string; href: string; prefix?: string }
  | { kind: 'tags'; labels: string[] };

const items: TickerItem[] = [
  { kind: 'text', label: 'Vol. 01 / Digital Garden', strong: true },
  ...latest.map((post, index) => ({
    kind: 'link' as const,
    label: post.title,
    href: post.href,
    prefix: index === 0 ? '最新' : undefined,
  })),
  { kind: 'tags', labels: topTags },
  { kind: 'text', label: `${posts} 篇文章 · ${tags} 个标签 · ${year}` },
  { kind: 'text', label: '不持续且间断更新', strong: true },
  { kind: 'text', label: 'Fresh Ink ↓' },
];
---

<div class="home-ticker" data-ticker data-enter="right">
  <span class="home-ticker-ripple" data-ticker-ripple aria-hidden="true"></span>
  <div class="home-ticker-viewport">
    <div class="home-ticker-track" data-ticker-track>
      <div class="home-ticker-group" data-ticker-group>
        {items.map((item) => (
          <>
            {item.kind === 'text' && (
              <span class:list={['home-ticker-item', { 'is-strong': item.strong }]}>{item.label}</span>
            )}
            {item.kind === 'link' && (
              <a class="home-ticker-item home-ticker-link" href={item.href}>
                {item.prefix && <span class="home-ticker-prefix">{item.prefix} →</span>}
                {item.label}
              </a>
            )}
            {item.kind === 'tags' && (
              <span class="home-ticker-item home-ticker-tags">
                {item.labels.map((tag) => <span class="home-ticker-tag">{tag}</span>)}
              </span>
            )}
            <span class="home-ticker-sep"></span>
          </>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .home-ticker {
    position: relative;
    overflow: hidden;
  }

  /* 落字击中跑马灯时的水墨横澜（纯 transform + opacity 合成层） */
  .home-ticker-ripple {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 180px;
    margin-left: -90px;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--vermilion) 24%, transparent) 0%,
      color-mix(in srgb, var(--accent) 10%, transparent) 48%,
      transparent 76%
    );
    transform: translate3d(0, 0, 0) scaleX(0.35);
    will-change: transform, opacity;
  }

  .home-ticker-track {
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }

  .home-ticker-sep {
    transition: transform 380ms var(--ease-bounce), opacity 280ms var(--ease);
  }

  .home-ticker:hover .home-ticker-sep {
    transform: rotate(135deg) scale(1.18);
    opacity: 0.95;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-ticker-ripple {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const CLEANUP_KEY = '__areSetTickerCleanup__';
  const LISTENER_KEY = '__areSetTickerPageLoadBound__';
  const BASE_SPEED = 42; // px / s at rest
  const HOVER_FACTOR = 0.16;
  const MAX_BOOST = 7;
  const MAX_SKEW = 14;

  function initTicker() {
    const previousCleanup = (window as any)[CLEANUP_KEY];
    if (typeof previousCleanup === 'function') previousCleanup();

    const root = document.querySelector<HTMLElement>('[data-ticker]');
    const track = root?.querySelector<HTMLElement>('[data-ticker-track]');
    const group = root?.querySelector<HTMLElement>('[data-ticker-group]');
    const rippleEl = root?.querySelector<HTMLElement>('[data-ticker-ripple]');
    if (!root || !track || !group) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Runtime state — lerped every frame so direction flips, hover deceleration, and impacts feel weighty
    const state = {
      x: 0,
      dipY: 0,
      dipVel: 0,
      skew: 0,
      dir: -1,        // -1: flows left (scrolling down), 1: flows right (scrolling up)
      dirTarget: -1,
      boost: 1,
      boostTarget: 1,
      hover: 1,
      hoverTarget: 1,
    };

    let groupWidth = 0;
    let rootLeft = 0;
    let idleTimer = 0;
    let resizeTimer = 0;
    let ticking = false;
    let inViewport = false;
    let isModalOpen = false;
    let smoothedVelocity = 0;
    let setSkew: ReturnType<typeof gsap.quickTo> | null = null;
    const clones: HTMLElement[] = [];

    // Clone the group until it covers the viewport twice, so the wrap seam is never visible
    function build() {
      clones.forEach((clone) => clone.remove());
      clones.length = 0;

      const previousWidth = groupWidth;
      const rootRect = root!.getBoundingClientRect();
      rootLeft = rootRect.left;
      groupWidth = group!.getBoundingClientRect().width;
      if (!groupWidth) return;

      const needed = Math.ceil((root!.clientWidth * 2) / groupWidth) + 1;
      const frag = document.createDocumentFragment();
      for (let i = 0; i < needed; i += 1) {
        const clone = group!.cloneNode(true) as HTMLElement;
        clone.removeAttribute('data-ticker-group');
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('a').forEach((link) => link.setAttribute('tabindex', '-1'));
        frag.appendChild(clone);
        clones.push(clone);
      }
      track!.appendChild(frag);

      // Keep the strip where it was (re-wrapped to the new loop length) instead of snapping to 0
      state.x = previousWidth ? gsap.utils.wrap(-groupWidth, 0, state.x) : 0;
    }

    function tick(_time: number, deltaTime: number) {
      if (!groupWidth || reduceMotion) return;
      const dt = Math.min(deltaTime, 64) / 1000;

      // Frame-rate independent exponential damping for silky deceleration on hover
      const smooth6 = 1 - Math.exp(-6.4 * dt);
      const smoothHover = 1 - Math.exp(-7.2 * dt);
      state.dir += (state.dirTarget - state.dir) * smooth6;
      state.boost += (state.boostTarget - state.boost) * (1 - Math.exp(-5.2 * dt));
      state.hover += (state.hoverTarget - state.hover) * smoothHover;

      // Vertical taut-ribbon rebound when struck by falling glyphs
      if (Math.abs(state.dipY) > 0.01 || Math.abs(state.dipVel) > 0.05) {
        const accel = -260 * state.dipY - 19 * state.dipVel;
        state.dipVel += accel * dt;
        state.dipY += state.dipVel * dt;
      } else {
        state.dipY = 0;
        state.dipVel = 0;
      }

      // Deadband early exit: avoid continuous sub-pixel jitter
      if (Math.abs(state.boost - 1) < 0.005 && state.boostTarget === 1) {
        state.boost = 1;
      }
      if (Math.abs(state.skew) < 0.008 && !gsap.isTweening(state)) {
        state.skew = 0;
      }

      const velocity = BASE_SPEED * state.boost * state.hover * state.dir;
      state.x = gsap.utils.wrap(-groupWidth, 0, state.x + velocity * dt);

      // Pure GPU translate3d write — bypasses per-frame GSAP CSS matrix parser overhead
      const xStr = state.x.toFixed(2);
      const yStr = state.dipY === 0 ? '0px' : `${state.dipY.toFixed(2)}px`;
      if (state.skew === 0) {
        track!.style.transform = `translate3d(${xStr}px, ${yStr}, 0px)`;
      } else {
        track!.style.transform = `translate3d(${xStr}px, ${yStr}, 0px) skewX(${state.skew.toFixed(2)}deg)`;
      }
    }

    function startTicking() {
      if (ticking || reduceMotion || document.hidden || isModalOpen || !inViewport) return;
      ticking = true;
      gsap.ticker.add(tick);
    }

    function stopTicking() {
      if (!ticking) return;
      ticking = false;
      gsap.ticker.remove(tick);
    }

    // Snap the skew back with a jelly overshoot once scrolling settles
    function settle() {
      state.boostTarget = 1;
      smoothedVelocity = 0;
      if (setSkew?.tween) {
        setSkew.tween.kill();
        setSkew = null;
      }
      gsap.to(state, {
        skew: 0,
        duration: 1.1,
        ease: 'elastic.out(1, 0.45)',
        overwrite: true,
      });
    }

    function scheduleSettle(delay: number) {
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(settle, delay);
    }

    const scrollWatcher = ScrollTrigger.create({
      onUpdate(self) {
        const rawVelocity = self.getVelocity();
        // EWMA: low-pass velocity filtering to eliminate trackpad jitter and hardware spikes
        smoothedVelocity = smoothedVelocity * 0.35 + rawVelocity * 0.65;
        const magnitude = Math.abs(smoothedVelocity);
        if (magnitude < 40) return;

        state.dirTarget = smoothedVelocity > 0 ? -1 : 1;
        state.boostTarget = gsap.utils.clamp(1, MAX_BOOST, 1 + magnitude / 350);

        if (!setSkew) {
          gsap.killTweensOf(state, 'skew');
          setSkew = gsap.quickTo(state, 'skew', { duration: 0.35, ease: 'power3.out' });
        }
        setSkew(gsap.utils.clamp(-MAX_SKEW, MAX_SKEW, -smoothedVelocity / 160));

        scheduleSettle(140);
      },
    });

    // Only spend frames and scroll listeners while the strip is actually on screen
    const visibility = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        inViewport = entry.isIntersecting;
        if (entry.isIntersecting) {
          startTicking();
          scrollWatcher.enable();
        } else {
          stopTicking();
          scrollWatcher.disable();
        }
      });
    }, { rootMargin: '80px 0px' });
    visibility.observe(root);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopTicking();
      else startTicking();
    }, { signal });

    window.addEventListener('app:modal-enter', () => {
      isModalOpen = true;
      stopTicking();
    }, { signal });

    window.addEventListener('app:modal-leave', () => {
      isModalOpen = false;
      startTicking();
    }, { signal });

    root.addEventListener('pointerenter', () => { state.hoverTarget = HOVER_FACTOR; }, { signal });
    root.addEventListener('pointerleave', () => { state.hoverTarget = 1; }, { signal });
    root.addEventListener('focusin', () => { state.hoverTarget = HOVER_FACTOR; }, { signal });
    root.addEventListener('focusout', () => { state.hoverTarget = 1; }, { signal });

    // Clicking empty strip gives it a shove; clicking a title just follows the link
    function shove(strength = 1) {
      if (reduceMotion) return;
      if (setSkew?.tween) {
        setSkew.tween.kill();
        setSkew = null;
      }
      gsap.killTweensOf(state, 'skew');
      state.boost = Math.max(state.boost, 1 + (MAX_BOOST * 0.72 - 1) * strength);
      state.boostTarget = 1;
      state.dipVel += 52 * strength;
      smoothedVelocity = 0;
      gsap.to(state, {
        skew: state.dir * 9.5 * strength,
        duration: 0.14,
        ease: 'power2.out',
        overwrite: true,
      });
      scheduleSettle(200);
    }

    function impactAt(clientX: number, strength = 1) {
      shove(Math.min(1.15, Math.max(0.35, strength)));
      if (!rippleEl || reduceMotion) return;
      const localX = clientX - rootLeft;
      gsap.killTweensOf(rippleEl);
      gsap.fromTo(
        rippleEl,
        { x: localX, scaleX: 0.25, opacity: 0.85 },
        { x: localX, scaleX: 1.45, opacity: 0, duration: 0.52, ease: 'power2.out', overwrite: true },
      );
    }

    root.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) return;
      impactAt((event as MouseEvent).clientX, 1);
    }, { signal });

    // Let the home page's easter eggs knock and query the strip seamlessly
    (window as any).__tickerShove = shove;
    (window as any).__tickerImpact = impactAt;
    (window as any).__tickerGetFlow = () => ({
      dir: state.dir,
      velocity: BASE_SPEED * state.boost * state.hover * state.dir,
    });

    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(build, 120);
    }, { signal });

    build();
    // Zpix is font-display: swap — re-measure once it lands so the loop seam stays clean
    document.fonts?.ready.then(() => { if (!signal.aborted) build(); });

    (window as any)[CLEANUP_KEY] = () => {
      controller.abort();
      stopTicking();
      (window as any).__tickerShove = undefined;
      (window as any).__tickerImpact = undefined;
      (window as any).__tickerGetFlow = undefined;
      scrollWatcher.kill();
      visibility.disconnect();
      if (setSkew?.tween) {
        setSkew.tween.kill();
        setSkew = null;
      }
      gsap.killTweensOf(state);
      if (rippleEl) gsap.killTweensOf(rippleEl);
      window.clearTimeout(idleTimer);
      window.clearTimeout(resizeTimer);
      (window as any)[CLEANUP_KEY] = undefined;
    };
  }

  initTicker();

  if (!(window as any)[LISTENER_KEY]) {
    document.addEventListener('astro:page-load', initTicker);
    document.addEventListener('astro:before-swap', () => {
      const cleanup = (window as any)[CLEANUP_KEY];
      if (typeof cleanup === 'function') cleanup();
    });
    (window as any)[LISTENER_KEY] = true;
  }
</script>
