    max-height: 76vh;
    max-height: 76dvh;
    padding-bottom: env(safe-area-inset-bottom);
    border-width: 1px 0 0;
    border-radius: 16px 16px 0 0;
    transform: none;
  }
  .ink-ask-card.is-opening {
    transition: clip-path 640ms var(--ease);
  }
  .ink-ask-card.is-closing {
    pointer-events: none;
    transition: clip-path 380ms cubic-bezier(0.55, 0, 0.8, 0.3);
  }

  /* 卡片头部（可拖拽） */
  .ink-ask-head {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.85rem 0.5rem 1rem;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .ink-ask-card.is-dragging .ink-ask-head {
    cursor: grabbing;
  }
  .ink-ask-head-main {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ink-ask-drag-handle {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    opacity: 0.65;
    transition: opacity 180ms ease;
  }
  .ink-ask-head:hover .ink-ask-drag-handle {
    opacity: 1;
    color: var(--text-strong);
  }
  .ink-ask-heading {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }
  .ink-ask-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ink-ask-sep {
    color: var(--muted);
    opacity: 0.4;
  }
  .ink-ask-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text-strong);
  }
  .ink-ask-close {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--muted-strong);
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .ink-ask-close:hover,
  .ink-ask-close:focus-visible {
    outline: none;
    color: var(--text-strong);
    border-color: var(--rule);
    background: var(--accent-soft);
  }

  /* 原选区引用（固定高度弹性，防挤压） */
  .ink-ask-quote-wrap {
    flex-shrink: 0;
    padding: 0.65rem 1.15rem 0.45rem;
  }
  .ink-ask-quote {
    display: -webkit-box;
    margin: 0;
    padding: 0.4rem 0.75rem 0.4rem 0.85rem;
    border-left: 3px solid var(--vermilion);
    border-radius: 0 4px 4px 0;
    background: rgba(var(--vermilion-rgb), 0.04);
    color: var(--muted-strong);
    font-size: 0.9rem;
    line-height: 1.6;
    white-space: pre-line;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  /* 对话流区（可自适应滚动） */
  .ink-ask-thread {
    flex: 1 1 0%;
    min-height: 0;
    padding: 0.75rem 1.1rem 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px dashed var(--rule);
    scrollbar-width: thin;
  }
  .ink-ask-turn + .ink-ask-turn {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule-soft);
  }

  /* 追问样式强化（独立气泡签，高区分度） */
  .ink-ask-q {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0 0 0.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--vermilion);
    border-radius: 6px;
    background: var(--bg-soft);
    color: var(--text-strong);
    font-size: 0.9rem;
    line-height: 1.6;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }
  .ink-ask-q-tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    margin-top: 0.1rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--vermilion);
    border-radius: 999px;
    background: var(--vermilion-soft);
    color: var(--vermilion);
    font-family: var(--font-hand-title);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }
  .ink-ask-q-text {
    flex: 1;
    font-weight: 600;
    word-break: break-word;
  }

  /* 快捷预设提问标签（平易近人、口语通俗） */
  .ink-ask-quick-prompts {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.45rem 1.1rem 0.2rem;
  }
  .ink-ask-pill {
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text);
    font-size: 0.76rem;
    line-height: 1.3;
    cursor: pointer;
    white-space: nowrap;
    transition: all 180ms ease;
  }
  .ink-ask-pill:hover {
    border-color: var(--vermilion);
    color: var(--vermilion);
    background: var(--vermilion-soft);
    transform: translateY(-1px);
  }

  /* 回答正文 */
  .ink-ask-answer {
    font-size: 0.95rem;
    line-height: 1.82;
    overflow-wrap: anywhere;
  }
  .ink-ask-answer > * {
    margin: 0 0 0.65em;
  }
  .ink-ask-answer > :last-child {
    margin-bottom: 0;
  }
  .ink-ask-answer ul {
    padding-left: 1.3em;
    list-style: disc;
  }
  .ink-ask-answer ol {
    padding-left: 1.4em;
    list-style: decimal;
  }
  .ink-ask-answer li {
    margin-bottom: 0.25em;
  }
  .ink-ask-answer li::marker {
    color: var(--ink-strong);
  }
  .ink-ask-answer strong,
  .ink-ask-answer .ink-ask-h {
    color: var(--text-strong);
    font-weight: 700;
  }
  .ink-ask-answer em {
    font-style: italic;
  }
  .ink-ask-answer a {
    color: var(--ink-strong);
    border-bottom: 1px solid currentColor;
  }
  .ink-ask-answer code {
    padding: 0.08em 0.36em;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg-soft);
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }
  .ink-ask-answer pre {
    padding: 0.7rem 0.85rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg-soft);
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .ink-ask-answer pre code {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    white-space: pre;
    overflow-wrap: normal;
  }
  .ink-ask-answer blockquote {
    padding-left: 0.75rem;
    border-left: 2.5px solid var(--rule-strong);
    color: var(--muted-strong);
  }
  .ink-ask-table {
    overflow-x: auto;
  }
  .ink-ask-table table {
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .ink-ask-table th,
  .ink-ask-table td {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }
  .ink-ask-table th {
    background: var(--bg-soft);
    color: var(--text-strong);
  }
  .ink-ask-turn.is-cached .ink-ask-answer {
    animation: ink-ask-surface 520ms var(--ease) both;
  }

  .ink-ask-caret {
    display: inline-block;
    width: 0.45em;
    height: 0.45em;
    margin-left: 0.2em;
    border-radius: 50%;
    background: var(--ink-strong);
    vertical-align: 0.1em;
    animation: ink-ask-breathe 1.1s ease-in-out infinite;
  }
  .ink-ask-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
  }
  .ink-ask-status[hidden] {
    display: none;
  }
  .ink-ask-status.is-error {
    color: var(--text-strong);
  }
  .ink-ask-dots {
    display: inline-flex;
    gap: 0.28rem;
  }
  .ink-ask-dots i {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--ink-strong);
    animation: ink-ask-breathe 1.2s ease-in-out infinite;
  }
  .ink-ask-dots i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .ink-ask-dots i:nth-child(3) {
    animation-delay: 0.36s;
  }
  .ink-ask-retry {
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background 180ms ease;
  }
  .ink-ask-retry:hover {
    background: var(--accent-soft);
  }
  .ink-ask-note {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  /* 输入框与底栏 */
  .ink-ask-form {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem 0.4rem 1rem;
    border-top: 1px solid var(--rule-soft);
    background: var(--bg-soft);
  }
  .ink-ask-input {
    flex: 1;
    min-width: 0;
    height: 36px;
    padding: 0 0.75rem;
    border: 1.5px solid var(--rule);
    border-radius: 6px;
    outline: none;
    background: var(--bg-elev);
    color: var(--text-strong);
    font: inherit;
    font-size: 0.88rem;
    line-height: 36px;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .ink-ask-input::placeholder {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .ink-ask-input:focus {
    border-color: var(--vermilion);
    box-shadow: 0 0 0 2.5px var(--vermilion-soft);
  }
  .ink-ask-send {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--vermilion);
    border-radius: 6px;
    background: var(--bg-elev);
    color: var(--vermilion);
    font-family: var(--font-hand-title);
    font-size: 1rem;
    font-weight: 700;
    box-shadow: inset 0 0 5px var(--vermilion-soft);
    transform: rotate(-3deg);
    cursor: pointer;
    transition: transform 180ms var(--ease-bounce), opacity 180ms ease, background 180ms ease, color 180ms ease;
  }
  .ink-ask-send:hover,
  .ink-ask-send:focus-visible {
    outline: none;
    transform: rotate(0deg) scale(1.05);
    background: var(--vermilion);
    color: var(--bg-base);
  }
  [data-theme="dark"] .ink-ask-send:hover,
  [data-theme="dark"] .ink-ask-send:focus-visible {
    background: #ffffff;
    color: #141414;
    border-color: #ffffff;
  }
  [data-theme="moss"] .ink-ask-send:hover,
  [data-theme="moss"] .ink-ask-send:focus-visible {
    background: var(--accent);
    color: var(--moss-badge-text, #004D40);
    border-color: var(--accent);
  }
  .ink-ask-form.is-busy .ink-ask-send {
    opacity: 0.35;
    pointer-events: none;
    transform: none;
  }
  .ink-ask-foot {
    margin: 0;
    flex-shrink: 0;
    padding: 0.35rem 1.1rem 0.7rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-align: right;
  }

  /* ---------- 右上角 AI 伴读常驻按钮 ---------- */
  .ink-ask-sidebar-trigger {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 99;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem 0.45rem 0.75rem;
    border-radius: 6px;
    background: var(--glass-bg);
    backdrop-filter: blur(14px) saturate(120%);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    border: 1px solid var(--rule-strong);
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.08),
      0 1px 3px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    color: var(--text-strong);
    font-family: var(--font-hand-title);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 240ms ease,
                border-color 240ms ease,
                background 240ms ease,
                transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 240ms ease;
  }
  [data-theme="dark"] .ink-ask-sidebar-trigger {
    background: var(--glass-bg-strong);
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.45),
      0 1px 3px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .ink-ask-sidebar-trigger:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.06) translateX(-3px);
    box-shadow:
      0 10px 32px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .ink-ask-sidebar-icon {
    display: inline-flex;
    align-items: center;
    color: var(--vermilion);
  }
  .ink-ask-sidebar-label {
    line-height: 1;
  }

  /* ---------- 右侧 AI 聊天抽屉 (Drawer) ---------- */
  .ink-ask-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 100010;
    background: rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms ease;
  }
  .ink-ask-drawer-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .ink-ask-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 100011;
    display: flex;
    flex-direction: column;
    width: min(580px, 100vw);
    background: var(--bg-elev);
    border-left: 1px solid var(--rule-strong);
    box-shadow: var(--glass-shadow-lg);
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    font-family: var(--font-hand);
  }
  @media (min-width: 1440px) {
    .ink-ask-drawer {
      width: min(640px, 45vw);
    }
  }
  .ink-ask-drawer.is-open {
    transform: translateX(0);
  }

  .ink-ask-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem 1.4rem 0.8rem;
    border-bottom: 1px solid var(--rule-soft);
    background: var(--bg-soft);
  }
  .ink-ask-drawer-title-area {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .ink-ask-drawer-title {
    margin: 0;
    font-family: var(--font-hand-title);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-strong);
  }
  .ink-ask-drawer-close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--muted-strong);
    cursor: pointer;
    transition: all 180ms ease;
  }
  .ink-ask-drawer-close:hover {
    color: var(--text-strong);
    border-color: var(--rule);
    background: var(--accent-soft);
  }

  .ink-ask-drawer-meta {
    padding: 0.55rem 1.4rem;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--rule-soft);
  }
  .ink-ask-drawer-badge {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg-elev);
    color: var(--muted-strong);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .ink-ask-drawer-body {
    flex: 1 1 0%;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.15rem 1.5rem;
    scrollbar-width: thin;
  }

  .ink-ask-drawer-welcome {
    margin-bottom: 1.2rem;
  }
  .ink-ask-welcome-desc {
    margin: 0 0 1rem;
    color: var(--muted-strong);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .ink-ask-drawer-cards {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ink-ask-quick-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--bg-soft);
    color: var(--text-strong);
    font-size: 0.88rem;
    text-align: left;
    cursor: pointer;
    transition: all 200ms ease;
  }
  .ink-ask-quick-card:hover {
    border-color: var(--vermilion);
    background: var(--vermilion-soft);
    transform: translateX(4px);
  }
  .quick-card-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .quick-card-text {
    flex: 1;
    font-weight: 500;
  }

  .ink-ask-drawer-thread .ink-ask-turn + .ink-ask-turn {
    margin-top: 1.3rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--rule-soft);
  }

  .ink-ask-drawer-form {
    flex-shrink: 0;
    padding: 0.85rem 1.15rem max(0.85rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--rule-soft);
    background: var(--bg-soft);
  }
  .ink-ask-drawer-input-wrap {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.35rem 0.4rem 0.35rem 0.8rem;
    border: 1.5px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--bg-elev);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.04), 0 2px 6px rgba(0, 0, 0, 0.02);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .ink-ask-drawer-input-wrap:focus-within {
    border-color: var(--vermilion);
    box-shadow: 0 0 0 3px var(--vermilion-soft);
  }
  .ink-ask-drawer-input {
    flex: 1;
    min-width: 0;
    height: 24px;
    min-height: 24px;
    max-height: 120px;
    margin: 0.25rem 0;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text-strong);
    font: inherit;
    font-size: 0.92rem;
    line-height: 1.5;
    resize: none;
    overflow-y: hidden;
    scrollbar-width: none;
  }
  .ink-ask-drawer-input::-webkit-scrollbar {
    display: none;
  }
  .ink-ask-drawer-input::placeholder {
    color: var(--muted);
    font-size: 0.88rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ink-ask-drawer-send {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1.5px solid var(--vermilion);
    border-radius: 6px;
    background: var(--vermilion-soft);
    color: var(--vermilion);
    font-family: var(--font-hand-title);
    font-size: 0.95rem;
    font-weight: 700;
    box-shadow: inset 0 0 4px var(--vermilion-soft);
    cursor: pointer;
    transition: transform 180ms var(--ease-bounce), opacity 180ms ease, background 180ms ease, color 180ms ease;
  }
  .ink-ask-drawer-send:hover,
  .ink-ask-drawer-send:focus-visible {
    outline: none;
    transform: scale(1.06);
    background: var(--vermilion);
    color: var(--bg-base);
  }
  [data-theme="dark"] .ink-ask-drawer-send:hover,
  [data-theme="dark"] .ink-ask-drawer-send:focus-visible {
    background: #ffffff;
    color: #141414;
    border-color: #ffffff;
  }
  [data-theme="moss"] .ink-ask-drawer-send:hover,
  [data-theme="moss"] .ink-ask-drawer-send:focus-visible {
    background: var(--accent);
    color: var(--moss-badge-text, #004D40);
    border-color: var(--accent);
  }
  .ink-ask-drawer-form.is-busy .ink-ask-drawer-send {
    opacity: 0.35;
    pointer-events: none;
    transform: none;
  }
  .ink-ask-drawer-foot-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.45rem;
    padding: 0 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }
  .ink-ask-drawer-tip {
    opacity: 0.75;
  }
  .ink-ask-drawer-foot {
    margin: 0;
    opacity: 0.75;
    text-align: right;
  }

  @keyframes ink-ask-stamp {
    0% { opacity: 0; transform: scale(1.7) rotate(-16deg); }
    55% { opacity: 1; transform: scale(0.92) rotate(1deg); }
    100% { opacity: 1; transform: scale(1) rotate(-4deg); }
  }
