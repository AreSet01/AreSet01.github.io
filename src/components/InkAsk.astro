---
// InkAsk.astro — 墨问 · AI 伴读与划词问答
// 1. 在正文里选中一段 → 选区末尾钤出「问」→ 墨圈圈出，卡片流式写出通俗生动的解答，支持拖拽移动窗口。
// 2. 右上角常驻「墨问 AI」伴读按钮 → 点击滑出右侧全文伴读侧边栏，支持多轮深入探讨。
// 3. 服务端是 server/ask.mjs。
---

<script>
  import { marked } from 'marked';

  const ENDPOINT = '/api/ask';
  const MAX_SELECTION = 400;
  const ANCHOR_CHARS = 40;
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const LISTENER_KEY = '__areSetInkAskBound__';
  const SKIP = '.code-block-toolbar, .mermaid-block-header, button, [aria-hidden="true"]';
  const BLOCK = 'p, li, pre, td, th, blockquote, h1, h2, h3, h4, h5, h6, dt, dd, figcaption, .mermaid-block';

  type Anchor = { text: string; prefix: string; suffix: string };
  type Box = { left: number; top: number; right: number; bottom: number; width: number; height: number };
  type Session = {
    card: HTMLElement;
    thread: HTMLElement;
    form: HTMLFormElement;
    input: HTMLInputElement;
    ring: SVGSVGElement;
    range: Range;
    anchor: Anchor;
    origin: { x: number; y: number };
    controller: AbortController | null;
    stop: AbortController;
    userMoved?: boolean;
  };

  let available: Promise<boolean> | null = null;
  let seal: HTMLButtonElement | null = null;
  let sealRange: Range | null = null;
  let session: Session | null = null;
  let mouseDown = false;
  let settleTimer = 0;

  // 侧边栏状态
  let sidebarBtn: HTMLButtonElement | null = null;
  let sidebarDrawer: HTMLElement | null = null;
  let sidebarOverlay: HTMLElement | null = null;
  let sidebarController: AbortController | null = null;

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const useSheet = () => window.innerWidth < 768;
  const prose = () => document.querySelector<HTMLElement>('[data-post-prose]');
  const postTitle = () => document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title || '本文';

  // 探测后端服务是否可用
  function probe(): Promise<boolean> {
    available ??= fetch(ENDPOINT, { cache: 'no-store', signal: AbortSignal.timeout(4000) })
      .then(async (res) => res.ok && (await res.json())?.ok === true)
      .catch(() => false);
    return available;
  }

  // ---------- 选区 → 纯文字 ----------

  function rangeText(range: Range): string {
    const fragment = range.cloneContents();
    fragment.querySelectorAll(SKIP).forEach((el) => el.remove());
    fragment.querySelectorAll(BLOCK).forEach((el) => el.append('\n'));
    return (fragment.textContent || '')
      .replace(/[ \t\f\r ]+/g, ' ')
      .replace(/ *\n */g, '\n')
      .replace(/\n{2,}/g, '\n')
      .trim();
  }

  function blockOf(node: Node, root: HTMLElement): Node {
    const el = node instanceof Element ? node : node.parentElement;
    const block = el?.closest(BLOCK);
    return block && root.contains(block) ? block : root;
  }

  function anchorOf(range: Range, root: HTMLElement): Anchor {
    const before = document.createRange();
    before.setStart(blockOf(range.startContainer, root), 0);
    before.setEnd(range.startContainer, range.startOffset);
    const endBlock = blockOf(range.endContainer, root);
    const after = document.createRange();
    after.setStart(range.endContainer, range.endOffset);
    after.setEnd(endBlock, endBlock.childNodes.length);
    return {
      text: rangeText(range),
      prefix: rangeText(before).slice(-ANCHOR_CHARS),
      suffix: rangeText(after).slice(0, ANCHOR_CHARS),
    };
  }

  function lineRects(range: Range): DOMRect[] {
    return Array.from(range.getClientRects()).filter((r) => r.width > 1 && r.height > 1);
  }

  function boxOf(rects: DOMRect[]): Box {
    const left = Math.min(...rects.map((r) => r.left));
    const top = Math.min(...rects.map((r) => r.top));
    const right = Math.max(...rects.map((r) => r.right));
    const bottom = Math.max(...rects.map((r) => r.bottom));
    return { left, top, right, bottom, width: right - left, height: bottom - top };
  }

  // ---------- 「问」印 ----------

  function ensureSeal(): HTMLButtonElement {
    if (seal?.isConnected) return seal;
    seal = document.createElement('button');
    seal.type = 'button';
    seal.className = 'ink-ask-seal';
    seal.textContent = '问';
    seal.title = '问问 AI（通俗解释）';
    seal.setAttribute('aria-label', '问 AI：通俗解释选中的内容');
    seal.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') event.preventDefault();
    });
    seal.addEventListener('click', () => {
      const root = prose();
      if (sealRange && root) open(sealRange, root);
    });
    seal.addEventListener('animationend', (event) => {
      if (event.pseudoElement) seal?.classList.remove('is-stamping');
    });
    document.body.append(seal);
    return seal;
  }

  function hideSeal() {
    sealRange = null;
    seal?.classList.remove('is-shown', 'is-stamping');
  }

  function showSeal(range: Range) {
    if (useSheet()) return hideSeal();
    const rects = lineRects(range);
    if (!rects.length) return hideSeal();
    const last = rects[rects.length - 1];
    const button = ensureSeal();
    const size = 34;
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const x = coarse ? last.right - size / 2 : last.right + 6;
    const y = coarse ? last.bottom + 22 : last.top + last.height / 2 - size / 2;
    button.style.left = `${Math.round(Math.min(Math.max(x, 8), window.innerWidth - size - 8) + window.scrollX)}px`;
    button.style.top = `${Math.round(y + window.scrollY)}px`;
    const wasShown = button.classList.contains('is-shown');
    sealRange = range.cloneRange();
    button.classList.add('is-shown');
    if (!wasShown && !reduceMotion()) {
      button.classList.remove('is-stamping');
      void button.offsetWidth;
      button.classList.add('is-stamping');
    }
  }

  function checkSelection() {
    const root = prose();
    const selection = window.getSelection();
    if (!root || !selection || selection.rangeCount === 0 || selection.isCollapsed) return hideSeal();
    const range = selection.getRangeAt(0);
    if (!root.contains(range.commonAncestorContainer)) return hideSeal();
    if ([...selection.toString().trim()].length < 2) return hideSeal();
    probe().then((ok) => {
      const now = window.getSelection();
      if (ok && now && now.rangeCount && !now.isCollapsed && now.getRangeAt(0) === range) showSeal(range);
    });
  }

  function settleSoon(delay: number) {
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(checkSelection, delay);
  }

  // ---------- 墨圈 ----------

  function seeded(seed: number) {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function strokePoints(box: Box, seed: number): Array<[number, number]> {
    const rand = seeded(seed);
    const points: Array<[number, number]> = [];
    if (box.height > 220) {
      const x = box.left - 14;
      for (let i = 0; i <= 24; i++) {
        const t = i / 24;
        const hook = Math.sin(t * Math.PI);
        points.push([x - hook * 5 + (rand() - 0.5) * 1.2, box.top - 4 + (box.height + 8) * t]);
      }
      return points;
    }
    const cx = box.left + box.width / 2;
    const cy = box.top + box.height / 2;
    const rx = box.width / 2 + 10 + Math.min(box.width * 0.06, 18);
    const ry = box.height / 2 + 8;
    const start = Math.PI * (1.08 + rand() * 0.14);
    const phase = rand() * Math.PI * 2;
    const steps = 64;
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const angle = start + Math.PI * 2 * 1.1 * t;
      const grow = 1 + 0.07 * t;
      const wobble = 1 + 0.03 * Math.sin(angle * 3 + phase) + 0.018 * Math.sin(angle * 5 + phase * 2);
      points.push([cx + rx * grow * wobble * Math.cos(angle), cy + ry * grow * wobble * Math.sin(angle) - 2.5 * t]);
    }
    return points;
  }

  function drawRing(range: Range, ring?: SVGSVGElement): SVGSVGElement | null {
    const rects = lineRects(range);
    if (!rects.length) return null;
    const box = boxOf(rects);
    const seed = Math.round(box.left * 7 + box.top * 13);
    const strokes = [strokePoints(box, seed), strokePoints(box, seed + 1)];
    const all = strokes.flat();
    const minX = Math.min(...all.map((p) => p[0])) - 4;
    const minY = Math.min(...all.map((p) => p[1])) - 4;
    const width = Math.max(...all.map((p) => p[0])) - minX + 4;
    const height = Math.max(...all.map((p) => p[1])) - minY + 4;

    const svg = ring ?? (document.createElementNS(SVG_NS, 'svg') as SVGSVGElement);
    svg.setAttribute('class', svg.getAttribute('class') || 'ink-ask-ring');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('width', String(Math.ceil(width)));
    svg.setAttribute('height', String(Math.ceil(height)));
    svg.setAttribute('viewBox', `0 0 ${Math.ceil(width)} ${Math.ceil(height)}`);
    svg.style.left = `${Math.round(minX + window.scrollX)}px`;
    svg.style.top = `${Math.round(minY + window.scrollY)}px`;
    svg.replaceChildren(
      ...strokes.map((points, i) => {
        const path = document.createElementNS(SVG_NS, 'path');
        path.setAttribute('class', i ? 'ink-ask-ring-echo' : 'ink-ask-ring-main');
        path.setAttribute('pathLength', '1');
        path.setAttribute('d', points.map(([x, y], j) => `${j ? 'L' : 'M'}${(x - minX).toFixed(1)} ${(y - minY).toFixed(1)}`).join(''));
        return path;
      }),
    );
    return svg;
  }

  // ---------- 回答里的 Markdown 解析与容错预处理 ----------

  const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  const renderer = new marked.Renderer();
  renderer.link = ({ href, text }) => `<a href="${href}" target="_blank" rel="noopener noreferrer nofollow">${text}</a>`;
  renderer.heading = ({ text }) => `<p class="ink-ask-h">${text}</p>`;

  marked.setOptions({
    gfm: true,
    breaks: true,
    renderer,
  });

  function preprocessMarkdown(src: string): string {
    if (!src) return '';
    let text = src.replace(/\r\n?/g, '\n');

    // 1. 将中文圆点列表符 • / · 转换为标准 markdown 列表符 -
    text = text.replace(/^[ \t]*[•·][ \t]+/gm, '- ');

    // 2. 修复孤立未闭合粗体：如果在非代码块的某一行有奇数个 **，自动在行末补上闭合
    const lines = text.split('\n');
    let inCodeFence = false;
    text = lines.map((line) => {
      if (/^\s*```/.test(line)) {
        inCodeFence = !inCodeFence;
        return line;
      }
      if (inCodeFence) return line;
      const stars = (line.match(/\*\*/g) || []).length;
      if (stars % 2 === 1) {
        return line + '**';
      }
      return line;
    }).join('\n');

    // 3. 解决反引号内联代码与粗体组合在非英文标点语境下的解析失效：
    // CommonMark 规则下反引号被视作标点，前接中文字符时 ** 无法作为左侧定界符（如 为什么必须用**`CreateDefaultSubobject`**？）。
    // 将 **(`...`)** 直接转换为 <strong>$1</strong>，令 marked 解析为 <strong><code>...</code></strong>，避免依赖定界符规则与引入不必要空格。
    text = text.replace(/\*\*\s*(`[^`\n]+`)\s*\*\*/g, '<strong>$1</strong>');

    // 4. 解决 ** 内部空格导致的解析失效：清理 ** 内侧多余空格（如 ** 结论 ** -> **结论**），不向外侧注入额外空格
    text = text.replace(/\*\*([^\n]+?)\*\*/g, (match, inner) => {
      const trimmed = inner.trim();
      return trimmed ? `**${trimmed}**` : match;
    });

    // 5. 清理连续重复空格（但保留换行）
    text = text.replace(/[ \t]{2,}/g, ' ');

    return text;
  }

  function renderMarkdown(src: string): string {
    try {
      const sanitized = preprocessMarkdown(src);
      const parsed = marked.parse(sanitized);
      return typeof parsed === 'string' ? parsed : '';
    } catch {
      return src.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');
    }
  }

  function placeCaret(answer: HTMLElement) {
    let host: Element | null = answer.lastElementChild;
    while (host && /^(UL|OL|BLOCKQUOTE|DIV|TABLE|TBODY|TR|PRE)$/.test(host.tagName) && host.lastElementChild) host = host.lastElementChild;
    const caret = document.createElement('span');
    caret.className = 'ink-ask-caret';
    (host ?? answer).append(caret);
  }

  // ---------- 拖拽支持 ----------

  function enableDrag(card: HTMLElement, handle: HTMLElement, onMoved: () => void, signal?: AbortSignal) {
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;
    let isDragging = false;
    let isPullingSheet = false;
    let sheetPullStartY = 0;
    let sheetPullDy = 0;

    handle.addEventListener('pointerdown', (e: PointerEvent) => {
      if ((e.target as HTMLElement).closest('button, input, textarea, a')) return;
      if (e.button !== 0) return;

      if (useSheet()) {
        isPullingSheet = true;
        sheetPullStartY = e.clientY;
        sheetPullDy = 0;
        card.style.transition = 'none';
        try { handle.setPointerCapture(e.pointerId); } catch {}
        return;
      }

      e.preventDefault();
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;

      const rect = card.getBoundingClientRect();
      initialLeft = rect.left + window.scrollX;
      initialTop = rect.top + window.scrollY;

      card.classList.add('is-dragging');
      try { handle.setPointerCapture(e.pointerId); } catch {}
    }, { signal });

    const onPointerMove = (ev: PointerEvent) => {
      if (isPullingSheet) {
        const dy = ev.clientY - sheetPullStartY;
        if (dy > 0) {
          sheetPullDy = dy;
          card.style.transform = `translateY(${dy}px)`;
        } else {
          sheetPullDy = 0;
          card.style.transform = '';
        }
        return;
      }

      if (!isDragging) return;
      const dx = ev.clientX - startX;
      const dy = ev.clientY - startY;

      const width = card.offsetWidth;
      const height = card.offsetHeight;
      const minX = 8 + window.scrollX;
      const maxX = window.innerWidth - width - 8 + window.scrollX;
      const minY = 8 + window.scrollY;
      const maxY = window.innerHeight - height - 8 + window.scrollY;

      const nextLeft = Math.max(minX, Math.min(maxX, initialLeft + dx));
      const nextTop = Math.max(minY, Math.min(maxY, initialTop + dy));

      card.style.left = `${Math.round(nextLeft)}px`;
      card.style.top = `${Math.round(nextTop)}px`;
      card.classList.remove('is-above'); // 拖拽后清除 transform 偏移

      onMoved();
    };

    const onPointerUp = (ev: PointerEvent) => {
      if (isPullingSheet) {
        isPullingSheet = false;
        try { handle.releasePointerCapture(ev.pointerId); } catch {}
        card.style.transition = 'transform 280ms cubic-bezier(0.16, 1, 0.3, 1)';
        if (sheetPullDy > 80) {
          card.style.transform = 'translateY(100%)';
          setTimeout(() => {
            close();
            card.style.transform = '';
            card.style.transition = '';
          }, 280);
        } else {
          card.style.transform = '';
          setTimeout(() => {
            card.style.transition = '';
          }, 280);
        }
        return;
      }

      if (!isDragging) return;
      isDragging = false;
      card.classList.remove('is-dragging');
      try {
        handle.releasePointerCapture(ev.pointerId);
      } catch {}
    };

    handle.addEventListener('pointermove', onPointerMove, { signal });
    handle.addEventListener('pointerup', onPointerUp, { signal });
    handle.addEventListener('pointercancel', onPointerUp, { signal });
    window.addEventListener('pointermove', onPointerMove, { signal });
    window.addEventListener('pointerup', onPointerUp, { signal });
    window.addEventListener('pointercancel', onPointerUp, { signal });
  }

  // ---------- 划词卡片 ----------

  const CLOSE_ICON =
    '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';

  const DRAG_ICON =
    '<svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><circle cx="4" cy="4" r="1.4"/><circle cx="12" cy="4" r="1.4"/><circle cx="4" cy="8" r="1.4"/><circle cx="12" cy="8" r="1.4"/><circle cx="4" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/></svg>';

  function buildCard(anchor: Anchor): HTMLElement {
    const card = document.createElement('div');
    card.className = 'ink-ask-card';
    card.setAttribute('role', 'dialog');
    card.setAttribute('aria-label', '墨问：AI 解释选中的内容');
    card.tabIndex = -1;
    card.innerHTML = `
      <div class="ink-ask-head" title="按住可拖动窗口">
        <div class="ink-ask-head-main">
          <span class="ink-ask-drag-handle" aria-hidden="true">${DRAG_ICON}</span>
          <p class="ink-ask-heading">
            <span class="ink-ask-kicker">Ask</span>
            <span class="ink-ask-sep">/</span>
            <span class="ink-ask-title">墨问</span>
          </p>
        </div>
        <button type="button" class="ink-ask-close" aria-label="关闭" title="关闭 (Esc)">${CLOSE_ICON}</button>
      </div>
      <div class="ink-ask-quote-wrap">
        <p class="ink-ask-quote"></p>
      </div>
      <div class="ink-ask-thread" data-lenis-prevent></div>
      <div class="ink-ask-quick-prompts">
        <button type="button" class="ink-ask-pill" data-ask="能用通俗生动的大白话讲讲这段是什么意思吗？">💡 通俗讲讲</button>
        <button type="button" class="ink-ask-pill" data-ask="能就这段内容举一个生动形象的例子吗？">🌰 举个例子</button>
        <button type="button" class="ink-ask-pill" data-ask="它在文章和工程技术实现里起什么作用？">🎯 有何作用</button>
        <button type="button" class="ink-ask-pill" data-ask="为什么要这样设计或书写，有没有易踩坑点？">⚡ 为什么这样写</button>
      </div>
      <form class="ink-ask-form" autocomplete="off">
        <input class="ink-ask-input" name="question" maxlength="120" placeholder="不懂就问，比如：举个例子、为什么这么写…" enterkeyhint="send" />
        <button type="submit" class="ink-ask-send" aria-label="追问">问</button>
      </form>
      <p class="ink-ask-foot">AI 伴读 · 按住头部可拖拽窗口</p>`;
    card.querySelector('.ink-ask-quote')!.textContent = anchor.text;
    return card;
  }

  let ringKey = '';

  function place(s: Session) {
    const rects = lineRects(s.range);
    if (!rects.length) return;
    const box = boxOf(rects);
    const key = [box.left + window.scrollX, box.top + window.scrollY, box.width, box.height].map(Math.round).join();
    if (key !== ringKey) {
      ringKey = key;
      drawRing(s.range, s.ring);
    }

    const { card } = s;
    const sheet = useSheet();
    card.classList.toggle('is-sheet', sheet);
    if (sheet) {
      card.style.left = card.style.top = card.style.width = card.style.transform = '';
      return;
    }

    // 用户手动拖拽过后，保持用户自选的位置
    if (s.userMoved) return;

    const last = rects[rects.length - 1];
    const width = Math.min(560, window.innerWidth - 32);
    const spaceBelow = window.innerHeight - last.bottom;
    const above = spaceBelow < 300 && box.top > spaceBelow;
    card.classList.toggle('is-above', above);
    card.style.width = `${width}px`;
    card.style.left = `${Math.round(Math.min(Math.max(box.left - 12, 16), window.innerWidth - width - 16) + window.scrollX)}px`;
    card.style.top = `${Math.round((above ? box.top - 16 : last.bottom + 16) + window.scrollY)}px`;
  }

  function inkCircle(s: Session) {
    const rect = s.card.getBoundingClientRect();
    const x = s.origin.x - window.scrollX - rect.left;
    const y = s.origin.y - window.scrollY - rect.top;
    const height = Math.max(rect.height, window.innerHeight * 0.72);
    const r = Math.hypot(Math.max(x, rect.width - x), Math.max(y, height - y)) + 24;
    return { x, y, r };
  }

  function afterTransition(el: HTMLElement, ms: number, fn: () => void) {
    let fired = false;
    const run = () => {
      if (fired) return;
      fired = true;
      fn();
    };
    el.addEventListener('transitionend', (event) => event.target === el && run(), { once: true });
    window.setTimeout(run, ms);
  }

  function reveal(s: Session) {
    if (reduceMotion()) return;
    const { card } = s;
    const { x, y, r } = inkCircle(s);
    card.style.clipPath = `circle(0px at ${x}px ${y}px)`;
    void card.offsetWidth;
    card.classList.add('is-opening');
    card.style.clipPath = `circle(${r}px at ${x}px ${y}px)`;
    afterTransition(card, 900, () => {
      card.classList.remove('is-opening');
      card.style.clipPath = '';
    });
  }

  function close(instant = false) {
    const s = session;
    if (!s) return;
    session = null;
    ringKey = '';
    s.controller?.abort();
    s.stop.abort();
    if (instant || reduceMotion()) {
      s.card.remove();
      s.ring.remove();
      return;
    }
    s.ring.classList.add('is-drying');
    window.setTimeout(() => s.ring.remove(), 600);
    const { x, y, r } = inkCircle(s);
    s.card.style.clipPath = `circle(${r}px at ${x}px ${y}px)`;
    void s.card.offsetWidth;
    s.card.classList.add('is-closing');
    s.card.style.clipPath = `circle(0px at ${x}px ${y}px)`;
    afterTransition(s.card, 600, () => s.card.remove());
  }

  // ---------- 一问一答 ----------

  const nearEnd = (el: HTMLElement) => el.scrollHeight - el.scrollTop - el.clientHeight < 48;

  function addTurn(thread: HTMLElement, question: string) {
    const turn = document.createElement('section');
    turn.className = 'ink-ask-turn';
    if (question) {
      const q = document.createElement('div');
      q.className = 'ink-ask-q';
      q.innerHTML = `<span class="ink-ask-q-tag">追问</span><span class="ink-ask-q-text">${escapeHtml(question)}</span>`;
      turn.append(q);
    }
    const answer = document.createElement('div');
    answer.className = 'ink-ask-answer';
    const status = document.createElement('p');
    status.className = 'ink-ask-status';
    status.setAttribute('role', 'status');
    status.innerHTML = '<span class="ink-ask-status-text">梳理思路中</span><span class="ink-ask-dots" aria-hidden="true"><i></i><i></i><i></i></span>';
    turn.append(answer, status);
    thread.append(turn);
    thread.scrollTop = thread.scrollHeight;
    return { turn, answer, status };
  }

  function note(turn: HTMLElement, text: string) {
    const p = document.createElement('p');
    p.className = 'ink-ask-note';
    p.textContent = text;
    turn.append(p);
  }

  async function ask(s: Session, question = '') {
    if (s.controller) return;
    const controller = new AbortController();
    s.controller = controller;
    s.form.classList.add('is-busy');
    const { turn, answer, status } = addTurn(s.thread, question);
    let text = '';
    let frame = 0;
    const paint = () => {
      frame = 0;
      const stick = nearEnd(s.thread);
      answer.innerHTML = renderMarkdown(text);
      if (turn.classList.contains('is-streaming')) placeCaret(answer);
      if (stick) s.thread.scrollTop = s.thread.scrollHeight;
    };

    try {
      if ([...s.anchor.text].length > MAX_SELECTION) throw new Error(`选中的内容太长了（最多 ${MAX_SELECTION} 字），缩短一点再问`);
      const response = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          path: location.pathname,
          selection: s.anchor.text,
          prefix: s.anchor.prefix,
          suffix: s.anchor.suffix,
          question,
        }),
        signal: controller.signal,
      });
      if (!response.ok || !response.body) {
        const data = await response.json().catch(() => null);
        throw new Error(data?.error || `请求失败（${response.status}）`);
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let finish: { cached?: boolean; truncated?: boolean } | null = null;
      while (!finish) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        for (let cut; (cut = buffer.indexOf('\n\n')) !== -1; ) {
          const line = buffer.slice(0, cut).split('\n').find((l) => l.startsWith('data:'));
          buffer = buffer.slice(cut + 2);
          if (!line) continue;
          const message = JSON.parse(line.slice(5));
          if (message.error) throw new Error(message.error);
          if (message.t && !text) status.querySelector('.ink-ask-status-text')!.textContent = '深入思考中';
          if (message.d) {
            if (!text) {
              status.hidden = true;
              turn.classList.add('is-streaming');
            }
            text += message.d;
            frame ||= requestAnimationFrame(paint);
          }
          if (message.done) finish = message;
        }
      }
      if (!text.trim()) throw new Error('没有收到回答，稍后再试');
      if (frame) cancelAnimationFrame(frame);
      turn.classList.remove('is-streaming');
      turn.classList.toggle('is-cached', Boolean(finish?.cached));
      paint();
      if (finish?.truncated) note(turn, '回答太长，后面被截断了');
      else if (!finish) note(turn, '连接断了，回答可能不完整');
    } catch (error) {
      if (controller.signal.aborted) return;
      if (frame) cancelAnimationFrame(frame);
      turn.classList.remove('is-streaming');
      if (text) paint();
      status.hidden = false;
      status.classList.add('is-error');
      status.textContent = error instanceof TypeError ? '网络好像断了，稍后再试' : (error as Error).message || '出错了，稍后再试';
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'ink-ask-retry';
      retry.textContent = '再试一次';
      retry.addEventListener('click', () => {
        turn.remove();
        ask(s, question);
      });
      status.append(retry);
    } finally {
      if (s.controller === controller) {
        s.controller = null;
        s.form.classList.remove('is-busy');
      }
    }
  }

  function open(range: Range, root: HTMLElement) {
    close(true);
    const anchor = anchorOf(range, root);
    const sealRect = seal?.classList.contains('is-shown') ? seal.getBoundingClientRect() : null;
    hideSeal();
    const ring = anchor.text ? drawRing(range) : null;
    if (!ring) return;
    const last = lineRects(range).at(-1)!;
    const origin = sealRect
      ? { x: sealRect.left + sealRect.width / 2, y: sealRect.top + sealRect.height / 2 }
      : { x: last.right, y: last.bottom };
    window.getSelection()?.removeAllRanges();

    const card = buildCard(anchor);
    const s: Session = {
      card,
      ring,
      range: range.cloneRange(),
      anchor,
      origin: { x: origin.x + window.scrollX, y: origin.y + window.scrollY },
      controller: null,
      stop: new AbortController(),
      thread: card.querySelector<HTMLElement>('.ink-ask-thread')!,
      form: card.querySelector<HTMLFormElement>('.ink-ask-form')!,
      input: card.querySelector<HTMLInputElement>('.ink-ask-input')!,
      userMoved: false,
    };
    session = s;
    document.body.append(ring, card);
    place(s);
    void ring.getBoundingClientRect();
    ring.classList.add('is-drawn');
    reveal(s);

    // 绑定拖拽
    const head = card.querySelector<HTMLElement>('.ink-ask-head')!;
    enableDrag(card, head, () => {
      s.userMoved = true;
    }, s.stop.signal);

    // 快捷预设词
    card.querySelectorAll<HTMLButtonElement>('.ink-ask-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const q = pill.dataset.ask || pill.textContent?.trim() || '';
        if (q && !s.controller) ask(s, q);
      });
    });

    const closeBtn = card.querySelector('.ink-ask-close')!;
    closeBtn.addEventListener('pointerdown', (e) => e.stopPropagation());
    closeBtn.addEventListener('click', () => close());

    s.form.addEventListener('submit', (event) => {
      event.preventDefault();
      const question = s.input.value.trim();
      if (!question || s.controller) return;
      s.input.value = '';
      ask(s, question);
    });

    const ro = new ResizeObserver(() => requestAnimationFrame(() => session === s && place(s)));
    ro.observe(root);
    s.stop.signal.addEventListener('abort', () => ro.disconnect());

    card.focus({ preventScroll: true });
    ask(s);
  }

  // ---------- 右上角 AI 伴读侧边栏 ----------

  function ensureSidebar() {
    if (sidebarBtn?.isConnected && sidebarDrawer?.isConnected) return;

    // 1. 右上角常驻按钮
    if (!sidebarBtn?.isConnected) {
      sidebarBtn = document.createElement('button');
      sidebarBtn.type = 'button';
      sidebarBtn.className = 'ink-ask-sidebar-trigger';
      sidebarBtn.setAttribute('aria-label', '打开 AI 伴读侧边栏');
      sidebarBtn.title = '打开 AI 伴读侧边栏';
      sidebarBtn.innerHTML = `
        <span class="ink-ask-sidebar-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </span>
        <span class="ink-ask-sidebar-label">墨问 AI</span>`;
      sidebarBtn.addEventListener('click', toggleSidebar);
      document.body.append(sidebarBtn);
    }

    // 2. 侧边栏遮罩与抽屉
    if (!sidebarOverlay?.isConnected) {
      sidebarOverlay = document.createElement('div');
      sidebarOverlay.className = 'ink-ask-drawer-overlay';
      sidebarOverlay.addEventListener('click', closeSidebar);
      document.body.append(sidebarOverlay);
    }

    if (!sidebarDrawer?.isConnected) {
      sidebarDrawer = document.createElement('aside');
      sidebarDrawer.className = 'ink-ask-drawer';
      sidebarDrawer.setAttribute('role', 'dialog');
      sidebarDrawer.setAttribute('aria-label', '墨问 · AI 伴读');
      sidebarDrawer.innerHTML = `
        <div class="ink-ask-drawer-head">
          <div class="ink-ask-drawer-title-area">
            <span class="ink-ask-kicker">Companion</span>
            <h2 class="ink-ask-drawer-title">墨问 · 伴读</h2>
          </div>
          <button type="button" class="ink-ask-drawer-close" aria-label="关闭侧边栏" title="关闭 (Esc)">${CLOSE_ICON}</button>
        </div>
        <div class="ink-ask-drawer-meta">
          <span class="ink-ask-drawer-badge" title="当前阅读文章">《${escapeHtml(postTitle())}》</span>
        </div>
        <div class="ink-ask-drawer-body" data-lenis-prevent>
          <div class="ink-ask-drawer-welcome">
            <p class="ink-ask-welcome-desc">我是本文的 AI 伴读老友。阅读中有任何生涩难懂之处，随时向我提问～</p>
            <div class="ink-ask-drawer-cards">
              <button type="button" class="ink-ask-quick-card" data-ask="请用通俗生动的大白话，帮我概括一下这篇文章的核心要点和主旨。">
                <span class="quick-card-icon">💡</span>
                <span class="quick-card-text">通俗总结本文要点</span>
              </button>
              <button type="button" class="ink-ask-quick-card" data-ask="这篇文章主要解决了什么核心问题或痛点？为什么需要这套方案？">
                <span class="quick-card-icon">🔍</span>
                <span class="quick-card-text">解决了什么核心痛点</span>
              </button>
              <button type="button" class="ink-ask-quick-card" data-ask="请帮我用简单易懂的语言梳理一下文中的核心实现逻辑和技术亮点。">
                <span class="quick-card-icon">🛠️</span>
                <span class="quick-card-text">核心实现与技术亮点</span>
              </button>
              <button type="button" class="ink-ask-quick-card" data-ask="读懂这篇文章需要什么前置知识？有哪些容易忽略的关键细节？">
                <span class="quick-card-icon">🎯</span>
                <span class="quick-card-text">前置知识与避坑细节</span>
              </button>
            </div>
          </div>
          <div class="ink-ask-drawer-thread"></div>
        </div>
        <form class="ink-ask-drawer-form" autocomplete="off">
          <div class="ink-ask-drawer-input-wrap">
            <textarea class="ink-ask-drawer-input" rows="1" maxlength="300" placeholder="向 AI 伴读提问本文…" enterkeyhint="send"></textarea>
            <button type="submit" class="ink-ask-drawer-send" aria-label="发送">问</button>
          </div>
          <div class="ink-ask-drawer-foot-row">
            <span class="ink-ask-drawer-tip">Enter 发送 · Shift+Enter 换行</span>
            <span class="ink-ask-drawer-foot">AI 伴读 · 紧扣本文</span>
          </div>
        </form>`;

      document.body.append(sidebarDrawer);

      const closeBtn = sidebarDrawer.querySelector('.ink-ask-drawer-close')!;
      closeBtn.addEventListener('click', closeSidebar);

      const thread = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-thread')!;
      const welcome = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-welcome')!;
      const form = sidebarDrawer.querySelector<HTMLFormElement>('.ink-ask-drawer-form')!;
      const textarea = sidebarDrawer.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input')!;

      // 预设卡片点击
      sidebarDrawer.querySelectorAll<HTMLButtonElement>('.ink-ask-quick-card').forEach((card) => {
        card.addEventListener('click', () => {
          const q = card.dataset.ask || card.textContent?.trim() || '';
          if (q) askDrawer(q);
        });
      });

      // 自动撑高 textarea
      function adjustTextareaHeight() {
        textarea.style.height = 'auto';
        const scrollH = textarea.scrollHeight;
        if (scrollH > 120) {
          textarea.style.height = '120px';
          textarea.style.overflowY = 'auto';
        } else {
          textarea.style.height = `${Math.max(24, scrollH)}px`;
          textarea.style.overflowY = 'hidden';
        }
      }

      textarea.addEventListener('input', adjustTextareaHeight);

      // 输入框快捷按键
      textarea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = textarea.value.trim();
        if (!q) return;
        textarea.value = '';
        textarea.style.height = '24px';
        textarea.style.overflowY = 'hidden';
        askDrawer(q);
      });

      async function askDrawer(question: string) {
        if (sidebarController) return;
        welcome.style.display = 'none'; // 提问后收起欢迎引导
        const controller = new AbortController();
        sidebarController = controller;
        form.classList.add('is-busy');

        const { turn, answer, status } = addTurn(thread, question);
        let text = '';
        let frame = 0;
        const paint = () => {
          frame = 0;
          const stick = nearEnd(thread);
          answer.innerHTML = renderMarkdown(text);
          if (turn.classList.contains('is-streaming')) placeCaret(answer);
          if (stick) thread.scrollTop = thread.scrollHeight;
        };

        try {
          const response = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              path: location.pathname,
              isArticle: true,
              question,
            }),
            signal: controller.signal,
          });

          if (!response.ok || !response.body) {
            const data = await response.json().catch(() => null);
            throw new Error(data?.error || `请求失败（${response.status}）`);
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          let finish: { cached?: boolean; truncated?: boolean } | null = null;
          while (!finish) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            for (let cut; (cut = buffer.indexOf('\n\n')) !== -1; ) {
              const line = buffer.slice(0, cut).split('\n').find((l) => l.startsWith('data:'));
              buffer = buffer.slice(cut + 2);
              if (!line) continue;
              const message = JSON.parse(line.slice(5));
              if (message.error) throw new Error(message.error);
              if (message.t && !text) status.querySelector('.ink-ask-status-text')!.textContent = '深入思考中';
              if (message.d) {
                if (!text) {
                  status.hidden = true;
                  turn.classList.add('is-streaming');
                }
                text += message.d;
                frame ||= requestAnimationFrame(paint);
              }
              if (message.done) finish = message;
            }
          }
          if (!text.trim()) throw new Error('没有收到回答，稍后再试');
          if (frame) cancelAnimationFrame(frame);
          turn.classList.remove('is-streaming');
          turn.classList.toggle('is-cached', Boolean(finish?.cached));
          paint();
          if (finish?.truncated) note(turn, '回答太长，后面被截断了');
        } catch (error) {
          if (controller.signal.aborted) return;
          if (frame) cancelAnimationFrame(frame);
          turn.classList.remove('is-streaming');
          if (text) paint();
          status.hidden = false;
          status.classList.add('is-error');
          status.textContent = error instanceof TypeError ? '网络好像断了，稍后再试' : (error as Error).message || '出错了，稍后再试';
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.className = 'ink-ask-retry';
          retry.textContent = '再试一次';
          retry.addEventListener('click', () => {
            turn.remove();
            askDrawer(question);
          });
          status.append(retry);
        } finally {
          if (sidebarController === controller) {
            sidebarController = null;
            form.classList.remove('is-busy');
          }
        }
      }
    }
  }

  function openSidebar() {
    ensureSidebar();
    sidebarOverlay?.classList.add('is-open');
    sidebarDrawer?.classList.add('is-open');
    sidebarDrawer?.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input')?.focus();
  }

  function closeSidebar() {
    sidebarOverlay?.classList.remove('is-open');
    sidebarDrawer?.classList.remove('is-open');
    sidebarController?.abort();
  }

  function toggleSidebar() {
    if (sidebarDrawer?.classList.contains('is-open')) closeSidebar();
    else openSidebar();
  }

  function openSidebarWithContext(snippet: string) {
    ensureSidebar();
    openSidebar();
    const textarea = sidebarDrawer?.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input');
    if (textarea && snippet) {
      const cleanSnippet = snippet.trim();
      const quoteLines = cleanSnippet.split('\n').map((l) => `> ${l}`).join('\n');
      textarea.value = `针对这部分内容：\n${quoteLines}\n\n我想请教：`;
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.focus();
      textarea.setSelectionRange(textarea.value.length, textarea.value.length);
    }
  }

  (window as any).__inkAsk = {
    openSidebar,
    closeSidebar,
    toggleSidebar,
    openSidebarWithContext,
  };

  window.addEventListener('inkask:open-with-context', (e: any) => {
    const text = e.detail?.snippet || e.detail?.text || '';
    openSidebarWithContext(text);
  });

  // ---------- 全局监听 ----------

  function initInkAsk() {
    if (!prose()) return;
    probe().then((ok) => {
      if (ok) ensureSidebar();
    });
  }

  initInkAsk();

  if (!(window as any)[LISTENER_KEY]) {
    (window as any)[LISTENER_KEY] = true;

    document.addEventListener(
      'pointerdown',
      (event) => {
        const target = event.target as Element | null;
        if (target?.closest?.('.ink-ask-seal, .ink-ask-card, .ink-ask-sidebar-trigger, .ink-ask-drawer')) return;
        if (session) close();
        if (event.pointerType === 'mouse' && event.button === 0) {
          mouseDown = true;
          hideSeal();
        }
      },
      true,
    );

    document.addEventListener(
      'pointerup',
      () => {
        if (!mouseDown) return;
        mouseDown = false;
        settleSoon(20);
      },
      true,
    );

    document.addEventListener('selectionchange', () => {
      if (!mouseDown) settleSoon(280);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (sidebarDrawer?.classList.contains('is-open')) closeSidebar();
      else if (session) close();
      else hideSeal();
    });

    let resizeFrame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        hideSeal();
        if (session) place(session);
      });
    });

    document.addEventListener('astro:page-load', () => {
      initInkAsk();
    });

    document.addEventListener('astro:before-swap', () => {
      close(true);
      closeSidebar();
      hideSeal();
      seal?.remove();
      seal = null;
      sidebarBtn?.remove();
      sidebarBtn = null;
      sidebarOverlay?.remove();
      sidebarOverlay = null;
      sidebarDrawer?.remove();
      sidebarDrawer = null;
    });
  }
</script>

