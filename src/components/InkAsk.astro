    padding-left: 0.78rem;
    border-left: 2.5px solid var(--vermilion);
    color: var(--muted-strong);
  }
  .ink-ask-table {
    overflow-x: auto;
  }
  .ink-ask-table table {
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .ink-ask-table th,
  .ink-ask-table td {
    padding: 0.32rem 0.58rem;
    border: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }
  .ink-ask-table th {
    background: rgba(var(--accent-rgb, 0, 0, 0), 0.045);
    color: var(--text-strong);
  }
  .ink-ask-turn.is-cached .ink-ask-answer {
    /* 缓存秒出保持原文字稳定，杜绝 opacity: 0 重置导致的二次刺眼闪烁 */
    animation: none;
  }

  .ink-ask-caret {
    display: inline-block;
    width: 0.42em;
    height: 0.42em;
    margin-left: 0.2em;
    border-radius: 50%;
    background: var(--vermilion);
    vertical-align: 0.1em;
    animation: ink-ask-breathe 1.1s ease-in-out infinite;
  }
  .ink-ask-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.84rem;
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .ink-ask-status.is-leaving {
    opacity: 0;
    transform: translateY(-2px);
  }
  .ink-ask-status[hidden] {
    display: none;
  }
  .ink-ask-status.is-error {
    color: var(--text-strong);
  }
  .ink-ask-dots {
    display: inline-flex;
    gap: 0.26rem;
  }
  .ink-ask-dots i {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: var(--vermilion);
    animation: ink-ask-breathe 1.2s ease-in-out infinite;
  }
  .ink-ask-dots i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .ink-ask-dots i:nth-child(3) {
    animation-delay: 0.36s;
  }
  .ink-ask-retry {
    padding: 0.12rem 0.62rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--text-strong);
    font-family: var(--font-body);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background 160ms ease;
  }
  .ink-ask-retry:hover {
    background: var(--accent-soft);
  }
  .ink-ask-note {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  /* 回答底部轻量操作条（存入笔记 + 复制） */
  .ink-ask-turn-actions {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.42rem;
    margin-top: 0.55rem;
    animation: inkSaveNoteIn 240ms var(--ease) both;
  }

  .ink-ask-save-note,
  .ink-ask-copy-answer {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.64rem;
    border: 1px solid var(--rule-soft);
    border-radius: 999px;
    background: transparent;
    color: var(--muted-strong);
    font-family: var(--font-body);
    font-size: 0.73rem;
    line-height: 1.25;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 140ms var(--ease);
  }

  @keyframes inkSaveNoteIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ink-ask-save-note:hover,
  .ink-ask-copy-answer:hover {
    background: rgba(var(--accent-rgb, 0, 0, 0), 0.06);
    border-color: var(--rule);
    color: var(--text-strong);
    transform: translateY(-1px);
  }

  .ink-ask-save-note:active,
  .ink-ask-copy-answer:active {
    transform: scale(0.96);
  }

  .ink-ask-save-note.is-partial {
    border-color: var(--vermilion);
    color: var(--vermilion);
    background: var(--vermilion-soft);
  }

  .ink-ask-save-note.is-saved,
  .ink-ask-copy-answer.is-copied {
    border-color: var(--vermilion);
    color: var(--vermilion);
    background: var(--vermilion-soft);
    animation: inkSaveNoteSaved 420ms var(--ease) both;
  }

  @keyframes inkSaveNoteSaved {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.06);
    }
    100% {
      transform: scale(1);
    }
  }

  /* 划词小窗输入框与底栏 */
  .ink-ask-form {
    display: flex;
    flex-shrink: 0;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem 0.75rem 1.05rem;
    border-top: none;
    background: transparent;
  }
  .ink-ask-input {
    flex: 1;
    min-width: 0;
    min-height: 36px;
    max-height: 140px;
    padding: 0.46rem 0.8rem;
    border: 1px solid var(--rule-strong);
    border-radius: 10px;
    outline: none;
    background: var(--bg-elev);
    color: var(--text-strong);
    font: inherit;
    font-size: 0.87rem;
    line-height: 1.55;
    resize: none;
    overflow-y: hidden;
    scrollbar-width: thin;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .ink-ask-input::placeholder {
    color: var(--muted);
    font-size: 0.81rem;
  }
  .ink-ask-input:focus {
    border-color: var(--vermilion);
    box-shadow: 0 0 0 2.5px var(--vermilion-soft);
  }
  .ink-ask-send {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--vermilion);
    border-radius: 9px;
    background: var(--vermilion-soft);
    color: var(--vermilion);
    font-family: var(--font-hand-title);
    font-size: 0.96rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 160ms var(--ease-bounce), opacity 180ms ease, background 180ms ease, color 180ms ease;
  }
  .ink-ask-send:hover,
  .ink-ask-send:focus-visible {
    outline: none;
    transform: scale(1.04);
    background: var(--vermilion);
    color: var(--bg-base);
  }
  [data-theme="dark"] .ink-ask-send:hover,
  [data-theme="dark"] .ink-ask-send:focus-visible {
    background: #ffffff;
    color: #141414;
    border-color: #ffffff;
  }
  [data-theme="moss"] .ink-ask-send:hover,
  [data-theme="moss"] .ink-ask-send:focus-visible {
    background: var(--accent);
    color: var(--moss-badge-text, #004D40);
    border-color: var(--accent);
  }
  .ink-ask-form.is-busy .ink-ask-send {
    opacity: 0.35;
    pointer-events: none;
    transform: none;
  }

  /* ---------- 右上角 AI 伴读常驻按钮 ---------- */
  .ink-ask-sidebar-trigger {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 99;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem 0.45rem 0.75rem;
    border-radius: 6px;
    background: var(--glass-bg);
    border: 1px solid var(--rule-strong);
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.08),
      0 1px 3px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    color: var(--text-strong);
    font-family: var(--font-hand-title);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 240ms ease,
                border-color 240ms ease,
                background 240ms ease,
                transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 240ms ease;
  }
  [data-theme="dark"] .ink-ask-sidebar-trigger {
    background: var(--glass-bg-strong);
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.45),
      0 1px 3px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .ink-ask-sidebar-trigger:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.06) translateX(-3px);
    box-shadow:
      0 10px 32px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .ink-ask-sidebar-icon {
    display: inline-flex;
    align-items: center;
    color: var(--vermilion);
  }
  .ink-ask-sidebar-label {
    line-height: 1;
  }

  /* ---------- 右侧 AI 伴读抽屉（东方书斋雅集风：单浮岛 / 双卷并排 / 画框全屏统一中轴） ---------- */
  @media (min-width: 1024px) {
    .ink-ask-drawer-overlay {
      display: none !important;
      pointer-events: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }

    .ink-ask-drawer {
      position: fixed;
      top: clamp(1rem, 2.5vh, 1.8rem);
      bottom: clamp(1rem, 2.5vh, 1.8rem);
      right: var(--companion-gutter, clamp(1rem, 1.6vw, 1.6rem));
      z-index: 100011;
      display: flex;
      flex-direction: column;
      width: var(--companion-rail-width, clamp(404px, 29vw, 464px));
      max-width: calc(100vw - 2.5rem);
      height: auto;
      max-height: calc(100vh - 2 * clamp(1rem, 2.5vh, 1.8rem));
      max-height: calc(100dvh - 2 * clamp(1rem, 2.5vh, 1.8rem));
      background: var(--glass-bg-strong, var(--bg-elev));
      border: 1px solid var(--glass-border-strong, var(--rule-strong));
      border-radius: 16px;
      box-shadow:
        var(--glass-inner-top),
        0 20px 50px rgba(0, 0, 0, 0.12),
        0 4px 16px rgba(0, 0, 0, 0.04);
      backdrop-filter: blur(24px) saturate(150%);
      -webkit-backdrop-filter: blur(24px) saturate(150%);
      transform: translate3d(calc(100% + 2.5rem), 0, 0) scale(0.985);
      opacity: 0;
      transition:
        transform 380ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 260ms cubic-bezier(0.16, 1, 0.3, 1);
      font-family: var(--font-hand);
      overflow: hidden;
      overscroll-behavior: contain;
    }

    [data-theme="dark"] .ink-ask-drawer {
      background: var(--glass-bg-strong, rgba(24, 24, 24, 0.95));
      border-color: var(--glass-border-strong, rgba(255, 255, 255, 0.16));
      box-shadow: var(--glass-inner-top), 0 24px 60px rgba(0, 0, 0, 0.55);
    }

    .ink-ask-drawer.is-open {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
    }
  }

  @media (max-width: 1023.98px) {
    .ink-ask-drawer-overlay {
      position: fixed;
      inset: 0;
      z-index: 100010;
      background: rgba(0, 0, 0, 0.38);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 280ms ease, visibility 280ms ease;
    }

    .ink-ask-drawer-overlay.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .ink-ask-drawer {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      z-index: 100011;
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 100%;
      height: 82vh;
      height: 82dvh;
      max-height: 85vh;
      max-height: 85dvh;
      background: var(--glass-bg-strong, var(--bg-elev));
      border-top: 1px solid var(--rule-strong, rgba(0, 0, 0, 0.18));
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.16);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      transform: translate3d(0, 100%, 0);
      transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
      font-family: var(--font-hand);
      overflow: hidden;
    }

    [data-theme="dark"] .ink-ask-drawer {
      background: rgba(24, 24, 24, 0.98);
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.6);
    }

    .ink-ask-drawer.is-open {
      transform: translate3d(0, 0, 0);
    }

    /* 移动端底抽屉全屏展开兜底（桌面端由 global.css 留白画框容器统一接管） */
    .ink-ask-drawer.is-maximized {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      max-width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      max-height: 100vh !important;
      max-height: 100dvh !important;
      border-radius: 0 !important;
      border: none !important;
      z-index: 100025 !important;
    }
  }

  .drawer-drag-handle {
    width: 36px;
    height: 4px;
    border-radius: 9999px;
    background: var(--rule-strong, rgba(0, 0, 0, 0.25));
    margin: 8px auto 4px auto;
    flex-shrink: 0;
  }

  .ink-ask-drawer.is-maximized .drawer-drag-handle {
    display: none !important;
  }

  /* 抽屉顶栏（与 global.css 52px 通透一体顶栏对齐） */
  .ink-ask-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 0.9rem 0 1.05rem;
    border-bottom: 1px solid var(--rule-soft);
    background: transparent;
    flex-shrink: 0;
  }
  .ink-ask-drawer-head-inner {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .ink-ask-drawer-title-area {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
  }
  .ink-ask-drawer-title {
    margin: 0;
    font-family: var(--font-hand-title);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--text-strong);
    line-height: 1;
  }
  .ink-ask-drawer-actions {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .ink-ask-drawer-new,
  .ink-ask-drawer-close,
  .ink-ask-drawer-maximize {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--muted-strong);
    cursor: pointer;
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
  }
  .ink-ask-drawer-new:hover,
  .ink-ask-drawer-close:hover,
  .ink-ask-drawer-maximize:hover,
  .ink-ask-drawer-maximize:focus-visible {
    outline: none;
    color: var(--text-strong);
    border-color: var(--rule-soft);
    background: rgba(var(--accent-rgb, 0, 0, 0), 0.07);
  }

  /* ---------- 书斋居中阅读中轴（单浮岛 / 双卷并排 / 画框全屏一脉相承） ---------- */
  .ink-ask-drawer-body {
    flex: 1 1 0%;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    container-type: inline-size;
    padding: clamp(1rem, 2.4vh, 1.75rem) clamp(1.05rem, 2.6vw, 2rem);
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    -webkit-overflow-scrolling: touch;
  }
  .ink-ask-drawer-body::-webkit-scrollbar,
  .ink-ask-drawer-thread::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }
  .ink-ask-drawer-body-inner {
    width: 100%;
    max-width: 720px;
    min-height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  /* ---------- 东方书斋雅集空状态（视觉黄金中段落座 + 双框朱印 + 2×2 典雅题签） ---------- */
  .ink-ask-drawer-welcome {
    margin: auto 0;
    padding: clamp(0.85rem, 2.5vh, 2rem) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .ink-ask-welcome-emblem {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 0.9rem;
    user-select: none;
  }
  .ink-ask-welcome-line {
    width: 44px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--rule-strong), transparent);
    opacity: 0.7;
  }
  .ink-ask-welcome-seal {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 7px;
    border: 1.5px solid var(--vermilion);
    background: var(--vermilion-soft);
    color: var(--vermilion);
    box-shadow: inset 0 0 0 2px var(--bg-elev);
    font-family: var(--font-hand-title);
    font-size: 1.18rem;
    font-weight: 700;
    line-height: 1;
  }
  .ink-ask-welcome-title {
    margin: 0 0 0.38rem;
    font-family: var(--font-hand-title);
    font-size: clamp(1.18rem, 1.5vw, 1.34rem);
    font-weight: 700;
    color: var(--text-strong);
    letter-spacing: 0.06em;
    line-height: 1.35;
  }
  .ink-ask-welcome-epigraph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 0.42rem;
    max-width: min(92%, 520px);
    font-family: var(--font-body);
    font-size: 0.79rem;
    color: var(--vermilion);
    letter-spacing: 0.02em;
    opacity: 0.92;
  }
  .ink-ask-welcome-epigraph .epigraph-affix {
    flex-shrink: 0;
  }
  .ink-ask-welcome-epigraph .epigraph-book {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ink-ask-welcome-epigraph:empty {
    display: none;
  }
  .ink-ask-welcome-desc {
    margin: 0 0 1.35rem;
    max-width: 440px;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.65;
  }
  .ink-ask-welcome-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.62rem;
    width: 100%;
    max-width: 560px;
  }
  @container (max-width: 390px) {
    .ink-ask-welcome-grid {
      grid-template-columns: 1fr;
    }
  }
  .ink-ask-prompt-card {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.78rem 0.88rem;
    border-radius: 12px;
    border: 1px solid var(--rule-soft);
    background: var(--bg-elev);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.025);
    text-align: left;
    cursor: pointer;
    user-select: none;
    transition:
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 180ms ease,
      box-shadow 180ms ease,
      background 180ms ease;
  }
  [data-theme="dark"] .ink-ask-prompt-card {
    background: rgba(255, 255, 255, 0.035);
    border-color: rgba(255, 255, 255, 0.09);
  }
  .ink-ask-prompt-card:hover,
  .ink-ask-prompt-card:focus-visible {
    outline: none;
    border-color: var(--vermilion);
    transform: translateY(-1.5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
  }
  [data-theme="dark"] .ink-ask-prompt-card:hover,
  [data-theme="dark"] .ink-ask-prompt-card:focus-visible {
    background: rgba(255, 255, 255, 0.065);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.32);
  }
  .prompt-card-icon {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: var(--vermilion-soft);
    color: var(--vermilion);
    flex-shrink: 0;
    margin-top: 1px;
  }
  .prompt-card-copy {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 0;
  }
  .prompt-card-title {
    font-family: var(--font-body);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-strong);
    line-height: 1.3;
  }
  .prompt-card-sub {
    font-family: var(--font-body);
    font-size: 0.73rem;
    color: var(--muted);
    line-height: 1.42;
  }

  /* ---------- 无框书卷式对话流（去重气泡框感，如展书页批阅） ---------- */
  .ink-ask-drawer-thread {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    transition: opacity 260ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ink-ask-drawer-thread:empty {
    display: none;
  }
  .ink-ask-drawer-thread.is-clearing {
    opacity: 0 !important;
    transform: translateY(-14px) !important;
    pointer-events: none !important;
  }
  .ink-ask-drawer-thread .ink-ask-turn {
    display: flex;
    flex-direction: column;
    gap: 0.48rem;
    width: 100%;
    margin: 0;
    padding: 0;
    border: none;
  }
  .ink-ask-drawer-thread .ink-ask-turn + .ink-ask-turn {
    margin-top: 0.15rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule-soft);
  }
  .ink-ask-drawer-thread .ink-ask-q {
    align-self: flex-end;
    max-width: min(86%, 520px);
    margin: 0 0 0.25rem;
    padding: 0.58rem 0.92rem;
    border-radius: 13px 13px 3px 13px;
