      setWelcomeEpigraph(sidebarDrawer.querySelector<HTMLElement>('.ink-ask-welcome-epigraph'));

      document.body.append(sidebarDrawer);
      bindScrollIsolation(sidebarDrawer, {
        scrollableSelector: '.ink-ask-drawer-body',
      });

      const closeBtn = sidebarDrawer.querySelector('.ink-ask-drawer-close')!;
      closeBtn.addEventListener('click', () => closeSidebar());

      const drawerMaxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize')!;
      const drawerHead = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-head')!;
      const applyDrawerMaxState = (isMax: boolean) => {
        if (!sidebarDrawer) return;
        sidebarDrawer.classList.toggle('is-maximized', isMax);
        document.body.classList.toggle('ink-ask-drawer-maximized', isMax);
        if (drawerMaxBtn) {
          drawerMaxBtn.innerHTML = isMax ? RESTORE_ICON : MAXIMIZE_ICON;
          drawerMaxBtn.dataset.tip = isMax ? '收为浮岛' : '全屏展开';
          drawerMaxBtn.setAttribute('aria-label', isMax ? '收为浮岛' : '全屏展开');
        }
      };

      const toggleDrawerMaximize = () => {
        if (!sidebarDrawer) return;
        lockScrollAnchor(400);

        const first = sidebarDrawer.getBoundingClientRect();
        const isMax = !sidebarDrawer.classList.contains('is-maximized');
        applyDrawerMaxState(isMax);

        const last = sidebarDrawer.getBoundingClientRect();
        const dx = Math.round((first.left + first.width / 2 - (last.left + last.width / 2)) * 0.52);

        sidebarDrawer.style.transition = 'none';
        sidebarDrawer.style.transform = `translate3d(${dx}px, 0, 0) scale(0.96)`;
        void sidebarDrawer.offsetHeight;

        sidebarDrawer.style.transition = 'transform 380ms cubic-bezier(0.16, 1, 0.3, 1)';
        sidebarDrawer.style.transform = 'translate3d(0, 0, 0) scale(1)';

        const onEnd = (e: TransitionEvent) => {
          if (e.target !== sidebarDrawer || e.propertyName !== 'transform') return;
          sidebarDrawer.style.transition = '';
          sidebarDrawer.style.transform = '';
          sidebarDrawer.removeEventListener('transitionend', onEnd);
        };
        sidebarDrawer.addEventListener('transitionend', onEnd);
        setTimeout(() => {
          if (!sidebarDrawer) return;
          sidebarDrawer.style.transition = '';
          sidebarDrawer.style.transform = '';
          sidebarDrawer.removeEventListener('transitionend', onEnd);
        }, 420);
      };
      drawerMaxBtn?.addEventListener('click', toggleDrawerMaximize);
      drawerHead?.addEventListener('dblclick', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        toggleDrawerMaximize();
      });

      // 供 CompanionLayout 以「目标状态」驱动全屏；silent 模式下由协调器统一接管过渡动画
      const setDrawerMaximized = (want: boolean, opts?: { silent?: boolean }) => {
        if (!sidebarDrawer) return;
        if (sidebarDrawer.classList.contains('is-maximized') === want) return;
        if (opts?.silent) {
          applyDrawerMaxState(want);
          return;
        }
        toggleDrawerMaximize();
      };

      // 交给同屏协调器接管摆放（并排 / 全屏 / 单浮岛互切）；协调器脚本可能后到，做一次短重试
      const registerAskPanel = (retries = 24) => {
        // 换页后旧抽屉会被移除，别把脱离文档的旧节点注册进新协调器
        if (!sidebarDrawer?.isConnected) return;
        const companion = (window as any).__companion;
        if (companion?.register) {
          companion.register('ask', sidebarDrawer, {
            open: openSidebar,
            close: closeSidebar,
            isOpen: () => Boolean(sidebarDrawer?.classList.contains('is-open')),
            isFull: () => Boolean(sidebarDrawer?.classList.contains('is-maximized')),
            setFull: setDrawerMaximized,
          });
          return;
        }
        if (retries <= 0) return;
        window.setTimeout(() => registerAskPanel(retries - 1), 50);
      };
      syncAskRegistration = () => registerAskPanel(4);
      registerAskPanel();

      const thread = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-thread')!;
      const drawerBody = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-body')!;
      const welcome = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-welcome')!;
      const form = sidebarDrawer.querySelector<HTMLFormElement>('.ink-ask-drawer-form')!;
      const textarea = sidebarDrawer.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input')!;

      const newChatBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-new')!;
      let isResetting = false;
      const resetConversation = () => {
        if (isResetting) return;
        if (sidebarController) {
          sidebarController.abort();
          sidebarController = null;
        }
        form.classList.remove('is-busy');
        textarea.value = '';
        textarea.style.height = '24px';
        textarea.style.overflowY = 'hidden';

        if (thread.children.length === 0) {
          sidebarDrawer?.classList.remove('has-turns');
          welcome.style.display = '';
          drawerBody.scrollTop = 0;
          textarea.focus({ preventScroll: true });
          return;
        }

        isResetting = true;
        thread.classList.add('is-clearing');
        setTimeout(() => {
          thread.innerHTML = '';
          thread.classList.remove('is-clearing');
          sidebarDrawer?.classList.remove('has-turns');
          welcome.style.display = '';
          welcome.classList.remove('is-entering');
          void welcome.offsetWidth;
          welcome.classList.add('is-entering');
          drawerBody.scrollTop = 0;
          isResetting = false;
          textarea.focus({ preventScroll: true });
        }, 260);
      };
      newChatBtn?.addEventListener('click', resetConversation);

      // 欢迎区典雅题签卡片与底部追问胶囊点击
      sidebarDrawer.querySelectorAll<HTMLButtonElement>('.ink-ask-mini-chip, .ink-ask-prompt-card').forEach((card) => {
        card.addEventListener('click', () => {
          const q = card.dataset.ask || card.textContent?.trim() || '';
          if (q) askDrawer(q);
        });
      });

      // 自动撑高 textarea
      function adjustTextareaHeight() {
        textarea.style.height = 'auto';
        const scrollH = textarea.scrollHeight;
        if (scrollH > 120) {
          textarea.style.height = '120px';
          textarea.style.overflowY = 'auto';
        } else {
          textarea.style.height = `${Math.max(24, scrollH)}px`;
          textarea.style.overflowY = 'hidden';
        }
      }

      textarea.addEventListener('input', adjustTextareaHeight);

      // 输入框快捷按键
      textarea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
          e.preventDefault();
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const q = textarea.value.trim();
        if (!q) return;
        textarea.value = '';
        textarea.style.height = '24px';
        textarea.style.overflowY = 'hidden';
        askDrawer(q);
      });

      async function askDrawer(question: string) {
        if (sidebarController) return;
        welcome.style.display = 'none'; // 提问后收起欢迎引导
        sidebarDrawer?.classList.add('has-turns');
        const controller = new AbortController();
        sidebarController = controller;
        form.classList.add('is-busy');

        const { turn, answer, status } = addTurn(thread, question);
        drawerBody.scrollTop = drawerBody.scrollHeight;
        let text = '';
        let displayed = 0;
        let pumpFrame = 0;
        let streamDone = false;
        let resolveReveal: (() => void) | null = null;
        const revealComplete = new Promise<void>((resolve) => { resolveReveal = resolve; });

        const renderAnswer = () => {
          answer.innerHTML = renderMarkdown(text.slice(0, displayed));
          if (turn.classList.contains('is-streaming')) placeCaret(answer);
          if (nearEnd(drawerBody)) drawerBody.scrollTop = drawerBody.scrollHeight;
        };

        const pump = () => {
          pumpFrame = 0;
          if (controller.signal.aborted) return;
          if (displayed < text.length) {
            const remaining = text.length - displayed;
            displayed = Math.min(text.length, displayed + Math.max(2, Math.ceil(remaining * 0.16)));
            renderAnswer();
          }
          if (streamDone && displayed >= text.length) {
            resolveReveal?.();
            resolveReveal = null;
            return;
          }
          pumpFrame = requestAnimationFrame(pump);
        };

        const scheduleReveal = () => {
          if (!pumpFrame) pumpFrame = requestAnimationFrame(pump);
        };

        try {
          let response: Response;
          if (isMockMode) {
          response = mockStreamResponse(true, question);
        } else {
          response = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              path: location.pathname,
              isArticle: true,
              question,
            }),
            signal: controller.signal,
          });
        }

        if (!response.ok || !response.body) {
          const data = await response.json().catch(() => null);
          throw new Error(data?.error || `请求失败（${response.status}）`);
        }

          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          let finish: { cached?: boolean; truncated?: boolean } | null = null;
          while (!finish) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            for (let cut; (cut = buffer.indexOf('\n\n')) !== -1; ) {
              const line = buffer.slice(0, cut).split('\n').find((l) => l.startsWith('data:'));
              buffer = buffer.slice(cut + 2);
              if (!line) continue;
              const message = JSON.parse(line.slice(5));
              if (message.error) throw new Error(message.error);
              if (message.t && !text) status.querySelector('.ink-ask-status-text')!.textContent = '沉思推演中';
              if (message.d) {
                if (!text) {
                  status.classList.add('is-leaving');
                  turn.classList.add('is-streaming', 'is-answering');
                  window.setTimeout(() => {
                    if (!controller.signal.aborted) status.hidden = true;
                  }, 180);
                }
                text += message.d;
                scheduleReveal();
              }
              if (message.done) finish = message;
            }
          }
          if (!text.trim()) throw new Error('没有收到回答，稍后再试');
          streamDone = true;
          scheduleReveal();
          await revealComplete;
          turn.classList.remove('is-streaming');
          turn.classList.toggle('is-cached', Boolean(finish?.cached));
          renderAnswer();
          addSaveNoteButton(turn, () => text, question, answer);
          if (finish?.truncated) note(turn, '回答太长，后面被截断了');
        } catch (error) {
          if (controller.signal.aborted) return;
          if (pumpFrame) cancelAnimationFrame(pumpFrame);
          streamDone = true;
          turn.classList.remove('is-streaming');
          if (text) {
            displayed = text.length;
            renderAnswer();
          }
          status.hidden = false;
          status.classList.remove('is-leaving');
          status.classList.add('is-error');
          status.textContent = error instanceof TypeError ? '网络好像断了，稍后再试' : (error as Error).message || '出错了，稍后再试';
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.className = 'ink-ask-retry';
          retry.textContent = '再试一次';
          retry.addEventListener('click', () => {
            turn.remove();
            askDrawer(question);
          });
          status.append(retry);
        } finally {
          if (sidebarController === controller) {
            sidebarController = null;
            form.classList.remove('is-busy');
          }
        }
      }
    }
  }

  function openSidebar(opts?: { silent?: boolean } | Event) {
    const isSilent = Boolean(opts && !(opts instanceof Event) && opts.silent);
    ensureSidebar();
    setWelcomeEpigraph(sidebarDrawer?.querySelector<HTMLElement>('.ink-ask-welcome-epigraph'));

    lockScrollAnchor(500);

    if (isSilent && sidebarDrawer) {
      sidebarDrawer.style.transition = 'none';
      sidebarOverlay?.classList.add('is-open');
      sidebarDrawer.classList.add('is-open');
      document.body.classList.add('ink-ask-drawer-open');
      void sidebarDrawer.offsetWidth;
      sidebarDrawer.style.transition = '';
    } else {
      if (sidebarDrawer) void sidebarDrawer.offsetWidth;
      if (sidebarOverlay) void sidebarOverlay.offsetWidth;
      sidebarOverlay?.classList.add('is-open');
      sidebarDrawer?.classList.add('is-open');
      document.body.classList.add('ink-ask-drawer-open');
      sidebarDrawer?.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input')?.focus({ preventScroll: true });
    }

    window.dispatchEvent(new CustomEvent('companion:panel', { detail: { kind: 'ask', open: true } }));
    window.dispatchEvent(new CustomEvent('ink-ask:open'));
    clampCardAwayFromRails();
  }

  function closeSidebar(opts?: { instant?: boolean } | Event) {
    const isInstant = Boolean(opts && !(opts instanceof Event) && opts.instant);
    lockScrollAnchor(500);
    const wasMax = sidebarDrawer?.classList.contains('is-maximized');

    if (isInstant && sidebarDrawer) {
      sidebarDrawer.style.transition = 'none';
      sidebarOverlay?.classList.remove('is-open');
      sidebarDrawer.classList.remove('is-open', 'is-maximized');
      document.body.classList.remove('ink-ask-drawer-open', 'ink-ask-drawer-maximized');
      const maxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize');
      if (maxBtn) {
        maxBtn.innerHTML = MAXIMIZE_ICON;
        maxBtn.dataset.tip = '全屏展开';
      }
      void sidebarDrawer.offsetWidth;
      sidebarDrawer.style.transition = '';
      sidebarController?.abort();
      window.dispatchEvent(new CustomEvent('companion:panel', { detail: { kind: 'ask', open: false } }));
      return;
    }

    sidebarOverlay?.classList.remove('is-open');
    sidebarDrawer?.classList.remove('is-open');
    document.body.classList.remove('ink-ask-drawer-open');
    sidebarController?.abort();
    sidebarBtn?.focus();

    window.dispatchEvent(new CustomEvent('companion:panel', { detail: { kind: 'ask', open: false } }));

    setTimeout(() => {
      if (sidebarDrawer?.classList.contains('is-open')) return;
      if (wasMax && sidebarDrawer) {
        sidebarDrawer.classList.remove('is-maximized');
        document.body.classList.remove('ink-ask-drawer-maximized');
        const maxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize');
        if (maxBtn) {
          maxBtn.innerHTML = MAXIMIZE_ICON;
          maxBtn.dataset.tip = '全屏展开';
        }
      }
    }, 340);
  }

  function toggleSidebar() {
    if (sidebarDrawer?.classList.contains('is-open')) closeSidebar();
    else openSidebar();
  }

  function openSidebarWithContext(snippet: string) {
    ensureSidebar();
    openSidebar();
    const textarea = sidebarDrawer?.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input');
    if (textarea && snippet) {
      const cleanSnippet = snippet.trim();
      textarea.value = cleanSnippet;
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.focus({ preventScroll: true });
      textarea.setSelectionRange(textarea.value.length, textarea.value.length);
    }
  }

  function resetConversation() {
    sidebarDrawer?.querySelector<HTMLButtonElement>('.ink-ask-drawer-new')?.click();
  }

  (window as any).__inkAsk = {
    ensureSidebar,
    openSidebar,
    closeSidebar,
    toggleSidebar,
    resetConversation,
    openSidebarWithContext,
    clampCard: clampCardAwayFromRails,
  };

  window.addEventListener('inkask:open-with-context', (e: any) => {
    const text = e.detail?.snippet || e.detail?.text || '';
    openSidebarWithContext(text);
  });

  // 与「高亮笔记」抽屉彻底解耦：不再互相关闭。
  // 摆位与同屏模式由 CompanionLayout 统一协调（浮岛 / 全屏 / 并排）。
  window.addEventListener('article-notes:open', () => {
    (window as any).__companion?.sync?.();
    clampCardAwayFromRails();
  });

  // ---------- 全局监听 ----------

  function initInkAsk() {
    if (!prose()) return;
    ensureSidebar();
    probe().then(() => {});
  }

  initInkAsk();

  if (!(window as any)[LISTENER_KEY]) {
    (window as any)[LISTENER_KEY] = true;

    document.addEventListener(
      'pointerdown',
      (event) => {
        const target = event.target as Element | null;
        if (target?.closest?.('.ink-ask-seal, .ink-ask-card, .ink-ask-sidebar-trigger, .ink-ask-drawer')) return;
        // 选区小窗只认自己的 × 按钮：点正文 / 点笔记 / 点空白都不再关闭它，
        // 这样才可能「一边写笔记一边看问答」。
        if (event.pointerType === 'mouse' && event.button === 0) {
          mouseDown = true;
          hideSeal();
        }
      },
      true,
    );

    document.addEventListener(
      'pointerup',
      () => {
        if (!mouseDown) return;
        mouseDown = false;
        settleSoon(20);
      },
      true,
    );

    document.addEventListener('selectionchange', () => {
      if (!mouseDown) settleSoon(280);
    });

    function trapModalTab(container: HTMLElement, e: KeyboardEvent) {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(
        container.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => el.offsetParent !== null || el.offsetWidth > 0 || el.offsetHeight > 0);
      if (focusables.length === 0) {
        e.preventDefault();
        return;
      }
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first || !container.contains(document.activeElement)) {
          e.preventDefault();
          last.focus({ preventScroll: true });
        }
      } else {
        if (document.activeElement === last || !container.contains(document.activeElement)) {
          e.preventDefault();
          first.focus({ preventScroll: true });
        }
      }
    }

    document.addEventListener('keydown', (event) => {
      const active = document.activeElement as HTMLElement | null;
      // 并排时两块面板都要能用 Tab 互相到达，此时不做模态焦点陷阱
      const trapAllowed = document.documentElement.getAttribute('data-companion-mode') !== 'split';
      if (sidebarDrawer?.classList.contains('is-open')) {
        // 只有焦点确实落在面板里才接管 Tab，否则会抢走笔记抽屉的键盘操作
        if (trapAllowed && event.key === 'Tab' && active && sidebarDrawer.contains(active)) {
          trapModalTab(sidebarDrawer, event);
          return;
        }
        if (event.key === 'Escape') {
          if (sidebarDrawer.classList.contains('is-maximized')) {
            event.preventDefault();
            event.stopPropagation();
            const maxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize');
            maxBtn?.click();
            return;
          }
          closeSidebar();
          return;
        }
      }

      if (session) {
        if (trapAllowed && event.key === 'Tab' && active && session.card.contains(active)) {
          trapModalTab(session.card, event);
          return;
        }
        if (event.key === 'Escape') {
          if (session.card.classList.contains('is-maximized')) {
            event.preventDefault();
            event.stopPropagation();
            const maxBtn = session.card.querySelector<HTMLButtonElement>('.ink-ask-card-maximize');
            maxBtn?.click();
            return;
          }
          // Esc 不再关闭小窗：它只认标题栏的 ×
          return;
        }
      }

      if (event.key === 'Escape') {
        hideSeal();
      }
    });

    let resizeFrame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        hideSeal();
        if (session) place(session);
      });
    });

    document.addEventListener('astro:page-load', () => {
      initInkAsk();
    });

    window.addEventListener('companion:ready', () => {
      syncAskRegistration?.();
    });

    document.addEventListener('astro:before-swap', () => {
      close(true);
      closeSidebar();
      hideSeal();
      syncAskRegistration = null;
      seal?.remove();
      seal = null;
      sidebarBtn?.remove();
      sidebarBtn = null;
      sidebarOverlay?.remove();
      sidebarOverlay = null;
      sidebarDrawer?.remove();
      sidebarDrawer = null;
    });
  }
</script>

