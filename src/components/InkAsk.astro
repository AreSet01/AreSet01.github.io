              <textarea class="ink-ask-drawer-input" rows="1" maxlength="500" placeholder="向墨问请教本文脉络、概念或细节…" enterkeyhint="send"></textarea>
              <button type="submit" class="ink-ask-drawer-send" aria-label="发送">问</button>
