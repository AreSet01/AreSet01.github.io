    font-size: 0.88rem;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-height: 140px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  /* 对话流区（可自适应滚动） */
  .ink-ask-thread {
    flex: 1 1 0%;
    min-height: 0;
    padding: 0.75rem 1.1rem 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px dashed var(--rule);
    scrollbar-width: none !important; -ms-overflow-style: none !important; -webkit-overflow-scrolling: touch;
  }
  .ink-ask-thread:empty {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 1rem;
  }
  .ink-ask-thread:empty::after {
    content: '💬 已将选中文本置入输入框，可在末尾添加问题，或直接发送提问…';
    font-size: 0.84rem;
    color: var(--muted);
    font-style: italic;
    text-align: center;
    line-height: 1.5;
  }
  .ink-ask-turn {
    animation: inkAskTurnEnter 340ms cubic-bezier(0.175, 0.885, 0.32, 1.12) both;
  }
  @keyframes inkAskTurnEnter {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .ink-ask-turn + .ink-ask-turn {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--rule-soft);
  }

  /* 追问样式强化（独立气泡签，高区分度） */
  .ink-ask-q {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0 0 0.75rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--vermilion);
    border-radius: 6px;
    background: var(--bg-soft);
    color: var(--text-strong);
    font-size: 0.9rem;
    line-height: 1.6;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    animation: inkAskQPop 300ms cubic-bezier(0.175, 0.885, 0.32, 1.12) both;
  }
  @keyframes inkAskQPop {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .ink-ask-q-tag {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    margin-top: 0.1rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--vermilion);
    border-radius: 999px;
    background: var(--vermilion-soft);
    color: var(--vermilion);
    font-family: var(--font-hand-title);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }
  .ink-ask-q-text {
    flex: 1;
    font-weight: 500;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: anywhere;
    line-height: 1.6;
  }

  /* 快捷预设提问标签（平易近人、口语通俗） */
  .ink-ask-quick-prompts {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.45rem 1.1rem 0.2rem;
  }
  .ink-ask-pill {
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text);
    font-size: 0.76rem;
    line-height: 1.3;
    cursor: pointer;
    white-space: nowrap;
    transition: all 180ms ease;
  }
  .ink-ask-pill:hover {
    border-color: var(--vermilion);
    color: var(--vermilion);
    background: var(--vermilion-soft);
    transform: translateY(-1px);
  }

  /* 回答正文：文字自然流式逐字涌出，容器保持稳定不闪烁 */
  .ink-ask-answer {
    font-size: 0.95rem;
    line-height: 1.82;
    overflow-wrap: anywhere;
  }

  .ink-ask-turn.is-answering .ink-ask-answer {
    /* 彻底移除 inkAnswerIn 的 opacity 0 与 filter blur，保证首字输出时如水墨顺畅流淌，零黑屏零闪烁 */
    animation: none;
  }
  .ink-ask-answer > * {
    margin: 0 0 0.65em;
  }
  .ink-ask-answer > :last-child {
    margin-bottom: 0;
  }
  .ink-ask-answer ul {
    padding-left: 1.3em;
    list-style: disc;
  }
  .ink-ask-answer ol {
    padding-left: 1.4em;
    list-style: decimal;
  }
  .ink-ask-answer li {
    margin-bottom: 0.25em;
  }
  .ink-ask-answer li::marker {
    color: var(--ink-strong);
  }
  .ink-ask-answer strong,
  .ink-ask-answer .ink-ask-h {
    color: var(--text-strong);
    font-weight: 700;
  }
  .ink-ask-answer em {
    font-style: italic;
  }
  .ink-ask-answer a {
    color: var(--ink-strong);
    border-bottom: 1px solid currentColor;
  }
  .ink-ask-answer code {
    padding: 0.08em 0.36em;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--bg-soft);
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.86em;
  }
  .ink-ask-answer pre {
    padding: 0.7rem 0.85rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg-soft);
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .ink-ask-answer pre code {
    padding: 0;
    border: 0;
    background: none;
    font-size: inherit;
    white-space: pre;
    overflow-wrap: normal;
  }
  .ink-ask-answer blockquote {
    padding-left: 0.75rem;
    border-left: 2.5px solid var(--rule-strong);
    color: var(--muted-strong);
  }
  .ink-ask-table {
    overflow-x: auto;
  }
  .ink-ask-table table {
    border-collapse: collapse;
    font-size: 0.85rem;
  }
  .ink-ask-table th,
  .ink-ask-table td {
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }
  .ink-ask-table th {
    background: var(--bg-soft);
    color: var(--text-strong);
  }
  .ink-ask-turn.is-cached .ink-ask-answer {
    /* 缓存秒出保持原文字稳定，杜绝 opacity: 0 重置导致的二次刺眼闪烁 */
    animation: none;
  }

  .ink-ask-caret {
    display: inline-block;
    width: 0.45em;
    height: 0.45em;
    margin-left: 0.2em;
    border-radius: 50%;
    background: var(--ink-strong);
    vertical-align: 0.1em;
    animation: ink-ask-breathe 1.1s ease-in-out infinite;
  }
  .ink-ask-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .ink-ask-status.is-leaving {
    opacity: 0;
    transform: translateY(-2px);
  }
  .ink-ask-status[hidden] {
    display: none;
  }
  .ink-ask-status.is-error {
    color: var(--text-strong);
  }
  .ink-ask-dots {
    display: inline-flex;
    gap: 0.28rem;
  }
  .ink-ask-dots i {
    width: 0.34rem;
    height: 0.34rem;
    border-radius: 50%;
    background: var(--ink-strong);
    animation: ink-ask-breathe 1.2s ease-in-out infinite;
  }
  .ink-ask-dots i:nth-child(2) {
    animation-delay: 0.18s;
  }
  .ink-ask-dots i:nth-child(3) {
    animation-delay: 0.36s;
  }
  .ink-ask-retry {
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    color: var(--text-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background 180ms ease;
  }
  .ink-ask-retry:hover {
    background: var(--accent-soft);
  }
  .ink-ask-note {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .ink-ask-save-note {
    align-self: flex-start;
    margin-top: 0.55rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: background 180ms ease, color 180ms ease, border-color 180ms ease, transform 160ms var(--ease);
    animation: inkSaveNoteIn 260ms var(--ease) both;
  }

  @keyframes inkSaveNoteIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ink-ask-save-note:hover {
    background: var(--accent-soft);
    color: var(--text-strong);
    transform: translateY(-1px);
  }

  .ink-ask-save-note:active {
    transform: scale(0.96);
  }

  .ink-ask-save-note.is-partial {
    border-color: var(--accent);
    color: var(--accent-strong);
    background: var(--accent-soft);
  }

  .ink-ask-save-note.is-saved {
    border-color: var(--accent);
    color: var(--accent-strong);
    animation: inkSaveNoteSaved 420ms var(--ease) both;
  }

  @keyframes inkSaveNoteSaved {
    0% {
      transform: scale(1);
    }
    45% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  /* 输入框与底栏 */
  .ink-ask-form {
    display: flex;
    flex-shrink: 0;
    align-items: flex-end;
    gap: 0.55rem;
    padding: 0.55rem 0.85rem 0.4rem 1rem;
    border-top: 1px solid var(--rule-soft);
    background: var(--bg-soft);
  }
  .ink-ask-input {
    flex: 1;
    min-width: 0;
    min-height: 38px;
    max-height: 140px;
    padding: 0.48rem 0.75rem;
    border: 1.5px solid var(--rule);
    border-radius: 6px;
    outline: none;
    background: var(--bg-elev);
    color: var(--text-strong);
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.55;
    resize: none;
    overflow-y: hidden;
    scrollbar-width: thin;
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }
  .ink-ask-input::placeholder {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .ink-ask-input:focus {
    border-color: var(--vermilion);
    box-shadow: 0 0 0 2.5px var(--vermilion-soft);
  }
  .ink-ask-send {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1.5px solid var(--vermilion);
    border-radius: 6px;
    background: var(--bg-elev);
    color: var(--vermilion);
    font-family: var(--font-hand-title);
    font-size: 1rem;
    font-weight: 700;
    box-shadow: inset 0 0 5px var(--vermilion-soft);
    transform: rotate(-3deg);
    cursor: pointer;
    transition: transform 180ms var(--ease-bounce), opacity 180ms ease, background 180ms ease, color 180ms ease;
  }
  .ink-ask-send:hover,
  .ink-ask-send:focus-visible {
    outline: none;
    transform: rotate(0deg) scale(1.05);
    background: var(--vermilion);
    color: var(--bg-base);
  }
  [data-theme="dark"] .ink-ask-send:hover,
  [data-theme="dark"] .ink-ask-send:focus-visible {
    background: #ffffff;
    color: #141414;
    border-color: #ffffff;
  }
  [data-theme="moss"] .ink-ask-send:hover,
  [data-theme="moss"] .ink-ask-send:focus-visible {
    background: var(--accent);
    color: var(--moss-badge-text, #004D40);
    border-color: var(--accent);
  }
  .ink-ask-form.is-busy .ink-ask-send {
    opacity: 0.35;
    pointer-events: none;
    transform: none;
  }

  /* ---------- 右上角 AI 伴读常驻按钮 ---------- */
  .ink-ask-sidebar-trigger {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 99;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem 0.45rem 0.75rem;
    border-radius: 6px;
    background: var(--glass-bg);
    border: 1px solid var(--rule-strong);
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.08),
      0 1px 3px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
    color: var(--text-strong);
    font-family: var(--font-hand-title);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 240ms ease,
                border-color 240ms ease,
                background 240ms ease,
                transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 240ms ease;
  }
  [data-theme="dark"] .ink-ask-sidebar-trigger {
    background: var(--glass-bg-strong);
    box-shadow:
      0 6px 24px rgba(0, 0, 0, 0.45),
      0 1px 3px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .ink-ask-sidebar-trigger:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.06) translateX(-3px);
    box-shadow:
      0 10px 32px rgba(0, 0, 0, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .ink-ask-sidebar-icon {
    display: inline-flex;
    align-items: center;
    color: var(--vermilion);
  }
  .ink-ask-sidebar-label {
    line-height: 1;
  }

  /* ---------- 右侧 AI 聊天抽屉 (Dual-Pane Floating Island & Bottom Sheet) ---------- */
  @media (min-width: 1024px) {
    .ink-ask-drawer-overlay {
      display: none !important;
      pointer-events: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }

    .ink-ask-drawer {
      position: fixed;
      top: clamp(1rem, 2.5vh, 1.8rem);
      bottom: clamp(1rem, 2.5vh, 1.8rem);
      right: clamp(1rem, 1.6vw, 1.8rem);
      z-index: 100011;
      display: flex;
      flex-direction: column;
      width: clamp(400px, 29vw, 480px);
      max-width: calc(100vw - 2.5rem);
      height: auto;
      max-height: calc(100vh - 2 * clamp(1rem, 2.5vh, 1.8rem));
      max-height: calc(100dvh - 2 * clamp(1rem, 2.5vh, 1.8rem));
      background: var(--glass-bg-strong, var(--bg-elev));
      border: 1px solid var(--rule-strong, rgba(0, 0, 0, 0.18));
      border-radius: 16px;
      box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.12),
        0 4px 16px rgba(0, 0, 0, 0.04);
      backdrop-filter: blur(24px) saturate(160%);
      -webkit-backdrop-filter: blur(24px) saturate(160%);
      transform: translate3d(calc(100% + 2.5rem), 0, 0) scale(0.98);
      opacity: 0;
      transition:
        transform 380ms cubic-bezier(0.175, 0.885, 0.32, 1.12),
        opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
      font-family: var(--font-hand);
      overflow: hidden;
      overscroll-behavior: contain;
    }

    [data-theme="dark"] .ink-ask-drawer {
      background: rgba(24, 24, 24, 0.95);
      border-color: rgba(255, 255, 255, 0.16);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
    }

    .ink-ask-drawer.is-open {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 1;
    }
  }

  @media (max-width: 1023.98px) {
    .ink-ask-drawer-overlay {
      position: fixed;
      inset: 0;
      z-index: 100010;
      background: rgba(0, 0, 0, 0.38);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 280ms ease, visibility 280ms ease;
    }

    .ink-ask-drawer-overlay.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .ink-ask-drawer {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      top: auto;
      z-index: 100011;
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 100%;
      height: 82vh;
      height: 82dvh;
      max-height: 85vh;
      max-height: 85dvh;
      background: var(--glass-bg-strong, var(--bg-elev));
      border-top: 1px solid var(--rule-strong, rgba(0, 0, 0, 0.18));
      border-radius: 20px 20px 0 0;
      box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.16);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      transform: translate3d(0, 100%, 0);
      transition: transform 380ms cubic-bezier(0.175, 0.885, 0.32, 1.12);
      font-family: var(--font-hand);
      overflow: hidden;
    }

    [data-theme="dark"] .ink-ask-drawer {
      background: rgba(24, 24, 24, 0.98);
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.6);
    }

    .ink-ask-drawer.is-open {
      transform: translate3d(0, 0, 0);
    }
  }

  .drawer-drag-handle {
    width: 36px;
    height: 4px;
    border-radius: 9999px;
    background: var(--rule-strong, rgba(0, 0, 0, 0.25));
    margin: 8px auto 4px auto;
    flex-shrink: 0;
  }

  .ink-ask-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid var(--rule-soft);
    background: var(--bg-soft);
  }
  .ink-ask-drawer-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .ink-ask-drawer-new {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.52rem;
    font-size: 0.74rem;
    font-family: inherit;
    font-weight: 500;
    line-height: 1;
    border-radius: 6px;
    border: 1px solid var(--rule);
    background: var(--bg);
    color: var(--text-soft);
    cursor: pointer;
    transition: all 180ms ease;
  }
  .ink-ask-drawer-new:hover {
    color: var(--text-strong);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .ink-ask-drawer-title-area {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .ink-ask-drawer-title {
    margin: 0;
    font-family: var(--font-hand-title);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-strong);
  }
  .ink-ask-drawer-close,
  .ink-ask-drawer-maximize {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--muted-strong);
    cursor: pointer;
    transition: all 180ms ease;
  }
  .ink-ask-drawer-close:hover,
  .ink-ask-drawer-maximize:hover,
  .ink-ask-drawer-maximize:focus-visible {
    outline: none;
    color: var(--text-strong);
    border-color: var(--rule);
    background: var(--accent-soft);
  }

  .ink-ask-drawer.is-maximized {
    position: fixed !important;
    inset: 0 !important;
    top: 0 !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100vw !important;
    max-width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    max-height: 100vh !important;
    max-height: 100dvh !important;
    border-radius: 0 !important;
    border: none !important;
    box-shadow: none !important;
    z-index: 100025 !important;
    background: var(--bg-base) !important;
  }

  [data-theme="dark"] .ink-ask-drawer.is-maximized {
    background: var(--bg-base, #161616) !important;
  }

  [data-theme="moss"] .ink-ask-drawer.is-maximized {
    background: var(--bg-base, #032b26) !important;
  }

  .ink-ask-drawer-head-inner,
  .ink-ask-drawer-body-inner,
  .ink-ask-drawer-form-inner {
    width: 100%;
    display: flex;
  }
  .ink-ask-drawer-head-inner {
    align-items: center;
    justify-content: space-between;
  }
  .ink-ask-drawer-body-inner {
    flex-direction: column;
    min-height: 100%;
  }
  .ink-ask-drawer-form-inner {
    flex-direction: column;
  }

  .ink-ask-drawer.is-maximized .drawer-drag-handle {
    display: none !important;
  }

  .ink-ask-drawer.is-maximized .ink-ask-drawer-head {
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 !important;
    background: var(--bg-soft) !important;
    border-bottom: 1px solid var(--rule-soft) !important;
  }
  .ink-ask-drawer.is-maximized .ink-ask-drawer-head-inner {
    max-width: 1000px !important;
    margin: 0 auto !important;
    padding: 0.65rem 1.5rem !important;
  }
  .ink-ask-drawer.is-maximized .ink-ask-drawer-title {
    font-size: 1.08rem !important;
  }

  .ink-ask-drawer.is-maximized .ink-ask-drawer-body {
    width: 100% !important;
    max-width: 100% !important;
    padding: 0 !important;
