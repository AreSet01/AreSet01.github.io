---
// InkAsk.astro — 墨问 · AI 伴读与划词问答
// 1. 在正文里选中一段 → 选区末尾钤出「问」→ 墨圈圈出，卡片流式写出通俗生动的解答，支持拖拽移动窗口。
// 2. 右上角常驻「墨问 AI」伴读按钮 → 点击滑出右侧全文伴读侧边栏，支持多轮深入探讨。
// 3. 服务端是 server/ask.mjs。
---

<script>
  import { renderMarkdown, domRangeToMarkdown } from '../utils/inkAskMarkdown';
  import { makeResizable, loadPanelSize } from '../utils/panelResize';
  import { bindScrollIsolation } from '../utils/scrollIsolation';
  import { lockScrollAnchor } from '../utils/scrollAnchorLock';

  const ENDPOINT = '/api/ask';
  const MAX_SELECTION = 400;
  const ANCHOR_CHARS = 40;
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const LISTENER_KEY = '__areSetInkAskBound__';
  const SKIP = '.code-block-toolbar, .mermaid-block-header, button, [aria-hidden="true"]';
  const BLOCK = 'p, li, pre, td, th, blockquote, h1, h2, h3, h4, h5, h6, dt, dd, figcaption, .mermaid-block';

  type Anchor = { text: string; prefix: string; suffix: string };
  type Box = { left: number; top: number; right: number; bottom: number; width: number; height: number };
  type Session = {
    card: HTMLElement;
    thread: HTMLElement;
    form: HTMLFormElement;
    input: HTMLInputElement | HTMLTextAreaElement;
    ring: SVGSVGElement;
    range: Range;
    anchor: Anchor;
    origin: { x: number; y: number };
    controller: AbortController | null;
    stop: AbortController;
    userMoved?: boolean;
  };

  let available: Promise<boolean> | null = null;
  let seal: HTMLButtonElement | null = null;
  let sealRange: Range | null = null;
  let session: Session | null = null;
  let mouseDown = false;
  let settleTimer = 0;

  // 侧边栏状态
  let sidebarBtn: HTMLButtonElement | null = null;
  let sidebarDrawer: HTMLElement | null = null;
  let sidebarOverlay: HTMLElement | null = null;
  let sidebarController: AbortController | null = null;

  const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const useSheet = () => window.innerWidth < 768;
  const prose = () => document.querySelector<HTMLElement>('[data-post-prose]');
  const postTitle = () => document.querySelector<HTMLElement>('[data-post-title]')?.textContent?.trim() || document.title || '本文';

  let isMockMode = false;

  function mockStreamResponse(isArticle: boolean, question: string, selection?: string): Response {
    const mockText = isArticle
      ? `【清浅 · 静态伴读演示】\n\n你好！欢迎体验「清浅」的全文 AI 伴读侧边栏。\n\n当前站点运行于 **GitHub Pages 纯静态托管环境**。在未连接私有大模型 API 服务时，系统自动切入演示模式。\n\n- **双卷并排**：点击顶栏的分屏按钮，可自由推挤切换文章与伴读工作台。\n- **自建服务**：只需克隆本仓库并在服务器启动 \`server/ask.mjs\`（配置 \`AI_API_KEY\`），即可享受流式大模型阅读理解与多轮推演。`
      : `【清浅 · 划词伴读演示】\n\n已收到你的提问：*“${question.trim() || '这段文字是什么意思？'}”*\n\n划选内容：> *${(selection || '').slice(0, 60)}${(selection || '').length > 60 ? '...' : ''}*\n\n当前站点部署在 **GitHub Pages 静态空间**。在完整部署模式下，伴读助手会结合文章上下文，调用大模型进行实时流式解答与概念拆解。\n\n你可以尝试继续在正文中划词，或体验右侧的双卷工作台。`;

    const encoder = new TextEncoder();
    const stream = new ReadableStream({
      async start(ctrl) {
        await new Promise((r) => setTimeout(r, 200));
        ctrl.enqueue(encoder.encode(`data: ${JSON.stringify({ t: '' })}\n\n`));

        const chunks = mockText.match(/[\s\S]{1,4}/g) || [mockText];
        for (const chunk of chunks) {
          await new Promise((r) => setTimeout(r, 20));
          ctrl.enqueue(encoder.encode(`data: ${JSON.stringify({ t: chunk })}\n\n`));
        }
        ctrl.enqueue(encoder.encode(`data: ${JSON.stringify({ finish: { cached: false } })}\n\n`));
        ctrl.close();
      },
    });
    return new Response(stream, {
      headers: { 'Content-Type': 'text/event-stream' },
    });
  }

  // 探测后端服务是否可用（若不可用则优雅降级为 Demo 演示模式）
  function probe(): Promise<boolean> {
    if (available) return available;
    available = fetch(ENDPOINT, { cache: 'no-store', signal: AbortSignal.timeout(2500) })
      .then(async (res) => {
        if (res.ok && (await res.json())?.ok === true) {
          isMockMode = false;
          return true;
        }
        isMockMode = true;
        return true;
      })
      .catch(() => {
        isMockMode = true;
        return true;
      });
    return available;
  }

  // ---------- 选区 → 纯文字 ----------

  function rangeText(range: Range): string {
    const fragment = range.cloneContents();
    fragment.querySelectorAll(SKIP).forEach((el) => el.remove());
    fragment.querySelectorAll(BLOCK).forEach((el) => el.append('\n'));
    return (fragment.textContent || '')
      .replace(/[ \t\f\r ]+/g, ' ')
      .replace(/ *\n */g, '\n')
      .replace(/\n{2,}/g, '\n')
      .trim();
  }

  function blockOf(node: Node, root: HTMLElement): Node {
    const el = node instanceof Element ? node : node.parentElement;
    const block = el?.closest(BLOCK);
    return block && root.contains(block) ? block : root;
  }

  function anchorOf(range: Range, root: HTMLElement): Anchor {
    const before = document.createRange();
    before.setStart(blockOf(range.startContainer, root), 0);
    before.setEnd(range.startContainer, range.startOffset);
    const endBlock = blockOf(range.endContainer, root);
    const after = document.createRange();
    after.setStart(range.endContainer, range.endOffset);
    after.setEnd(endBlock, endBlock.childNodes.length);
    return {
      text: rangeText(range),
      prefix: rangeText(before).slice(-ANCHOR_CHARS),
      suffix: rangeText(after).slice(0, ANCHOR_CHARS),
    };
  }

  function lineRects(range: Range): DOMRect[] {
    return Array.from(range.getClientRects()).filter((r) => r.width > 1 && r.height > 1);
  }

  function boxOf(rects: DOMRect[]): Box {
    const left = Math.min(...rects.map((r) => r.left));
    const top = Math.min(...rects.map((r) => r.top));
    const right = Math.max(...rects.map((r) => r.right));
    const bottom = Math.max(...rects.map((r) => r.bottom));
    return { left, top, right, bottom, width: right - left, height: bottom - top };
  }

  // ---------- 「问」印 ----------

  function ensureSeal(): HTMLButtonElement {
    if (seal?.isConnected) return seal;
    seal = document.createElement('button');
    seal.type = 'button';
    seal.className = 'ink-ask-seal';
    seal.textContent = '问';
    seal.title = '问问 AI（通俗解释）';
    seal.setAttribute('aria-label', '问 AI：通俗解释选中的内容');
    seal.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') event.preventDefault();
    });
    seal.addEventListener('click', () => {
      const root = prose();
      if (sealRange && root) open(sealRange, root);
    });
    seal.addEventListener('animationend', (event) => {
      if (event.pseudoElement) seal?.classList.remove('is-stamping');
    });
    document.body.append(seal);
    return seal;
  }

  function hideSeal() {
    sealRange = null;
    seal?.classList.remove('is-shown', 'is-stamping');
  }

  function showSeal(range: Range) {
    if (useSheet()) return hideSeal();
    const rects = lineRects(range);
    if (!rects.length) return hideSeal();
    const last = rects[rects.length - 1];
    const button = ensureSeal();
    const size = 34;
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const x = coarse ? last.right - size / 2 : last.right + 6;
    const y = coarse ? last.bottom + 22 : last.top + last.height / 2 - size / 2;
    button.style.left = `${Math.round(Math.min(Math.max(x, 8), window.innerWidth - size - 8) + window.scrollX)}px`;
    button.style.top = `${Math.round(y + window.scrollY)}px`;
    const wasShown = button.classList.contains('is-shown');
    sealRange = range.cloneRange();
    button.classList.add('is-shown');
    if (!wasShown && !reduceMotion()) {
      button.classList.remove('is-stamping');
      void button.offsetWidth;
      button.classList.add('is-stamping');
    }
  }

  function checkSelection() {
    const root = prose();
    const selection = window.getSelection();
    if (!root || !selection || selection.rangeCount === 0 || selection.isCollapsed) return hideSeal();
    const range = selection.getRangeAt(0);
    if (!root.contains(range.commonAncestorContainer)) return hideSeal();
    if ([...selection.toString().trim()].length < 2) return hideSeal();
    probe().then((ok) => {
      const now = window.getSelection();
      if (ok && now && now.rangeCount && !now.isCollapsed && now.getRangeAt(0) === range) showSeal(range);
    });
  }

  function settleSoon(delay: number) {
    window.clearTimeout(settleTimer);
    settleTimer = window.setTimeout(checkSelection, delay);
  }

  // ---------- 墨圈 ----------

  function seeded(seed: number) {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function strokePoints(box: Box, seed: number): Array<[number, number]> {
    const rand = seeded(seed);
    const points: Array<[number, number]> = [];
    if (box.height > 220) {
      const x = box.left - 14;
      for (let i = 0; i <= 24; i++) {
        const t = i / 24;
        const hook = Math.sin(t * Math.PI);
        points.push([x - hook * 5 + (rand() - 0.5) * 1.2, box.top - 4 + (box.height + 8) * t]);
      }
      return points;
    }
    const cx = box.left + box.width / 2;
    const cy = box.top + box.height / 2;
    const rx = box.width / 2 + 10 + Math.min(box.width * 0.06, 18);
    const ry = box.height / 2 + 8;
    const start = Math.PI * (1.08 + rand() * 0.14);
    const phase = rand() * Math.PI * 2;
    const steps = 64;
    for (let i = 0; i <= steps; i++) {
      const t = i / steps;
      const angle = start + Math.PI * 2 * 1.1 * t;
      const grow = 1 + 0.07 * t;
      const wobble = 1 + 0.03 * Math.sin(angle * 3 + phase) + 0.018 * Math.sin(angle * 5 + phase * 2);
      points.push([cx + rx * grow * wobble * Math.cos(angle), cy + ry * grow * wobble * Math.sin(angle) - 2.5 * t]);
    }
    return points;
  }

  function drawRing(range: Range, ring?: SVGSVGElement): SVGSVGElement | null {
    const rects = lineRects(range);
    if (!rects.length) return null;
    const box = boxOf(rects);
    const seed = Math.round(box.left * 7 + box.top * 13);
    const strokes = [strokePoints(box, seed), strokePoints(box, seed + 1)];
    const all = strokes.flat();
    const minX = Math.min(...all.map((p) => p[0])) - 4;
    const minY = Math.min(...all.map((p) => p[1])) - 4;
    const width = Math.max(...all.map((p) => p[0])) - minX + 4;
    const height = Math.max(...all.map((p) => p[1])) - minY + 4;

    const svg = ring ?? (document.createElementNS(SVG_NS, 'svg') as SVGSVGElement);
    svg.setAttribute('class', svg.getAttribute('class') || 'ink-ask-ring');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('width', String(Math.ceil(width)));
    svg.setAttribute('height', String(Math.ceil(height)));
    svg.setAttribute('viewBox', `0 0 ${Math.ceil(width)} ${Math.ceil(height)}`);
    svg.style.left = `${Math.round(minX + window.scrollX)}px`;
    svg.style.top = `${Math.round(minY + window.scrollY)}px`;
    svg.replaceChildren(
      ...strokes.map((points, i) => {
        const path = document.createElementNS(SVG_NS, 'path');
        path.setAttribute('class', i ? 'ink-ask-ring-echo' : 'ink-ask-ring-main');
        path.setAttribute('pathLength', '1');
        path.setAttribute('d', points.map(([x, y], j) => `${j ? 'L' : 'M'}${(x - minX).toFixed(1)} ${(y - minY).toFixed(1)}`).join(''));
        return path;
      }),
    );
    return svg;
  }

  // ---------- 回答里的 Markdown 解析与容错预处理 ----------

  const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  function placeCaret(answer: HTMLElement) {
    let host: Element | null = answer.lastElementChild;
    while (host && /^(UL|OL|BLOCKQUOTE|DIV|TABLE|TBODY|TR|PRE)$/.test(host.tagName) && host.lastElementChild) host = host.lastElementChild;
    const caret = document.createElement('span');
    caret.className = 'ink-ask-caret';
    (host ?? answer).append(caret);
  }

  // ---------- 拖拽支持 ----------

  function enableDrag(card: HTMLElement, handle: HTMLElement, onMoved: () => void, signal?: AbortSignal) {
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;
    let isDragging = false;
    let isPullingSheet = false;
    let sheetPullStartY = 0;
    let sheetPullDy = 0;

    handle.addEventListener('pointerdown', (e: PointerEvent) => {
      if ((e.target as HTMLElement).closest('button, input, textarea, a')) return;
      if (e.button !== 0) return;
      if (card.classList.contains('is-maximized')) return;

      if (useSheet()) {
        isPullingSheet = true;
        sheetPullStartY = e.clientY;
        sheetPullDy = 0;
        card.style.transition = 'none';
        try { handle.setPointerCapture(e.pointerId); } catch {}
        return;
      }

      e.preventDefault();
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;

      const rect = card.getBoundingClientRect();
      initialLeft = rect.left + window.scrollX;
      initialTop = rect.top + window.scrollY;

      card.classList.add('is-dragging');
      try { handle.setPointerCapture(e.pointerId); } catch {}
    }, { signal });

    const onPointerMove = (ev: PointerEvent) => {
      if (isPullingSheet) {
        const dy = ev.clientY - sheetPullStartY;
        if (dy > 0) {
          sheetPullDy = dy;
          card.style.transform = `translateY(${dy}px)`;
        } else {
          sheetPullDy = 0;
          card.style.transform = '';
        }
        return;
      }

      if (!isDragging) return;
      const dx = ev.clientX - startX;
      const dy = ev.clientY - startY;

      const width = card.offsetWidth;
      const height = card.offsetHeight;
      const minX = 16 + window.scrollX;
      const maxX = window.innerWidth - width - 16 + window.scrollX;
      const minY = 16 + window.scrollY;
      const maxY = window.innerHeight - height - 16 + window.scrollY;

      const nextLeft = Math.max(minX, Math.min(maxX, initialLeft + dx));
      const nextTop = Math.max(minY, Math.min(maxY, initialTop + dy));

      card.style.left = `${Math.round(nextLeft)}px`;
      card.style.top = `${Math.round(nextTop)}px`;
      card.classList.remove('is-above');
      card.style.transform = 'none';

      onMoved();
    };

    const onPointerUp = (ev: PointerEvent) => {
      if (isPullingSheet) {
        isPullingSheet = false;
        try { handle.releasePointerCapture(ev.pointerId); } catch {}
        card.style.transition = 'transform 280ms cubic-bezier(0.16, 1, 0.3, 1)';
        if (sheetPullDy > 80) {
          card.style.transform = 'translateY(100%)';
          setTimeout(() => {
            close();
            card.style.transform = '';
            card.style.transition = '';
          }, 280);
        } else {
          card.style.transform = '';
          setTimeout(() => {
            card.style.transition = '';
          }, 280);
        }
        return;
      }

      if (!isDragging) return;
      isDragging = false;
      card.classList.remove('is-dragging');
      try {
        handle.releasePointerCapture(ev.pointerId);
      } catch {}
    };

    handle.addEventListener('pointermove', onPointerMove, { signal });
    handle.addEventListener('pointerup', onPointerUp, { signal });
    handle.addEventListener('pointercancel', onPointerUp, { signal });
    window.addEventListener('pointermove', onPointerMove, { signal });
    window.addEventListener('pointerup', onPointerUp, { signal });
    window.addEventListener('pointercancel', onPointerUp, { signal });
  }

  // ---------- 划词卡片 ----------

  const CLOSE_ICON =
    '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>';

  const DRAG_ICON =
    '<svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true"><circle cx="4" cy="4" r="1.3"/><circle cx="12" cy="4" r="1.3"/><circle cx="4" cy="8" r="1.3"/><circle cx="12" cy="8" r="1.3"/><circle cx="4" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/></svg>';

  const MAXIMIZE_ICON =
    '<svg viewBox="0 0 24 24" width="13.5" height="13.5" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>';

  const RESTORE_ICON =
    '<svg viewBox="0 0 24 24" width="13.5" height="13.5" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14h6v6M20 10h-6V4M14 10l7-7M10 14l-7 7"/></svg>';

  const ICON_SUMMARY =
    '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h11"/><path d="M4 18h14"/></svg>';

  const ICON_ORIGIN =
    '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>';

  const ICON_CRAFT =
    '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 12 12 17 22 12"/><polyline points="2 17 12 22 22 17"/></svg>';

  const ICON_PITFALL =
    '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>';

  const ICON_BOOKMARK =
    '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>';

  const ICON_COPY =
    '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.95" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

  function buildCard(anchor: Anchor): HTMLElement {
    const card = document.createElement('div');
    card.className = 'ink-ask-card';
    card.setAttribute('role', 'dialog');
    card.setAttribute('aria-label', '墨问：AI 解释选中的内容');
    card.tabIndex = -1;
    card.innerHTML = `
      <div class="ink-ask-head" title="按住可拖动窗口 (双击最大化/还原)">
        <div class="ink-ask-head-main">
          <span class="ink-ask-drag-handle" aria-hidden="true">${DRAG_ICON}</span>
          <span class="companion-mini-seal" aria-hidden="true">问</span>
          <p class="ink-ask-heading">
            <span class="ink-ask-title">墨问</span>
            <span class="ink-ask-sep">·</span>
            <span class="ink-ask-kicker">划词解惑</span>
          </p>
        </div>
        <div class="ink-ask-head-actions">
          <button type="button" class="ink-ask-card-maximize" aria-label="全屏切换" title="放大到全屏 (双击标题栏)">${MAXIMIZE_ICON}</button>
          <button type="button" class="ink-ask-close" aria-label="关闭" title="关闭">${CLOSE_ICON}</button>
        </div>
      </div>
      <div class="ink-ask-quote-wrap">
        <p class="ink-ask-quote"></p>
      </div>
      <div class="ink-ask-thread" data-lenis-prevent></div>
      <div class="ink-ask-quick-prompts">
        <button type="button" class="ink-ask-pill" data-ask="能用通俗生动的大白话讲讲这段是什么意思吗？">${ICON_SUMMARY}<span>通俗讲讲</span></button>
        <button type="button" class="ink-ask-pill" data-ask="能就这段内容举一个生动形象的例子吗？">${ICON_ORIGIN}<span>举个例子</span></button>
        <button type="button" class="ink-ask-pill" data-ask="它在文章和工程技术实现里起什么作用？">${ICON_CRAFT}<span>有何作用</span></button>
        <button type="button" class="ink-ask-pill" data-ask="为什么要这样设计或书写，有没有易踩坑点？">${ICON_PITFALL}<span>为何这样写</span></button>
      </div>
      <form class="ink-ask-form" autocomplete="off">
        <textarea class="ink-ask-input" name="question" rows="1" maxlength="1000" placeholder="不懂就问，可在此编辑或追加问题… (Enter 发送，Shift+Enter 换行)" enterkeyhint="send"></textarea>
        <button type="submit" class="ink-ask-send" aria-label="发送">问</button>
      </form>
      <div class="ink-ask-resize-handle" aria-hidden="true" title="拖拽调整大小（双击恢复默认）"></div>`;
    card.querySelector('.ink-ask-quote')!.textContent = anchor.text;

    const resizeHandle = card.querySelector<HTMLElement>('.ink-ask-resize-handle');
    if (resizeHandle) {
      makeResizable(card, resizeHandle, {
        storageKey: 'inkask-panel-size',
        minWidth: 320,
        minHeight: 240,
        maxWidth: () => Math.min(window.innerWidth - 24, 920),
        maxHeight: () => Math.max(240, window.innerHeight - 24),
        fallback: { width: 560, height: 520 },
        onChange: () => clampCardToViewport(card),
      });
    }
    return card;
  }

  let ringKey = '';

  function clampCardToViewport(card: HTMLElement) {
    if (card.classList.contains('is-sheet')) return;
    const width = card.offsetWidth;
    const height = card.offsetHeight;
    if (!width || !height) return;

    const left = Number.parseFloat(card.style.left);
    const top = Number.parseFloat(card.style.top);
    if (!Number.isFinite(left) || !Number.isFinite(top)) return;

    const sx = window.scrollX;
    const sy = window.scrollY;
    const minLeft = sx + 16;
    const maxLeft = sx + window.innerWidth - width - 16;
    const clampedLeft = Math.min(Math.max(left, minLeft), Math.max(minLeft, maxLeft));

    const minTop = sy + 16;
    const maxTop = sy + window.innerHeight - height - 16;
    const clampedTop = Math.min(Math.max(top, minTop), Math.max(minTop, maxTop));

    card.style.left = `${Math.round(clampedLeft)}px`;
    card.style.top = `${Math.round(clampedTop)}px`;
    card.style.transform = 'none';
  }

  /**
   * 浮岛（笔记 / 墨问侧栏）打开后，把选区小窗让到它左侧，避免被抽屉压住。
   * 位置按浮岛实测左边缘计算（不写死宽度），正文推挤 / 主题切换后都还成立。
   */
  function clampCardAwayFromRails() {
    const s = session;
    if (!s) return;
    if (s.card.classList.contains('is-maximized')) return;
    if (document.documentElement.getAttribute('data-companion-mode') !== 'rail') return;

    let railLeft = window.innerWidth;
    let opened = false;
    document.querySelectorAll<HTMLElement>('.article-notes-drawer.is-open, .ink-ask-drawer.is-open').forEach((panel) => {
      const left = panel.getBoundingClientRect().left;
      if (left > 0 && left < window.innerWidth) {
        railLeft = Math.min(railLeft, left);
        opened = true;
      }
    });
    if (!opened) return;

    const maxRight = railLeft - 16;
    const rect = s.card.getBoundingClientRect();
    if (rect.right <= maxRight) return;

    const left = Math.max(16, maxRight - rect.width);
    s.card.style.left = `${Math.round(window.scrollX + left)}px`;
    s.card.style.transform = 'none';
  }

  function place(s: Session) {
    const rects = lineRects(s.range);
    if (!rects.length) return;
    const box = boxOf(rects);
    const key = [box.left + window.scrollX, box.top + window.scrollY, box.width, box.height].map(Math.round).join();
    if (key !== ringKey) {
      ringKey = key;
      drawRing(s.range, s.ring);
    }

    const { card } = s;
    const sheet = useSheet();
    card.classList.toggle('is-sheet', sheet);
    if (sheet) {
      card.style.left = card.style.top = card.style.width = card.style.transform = '';
      card.style.height = '';
      return;
    }

    // 用户手动拖拽过后，保持用户自选的位置，但确保不超出视口
    if (s.userMoved) {
      clampCardToViewport(card);
      return;
    }

    const last = rects[rects.length - 1];
    const savedSize = loadPanelSize('inkask-panel-size');
    const width = Math.min(savedSize?.width ?? 560, window.innerWidth - 32);
    card.style.width = `${width}px`;
    if (savedSize?.height) {
      card.style.height = `${Math.min(savedSize.height, window.innerHeight - 32)}px`;
    }

    // 获取当前卡片实际高度（若尚未渲染则参考预估高度）
    const cardHeight = card.offsetHeight || (savedSize?.height ?? 500);
    const cardWidth = card.offsetWidth || width;

    // 计算下方与上方可用空间（相对于视口）
    const spaceBelow = window.innerHeight - last.bottom;
    const spaceAbove = box.top;

    let targetViewportTop: number;
    const fitsBelow = spaceBelow >= cardHeight + 20;
    const fitsAbove = spaceAbove >= cardHeight + 20;

    if (fitsBelow) {
      targetViewportTop = last.bottom + 12;
      card.classList.remove('is-above');
    } else if (fitsAbove) {
      targetViewportTop = box.top - cardHeight - 12;
      card.classList.add('is-above');
    } else if (spaceBelow >= spaceAbove) {
      targetViewportTop = last.bottom + 12;
      card.classList.remove('is-above');
    } else {
      targetViewportTop = box.top - cardHeight - 12;
      card.classList.add('is-above');
    }

    // 严密视口边界限制（保留至少 16px 边距，确保标题栏和拖拽手柄绝对不被顶栏遮挡）
    const minViewportTop = 16;
    const maxViewportTop = Math.max(minViewportTop, window.innerHeight - cardHeight - 16);
    const clampedViewportTop = Math.min(Math.max(targetViewportTop, minViewportTop), maxViewportTop);

    // 水平对齐与视口限制
    const targetViewportLeft = box.left - 12;
    const minViewportLeft = 16;
    const maxViewportLeft = Math.max(minViewportLeft, window.innerWidth - cardWidth - 16);
    const clampedViewportLeft = Math.min(Math.max(targetViewportLeft, minViewportLeft), maxViewportLeft);

    card.style.left = `${Math.round(window.scrollX + clampedViewportLeft)}px`;
    card.style.top = `${Math.round(window.scrollY + clampedViewportTop)}px`;
    card.style.transform = 'none';
    // 浮岛打开时保持让位：正文推挤（push）会重新触发 place，不能把小窗又推回抽屉底下
    clampCardAwayFromRails();
  }

  function inkCircle(s: Session) {
    const rect = s.card.getBoundingClientRect();
    const x = s.origin.x - window.scrollX - rect.left;
    const y = s.origin.y - window.scrollY - rect.top;
    const height = Math.max(rect.height, window.innerHeight * 0.72);
    const r = Math.hypot(Math.max(x, rect.width - x), Math.max(y, height - y)) + 24;
    return { x, y, r };
  }

  function afterTransition(el: HTMLElement, ms: number, fn: () => void) {
    let fired = false;
    const run = () => {
      if (fired) return;
      fired = true;
      fn();
    };
    el.addEventListener('transitionend', (event) => event.target === el && run(), { once: true });
    window.setTimeout(run, ms);
  }

  function reveal(s: Session) {
    if (reduceMotion()) return;
    const { card } = s;
    const { x, y, r } = inkCircle(s);
    card.style.clipPath = `circle(0px at ${x}px ${y}px)`;
    void card.offsetWidth;
    card.classList.add('is-opening');
    card.style.clipPath = `circle(${r}px at ${x}px ${y}px)`;
    afterTransition(card, 900, () => {
      card.classList.remove('is-opening');
      card.style.clipPath = '';
    });
  }

  function close(instant = false) {
    const s = session;
    if (!s) return;
    document.body.classList.remove('ink-ask-card-maximized');
    session = null;
    ringKey = '';
    s.controller?.abort();
    s.stop.abort();
    if (instant || reduceMotion()) {
      s.card.remove();
      s.ring.remove();
      return;
    }
    s.ring.classList.add('is-drying');
    window.setTimeout(() => s.ring.remove(), 600);
    const { x, y, r } = inkCircle(s);
    s.card.style.clipPath = `circle(${r}px at ${x}px ${y}px)`;
    void s.card.offsetWidth;
    s.card.classList.add('is-closing');
    s.card.style.clipPath = `circle(0px at ${x}px ${y}px)`;
    afterTransition(s.card, 600, () => s.card.remove());
  }

  // ---------- 一问一答 ----------

  const nearEnd = (el: HTMLElement) => el.scrollHeight - el.scrollTop - el.clientHeight < 48;

  function addTurn(thread: HTMLElement, question: string) {
    const turn = document.createElement('section');
    turn.className = 'ink-ask-turn';
    if (question) {
      const q = document.createElement('div');
      q.className = 'ink-ask-q';
      const isFirst = thread.children.length === 0;
      q.innerHTML = `<span class="ink-ask-q-tag">${isFirst ? '提问' : '追问'}</span><span class="ink-ask-q-text">${escapeHtml(question)}</span>`;
      turn.append(q);
    }
    const byline = document.createElement('div');
    byline.className = 'ink-ask-byline';
    byline.innerHTML = '<span class="companion-mini-seal" aria-hidden="true">墨</span><span class="ink-ask-byline-name">墨问</span>';
    const answer = document.createElement('div');
    answer.className = 'ink-ask-answer';
    const status = document.createElement('p');
    status.className = 'ink-ask-status';
    status.setAttribute('role', 'status');
    status.innerHTML = '<span class="ink-ask-status-text">展卷推敲中</span><span class="ink-ask-dots" aria-hidden="true"><i></i><i></i><i></i></span>';
    turn.append(byline, answer, status);
    thread.append(turn);
    thread.scrollTop = thread.scrollHeight;
    return { turn, answer, status };
  }

  function note(turn: HTMLElement, text: string) {
    const p = document.createElement('p');
    p.className = 'ink-ask-note';
    p.textContent = text;
    turn.append(p);
  }

  /** 读取落在某个元素内部的选区 Markdown（用于「只存入选中的部分」） */
  function selectedTextInside(el: HTMLElement | null): string {
    if (!el) return '';
    const selection = window.getSelection();
    if (!selection || selection.isCollapsed || selection.rangeCount === 0) return '';
    const range = selection.getRangeAt(0);
    const node = range.commonAncestorContainer;
    const host = node.nodeType === Node.TEXT_NODE ? node.parentElement : (node as Element);
    if (!host || !el.contains(host)) return '';
    return domRangeToMarkdown(range).trim() || selection.toString().trim();
  }

  // 点击按钮的 pointerdown 会先折叠选区，这里在折叠前把选中的片段记下来
  const pendingSelections = new WeakMap<HTMLElement, string>();

  function refreshSaveNoteLabels() {
    document.querySelectorAll<HTMLButtonElement>('.ink-ask-save-note').forEach((btn) => {
      if (btn.classList.contains('is-saved')) return;
      const turn = btn.closest('.ink-ask-turn');
      const answerEl = turn?.querySelector<HTMLElement>('.ink-ask-answer') || null;
      const partial = Boolean(selectedTextInside(answerEl));
      const labelEl = btn.querySelector<HTMLElement>('.ink-ask-save-label');
      if (labelEl) labelEl.textContent = partial ? '存入选中' : '存入笔记';
      else btn.textContent = partial ? '存入选中' : '存入笔记';
      btn.classList.toggle('is-partial', partial);
    });
  }

  /** 回答完成后在下方追加书斋操作栏（「存入笔记」+「复制」） */
  function addSaveNoteButton(turn: HTMLElement, getText: () => string, question: string, answerEl: HTMLElement) {
    if (turn.querySelector('.ink-ask-save-note')) return;
    const bar = document.createElement('div');
    bar.className = 'ink-ask-turn-actions';

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'ink-ask-save-note';
    btn.innerHTML = `${ICON_BOOKMARK}<span class="ink-ask-save-label">存入笔记</span>`;
    btn.title = '默认保存整条回答；先在回答里选中一段文字，则只保存选中的部分';
    btn.addEventListener('pointerdown', () => {
      const current = selectedTextInside(answerEl);
      if (current) pendingSelections.set(answerEl, current);
    }, true);
    btn.addEventListener('click', () => {
      const selected = pendingSelections.get(answerEl) || selectedTextInside(answerEl);
      pendingSelections.delete(answerEl);
      const text = (selected || getText()).trim();
      if (!text) return;
      const detail = { kind: 'ai' as const, text, markdown: text, question, headingText: 'AI 问答摘录' };
      const api = (window as any).__articleNotes;
      if (api && typeof api.addNote === 'function') api.addNote(detail);
      else window.dispatchEvent(new CustomEvent('article-note:add', { detail }));

      const labelEl = btn.querySelector<HTMLElement>('.ink-ask-save-label');
      if (labelEl) labelEl.textContent = selected ? '已存入选中' : '已存入笔记';
      btn.classList.add('is-saved');
      window.setTimeout(() => {
        btn.classList.remove('is-saved');
        refreshSaveNoteLabels();
      }, 1800);
    });

    const copyBtn = document.createElement('button');
    copyBtn.type = 'button';
    copyBtn.className = 'ink-ask-copy-answer';
    copyBtn.innerHTML = `${ICON_COPY}<span class="ink-ask-copy-label">复制</span>`;
    copyBtn.title = '复制本条回答 Markdown';
    copyBtn.addEventListener('click', async () => {
      const raw = getText().trim();
      if (!raw) return;
      try {
        await navigator.clipboard.writeText(raw);
        const lbl = copyBtn.querySelector<HTMLElement>('.ink-ask-copy-label');
        if (lbl) lbl.textContent = '已复制';
        copyBtn.classList.add('is-copied');
        window.setTimeout(() => {
          copyBtn.classList.remove('is-copied');
          if (lbl) lbl.textContent = '复制';
        }, 1600);
      } catch {}
    });

    bar.append(btn, copyBtn);
    turn.append(bar);
    refreshSaveNoteLabels();
  }

  let saveLabelTimer = 0;
  document.addEventListener('selectionchange', () => {
    window.clearTimeout(saveLabelTimer);
    saveLabelTimer = window.setTimeout(refreshSaveNoteLabels, 120);
  });
  document.addEventListener('pointerup', () => window.setTimeout(refreshSaveNoteLabels, 40), true);

  async function ask(s: Session, question = '') {
    if (s.controller) return;
    const controller = new AbortController();
    s.controller = controller;
    s.form.classList.add('is-busy');
    const { turn, answer, status } = addTurn(s.thread, question);
    let text = '';
    let frame = 0;
    const paint = () => {
      frame = 0;
      const stick = nearEnd(s.thread);
      answer.innerHTML = renderMarkdown(text);
      if (turn.classList.contains('is-streaming')) placeCaret(answer);
      if (stick) s.thread.scrollTop = s.thread.scrollHeight;
    };

    try {
      if ([...s.anchor.text].length > MAX_SELECTION) throw new Error(`选中的内容太长了（最多 ${MAX_SELECTION} 字），缩短一点再问`);
      let response: Response;
      if (isMockMode) {
        response = mockStreamResponse(false, question, s.anchor.text);
      } else {
        response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            path: location.pathname,
            selection: s.anchor.text,
            prefix: s.anchor.prefix,
            suffix: s.anchor.suffix,
            question,
          }),
          signal: controller.signal,
        });
      }
      if (!response.ok || !response.body) {
        const data = await response.json().catch(() => null);
        throw new Error(data?.error || `请求失败（${response.status}）`);
      }

      const reader = response.body.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let finish: { cached?: boolean; truncated?: boolean } | null = null;
      while (!finish) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        for (let cut; (cut = buffer.indexOf('\n\n')) !== -1; ) {
          const line = buffer.slice(0, cut).split('\n').find((l) => l.startsWith('data:'));
          buffer = buffer.slice(cut + 2);
          if (!line) continue;
          const message = JSON.parse(line.slice(5));
          if (message.error) throw new Error(message.error);
          if (message.t && !text) status.querySelector('.ink-ask-status-text')!.textContent = '深入思考中';
          if (message.d) {
            if (!text) {
              status.hidden = true;
              turn.classList.add('is-streaming');
            }
            text += message.d;
            frame ||= requestAnimationFrame(paint);
          }
          if (message.done) finish = message;
        }
      }
      if (!text.trim()) throw new Error('没有收到回答，稍后再试');
      if (frame) cancelAnimationFrame(frame);
      turn.classList.remove('is-streaming');
      turn.classList.toggle('is-cached', Boolean(finish?.cached));
      paint();
      addSaveNoteButton(turn, () => text, question, answer);
      if (finish?.truncated) note(turn, '回答太长，后面被截断了');
      else if (!finish) note(turn, '连接断了，回答可能不完整');
    } catch (error) {
      if (controller.signal.aborted) return;
      if (frame) cancelAnimationFrame(frame);
      turn.classList.remove('is-streaming');
      if (text) paint();
      status.hidden = false;
      status.classList.add('is-error');
      status.textContent = error instanceof TypeError ? '网络好像断了，稍后再试' : (error as Error).message || '出错了，稍后再试';
      const retry = document.createElement('button');
      retry.type = 'button';
      retry.className = 'ink-ask-retry';
      retry.textContent = '再试一次';
      retry.addEventListener('click', () => {
        turn.remove();
        ask(s, question);
      });
      status.append(retry);
    } finally {
      if (s.controller === controller) {
        s.controller = null;
        s.form.classList.remove('is-busy');
      }
    }
  }

  function open(range: Range, root: HTMLElement) {
    close(true);
    const anchor = anchorOf(range, root);
    const sealRect = seal?.classList.contains('is-shown') ? seal.getBoundingClientRect() : null;
    hideSeal();
    const ring = anchor.text ? drawRing(range) : null;
    if (!ring) return;
    const last = lineRects(range).at(-1)!;
    const origin = sealRect
      ? { x: sealRect.left + sealRect.width / 2, y: sealRect.top + sealRect.height / 2 }
      : { x: last.right, y: last.bottom };
    window.getSelection()?.removeAllRanges();

    const card = buildCard(anchor);
    const s: Session = {
      card,
      ring,
      range: range.cloneRange(),
      anchor,
      origin: { x: origin.x + window.scrollX, y: origin.y + window.scrollY },
      controller: null,
      stop: new AbortController(),
      thread: card.querySelector<HTMLElement>('.ink-ask-thread')!,
      form: card.querySelector<HTMLFormElement>('.ink-ask-form')!,
      input: card.querySelector<HTMLInputElement>('.ink-ask-input')!,
      userMoved: false,
    };
    session = s;
    document.body.append(ring, card);

    // 绑定拖拽
    const head = card.querySelector<HTMLElement>('.ink-ask-head')!;
    enableDrag(card, head, () => {
      s.userMoved = true;
    }, s.stop.signal);

    const textarea = s.input as HTMLTextAreaElement;
    const autoResize = () => {
      if (!textarea) return;
      textarea.style.height = 'auto';
      const nextH = Math.min(Math.max(textarea.scrollHeight, 38), 140);
      textarea.style.height = `${nextH}px`;
      textarea.style.overflowY = textarea.scrollHeight > 140 ? 'auto' : 'hidden';
    };

    textarea.addEventListener('input', autoResize);
    textarea.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        s.form.requestSubmit();
      }
    });

    // 快捷预设词
    card.querySelectorAll<HTMLButtonElement>('.ink-ask-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const prompt = pill.dataset.ask || pill.textContent?.trim() || '';
        if (!prompt || s.controller) return;
        const currentInput = s.input.value.trim();
        const fullQ = currentInput
          ? (currentInput.includes(prompt) ? currentInput : `${currentInput}\n\n${prompt}`)
          : prompt;
        s.input.value = '';
        autoResize();
        ask(s, fullQ);
      });
    });

    const closeBtn = card.querySelector('.ink-ask-close')!;
    closeBtn.addEventListener('pointerdown', (e) => e.stopPropagation());
    closeBtn.addEventListener('click', () => close());

    const cardMaxBtn = card.querySelector<HTMLButtonElement>('.ink-ask-card-maximize')!;
    const toggleCardMaximize = () => {
      const first = card.getBoundingClientRect();
      const isMax = card.classList.toggle('is-maximized');
      document.body.classList.toggle('ink-ask-card-maximized', isMax);
      cardMaxBtn.innerHTML = isMax ? RESTORE_ICON : MAXIMIZE_ICON;
      cardMaxBtn.title = isMax ? '还原窗口 (双击标题栏 / Esc)' : '放大到全屏 (双击标题栏)';
      if (!isMax) {
        clampCardToViewport(card);
      }

      const last = card.getBoundingClientRect();
      const dx = first.left - last.left;
      const dy = first.top - last.top;
      const sx = first.width / (last.width || 1);
      const sy = first.height / (last.height || 1);

      card.style.transformOrigin = 'top left';
      card.style.transition = 'none';
      card.style.transform = `translate3d(${dx}px, ${dy}px, 0) scale(${sx}, ${sy})`;
      void card.offsetHeight; // Force layout flush so the initial inverted transform is painted!

      card.style.transition = 'transform 380ms cubic-bezier(0.175, 0.885, 0.32, 1.12), border-radius 380ms ease';
      card.style.transform = 'translate3d(0, 0, 0) scale(1, 1)';

      const onEnd = (e: TransitionEvent) => {
        if (e.target !== card || e.propertyName !== 'transform') return;
        card.style.transition = '';
        card.style.transform = '';
        card.style.transformOrigin = '';
        card.removeEventListener('transitionend', onEnd);
      };
      card.addEventListener('transitionend', onEnd);
      setTimeout(() => {
        card.style.transition = '';
        card.style.transform = '';
        card.style.transformOrigin = '';
        card.removeEventListener('transitionend', onEnd);
      }, 450);
    };
    cardMaxBtn?.addEventListener('pointerdown', (e) => e.stopPropagation());
    cardMaxBtn?.addEventListener('click', toggleCardMaximize);
    head.addEventListener('dblclick', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      toggleCardMaximize();
    });

    s.form.addEventListener('submit', (event) => {
      event.preventDefault();
      const question = s.input.value.trim();
      if (!question || s.controller) return;
      s.input.value = '';
      autoResize();
      ask(s, question);
    });

    const ro = new ResizeObserver(() => requestAnimationFrame(() => session === s && place(s)));
    ro.observe(root);
    s.stop.signal.addEventListener('abort', () => ro.disconnect());

    // 原封不动将选中文本填入聊天框，先执行 autoResize，让卡片高度达到实际预期尺寸
    const textToPaste = anchor.text.trim();
    if (s.input) {
      s.input.value = textToPaste;
      autoResize();
    }

    // 真实尺寸就绪后再计算精确定位与视口避让
    place(s);
    // 若此刻右侧已有笔记 / 墨问浮岛，先把小窗让到浮岛左侧，避免一出现就被压住
    clampCardAwayFromRails();
    void ring.getBoundingClientRect();
    ring.classList.add('is-drawn');
    reveal(s);

    if (s.input) {
      window.setTimeout(() => {
        if (session === s) {
          s.input.focus({ preventScroll: true });
          s.input.setSelectionRange(s.input.value.length, s.input.value.length);
        }
      }, 50);
    }
  }

  // ---------- 右上角 AI 伴读侧边栏 ----------

  let syncAskRegistration: (() => void) | null = null;

  function setWelcomeEpigraph(epigraphEl: HTMLElement | null | undefined) {
    if (!epigraphEl) return;
    const title = postTitle();
    epigraphEl.innerHTML = '';
    if (!title) return;
    const prefix = document.createElement('span');
    prefix.className = 'epigraph-affix';
    prefix.textContent = '正在伴读《';
