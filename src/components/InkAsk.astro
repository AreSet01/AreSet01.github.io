      });

      const closeBtn = sidebarDrawer.querySelector('.ink-ask-drawer-close')!;
      closeBtn.addEventListener('click', () => closeSidebar());

      // 移动端底部手卷抽屉下滑手势（rAF 节流 + 速度感知，零卡顿跟手）
      const drawerDragBar = sidebarDrawer.querySelector<HTMLElement>('.drawer-drag-handle');
      if (drawerDragBar) {
        let pulling = false;
        let startY = 0;
        let dy = 0;
        let lastY = 0;
        let lastT = 0;
        let vy = 0;
        let rafId = 0;
        const applyPull = () => {
          rafId = 0;
          if (!pulling || !sidebarDrawer) return;
          sidebarDrawer.style.transform = dy > 0 ? `translate3d(0, ${dy}px, 0)` : '';
        };
        drawerDragBar.addEventListener('pointerdown', (ev: PointerEvent) => {
          if (window.innerWidth >= 1024 || sidebarDrawer?.classList.contains('is-maximized')) return;
          pulling = true;
          startY = ev.clientY;
          lastY = ev.clientY;
          lastT = performance.now();
          dy = 0;
          vy = 0;
          if (sidebarDrawer) sidebarDrawer.style.transition = 'none';
          try { drawerDragBar.setPointerCapture(ev.pointerId); } catch {}
        });
        drawerDragBar.addEventListener('pointermove', (ev: PointerEvent) => {
          if (!pulling) return;
          const now = performance.now();
          const dt = Math.max(1, now - lastT);
          vy = (ev.clientY - lastY) / dt;
          lastY = ev.clientY;
          lastT = now;
          dy = Math.max(0, ev.clientY - startY);
          if (!rafId) rafId = window.requestAnimationFrame(applyPull);
        });
        const finishPull = (ev: PointerEvent) => {
          if (!pulling) return;
          pulling = false;
          if (rafId) {
            window.cancelAnimationFrame(rafId);
            rafId = 0;
          }
          try { drawerDragBar.releasePointerCapture(ev.pointerId); } catch {}
          if (!sidebarDrawer) return;
          sidebarDrawer.style.transition = '';
          sidebarDrawer.style.transform = '';
          if (dy > 96 || (dy > 36 && vy > 0.55)) {
            closeSidebar();
          }
        };
        drawerDragBar.addEventListener('pointerup', finishPull);
        drawerDragBar.addEventListener('pointercancel', finishPull);
      }

      const drawerMaxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize')!;
      const drawerHead = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-head')!;
      const applyDrawerMaxState = (isMax: boolean) => {
        if (!sidebarDrawer) return;
        sidebarDrawer.classList.toggle('is-maximized', isMax);
        document.body.classList.toggle('ink-ask-drawer-maximized', isMax);
        if (drawerMaxBtn) {
          drawerMaxBtn.innerHTML = isMax ? RESTORE_ICON : MAXIMIZE_ICON;
          drawerMaxBtn.dataset.tip = isMax ? '收为浮岛' : '全屏展开';
          drawerMaxBtn.setAttribute('aria-label', isMax ? '收为浮岛' : '全屏展开');
        }
      };

      const toggleDrawerMaximize = () => {
        if (!sidebarDrawer) return;
        lockScrollAnchor(readArticleMotion().panelMs + 100);

        const first = sidebarDrawer.getBoundingClientRect();
        const isMax = !sidebarDrawer.classList.contains('is-maximized');
        applyDrawerMaxState(isMax);

        const last = sidebarDrawer.getBoundingClientRect();
        const dx = Math.round((first.left + first.width / 2 - (last.left + last.width / 2)) * 0.52);

        sidebarDrawer.style.transition = 'none';
        sidebarDrawer.style.transform = `translate3d(${dx}px, 0, 0) scale(0.96)`;
        void sidebarDrawer.offsetHeight;

        sidebarDrawer.style.transition = 'transform var(--article-duration-panel) var(--article-ease-layout)';
        sidebarDrawer.style.transform = 'translate3d(0, 0, 0) scale(1)';

        const onEnd = (e: TransitionEvent) => {
          if (e.target !== sidebarDrawer || e.propertyName !== 'transform') return;
          sidebarDrawer.style.transition = '';
          sidebarDrawer.style.transform = '';
          sidebarDrawer.removeEventListener('transitionend', onEnd);
        };
        sidebarDrawer.addEventListener('transitionend', onEnd);
        setTimeout(() => {
          if (!sidebarDrawer) return;
          sidebarDrawer.style.transition = '';
          sidebarDrawer.style.transform = '';
          sidebarDrawer.removeEventListener('transitionend', onEnd);
        }, readArticleMotion().panelMs + 80);
      };
      drawerMaxBtn?.addEventListener('click', toggleDrawerMaximize);
      drawerHead?.addEventListener('dblclick', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        toggleDrawerMaximize();
      });

      // 供 CompanionLayout 以「目标状态」驱动全屏；silent 模式下由协调器统一接管过渡动画
      const setDrawerMaximized = (want: boolean, opts?: { silent?: boolean }) => {
        if (!sidebarDrawer) return;
        if (sidebarDrawer.classList.contains('is-maximized') === want) return;
        if (opts?.silent) {
          applyDrawerMaxState(want);
          return;
        }
        toggleDrawerMaximize();
      };

      // 交给同屏协调器接管摆放（并排 / 全屏 / 单浮岛互切）；协调器脚本可能后到，做一次短重试
      const registerAskPanel = (retries = 24) => {
        // 换页后旧抽屉会被移除，别把脱离文档的旧节点注册进新协调器
        if (!sidebarDrawer?.isConnected) return;
        const companion = (window as any).__companion;
        if (companion?.register) {
          companion.register('ask', sidebarDrawer, {
            open: openSidebar,
            close: closeSidebar,
            isOpen: () => Boolean(sidebarDrawer?.classList.contains('is-open')),
            isFull: () => Boolean(sidebarDrawer?.classList.contains('is-maximized')),
            setFull: setDrawerMaximized,
          });
          return;
        }
        if (retries <= 0) return;
        window.setTimeout(() => registerAskPanel(retries - 1), 50);
      };
      syncAskRegistration = () => registerAskPanel(4);
      registerAskPanel();

      const thread = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-thread')!;
      const drawerBody = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-body')!;
      const welcome = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-welcome')!;
      const form = sidebarDrawer.querySelector<HTMLFormElement>('.ink-ask-drawer-form')!;
      const textarea = sidebarDrawer.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input')!;

      const newChatBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-new')!;
      const historyBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-history-btn')!;
      const historyPanel = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-history-panel')!;
      const historyList = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-history-list')!;
      const historyCount = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-history-count')!;
      const historyClearBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-history-clear')!;

      function renderHistoryList() {
        const store = loadArticleAskStore(location.pathname);
        historyList.innerHTML = '';
        const validSessions = store.sessions.filter((s) => s.turns.length > 0 || s.id === store.activeSessionId);
        if (historyCount) historyCount.textContent = String(validSessions.length);

        if (validSessions.length === 0 || (validSessions.length === 1 && validSessions[0].turns.length === 0)) {
          const empty = document.createElement('div');
          empty.className = 'ink-ask-history-empty';
          empty.textContent = '暂无历史对话记录';
          historyList.append(empty);
          return;
        }

        for (const s of validSessions) {
          const item = document.createElement('div');
          item.className = 'ink-ask-history-item' + (s.id === store.activeSessionId ? ' is-active' : '');
          item.setAttribute('role', 'listitem');

          const main = document.createElement('button');
          main.type = 'button';
          main.className = 'ink-ask-history-item-main';
          main.innerHTML = `
            <div class="ink-ask-history-item-title">${escapeHtml(s.title || '伴读对话')}</div>
            <div class="ink-ask-history-item-meta">
              <span class="ink-ask-history-item-time">${formatRelativeTime(s.updatedAt)}</span>
              <span class="ink-ask-history-item-turns">${s.turns.length} 轮对话</span>
              ${s.id === store.activeSessionId ? '<span class="ink-ask-history-item-badge">当前</span>' : ''}
            </div>
          `;
          main.addEventListener('click', () => {
            if (sidebarController) {
              sidebarController.abort();
              sidebarController = null;
              form.classList.remove('is-busy');
            }
            switchActiveSession(location.pathname, s.id);
            loadAndRenderActiveSession(thread, welcome, (tTurn, q) => recallDrawerTurn(tTurn, q));
            toggleHistoryPanel(false);
          });

          const delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'ink-ask-history-item-del';
          delBtn.setAttribute('aria-label', '删除此会话');
          delBtn.title = '删除此会话';
          delBtn.innerHTML = CLOSE_ICON;
          delBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            storeDeleteSession(location.pathname, s.id);
            loadAndRenderActiveSession(thread, welcome, (tTurn, q) => recallDrawerTurn(tTurn, q));
            renderHistoryList();
          });

          item.append(main, delBtn);
          historyList.append(item);
        }
      }

      function toggleHistoryPanel(show?: boolean) {
        const willShow = show !== undefined ? show : historyPanel.hidden;
        historyPanel.hidden = !willShow;
        historyPanel.setAttribute('aria-hidden', String(!willShow));
        historyBtn?.classList.toggle('is-active', willShow);
        if (willShow) {
          renderHistoryList();
        }
      }

      historyBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleHistoryPanel();
      });

      historyClearBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (confirm('确认清空当前文章的所有墨问历史对话记录吗？此操作无法撤销。')) {
          clearAllSessions(location.pathname);
          loadAndRenderActiveSession(thread, welcome, (tTurn, q) => recallDrawerTurn(tTurn, q));
          renderHistoryList();
          toggleHistoryPanel(false);
        }
      });

      let isResetting = false;
      const resetConversation = () => {
        if (isResetting) return;
        if (sidebarController) {
          sidebarController.abort();
          sidebarController = null;
        }
        form.classList.remove('is-busy');
        textarea.value = '';
        textarea.style.height = '24px';
        textarea.style.overflowY = 'hidden';

        toggleHistoryPanel(false);

        if (thread.children.length === 0) {
          sidebarDrawer?.classList.remove('has-turns');
          welcome.style.display = '';
          drawerBody.scrollTop = 0;
          textarea.focus({ preventScroll: true });
          return;
        }

        archiveAndNewSession(location.pathname);

        isResetting = true;
        thread.classList.add('is-clearing');
        setTimeout(() => {
          thread.innerHTML = '';
          thread.classList.remove('is-clearing');
          sidebarDrawer?.classList.remove('has-turns');
          welcome.style.display = '';
          welcome.classList.remove('is-entering');
          void welcome.offsetWidth;
          welcome.classList.add('is-entering');
          drawerBody.scrollTop = 0;
          isResetting = false;
          textarea.focus({ preventScroll: true });
        }, 220);
      };
      newChatBtn?.addEventListener('click', resetConversation);

      // 欢迎区典雅题签卡片与底部追问胶囊点击
      sidebarDrawer.querySelectorAll<HTMLButtonElement>('.ink-ask-mini-chip, .ink-ask-prompt-card').forEach((card) => {
        card.addEventListener('click', () => {
          const q = card.dataset.ask || card.textContent?.trim() || '';
          if (!q) return;
          if (card.classList.contains('ink-ask-prompt-card') && !reduceMotion()) {
            card.classList.add('is-launching');
            window.setTimeout(() => {
              card.classList.remove('is-launching');
              askDrawer(q);
            }, 130);
          } else {
            askDrawer(q);
          }
        });
      });

      // 自动撑高 textarea 并温和提示剩余字数
      const drawerCharCount = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-char-count');
      function adjustTextareaHeight() {
        textarea.style.height = 'auto';
        const scrollH = textarea.scrollHeight;
        if (scrollH > 120) {
          textarea.style.height = '120px';
          textarea.style.overflowY = 'auto';
        } else {
          textarea.style.height = `${Math.max(24, scrollH)}px`;
          textarea.style.overflowY = 'hidden';
        }
        updateCharCount(textarea, drawerCharCount);
      }

      textarea.addEventListener('input', adjustTextareaHeight);

      let lastCompositionEndTime = 0;
      textarea.addEventListener('compositionend', () => {
        lastCompositionEndTime = Date.now();
      });

      // 输入框快捷按键（增加输入法合成结束时间戳防误触，支持 Enter 发送与 Shift+Enter 换行）
      textarea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
          if (Date.now() - lastCompositionEndTime < 60) return;
          e.preventDefault();
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });

      let currentDrawerTurn: HTMLElement | null = null;
      let currentDrawerQuestion = '';

      function recallDrawerTurn(turnToRecall?: HTMLElement | null, qText?: string) {
        if (sidebarController) {
          sidebarController.abort();
          sidebarController = null;
          form.classList.remove('is-busy');
        }
        const targetTurn = turnToRecall || currentDrawerTurn || (thread.lastElementChild as HTMLElement | null);
        if (!targetTurn) return;
        const textToRestore = qText || targetTurn.dataset.question || targetTurn.querySelector('.ink-ask-q-text')?.textContent || '';

        if (targetTurn.dataset.turnId) {
          storeRemoveTurn(location.pathname, targetTurn.dataset.turnId);
        }

        targetTurn.classList.add('is-recalling');
        window.setTimeout(() => {
          targetTurn.remove();
          if (thread.children.length === 0) {
            sidebarDrawer?.classList.remove('has-turns');
            welcome.style.display = '';
            welcome.classList.remove('is-entering');
            void welcome.offsetWidth;
            welcome.classList.add('is-entering');
          }
        }, 200);

        if (textToRestore) {
          textarea.value = textToRestore;
          adjustTextareaHeight();
          textarea.focus({ preventScroll: true });
          textarea.setSelectionRange(textarea.value.length, textarea.value.length);
        }
        if (currentDrawerTurn === targetTurn) {
          currentDrawerTurn = null;
          currentDrawerQuestion = '';
        }
      }

      recallActiveDrawerTurn = () => recallDrawerTurn();

      const drawerRecallBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-recall');
      drawerRecallBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        recallDrawerTurn();
      });

      let activeFollowUpQuote = '';
      let followUpChipEl: HTMLElement | null = null;

      const clearFollowUpChip = () => {
        activeFollowUpQuote = '';
        if (followUpChipEl) {
          followUpChipEl.remove();
          followUpChipEl = null;
        }
      };

      const mountFollowUpChip = (payload: { text: string; question?: string; kind?: string; heading?: string }) => {
        const snippet = (payload.text || '').trim();
        if (!snippet) return;
        activeFollowUpQuote = snippet;
        const formInner = sidebarDrawer?.querySelector<HTMLElement>('.ink-ask-drawer-form-inner');
        const inputWrap = sidebarDrawer?.querySelector<HTMLElement>('.ink-ask-drawer-input-wrap');
        if (!formInner || !inputWrap) return;
        if (!followUpChipEl || !formInner.contains(followUpChipEl)) {
          followUpChipEl = document.createElement('div');
          followUpChipEl.className = 'ink-ask-followup-chip';
          formInner.insertBefore(followUpChipEl, inputWrap);
        }
        const badgeLabel = payload.kind === 'ai' ? '追问摘录' : '引文追问';
        const previewText = snippet.replace(/\s+/g, ' ').slice(0, 72) + (snippet.length > 72 ? '…' : '');
        followUpChipEl.innerHTML = `
          <span class="ink-ask-followup-badge">${badgeLabel}</span>
          <span class="ink-ask-followup-text">${escapeHtml(previewText)}</span>
          <button type="button" class="ink-ask-followup-close" aria-label="移除引用上下文" title="移除引用">×</button>
        `;
        followUpChipEl.querySelector('.ink-ask-followup-close')?.addEventListener('click', () => {
          clearFollowUpChip();
          textarea.focus({ preventScroll: true });
        });
        textarea.placeholder = '针对上方引用继续追问…';
        textarea.focus({ preventScroll: true });
      };
      (sidebarDrawer as any).__mountFollowUpChip = mountFollowUpChip;

      // 并排模式下支持从右卷「笔记」拖入卡片作为追问上下文
      sidebarDrawer.addEventListener('dragover', (e: DragEvent) => {
        if (document.documentElement.getAttribute('data-companion-mode') !== 'split') return;
        if (!e.dataTransfer?.types.includes('application/x-companion-note')) return;
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
        sidebarDrawer?.classList.add('is-drop-target');
      });
      sidebarDrawer.addEventListener('dragleave', (e: DragEvent) => {
        const related = e.relatedTarget as Node | null;
        if (related && sidebarDrawer?.contains(related)) return;
        sidebarDrawer?.classList.remove('is-drop-target');
      });
      sidebarDrawer.addEventListener('drop', (e: DragEvent) => {
        sidebarDrawer?.classList.remove('is-drop-target');
        if (document.documentElement.getAttribute('data-companion-mode') !== 'split') return;
        const raw = e.dataTransfer?.getData('application/x-companion-note');
        if (!raw) return;
        e.preventDefault();
        try {
          const parsed = JSON.parse(raw);
          if (parsed?.text) {
            mountFollowUpChip(parsed);
          }
        } catch {}
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const rawQ = textarea.value.trim();
        if (!rawQ) return;
        const fullQ = activeFollowUpQuote
          ? `结合这段内容：「${activeFollowUpQuote.slice(0, 360)}」\n\n${rawQ}`
          : rawQ;
        clearFollowUpChip();
        textarea.placeholder = '向墨问请教本文脉络、术语或延伸思考…';
        textarea.value = '';
        textarea.style.height = '24px';
        textarea.style.overflowY = 'hidden';
        askDrawer(fullQ);
      });

      async function askDrawer(question: string) {
        if (sidebarController) return;
        welcome.style.display = 'none'; // 提问后收起欢迎引导
        sidebarDrawer?.classList.add('has-turns');
        const controller = new AbortController();
        sidebarController = controller;
        form.classList.add('is-busy');

        const recentHistory = getRecentHistoryMessages(location.pathname, 3);
        const storedTurn = storeAppendTurn(location.pathname, { question });

        const { turn, answer, status } = addTurn(thread, question, () => {
          recallDrawerTurn(turn, question);
        });
        turn.dataset.turnId = storedTurn.id;
        currentDrawerTurn = turn;
        currentDrawerQuestion = question;
        drawerBody.scrollTop = drawerBody.scrollHeight;
        let text = '';
        let displayed = 0;
        let pumpFrame = 0;
        let streamDone = false;
        let resolveReveal: (() => void) | null = null;
        const revealComplete = new Promise<void>((resolve) => { resolveReveal = resolve; });

        const renderAnswer = () => {
          answer.innerHTML = renderMarkdown(text.slice(0, displayed));
          if (turn.classList.contains('is-streaming')) placeCaret(answer);
          if (nearEnd(drawerBody)) drawerBody.scrollTop = drawerBody.scrollHeight;
        };

        const pump = () => {
          pumpFrame = 0;
          if (controller.signal.aborted) return;
          if (displayed < text.length) {
            const remaining = text.length - displayed;
            displayed = Math.min(text.length, displayed + Math.max(2, Math.ceil(remaining * 0.16)));
            renderAnswer();
          }
          if (streamDone && displayed >= text.length) {
            resolveReveal?.();
            resolveReveal = null;
            return;
          }
          pumpFrame = requestAnimationFrame(pump);
        };

        const scheduleReveal = () => {
          if (!pumpFrame) pumpFrame = requestAnimationFrame(pump);
        };

        try {
          const response = await fetch(ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              path: location.pathname,
              isArticle: true,
              question,
              history: recentHistory,
            }),
            signal: controller.signal,
          });

          if (!response.ok || !response.body) {
            const data = await response.json().catch(() => null);
            throw new Error(data?.error || `请求失败（${response.status}）`);
          }

          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          let finish: { cached?: boolean; truncated?: boolean } | null = null;
          while (!finish) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            for (let cut; (cut = buffer.indexOf('\n\n')) !== -1; ) {
              const line = buffer.slice(0, cut).split('\n').find((l) => l.startsWith('data:'));
              buffer = buffer.slice(cut + 2);
              if (!line) continue;
              const message = JSON.parse(line.slice(5));
              if (message.error) throw new Error(message.error);
              if (message.t && !text) status.querySelector('.ink-ask-status-text')!.textContent = '沉思推演中';
              if (message.d) {
                if (!text) {
                  status.classList.add('is-leaving');
                  turn.classList.add('is-streaming', 'is-answering');
                  window.setTimeout(() => {
                    if (!controller.signal.aborted) status.hidden = true;
                  }, 180);
                }
                text += message.d;
                scheduleReveal();
              }
              if (message.done) finish = message;
            }
          }
          if (!text.trim()) throw new Error('没有收到回答，稍后再试');
          streamDone = true;
          scheduleReveal();
          await revealComplete;
          turn.classList.remove('is-streaming');
          turn.classList.toggle('is-cached', Boolean(finish?.cached));
          renderAnswer();
          if (!finish?.cached) settleCaret(answer);
          addSaveNoteButton(turn, () => text, question, answer);
          updateActiveTurnAnswer(location.pathname, storedTurn.id, text, { cached: Boolean(finish?.cached) });
          if (finish?.truncated) note(turn, '回答太长，后面被截断了');
        } catch (error) {
          if (controller.signal.aborted) return;
          if (pumpFrame) cancelAnimationFrame(pumpFrame);
          streamDone = true;
          turn.classList.remove('is-streaming');
          if (text) {
            displayed = text.length;
            renderAnswer();
            updateActiveTurnAnswer(location.pathname, storedTurn.id, text, { cached: false });
          } else if (storedTurn?.id) {
            storeRemoveTurn(location.pathname, storedTurn.id);
          }
          status.hidden = false;
          status.classList.remove('is-leaving');
          status.classList.add('is-error');
          status.textContent = error instanceof TypeError ? '网络好像断了，稍后再试' : (error as Error).message || '出错了，稍后再试';
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.className = 'ink-ask-retry';
          retry.textContent = '再试一次';
          retry.addEventListener('click', () => {
            if (turn.dataset.turnId) {
              storeRemoveTurn(location.pathname, turn.dataset.turnId);
            }
            turn.remove();
            askDrawer(question);
          });
          status.append(retry);
        } finally {
          if (sidebarController === controller) {
            sidebarController = null;
            form.classList.remove('is-busy');
          }
        }
      }

      loadAndRenderActiveSession(thread, welcome, (tTurn, q) => recallDrawerTurn(tTurn, q));
      reloadDrawerSession = () => loadAndRenderActiveSession(thread, welcome, (tTurn, q) => recallDrawerTurn(tTurn, q));
    }
  }

  function openSidebar(opts?: { silent?: boolean } | Event) {
    sidebarCloseVersion++;
    const isSilent = Boolean(opts && !(opts instanceof Event) && opts.silent);
    ensureSidebar();
    setWelcomeEpigraph(sidebarDrawer?.querySelector<HTMLElement>('.ink-ask-welcome-epigraph'));
    const wasOpen = Boolean(sidebarDrawer?.classList.contains('is-open'));

    lockScrollAnchor(readArticleMotion().panelMs + 100);

    if (isSilent && sidebarDrawer) {
      sidebarDrawer.style.transition = 'none';
      sidebarOverlay?.classList.add('is-open');
      sidebarDrawer.classList.add('is-open');
      document.body.classList.add('ink-ask-drawer-open');
      void sidebarDrawer.offsetWidth;
      sidebarDrawer.style.transition = '';
    } else {
      if (sidebarDrawer) void sidebarDrawer.offsetWidth;
      if (sidebarOverlay) void sidebarOverlay.offsetWidth;
      sidebarOverlay?.classList.add('is-open');
      sidebarDrawer?.classList.add('is-open');
      document.body.classList.add('ink-ask-drawer-open');

      if (!wasOpen && sidebarDrawer && !reduceMotion()) {
        if (!sidebarDrawer.classList.contains('has-turns')) {
          const welcomeEl = sidebarDrawer.querySelector<HTMLElement>('.ink-ask-drawer-welcome');
          if (welcomeEl) {
            welcomeEl.classList.remove('is-entering');
            void welcomeEl.offsetWidth;
            welcomeEl.classList.add('is-entering');
          }
        }
      }

      sidebarDrawer?.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input')?.focus({ preventScroll: true });
    }

    window.dispatchEvent(new CustomEvent('companion:panel', { detail: { kind: 'ask', open: true } }));
    window.dispatchEvent(new CustomEvent('ink-ask:open'));
    clampCardAwayFromRails();
  }

  function closeSidebar(opts?: { instant?: boolean } | Event) {
    const closeVersion = ++sidebarCloseVersion;
    const isInstant = Boolean(opts && !(opts instanceof Event) && opts.instant);
    lockScrollAnchor(readArticleMotion().panelMs + 100);
    const wasMax = sidebarDrawer?.classList.contains('is-maximized');

    if (isInstant && sidebarDrawer) {
      sidebarDrawer.style.transition = 'none';
      sidebarOverlay?.classList.remove('is-open');
      sidebarDrawer.classList.remove('is-open', 'is-maximized');
      document.body.classList.remove('ink-ask-drawer-open', 'ink-ask-drawer-maximized');
      const maxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize');
      if (maxBtn) {
        maxBtn.innerHTML = MAXIMIZE_ICON;
        maxBtn.dataset.tip = '全屏展开';
      }
      void sidebarDrawer.offsetWidth;
      sidebarDrawer.style.transition = '';
      sidebarController?.abort();
      window.dispatchEvent(new CustomEvent('companion:panel', { detail: { kind: 'ask', open: false } }));
      return;
    }

    sidebarOverlay?.classList.remove('is-open');
    sidebarDrawer?.classList.remove('is-open');
    document.body.classList.remove('ink-ask-drawer-open');
    sidebarController?.abort();
    sidebarBtn?.focus();

    window.dispatchEvent(new CustomEvent('companion:panel', { detail: { kind: 'ask', open: false } }));

    setTimeout(() => {
      if (closeVersion !== sidebarCloseVersion) return;
      if (sidebarDrawer?.classList.contains('is-open')) return;
      if (wasMax && sidebarDrawer) {
        sidebarDrawer.classList.remove('is-maximized');
        document.body.classList.remove('ink-ask-drawer-maximized');
        const maxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize');
        if (maxBtn) {
          maxBtn.innerHTML = MAXIMIZE_ICON;
          maxBtn.dataset.tip = '全屏展开';
        }
      }
    }, reduceMotion() ? 0 : readArticleMotion().panelMs + 40);
  }

  function toggleSidebar() {
    if (sidebarDrawer?.classList.contains('is-open')) closeSidebar();
    else openSidebar();
  }

  function openSidebarWithContext(snippet: string) {
    ensureSidebar();
    openSidebar();
    const textarea = sidebarDrawer?.querySelector<HTMLTextAreaElement>('.ink-ask-drawer-input');
    if (textarea && snippet) {
      const cleanSnippet = snippet.trim();
      textarea.value = cleanSnippet;
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.focus({ preventScroll: true });
      textarea.setSelectionRange(textarea.value.length, textarea.value.length);
    }
  }

  function mountFollowUpContext(payload: { text: string; question?: string; kind?: string; heading?: string }) {
    ensureSidebar();
    openSidebar();
    const fn = (sidebarDrawer as any)?.__mountFollowUpChip;
    if (typeof fn === 'function') {
      fn(payload);
    } else if (payload?.text) {
      openSidebarWithContext(payload.text);
    }
  }

  function locateTurn(queryOrId: string): boolean {
    ensureSidebar();
    openSidebar();
    if (!sidebarDrawer) return false;
    const turns = Array.from(sidebarDrawer.querySelectorAll<HTMLElement>('.ink-ask-turn'));
    const clean = (queryOrId || '').trim();
    const target =
      turns.find((t) => t.dataset.turnId === clean || t.id === clean) ||
      turns.find((t) => (t.dataset.question || '').includes(clean) || (t.textContent || '').includes(clean)) ||
      turns[turns.length - 1];
    if (!target) return false;
    window.setTimeout(() => {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.remove('has-turn-pulse');
      void target.offsetWidth;
      target.classList.add('has-turn-pulse');
      window.setTimeout(() => target.classList.remove('has-turn-pulse'), 800);
    }, 220);
    return true;
  }

  function resetConversation() {
    sidebarDrawer?.querySelector<HTMLButtonElement>('.ink-ask-drawer-new')?.click();
  }

  (window as any).__inkAsk = {
    ensureSidebar,
    openSidebar,
    closeSidebar,
    toggleSidebar,
    resetConversation,
    openSidebarWithContext,
    mountFollowUpContext,
    locateTurn,
    clampCard: clampCardAwayFromRails,
  };

  window.addEventListener('inkask:open-with-context', (e: any) => {
    const text = e.detail?.snippet || e.detail?.text || '';
    openSidebarWithContext(text);
  });

  // 与「高亮笔记」抽屉彻底解耦：不再互相关闭。
  // 摆位与同屏模式由 CompanionLayout 统一协调（浮岛 / 全屏 / 并排）。
  window.addEventListener('article-notes:open', () => {
    (window as any).__companion?.sync?.();
    clampCardAwayFromRails();
  });

  // ---------- 全局监听 ----------

  function initInkAsk() {
    if (!prose()) return;
    ensureSidebar();
    probe().then(() => {});
  }

  initInkAsk();

  if (!(window as any)[LISTENER_KEY]) {
    (window as any)[LISTENER_KEY] = true;

    document.addEventListener(
      'pointerdown',
      (event) => {
        const target = event.target as Element | null;
        if (target?.closest?.('.ink-ask-seal, .ink-ask-card, .ink-ask-sidebar-trigger, .ink-ask-drawer')) return;
        // 选区小窗只认自己的 × 按钮：点正文 / 点笔记 / 点空白都不再关闭它，
        // 这样才可能「一边写笔记一边看问答」。
        if (event.pointerType === 'mouse' && event.button === 0) {
          mouseDown = true;
          hideSeal();
        }
      },
      true,
    );

    document.addEventListener(
      'pointerup',
      () => {
        if (!mouseDown) return;
        mouseDown = false;
        settleSoon(20);
      },
      true,
    );

    document.addEventListener('selectionchange', () => {
      if (!mouseDown) settleSoon(280);
    });

    function trapModalTab(container: HTMLElement, e: KeyboardEvent) {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(
        container.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => el.offsetParent !== null || el.offsetWidth > 0 || el.offsetHeight > 0);
      if (focusables.length === 0) {
        e.preventDefault();
        return;
      }
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first || !container.contains(document.activeElement)) {
          e.preventDefault();
          last.focus({ preventScroll: true });
        }
      } else {
        if (document.activeElement === last || !container.contains(document.activeElement)) {
          e.preventDefault();
          first.focus({ preventScroll: true });
        }
      }
    }

    document.addEventListener('keydown', (event) => {
      const active = document.activeElement as HTMLElement | null;
      // 并排时两块面板都要能用 Tab 互相到达，此时不做模态焦点陷阱
      const trapAllowed = document.documentElement.getAttribute('data-companion-mode') !== 'split';
      if (sidebarDrawer?.classList.contains('is-open')) {
        // 只有焦点确实落在面板里才接管 Tab，否则会抢走笔记抽屉的键盘操作
        if (trapAllowed && event.key === 'Tab' && active && sidebarDrawer.contains(active)) {
          trapModalTab(sidebarDrawer, event);
          return;
        }
        if (event.key === 'Escape') {
          if (sidebarController) {
            event.preventDefault();
            event.stopPropagation();
            recallActiveDrawerTurn?.();
            return;
          }
          if (sidebarDrawer.classList.contains('is-maximized')) {
            event.preventDefault();
            event.stopPropagation();
            const maxBtn = sidebarDrawer.querySelector<HTMLButtonElement>('.ink-ask-drawer-maximize');
            maxBtn?.click();
            return;
          }
          closeSidebar();
          return;
        }
      }

      if (session) {
        if (trapAllowed && event.key === 'Tab' && active && session.card.contains(active)) {
          trapModalTab(session.card, event);
          return;
        }
        if (event.key === 'Escape') {
          if (session.controller) {
            event.preventDefault();
            event.stopPropagation();
            recallSessionTurn(session);
            return;
          }
          if (session.card.classList.contains('is-maximized')) {
            event.preventDefault();
            event.stopPropagation();
            const maxBtn = session.card.querySelector<HTMLButtonElement>('.ink-ask-card-maximize');
            maxBtn?.click();
            return;
          }
          // Esc 不再关闭小窗：它只认标题栏的 ×
          return;
        }
      }

      if (event.key === 'Escape') {
        hideSeal();
      }
    });

    let resizeFrame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        hideSeal();
        if (session) place(session);
      });
    });

    document.addEventListener('astro:page-load', () => {
      initInkAsk();
      reloadDrawerSession?.();
    });

    window.addEventListener('companion:ready', () => {
      syncAskRegistration?.();
    });

    document.addEventListener('astro:before-swap', () => {
      close(true);
      closeSidebar();
      hideSeal();
      syncAskRegistration = null;
      reloadDrawerSession = null;
      seal?.remove();
      seal = null;
      sidebarBtn?.remove();
      sidebarBtn = null;
      sidebarOverlay?.remove();
      sidebarOverlay = null;
      sidebarDrawer?.remove();
      sidebarDrawer = null;
    });
  }
</script>

