        <span class="ink-ask-char-count" aria-live="polite"></span>
        <button type="button" class="ink-ask-recall" aria-label="撤回刚才的提问并重新编辑" title="撤回刚才的提问并重新编辑 (Esc)">${ICON_RECALL}<span>撤回</span></button>
