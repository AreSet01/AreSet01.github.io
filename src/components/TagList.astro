---
import { tagSlug } from '../utils/posts';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = '' } = Astro.props;
---

<div class={`flex flex-wrap items-center gap-x-5 gap-y-1 ${className}`}>
  {tags.map(tag => (
    <a class="tag-chip" href={`/tags/${tagSlug(tag)}`}>{tag}</a>
  ))}
</div>
