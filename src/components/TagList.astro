---
import { tagSlug } from '../utils/posts';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className = '' } = Astro.props;
---

<div class={`tag-list-brush flex flex-wrap items-center gap-x-5 gap-y-1.5 ${className}`}>
  {tags.map(tag => (
    <a class="tag-chip tag-chip-ink" href={`/tags/${tagSlug(tag)}`}>
      <span class="tag-chip-label">{tag}</span>
    </a>
  ))}
</div>

<style>
  .tag-chip-ink {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    transition: color 240ms var(--ease), transform 260ms var(--ease-bounce);
  }

  .tag-chip-ink::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    background: linear-gradient(90deg, var(--vermilion) 0%, var(--accent) 65%, transparent 100%);
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1), opacity 240ms var(--ease);
    pointer-events: none;
  }

  .tag-chip-ink:hover,
  .tag-chip-ink:focus-visible {
    transform: translateY(-1px);
  }

  .tag-chip-ink:hover::after,
  .tag-chip-ink:focus-visible::after {
    transform: scaleX(1);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .tag-chip-ink,
    .tag-chip-ink::after {
      transition: none !important;
    }
  }
</style>
