---
import { formatDate } from '../utils/date';
import { tagSlug } from '../utils/posts';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  slug: string;
  index?: number;
  locked?: boolean;
}

const { title, description, pubDate, tags = [], slug, index = 0, locked = false } = Astro.props;
const noteNumber = String(index + 1).padStart(2, '0');
const enterFrom = (['left', 'bottom', 'right'] as const)[index % 3];
---

<article class="h-full" data-enter={enterFrom}>
  <!-- The card body is a plain element so the tag links inside can be real links; the post link
       is stretched over the whole card via ::after, keeping the preview-modal behaviour. -->
  <div class="note-card group">
    <a
      href={`/posts/${slug}`}
      data-post-preview={`/posts/${slug}`}
      class="note-card-link"
      aria-label={title}
    ></a>

    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 font-mono text-[0.72rem] tracking-[0.08em] text-[var(--muted)]">
      <span class="whitespace-nowrap">№ {noteNumber}</span>
      <div class="flex items-center gap-3">
        {locked && <span class="lock-mark">Locked</span>}
        <time datetime={pubDate.toISOString()} class="whitespace-nowrap">
          {formatDate(pubDate)}
        </time>
      </div>
    </div>

    <h2 class="font-display mt-5 text-[1.5rem] leading-[1.38] py-1 text-[var(--text-strong)] transition duration-300 group-hover:text-[var(--accent)]">
      {title}
    </h2>

    {description && (
      <p
        class="mt-3 text-[0.92rem] leading-relaxed text-[var(--muted-strong)] line-clamp-3"
        style="font-family: var(--font-serif); font-style: italic;"
      >
        {description}
      </p>
    )}

    {tags.length > 0 && (
      <div class="note-card-tags mt-5 flex flex-wrap gap-x-4 gap-y-1">
        {tags.slice(0, 3).map(tag => (
          <a class="tag-chip" href={`/tags/${tagSlug(tag)}`}>{tag}</a>
        ))}
      </div>
    )}

    <div class="mt-auto flex items-center justify-between gap-3 pt-8">
      <span class="whitespace-nowrap font-mono text-[0.72rem] tracking-[0.16em] uppercase text-[var(--accent)]">
        Read →
      </span>
      <span class="surface-pill shrink-0">
        {String(tags.length).padStart(2, '0')} / TAGS
      </span>
    </div>
  </div>
</article>
