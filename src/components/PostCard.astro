---
import { formatDate } from '../utils/date';
import { tagSlug } from '../utils/posts';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  slug: string;
  index?: number;
  locked?: boolean;
}

const { title, description, pubDate, tags = [], slug, index = 0, locked = false } = Astro.props;
const noteNumber = String(index + 1).padStart(2, '0');
---

<article class="h-full" data-enter="card">
  <!-- The card body is a plain element so the tag links inside can be real links; the post link
       is stretched over the whole card via .note-card-link, keeping the preview-modal behaviour. -->
  <div class="note-card paper-card group" data-tilt data-paper-card>
    <!-- Pre-rendered compositor shadow layer (animates opacity only — zero box-shadow repaint) -->
    <span class="paper-card-elevation" aria-hidden="true"></span>
    <!-- Xuan-paper diffuse light sheen & fine paper fiber catchlight -->
    <span class="paper-card-sheen" aria-hidden="true"></span>
    <!-- Running-script calligraphy edge ink frame -->
    <span class="paper-card-inkframe" aria-hidden="true"></span>
    <!-- Vermilion corner seal mark -->
    <span class="paper-card-seal" aria-hidden="true">{locked ? '封' : '阅'}</span>

    <a
      href={`/posts/${slug}`}
      data-post-preview={`/posts/${slug}`}
      class="note-card-link"
      aria-label={title}
    ></a>

    <div class="paper-card-meta flex flex-wrap items-center justify-between gap-x-3 gap-y-1 font-mono text-[0.72rem] tracking-[0.08em] text-[var(--muted)]">
      <span class="paper-card-no whitespace-nowrap">№ {noteNumber}</span>
      <div class="flex items-center gap-3">
        {locked && <span class="lock-mark">Locked</span>}
        <time datetime={pubDate.toISOString()} class="whitespace-nowrap">
          {formatDate(pubDate)}
        </time>
      </div>
    </div>

    <h2 class="paper-card-title font-display mt-5 text-[1.5rem] leading-[1.38] py-1 text-[var(--text-strong)] transition-colors duration-300 group-hover:text-[var(--accent)]">
      {title}
    </h2>

    {description && (
      <p
        class="paper-card-excerpt mt-3 text-[0.92rem] leading-relaxed text-[var(--muted-strong)] line-clamp-3"
        style="font-family: var(--font-serif); font-style: italic;"
      >
        {description}
      </p>
    )}

    {tags.length > 0 && (
      <div class="note-card-tags mt-5 flex flex-wrap gap-x-4 gap-y-1">
        {tags.slice(0, 3).map(tag => (
          <a class="tag-chip paper-tag-chip" href={`/tags/${tagSlug(tag)}`}>{tag}</a>
        ))}
      </div>
    )}

    <div class="paper-card-foot mt-auto flex items-center justify-between gap-3 pt-8">
      <span class="paper-read-cta whitespace-nowrap font-mono text-[0.72rem] tracking-[0.16em] uppercase text-[var(--accent)] inline-flex items-center gap-1.5">
        Read <span class="arrow-indicator inline-block" data-card-arrow aria-hidden="true">&rarr;</span>
      </span>
      <span class="surface-pill shrink-0">
        {String(tags.length).padStart(2, '0')} / TAGS
      </span>
    </div>
  </div>
</article>

<script>
  import { bindGlobalPaperCardLifecycle } from '../utils/cardMotion';
  bindGlobalPaperCardLifecycle();
</script>

<style>
  /* 根除 box-shadow 逐帧重绘：卡片本体保持静态轻墨底影，抬升阴影完全交由 .paper-card-elevation 的 opacity 合成层驱动 */
  .note-card.paper-card {
    --paper-x: 50%;
    --paper-y: 35%;
    --paper-sheen-opacity: 0;
    --paper-glow-rgb: 128, 98, 66;
    --paper-fiber-rgb: 110, 82, 52;
    position: relative;
    isolation: isolate;
    box-shadow: 0 3px 12px -3px rgba(0, 0, 0, 0.045) !important;
    transition:
      background-color 340ms var(--ease-card),
      border-color 340ms var(--ease-card),
      color 260ms var(--ease-card) !important;
  }

  .note-card.paper-card:hover,
  .note-card.paper-card:focus-within {
    box-shadow: 0 3px 12px -3px rgba(0, 0, 0, 0.045) !important;
  }

  :global([data-theme="dark"]) .note-card.paper-card {
    --paper-glow-rgb: 235, 228, 214;
    --paper-fiber-rgb: 240, 232, 218;
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.42) !important;
  }

  :global([data-theme="dark"]) .note-card.paper-card:hover,
  :global([data-theme="dark"]) .note-card.paper-card:focus-within {
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.42) !important;
  }

  :global([data-theme="moss"]) .note-card.paper-card {
    --paper-glow-rgb: 255, 198, 212;
    --paper-fiber-rgb: 255, 228, 235;
    box-shadow: 0 4px 16px -4px rgba(0, 32, 26, 0.28) !important;
  }

  :global([data-theme="moss"]) .note-card.paper-card:hover,
  :global([data-theme="moss"]) .note-card.paper-card:focus-within {
    box-shadow: 0 4px 16px -4px rgba(0, 32, 26, 0.28) !important;
  }

  :global([data-theme="rice"]) .note-card.paper-card {
    --paper-glow-rgb: 148, 104, 62;
    --paper-fiber-rgb: 125, 92, 66;
    box-shadow: 0 3px 14px -3px rgba(92, 70, 44, 0.09) !important;
  }

  :global([data-theme="rice"]) .note-card.paper-card:hover,
  :global([data-theme="rice"]) .note-card.paper-card:focus-within {
    box-shadow: 0 3px 14px -3px rgba(92, 70, 44, 0.09) !important;
  }

  /* 1. 预渲染宣纸浮空墨晕投影层（纯 opacity 动画，零 Paint 开销） */
  .paper-card-elevation {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: -2;
    box-shadow:
      0 18px 38px -12px rgba(var(--accent-rgb), 0.14),
      0 8px 20px -6px rgba(var(--paper-glow-rgb), 0.12),
      0 1px 0 0 rgba(255, 255, 255, 0.45) inset;
    opacity: 0;
    transition: opacity 420ms var(--ease-card);
  }

  :global([data-theme="dark"]) .paper-card-elevation {
    box-shadow:
      0 20px 44px -10px rgba(0, 0, 0, 0.68),
      0 6px 18px -4px rgba(var(--accent-rgb), 0.1),
      0 1px 0 0 rgba(255, 255, 255, 0.09) inset;
  }

  :global([data-theme="moss"]) .paper-card-elevation {
    box-shadow:
      0 20px 42px -10px rgba(0, 28, 22, 0.46),
      0 6px 18px -4px rgba(var(--accent-rgb), 0.2),
      0 1px 0 0 rgba(255, 241, 244, 0.16) inset;
  }

  .note-card.paper-card:hover .paper-card-elevation,
  .note-card.paper-card:focus-within .paper-card-elevation,
  .note-card.paper-card:global(.is-paper-hovered) .paper-card-elevation {
    opacity: 1;
  }

  /* 2. 宣纸纤维受光漫反射墨晕（随指针坐标实时流转温润纸纹光泽） */
  .paper-card-sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
    opacity: var(--paper-sheen-opacity, 0);
    background:
      radial-gradient(
        340px circle at var(--paper-x, 50%) var(--paper-y, 35%),
        rgba(var(--paper-glow-rgb), 0.12) 0%,
        rgba(var(--accent-rgb), 0.05) 38%,
        transparent 72%
      ),
      repeating-linear-gradient(
        92deg,
        transparent 0px,
        transparent 19px,
        rgba(var(--paper-fiber-rgb), 0.026) 19px,
        rgba(var(--paper-fiber-rgb), 0.026) 20px
      ),
      repeating-linear-gradient(
        2deg,
        transparent 0px,
        transparent 29px,
        rgba(var(--paper-fiber-rgb), 0.018) 29px,
        rgba(var(--paper-fiber-rgb), 0.018) 30px
      );
    transition: opacity 280ms var(--ease);
  }

  .note-card.paper-card:focus-within .paper-card-sheen {
    opacity: 0.75;
  }

  /* 3. 卡片边缘「行书起收笔墨线」渐显反馈 */
  .paper-card-inkframe {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .paper-card-inkframe::before,
  .paper-card-inkframe::after {
    content: '';
    position: absolute;
    pointer-events: none;
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1), opacity 360ms var(--ease);
    opacity: 0;
  }

  /* 顶部横锋：起笔浓、收笔飞白渐隐 */
  .paper-card-inkframe::before {
    top: 0;
    left: 0.85rem;
    right: 2.4rem;
    height: 1.5px;
    background: linear-gradient(90deg, var(--vermilion) 0%, var(--accent) 42%, transparent 100%);
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* 左缘竖锋：自左上折笔垂落 */
  .paper-card-inkframe::after {
    top: 0.85rem;
    bottom: 1.8rem;
    left: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--vermilion) 0%, var(--accent) 48%, transparent 100%);
    transform: scaleY(0);
    transform-origin: center top;
  }

  .note-card.paper-card:hover .paper-card-inkframe::before,
  .note-card.paper-card:focus-within .paper-card-inkframe::before {
    transform: scaleX(1);
    opacity: 0.86;
  }

  .note-card.paper-card:hover .paper-card-inkframe::after,
  .note-card.paper-card:focus-within .paper-card-inkframe::after {
    transform: scaleY(1);
    opacity: 0.78;
    transition-delay: 45ms;
  }

  /* 4. 朱砂角印：悬停时如钤印轻落右下留白处 */
  .paper-card-seal {
    position: absolute;
    right: 1.35rem;
    top: 2.95rem;
    width: 1.48rem;
    height: 1.48rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--vermilion);
    border-radius: 3px;
    color: var(--vermilion);
    background: color-mix(in srgb, var(--vermilion) 6%, transparent);
    font-family: var(--font-hand-title);
    font-size: 0.74rem;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    opacity: 0;
    transform: scale(1.32) rotate(-12deg);
    transition:
      opacity 280ms var(--ease),
      transform 460ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .note-card.paper-card:hover .paper-card-seal,
  .note-card.paper-card:focus-within .paper-card-seal {
    opacity: 0.76;
    transform: scale(1) rotate(-5deg);
  }

  .paper-card-no {
    position: relative;
    transition: color 260ms var(--ease);
  }

  .note-card.paper-card:hover .paper-card-no {
    color: var(--text-strong);
  }

  .paper-read-cta {
    position: relative;
  }

  .paper-read-cta::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: linear-gradient(90deg, var(--vermilion), transparent);
    transform: scaleX(0.2);
    transform-origin: left center;
    opacity: 0.45;
    transition: transform 360ms var(--ease), opacity 280ms var(--ease);
  }

  .note-card.paper-card:hover .paper-read-cta::after,
  .note-card.paper-card:focus-within .paper-read-cta::after {
    transform: scaleX(1);
    opacity: 0.9;
  }

  /* 卡片内标签笔触微交互 */
  .paper-tag-chip {
    position: relative;
    z-index: 2;
    transition: color 240ms var(--ease), transform 240ms var(--ease);
  }

  .paper-tag-chip::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1px;
    background: linear-gradient(90deg, var(--vermilion), transparent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 280ms var(--ease);
  }

  .paper-tag-chip:hover {
    transform: translateY(-1px);
  }

  .paper-tag-chip:hover::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .paper-card-elevation,
    .paper-card-sheen,
    .paper-card-inkframe::before,
    .paper-card-inkframe::after,
    .paper-card-seal,
    .paper-read-cta::after,
    .paper-tag-chip,
    .paper-tag-chip::after {
      transition: none !important;
      transform: none !important;
    }
    .paper-card-sheen {
      display: none;
    }
  }
</style>
