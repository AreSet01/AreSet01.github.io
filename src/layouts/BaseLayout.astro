      })();
    </script>
    <script is:inline>
      /* ========== 主题切换 ========== */
      (function() {
        var toggleKey = '__areSetThemeToggleBound__';
        if (window[toggleKey]) return;

        // light → dark → moss → rice → light
        var THEME_CYCLE = ['light', 'dark', 'moss', 'rice'];

        document.addEventListener('click', function(e) {
          var node = e.target;
          var el = node && typeof node.closest === 'function'
            ? node
            : (node && node.parentElement && typeof node.parentElement.closest === 'function' ? node.parentElement : null);
          var btn = el ? el.closest('[data-theme-toggle]') : null;
          if (!btn) return;
          if (typeof btn.blur === 'function') btn.blur();

          var current = (document.documentElement.getAttribute('data-theme') || '').trim() ||
            (typeof window.__getPreferredTheme === 'function' ? window.__getPreferredTheme() : 'light');
          var index = THEME_CYCLE.indexOf(current);
          var next = index !== -1 ? THEME_CYCLE[(index + 1) % THEME_CYCLE.length] : 'dark';

          try {
            localStorage.setItem('theme', next);
          } catch (error) {}

          if (typeof window.__transitionTheme === 'function') {
            window.__transitionTheme(next, btn);
          } else if (typeof window.__applyTheme === 'function') {
            window.__applyTheme(next);
          } else {
            document.documentElement.setAttribute('data-theme', next);
          }
        });

        window[toggleKey] = true;
      })();
    </script>
    <script is:inline>
      /* ========== 字体切换：像素体 ⇄ 行楷 ========== */
      (function() {
        var toggleKey = '__areSetFontToggleBound__';
        if (window[toggleKey]) return;

        document.addEventListener('click', function(e) {
          var node = e.target;
          var el = node && typeof node.closest === 'function'
            ? node
            : (node && node.parentElement && typeof node.parentElement.closest === 'function' ? node.parentElement : null);
          var btn = el ? el.closest('[data-font-toggle]') : null;
          if (!btn) return;
          if (typeof btn.blur === 'function') btn.blur();

          var isKai = document.documentElement.getAttribute('data-font') === 'kai';
          var next = isKai ? 'pixel' : 'kai';

          try {
            localStorage.setItem('site-font', next);
          } catch (error) {}

          if (typeof window.__transitionFont === 'function') {
            window.__transitionFont(next, btn);
          } else if (typeof window.__applyFont === 'function') {
            window.__applyFont(next);
          } else if (next === 'kai') {
            document.documentElement.setAttribute('data-font', 'kai');
          } else {
            document.documentElement.removeAttribute('data-font');
          }
        });

        window[toggleKey] = true;
      })();
    </script>
    <script is:inline>
      /* ========== 阅读进度条 ========== */
      (function initProgress() {
        var cleanupListeners = null;

        function setup() {
          if (cleanupListeners) {
            cleanupListeners();
            cleanupListeners = null;
          }

          var old = document.querySelector('.reading-progress');
          if (old) old.remove();

          var prose = document.querySelector('.prose');
          if (!prose) return;

          var bar = document.createElement('div');
          bar.className = 'reading-progress';
          document.body.appendChild(bar);

          function update() {
            var rect = prose.getBoundingClientRect();
            var top = -rect.top;
            var total = rect.height - window.innerHeight;
            if (total <= 0) { bar.style.transform = 'scaleX(1)'; return; }
            var pct = Math.min(100, Math.max(0, (top / total) * 100));
            bar.style.transform = 'scaleX(' + (pct / 100) + ')';
            if (pct >= 99.5) {
              bar.classList.add('is-hidden');
            } else {
              bar.classList.remove('is-hidden');
            }
          }

          var progressTicking = false;
          function onScrollOrResize() {
            if (!progressTicking) {
              progressTicking = true;
              requestAnimationFrame(function() {
                update();
                progressTicking = false;
              });
            }
          }

          window.addEventListener('scroll', onScrollOrResize, { passive: true });
          window.addEventListener('resize', onScrollOrResize, { passive: true });
          cleanupListeners = function() {
            window.removeEventListener('scroll', onScrollOrResize);
            window.removeEventListener('resize', onScrollOrResize);
          };
          update();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', setup);
        } else {
          setup();
        }
        document.addEventListener('astro:page-load', setup);
      })();
    </script>

    <!-- 3D Tilt Card System (rAF 合帧 · 滚动缓存失效保护 · 无光晕无溢出缩放) -->
    <script>
      import gsap from 'gsap';

      let tiltScrollInvalidateBound = false;
      const tiltInvalidateCallbacks = new Set<() => void>();

      function initTiltCards() {
        (window as any).__initTiltCards = initTiltCards;
        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        if (!tiltScrollInvalidateBound) {
          tiltScrollInvalidateBound = true;
          const invalidateAll = () => {
            tiltInvalidateCallbacks.forEach((fn) => fn());
          };
          window.addEventListener('scroll', invalidateAll, { passive: true });
          window.addEventListener('resize', invalidateAll, { passive: true });
          document.addEventListener('astro:before-swap', () => {
            tiltInvalidateCallbacks.clear();
          });
        }

        const cards = document.querySelectorAll<HTMLElement>('[data-tilt]');
        if (!cards.length) return;

        cards.forEach((card) => {
          if ((card as any).__tiltActive) return;
          (card as any).__tiltActive = true;

          let rect = { left: 0, top: 0, width: 1, height: 1 } as DOMRect;
          let rectDirty = true;
          let isInside = false;
          let tiltRaf = 0;
          let pendingClientX = 0;
          let pendingClientY = 0;
          const maxTilt = 4.5;

          const markDirty = () => {
            rectDirty = true;
          };
          tiltInvalidateCallbacks.add(markDirty);

          const updateRect = () => {
            rect = card.getBoundingClientRect();
            rectDirty = false;
          };

          const isCardInMotion = () =>
            card.classList.contains('is-entering') || card.classList.contains('is-reflowing');

          const onPointerEnter = () => {
            if (isCardInMotion()) return;
            isInside = true;
            updateRect();
          };

          const onPointerMove = (e: PointerEvent) => {
            if (isCardInMotion()) return;
            pendingClientX = e.clientX;
            pendingClientY = e.clientY;
            if (tiltRaf) return;
            tiltRaf = requestAnimationFrame(() => {
              tiltRaf = 0;
              if (!isInside || rectDirty) {
                isInside = true;
                updateRect();
              }

              const x = pendingClientX - rect.left;
              const y = pendingClientY - rect.top;

              const xPct = Math.max(0, Math.min(1, x / Math.max(1, rect.width))) - 0.5;
              const yPct = Math.max(0, Math.min(1, y / Math.max(1, rect.height))) - 0.5;

              const rotX = -yPct * maxTilt * 2;
              const rotY = xPct * maxTilt * 2;

              gsap.to(card, {
                rotateX: rotX,
                rotateY: rotY,
                y: -3,
                transformPerspective: 1000,
                duration: 0.36,
                ease: 'card-enter',
                overwrite: 'auto',
              });
            });
          };

          const onPointerLeave = () => {
            isInside = false;
            if (tiltRaf) {
              cancelAnimationFrame(tiltRaf);
              tiltRaf = 0;
            }
            if (isCardInMotion()) return;

            gsap.to(card, {
              rotateX: 0,
              rotateY: 0,
              y: 0,
              transformPerspective: 1000,
              duration: 0.68,
              ease: 'card-enter',
              overwrite: 'auto',
            });
          };

          card.addEventListener('pointerenter', onPointerEnter, { passive: true });
          card.addEventListener('pointermove', onPointerMove, { passive: true });
          card.addEventListener('pointerleave', onPointerLeave, { passive: true });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initTiltCards);
      } else {
        initTiltCards();
      }
      document.addEventListener('astro:page-load', initTiltCards);
    </script>

    <style is:global>
      /* ── 主题/字体切换水墨晕环 & 单色水墨涟漪光环（纯合成器 transform + opacity，零 blur） ── */
      .theme-switch-ink-ring {
        position: fixed;
        z-index: 2147483645;
        border-radius: 50%;
        pointer-events: none;
        border: 1.5px solid var(--border-strong, rgba(0, 0, 0, 0.34));
        background: radial-gradient(
          circle,
          transparent 62%,
          rgba(26, 24, 20, 0.08) 92%,
          transparent 100%
        );
        transform: translate3d(-50%, -50%, 0) scale(0.02);
        will-change: transform, opacity;
      }

      [data-theme="dark"] .theme-switch-ink-ring {
        border-color: rgba(234, 232, 227, 0.38);
        background: radial-gradient(
          circle,
          transparent 62%,
          rgba(234, 232, 227, 0.1) 92%,
          transparent 100%
        );
      }

      [data-theme="moss"] .theme-switch-ink-ring {
        border-color: rgba(255, 194, 209, 0.55);
        background: radial-gradient(
          circle,
          transparent 62%,
          rgba(255, 241, 244, 0.14) 92%,
          transparent 100%
        );
      }

      .ink-ripple-halo {
        position: fixed;
        z-index: 60;
        border-radius: 9999px;
        border: 1.25px solid var(--border-strong, var(--ink));
        pointer-events: none;
        transform-origin: center center;
        will-change: transform, opacity;
      }

      [data-theme="dark"] .ink-ripple-halo {
        border-color: rgba(234, 232, 227, 0.42);
      }

      [data-theme="moss"] .ink-ripple-halo {
        border-color: rgba(255, 194, 209, 0.58);
      }

      /* View Transition 运行中彻底静默内层 CSS 过渡，杜绝旧帧快照滞后与 box-shadow/filter 掉帧 */
      html[data-vt-active="true"].theme-switching *,
      html[data-vt-active="true"].theme-switching body,
      html[data-vt-active="true"].theme-switching body::before,
      html[data-vt-active="true"].theme-switching body::after {
        transition: none !important;
      }

      /* 降级非 VT 路径：只柔和过渡墨色与背景色，严禁逐帧过滤模糊与阴影重绘 */
      html:not([data-vt-active="true"]).theme-switching body,
      html:not([data-vt-active="true"]).theme-switching .site-shell,
      html:not([data-vt-active="true"]).theme-switching .glass-nav,
      html:not([data-vt-active="true"]).theme-switching .surface-card,
      html:not([data-vt-active="true"]).theme-switching .stat-card {
        transition-property: background-color, color, border-color !important;
        transition-duration: 380ms !important;
        transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;
      }

      /* ── 全局图片/图表查看器（宣纸绫裱画框 FLIP · 零 filter:blur 拖尾 · 双层交叉切图） ── */
      .image-viewer-overlay,
      .image-viewer-overlay.is-open {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        background: rgba(246, 243, 237, 0.94) !important;
        transition:
          opacity 360ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0ms linear 0ms !important;
      }

      .image-viewer-overlay:not(.is-open) {
        transition:
          opacity 280ms cubic-bezier(0.32, 0, 0.2, 1),
          visibility 0ms linear 280ms !important;
      }

      [data-theme="dark"] .image-viewer-overlay,
      [data-theme="dark"] .image-viewer-overlay.is-open {
        background: rgba(16, 16, 16, 0.94) !important;
      }

      [data-theme="moss"] .image-viewer-overlay,
      [data-theme="moss"] .image-viewer-overlay.is-open {
        background: rgba(0, 77, 64, 0.94) !important;
      }

      [data-theme="rice"] .image-viewer-overlay,
      [data-theme="rice"] .image-viewer-overlay.is-open {
        background: rgba(242, 233, 216, 0.95) !important;
      }

      .image-viewer-shell {
        filter: none !important;
        border-radius: 10px !important;
        background: var(--bg-elev, #fcfaf8) !important;
        border: 1px solid var(--rule-strong) !important;
      }

      /* 宣纸绫裱四角包边纹饰 */
      .image-viewer-silk-corners {
        position: absolute;
        inset: 6px;
        pointer-events: none;
        z-index: 2;
        border-radius: 6px;
        background:
          linear-gradient(90deg, var(--ink, #222222) 12px, transparent 12px) 0 0 / 100% 1.5px no-repeat,
          linear-gradient(180deg, var(--ink, #222222) 12px, transparent 12px) 0 0 / 1.5px 100% no-repeat,
          linear-gradient(270deg, var(--ink, #222222) 12px, transparent 12px) 100% 100% / 100% 1.5px no-repeat,
          linear-gradient(0deg, var(--ink, #222222) 12px, transparent 12px) 100% 100% / 1.5px 100% no-repeat;
        opacity: 0.42;
      }

      [data-theme="dark"] .image-viewer-silk-corners {
        opacity: 0.42;
      }

      [data-theme="moss"] .image-viewer-silk-corners {
        background:
          linear-gradient(90deg, #ffc2d1 12px, transparent 12px) 0 0 / 100% 1.5px no-repeat,
          linear-gradient(180deg, #ffc2d1 12px, transparent 12px) 0 0 / 1.5px 100% no-repeat,
          linear-gradient(270deg, #ffc2d1 12px, transparent 12px) 100% 100% / 100% 1.5px no-repeat,
          linear-gradient(0deg, #ffc2d1 12px, transparent 12px) 100% 100% / 1.5px 100% no-repeat;
        opacity: 0.58;
      }

      .image-viewer-viewport {
        position: relative !important;
      }

      .image-viewer-media {
        filter: none !important;
        transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1) !important;
      }

      .image-viewer-media-ghost {
        position: absolute !important;
        inset: 0;
        margin: auto !important;
        pointer-events: none !important;
        z-index: 1;
        will-change: transform, opacity;
      }

      @media (prefers-reduced-motion: reduce) {
        .image-viewer-overlay,
        .image-viewer-overlay.is-open,
        .image-viewer-media,
        .theme-switch-ink-ring,
        .ink-ripple-halo {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>
