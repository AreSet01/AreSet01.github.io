          }

          const sourceRect = previewSourceEl.getBoundingClientRect();
          const modalRect = modal.getBoundingClientRect();
          const rawX = sourceRect.left + sourceRect.width / 2 - window.innerWidth / 2;
          const rawY = sourceRect.top + sourceRect.height / 2 - window.innerHeight / 2;
          const modalW = Math.max(modalRect.width || 720, 1);
