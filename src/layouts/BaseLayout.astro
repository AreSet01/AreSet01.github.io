        function setSearchCategory(nextCat, resetActive = true) {
          searchSelectedCategory = nextCat || 'all';
          if (searchInput) {
            const trimmed = searchInput.value.trimStart();
            if (nextCat !== 'commands' && (trimmed.startsWith('>') || trimmed.startsWith('＞'))) {
              searchInput.value = trimmed.slice(1).trimStart();
            }
          }
          updateSearchResults(resetActive);
        }

        function executeCommandAction(actionId) {
          if (!actionId) return false;
          if (actionId.startsWith('theme:')) {
            const targetTheme = actionId.slice(6);
            closeSearch(false);
            window.setTimeout(() => {
              const toggleBtn = document.querySelector('[data-theme-toggle]');
              if (typeof window.__transitionTheme === 'function') {
                window.__transitionTheme(targetTheme, toggleBtn);
              } else if (typeof window.__applyTheme === 'function') {
                window.__applyTheme(targetTheme);
              }
            }, 80);
            return true;
          }

          if (actionId === 'shell:toggle-font') {
            const cur = document.documentElement.getAttribute('data-font') === 'kai' ? 'kai' : 'pixel';
            const next = cur === 'kai' ? 'pixel' : 'kai';
            closeSearch(false);
            window.setTimeout(() => {
              const fontBtn = document.querySelector('[data-font-toggle]');
              if (typeof window.__transitionFont === 'function') {
                window.__transitionFont(next, fontBtn);
              } else if (fontBtn instanceof HTMLElement) {
                fontBtn.click();
              }
            }, 80);
            return true;
          }

          if (actionId === 'shell:toggle-trail') {
            closeSearch(false);
            const trailBtn = document.querySelector('[data-cursor-trail-toggle]');
            if (trailBtn instanceof HTMLElement) trailBtn.click();
            return true;
          }

          if (actionId === 'shell:toggle-sound') {
            closeSearch(false);
            window.setTimeout(() => {
              const soundBtn = document.querySelector('[data-zen-sound-toggle]');
              if (soundBtn instanceof HTMLElement) soundBtn.click();
            }, 90);
            return true;
          }

          if (actionId === 'shell:replay-intro') {
            closeSearch(false);
            const url = new URL(window.location.href);
            url.searchParams.set('intro', '1');
            window.location.assign(url.pathname + url.search + url.hash);
            return true;
          }

          if (actionId === 'article:bookmark') {
            closeSearch(false);
            window.setTimeout(() => {
              window.__readingBookmarks?.bookmarkSelection?.();
            }, 80);
            return true;
          }

          if (actionId === 'article:open-bookmarks') {
            closeSearch(false);
            window.setTimeout(() => {
              window.__readingBookmarks?.openPopover?.();
            }, 90);
            return true;
          }

          if (actionId === 'article:search') {
            closeSearch(false);
            window.setTimeout(() => {
              if (window.__articleSearch && typeof window.__articleSearch.open === 'function') {
                window.__articleSearch.open();
              } else {
                const btn = document.querySelector('[data-article-search-trigger]');
                if (btn instanceof HTMLElement) btn.click();
              }
            }, 90);
            return true;
          }

          if (actionId === 'article:notes-drawer') {
            closeSearch(false);
            window.setTimeout(() => {
              if (window.__articleNotes && typeof window.__articleNotes.openDrawer === 'function') {
                window.__articleNotes.openDrawer();
              } else {
                const btn = document.querySelector('[data-article-notes-trigger]');
                if (btn instanceof HTMLElement) btn.click();
              }
            }, 90);
            return true;
          }

          return false;
        }

        function tryHandleSamePageJump(href) {
          if (!href) return false;
          try {
            const targetUrl = new URL(href, window.location.origin);
            const cleanCurPath = window.location.pathname.replace(/\/+$/, '');
            const cleanTargetPath = targetUrl.pathname.replace(/\/+$/, '');
            if (cleanCurPath !== cleanTargetPath) return false;

            if (targetUrl.searchParams.get('resume') === '1' && window.__readingBookmarks?.resumeProgress) {
              closeSearch(false);
              window.setTimeout(() => window.__readingBookmarks.resumeProgress(), 80);
              return true;
            }
            const bmId = targetUrl.searchParams.get('bm');
            if (bmId && window.__readingBookmarks?.jumpToBookmark) {
              closeSearch(false);
              window.setTimeout(() => window.__readingBookmarks.jumpToBookmark(bmId), 80);
              return true;
            }
            const noteId = targetUrl.searchParams.get('noteId');
            if (noteId && window.__articleNotes?.jumpToHighlight) {
              closeSearch(false);
              window.setTimeout(() => window.__articleNotes.jumpToHighlight(noteId), 80);
              return true;
            }
          } catch {}
          return false;
        }

        function activateSearchResult(index, resultNode) {
          const item = searchResults[index];
          if (!item) return;
          if (item.actionId) {
            executeCommandAction(item.actionId);
            return;
          }
          if (item.href) {
            if (tryHandleSamePageJump(item.href)) return;
            closeSearch(false);
            if (resultNode instanceof HTMLAnchorElement) {
              return;
            }
            const anchor = searchResultsEl?.querySelector(`a[data-search-result][data-index="${index}"]`);
            if (anchor instanceof HTMLAnchorElement) {
              anchor.click();
            } else {
              window.location.assign(item.href);
            }
          }
        }

        function renderSearchResults(statusOverride) {
          if (!searchResultsEl || !searchInput) return;

          const rawQuery = searchInput.value.trim();

          if (searchState === 'loading' && !searchResults.length) {
            setSearchStatus('正在整理搜索索引...');
            searchResultsEl.innerHTML = `
              <div class="search-empty">
                <p>正在装载全站书目与知识索引…</p>
              </div>
            `;
            return;
          }

          if (searchState === 'error' && !searchResults.length) {
            setSearchStatus('搜索索引加载失败。');
            searchResultsEl.innerHTML = `
              <div class="search-empty">
                <p>暂时无法加载文章索引，你仍可切换至「笔记」「导图」或「指令」使用。</p>
              </div>
            `;
            return;
          }

          if (statusOverride) {
            setSearchStatus(statusOverride);
          }

          if (!searchResults.length) {
            if (!statusOverride) {
              setSearchStatus(rawQuery ? '未找到匹配项' : '暂无内容');
            }
            searchResultsEl.innerHTML = `
              <div class="search-empty">
                <p>${rawQuery ? '换个关键词试试，或按 Tab 切换分类、输入 > 执行快捷指令。' : '当前分类下暂无记录。'}</p>
              </div>
            `;
            return;
          }

          let lastSection = '';
          searchResultsEl.innerHTML = searchResults.map((item, index) => {
            const summary = item.summary || item.description || item.excerpt || '';
            const chipsHtml = (item.chips || item.tags || [])
              .slice(0, 3)
              .map((tag) => `<span class="search-chip">${escapeHtml(tag)}</span>`)
              .join('');

            const showSection = Boolean(!rawQuery && item.sectionLabel && item.sectionLabel !== lastSection);
            if (showSection) lastSection = item.sectionLabel;
            const sectionHeaderHtml = showSection
              ? `<div class="search-section-header" role="presentation">${escapeHtml(item.sectionLabel)}</div>`
              : '';

            const badgeHtml = item.badge
              ? `<span class="search-kind-badge" data-tone="${escapeHtml(item.badgeTone || 'muted')}">${escapeHtml(item.badge)}</span>`
              : '';

            const progressHtml = typeof item.progressRatio === 'number'
              ? `<div class="search-resume-track" aria-hidden="true"><span class="search-resume-fill" style="transform:scaleX(${Math.max(0.03, Math.min(1, item.progressRatio)).toFixed(3)})"></span></div>`
              : '';

            const metaRight = item.metaRight || item.dateLabel || (item.slug ? `/${item.slug}` : '');
            const isCommandBtn = Boolean(item.actionId && !item.href);

            const innerHtml = `
              <div class="search-result-top">
                <div class="search-result-title-row">
                  ${badgeHtml}
                  <p class="search-result-title">${escapeHtml(item.title)}</p>
                </div>
                <span class="search-result-date">${escapeHtml(metaRight)}</span>
              </div>
              <p class="search-result-summary">${escapeHtml(summary)}</p>
              ${progressHtml}
              ${chipsHtml ? `<div class="search-result-meta"><div class="search-chip-group">${chipsHtml}</div></div>` : ''}
            `;

            if (isCommandBtn) {
              return `
                ${sectionHeaderHtml}
                <button
                  type="button"
                  class="search-result search-result-btn${index === searchActiveIndex ? ' is-active' : ''}"
                  data-search-result
                  data-index="${index}"
                  data-kind="${escapeHtml(item.kind || 'command')}"
                  style="--i: ${Math.min(index, 8)}"
                  aria-selected="${index === searchActiveIndex ? 'true' : 'false'}"
                >
                  ${innerHtml}
                </button>
              `;
            }

            return `
              ${sectionHeaderHtml}
              <a
                href="${escapeHtml(item.href || '#')}"
                class="search-result${index === searchActiveIndex ? ' is-active' : ''}"
                data-search-result
                data-index="${index}"
                data-kind="${escapeHtml(item.kind || 'post')}"
                style="--i: ${Math.min(index, 8)}"
                aria-selected="${index === searchActiveIndex ? 'true' : 'false'}"
              >
                ${innerHtml}
              </a>
            `;
          }).join('');
        }

        function scoreSearchItem(item, fullQuery, tokens) {
          let score = 0;
          const { titleText, descriptionText, excerptText, contentText, tagsText, slugText } = item._search;

          if (titleText.includes(fullQuery)) score += 120 - Math.min(titleText.indexOf(fullQuery), 40);
          if (tagsText.includes(fullQuery)) score += 72 - Math.min(tagsText.indexOf(fullQuery), 30);
          if (descriptionText.includes(fullQuery)) score += 46 - Math.min(descriptionText.indexOf(fullQuery), 24);
          if (excerptText.includes(fullQuery)) score += 24;
          if (contentText && contentText.includes(fullQuery)) score += 28;
          if (slugText.includes(fullQuery)) score += 18;

          for (const token of tokens) {
            if (!token) continue;
            if (titleText.includes(token)) score += 34;
            if (tagsText.includes(token)) score += 20;
            if (descriptionText.includes(token)) score += 12;
            if (excerptText.includes(token)) score += 8;
            if (contentText && contentText.includes(token)) score += 8;
            if (slugText.includes(token)) score += 6;
          }

          return score;
        }

        function updateSearchResults(resetActive = true, immediateGlider = false) {
          if (!searchInput) return;

          const bridge = window.__commandPaletteBridge;
          let statusMessage = '';
          let effectiveCat = searchSelectedCategory;

          if (bridge && typeof bridge.runQuery === 'function') {
            const out = bridge.runQuery(searchInput.value, searchSelectedCategory, searchItems);
            searchResults = out.items;
            statusMessage = out.statusText;
            effectiveCat = out.effectiveCategory;
            if (searchOverlay) {
              searchOverlay.setAttribute('data-prefix-mode', out.isCommandPrefix ? 'true' : 'false');
            }
          } else {
            const fullQuery = normalizeSearchText(searchInput.value);
            const tokens = fullQuery.split(/\s+/).filter(Boolean);
            if (!fullQuery) {
              searchResults = searchItems.slice(0, 6);
            } else {
              searchResults = searchItems
                .map((item) => ({
                  item,
                  score: scoreSearchItem(item, fullQuery, tokens),
                }))
                .filter((entry) => entry.score > 0)
                .sort((left, right) => right.score - left.score || right.item.publishedAt - left.item.publishedAt)
                .slice(0, 8)
                .map((entry) => entry.item);
            }
            statusMessage = fullQuery ? `找到 ${searchResults.length} 篇相关文章` : '最近更新';
          }

          syncSearchTabGlider(effectiveCat, immediateGlider);

          if (resetActive) {
            searchActiveIndex = searchResults.length ? 0 : -1;
          } else if (searchActiveIndex >= searchResults.length) {
            searchActiveIndex = searchResults.length ? searchResults.length - 1 : -1;
          }

          if (searchState !== 'loading' || searchResults.length > 0) {
            searchState = 'ready';
          }
          renderSearchResults(statusMessage);
        }

        function ensureSearchIndex(force = false) {
          if (!searchReady) return Promise.resolve([]);
          if (searchItems.length && !force) {
            updateSearchResults();
            return Promise.resolve(searchItems);
          }

          if (searchIndexPromise && !force) return searchIndexPromise;

          searchState = 'loading';
          renderSearchResults();

          const cacheBuster = `_t=${Date.now()}`;
          const fetchUrl = searchIndexUrl.includes('?')
            ? `${searchIndexUrl}&${cacheBuster}`
            : `${searchIndexUrl}?${cacheBuster}`;

          searchIndexPromise = fetch(fetchUrl, {
            cache: 'no-store',
            headers: {
              'Cache-Control': 'no-cache, no-store, must-revalidate',
              'Pragma': 'no-cache',
            },
          })
            .then((response) => {
              if (!response.ok) throw new Error(`HTTP ${response.status}`);
              return response.json();
            })
            .then((items) => {
              searchItems = Array.isArray(items) ? items.map(buildSearchIndexEntry) : [];
              searchIndexPromise = null;
              updateSearchResults(false);
              return searchItems;
            })
            .catch((error) => {
              searchIndexPromise = null;
              searchState = 'error';
              renderSearchResults();
              throw error;
            });

          return searchIndexPromise;
        }

        function openSearch(sourceEl) {
          if (!searchReady) return;
          if (searchOverlay.classList.contains('is-open')) {
            searchInput.focus({ preventScroll: true });
            searchInput.select();
            return;
          }

          if (overlay.classList.contains('is-open')) {
            closePreview();
            window.setTimeout(() => openSearch(sourceEl), prefersReducedMotion ? 0 : 220);
            return;
          }

          clearSearchCloseTimer();
          searchSourceEl = sourceEl instanceof HTMLElement ? sourceEl : null;
          syncScrollbarOffset();
          if (window.lenis) window.lenis.stop();
          document.body.classList.add('search-lock');
          searchOverlay.setAttribute('aria-hidden', 'false');
          updateSearchResults(true, true);

          requestAnimationFrame(() => {
            searchOverlay.classList.add('is-open');
            document.body.classList.add('search-open');
            notifyModalState('search', true);
            syncSearchTabGlider(undefined, true);
            animateSearchModal(true);
          });

          // In dev mode, always refresh so article edits/deletions reflect immediately
          ensureSearchIndex(Boolean(isDev)).catch(() => {});

          window.setTimeout(() => {
            searchInput.focus({ preventScroll: true });
            searchInput.select();
          }, prefersReducedMotion ? 0 : 120);
        }

        function closeSearch(restoreFocus = true) {
          if (!searchReady || !searchOverlay.classList.contains('is-open')) return;

          clearSearchCloseTimer();
          searchOverlay.classList.remove('is-open');
          document.body.classList.remove('search-open');

          const finishSearchClose = () => {
            document.body.classList.remove('search-lock');
            searchOverlay.setAttribute('aria-hidden', 'true');
            syncScrollbarOffset();

            if (restoreFocus && searchSourceEl instanceof HTMLElement && searchSourceEl.isConnected) {
              searchSourceEl.focus({ preventScroll: true });
            }

            if (window.lenis) window.lenis.start();
            searchSourceEl = null;
            searchCloseTimer = 0;
            notifyModalState('search', false);
          };

          if (prefersReducedMotion) {
            finishSearchClose();
            return;
          }

          animateSearchModal(false);
          searchCloseTimer = window.setTimeout(finishSearchClose, 380);
        }

        // The palette unfolds from wherever it was summoned (the sidebar field, or top-centre
        // for the keyboard shortcut) and folds back there on close. Transform + opacity only.
        function animateSearchModal(opening) {
          const modalEl = searchOverlay?.querySelector('.search-modal');
          if (!modalEl || !window.gsap || prefersReducedMotion) return;

          const modalRect = modalEl.getBoundingClientRect();
          let x = 0;
          let y = -36;
          let scaleX = 0.92;
          let scaleY = 0.86;
          if (searchSourceEl instanceof Element && searchSourceEl.isConnected) {
            const src = searchSourceEl.getBoundingClientRect();
            if (src.width > 0 && src.height > 0) {
              x = src.left + src.width / 2 - (modalRect.left + modalRect.width / 2);
              y = src.top + src.height / 2 - (modalRect.top + modalRect.height / 2);
              scaleX = Math.max(0.18, src.width / Math.max(modalRect.width, 1));
              scaleY = Math.max(0.06, src.height / Math.max(modalRect.height, 1));
            }
          }

          window.gsap.killTweensOf(modalEl);
          if (opening) {
            window.gsap.fromTo(modalEl,
              { x, y, scaleX, scaleY, opacity: 0 },
              { x: 0, y: 0, scaleX: 1, scaleY: 1, opacity: 1, duration: 0.82, ease: 'ink', overwrite: true,
                clearProps: 'transform,opacity' }
            );
          } else {
            window.gsap.to(modalEl, {
              x, y, scaleX, scaleY, opacity: 0, duration: 0.34, ease: 'power3.in', overwrite: true,
              onComplete: () => window.gsap.set(modalEl, { clearProps: 'transform,opacity' }),
            });
          }
        }

        function releaseAnimation(animation) {
          if (!animation) return;
          animation.onfinish = null;
          animation.oncancel = null;
          animation.cancel();
        }

        function stopImageViewerAnimations() {
          releaseAnimation(imageViewerOverlayAnimation);
          releaseAnimation(imageViewerShellAnimation);
          imageViewerOverlayAnimation = null;
          imageViewerShellAnimation = null;
        }

        function resetImageViewerMotion() {
          imageViewerMotion = {
            startX: 0,
            startY: 18,
            startScaleX: 0.86,
            startScaleY: 0.82,
            pinchScaleX: 0.68,
            pinchScaleY: 1.01,
            driftX: 0,
            driftY: -8,
            overshootScaleX: 1.01,
            overshootScaleY: 0.992,
          };
        }

        function setImageViewerMotion(sourceEl) {
          if (!(sourceEl instanceof Element) || !sourceEl.isConnected) {
            resetImageViewerMotion();
            return;
          }

          const sourceRect = sourceEl.getBoundingClientRect();
          const shellRect = imageViewerShell.getBoundingClientRect();
          if (sourceRect.width <= 0 || sourceRect.height <= 0 || shellRect.width <= 0 || shellRect.height <= 0) {
            resetImageViewerMotion();
            return;
          }

          const shellCenterX = shellRect.left + shellRect.width / 2;
          const shellCenterY = shellRect.top + shellRect.height / 2;
          const startX = sourceRect.left + sourceRect.width / 2 - shellCenterX;
          const startY = sourceRect.top + sourceRect.height / 2 - shellCenterY;
          const scaleRatioX = Math.max(0.14, Math.min(1.08, sourceRect.width / Math.max(shellRect.width, 1)));
          const scaleRatioY = Math.max(0.14, Math.min(1.08, sourceRect.height / Math.max(shellRect.height, 1)));
          // Blend uniform & aspect ratios so the silk frame never distorts typography while honoring exact FLIP origin
          const uniformRatio = Math.sqrt(scaleRatioX * scaleRatioY);
          const startScaleX = uniformRatio * 0.65 + scaleRatioX * 0.35;
          const startScaleY = uniformRatio * 0.65 + scaleRatioY * 0.35;

          imageViewerMotion = {
            startX,
            startY,
            startScaleX,
            startScaleY,
            pinchScaleX: startScaleX,
            pinchScaleY: startScaleY,
            driftX: 0,
            driftY: 0,
            overshootScaleX: 1,
            overshootScaleY: 1,
          };
        }

        function applyImageViewerStartStyles() {
          const { startX, startY, startScaleX, startScaleY } = imageViewerMotion;
          imageOverlay.style.opacity = '0';
          imageViewerShell.style.willChange = 'transform, opacity';
          imageViewerShell.style.transform = `translate3d(${startX}px, ${startY}px, 0) scale(${startScaleX}, ${startScaleY})`;
          imageViewerShell.style.opacity = '0';
        }

        function applyImageViewerOpenStyles() {
          imageOverlay.style.opacity = '1';
          imageViewerShell.style.transform = 'translate3d(0, 0, 0) scale(1, 1)';
          imageViewerShell.style.opacity = '1';
          imageViewerShell.style.removeProperty('will-change');
        }

        function clearImageViewerInlineStyles() {
          imageOverlay.style.removeProperty('opacity');
          imageViewerShell.style.removeProperty('transform');
          imageViewerShell.style.removeProperty('opacity');
          imageViewerShell.style.removeProperty('will-change');
        }

        // 宣纸绫裱画框 FLIP 展开 (~520ms 展开 / ~360ms 收拢，宣纸衬底纯 opacity 渐显，彻底根除 filter:blur 拖尾掉帧)
        const VIEWER_OPEN_MS = 520;
        const VIEWER_BACKDROP_OPEN_MS = 380;
        const VIEWER_CLOSE_MS = 360;
        const VIEWER_BACKDROP_CLOSE_MS = 280;

        function animateImageViewerOpen() {
          stopImageViewerAnimations();

          if (prefersReducedMotion) {
            applyImageViewerOpenStyles();
            imageViewerState = 'open';
            return;
          }

          const { startX, startY, startScaleX, startScaleY } = imageViewerMotion;
          imageViewerState = 'opening';
          imageViewerShell.style.willChange = 'transform, opacity';

          if (typeof imageViewerShell.animate === 'function') {
            imageViewerOverlayAnimation = imageOverlay.animate(
              [{ opacity: 0 }, { opacity: 1 }],
              {
                duration: VIEWER_BACKDROP_OPEN_MS,
                easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                fill: 'both',
              }
            );

            imageViewerShellAnimation = imageViewerShell.animate(
              [
                {
                  transform: `translate3d(${startX}px, ${startY}px, 0) scale(${startScaleX}, ${startScaleY})`,
                  opacity: 0.16,
                },
                {
                  transform: 'translate3d(0, 0, 0) scale(1, 1)',
                  opacity: 1,
                },
              ],
              {
                duration: VIEWER_OPEN_MS,
                easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                fill: 'both',
              }
            );

            imageViewerOverlayAnimation.onfinish = () => {
              imageOverlay.style.opacity = '1';
              releaseAnimation(imageViewerOverlayAnimation);
              imageViewerOverlayAnimation = null;
            };

            imageViewerOverlayAnimation.oncancel = () => {
              imageViewerOverlayAnimation = null;
            };

            imageViewerShellAnimation.onfinish = () => {
              applyImageViewerOpenStyles();
              releaseAnimation(imageViewerShellAnimation);
              imageViewerShellAnimation = null;
              imageViewerState = 'open';
            };

            imageViewerShellAnimation.oncancel = () => {
              imageViewerShellAnimation = null;
            };
            return;
          }

          if (window.gsap) {
            window.gsap.killTweensOf([imageOverlay, imageViewerShell]);
            window.gsap.fromTo(imageOverlay, { opacity: 0 }, { opacity: 1, duration: VIEWER_BACKDROP_OPEN_MS / 1000, ease: 'power2.out' });
            window.gsap.fromTo(imageViewerShell,
              { x: startX, y: startY, scaleX: startScaleX, scaleY: startScaleY, opacity: 0.16 },
              { x: 0, y: 0, scaleX: 1, scaleY: 1, opacity: 1, duration: VIEWER_OPEN_MS / 1000, ease: 'paper-glide', onComplete: () => {
                applyImageViewerOpenStyles();
                imageViewerState = 'open';
              }}
            );
          }
        }

        function finishImageViewerClose(restoreFocusEl) {
          stopImageViewerAnimations();
          imageViewerViewport?.querySelectorAll('.image-viewer-media-ghost').forEach((g) => g.remove());
          imageOverlay.classList.remove('is-open');
          document.body.classList.remove('image-view-open');
          imageViewerCaption.hidden = true;
          syncScrollbarOffset();
          clearImageViewerInlineStyles();
          restoreSourceImageHidden();
          resetImageViewerMotion();
          imageViewerState = 'closed';
          imageViewerSourceEl = null;
          notifyModalState('imageViewer', false);
          if (window.lenis) window.lenis.start();

          if (restoreFocusEl instanceof HTMLElement && restoreFocusEl.isConnected && restoreFocusEl.tabIndex >= 0) {
            restoreFocusEl.focus({ preventScroll: true });
          }
        }

        function closeImageViewer() {
          if (!imageOverlay.classList.contains('is-open') || imageViewerState === 'closing') return;

          const restoreFocusEl = imageViewerSourceEl;
          stopImageViewerAnimations();

          if (prefersReducedMotion) {
            finishImageViewerClose(restoreFocusEl);
            return;
          }

          // Re-measure current active gallery image so closing after stepping flies back to the right frame
          if (imageViewerSourceEl instanceof Element && imageViewerSourceEl.isConnected) {
            setImageViewerMotion(imageViewerSourceEl);
          }
          const { startX, startY, startScaleX, startScaleY } = imageViewerMotion;

          imageViewerState = 'closing';
          applyImageViewerOpenStyles();
          imageViewerShell.style.willChange = 'transform, opacity';

          if (typeof imageViewerShell.animate === 'function') {
            imageViewerOverlayAnimation = imageOverlay.animate(
              [{ opacity: 1 }, { opacity: 0 }],
              {
                duration: VIEWER_BACKDROP_CLOSE_MS,
                easing: 'cubic-bezier(0.32, 0, 0.2, 1)',
                fill: 'both',
              }
            );

            imageViewerShellAnimation = imageViewerShell.animate(
              [
                {
