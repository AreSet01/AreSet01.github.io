            startY: 24,
            startScaleX: 0.92,
            startScaleY: 0.88,
            pinchScaleX: 0.7,
            pinchScaleY: 1.02,
            driftX: 0,
            driftY: -10,
            overshootScaleX: 1.018,
            overshootScaleY: 0.988,
