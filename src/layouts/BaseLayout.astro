          const startY = Math.max(-140, Math.min(140, rawY * 0.28 + 14));

          previewMotion = {
            startX,
            startY,
            startScaleX: startScale,
            startScaleY: startScale,
            pinchScaleX: startScale,
            pinchScaleY: startScale,
            driftX: 0,
            driftY: 0,
            overshootScaleX: 1,
            overshootScaleY: 1,
