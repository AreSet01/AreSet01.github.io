            if (event.key === '-' || event.key === '_') {
              event.preventDefault();
              setViewerZoom(viewerScale - 0.25, true);
              return;
            }
            if (event.key === '0') {
              event.preventDefault();
              setViewerZoom(1, true);
              return;
            }
            if (event.key === 'Escape') {
              closeImageViewer();
              return;
            }
          }

          if (overlay.classList.contains('is-open')) {
            if (event.key === 'Tab') {
