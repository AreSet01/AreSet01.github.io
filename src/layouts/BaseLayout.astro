---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { ClientRouter } from 'astro:transitions';
import SiteIntro from '../components/SiteIntro.astro';
import PostTransition from '../components/PostTransition.astro';
import ZenSoundscape from '../components/ZenSoundscape.astro';
import ZenRainscape from '../components/ZenRainscape.astro';

const buildVersion =
  (import.meta.env as Record<string, string | undefined>).PUBLIC_APP_BUILD_VERSION ||
  process.env.PUBLIC_APP_BUILD_VERSION ||
  Date.now().toString(36);
const searchIndexPath = `${import.meta.env.BASE_URL ?? '/'}search-index.json?v=${buildVersion}`;

interface Props {
  title: string;
  description?: string;
  standalone?: boolean;
}

const {
  title,
  description = '梦付千秋 - 日常记录与技术分享',
  standalone = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="app-build-version" content={buildVersion} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
    <meta name="baiduspider" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="bingbot" content="noindex, nofollow, noarchive, nosnippet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Ma+Shan+Zheng&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Ma+Shan+Zheng&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      />
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-webfont@1.7.0/style.css"
      />
    </noscript>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      (function(){
        var VALID_MOSS_SHADES = ['004D40', '00695C', '00796B', '00897B', '4DB6AC'];
        function getStoredMossShade() {
          try {
            var raw = new URLSearchParams(window.location.search).get('moss-shade') ||
                           new URLSearchParams(window.location.search).get('shade');
            if (raw) {
              var clean = raw.trim().replace(/^#/, '').toUpperCase();
              if (clean === 'DEFAULT' || clean === 'RESET') {
                localStorage.removeItem('moss-shade');
                return null;
              }
              if (VALID_MOSS_SHADES.indexOf(clean) !== -1) {
                try { localStorage.setItem('moss-shade', clean); } catch (err) {}
                return clean;
              }
            }
            var stored = localStorage.getItem('moss-shade');
            if (stored) {
              var normStored = stored.trim().replace(/^#/, '').toUpperCase();
              return VALID_MOSS_SHADES.indexOf(normStored) !== -1 ? normStored : null;
            }
            return null;
          } catch (e) {
            return null;
          }
        }

        var VALID_THEMES = ['dark', 'light', 'moss', 'rice'];
        var LIGHT_THEMES = ['light', 'rice'];
        var runtimeKey = '__areSetThemeRuntimeBound__';
        var themeTransitionTimer = 0;

        function isValidTheme(value) {
          return typeof value === 'string' && VALID_THEMES.indexOf(value) !== -1;
        }

        function getStoredTheme() {
          try {
            var stored = localStorage.getItem('theme');
            return isValidTheme(stored) ? stored : null;
          } catch (error) {
            return null;
          }
        }

        function resolveTheme(explicitTheme) {
          if (isValidTheme(explicitTheme)) return explicitTheme;
          var storedTheme = getStoredTheme();
          if (storedTheme) return storedTheme;
          return window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
        }

        // Hide [data-enter] elements before first paint so the enter choreography can reveal them
        document.documentElement.classList.add('js-enter');
        try {
          var preTheme = resolveTheme();
          if (preTheme) {
            document.documentElement.setAttribute('data-theme', preTheme);
          }
          if (localStorage.getItem('sidebar-collapsed') === 'true') {
            document.documentElement.setAttribute('data-sidebar-collapsed', 'true');
          }
          if (localStorage.getItem('pixel-mode') === 'true') {
            document.documentElement.setAttribute('data-pixel', 'true');
          }
          if (localStorage.getItem('cursor-trail') === 'disabled') {
            document.documentElement.setAttribute('data-cursor-trail', 'disabled');
          }
          // Pre-paint so the 行楷 face is never a flash of pixel type on first load
          if (localStorage.getItem('site-font') === 'kai') {
            document.documentElement.setAttribute('data-font', 'kai');
          }
          var preShade = getStoredMossShade();
          if (preShade) {
            document.documentElement.setAttribute('data-moss-shade', preShade);
          }
        } catch (e) {}

        function syncThemeColor(theme) {
          var meta = document.querySelector('meta[name="theme-color"]');
          var mossShade = document.documentElement.getAttribute('data-moss-shade');
          var barColor =
            theme === 'dark' ? '#0a0a0a' :
            theme === 'moss' ? (mossShade ? '#' + mossShade : '#00796B') :
            theme === 'rice' ? '#F2E9D8' : '#ffffff';
          if (meta) meta.setAttribute('content', barColor);
          document.documentElement.style.colorScheme =
            LIGHT_THEMES.indexOf(theme) !== -1 ? 'light' : 'dark';
        }

        function syncGiscusTheme(theme) {
          var giscusTheme = LIGHT_THEMES.indexOf(theme) !== -1 ? 'light' : 'dark_dimmed';
          var script = document.querySelector('script[src="https://giscus.app/client.js"]');
          if (script) script.setAttribute('data-theme', giscusTheme);

          var frame = document.querySelector('iframe.giscus-frame');
          if (frame && frame.contentWindow) {
            frame.contentWindow.postMessage(
              { giscus: { setConfig: { theme: giscusTheme } } },
              'https://giscus.app'
            );
          }
        }

        function markThemeSwitching() {
          document.documentElement.classList.add('theme-switching');
          window.clearTimeout(themeTransitionTimer);
          themeTransitionTimer = window.setTimeout(function() {
            document.documentElement.classList.remove('theme-switching');
            document.documentElement.removeAttribute('data-vt-active');
          }, 860);
        }

        /* 主题/字形切换水墨晕环：纯 GPU transform + opacity，零 blur 零紫边 */
        function spawnThemeInkRipple(x, y, nextTheme) {
          try {
            if (!document.body) return;
            var oldRing = document.getElementById('theme-switch-ink-ring');
            if (oldRing) oldRing.remove();
            var ring = document.createElement('div');
            ring.id = 'theme-switch-ink-ring';
            ring.className = 'theme-switch-ink-ring';
            ring.setAttribute('data-theme-ink-ring', nextTheme || 'ink');
            ring.style.left = Math.round(x) + 'px';
            ring.style.top = Math.round(y) + 'px';
            var maxR = Math.hypot(
              Math.max(x, window.innerWidth - x),
              Math.max(y, window.innerHeight - y)
            );
            var size = Math.max(48, Math.round(maxR * 2));
            ring.style.width = size + 'px';
            ring.style.height = size + 'px';
            document.body.appendChild(ring);
            if (typeof ring.animate === 'function') {
              var anim = ring.animate(
                [
                  { transform: 'translate3d(-50%, -50%, 0) scale(0.02)', opacity: 0.62 },
                  { transform: 'translate3d(-50%, -50%, 0) scale(0.62)', opacity: 0.32, offset: 0.58 },
                  { transform: 'translate3d(-50%, -50%, 0) scale(1.04)', opacity: 0 },
                ],
                { duration: 700, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' }
              );
              anim.onfinish = function() { ring.remove(); };
            } else {
              window.setTimeout(function() { ring.remove(); }, 720);
            }
          } catch (err) {}
        }

        function applyTheme(explicitTheme) {
          var nextTheme = resolveTheme(explicitTheme);
          if (isValidTheme(explicitTheme)) {
            try { localStorage.setItem('theme', explicitTheme); } catch (e) {}
          }
          document.documentElement.setAttribute('data-theme', nextTheme);
          var shade = getStoredMossShade();
          if (nextTheme === 'moss' && shade) {
            document.documentElement.setAttribute('data-moss-shade', shade);
          } else {
            document.documentElement.removeAttribute('data-moss-shade');
          }
          syncThemeColor(nextTheme);

          requestAnimationFrame(function() { syncGiscusTheme(nextTheme); });
          window.setTimeout(function() { syncGiscusTheme(nextTheme); }, 180);
          window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: nextTheme } }));
          return nextTheme;
        }

        function setMossShade(shade) {
          try {
            if (shade) {
              var clean = shade.trim().replace(/^#/, '').toUpperCase();
              if (VALID_MOSS_SHADES.indexOf(clean) !== -1) {
                localStorage.setItem('moss-shade', clean);
              }
            } else {
              localStorage.removeItem('moss-shade');
            }
          } catch (e) {}
          applyTheme('moss');
        }

        /* ---------- 字体：像素体 ⇄ 行楷 ---------- */

        function getStoredFont() {
          try {
            var stored = localStorage.getItem('site-font');
            return stored === 'kai' || stored === 'pixel' ? stored : null;
          } catch (error) {
            return null;
          }
        }

        function applyFont(explicitFont) {
          var nextFont = explicitFont === 'kai' || explicitFont === 'pixel'
            ? explicitFont
            : (getStoredFont() || 'pixel');

          if (explicitFont === 'kai' || explicitFont === 'pixel') {
            try { localStorage.setItem('site-font', explicitFont); } catch (e) {}
          }

          if (nextFont === 'kai') {
            document.documentElement.setAttribute('data-font', 'kai');
          } else {
            document.documentElement.removeAttribute('data-font');
          }
          window.dispatchEvent(new CustomEvent('font-change', { detail: { font: nextFont } }));
          return nextFont;
        }

        /* Swapping the face reflows every line on the page, and a hard reflow reads as a
           snap. Wash it the way the theme switch is washed — the ink-bleed vocabulary the
           rest of the site uses — rather than cross-fading the whole document. */
        function transitionFont(nextFont, sourceEl) {
          var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (
            prefersReducedMotion ||
            !sourceEl ||
            typeof document.startViewTransition !== 'function'
          ) {
            applyFont(nextFont);
            return;
          }

          if (sourceEl && typeof sourceEl.blur === 'function') {
            sourceEl.blur();
          }
          if (typeof window.__clearCursorTrail === 'function') {
            window.__clearCursorTrail();
          }

          var rect = sourceEl.getBoundingClientRect();
          var x = rect.left + rect.width / 2;
          var y = rect.top + rect.height / 2;
          var endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y)
          );

          try {
            document.documentElement.setAttribute('data-vt-active', 'true');
            spawnThemeInkRipple(x, y, 'font');
            var transition = document.startViewTransition(function() {
              applyFont(nextFont);
            });

            if (transition && transition.finished && typeof transition.finished.finally === 'function') {
              transition.finished.finally(function() {
                document.documentElement.removeAttribute('data-vt-active');
              });
            }

            if (transition && transition.ready && typeof transition.ready.then === 'function') {
              transition.ready
                .then(function() {
                  if (typeof document.documentElement.animate === 'function') {
                    document.documentElement.animate(
                      {
                        clipPath: [
                          'circle(12px at ' + x + 'px ' + y + 'px)',
                          'circle(' + endRadius + 'px at ' + x + 'px ' + y + 'px)',
                        ],
                      },
                      {
                        duration: 640,
                        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                        pseudoElement: '::view-transition-new(root)',
                      }
                    );
                  }
                })
                .catch(function() {
                  document.documentElement.removeAttribute('data-vt-active');
                });
            }
          } catch (e) {
            document.documentElement.removeAttribute('data-vt-active');
            applyFont(nextFont);
          }
        }

        function transitionTheme(nextTheme, sourceEl) {
          var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (
            prefersReducedMotion ||
            !sourceEl ||
            typeof document.startViewTransition !== 'function'
          ) {
            markThemeSwitching();
            applyTheme(nextTheme);
            return;
          }

          if (sourceEl && typeof sourceEl.blur === 'function') {
            sourceEl.blur();
          }
          if (typeof window.__clearCursorTrail === 'function') {
            window.__clearCursorTrail();
          }

          var rect = sourceEl.getBoundingClientRect();
          var x = rect.left + rect.width / 2;
          var y = rect.top + rect.height / 2;
          var endRadius = Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y)
          );

          try {
            document.documentElement.setAttribute('data-vt-active', 'true');
            spawnThemeInkRipple(x, y, nextTheme);
            var transition = document.startViewTransition(function() {
              markThemeSwitching();
              applyTheme(nextTheme);
            });

            if (transition && transition.finished && typeof transition.finished.finally === 'function') {
              transition.finished.finally(function() {
                document.documentElement.removeAttribute('data-vt-active');
              });
            }

            if (transition && transition.ready && typeof transition.ready.then === 'function') {
              transition.ready
                .then(function() {
                  if (typeof document.documentElement.animate === 'function') {
                    document.documentElement.animate(
                      {
                        clipPath: [
                          'circle(12px at ' + x + 'px ' + y + 'px)',
                          'circle(' + endRadius + 'px at ' + x + 'px ' + y + 'px)',
                        ],
                      },
                      {
                        duration: 680,
                        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                        pseudoElement: '::view-transition-new(root)',
                      }
                    );
                  }
                })
                .catch(function() {
                  document.documentElement.removeAttribute('data-vt-active');
                });
            }
          } catch (e) {
            document.documentElement.removeAttribute('data-vt-active');
            markThemeSwitching();
            applyTheme(nextTheme);
          }
        }

        window.__getPreferredTheme = resolveTheme;
        window.__applyTheme = applyTheme;
        window.__setMossShade = setMossShade;
        window.__transitionTheme = transitionTheme;
        window.__applyFont = applyFont;
        window.__transitionFont = transitionFont;
        applyTheme();
        applyFont();

        if (window[runtimeKey]) return;

        document.addEventListener('astro:before-swap', function(e) {
          try {
            var activeTheme = resolveTheme();
            if (e.newDocument && e.newDocument.documentElement) {
              if (activeTheme) e.newDocument.documentElement.setAttribute('data-theme', activeTheme);
              var shade = getStoredMossShade();
              if (activeTheme === 'moss' && shade) {
                e.newDocument.documentElement.setAttribute('data-moss-shade', shade);
              } else {
                e.newDocument.documentElement.removeAttribute('data-moss-shade');
              }
              var font = getStoredFont();
              if (font === 'kai') {
                e.newDocument.documentElement.setAttribute('data-font', 'kai');
              } else {
                e.newDocument.documentElement.removeAttribute('data-font');
              }
              if (localStorage.getItem('sidebar-collapsed') === 'true') {
                e.newDocument.documentElement.setAttribute('data-sidebar-collapsed', 'true');
              }
            }
          } catch (err) {}
        });

        document.addEventListener('astro:after-swap', function() {
          applyTheme();
          applyFont();
          try {
            if (localStorage.getItem('cursor-trail') === 'disabled') {
              document.documentElement.setAttribute('data-cursor-trail', 'disabled');
            } else {
              document.documentElement.removeAttribute('data-cursor-trail');
            }
          } catch (e) {}
        });

        document.addEventListener('astro:page-load', function() {
          applyTheme();
          applyFont();
        });

        var media = window.matchMedia('(prefers-color-scheme:dark)');
        if (media && typeof media.addEventListener === 'function') {
          media.addEventListener('change', function() {
            if (getStoredTheme()) return;
            applyTheme();
          });
        }

        window[runtimeKey] = true;
      })();
    </script>
    <script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL ?? '/' }}>
      (function(){
        // Decide the site-entry curtain before first paint, so a session that has already seen it
        // never flashes the overlay. The markup ships on every page but stays display:none until
        // html.site-intro-active is set here; SiteIntro.astro refuses to play without it.
        //
        // Once per browser session. Force a replay with ?intro=1 or #intro; the decision is
        // latched on window so client navigations (which re-run this script) can't re-arm it.
        if (window.__siteIntroDecided) return;
        window.__siteIntroDecided = true;

        var base = typeof baseUrl !== 'undefined' ? baseUrl : '/';
        var rawBase = (base || '/').replace(/\/$/, '');
        var curPath = (window.location.pathname || '/').replace(/\/index\.html$/, '').replace(/\/$/, '');
        var isHome = curPath === rawBase;
        if (!isHome) return;

        var isAboutIntroForced = /[?&]about-intro=1(&|$)/.test(location.search) ||
                                 location.hash === '#about-intro' ||
                                 /[?&]zen=1(&|$)/.test(location.search);
        if (isAboutIntroForced) return;

        var forced = /[?&]intro=1(&|$)/.test(location.search) || location.hash === '#intro';
        var seen = false;
        try { seen = sessionStorage.getItem('site-intro-seen') === '1'; } catch (e) {}
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!forced && (seen || reduced)) return;

        document.documentElement.classList.add('site-intro-active');
        window.__siteIntroPending = true;
        // Latched up front: refreshing mid-curtain should land on the page, not replay the curtain
        try { sessionStorage.setItem('site-intro-seen', '1'); } catch (e) {}
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">跳至主要内容</a>
    <SiteIntro />
    <PostTransition />
    <canvas id="inkCanvas" transition:persist style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 2147483646;"></canvas>
    <div id="custom-cursor" aria-hidden="true" transition:persist><span class="cursor-dot"></span><span class="cursor-ring"></span></div>
    <ZenRainscape transition:persist />
    <ZenSoundscape transition:persist />
    <div class:list={['site-shell', { 'site-shell-standalone': standalone }]}>
      <slot />
    </div>

    {!standalone && (
      <!-- Floating retro pixel expand button directly under body to ensure true viewport fixed positioning -->
      <button
        class="sidebar-expand-btn hidden lg:inline-flex"
        type="button"
        data-sidebar-expand
        aria-label="展开侧边栏"
        title="展开侧边栏"
      >
        <span class="expand-btn-icon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 17 18 12 13 7"></polyline>
            <polyline points="6 17 11 12 6 7"></polyline>
          </svg>
        </span>
        <span class="expand-btn-text">展开导航</span>
      </button>
    )}

    <div class="search-overlay" id="site-search" aria-hidden="true">
      <div class="search-modal" role="dialog" aria-modal="true" aria-labelledby="search-title">
        <div class="search-panel" data-lenis-prevent>
          <div class="search-header">
            <div class="search-heading">
              <p class="eyebrow">Command Palette · 书斋检索与指令</p>
              <h2 class="search-title" id="search-title">全局检索与快捷指令</h2>
            </div>
            <button class="search-close-btn" type="button" aria-label="关闭搜索">
              Esc
            </button>
          </div>
          <label class="search-input-shell" for="site-search-input">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M10.5 10.5L13.5 13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
            <input
              id="site-search-input"
              class="search-input"
              type="search"
              placeholder="搜索文章、笔记、夹签、导图，或输入 > 执行指令..."
              autocomplete="off"
              spellcheck="false"
            />
          </label>
          <div class="search-tabs-bar">
            <div class="search-tabs" data-search-tabs role="tablist" aria-label="检索范围分类">
              <span class="search-tab-glider" data-search-tab-glider aria-hidden="true"></span>
              <button type="button" class="search-tab is-active" role="tab" aria-selected="true" data-search-cat="all">全部</button>
              <button type="button" class="search-tab" role="tab" aria-selected="false" data-search-cat="posts">文章</button>
              <button type="button" class="search-tab" role="tab" aria-selected="false" data-search-cat="notes">笔记</button>
              <button type="button" class="search-tab" role="tab" aria-selected="false" data-search-cat="mindmaps">导图</button>
              <button type="button" class="search-tab" role="tab" aria-selected="false" data-search-cat="commands">指令</button>
            </div>
            <button type="button" class="search-cmd-hint-btn" data-search-cmd-prefix-btn title="输入 > 进入快捷指令模式">
              <span class="search-kbd">&gt;</span>
              <span>指令</span>
            </button>
          </div>
          <div class="search-status" data-search-status>输入关键词跨库检索，或输入 &gt; 唤出快捷指令。</div>
          <div class="search-results" data-search-results role="listbox" aria-label="搜索与指令结果"></div>
          <div class="search-footer">
            <div class="search-footer-item">
              <span class="search-kbd">↑</span>
              <span class="search-kbd">↓</span>
              <span>选择</span>
            </div>
            <div class="search-footer-item">
              <span class="search-kbd">Tab</span>
              <span>切换分类</span>
            </div>
            <div class="search-footer-item">
              <span class="search-kbd">&gt;</span>
              <span>快捷指令</span>
            </div>
            <div class="search-footer-item">
              <span class="search-kbd">Enter</span>
              <span>打开 / 执行</span>
            </div>
            <div class="search-footer-item">
              <span class="search-kbd">Esc</span>
              <span>关闭</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import CustomEase from 'gsap/CustomEase';
      import Lenis from 'lenis';
      import { readArticleMotion, cubicBezierPoints } from '../utils/articleMotion';
      import { addCardEnter, cardEnterDelay, clearCardMotion, setCardEnterState } from '../utils/cardMotion';
      import { mountSiteContextMenu } from '../utils/siteContextMenu';
      import { mountAppAutoUpdate } from '../utils/appAutoUpdate';
      import { loadAllStoredNotes } from '../utils/articleHighlightEngine';
      import { loadActiveMindMaps } from '../utils/mindmapEngine';
      import { getAllBookmarks, getRecentReadingProgress } from '../utils/readingBookmarkEngine';
      import { initReadingSync } from '../utils/readingSync';
      import {
        buildDefaultCommands,
        computePaletteGliderGeometry,
        parsePaletteQuery,
        queryCommandPalette,
        stepPaletteCategory,
        type PaletteCategory,
        type RawPostSearchEntry,
      } from '../utils/commandPaletteEngine';

      mountSiteContextMenu();
      mountAppAutoUpdate({ baseUrl: import.meta.env.BASE_URL ?? '/' });
      initReadingSync();

      (window as any).__commandPaletteBridge = {
        computeGlider: computePaletteGliderGeometry,
        parseQuery: parsePaletteQuery,
        stepCategory: stepPaletteCategory,
        runQuery(rawInput: string, selectedCategory: PaletteCategory, posts: RawPostSearchEntry[]) {
          const basePath = import.meta.env.BASE_URL ?? '/';
          const recentReading = getRecentReadingProgress(3);
          const isArticlePage = Boolean(document.querySelector('[data-post-prose]'));
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
          const currentFont = document.documentElement.getAttribute('data-font') || 'pixel';
          const topResume = recentReading[0];
          const commands = buildDefaultCommands({
            isArticlePage,
            currentTheme,
            currentFont,
            hasRecentResume: Boolean(topResume),
            recentResumeTitle: topResume?.postTitle,
            recentResumeHref: topResume ? `${basePath.replace(/\/?$/, '/')}posts/${topResume.postSlug}/?resume=1` : undefined,
            basePath,
          });
          return queryCommandPalette(rawInput, selectedCategory, {
            posts,
            noteBuckets: loadAllStoredNotes(),
            bookmarks: getAllBookmarks(),
            recentReading,
            mindmaps: loadActiveMindMaps(),
            commands,
            basePath,
          });
        },
      };

      gsap.registerPlugin(ScrollTrigger, CustomEase);
      CustomEase.create('article-enter', cubicBezierPoints(readArticleMotion().revealEase));

      // Create a premium "ink-wash" custom ease
      CustomEase.create("ink", "0.25, 1, 0.5, 1");
      CustomEase.create("ink-out", "0.34, 1.56, 0.64, 1"); // Slight overshoot like ink spreading

      window.gsap = gsap;
      window.ScrollTrigger = ScrollTrigger;

      function initSmoothScroll() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const lenis = new Lenis({
          duration: 0.85, // Snappy & responsive, eliminates sluggish dragging feel
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Custom premium easing
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1.0, // Natural 1:1 wheel response
          allowNestedScroll: false, // Do not let containers (mermaid/code) hijack vertical scroll!
          anchors: { offset: -70 },
          virtualScroll: (data) => {
            // When Shift key is held, completely bypass Lenis to permit horizontal scroll!
            if (data.event.shiftKey) return false;
            // If any modal (e.g. Mermaid fullscreen modal, Life lottery modal, Gallery lightbox, Pin sheet) is open, completely block page scroll!
            if (document.body.classList.contains('mermaid-modal-open') || document.body.classList.contains('life-modal-open') || document.body.classList.contains('gallery-lightbox-open') || document.body.classList.contains('pin-sheet-open') || ((window.innerWidth < 1024) && (document.body.classList.contains('notes-drawer-open') || document.body.classList.contains('ink-ask-drawer-open')))) return false;

            const target = data.event.target;
            if (target instanceof Element) {
              // Completely prevent Lenis from scrolling page when interacting with TOC, modals, or sheets
              if (target.closest('.post-toc, .post-toc-inner, .post-toc-nav, .mermaid-modal-overlay, #mermaid-modal, #gallery-lightbox, .gallery-lightbox, .pin-sheet-drawer, .pin-window-body, .ink-ask-card, .article-notes-drawer, #article-notes-drawer, .ink-ask-drawer, #ink-ask-drawer, [data-lenis-prevent]')) {
                return false;
              }
              // When an inline diagram is zoomed, allow native pan/scroll without page hijacking
              if (target.closest('.mermaid-stage.is-zoomed')) {
                return false;
              }
              // On trackpad / touch horizontal drag, allow native horizontal swipe over horizontal containers
              if (Math.abs(data.deltaX) > Math.abs(data.deltaY) && Math.abs(data.deltaX) > 1) {
                if (target.closest('.table-scroll, .prose table, table, .table-wrapper, [data-table-wrap], .prose pre, pre, .mermaid-stage, [data-scrollable]')) {
                  return false;
                }
              }
            }
            return true;
          },
        });

        lenis.on('scroll', ScrollTrigger.update);

        if (lenisTickerFn) {
          gsap.ticker.remove(lenisTickerFn);
        }
        lenisTickerFn = (time: number) => {
          lenis.raf(time * 1000);
        };
        gsap.ticker.add(lenisTickerFn);

        // Smooth out lag spikes instead of jumping
        gsap.ticker.lagSmoothing(500, 33);

        // Store globally for potential destruction
        window.lenis = lenis;
      }

      let lenisTickerFn: ((time: number) => void) | null = null;

      // Initialize on first load
      initSmoothScroll();

      // Re-initialize after Astro View Transitions
      document.addEventListener('astro:after-swap', () => {
        if (lenisTickerFn) {
          gsap.ticker.remove(lenisTickerFn);
          lenisTickerFn = null;
        }
        if (window.lenis) {
          window.lenis.destroy();
        }
        initSmoothScroll();
      });

      function initScrollableContainers() {
        // Clean up any stale data-lenis-prevent attributes from code blocks and diagrams
        document.querySelectorAll('[data-scrollable], .prose pre, pre, .mermaid-stage').forEach((el) => {
          el.removeAttribute('data-lenis-prevent');
        });
        // Ensure TOC container and navigation can scroll vertically inside its panel without moving the page
        document.querySelectorAll('.post-toc, .post-toc-inner, .post-toc-nav').forEach((el) => {
          el.setAttribute('data-lenis-prevent', '');
        });
      }

      // Dedicated horizontal scroll handler: ONLY active when Shift key is pressed!
      function setupShiftHorizontalScroll() {
        if (window.__shiftScrollBound) return;
        window.__shiftScrollBound = true;

        window.addEventListener('wheel', (e) => {
          // STRICT RULE: If Shift is NOT pressed, do NOTHING! Page scrolls vertically 100% untouched!
          if (!e.shiftKey) return;

          const target = e.target instanceof Element ? e.target : null;
          if (!target) return;

          // Find nearest horizontally scrollable element (pre, table, etc.)
          let el = target;
          let scrollContainer = null;
          while (el && el !== document.documentElement && el !== document.body) {
            if (el.scrollWidth > el.clientWidth + 2) {
              const ox = window.getComputedStyle(el).overflowX;
              if (['auto', 'scroll', 'overlay'].includes(ox)) {
                scrollContainer = el;
                break;
              }
            }
            el = el.parentElement;
          }

          if (!scrollContainer) return;

          const maxScroll = scrollContainer.scrollWidth - scrollContainer.clientWidth;
          if (maxScroll <= 2) return;

          // Normalize delta across all browsers, operating systems, and mouse models
          // On Windows Chrome, Blink may convert vertical wheel into deltaX when Shift is held.
          // Other drivers/browsers may keep deltaY. Pick whichever axis holds the wheel magnitude:
          const rawDelta = Math.abs(e.deltaX) >= Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
          const multiplier = e.deltaMode === 1 ? 36 : e.deltaMode === 2 ? window.innerHeight : 1;
          const delta = rawDelta * multiplier;
          if (!delta) return;

          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          scrollContainer.scrollLeft += delta;
        }, { passive: false, capture: true });
      }

      setupShiftHorizontalScroll();

      // ================= Page-enter choreography =================
      // Every [data-enter] element flies in with a fast-in / long-settle ease, and plays again each
      // time it scrolls back into view. Kinds:
      //   left | right | top | bottom | scale — directional transform + opacity
      //   card  — shared soft landing for every article / note / collection card
      //   stamp — monochrome ink ripple settle, gentle ink splash, number counts up
      //   ink   — a drop of ink at the row's left edge spreads into the whole row (clip-path)
      // On first paint the authored direction plays; on scroll re-entries the vertical component
      // follows the scroll (rising in from below when scrolling down, dropping in from above when
      // scrolling up) so the motion always agrees with where the element actually came from.
      // Opt-outs: data-enter-once (sidebar: only on hard loads), data-no-replay (inside pins).
      // Gentle, refined offsets: soft slide without violent jerking or snapping
      const ENTER_OFFSET = { left: -34, right: 34, top: -28, bottom: 28 };
      const ENTER_SCROLL_BIAS = 18; // subtle vertical nudge on horizontal kinds during scroll re-entries
      const ENTER_TRIGGER_PREFIX = 'enter:';
      // Sides converge first, then verticals, then scale/stamps/bloom, ink rows last
      const ENTER_ORDER = { left: 0, right: 0, top: 1, bottom: 1, card: 2, scale: 2, stamp: 2, bloom: 2, ink: 3 };
      const ENTER_STAGGER = { default: 0.068, card: 0.056, stamp: 0.11, bloom: 0.11, ink: 0.062 };
      let hasNavigated = false;
      let cardYawCounter = 0;

      // Smooth, natural brush glide ease: gentle start, steady acceleration and soft settle (zero whip/snap)
      CustomEase.create('enter', 'M0,0 C0.16,1 0.3,1 1,1');
      // 宣纸舒卷曲线：起笔温润，收锋安定，消除前段过陡急刹感
      CustomEase.create('paper-glide', 'M0,0 C0.2,0.84 0.3,1 1,1');
      // 宣纸水墨毛细渗透曲线：先浸润纸肌，后缓缓晕开收口
      CustomEase.create('ink-seep', 'M0,0 C0.14,0.74 0.26,0.97 1,1');
      // 水墨凝定曲线：轻触宣纸温润落定，零弹跳
      CustomEase.create('ink-settle', 'M0,0 C0.16,0.92 0.28,1 0.56,1 0.8,1 1,1 1,1');

      // Which way the page is moving — CSS reveals (post body) read it off <html>
      ScrollTrigger.create({
        id: 'scroll-direction',
        onUpdate: (self) => {
          document.documentElement.dataset.scrollDir = self.direction === -1 ? 'up' : 'down';
        },
      });

      function enterKind(el) {
        return el.dataset.enter || 'bottom';
      }

      function isVisibleInFlow(el) {
        return el.offsetParent !== null || getComputedStyle(el).position === 'fixed';
      }

      // Rotation the stylesheet gives this element (e.g. .home-stat's rotate(-1.5deg)), in degrees
      function restingRotation(el) {
        const wasEntering = el.classList.contains('is-entering');
        el.classList.remove('is-entering');
        const matrix = getComputedStyle(el).transform;
        if (wasEntering) el.classList.add('is-entering');
        const match = /matrix\(([^,]+),([^,]+)/.exec(matrix);
        if (!match) return 0;
        return Math.atan2(parseFloat(match[2]), parseFloat(match[1])) * 180 / Math.PI;
      }

      function measureInkSpec(el, cachedRect) {
        const seed = el.querySelector('time') || el;
        const rowRect = cachedRect || el.getBoundingClientRect();
        const seedRect = seed === el ? rowRect : seed.getBoundingClientRect();
        const x = seedRect.left - rowRect.left + Math.min(seedRect.width, 40) / 2;
        const y = seedRect.top - rowRect.top + seedRect.height / 2;
        const radius = Math.max(24, Math.ceil(Math.hypot(rowRect.width || el.offsetWidth || 240, rowRect.height || el.offsetHeight || 48)));
        return { origin: `${Math.round(x)}px ${Math.round(y)}px`, radius };
      }

      // Spawn a lightweight GPU-composited monochrome water-ink ripple halo on settle
      function spawnInkRippleHalo(el) {
        if (!el || !el.isConnected || !document.body) return;
        const rect = el.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;
        const halo = document.createElement('div');
        halo.className = 'ink-ripple-halo';
        Object.assign(halo.style, {
          left: `${Math.round(rect.left)}px`,
          top: `${Math.round(rect.top)}px`,
          width: `${Math.round(rect.width)}px`,
          height: `${Math.round(rect.height)}px`,
        });
        document.body.appendChild(halo);
        if (typeof halo.animate === 'function') {
          const anim = halo.animate(
            [
              { transform: 'scale(0.96)', opacity: 0.52 },
              { transform: 'scale(1.22)', opacity: 0 },
            ],
            { duration: 520, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'forwards' }
          );
          anim.onfinish = () => halo.remove();
        } else {
          window.setTimeout(() => halo.remove(), 540);
        }
      }

      function finishEnter(el) {
        el.classList.remove('is-entering');
        el.classList.add('is-entered');
        if (enterKind(el) === 'card') {
          clearCardMotion(el, false);
        } else {
          gsap.set(el, { clearProps: 'transform,opacity,clipPath,filter,transformOrigin,willChange' });
        }
        if (el.matches?.('.glass-nav') || el.querySelector?.('.glass-nav')) {
          (window as any).__syncNavMagneticGlider?.();
        }
      }

      function countUp(el, delay) {
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target)) return;
        gsap.killTweensOf(el);
        const counter = { value: 0 };
        gsap.to(counter, {
          value: target,
          duration: 1.2,
          delay,
          ease: 'expo.out',
          onUpdate: () => { el.textContent = String(Math.round(counter.value)); },
          onComplete: () => { el.textContent = String(target); },
        });
      }

      function splashAt(el) {
        if (typeof window.__inkSplash !== 'function') return;
        if (!el || !el.isConnected) return;
        const rect = el.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return;
        const centerX = Math.round(rect.left + rect.width / 2);
        const centerY = Math.round(rect.top + rect.height / 2);
        if (centerX <= 15 && centerY <= 15) return;
        window.__inkSplash(centerX, centerY, 12);
      }

      // Adds this element's entrance to `tl` at `at` seconds; returns how long to wait before the
      // next one. `scrollDir` is null for the first-paint choreography, 'down' | 'up' on re-entries.
      function scheduleEnter(tl, el, at, scrollDir = null, cardIndex = -1, knownPanel = undefined, preMeta = undefined) {
        const kind = enterKind(el);
        const isArticle = Boolean(document.querySelector('[data-post-prose]'));
        const isReplay = el.dataset.enteredOnce === 'true';
        el.dataset.enterState = 'in';
        el.dataset.enteredOnce = 'true';
        el.classList.remove('is-entered');
        el.classList.add('is-entering');

        if (kind === 'card') {
          const direction = scrollDir === 'down' ? 1 : scrollDir === 'up' ? -1 : 0;
          const yawIdx = cardIndex >= 0 ? cardIndex : cardYawCounter++;
          setCardEnterState(el, {
            replay: isReplay,
            direction,
            indexOffset: yawIdx,
            preOrdered: true,
            knownPanel,
          });
          addCardEnter(tl, el, at, {
            replay: isReplay,
            direction,
            preOrdered: true,
            onComplete: () => finishEnter(el),
          });
          return ENTER_STAGGER.card;
        }

        // On replay: use ultra-light GPU compositor-only animation (zero filter:blur, zero splash DOM injection)
        if (isReplay) {
          const scrollY = scrollDir ? (scrollDir === 'down' ? 1 : -1) : 0;
          const fromY = scrollY * (kind === 'top' || kind === 'bottom' ? ENTER_OFFSET.bottom * 0.55 : ENTER_SCROLL_BIAS);
          const fromX = (kind === 'left' || kind === 'right') ? ENTER_OFFSET[kind] * 0.45 : 0;
          gsap.set(el, { opacity: 0, x: fromX, y: fromY, scale: 0.985, willChange: 'transform, opacity' });
          tl.to(el, {
            opacity: 1, x: 0, y: 0, scale: 1,
            duration: isArticle ? 0.66 : 0.44,
            ease: isArticle ? 'article-enter' : 'paper-glide',
            onComplete: () => finishEnter(el),
          }, at);
          return ENTER_STAGGER.default * 0.6;
        }

        if (kind === 'stamp') {
          // 水墨凝定：轻盈落定 + 单色水墨涟漪光环扩散
          const restRotation = preMeta?.restRotation ?? restingRotation(el);
          const rect = preMeta?.rect ?? el.getBoundingClientRect();
          const origin = (rect.right > window.innerWidth * 0.65) ? 'right center' : '50% 50%';
          gsap.set(el, {
            opacity: 0,
            scale: 1.08,
            y: 8,
            rotation: restRotation,
            transformOrigin: origin,
            willChange: 'transform, opacity',
          });
          tl.to(el, {
            opacity: 1,
            scale: 1,
            y: 0,
            rotation: restRotation,
            duration: 0.48,
            ease: 'ink-settle',
            onStart: () => {
              gsap.delayedCall(0.14, () => {
                if (el && el.isConnected) {
                  spawnInkRippleHalo(el);
                  splashAt(el);
                }
              });
            },
            onComplete: () => finishEnter(el),
          }, at);
          el.querySelectorAll('[data-count]').forEach((numEl) => countUp(numEl, at + 0.2));
          return ENTER_STAGGER.stamp;
        }

        if (kind === 'bloom') {
          // 落墨生花：零 filter:blur 掉帧，纯合成器宣纸墨卷绽放（clip-path + scale + opacity）
          gsap.set(el, {
            opacity: 0,
            y: 14,
            scale: 0.96,
            clipPath: 'inset(6% 4% 6% 4% round 16px)',
            transformOrigin: '50% 50%',
            willChange: 'transform, opacity, clip-path',
          });
          tl.to(el, {
            opacity: 1,
            y: 0,
            scale: 1,
            clipPath: 'inset(0% 0% 0% 0% round 16px)',
            duration: 0.78,
            ease: 'ink-seep',
            onStart: () => {
              gsap.delayedCall(0.16, () => {
                if (el && el.isConnected) splashAt(el);
              });
            },
            onComplete: () => finishEnter(el),
          }, at);
          el.querySelectorAll('[data-count]').forEach((numEl) => countUp(numEl, at + 0.18));
          return ENTER_STAGGER.bloom;
        }

        if (kind === 'ink') {
          const spec = preMeta?.inkSpec ?? measureInkSpec(el, preMeta?.rect);
          gsap.set(el, {
            opacity: 0.36,
            x: -8,
            clipPath: `circle(0px at ${spec.origin})`,
            willChange: 'clip-path, transform, opacity',
          });
          tl.to(el, {
            opacity: 1,
            x: 0,
            clipPath: `circle(${spec.radius}px at ${spec.origin})`,
            duration: 0.94,
            ease: 'ink-seep',
            onComplete: () => finishEnter(el),
          }, at);
          return ENTER_STAGGER.ink;
        }

        const from = { opacity: 0, x: 0, y: 0, scale: 1, willChange: 'transform, opacity' };
        const scrollY = scrollDir ? (scrollDir === 'down' ? 1 : -1) : 0;
        if (kind === 'left' || kind === 'right') {
          from.x = ENTER_OFFSET[kind];
          from.y = scrollY * ENTER_SCROLL_BIAS;
        } else if (kind === 'top' || kind === 'bottom') {
          from.y = scrollDir ? scrollY * ENTER_OFFSET.bottom : ENTER_OFFSET[kind];
        } else if (kind === 'scale') {
          from.scale = 0.86;
          from.y = scrollY * ENTER_SCROLL_BIAS * 0.5;
        }

        gsap.set(el, from);
        tl.to(el, {
          opacity: 1, x: 0, y: 0, scale: 1,
          duration: isArticle ? 0.88 : 0.74,
          ease: isArticle ? 'article-enter' : 'paper-glide',
          onComplete: () => finishEnter(el),
        }, at);
        return ENTER_STAGGER.default;
      }

      // Scroll discovery & re-entry: batch elements crossing the viewport within the same frame
      // so multi-column cards ripple in a diagonal wave instead of snapping in flat lockstep
      let pendingScrollReplays: Array<{ el: HTMLElement; scrollDir: string }> = [];
      let pendingScrollReplayRaf = 0;

      function flushPendingScrollReplays() {
        pendingScrollReplayRaf = 0;
        if (!pendingScrollReplays.length) return;
        const batch = pendingScrollReplays;
        pendingScrollReplays = [];

        const valid = batch.filter(({ el }) =>
          el.isConnected &&
          el.dataset.enterState !== 'in' &&
          isVisibleInFlow(el) &&
          !el.classList.contains('is-filtered-out')
        );
        if (!valid.length) return;

        const measured = valid.map((item, idx) => {
          const r = item.el.getBoundingClientRect();
          const vert = item.scrollDir === 'up' ? -r.top : r.top;
          const isPanel =
            item.el.matches?.('.stats-hero, .stats-kpis, .chart-card, .stats-table, [id*="empty-state"], .empty-state') ||
            r.width > 680;
          return { ...item, idx, score: vert + r.left * 0.48, isPanel };
        });
        measured.sort((a, b) => a.score - b.score || a.idx - b.idx);

        const tl = gsap.timeline();
        let at = 0;
        measured.forEach(({ el, scrollDir, isPanel }, idx) => {
          const wasSeen = el.dataset.enteredOnce === 'true';
          gsap.killTweensOf(el);
          scheduleEnter(tl, el, at, scrollDir, idx, isPanel);
          const kind = enterKind(el);
          at += kind === 'card' ? (wasSeen ? 0.042 : 0.06) : (wasSeen ? 0.04 : 0.065);
        });
      }

      function replayEnter(el, scrollDir) {
        if (el.dataset.enterState === 'in') return;
        if (!isVisibleInFlow(el)) return;
        if (el.classList.contains('is-filtered-out')) return;
        if (!pendingScrollReplays.some((item) => item.el === el)) {
          pendingScrollReplays.push({ el, scrollDir });
        }
        if (!pendingScrollReplayRaf) {
          pendingScrollReplayRaf = requestAnimationFrame(flushPendingScrollReplays);
        }
      }

      // Scrolled fully out of the viewport: reset silently and arm for the next crossing
      function leaveEnter(el) {
        if (el.dataset.enterState !== 'in') return;
        if (el.classList.contains('is-filtered-out')) return;
        // Never hide an element that is still visible in the viewport!
        const rect = el.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < window.innerHeight) {
          return;
        }
        el.dataset.enterState = 'out';
        clearCardMotion(el, true);
        el.classList.remove('is-entered', 'is-entering');
        if (isVisibleInFlow(el)) gsap.set(el, { opacity: 0 });
      }

      // Anything that changes the page's height behind the triggers' back invalidates them
      document.addEventListener('toggle', () => {
        requestAnimationFrame(() => ScrollTrigger.refresh());
      }, true);

      // Which elements enter right away, in what order and when — without touching them. The
      // site-entry curtain reads this (window.__peekPageEnter) so its pixels can land on each
      // element at the moment that element starts to enter.
      function planPageEnter({ forceEnterOnce = false } = {}) {
        const viewportH = window.innerHeight;
        const immediate = [];
        const deferred = [];
        const settled = []; // enter-once elements on a client navigation: shown, never animated
        const rectMap = new Map();
        gsap.utils.toArray('[data-enter]').forEach((el) => {
          // The sidebar only makes its entrance once; on client navigations it stays put —
          // except when releasing from post-title-hold where .glass-nav was hidden
          if (el.hasAttribute('data-enter-once')) {
            ((hasNavigated && !forceEnterOnce) ? settled : immediate).push(el);
            return;
          }
          const rect = el.getBoundingClientRect();
          rectMap.set(el, rect);
          const onScreen = rect.top < viewportH * 0.92 && rect.bottom > 0;
          (onScreen ? immediate : deferred).push(el);
        });

        // Sort by group first; inside 'card' group, sort by spatial diagonal wave (top-left -> bottom-right)
        // so multi-column masonry grids never animate down column 1 before column 2
        immediate.sort((a, b) => {
          const ga = ENTER_ORDER[enterKind(a)] ?? 1;
          const gb = ENTER_ORDER[enterKind(b)] ?? 1;
          if (ga !== gb) return ga - gb;
          if (enterKind(a) === 'card' && enterKind(b) === 'card') {
            const ra = rectMap.get(a);
            const rb = rectMap.get(b);
            if (ra && rb) {
              return (ra.top + ra.left * 0.48) - (rb.top + rb.left * 0.48);
            }
          }
          return 0;
        });

        let at = 0;
        let lastGroup = -1;
        let cardGroupStartAt = -1;
        let cardCountInGroup = 0;
