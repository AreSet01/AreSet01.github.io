---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

import TagList from '../components/TagList.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  locked?: boolean;
  passwordHash?: string;
  passwordHint?: string;
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  locked = false,
  passwordHash,
  passwordHint,
  headings = [],
} = Astro.props;
const isLocked = locked && Boolean(passwordHash);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const hasToc = tocHeadings.length > 1;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="container-medium flex-1 pt-14 pb-16 md:pt-20">
    <article
      class="space-y-14"
      data-locked-post={isLocked ? 'true' : undefined}
      data-lock-key={isLocked ? passwordHash : undefined}
    >
      <header class="panel reveal-up">
        <div class="flex flex-wrap items-center gap-3 font-mono text-[0.72rem] tracking-[0.1em] uppercase text-[var(--muted)]">
          <a href="/archive" class="transition hover:text-[var(--accent)]">Archive</a>
          <span class="opacity-40">/</span>
          <span>{formatDate(pubDate)}</span>
          {isLocked && <span class="lock-mark">Locked</span>}
        </div>
        <h1 class="section-title mt-7 max-w-3xl" style="font-size: clamp(2.2rem, 4.5vw, 3.2rem);">
          {title}
        </h1>
        {description && (
          <p
            class="mt-6 max-w-2xl text-[1.05rem] leading-[1.78] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
          >
            {description}
          </p>
        )}
        {tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;">
            <TagList tags={tags} />
          </div>
        )}
      </header>
      {isLocked && (
        <section
          class="lock-panel panel reveal-up py-10"
          data-lock-panel
          style="animation-delay: 120ms;"
        >
          <p class="eyebrow">Protected Note</p>
          <h2 class="font-display mt-5 text-[1.55rem] text-[var(--text-strong)]">
            输入密码可查看噢～
          </h2>
          {passwordHint && (
            <p
              class="mt-4 text-[0.94rem] leading-relaxed text-[var(--muted-strong)]"
              style="font-family: var(--font-serif); font-style: italic;"
            >
              Hint：{passwordHint}
            </p>
          )}
          <form class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end" data-lock-form>
            <label class="flex-1">
              <span class="stat-label">Password</span>
              <input
                class="lock-input mt-2"
                type="password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
              />
            </label>
            <button class="btn-primary whitespace-nowrap" type="submit">Unlock →</button>
          </form>
          <p class="lock-message mt-5" data-lock-message aria-live="polite"></p>
        </section>
      )}
      <div
        class="space-y-6 reveal-up"
        style="animation-delay: 120ms;"
        data-locked-content={isLocked ? 'true' : undefined}
        hidden={isLocked}
      >
        {hasToc && (
          <details class="post-toc panel" open aria-labelledby="post-toc-title">
            <summary class="post-toc-summary">
              <div class="flex items-center gap-2">
                <span class="post-toc-kicker">Navigation</span>
                <span class="opacity-30">/</span>
                <span id="post-toc-title" class="post-toc-title">文章目录</span>
              </div>
              <span class="post-toc-badge">{tocHeadings.length} 节</span>
            </summary>
            <div class="post-toc-inner">
              <nav class="post-toc-nav" aria-label="文章目录">
                {tocHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class={`post-toc-link depth-${heading.depth}`}
                    data-toc-link={heading.slug}
                  >
                    <span class="toc-bullet" />
                    <span class="toc-text">{heading.text}</span>
                  </a>
                ))}
              </nav>
            </div>
          </details>
        )}
        <div class="panel rounded-[20px] px-7 py-8 md:px-10 md:py-10">
          <div class="prose" data-post-prose>
            <slot />
          </div>
        </div>
      </div>
      <div class="reveal-up pt-6 border-t border-[var(--rule)]" style="animation-delay: 220ms; border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;">
        <p class="eyebrow mb-6">Discussion</p>
        <Giscus />
      </div>
    </article>
  </main>

  {isLocked && (
    <script is:inline data-astro-rerun>
      (() => {
        const article = document.querySelector('[data-locked-post="true"]');
        const panel = document.querySelector('[data-lock-panel]');
        const content = document.querySelector('[data-locked-content="true"]');
        const form = document.querySelector('[data-lock-form]');
        const message = document.querySelector('[data-lock-message]');
        const expectedHash = article?.getAttribute('data-lock-key') || '';
        const storageKey = `post-unlocked:${location.pathname}:${expectedHash}`;
        const encoder = new TextEncoder();

        function getStoredUnlock() {
          try {
            return sessionStorage.getItem(storageKey) === '1';
          } catch {
            return false;
          }
        }

        function setStoredUnlock() {
          try {
            sessionStorage.setItem(storageKey, '1');
          } catch {
            // Some privacy modes block sessionStorage; unlocking still works for the current page.
          }
        }

        async function sha256(value) {
          const bytes = encoder.encode(value);
          if (!window.crypto?.subtle) {
            throw new Error('WebCrypto is unavailable');
          }
          const hashBuffer = await window.crypto.subtle.digest('SHA-256', bytes);
          return Array.from(new Uint8Array(hashBuffer))
            .map((byte) => byte.toString(16).padStart(2, '0'))
            .join('');
        }

        function unlock() {
          if (content) content.hidden = false;
          if (panel) panel.hidden = true;
          article?.setAttribute('data-locked-post', 'false');
        }

        if (!article || !panel || !content || !form || !expectedHash) return;
        if (form.dataset.lockBound === 'true') return;
        form.dataset.lockBound = 'true';

        if (getStoredUnlock()) {
          unlock();
          return;
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          const password = String(formData.get('password') ?? '');
          if (!password) return;

          try {
            const digest = await sha256(password);
            if (digest === expectedHash) {
              setStoredUnlock();
              unlock();
              window.dispatchEvent(new CustomEvent('post-unlocked'));
            } else if (message) {
              message.textContent = 'Password is incorrect.';
            }
          } catch {
            if (message) {
              message.textContent = 'This browser cannot verify the password here.';
            }
          }
        });
      })();
    </script>
  )}
  <script is:inline>
    (() => {
      const cleanupKey = '__areSetPostTocCleanup__';
      const initKey = '__areSetPostTocInit__';
      const listenerKey = '__areSetPostTocPageLoadBound__';

      function initPostToc() {
        const previousCleanup = window[cleanupKey];
        if (typeof previousCleanup === 'function') previousCleanup();

        const toc = document.querySelector('.post-toc');
        const prose = document.querySelector('[data-post-prose]');
        if (!toc || !prose) {
          window[cleanupKey] = null;
          return;
        }

        const controller = new AbortController();
        const { signal } = controller;
        const links = Array.from(toc.querySelectorAll('[data-toc-link]'));
        const headings = links
          .map((link) => {
            const id = link.getAttribute('data-toc-link');
            const heading = id ? prose.querySelector(`#${CSS.escape(id)}`) : null;
            return heading ? { link, heading } : null;
          })
          .filter(Boolean);

        function setActive(id) {
          links.forEach((link) => {
            link.classList.toggle('is-active', link.getAttribute('data-toc-link') === id);
          });
        }

        links.forEach((link) => {
          link.addEventListener('click', () => {
            const id = link.getAttribute('data-toc-link');
            if (id) setActive(id);
          }, { signal });
        });

        if (!headings.length || !('IntersectionObserver' in window)) {
          const firstId = links[0]?.getAttribute('data-toc-link');
          if (firstId) setActive(firstId);
          window[cleanupKey] = () => controller.abort();
          return;
        }

        const visible = new Map();
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            if (!id) return;
            if (entry.isIntersecting) {
              visible.set(id, entry.boundingClientRect.top);
            } else {
              visible.delete(id);
            }
          });

          if (visible.size > 0) {
            const [id] = Array.from(visible.entries()).sort((a, b) => a[1] - b[1])[0];
            setActive(id);
            return;
          }

          const current = headings
            .map((item) => item.heading)
            .filter((heading) => heading.getBoundingClientRect().top <= 120)
            .at(-1);
          if (current?.id) setActive(current.id);
        }, {
          rootMargin: '-18% 0px -70% 0px',
          threshold: [0, 1],
        });

        headings.forEach(({ heading }) => observer.observe(heading));

        window[cleanupKey] = () => {
          controller.abort();
          observer.disconnect();
        };
      }

      window[initKey] = initPostToc;
      initPostToc();

      if (!window[listenerKey]) {
        window.addEventListener('post-unlocked', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });

        document.addEventListener('astro:page-load', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });
        window[listenerKey] = true;
      }
    })();
  </script>
  <script is:inline>
    (() => {
      const cleanupKey = '__areSetPostEnhancementsCleanup__';
      const initKey = '__areSetPostEnhancementsInit__';
      const listenerKey = '__areSetPostEnhancementsPageLoadBound__';

      function initPostEnhancements() {
        const previousCleanup = window[cleanupKey];
        if (typeof previousCleanup === 'function') previousCleanup();

        const prose = document.querySelector('[data-post-prose]');
        if (!prose) {
          window[cleanupKey] = null;
          return;
        }

        const controller = new AbortController();
        const { signal } = controller;
        let lastFocus = null;
        let previewOverlay = null;
        const previewCache = new Map();

        function enhanceCodeBlocks() {
          prose.querySelectorAll('pre').forEach((pre) => {
            if (pre.dataset.codeEnhanced === 'true') return;
            const code = pre.querySelector('code');
            if (!code) return;

            pre.dataset.codeEnhanced = 'true';
            const className = code.className || '';
            const languageMatch = className.match(/(?:language|lang)-([a-z0-9_+#.-]+)/i);
            const language = (languageMatch?.[1] || pre.getAttribute('data-language') || 'code').toLowerCase();

            const toolbar = document.createElement('div');
            toolbar.className = 'code-block-toolbar';

            const label = document.createElement('span');
            label.className = 'code-block-language';
            label.textContent = language;

            const copyButton = document.createElement('button');
            copyButton.className = 'code-copy-button';
            copyButton.type = 'button';
            copyButton.textContent = 'Copy';
            copyButton.setAttribute('aria-label', '复制代码');

            copyButton.addEventListener('click', async () => {
              const text = code.textContent || '';
              try {
                await navigator.clipboard.writeText(text);
                copyButton.textContent = 'Copied';
                window.setTimeout(() => {
                  copyButton.textContent = 'Copy';
                }, 1400);
              } catch {
                copyButton.textContent = 'Failed';
                window.setTimeout(() => {
                  copyButton.textContent = 'Copy';
                }, 1400);
              }
            }, { signal });

            toolbar.append(label, copyButton);
            pre.prepend(toolbar);
          });
        }

        function bindAnchorScroll() {
          prose.addEventListener('click', (event) => {
            if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            const anchor = event.target instanceof Element ? event.target.closest('a[href^="#"]') : null;
            if (!anchor) return;
            const href = anchor.getAttribute('href') || '';
            if (href.length <= 1) return;

            const targetId = decodeURIComponent(href.slice(1));
            const targetEl = document.getElementById(targetId) || prose.querySelector(`#${CSS.escape(targetId)}`);
            if (targetEl) {
              event.preventDefault();
              if (window.lenis) {
                window.lenis.scrollTo(targetEl, { offset: -70 });
              } else {
                targetEl.scrollIntoView({ behavior: 'smooth' });
              }
              history.pushState(null, '', href);
            }
          }, { signal });
        }

        enhanceCodeBlocks();
        bindAnchorScroll();

        window[cleanupKey] = () => {
          controller.abort();
        };
      }

      window[initKey] = initPostEnhancements;
      initPostEnhancements();

      if (!window[listenerKey]) {
        window.addEventListener('post-unlocked', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });

        document.addEventListener('astro:page-load', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });
        window[listenerKey] = true;
      }
    })();
  </script>

  <style is:global>
    .post-toc {
      border-radius: 18px !important;
      padding: 1.1rem 1.4rem !important;
      background: var(--bg-soft);
      border: 1px solid var(--rule);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .post-toc:hover {
      border-color: var(--rule-strong);
    }
    .post-toc-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      user-select: none;
      list-style: none;
      outline: none;
    }
    .post-toc-summary::-webkit-details-marker {
      display: none;
    }
    .post-toc-kicker {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .post-toc-title {
      font-family: var(--font-hand);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-strong);
    }
    .post-toc-badge {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--muted-strong);
      background: rgba(0, 0, 0, 0.04);
      padding: 0.15rem 0.55rem;
      border-radius: 9999px;
      border: 1px solid var(--rule-soft);
    }
    .post-toc-inner {
      margin-top: 0.85rem;
      padding-top: 0.85rem;
      border-top: 1px dashed var(--rule);
    }
    .post-toc-nav {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      max-height: 22rem;
      overflow-y: auto;
      padding-right: 0.4rem;
    }
    .post-toc-nav::-webkit-scrollbar {
      width: 4px;
    }
    .post-toc-nav::-webkit-scrollbar-track {
      background: transparent;
    }
    .post-toc-nav::-webkit-scrollbar-thumb {
      background: var(--rule);
      border-radius: 4px;
    }
    .post-toc-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.28rem 0.55rem;
      border-radius: 6px;
      font-size: 0.88rem;
      line-height: 1.5;
      color: var(--muted-strong);
      text-decoration: none !important;
      transition: all 0.15s ease;
    }
    .post-toc-link .toc-bullet {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--rule-strong);
      flex-shrink: 0;
      opacity: 0.45;
      transition: all 0.15s ease;
    }
    .post-toc-link.depth-2 {
      font-weight: 600;
      color: var(--text-strong);
      margin-top: 0.35rem;
    }
    .post-toc-link.depth-3 {
      padding-left: 1.4rem;
      font-size: 0.82rem;
      color: var(--muted-strong);
    }
    .post-toc-link.depth-3 .toc-bullet {
      width: 3.5px;
      height: 3.5px;
    }
    .post-toc-link:hover {
      color: var(--text-strong);
      background: rgba(0, 0, 0, 0.04);
      transform: translateX(3px);
    }
    .post-toc-link:hover .toc-bullet {
      opacity: 1;
      background: var(--accent);
    }
    .post-toc-link.is-active {
      color: var(--accent-strong);
      font-weight: 700;
      background: rgba(0, 0, 0, 0.05);
    }
    .post-toc-link.is-active .toc-bullet {
      opacity: 1;
      background: var(--accent);
      transform: scale(1.35);
    }
  </style>
</BaseLayout>
