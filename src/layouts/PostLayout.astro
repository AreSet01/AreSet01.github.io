---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

import TagList from '../components/TagList.astro';
import Giscus from '../components/Giscus.astro';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import InkAsk from '../components/InkAsk.astro';
import { formatDate } from '../utils/date';

interface SeriesLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  category?: string;
  readingMinutes?: number;
  series?: {
    name: string;
    current: number;
    total: number;
    parts: Array<SeriesLink & { index: number }>;
    prev?: SeriesLink;
    next?: SeriesLink;
  };
  locked?: boolean;
  passwordHash?: string;
  passwordHint?: string;
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  category,
  readingMinutes,
  series,
  locked = false,
  passwordHash,
  passwordHint,
  headings = [],
} = Astro.props;
const isLocked = locked && Boolean(passwordHash);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const hasToc = tocHeadings.length > 1;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="container-medium flex-1 pt-14 pb-16 md:pt-20">
    <article
      class="space-y-14"
      data-locked-post={isLocked ? 'true' : undefined}
      data-lock-key={isLocked ? passwordHash : undefined}
    >
      <header class="panel" data-post-header>
        <div class="flex flex-wrap items-center gap-3 font-mono text-[0.72rem] tracking-[0.1em] uppercase text-[var(--muted)]" data-enter="left">
          <a href="/archive" class="transition hover:text-[var(--accent)]">Archive</a>
          <span class="opacity-40">/</span>
          <span data-post-typed>{formatDate(pubDate)}</span>
          {category && (
            <>
              <span class="opacity-40">/</span>
              <a href={`/archive?category=${encodeURIComponent(category)}`} class="transition hover:text-[var(--accent)]">
                {category}
              </a>
            </>
          )}
          {readingMinutes && (
            <>
              <span class="opacity-40">/</span>
              <span>{readingMinutes} min read</span>
            </>
          )}
          {isLocked && <span class="lock-mark">Locked</span>}
        </div>
        <h1 class="section-title post-title mt-7 max-w-3xl" style="font-size: clamp(2.2rem, 4.5vw, 3.2rem);" data-post-title>
          {title}
        </h1>
        {description && (
          <p
            class="mt-6 max-w-2xl text-[1.05rem] leading-[1.78] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
            data-enter="left"
          >
            {description}
          </p>
        )}
        {tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;" data-enter="bottom">
            <TagList tags={tags} />
          </div>
        )}
      </header>
      {series && (
        <nav class="series-strip" data-enter="bottom" data-no-replay aria-label={`系列：${series.name}`}>
          <div class="series-strip-head">
            <span class="series-strip-kicker">Series</span>
            <span class="series-strip-name">{series.name}</span>
            <span class="series-strip-count">{series.current} / {series.total}</span>
          </div>
          <ol class="series-dots">
            {series.parts.map((part) => {
              const isCurrent = part.index === series.current;
              const isDone = part.index < series.current;
              const badgeText = isCurrent ? '当前阅读' : isDone ? '已阅' : `待读`;
              return (
                <li>
                  <a
                    href={part.href}
                    class:list={['series-dot', { 'is-current': isCurrent, 'is-done': isDone }]}
                    aria-current={isCurrent ? 'step' : undefined}
                  >
                    <span class="series-dot-mark" aria-hidden="true"></span>
                    <span class="series-dot-tip">
                      <span class="series-dot-tip-head">
                        <span class="series-dot-tip-num">PART {String(part.index).padStart(2, '0')}</span>
                        <span class:list={['series-dot-tip-badge', { 'is-current': isCurrent }]}>{badgeText}</span>
                      </span>
                      <span class="series-dot-tip-title">{part.title}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </nav>
      )}
      {isLocked && (
        <section
          class="lock-panel panel py-10"
          data-lock-panel
          data-enter="scale"
        >
          <p class="eyebrow">Protected Note</p>
          <h2 class="font-display mt-5 text-[1.55rem] text-[var(--text-strong)]">
            输入密码可查看噢～
          </h2>
          {passwordHint && (
            <p
              class="mt-4 text-[0.94rem] leading-relaxed text-[var(--muted-strong)]"
              style="font-family: var(--font-serif); font-style: italic;"
            >
              Hint：{passwordHint}
            </p>
          )}
          <form class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end" data-lock-form>
            <label class="flex-1">
              <span class="stat-label">Password</span>
              <input
                class="lock-input mt-2"
                type="password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
              />
            </label>
            <button class="btn-primary whitespace-nowrap" type="submit">Unlock →</button>
          </form>
          <p class="lock-message mt-5" data-lock-message aria-live="polite"></p>
        </section>
      )}
      <div
        class="space-y-6"
        data-locked-content={isLocked ? 'true' : undefined}
        hidden={isLocked}
      >
        {hasToc && (
          <details class="post-toc panel" open aria-labelledby="post-toc-title" data-enter="bottom" data-no-replay data-lenis-prevent>
            <summary class="post-toc-summary" data-lenis-prevent>
              <div class="flex items-center gap-2">
                <span class="post-toc-kicker">Navigation</span>
                <span class="opacity-30">/</span>
                <span id="post-toc-title" class="post-toc-title">文章目录</span>
              </div>
              <span class="post-toc-badge">{tocHeadings.length} 节</span>
            </summary>
            <div class="post-toc-inner" data-lenis-prevent>
              <nav class="post-toc-nav" aria-label="文章目录" data-lenis-prevent>
                {tocHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class={`post-toc-link depth-${heading.depth}`}
                    data-toc-link={heading.slug}
                  >
                    <span class="toc-bullet" />
                    <span class="toc-text">{heading.text}</span>
                  </a>
                ))}
              </nav>
            </div>
          </details>
        )}
        <div class="panel post-body rounded-[20px] px-7 py-8 md:px-10 md:py-10" data-post-body>
          <div class="post-spine" aria-hidden="true" data-post-spine>
            <svg preserveAspectRatio="none" viewBox="0 0 2 100">
              <line x1="1" y1="0" x2="1" y2="100" pathLength="1" data-post-spine-line />
            </svg>
          </div>
          <div class="prose" data-post-prose>
            <slot />
          </div>
        </div>
      </div>
      {series && (series.prev || series.next) && (
        <nav class="series-ends" data-enter="bottom" data-no-replay aria-label="系列上下篇">
          {series.prev ? (
            <a class="series-end is-prev" href={series.prev.href}>
              <span>← 上一篇</span>
              <strong>{series.prev.title}</strong>
            </a>
          ) : (
            <span class="series-end is-empty">已是系列第一篇</span>
          )}
          {series.next ? (
            <a class="series-end is-next" href={series.next.href}>
              <span>下一篇 →</span>
              <strong>{series.next.title}</strong>
            </a>
          ) : (
            <span class="series-end is-empty">已是系列最后一篇</span>
          )}
        </nav>
      )}
      <div class="pt-6 border-t border-[var(--rule)]" data-enter="bottom" data-no-replay style="border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;">
        <p class="eyebrow mb-6">Discussion</p>
        <Giscus />
      </div>
    </article>
  </main>

  <MermaidRenderer />
  <InkAsk />

  {isLocked && (
    <script is:inline data-astro-rerun>
      (() => {
        const article = document.querySelector('[data-locked-post="true"]');
        const panel = document.querySelector('[data-lock-panel]');
        const content = document.querySelector('[data-locked-content="true"]');
        const form = document.querySelector('[data-lock-form]');
        const message = document.querySelector('[data-lock-message]');
        const expectedHash = article?.getAttribute('data-lock-key') || '';
        const storageKey = `post-unlocked:${location.pathname}:${expectedHash}`;
        const encoder = new TextEncoder();

        function getStoredUnlock() {
          try {
            return sessionStorage.getItem(storageKey) === '1';
          } catch {
            return false;
          }
        }

        function setStoredUnlock() {
          try {
            sessionStorage.setItem(storageKey, '1');
          } catch {
            // Some privacy modes block sessionStorage; unlocking still works for the current page.
          }
        }

        async function sha256(value) {
          const bytes = encoder.encode(value);
          if (!window.crypto?.subtle) {
            throw new Error('WebCrypto is unavailable');
          }
          const hashBuffer = await window.crypto.subtle.digest('SHA-256', bytes);
          return Array.from(new Uint8Array(hashBuffer))
            .map((byte) => byte.toString(16).padStart(2, '0'))
            .join('');
        }

        function unlock() {
          if (content) content.hidden = false;
          if (panel) panel.hidden = true;
          article?.setAttribute('data-locked-post', 'false');
        }

        if (!article || !panel || !content || !form || !expectedHash) return;
        if (form.dataset.lockBound === 'true') return;
        form.dataset.lockBound = 'true';

        if (getStoredUnlock()) {
          unlock();
          return;
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          const password = String(formData.get('password') ?? '');
          if (!password) return;

          try {
            const digest = await sha256(password);
            if (digest === expectedHash) {
              setStoredUnlock();
              unlock();
              window.dispatchEvent(new CustomEvent('post-unlocked'));
            } else if (message) {
              message.textContent = 'Password is incorrect.';
            }
          } catch {
            if (message) {
              message.textContent = 'This browser cannot verify the password here.';
            }
          }
        });
      })();
    </script>
  )}
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import CustomEase from 'gsap/CustomEase';

    gsap.registerPlugin(ScrollTrigger, CustomEase);
    CustomEase.create('post-enter', 'M0,0 C0.06,0.62 0.16,0.9 0.42,0.975 0.62,1.005 0.8,1 1,1');

    const CLEANUP_KEY = '__areSetPostRevealCleanup__';
    const LISTENER_KEY = '__areSetPostRevealBound__';
    const TRIGGER_PREFIX = 'post:';

    // Which reveal each direct child of the article gets — everything else is a plain block
    function revealKind(el: Element): string {
      if (el.classList.contains('mermaid-block') || el.hasAttribute('data-mermaid-code')) return 'mermaid';
      const tag = el.tagName;
      if (tag === 'H2') return 'heading';
      if (tag === 'H3' || tag === 'H4') return 'subheading';
      if (tag === 'PRE') return 'code';
      if (tag === 'TABLE') return 'table';
      if (tag === 'BLOCKQUOTE') return 'quote';
      if (tag === 'UL' || tag === 'OL') return 'list';
      if (tag === 'IMG') return 'image';
      if (tag === 'P' && el.children.length === 1 && el.firstElementChild?.tagName === 'IMG' && !el.textContent?.trim()) return 'image';
      return 'block';
    }

    function initPostReveal() {
      const previousCleanup = (window as any)[CLEANUP_KEY];
      if (typeof previousCleanup === 'function') previousCleanup();

      const prose = document.querySelector<HTMLElement>('[data-post-prose]');
      if (!prose) return;

      const controller = new AbortController();
      const { signal } = controller;
      const timers: number[] = [];
      const typewriterTimers: number[] = [];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      ScrollTrigger.getAll().forEach((trigger) => {
        if (String(trigger.vars.id || '').startsWith(TRIGGER_PREFIX)) trigger.kill();
      });

      // ---------- Title: characters drop in one by one ----------
      const title = document.querySelector<HTMLElement>('[data-post-title]');
      const header = document.querySelector<HTMLElement>('[data-post-header]') || title?.closest('header');
      const typed = document.querySelector<HTMLElement>('[data-post-typed]');

      if (typed) {
        const full = typed.dataset.full || typed.textContent || '';
        typed.dataset.full = full;
        // Pre-reserve rendered width so typing NEVER causes flexbox reflow
        const rect = typed.getBoundingClientRect();
        if (rect.width > 0) {
          typed.style.minWidth = `${Math.ceil(rect.width)}px`;
        }
      }

      if (title && !title.dataset.split) {
        const t0 = performance.now();
        const text = title.textContent?.trim() || '';
        title.textContent = '';
        title.dataset.split = 'true';
        const frag = document.createDocumentFragment();
        for (const ch of text) {
          const span = document.createElement('span');
          span.className = 'post-title-char';
          span.textContent = ch === ' ' ? ' ' : ch;
          frag.appendChild(span);
        }
        title.appendChild(frag);
        const splitTime = performance.now() - t0;
        if (splitTime > 1) {
          console.debug(`[perf:title-split] Split ${text.length} chars in ${splitTime.toFixed(2)}ms`);
        }
      }

      function startTitleAndDate() {
        if (signal.aborted) return;

        if (title) {
          title.classList.add('is-split-ready');
          const chars = title.querySelectorAll('.post-title-char');
          if (chars.length && !reduceMotion) {
            const t0 = performance.now();
            gsap.killTweensOf(chars);
            gsap.fromTo(chars,
              { y: 46, opacity: 0, rotation: () => gsap.utils.random(-7, 7) },
              {
                y: 0, opacity: 1, rotation: 0,
                duration: 1.3, ease: 'post-enter', stagger: 0.035, delay: 0.08, overwrite: 'auto',
                onComplete: () => {
                  gsap.set(chars, { clearProps: 'transform,opacity' });
                  title.classList.remove('is-split-ready');
                },
              }
            );
            const setupTime = performance.now() - t0;
            if (setupTime > 2) {
              console.debug(`[perf:title-tween] Setup ${chars.length} char tweens in ${setupTime.toFixed(2)}ms`);
            }
          }
        }

        // ---------- Date: typewriter ----------
        if (typed && !reduceMotion) {
          typewriterTimers.forEach((id) => window.clearTimeout(id));
          typewriterTimers.length = 0;
          const full = typed.dataset.full || typed.textContent || '';
          typed.textContent = '';
          typed.classList.add('is-typing');
          let i = 0;
          let totalTickCpuMs = 0;
          let tickCount = 0;
          const tick = () => {
            if (signal.aborted) return;
            const t0 = performance.now();
            i += 1;
            typed.textContent = full.slice(0, i);
            totalTickCpuMs += performance.now() - t0;
            tickCount += 1;
            if (i < full.length) {
              const tid = window.setTimeout(tick, 42);
              typewriterTimers.push(tid);
              timers.push(tid);
            } else {
              const tid = window.setTimeout(() => {
                typed.classList.remove('is-typing');
                console.info(`[perf:typewriter] Completed: ${tickCount} ticks, avg ${(totalTickCpuMs / Math.max(1, tickCount)).toFixed(2)}ms/tick, total CPU ${totalTickCpuMs.toFixed(2)}ms`);
              }, 900);
              typewriterTimers.push(tid);
              timers.push(tid);
            }
          };
          const tid = window.setTimeout(tick, 180);
          typewriterTimers.push(tid);
          timers.push(tid);
        }
      }

      function resetTitleAndDate() {
        if (title) {
          const chars = title.querySelectorAll('.post-title-char');
          gsap.killTweensOf(chars);
          gsap.set(chars, { opacity: 0, y: 46 });
          title.classList.add('is-split-ready');
        }
        if (typed) {
          typewriterTimers.forEach((id) => window.clearTimeout(id));
          typewriterTimers.length = 0;
          typed.classList.remove('is-typing');
          typed.textContent = '';
        }
      }

      // Bidirectional replay: observe header entering and exiting viewport
      let headerCanReplay = false;
      if (header && !reduceMotion) {
        const headerObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting && entry.boundingClientRect.bottom <= 0) {
              // Scrolled down past the header: silently reset and arm for replay
              headerCanReplay = true;
              resetTitleAndDate();
            } else if (entry.isIntersecting && headerCanReplay) {
              // Scrolled back up to top: replay title and date entrance
              headerCanReplay = false;
              startTitleAndDate();
            }
          });
        }, { threshold: 0 });
        headerObserver.observe(header);
        signal.addEventListener('abort', () => headerObserver.disconnect());
      }

      const isPendingTransition = Boolean((window as any).__postTransitionPending);
      if (isPendingTransition && !reduceMotion) {
        resetTitleAndDate();
        let fired = false;
        const trigger = () => {
          if (fired || signal.aborted) return;
          fired = true;
          startTitleAndDate();
        };
        window.addEventListener('post-transition-release', trigger, { signal, once: true });
        timers.push(window.setTimeout(trigger, 1200));
      } else {
        startTitleAndDate();
      }

      // ---------- Blocks: tag each direct child, reveal via IntersectionObserver ----------
      // Code blocks and images animate clip-path, and Chrome's IntersectionObserver treats a
      // target's own clip-path as clipping — so those get a wrapper that is observed instead.
      const tBlocks0 = performance.now();
      const blocks = (Array.from(prose.children) as HTMLElement[]).map((el) => {
        if (el.classList.contains('pr-wrap')) return el;
        const kind = revealKind(el);
        if (kind !== 'code' && kind !== 'image' && kind !== 'mermaid') return el;
        const wrap = document.createElement('div');
        wrap.className = 'pr-wrap';
        wrap.dataset.pr = kind;
        el.replaceWith(wrap);
        wrap.appendChild(el);
        return wrap;
      });
      blocks.forEach((el) => {
        const kind = el.dataset.pr || revealKind(el);
        el.dataset.pr = kind;
        el.classList.add('pr');
        if (kind === 'table') el.querySelectorAll('tr').forEach((row, i) => row.style.setProperty('--i', String(Math.min(i, 12))));
        if (kind === 'list') Array.from(el.children).forEach((li, i) => (li as HTMLElement).style.setProperty('--i', String(Math.min(i, 8))));
      });
      const tBlocksDuration = performance.now() - tBlocks0;
      if (tBlocksDuration > 2) {
        console.debug(`[perf:blocks-wrap] Prepared ${blocks.length} blocks in ${tBlocksDuration.toFixed(2)}ms`);
      }

      if (reduceMotion) {
        blocks.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            // Replays every time a block comes back into view
            entry.target.classList.toggle('is-in', entry.isIntersecting);
          });
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0 });
        blocks.forEach((el) => io.observe(el));
        signal.addEventListener('abort', () => io.disconnect());
      }

      // ---------- Reading spine: draws with scroll, ink dots per h2 ----------
      const body = document.querySelector<HTMLElement>('[data-post-body]');
      const spine = document.querySelector<HTMLElement>('[data-post-spine]');
      const spineLine = document.querySelector<SVGLineElement>('[data-post-spine-line]');
      const dots: HTMLElement[] = [];

      function placeDots() {
        if (!body || !spine) return;
        const h2s = Array.from(prose.querySelectorAll<HTMLElement>('h2'));
        const bodyTop = body.getBoundingClientRect().top;

        while (dots.length > h2s.length) {
          dots.pop()?.remove();
        }
        while (dots.length < h2s.length) {
          const dot = document.createElement('i');
          dot.className = 'post-spine-dot';
          spine.appendChild(dot);
          dots.push(dot);
        }

        const positions = h2s.map((h2) => {
          return Math.round(h2.getBoundingClientRect().top - bodyTop + parseFloat(getComputedStyle(h2).paddingTop) + 14);
        });
        positions.forEach((top, i) => {
          const dot = dots[i];
          if (dot) dot.style.top = `${top}px`;
        });
      }

      if (body && spine && spineLine && !reduceMotion) {
        placeDots();
        // Written straight from scroll progress (pathLength="1", so offset 1 → 0 is empty → full)
        const spineState = { p: 0 };
        const paint = () => { spineLine.style.strokeDashoffset = String(1 - spineState.p); };
        paint();
        ScrollTrigger.create({
          id: `${TRIGGER_PREFIX}spine`,
          trigger: body,
          start: 'top 65%',
          end: 'bottom 55%',
          onUpdate: (self) => {
            gsap.to(spineState, { p: self.progress, duration: 0.4, ease: 'power2.out', overwrite: true, onUpdate: paint });
          },
        });

        const headings = Array.from(prose.querySelectorAll<HTMLElement>('h2'));
        const litIo = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const index = headings.indexOf(entry.target as HTMLElement);
            const dot = dots[index];
            if (!dot) return;
            const passed = entry.isIntersecting || entry.boundingClientRect.top < 0;
            dot.classList.toggle('is-lit', passed);
          });
        }, { rootMargin: '-35% 0px -35% 0px' });
        headings.forEach((h) => litIo.observe(h));
        signal.addEventListener('abort', () => litIo.disconnect());

        // Images and fonts shift layout after first paint — keep the dots pinned to their headings.
        // Debounce and avoid calling ScrollTrigger.refresh() while Lenis is actively scrolling!
        let roTimer: number | null = null;
        const ro = new ResizeObserver(() => {
          if (roTimer) window.clearTimeout(roTimer);
          roTimer = window.setTimeout(() => {
            placeDots();
            if (!(window as any).lenis?.isScrolling) {
              ScrollTrigger.refresh();
            } else {
              const checkScroll = () => {
                if (!(window as any).lenis?.isScrolling) {
                  ScrollTrigger.refresh();
                } else {
                  window.setTimeout(checkScroll, 120);
                }
              };
              window.setTimeout(checkScroll, 120);
            }
          }, 150);
        });
        ro.observe(prose);
        signal.addEventListener('abort', () => {
          ro.disconnect();
          if (roTimer) window.clearTimeout(roTimer);
        });
      }

      // ---------- Series Tooltips: dynamic boundary clamping ----------
      const seriesContainer = document.querySelector<HTMLElement>('.series-dots');
      if (seriesContainer) {
        function updateSeriesTooltip(dot: HTMLElement) {
          const tip = dot.querySelector<HTMLElement>('.series-dot-tip');
          if (!tip) return;
          const dotRect = dot.getBoundingClientRect();
          const containerRect = seriesContainer!.getBoundingClientRect();
          const tipWidth = tip.offsetWidth || 220;
          const dotCenterX = dotRect.left + dotRect.width / 2;

          const clampedLeft = Math.max(
            containerRect.left,
            Math.min(dotCenterX - tipWidth / 2, containerRect.right - tipWidth)
          );
          const offsetFromDot = Math.round(clampedLeft - dotRect.left);
          const arrowX = Math.round(dotCenterX - clampedLeft);

          tip.style.setProperty('--tip-left', `${offsetFromDot}px`);
          tip.style.setProperty('--tip-translate', '0 6px');
          tip.style.setProperty('--tip-translate-active', '0 -2px');
          tip.style.setProperty('--arrow-left', `${arrowX}px`);
        }

        seriesContainer.querySelectorAll<HTMLElement>('.series-dot').forEach((dot) => {
          dot.addEventListener('pointerenter', () => updateSeriesTooltip(dot), { signal, passive: true });
          dot.addEventListener('focus', () => updateSeriesTooltip(dot), { signal, passive: true });
        });
      }

      (window as any)[CLEANUP_KEY] = () => {
        controller.abort();
        timers.forEach((id) => window.clearTimeout(id));
        typewriterTimers.forEach((id) => window.clearTimeout(id));
        if (title) {
          const chars = title.querySelectorAll('.post-title-char');
          gsap.killTweensOf(chars);
        }
        dots.forEach((d) => d.remove());
        ScrollTrigger.getAll().forEach((trigger) => {
          if (String(trigger.vars.id || '').startsWith(TRIGGER_PREFIX)) trigger.kill();
        });
        (window as any)[CLEANUP_KEY] = undefined;
      };
    }

    let initializedThisDocument = false;

    function runPostReveal(force = false) {
      if (initializedThisDocument && !force) return;
      initializedThisDocument = true;
      initPostReveal();
    }

    runPostReveal();

    if (!(window as any)[LISTENER_KEY]) {
      document.addEventListener('astro:page-load', () => runPostReveal());
      document.addEventListener('astro:after-swap', () => {
        initializedThisDocument = false;
      });
      // Locked posts reveal their body only after the password check
      window.addEventListener('post-unlocked', () => runPostReveal(true));
      (window as any)[LISTENER_KEY] = true;
    }
  </script>
  <script is:inline>
    (() => {
      const cleanupKey = '__areSetPostTocCleanup__';
      const initKey = '__areSetPostTocInit__';
      const listenerKey = '__areSetPostTocPageLoadBound__';

      function initPostToc() {
        const previousCleanup = window[cleanupKey];
        if (typeof previousCleanup === 'function') previousCleanup();

        const toc = document.querySelector('.post-toc');
        const prose = document.querySelector('[data-post-prose]');
        if (!toc || !prose) {
          window[cleanupKey] = null;
          return;
        }

        const controller = new AbortController();
        const { signal } = controller;
        const links = Array.from(toc.querySelectorAll('[data-toc-link]'));
        const headings = links
          .map((link) => {
            const id = link.getAttribute('data-toc-link');
            const heading = id ? prose.querySelector(`#${CSS.escape(id)}`) : null;
            return heading ? { link, heading } : null;
          })
          .filter(Boolean);

        function setActive(id) {
          links.forEach((link) => {
            link.classList.toggle('is-active', link.getAttribute('data-toc-link') === id);
          });
        }

        links.forEach((link) => {
          link.addEventListener('click', () => {
            const id = link.getAttribute('data-toc-link');
            if (id) setActive(id);
          }, { signal });
        });

        if (!headings.length || !('IntersectionObserver' in window)) {
          const firstId = links[0]?.getAttribute('data-toc-link');
          if (firstId) setActive(firstId);
          window[cleanupKey] = () => controller.abort();
          return;
        }

        const visible = new Map();
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const id = entry.target.id;
            if (!id) return;
            if (entry.isIntersecting) {
              visible.set(id, entry.boundingClientRect.top);
            } else {
              visible.delete(id);
            }
          });

          if (visible.size > 0) {
            const [id] = Array.from(visible.entries()).sort((a, b) => a[1] - b[1])[0];
            setActive(id);
            return;
          }

          const current = headings
            .map((item) => item.heading)
            .filter((heading) => heading.getBoundingClientRect().top <= 120)
            .at(-1);
          if (current?.id) setActive(current.id);
        }, {
          rootMargin: '-18% 0px -70% 0px',
          threshold: [0, 1],
        });

        headings.forEach(({ heading }) => observer.observe(heading));

        window[cleanupKey] = () => {
          controller.abort();
          observer.disconnect();
        };
      }

      window[initKey] = initPostToc;
      initPostToc();

      if (!window[listenerKey]) {
        window.addEventListener('post-unlocked', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });

        document.addEventListener('astro:page-load', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });
        window[listenerKey] = true;
      }
    })();
  </script>
  <script is:inline>
    (() => {
      const cleanupKey = '__areSetPostEnhancementsCleanup__';
      const initKey = '__areSetPostEnhancementsInit__';
      const listenerKey = '__areSetPostEnhancementsPageLoadBound__';

      function initPostEnhancements() {
        const previousCleanup = window[cleanupKey];
        if (typeof previousCleanup === 'function') previousCleanup();

        const prose = document.querySelector('[data-post-prose]');
        if (!prose) {
          window[cleanupKey] = null;
          return;
        }

        const controller = new AbortController();
        const { signal } = controller;
        let lastFocus = null;
        let previewOverlay = null;
        const previewCache = new Map();

        function enhanceCodeBlocks() {
          prose.querySelectorAll('pre').forEach((pre) => {
            if (pre.dataset.codeEnhanced === 'true') return;
            if (pre.closest('.mermaid-block')) return;
            const code = pre.querySelector('code');
            if (!code) return;

            pre.dataset.codeEnhanced = 'true';
            const className = code.className || '';
            const languageMatch = className.match(/(?:language|lang)-([a-z0-9_+#.-]+)/i);
            const language = (languageMatch?.[1] || pre.getAttribute('data-language') || 'code').toLowerCase();

            const toolbar = document.createElement('div');
            toolbar.className = 'code-block-toolbar';

            // `title="MyActor.h"` on the fence becomes the primary label (see astro.config.mjs)
            const fileName = pre.getAttribute('data-title');
            if (fileName) {
              toolbar.dataset.titled = 'true';
              const titleEl = document.createElement('span');
              titleEl.className = 'code-block-title';
              titleEl.textContent = fileName;
              toolbar.appendChild(titleEl);
            }

            const label = document.createElement('span');
            label.className = 'code-block-language';
            label.textContent = language;

            const copyButton = document.createElement('button');
            copyButton.className = 'code-copy-button';
            copyButton.type = 'button';
            copyButton.textContent = 'Copy';
            copyButton.setAttribute('aria-label', '复制代码');

            copyButton.addEventListener('click', async () => {
              const text = code.textContent || '';
              try {
                await navigator.clipboard.writeText(text);
                copyButton.textContent = 'Copied';
                window.setTimeout(() => {
                  copyButton.textContent = 'Copy';
                }, 1400);
              } catch {
                copyButton.textContent = 'Failed';
                window.setTimeout(() => {
                  copyButton.textContent = 'Copy';
                }, 1400);
              }
            }, { signal });

            toolbar.append(label, copyButton);
            pre.prepend(toolbar);
          });
        }

        function bindAnchorScroll() {
          prose.addEventListener('click', (event) => {
            if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            const anchor = event.target instanceof Element ? event.target.closest('a[href^="#"]') : null;
            if (!anchor) return;
            const href = anchor.getAttribute('href') || '';
            if (href.length <= 1) return;

            const targetId = decodeURIComponent(href.slice(1));
            const targetEl = document.getElementById(targetId) || prose.querySelector(`#${CSS.escape(targetId)}`);
            if (targetEl) {
              event.preventDefault();
              if (window.lenis) {
                window.lenis.scrollTo(targetEl, { offset: -70 });
              } else {
                targetEl.scrollIntoView({ behavior: 'smooth' });
              }
              history.pushState(null, '', href);
            }
          }, { signal });
        }

        enhanceCodeBlocks();
        bindAnchorScroll();

        window[cleanupKey] = () => {
          controller.abort();
        };
      }

      window[initKey] = initPostEnhancements;
      initPostEnhancements();

      if (!window[listenerKey]) {
        window.addEventListener('post-unlocked', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });

        document.addEventListener('astro:page-load', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });
        window[listenerKey] = true;
      }
    })();
  </script>

