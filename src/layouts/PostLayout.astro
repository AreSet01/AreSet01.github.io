          linkPopover.innerHTML = `
            <div class="post-link-popover-head">
              <span class="post-link-popover-badge">章节速览</span>
              <span class="post-link-popover-meta"></span>
            </div>
            <h4 class="post-link-popover-title"></h4>
            <p class="post-link-popover-excerpt"></p>
            <div class="post-link-popover-actions">
              <a class="post-link-popover-go" href="#">直达阅读 →</a>
              <button type="button" class="post-link-popover-pin">
                <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14v-2l-2-2V5a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v8l-2 2v2z"></path></svg>
                <span>钉入对照台</span>
              </button>
            </div>
          `;
          document.body.appendChild(linkPopover);

          linkPopover.addEventListener('pointerenter', () => {
            window.clearTimeout(hidePopoverTimer);
          }, { signal });

          linkPopover.addEventListener('pointerleave', () => {
            scheduleHidePopover();
          }, { signal });

          const goBtn = linkPopover.querySelector('.post-link-popover-go');
          goBtn?.addEventListener('click', (e) => {
            const href = goBtn.getAttribute('href') || '';
            if (href.startsWith('#')) {
              e.preventDefault();
              const id = decodeURIComponent(href.slice(1));
              const targetEl = document.getElementById(id) || prose.querySelector(`#${CSS.escape(id)}`);
              if (targetEl) {
                hideLinkPopover();
                if (window.lenis) window.lenis.scrollTo(targetEl, { offset: -70 });
                else targetEl.scrollIntoView({ behavior: 'smooth' });
                history.pushState(null, '', href);
                pulseHeadingTarget(targetEl);
              }
            }
          }, { signal });

          const pinBtn = linkPopover.querySelector('.post-link-popover-pin');
          pinBtn?.addEventListener('click', () => {
            const title = linkPopover.querySelector('.post-link-popover-title')?.textContent || '文内摘录';
            const excerpt = linkPopover.querySelector('.post-link-popover-excerpt')?.textContent || '';
            const badge = linkPopover.querySelector('.post-link-popover-badge')?.textContent || '链接速览';
            if (window.__pinWorkbench && typeof window.__pinWorkbench.pinExcerpt === 'function') {
              window.__pinWorkbench.pinExcerpt({
                text: `【${title}】\n${excerpt}`,
                chapter: badge,
                triggerEl: pinBtn,
              });
              hideLinkPopover();
            }
          }, { signal });

          return linkPopover;
        }

        function hideLinkPopover() {
          window.clearTimeout(hoverIntentTimer);
          window.clearTimeout(hidePopoverTimer);
          activePreviewAnchor = null;
          if (!linkPopover) return;
          linkPopover.classList.remove('is-visible');
          window.setTimeout(() => {
            if (linkPopover && !linkPopover.classList.contains('is-visible')) {
              linkPopover.hidden = true;
            }
          }, 200);
        }

        function scheduleHidePopover() {
          window.clearTimeout(hidePopoverTimer);
          hidePopoverTimer = window.setTimeout(() => {
            hideLinkPopover();
          }, 190);
        }

        function extractSectionPreview(rootDoc, hashId) {
          if (hashId) {
            const target = rootDoc.getElementById(hashId) || (window.CSS && CSS.escape ? rootDoc.querySelector(`#${CSS.escape(hashId)}`) : null);
            if (target) {
              const title = (target.textContent || '').replace(/#$/, '').trim();
              let text = '';
              let sibling = target.nextElementSibling;
              while (sibling && !/^H[1-3]$/.test(sibling.tagName) && text.length < 150) {
                if (sibling.tagName === 'P' || sibling.tagName === 'UL' || sibling.tagName === 'OL' || sibling.tagName === 'BLOCKQUOTE') {
                  text += (text ? ' ' : '') + (sibling.textContent || '').trim();
                }
                sibling = sibling.nextElementSibling;
              }
              return {
                title: title || hashId,
                excerpt: (text || '点击直达该章节段落阅读详情。').slice(0, 145) + (text.length > 145 ? '…' : ''),
              };
            }
          }
          const h1 = rootDoc.querySelector('[data-post-title], article h1, main h1, title');
          const firstP = rootDoc.querySelector('[data-post-prose] > p, article p, main p');
          const rawTitle = (h1?.textContent || '').trim();
          const rawExcerpt = (firstP?.textContent || '').trim();
          return {
            title: rawTitle || '文章速览',
            excerpt: (rawExcerpt || '点击直达阅读全文内容。').slice(0, 145) + (rawExcerpt.length > 145 ? '…' : ''),
          };
        }

        async function openLinkPopoverForAnchor(anchor) {
          const rawHref = anchor.getAttribute('href') || '';
          if (!rawHref) return;
          let urlObj;
          try {
            urlObj = new URL(rawHref, window.location.href);
          } catch {
            return;
          }
          if (urlObj.origin !== window.location.origin) return;
          const isSamePageHash = urlObj.pathname === window.location.pathname && urlObj.hash.length > 1;
          const isInternalPost = /^\/posts\/[^/]+\/?$/.test(urlObj.pathname);
          if (!isSamePageHash && !isInternalPost) return;

          const pop = ensureLinkPopover();
          const badgeEl = pop.querySelector('.post-link-popover-badge');
          const metaEl = pop.querySelector('.post-link-popover-meta');
          const titleEl = pop.querySelector('.post-link-popover-title');
          const excerptEl = pop.querySelector('.post-link-popover-excerpt');
          const goEl = pop.querySelector('.post-link-popover-go');

          const hashId = urlObj.hash ? decodeURIComponent(urlObj.hash.slice(1)) : '';
          let previewData = null;

          if (isSamePageHash) {
            previewData = extractSectionPreview(document, hashId);
            if (badgeEl) badgeEl.textContent = '本文节选';
            if (metaEl) metaEl.textContent = `#${hashId.slice(0, 20)}`;
            if (goEl) goEl.setAttribute('href', `#${encodeURIComponent(hashId)}`);
          } else {
            if (badgeEl) badgeEl.textContent = '关联文章';
            if (metaEl) metaEl.textContent = urlObj.pathname.replace(/^\/posts\/|\/$/g, '');
            if (goEl) goEl.setAttribute('href', urlObj.pathname + urlObj.hash);

            const cacheKey = urlObj.pathname;
            let doc = previewCache.get(cacheKey);
            if (!doc) {
              try {
                const res = await fetch(urlObj.pathname, { headers: { Accept: 'text/html' } });
                if (!res.ok) return;
                const html = await res.text();
                doc = new DOMParser().parseFromString(html, 'text/html');
                previewCache.set(cacheKey, doc);
              } catch {
                return;
              }
            }
            if (activePreviewAnchor !== anchor) return;
            previewData = extractSectionPreview(doc, hashId);
          }

          if (!previewData) return;
          if (titleEl) titleEl.textContent = previewData.title;
          if (excerptEl) excerptEl.textContent = previewData.excerpt;

          pop.hidden = false;
          const rect = anchor.getBoundingClientRect();
          const popW = Math.min(340, window.innerWidth - 24);
          let left = rect.left + rect.width / 2 - popW / 2;
          left = Math.max(12, Math.min(window.innerWidth - popW - 12, left));
          const preferTop = rect.top > 210;
          pop.style.width = `${popW}px`;
          pop.style.left = `${Math.round(left)}px`;
          if (preferTop) {
            pop.style.top = `${Math.round(rect.top - 10)}px`;
            pop.dataset.placement = 'top';
          } else {
            pop.style.top = `${Math.round(rect.bottom + 10)}px`;
            pop.dataset.placement = 'bottom';
          }
          void pop.offsetWidth;
          pop.classList.add('is-visible');
        }

        function initLinkPreviews() {
          prose.addEventListener('pointerover', (e) => {
            if (window.matchMedia('(hover: none)').matches) return;
            const anchor = e.target instanceof Element ? e.target.closest('a[href]') : null;
            if (!anchor || anchor.classList.contains('heading-anchor-btn')) return;
            const href = anchor.getAttribute('href') || '';
            if (!href.startsWith('#') && !href.startsWith('/posts/') && !href.includes('/posts/')) return;
            window.clearTimeout(hidePopoverTimer);
            if (activePreviewAnchor === anchor) return;
            activePreviewAnchor = anchor;
            window.clearTimeout(hoverIntentTimer);
            hoverIntentTimer = window.setTimeout(() => {
              openLinkPopoverForAnchor(anchor);
            }, 260);
          }, { signal });

          prose.addEventListener('pointerout', (e) => {
            const anchor = e.target instanceof Element ? e.target.closest('a[href]') : null;
            if (!anchor) return;
            const related = e.relatedTarget instanceof Element ? e.relatedTarget : null;
            if (related && (anchor.contains(related) || (linkPopover && linkPopover.contains(related)))) return;
            window.clearTimeout(hoverIntentTimer);
            scheduleHidePopover();
          }, { signal });
        }

        enhanceCalloutBlocks();
        enhanceCodeBlocks();
        enhanceHeadingAnchors();
        bindAnchorScroll();
        initLinkPreviews();

        if (location.hash && location.hash.length > 1) {
          const initialId = decodeURIComponent(location.hash.slice(1));
          const initialTarget = document.getElementById(initialId) || (window.CSS && CSS.escape ? prose.querySelector(`#${CSS.escape(initialId)}`) : null);
          if (initialTarget && /^H[2-3]$/.test(initialTarget.tagName)) {
            window.setTimeout(() => pulseHeadingTarget(initialTarget), 360);
          }
        }

        window[cleanupKey] = () => {
          window.clearTimeout(hoverIntentTimer);
          window.clearTimeout(hidePopoverTimer);
          if (linkPopover) {
            linkPopover.remove();
            linkPopover = null;
          }
          controller.abort();
        };
      }

      window[initKey] = initPostEnhancements;
      initPostEnhancements();

      if (!window[listenerKey]) {
        window.addEventListener('post-unlocked', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });

        document.addEventListener('astro:page-load', () => {
          const init = window[initKey];
          if (typeof init === 'function') init();
        });
        window[listenerKey] = true;
      }
    })();
  </script>

