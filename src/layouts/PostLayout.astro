---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

import TagList from '../components/TagList.astro';
import Giscus from '../components/Giscus.astro';
import MermaidRenderer from '../components/MermaidRenderer.astro';
import CompanionLayout from '../components/CompanionLayout.astro';
import InkAsk from '../components/InkAsk.astro';
import PinWorkbench from '../components/PinWorkbench.astro';
import ArticleSearch from '../components/ArticleSearch.astro';
import ArticleSelectionDock from '../components/ArticleSelectionDock.astro';
import { formatDate } from '../utils/date';

interface SeriesLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  tags?: string[];
  category?: string;
  readingMinutes?: number;
  series?: {
    name: string;
    current: number;
    total: number;
    parts: Array<SeriesLink & { index: number }>;
    prev?: SeriesLink;
    next?: SeriesLink;
  };
  locked?: boolean;
  passwordHash?: string;
  passwordHint?: string;
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  category,
  readingMinutes,
  series,
  locked = false,
  passwordHash,
  passwordHint,
  headings = [],
} = Astro.props;
const isLocked = locked && Boolean(passwordHash);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const hasToc = tocHeadings.length > 1;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main-content" tabindex="-1" class="container-medium flex-1 pt-6 pb-28 lg:pt-8 outline-none">
    <article
      class="space-y-14"
      data-post-title-hold="true"
      data-locked-post={isLocked ? 'true' : undefined}
      data-lock-key={isLocked ? passwordHash : undefined}
    >
      <header class="panel flex flex-col" data-post-header>
        <div class="flex flex-wrap items-center gap-3 font-mono text-[0.72rem] tracking-[0.1em] uppercase text-[var(--muted)]" data-enter="left">
          <a href="/archive" class="transition hover:text-[var(--accent)]">Archive</a>
          <span class="opacity-40">/</span>
          <span data-post-typed>{formatDate(pubDate)}</span>
          {category && (
            <>
              <span class="opacity-40">/</span>
              <a href={`/archive?category=${encodeURIComponent(category)}`} class="transition hover:text-[var(--accent)]">
                {category}
              </a>
            </>
          )}
          {readingMinutes && (
            <>
              <span class="opacity-40">/</span>
              <span>{readingMinutes} min read</span>
            </>
          )}
          {isLocked && <span class="lock-mark">Locked</span>}
        </div>
        <h1 class="section-title post-title mt-7 mb-6 max-w-3xl" style="font-size: clamp(2.2rem, 4.5vw, 3.2rem);" data-post-title>
          <span class="post-title-calligraphy" data-post-title-calligraphy>
            <span class="post-title-text" data-post-title-text>{title}</span>
          </span>
        </h1>
        {description && (
          <p
            class="mt-7 max-w-2xl text-[1.05rem] leading-[1.78] text-[var(--muted-strong)]"
            style="font-family: var(--font-serif); font-style: italic;"
            data-enter="left"
          >
            {description}
          </p>
        )}
        {tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-[var(--rule)]" style="border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;" data-enter="bottom">
            <TagList tags={tags} />
          </div>
        )}
      </header>
      {series && (
        <nav class="series-strip" data-enter="bottom" data-no-replay aria-label={`系列：${series.name}`}>
          <div class="series-strip-head">
            <span class="series-strip-kicker">Series</span>
            <span class="series-strip-name">{series.name}</span>
            <span class="series-strip-count">{series.current} / {series.total}</span>
          </div>
          <ol class="series-dots">
            {series.parts.map((part) => {
              const isCurrent = part.index === series.current;
              const isDone = part.index < series.current;
              const badgeText = isCurrent ? '当前阅读' : isDone ? '已阅' : `待读`;
              return (
                <li>
                  <a
                    href={part.href}
                    class:list={['series-dot', { 'is-current': isCurrent, 'is-done': isDone }]}
                    aria-current={isCurrent ? 'step' : undefined}
                  >
                    <span class="series-dot-mark" aria-hidden="true"></span>
                    <span class="series-dot-tip">
                      <span class="series-dot-tip-head">
                        <span class="series-dot-tip-num">PART {String(part.index).padStart(2, '0')}</span>
                        <span class:list={['series-dot-tip-badge', { 'is-current': isCurrent }]}>{badgeText}</span>
                      </span>
                      <span class="series-dot-tip-title">{part.title}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ol>
        </nav>
      )}
      {isLocked && (
        <section
          class="lock-panel panel py-10"
          data-lock-panel
          data-enter="scale"
        >
          <p class="eyebrow">Protected Note</p>
          <h2 class="font-display mt-5 text-[1.55rem] text-[var(--text-strong)]">
            输入密码可查看噢～
          </h2>
          {passwordHint && (
            <p
              class="mt-4 text-[0.94rem] leading-relaxed text-[var(--muted-strong)]"
              style="font-family: var(--font-serif); font-style: italic;"
            >
              Hint：{passwordHint}
            </p>
          )}
          <form class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end" data-lock-form>
            <label class="flex-1">
              <span class="stat-label">Password</span>
              <input
                class="lock-input mt-2"
                type="password"
                name="password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
              />
            </label>
            <button class="btn-primary whitespace-nowrap" type="submit">Unlock →</button>
          </form>
          <p class="lock-message mt-5" data-lock-message aria-live="polite"></p>
        </section>
      )}
      <div
        class="space-y-6"
        data-locked-content={isLocked ? 'true' : undefined}
        hidden={isLocked}
      >
        {hasToc && (
          <details class="post-toc panel" open aria-labelledby="post-toc-title" data-enter="bottom" data-no-replay data-lenis-prevent>
            <summary class="post-toc-summary" data-lenis-prevent>
              <div class="flex items-center gap-2">
                <span class="post-toc-caret" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
                <span class="post-toc-kicker">Navigation</span>
                <span class="opacity-30">/</span>
                <span id="post-toc-title" class="post-toc-title">文章目录</span>
              </div>
              <div class="post-toc-tools flex items-center gap-2">
                <button
                  type="button"
                  id="post-toc-search-btn"
                  class="post-toc-search-btn max-sm:hidden"
                  data-article-search-trigger
                  aria-label="搜索本文 (⌘F 或 /)"
                  title="搜索本文 (⌘F 或 /)"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>
                  <span>搜本文</span>
                  <kbd class="post-toc-search-kbd">⌘F</kbd>
                </button>
                <button
                  type="button"
                  id="post-toc-notes-btn"
                  class="post-toc-search-btn max-sm:hidden"
                  data-article-notes-trigger
                  aria-label="查看文章高亮笔记"
                  title="查看高亮笔记"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 11-6 6v3h3l6-6"></path>
                    <path d="m22 2-2.5 2.5a2.12 2.12 0 0 1-3 0l-1-1a2.12 2.12 0 0 1 0-3L18 0z"></path>
                    <path d="M14.5 5.5 18.5 9.5"></path>
                  </svg>
                  <span>笔记</span>
                  <span class="post-toc-notes-badge" data-notes-count>0</span>
                </button>
                <span class="post-toc-badge">{tocHeadings.length} 节</span>
              </div>
            </summary>
            <div class="post-toc-expander">
              <div class="post-toc-inner" data-lenis-prevent>
                <nav class="post-toc-nav" aria-label="文章目录" data-lenis-prevent>
                  {tocHeadings.map((heading) => (
                    <a
                      href={`#${heading.slug}`}
                      class={`post-toc-link depth-${heading.depth}`}
                      data-toc-link={heading.slug}
                    >
                      <span class="toc-bullet" />
                      <span class="toc-text">{heading.text}</span>
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          </details>
        )}
        <div class="panel post-body rounded-[20px] px-4 py-6 sm:px-6 md:px-10 md:py-10" data-post-body>
          <div class="post-spine" aria-hidden="true" data-post-spine>
            <svg preserveAspectRatio="none" viewBox="0 0 2 100">
              <line x1="1" y1="0" x2="1" y2="100" pathLength="1" data-post-spine-line />
            </svg>
          </div>
          <div class="prose" data-post-prose>
            <slot />
          </div>
        </div>
      </div>
      {series && (series.prev || series.next) && (
        <nav class="series-ends" data-enter="bottom" data-no-replay aria-label="系列上下篇">
          {series.prev ? (
            <a class="series-end is-prev" href={series.prev.href}>
              <span>← 上一篇</span>
              <strong>{series.prev.title}</strong>
            </a>
          ) : (
            <span class="series-end is-empty">已是系列第一篇</span>
          )}
          {series.next ? (
            <a class="series-end is-next" href={series.next.href}>
              <span>下一篇 →</span>
              <strong>{series.next.title}</strong>
            </a>
          ) : (
            <span class="series-end is-empty">已是系列最后一篇</span>
          )}
        </nav>
      )}
      <div class="pt-6 border-t border-[var(--rule)]" data-enter="bottom" data-no-replay style="border-image: linear-gradient(to right, transparent 5%, var(--rule) 50%, transparent 95%) 1;">
        <p class="eyebrow mb-6">Discussion</p>
        <Giscus />
      </div>
    </article>
  </main>

  <MermaidRenderer />
  <CompanionLayout />
  <InkAsk />
  <PinWorkbench />
  <ArticleSearch />
  <ArticleSelectionDock />
  <div class="article-floating-actions" id="article-floating-actions">
    <script is:inline data-astro-rerun>
      (() => {
        const container = document.getElementById('article-floating-actions');
        const notesPill = document.getElementById('article-highlights-floating-pill');
        const searchPill = document.getElementById('article-search-floating-pill');
        if (container && notesPill && searchPill) {
          if (notesPill.parentElement !== container) container.appendChild(notesPill);
          if (searchPill.parentElement !== container) container.appendChild(searchPill);
        }
      })();
    </script>
  </div>

  {isLocked && (
    <script is:inline data-astro-rerun>
      (() => {
        const article = document.querySelector('[data-locked-post="true"]');
        const panel = document.querySelector('[data-lock-panel]');
        const content = document.querySelector('[data-locked-content="true"]');
        const form = document.querySelector('[data-lock-form]');
        const message = document.querySelector('[data-lock-message]');
        const expectedHash = article?.getAttribute('data-lock-key') || '';
        const storageKey = `post-unlocked:${location.pathname}:${expectedHash}`;
        const encoder = new TextEncoder();

        function getStoredUnlock() {
          try {
            return sessionStorage.getItem(storageKey) === '1';
          } catch {
            return false;
          }
        }

        function setStoredUnlock() {
          try {
            sessionStorage.setItem(storageKey, '1');
          } catch {
            // Some privacy modes block sessionStorage; unlocking still works for the current page.
          }
        }

        async function sha256(value) {
          const bytes = encoder.encode(value);
          if (!window.crypto?.subtle) {
            throw new Error('WebCrypto is unavailable');
          }
          const hashBuffer = await window.crypto.subtle.digest('SHA-256', bytes);
          return Array.from(new Uint8Array(hashBuffer))
            .map((byte) => byte.toString(16).padStart(2, '0'))
            .join('');
        }

        function unlock() {
          if (content) content.hidden = false;
          if (panel) panel.hidden = true;
          article?.setAttribute('data-locked-post', 'false');
        }

        if (!article || !panel || !content || !form || !expectedHash) return;
        if (form.dataset.lockBound === 'true') return;
        form.dataset.lockBound = 'true';

        if (getStoredUnlock()) {
          unlock();
          return;
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          const password = String(formData.get('password') ?? '');
          if (!password) return;

          try {
            const digest = await sha256(password);
            if (digest === expectedHash) {
              setStoredUnlock();
              unlock();
              window.dispatchEvent(new CustomEvent('post-unlocked'));
            } else if (message) {
              message.textContent = 'Password is incorrect.';
            }
          } catch {
            if (message) {
              message.textContent = 'This browser cannot verify the password here.';
            }
          }
        });
      })();
    </script>
  )}
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import CustomEase from 'gsap/CustomEase';

    gsap.registerPlugin(ScrollTrigger, CustomEase);
    CustomEase.create('post-enter', 'M0,0 C0.06,0.62 0.16,0.9 0.42,0.975 0.62,1.005 0.8,1 1,1');

    const CLEANUP_KEY = '__areSetPostRevealCleanup__';
    const LISTENER_KEY = '__areSetPostRevealBound__';
    const TRIGGER_PREFIX = 'post:';

    // Which reveal each direct child of the article gets — everything else is a plain block
    function revealKind(el: Element): string {
      if (el.classList.contains('mermaid-block') || el.hasAttribute('data-mermaid-code')) return 'mermaid';
      if (el.classList.contains('table-scroll')) return 'table';
      const tag = el.tagName;
      if (tag === 'H2') return 'heading';
      if (tag === 'H3' || tag === 'H4') return 'subheading';
      if (tag === 'PRE') return 'code';
      if (tag === 'TABLE') return 'table';
      if (tag === 'BLOCKQUOTE') return 'quote';
      if (tag === 'UL' || tag === 'OL') return 'list';
      if (tag === 'IMG') return 'image';
      if (tag === 'P' && el.children.length === 1 && el.firstElementChild?.tagName === 'IMG' && !el.textContent?.trim()) return 'image';
      return 'block';
    }

    function initPostReveal() {
      const previousCleanup = (window as any)[CLEANUP_KEY];
      if (typeof previousCleanup === 'function') previousCleanup();

      const prose = document.querySelector<HTMLElement>('[data-post-prose]');
      if (!prose) return;

      const controller = new AbortController();
      const { signal } = controller;
      const timers: number[] = [];
      const typewriterTimers: number[] = [];
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      ScrollTrigger.getAll().forEach((trigger) => {
        if (String(trigger.vars.id || '').startsWith(TRIGGER_PREFIX)) trigger.kill();
      });

      // ---------- Decoupled Title & Date Entrance (Optical Center -> Header Dock) ----------
      const title = document.querySelector<HTMLElement>('[data-post-title]');
      const header = document.querySelector<HTMLElement>('[data-post-header]') || title?.closest('header');
      const typed = document.querySelector<HTMLElement>('[data-post-typed]');
      const article = title?.closest('article') || document.querySelector<HTMLElement>('article');
      if (article && !reduceMotion && !window.location.hash) {
        article.setAttribute('data-post-title-hold', 'true');
      }

      if (typed) {
        const full = typed.dataset.full || typed.textContent || '';
        typed.dataset.full = full;
        // Pre-reserve rendered width so typing NEVER causes flexbox reflow
        const rect = typed.getBoundingClientRect();
        if (rect.width > 0) {
          typed.style.minWidth = `${Math.ceil(rect.width)}px`;
        }
      }

      // Living Calligraphy: 【错落淡入 · Stagger Fade】字韵流转
      const titleText = title?.querySelector<HTMLElement>('[data-post-title-text]');
      let charNodes: HTMLElement[] = [];
      const chars: HTMLElement[] = []; // backward compatibility
      let cancelActiveSpatters: (() => void) | null = null;

      function splitTitleToStaggerNodes(el: HTMLElement): HTMLElement[] {
        const raw = el.dataset.fullTitle || el.textContent || '';
        el.dataset.fullTitle = raw;
        el.innerHTML = '';
        const tokens = raw.match(/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]|[^\s\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\p{Script=Hangul}]+|\s+/gu) || [raw];
        const nodes: HTMLElement[] = [];

        tokens.forEach((token) => {
          if (/^\s+$/.test(token)) {
            const space = document.createElement('span');
            space.className = 'post-title-space';
            space.innerHTML = '&nbsp;';
            el.appendChild(space);
          } else {
            const span = document.createElement('span');
            span.className = 'post-title-char';
            span.textContent = token;
            el.appendChild(span);
            nodes.push(span);
          }
        });

        return nodes;
      }

      function startTypewriterDate(immediate = false) {
        if (!typed) return;
        typewriterTimers.forEach((id) => window.clearTimeout(id));
        typewriterTimers.length = 0;
        const full = typed.dataset.full || typed.textContent || '';
        if (immediate || reduceMotion) {
          typed.textContent = full;
          typed.classList.remove('is-typing');
          return;
        }
        typed.textContent = '';
        typed.classList.add('is-typing');
        let i = 0;
        let totalTickCpuMs = 0;
        let tickCount = 0;
        const tick = () => {
          if (signal.aborted) return;
          const t0 = performance.now();
          i += 1;
          typed.textContent = full.slice(0, i);
          totalTickCpuMs += performance.now() - t0;
          tickCount += 1;
          if (i < full.length) {
            const tid = window.setTimeout(tick, 48);
            typewriterTimers.push(tid);
            timers.push(tid);
          } else {
            const tid = window.setTimeout(() => {
              typed.classList.remove('is-typing');
            }, 500);
            typewriterTimers.push(tid);
            timers.push(tid);
          }
        };
        const tid = window.setTimeout(tick, 80);
        typewriterTimers.push(tid);
        timers.push(tid);
      }

      let isTitleDocked = false;
      let titleEntranceTimeline: gsap.core.Timeline | null = null;
      let removeInterruptListeners: (() => void) | null = null;
      let isScrollLocked = false;
      let preventScrollCleanup: (() => void) | null = null;

      function lockScroll() {
        if (isScrollLocked) return;
        isScrollLocked = true;
        document.documentElement.setAttribute('data-post-title-hold', 'true');
        document.body.setAttribute('data-post-title-hold', 'true');
        document.documentElement.style.overflow = 'hidden';
        try {
          (window as any).lenis?.stop();
        } catch {}

        const preventScroll = (e: Event) => {
          if (e.cancelable) e.preventDefault();
        };
        window.addEventListener('wheel', preventScroll, { passive: false, capture: true });
        window.addEventListener('touchmove', preventScroll, { passive: false, capture: true });
        preventScrollCleanup = () => {
          window.removeEventListener('wheel', preventScroll, { capture: true } as any);
          window.removeEventListener('touchmove', preventScroll, { capture: true } as any);
        };
      }

      function unlockScroll() {
        if (!isScrollLocked) return;
        isScrollLocked = false;
        if (preventScrollCleanup) {
          preventScrollCleanup();
          preventScrollCleanup = null;
        }
        document.documentElement.removeAttribute('data-post-title-hold');
        document.body.removeAttribute('data-post-title-hold');
        document.documentElement.style.overflow = '';
        try {
          (window as any).lenis?.start();
        } catch {}
      }

      function cleanupInterrupt() {
        if (removeInterruptListeners) {
          removeInterruptListeners();
          removeInterruptListeners = null;
        }
      }

      function releaseDockedStage(instantDate = false) {
        if (isTitleDocked || signal.aborted) return;
        isTitleDocked = true;
        cleanupInterrupt();
        unlockScroll();

        if (titleEntranceTimeline) {
          titleEntranceTimeline.kill();
          titleEntranceTimeline = null;
        }
        if (title) {
          gsap.killTweensOf(title);
          gsap.set(title, { clearProps: 'transform,position,zIndex,--title-bar-opacity,--title-bar-scale' });
          title.classList.remove('is-split-ready', 'is-center-stage');
        }
        if (cancelActiveSpatters) {
          cancelActiveSpatters();
          cancelActiveSpatters = null;
        }
        if (titleText) {
          gsap.killTweensOf(titleText);
          gsap.set(titleText, { clearProps: 'transform,opacity,filter' });
        }
        if (charNodes.length) {
          gsap.killTweensOf(charNodes);
          gsap.set(charNodes, { clearProps: 'transform,opacity,filter' });
        }
        if (chars.length) {
          gsap.killTweensOf(chars);
          gsap.set(chars, { clearProps: 'transform,opacity' });
        }

        const art = article || document.querySelector('article');
        art?.removeAttribute('data-post-title-hold');
        document.documentElement.removeAttribute('data-post-title-hold');
        document.body.removeAttribute('data-post-title-hold');
        (window as any).__postTitleHoldPending = false;

        // Release BaseLayout page entrance (including sidebar & header elements)
        (window as any).__releasePageEnter?.({ fromPostTitleHold: true });

        // Smoothly entrance post-body container and InkAsk floating pill
        const postBodyEl = document.querySelector<HTMLElement>('[data-post-body]');
        if (postBodyEl && !reduceMotion) {
          gsap.killTweensOf(postBodyEl);
          gsap.fromTo(
            postBodyEl,
            { opacity: 0, y: 24 },
            { opacity: 1, y: 0, duration: 0.78, ease: 'post-enter', clearProps: 'transform,opacity' }
          );
        }
        const inkAskBtn = document.querySelector<HTMLElement>('.ink-ask-sidebar-trigger');
        if (inkAskBtn && !reduceMotion) {
          gsap.killTweensOf(inkAskBtn);
          gsap.fromTo(
            inkAskBtn,
            { opacity: 0, y: -8 },
            { opacity: 1, y: 0, duration: 0.55, delay: 0.12, ease: 'power2.out', clearProps: 'transform,opacity' }
          );
        }

        startTypewriterDate(instantDate);
        if (typeof (window as any).__revealInViewBlocks__ === 'function') {
          if (reduceMotion) {
            (window as any).__revealInViewBlocks__();
          } else {
            // Wait one frame after removing visibility:hidden so .prose .pr transitions smoothly
            requestAnimationFrame(() => {
              if (signal.aborted) return;
              (window as any).__revealInViewBlocks__?.();
              requestAnimationFrame(() => {
                if (signal.aborted) return;
                (window as any).__revealInViewBlocks__?.();
              });
            });
          }
        }
      }

      function fastForwardTitle() {
        releaseDockedStage(true);
      }

      function setupInterruptHandlers() {
        cleanupInterrupt();
        const onInterrupt = () => {
          fastForwardTitle();
        };
        const onKey = (ke: KeyboardEvent) => {
          if ([' ', 'Enter', 'Escape', 'Spacebar'].includes(ke.key)) {
            fastForwardTitle();
          }
        };

        window.addEventListener('wheel', onInterrupt, { passive: true, capture: true, signal });
        window.addEventListener('touchstart', onInterrupt, { passive: true, capture: true, signal });
        window.addEventListener('touchmove', onInterrupt, { passive: true, capture: true, signal });
        window.addEventListener('pointerdown', onInterrupt, { passive: true, capture: true, signal });
        window.addEventListener('click', onInterrupt, { passive: true, capture: true, signal });
        window.addEventListener('keydown', onKey, { capture: true, signal });

        removeInterruptListeners = () => {
          window.removeEventListener('wheel', onInterrupt as any);
          window.removeEventListener('touchstart', onInterrupt as any);
          window.removeEventListener('touchmove', onInterrupt as any);
          window.removeEventListener('pointerdown', onInterrupt as any);
          window.removeEventListener('click', onInterrupt as any);
          window.removeEventListener('keydown', onKey as any);
        };
      }

      // Compute In-Flow FLIP delta for full-screen optical center
      function prepareOpticalCenter() {
        if (!title || reduceMotion) return { deltaX: 0, deltaY: 0 };

        if (window.scrollY !== 0) {
          try {
            window.scrollTo({ top: 0, left: 0, behavior: 'instant' as ScrollBehavior });
          } catch {
            window.scrollTo(0, 0);
          }
        }

        // Ensure title is measured at natural layout position
        gsap.set(title, { clearProps: 'transform,position,zIndex,transformOrigin' });
        const targetRect = title.getBoundingClientRect();
        const vpW = window.innerWidth;
        const vpH = window.innerHeight;

        if (vpH < 300 || vpW < 300) return { deltaX: 0, deltaY: 0 };

        // Optical center: horizontally centered in viewport, vertically at ~40% of viewport height
        const targetCenterX = Math.round((vpW - targetRect.width) / 2);
        const targetCenterY = Math.round(vpH * 0.40 - targetRect.height / 2);

        const deltaX = targetCenterX - targetRect.left;
        const deltaY = Math.max(0, targetCenterY - targetRect.top);

        const titleScale = window.innerWidth < 640
          ? Math.min(1.08, Math.max(1, (window.innerWidth - 48) / Math.max(1, targetRect.width)))
          : 1.25;

        return { deltaX, deltaY, titleScale };
      }

      let isOpticalCenterStaged = false;

      function stageTitleAtOpticalCenter() {
        if (!title || reduceMotion || isOpticalCenterStaged) return;
        isOpticalCenterStaged = true;
        article?.setAttribute('data-post-title-hold', 'true');
        lockScroll();

        if (titleText && !charNodes.length) {
          charNodes = splitTitleToStaggerNodes(titleText);
        }

        const { deltaX, deltaY, titleScale = 1 } = prepareOpticalCenter();
        title.classList.add('is-split-ready', 'is-center-stage');

        gsap.set(title, {
          x: deltaX,
          y: deltaY,
          scale: titleScale,
          transformOrigin: 'center center',
          force3D: true,
          position: 'relative',
          zIndex: 30,
          '--title-bar-opacity': 0,
          '--title-bar-scale': 0.15,
        });

        if (charNodes.length) {
          gsap.set(charNodes, {
            y: 14,
            opacity: 0,
            filter: 'blur(6px)',
            force3D: true,
          });
        }

        (window as any).__postTitleHoldPending = true;
      }

      function startDecoupledTitleEntrance() {
        if (signal.aborted || isTitleDocked) return;

        if (reduceMotion || !title || Boolean(window.location.hash)) {
          fastForwardTitle();
          return;
        }

        stageTitleAtOpticalCenter();

        const isFreezeCenter = /[?&]freeze=title-center/.test(location.search);
        if (!isFreezeCenter) {
          // Grace period (420ms) before enabling user-skip interrupt so residual scroll/click momentum
          // from clicking the article link never aborts the title entrance on frame 0.
          timers.push(window.setTimeout(() => {
            if (!isTitleDocked && !signal.aborted) {
              setupInterruptHandlers();
            }
          }, 420));
          // Safety fallback timer (2.6s): fast-forward only if animation stalls
          timers.push(window.setTimeout(() => {
            if (!isTitleDocked) fastForwardTitle();
          }, 2600));
        }

        const tl = gsap.timeline({
          onComplete: () => {
            if (isFreezeCenter || isTitleDocked) return;
            releaseDockedStage(false);
          },
        });
        titleEntranceTimeline = tl;

        // Living Calligraphy Choreography: 【错落淡入 · Stagger Fade】字韵流转
        const charDuration = 0.50;
        const totalStagger = Math.min(0.34, 0.02 * charNodes.length);
        const staggerEach = charNodes.length > 0 ? totalStagger / charNodes.length : 0.02;

        // Draw left ink bar downward alongside character stagger
        tl.to(title, {
          '--title-bar-opacity': 0.92,
          '--title-bar-scale': 1,
          duration: 0.52,
          ease: 'power3.out',
        }, 0.02);

        // Step 1: Stagger Fade across all word & character units
        if (charNodes.length) {
          tl.fromTo(charNodes,
            {
              y: 14,
              opacity: 0,
              filter: 'blur(6px)',
            },
            {
              y: 0,
              opacity: 1,
              filter: 'blur(0px)',
              duration: charDuration,
              stagger: staggerEach,
              ease: 'power3.out',
              force3D: true,
            },
            0.04
          );
        } else if (titleText) {
          tl.fromTo(titleText,
            { y: 14, opacity: 0, filter: 'blur(6px)' },
            { y: 0, opacity: 1, filter: 'blur(0px)', duration: charDuration, ease: 'power3.out' },
            0.04
          );
        }

        if (isFreezeCenter) {
          // Freeze optical center title state with other components held in pre-enter
          tl.addPause();
        } else {
          // Step 2: Smoothly glide from optical center to docked layout position in Header (图一位置)
          tl.to(title, {
            x: 0,
            y: 0,
            scale: 1,
            duration: 0.62,
            ease: 'power3.inOut',
          }, '+=0.18');
        }
      }

      function replayTitleInPlace() {
        if (signal.aborted || !title || reduceMotion) return;
        if (charNodes.length) {
          gsap.killTweensOf(charNodes);
          gsap.fromTo(charNodes,
            { y: 10, opacity: 0.2, filter: 'blur(4px)' },
            {
              y: 0, opacity: 1, filter: 'blur(0px)',
              duration: 0.55, ease: 'power2.out', stagger: 0.03,
              onComplete: () => {
                gsap.set(charNodes, { clearProps: 'transform,opacity,filter' });
              },
            }
          );
        } else if (titleText) {
          gsap.killTweensOf(titleText);
          gsap.fromTo(titleText,
            { y: 10, opacity: 0.2, filter: 'blur(4px)' },
            {
              y: 0, opacity: 1, filter: 'blur(0px)',
              duration: 0.55, ease: 'power2.out',
              onComplete: () => {
                gsap.set(titleText, { clearProps: 'transform,opacity,filter' });
              },
            }
          );
        }
        startTypewriterDate(false);
      }

      function resetTitleAndDate() {
        if (charNodes.length && isTitleDocked) {
          gsap.killTweensOf(charNodes);
          gsap.set(charNodes, { opacity: 0.2, y: 10, filter: 'blur(4px)' });
        } else if (titleText && isTitleDocked) {
          gsap.killTweensOf(titleText);
          gsap.set(titleText, { opacity: 0.3, y: 12, filter: 'blur(4px)' });
        }
        if (title && isTitleDocked) {
          title.classList.add('is-split-ready');
        }
        if (typed && isTitleDocked) {
          typewriterTimers.forEach((id) => window.clearTimeout(id));
          typewriterTimers.length = 0;
          typed.classList.remove('is-typing');
          typed.textContent = '';
        }
      }

      // Bidirectional replay: observe header entering and exiting viewport
      let headerCanReplay = false;
      if (header && !reduceMotion) {
        const headerObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting && entry.boundingClientRect.bottom <= 0) {
              // Scrolled down past the header: silently reset and arm for replay
              headerCanReplay = true;
              resetTitleAndDate();
            } else if (entry.isIntersecting && headerCanReplay) {
              // Scrolled back up to top: replay title and date entrance in-place
              headerCanReplay = false;
              replayTitleInPlace();
            }
          });
        }, { threshold: 0 });
        headerObserver.observe(header);
        signal.addEventListener('abort', () => headerObserver.disconnect());
      }

      try {
        const isPendingTransition = Boolean((window as any).__postTransitionPending);
        if (isPendingTransition && !reduceMotion && !window.location.hash) {
          // Pre-position title at optical center right away so it never flashes in header
          stageTitleAtOpticalCenter();
          let fired = false;
          const trigger = () => {
            if (fired || signal.aborted) return;
            fired = true;
            startDecoupledTitleEntrance();
          };
          window.addEventListener('post-transition-release', trigger, { signal, once: true });
          timers.push(window.setTimeout(trigger, 480));
        } else {
          startDecoupledTitleEntrance();
        }
      } catch (err) {
        console.error('[PostLayout] Transition setup error, falling back to instant dock:', err);
        fastForwardTitle();
      }

      // ---------- Blocks: tag each direct child, reveal via IntersectionObserver ----------
      // Direct tagging without DOM mutations (no wrapper insertion) for pure GPU transitions
      const tBlocks0 = performance.now();
      const blocks = Array.from(prose.children) as HTMLElement[];
      blocks.forEach((el) => {
        const kind = el.dataset.pr || revealKind(el);
        el.dataset.pr = kind;
        el.classList.add('pr');
        if (kind === 'table') el.querySelectorAll('tr').forEach((row, i) => row.style.setProperty('--i', String(Math.min(i, 12))));
        if (kind === 'list') Array.from(el.children).forEach((li, i) => (li as HTMLElement).style.setProperty('--i', String(Math.min(i, 8))));
      });
      const tBlocksDuration = performance.now() - tBlocks0;
      if (tBlocksDuration > 2) {
        console.debug(`[perf:blocks-wrap] Prepared ${blocks.length} blocks in ${tBlocksDuration.toFixed(2)}ms`);
      }

      if (reduceMotion) {
        blocks.forEach((el) => el.classList.add('is-in'));
      } else {
        // 方案 B 完整落地：双阈值迟滞（Dual-threshold Hysteresis）观察器架构
        let observersAttached = false;

        const revealInViewBlocks = () => {
          if (!isTitleDocked && !reduceMotion) return;
          const vh = window.innerHeight || document.documentElement.clientHeight;
          blocks.forEach((el, index) => {
            if (el.classList.contains('is-in')) return;
            const rect = el.getBoundingClientRect();
            if ((rect.top < vh * 0.96 && rect.bottom > 0) || (index < 3 && rect.top < vh)) {
              el.classList.add('is-in');
            } else if (rect.bottom <= 0 && rect.top !== 0) {
              el.classList.add('pr-instant', 'is-in');
            }
          });
        };

        const initProseObservers = () => {
          if (observersAttached || signal.aborted) return;
          observersAttached = true;

          // 1. revealObserver (rootMargin: '0px 0px -4% 0px'):
          //    元素滚动进入视口安全区时触发，添加 .is-in 播放 900ms 优雅进场动画。
          //    绝不在视口内或视口边缘拔除 .is-in，彻底杜绝上下滑动与动画播放中途来回拉扯造成的撕裂抽搐。
          //    从视口上方进入的块（深链接或恢复滚动位置后向上滑）静默显形，绝不逆着手势播位移。
          const revealObserver = new IntersectionObserver((entries) => {
            if (!isTitleDocked && !reduceMotion) return;
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                if (el.classList.contains('is-in')) return;
                if (entry.boundingClientRect.top < 0) {
                  el.classList.add('pr-instant', 'is-in');
                  requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('pr-instant')));
                } else {
                  el.classList.add('is-in');
                }
              }
            });
          }, { rootMargin: '0px 0px -4% 0px', threshold: 0 });

          // 2. resetObserver (rootMargin: '120px 0px 120px 0px'):
          //    仅当元素彻底离开视口安全缓冲区（超出屏幕外 >120px）时，才静默重置 .is-in。
          //    并且只给落到视口「下方」的块重新上膛：留在上方的块保持进场态，
          //    于是向上滚动全程没有任何内容逆着手势位移，而向下滚动的往返重播完整保留。
          //    无需任何 setTimeout 异步定时器，无布局抖动，零抽搐。
          const resetObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) {
                if (entry.boundingClientRect.top <= 0) return;
                entry.target.classList.remove('is-in');
              }
            });
          }, { rootMargin: '120px 0px 120px 0px', threshold: 0 });

          blocks.forEach((el) => {
            revealObserver.observe(el);
            resetObserver.observe(el);
          });

          revealInViewBlocks();
          requestAnimationFrame(revealInViewBlocks);

          signal.addEventListener('abort', () => {
            revealObserver.disconnect();
            resetObserver.disconnect();
          });
        };

        (window as any).__revealInViewBlocks__ = () => {
          initProseObservers();
          revealInViewBlocks();
        };

        // If title is already docked or reduced motion, reveal right away; otherwise wait for docking
        if (isTitleDocked) {
          initProseObservers();
        }

        document.addEventListener('visibilitychange', () => {
          if (!document.hidden && (isTitleDocked || reduceMotion)) {
            revealInViewBlocks();
          }
        }, { signal });
      }

      // ---------- Reading spine: draws with scroll, ink dots per h2 ----------
      const body = document.querySelector<HTMLElement>('[data-post-body]');
      const spine = document.querySelector<HTMLElement>('[data-post-spine]');
      const spineLine = document.querySelector<SVGLineElement>('[data-post-spine-line]');
      const dots: HTMLElement[] = [];

      function placeDots() {
        if (!body || !spine) return;
        const h2s = Array.from(prose.querySelectorAll<HTMLElement>('h2'));
        const bodyTop = body.getBoundingClientRect().top;

        while (dots.length > h2s.length) {
          dots.pop()?.remove();
        }
        while (dots.length < h2s.length) {
          const dot = document.createElement('i');
          dot.className = 'post-spine-dot';
          spine.appendChild(dot);
          dots.push(dot);
        }

        const positions = h2s.map((h2) => {
          return Math.round(h2.getBoundingClientRect().top - bodyTop + parseFloat(getComputedStyle(h2).paddingTop) + 14);
        });
        positions.forEach((top, i) => {
          const dot = dots[i];
          if (dot) dot.style.top = `${top}px`;
        });
      }

      if (body && spine && spineLine && !reduceMotion) {
        requestAnimationFrame(() => placeDots());
        // Written straight from scroll progress (pathLength="1", so offset 1 → 0 is empty → full)
        spineLine.style.strokeDashoffset = '1';
        ScrollTrigger.create({
          id: `${TRIGGER_PREFIX}spine`,
          trigger: body,
          start: 'top 65%',
          end: 'bottom 55%',
          onUpdate: (self) => {
            spineLine.style.strokeDashoffset = String(1 - self.progress);
          },
        });

        const headings = Array.from(prose.querySelectorAll<HTMLElement>('h2'));
        const litIo = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const index = headings.indexOf(entry.target as HTMLElement);
            const dot = dots[index];
            if (!dot) return;
            const passed = entry.isIntersecting || entry.boundingClientRect.top < 0;
            dot.classList.toggle('is-lit', passed);
          });
        }, { rootMargin: '-35% 0px -35% 0px' });
        headings.forEach((h) => litIo.observe(h));
        signal.addEventListener('abort', () => litIo.disconnect());

        // Images and fonts shift layout after first paint — keep the dots pinned to their headings.
        // Debounce and avoid calling ScrollTrigger.refresh() while Lenis is actively scrolling!
        let roTimer: number | null = null;
        const ro = new ResizeObserver(() => {
          if (roTimer) window.clearTimeout(roTimer);
          roTimer = window.setTimeout(() => {
            placeDots();
            if (!(window as any).lenis?.isScrolling) {
              ScrollTrigger.refresh();
            } else {
              const checkScroll = () => {
                if (!(window as any).lenis?.isScrolling) {
                  ScrollTrigger.refresh();
                } else {
                  window.setTimeout(checkScroll, 120);
                }
              };
              window.setTimeout(checkScroll, 120);
            }
          }, 150);
        });
        ro.observe(prose);
        signal.addEventListener('abort', () => {
          ro.disconnect();
          if (roTimer) window.clearTimeout(roTimer);
        });
      }

      // ---------- Series Tooltips: dynamic boundary clamping ----------
      const seriesContainer = document.querySelector<HTMLElement>('.series-dots');
      if (seriesContainer) {
        function updateSeriesTooltip(dot: HTMLElement) {
          const tip = dot.querySelector<HTMLElement>('.series-dot-tip');
          if (!tip) return;
          const dotRect = dot.getBoundingClientRect();
          const containerRect = seriesContainer!.getBoundingClientRect();
          const tipWidth = tip.offsetWidth || 220;
          const dotCenterX = dotRect.left + dotRect.width / 2;

          const clampedLeft = Math.max(
            containerRect.left,
            Math.min(dotCenterX - tipWidth / 2, containerRect.right - tipWidth)
          );
          const offsetFromDot = Math.round(clampedLeft - dotRect.left);
          const arrowX = Math.round(dotCenterX - clampedLeft);

          tip.style.setProperty('--tip-left', `${offsetFromDot}px`);
          tip.style.setProperty('--tip-translate', '0 6px');
          tip.style.setProperty('--tip-translate-active', '0 -2px');
          tip.style.setProperty('--arrow-left', `${arrowX}px`);
        }

        seriesContainer.querySelectorAll<HTMLElement>('.series-dot').forEach((dot) => {
          dot.addEventListener('pointerenter', () => updateSeriesTooltip(dot), { signal, passive: true });
          dot.addEventListener('focus', () => updateSeriesTooltip(dot), { signal, passive: true });
        });
      }

      (window as any)[CLEANUP_KEY] = () => {
        controller.abort();
        cleanupInterrupt();
        unlockScroll();
        timers.forEach((id) => window.clearTimeout(id));
        typewriterTimers.forEach((id) => window.clearTimeout(id));
        if (titleEntranceTimeline) {
          titleEntranceTimeline.kill();
          titleEntranceTimeline = null;
        }
        if (title) {
          gsap.killTweensOf(title);
          gsap.set(title, { clearProps: 'transform,position,zIndex' });
        }
        if (cancelActiveSpatters) {
          cancelActiveSpatters();
          cancelActiveSpatters = null;
        }
        if (titleText) {
          gsap.killTweensOf(titleText);
          gsap.set(titleText, { clearProps: 'clipPath,filter,transform,opacity' });
        }
        dots.forEach((d) => d.remove());
        ScrollTrigger.getAll().forEach((trigger) => {
          if (String(trigger.vars.id || '').startsWith(TRIGGER_PREFIX)) trigger.kill();
        });
        (window as any).__revealInViewBlocks__ = undefined;
        (window as any).__postTitleHoldPending = false;
        (window as any)[CLEANUP_KEY] = undefined;
      };
    }

    // 用“当前 prose 元素”做去重，而不是 document / URL。
    // ClientRouter 切换文章时脚本可能在旧 DOM 上先执行一次；page-load 时新 prose
    // 已经是另一个元素，必须重新初始化，标题动画才会在每篇文章各播一次。
    let initializedProse: HTMLElement | null = null;

    function runPostReveal(force = false) {
      const prose = document.querySelector<HTMLElement>('[data-post-prose]');
      if (!prose) {
        // 切到非文章页：清掉上一篇文章遗留的滚动锁 / 定时器 / ScrollTrigger
        const previousCleanup = (window as any)[CLEANUP_KEY];
        if (typeof previousCleanup === 'function') previousCleanup();
        initializedProse = null;
        return;
      }
      if (!force && initializedProse === prose) return;
      initializedProse = prose;
      initPostReveal();
    }

    runPostReveal();

    if (!(window as any)[LISTENER_KEY]) {
      document.addEventListener('astro:after-swap', () => {
        // 新 DOM 已经就位：立即同步预置标题中央态，杜绝首帧闪现原位
        runPostReveal(true);
      });
      document.addEventListener('astro:page-load', () => {
        runPostReveal();
      });
      // Locked posts reveal their body only after the password check
      window.addEventListener('post-unlocked', () => runPostReveal(true));
      (window as any)[LISTENER_KEY] = true;
    }
  </script>
  <script is:inline>
    (() => {
      const cleanupKey = '__areSetPostTocCleanup__';
      const initKey = '__areSetPostTocInit__';
      const listenerKey = '__areSetPostTocPageLoadBound__';

      function initPostToc() {
        const previousCleanup = window[cleanupKey];
        if (typeof previousCleanup === 'function') previousCleanup();

        const toc = document.querySelector('.post-toc');
        const prose = document.querySelector('[data-post-prose]');
        if (!toc || !prose) {
          window[cleanupKey] = null;
          return;
        }

        const controller = new AbortController();
        const { signal } = controller;
        const links = Array.from(toc.querySelectorAll('[data-toc-link]'));
        const headings = links
          .map((link) => {
            const id = link.getAttribute('data-toc-link');
            const heading = id ? (document.getElementById(id) || (window.CSS && CSS.escape ? prose.querySelector('#' + CSS.escape(id)) : null)) : null;
            return heading ? { link, heading } : null;
          })
          .filter(Boolean);

        let currentActiveId = null;

        // Keep the active link visible inside the TOC's own scroller — and nowhere else.
        // scrollIntoView() walks up every scrolling box to the viewport, and this TOC is an
        // inline <details> above the article rather than a sticky rail, so it would drag the
        // whole page back up to the TOC on every scrollspy change.
        function revealLinkInToc(link, smooth) {
          const nav = toc.querySelector('.post-toc-nav');
          if (!nav || nav.scrollHeight <= nav.clientHeight + 1) return;
          const navRect = nav.getBoundingClientRect();
          const linkRect = link.getBoundingClientRect();
          let delta = 0;
          if (linkRect.top < navRect.top) delta = linkRect.top - navRect.top;
          else if (linkRect.bottom > navRect.bottom) delta = linkRect.bottom - navRect.bottom;
          if (!delta) return;
          const top = nav.scrollTop + delta;
          if (smooth) nav.scrollTo({ top, behavior: 'smooth' });
          else nav.scrollTop = top;
        }

        function setActive(id) {
          if (!id || id === currentActiveId) return;
          currentActiveId = id;
          links.forEach((link) => {
            const isCurrent = link.getAttribute('data-toc-link') === id;
            link.classList.toggle('is-active', isCurrent);
            if (isCurrent && toc.open) {
              revealLinkInToc(link, true);
            }
          });
        }

        // Smooth scroll to heading when TOC link is clicked
        links.forEach((link) => {
          link.addEventListener('click', (event) => {
            if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            const id = link.getAttribute('data-toc-link');
            if (!id) return;
            const targetEl = document.getElementById(id) || (window.CSS && CSS.escape ? prose.querySelector('#' + CSS.escape(id)) : null);
            if (targetEl) {
              event.preventDefault();
              setActive(id);
              if (window.lenis) {
                window.lenis.scrollTo(targetEl, { offset: -70 });
              } else {
                const top = targetEl.getBoundingClientRect().top + window.scrollY - 70;
                window.scrollTo({ top, behavior: 'smooth' });
              }
              try {
                history.pushState(null, '', '#' + id);
              } catch (_) {}
              if (typeof window.__pulseHeadingTarget === 'function') {
                window.__pulseHeadingTarget(targetEl);
              }
            }
          }, { signal });
        });

        // 文章目录展开/收起平滑缓动动画
        const summary = toc.querySelector('.post-toc-summary');
        const expander = toc.querySelector('.post-toc-expander');
        const inner = toc.querySelector('.post-toc-inner');
        let isOpening = false;
        let isClosing = false;
