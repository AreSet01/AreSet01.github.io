{
  "name": "my-blog",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && astro build --force",
    "hash:password": "node scripts/hash-password.mjs",
    "ask": "node server/ask.mjs",
    "deploy": "node scripts/deploy-server.mjs",
    "preview": "astro preview",
    "preview:theme": "node scripts/generate-previews.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.5",
    "gsap": "^3.15.0",
    "katex": "^0.19.1",
    "lenis": "^1.3.23",
    "marked": "^16.4.2",
    "mermaid": "^12.0.0",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.2",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
